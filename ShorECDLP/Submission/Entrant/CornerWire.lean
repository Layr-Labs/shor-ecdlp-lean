  have hw := (BalancedCleanup.widths cellLayout.toLayout cellLayout_widths)
  simp only [TopReuse.unnormalizeE, ECDSAAdd.wires_append, Finset.mem_union] at hm
  rcases hm with (h | h) | h
  · simp only [cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at h
    have := MappedCompressed.base_injective h; omega
  · have hs := EndKnown.addK_wires cellLayout.low cellLayout.ylow (cellLayout.carry.take 254)
      cellLayout.ymsb cellLayout.lower cellLayout.one BalancedCleanup.positiveLiteral (by omega) h
    rcases Finset.mem_union.mp hs with h1 | h2
    · have hl := literalConstAdd_wires _ _ _ _ _ h1
      simp only [List.mem_toFinset, List.mem_cons, List.mem_append, cellLayout_one, cellLayout_lower] at hl
      rcases hl with e | e | hr | hc
      · have := MappedCompressed.base_injective e; omega
      · have := MappedCompressed.base_injective e; omega
      · exact cell_not_low k (by omega) hr
      · exact cellLayout_carry_take254_ne k hk hc
    · simp only [List.mem_toFinset, List.mem_cons] at h2
      rcases h2 with e | hy
      · exact cell_not_y k (by omega) (by rw [e]; simp [BalancedCleanup.Layout.y])
      · exact cell_not_y k (by omega) (by simp [BalancedCleanup.Layout.y, hy])
  · simp only [cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
