        rcases hw with ⟨i, hi, rfl⟩ | rfl | rfl | rfl <;> exact mem_workIds_map _ (by omega)
      exact hm (e ▸ hcw)
    exact (ECDSAAdd.run_preserves_outside _ m st w (by
      intro hm; simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_singleton,
        Finset.notMem_empty, or_false] at hm; exact hne hm)).trans (hc.2.2 w hw)

theorem compiledSwapBody_catLitSim {n : Nat} (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledSwapBody (n := n) s).prog.instantiate read h) SW.swapBody CellValid := by
  rw [compiledSwapBody]
  exact catLitSim_weaken
    (CatFn.compileProg_catLitSim (base 1541) (base 1026) SW.swapBody
      (cell_swapBody_avoid 1541 (Or.inl rfl)) (cell_swapBody_avoid 1026 (Or.inr rfl))
      (base_ne 1541 1026 (by omega))
      (swapBody_def.symm ▸ swapRegisters_physical (base 2410) cellLayout.r cellLayout.y cell_swap_nodup) s read h)
    (fun _ hv => cellValid_1541_1026 hv)

theorem compiledHalf_catLitSim {n : Nat} (divide : Bool) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledHalf (n := n) divide s).prog.instantiate read h)
      (OneBankCell5.half divide base (base 2409)) CellClean := by
  have h1 : ∀ (s' : Nat) (r' : ConstantBit n → Bool) (h' : Fin s' → Bool),
      CatLitSim (base 1026) ((CatFn.noT ([.X (base 2409)]) s').prog.instantiate r' h') ([.X (base 2409)]) CellClean :=
    fun s' r' h' => catLitSim_weaken (CatFn.noT_catLitSim (base 1026) ([.X (base 2409)]) x2409_avoid_1026 s' r' h')
      (fun _ _ => trivial)
  rw [compiledHalf, cell_half_eq]
  cases divide
  · have h12 := CatFn.seq_catLitSim _ _ compiledInverse_indep ([.X (base 2409)]) (TopReuse.inverse cellLayout)
      CellClean CellClean h1 compiledInverse_catLitSim (fun st m hc _ => x2409_pres_clean st m hc)
    exact CatFn.seq_catLitSim _ _ (CatFn.noT_indep _) _ ([.X (base 2409)]) CellClean (fun _ => True) h12
      (CatFn.noT_catLitSim (base 1026) _ x2409_avoid_1026) (fun _ _ _ _ => trivial) s read h
  · have h12 := CatFn.seq_catLitSim _ _ compiledForward_indep ([.X (base 2409)]) (TopReuse.forward cellLayout)
      CellClean CellClean h1 compiledForward_catLitSim (fun st m hc _ => x2409_pres_clean st m hc)
    exact CatFn.seq_catLitSim _ _ (CatFn.noT_indep _) _ ([.X (base 2409)]) CellClean (fun _ => True) h12
      (CatFn.noT_catLitSim (base 1026) _ x2409_avoid_1026) (fun _ _ _ _ => trivial) s read h

theorem compiledHalfE_catLitSim {n : Nat} (divide : Bool) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledHalfE (n := n) divide s).prog.instantiate read h)
      (OneBankCell5.halfE divide base (base 2409)) CellClean := by
  rw [compiledHalfE]; cases divide
  · simp only [Bool.false_eq_true, if_false, OneBankCell5.halfE]
