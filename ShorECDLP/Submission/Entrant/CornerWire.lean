theorem compileAddInPlace_finish {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat),
      (compileAddInPlace (n := n) y x ys carry cin start).finish =
        start + ECDSAAdd.measurementCount (addInPlace x ys carry cin)
  | a :: a' :: as, b :: b' :: bs, c :: cs, cin, start => by
      have ih := compileAddInPlace_finish (n := n) y (a' :: as) (b' :: bs) cs c start
      simp only [compileAddInPlace, CatProg.append, CatProg.lit, CatProg.noT_finish, addInPlace,
        ECDSAAdd.measurementCount_append, ih]
      have h1 : ECDSAAdd.measurementCount (majority a b cin c) = 0 := rfl
      have h2 : ECDSAAdd.measurementCount (eraseCarry a b cin c) = 1 := rfl
      have h3 : ECDSAAdd.measurementCount ([.CX a b, .CX cin b] : ECDSAAdd.Program) = 0 := rfl
      omega
  | [a], [b], _, cin, start => rfl
  | [], _, _, _, _ | [_], [], _, _, _ | [_], _ :: _ :: _, _, _, _
  | [_, _], [], _, _, _ | [_, _], [_], _, _, _ | [_, _], _ :: _ :: _, [], _, _
  | _ :: _ :: _ :: _, [], _, _, _ | _ :: _ :: _ :: _, [_], _, _, _
  | _ :: _ :: _ :: _, _ :: _ :: _, [], _, _ => rfl

theorem compileAddInPlaceTop_finish {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat),
      (compileAddInPlaceTop (n := n) y x ys carry cin start).finish =
        start + ECDSAAdd.measurementCount (TopReuseCarry.addInPlaceTop x ys carry cin)
  | [a, a'], b :: b' :: bs, c :: cs, cin, start => by
      have ih := compileAddInPlaceTop_finish (n := n) y ([a']) (b' :: bs) cs c start
      have h1 : ECDSAAdd.measurementCount ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) = 0 := rfl
      have h2 : ECDSAAdd.measurementCount (eraseCarry a b cin c) = 1 := rfl
      have h3 : ECDSAAdd.measurementCount ([.CX a b, .CX cin b] : ECDSAAdd.Program) = 0 := rfl
      simp only [compileAddInPlaceTop, TopReuseCarry.addInPlaceTop, if_true, CatProg.append, CatProg.lit,
        CatProg.noT_finish, ECDSAAdd.measurementCount_append, ih, h1, h2, h3]
      omega
  | a :: a' :: a'' :: as, b :: b' :: bs, c :: cs, cin, start => by
      have ih := compileAddInPlaceTop_finish (n := n) y (a' :: a'' :: as) (b' :: bs) cs c start
      have h1 : ECDSAAdd.measurementCount (majority a b cin c) = 0 := rfl
      have h2 : ECDSAAdd.measurementCount (eraseCarry a b cin c) = 1 := rfl
      have h3 : ECDSAAdd.measurementCount ([.CX a b, .CX cin b] : ECDSAAdd.Program) = 0 := rfl
      simp only [compileAddInPlaceTop, TopReuseCarry.addInPlaceTop, reduceCtorEq, if_false, CatProg.append, CatProg.lit,
        CatProg.noT_finish, ECDSAAdd.measurementCount_append, ih, h1, h2, h3]
      omega
  | [a], [b], _, cin, start => rfl
  | [], _, _, _, _ | [_], [], _, _, _ | [_], _ :: _ :: _, _, _, _
  | [_, _], [], _, _, _ | [_, _], [_], _, _, _ | [_, _], _ :: _ :: _, [], _, _
  | _ :: _ :: _ :: _, [], _, _, _ | _ :: _ :: _ :: _, [_], _, _, _
  | _ :: _ :: _ :: _, _ :: _ :: _, [], _, _ => rfl

theorem compileAddInPlace_tCount {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool),
      ((compileAddInPlace (n := n) y x ys carry cin start).prog.instantiate read h).tCount =
        4 * ECDSAAdd.toffoliCount (addInPlace x ys carry cin)
  | a :: a' :: as, b :: b' :: bs, c :: cs, cin, start, read, h => by
      have ih := compileAddInPlace_tCount (n := n) y (a' :: as) (b' :: bs) cs c
        (CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)).finish read (fun _ => false)
      simp only [compileAddInPlace, CatProg.append]
      rw [indep_append_tCount _ _ (CatProg.lit_indep _),
        indep_append_tCount _ _ (CatProg.noT_indep _),
        indep_append_tCount _ _ (compileAddInPlace_indep y _ _ _ _ _),
        CatProg.lit_tCount, majorityCat_tCount, ih, CatProg.noT_tCount, eraseCarry_norm_toff,
        CatProg.lit_tCount, cx2_tCount]
      have hm : ECDSAAdd.toffoliCount (majority a b cin c) = 1 := rfl
      have he : ECDSAAdd.toffoliCount (eraseCarry a b cin c) = 0 := rfl
      have hc : ECDSAAdd.toffoliCount ([.CX a b, .CX cin b] : ECDSAAdd.Program) = 0 := rfl
      simp only [addInPlace, ECDSAAdd.toffoliCount_append, hm, he, hc]
      omega
  | [a], [b], _, cin, start, read, h => by
      rw [compileAddInPlace, CatProg.lit_tCount, cx2_tCount]; rfl
  | [], _, _, _, _, _, _ | [_], [], _, _, _, _, _ | [_], _ :: _ :: _, _, _, _, _, _
  | _ :: _ :: _, [], _, _, _, _, _ | _ :: _ :: _, [_], _, _, _, _, _
  | _ :: _ :: _, _ :: _ :: _, [], _, _, _, _ => by
      simp [compileAddInPlace, CatProg.lit_tCount, addInPlace, ECDSAAdd.toffoliCount, ShorECDLP.tCount]

theorem compileAddInPlaceTop_tCount {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool),
      ((compileAddInPlaceTop (n := n) y x ys carry cin start).prog.instantiate read h).tCount =
        4 * ECDSAAdd.toffoliCount (TopReuseCarry.addInPlaceTop x ys carry cin)
  | [a, a'], b :: b' :: bs, c :: cs, cin, start, read, h => by
      have ih := compileAddInPlaceTop_tCount (n := n) y ([a']) (b' :: bs) cs c
        (CatProg.lit (n := n) (start := start) [.CX b c, .CX b' c, .CX cin c]).finish read (fun _ => false)
      have he : ECDSAAdd.toffoliCount (eraseCarry a b cin c) = 0 := rfl
      have hc : ECDSAAdd.toffoliCount ([.CX a b, .CX cin b] : ECDSAAdd.Program) = 0 := rfl
      have h0 : ECDSAAdd.toffoliCount ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) = 0 := rfl
      simp only [compileAddInPlaceTop, CatProg.append]
      rw [indep_append_tCount _ _ (CatProg.lit_indep _),
        indep_append_tCount _ _ (CatProg.noT_indep _),
        indep_append_tCount _ _ (compileAddInPlaceTop_indep y _ _ _ _ _),
        CatProg.lit_tCount, cx3_tCount, ih, CatProg.noT_tCount, eraseCarry_norm_toff,
        CatProg.lit_tCount, cx2_tCount]
      simp only [TopReuseCarry.addInPlaceTop, if_true, ECDSAAdd.toffoliCount_append, h0, he, hc]
      omega
  | a :: a' :: a'' :: as, b :: b' :: bs, c :: cs, cin, start, read, h => by
      have ih := compileAddInPlaceTop_tCount (n := n) y (a' :: a'' :: as) (b' :: bs) cs c
        (CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)).finish read (fun _ => false)
      have he : ECDSAAdd.toffoliCount (eraseCarry a b cin c) = 0 := rfl
      have hc : ECDSAAdd.toffoliCount ([.CX a b, .CX cin b] : ECDSAAdd.Program) = 0 := rfl
      have hm : ECDSAAdd.toffoliCount (majority a b cin c) = 1 := rfl
      simp only [compileAddInPlaceTop, CatProg.append]
      rw [indep_append_tCount _ _ (CatProg.lit_indep _),
        indep_append_tCount _ _ (CatProg.noT_indep _),
        indep_append_tCount _ _ (compileAddInPlaceTop_indep y _ _ _ _ _),
        CatProg.lit_tCount, majorityCat_tCount, ih, CatProg.noT_tCount, eraseCarry_norm_toff,
        CatProg.lit_tCount, cx2_tCount]
      simp only [TopReuseCarry.addInPlaceTop, reduceCtorEq, if_false, ECDSAAdd.toffoliCount_append, hm, he, hc]
      omega
  | [a], [b], _, cin, start, read, h => by
      rw [compileAddInPlaceTop, CatProg.lit_tCount, cx2_tCount]; rfl
  | [], _, _, _, _, _, _ | [_], [], _, _, _, _, _ | [_], _ :: _ :: _, _, _, _, _, _
  | [_, _], [], _, _, _, _, _ | [_, _], [_], _, _, _, _, _ | [_, _], _ :: _ :: _, [], _, _, _, _
  | _ :: _ :: _ :: _, [], _, _, _, _, _ | _ :: _ :: _ :: _, [_], _, _, _, _, _
  | _ :: _ :: _ :: _, _ :: _ :: _, [], _, _, _, _ => by
      simp [compileAddInPlaceTop, CatProg.lit_tCount, TopReuseCarry.addInPlaceTop, ECDSAAdd.toffoliCount, ShorECDLP.tCount]

theorem compileAddInPlace_slots {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat),
      (compileAddInPlace (n := n) y x ys carry cin start).prog.gateSlots ≤ 50 * ys.length
  | a :: a' :: as, b :: b' :: bs, c :: cs, cin, start => by
      have ih := compileAddInPlace_slots (n := n) y (a' :: as) (b' :: bs) cs c
        (CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)).finish
      have he := CatProg.noT_slots (n := n)
        (start := (compileAddInPlace (n := n) y (a' :: as) (b' :: bs) cs c
          (CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)).finish).finish)
        (eraseCarry a b cin c)
      have hes : ECDSAAdd.Challenge.gateSlots (eraseCarry a b cin c) = 4 := rfl
      simp only [compileAddInPlace, CatProg.append, Straight.gateSlots_append, CatProg.lit_slots,
