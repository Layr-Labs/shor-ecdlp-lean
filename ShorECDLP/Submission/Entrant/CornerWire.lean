theorem twoPassCont_slots {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (Bk : Nat) (hk : ∀ c rs, (k c rs).gateSlots ≤ Bk) (start : Nat) :
    (twoPassContProg k start).gateSlots ≤
      4 * ECDSAAdd.Challenge.gateSlots (ECDSAAdd.Baselines.normalizeProgram site1Arith) + 52000000 + Bk := by
  have h8 (c : Nat) (rs : List (Fin c)) : (step8Cont k c rs).gateSlots ≤ Bk := by
    rw [step8Cont, castFinish_gateSlots]
    exact measureThen_slots_le k Bk hk pairExtraWires c rs
  have h78 (c : Nat) (rs : List (Fin c)) :
      (step78Cont k c rs).gateSlots ≤ 4 * ECDSAAdd.Challenge.gateSlots tailNorm + Bk := by
    rw [step78Cont, castFinish_gateSlots, Straight.gateSlots_append, literalFixed_slots]
    have hl := literal_slot_bound (n := 65536) tailNorm
    have h8' := h8 (c + mTail) (rs.map (Fin.castLE (Nat.le_add_right _ _)))
    generalize ECDSAAdd.Challenge.gateSlots tailNorm = gT at hl ⊢
    omega
  have h678 (c : Nat) (rs : List (Fin c)) :
      (step678Cont k c rs).gateSlots ≤ 4 * ECDSAAdd.Challenge.gateSlots tailNorm + Bk := by
    rw [step678Cont, castFinish_gateSlots]
    exact measureThen_slots_le (fun cur rs' => step78Cont k cur rs') _ h78 gB c rs
  have h5678 (c : Nat) (rs : List (Fin c)) :
      (step5678Cont k c rs).gateSlots ≤ (2 ^ 15 * (2 * 513) + 10 * (2 ^ 15 - 1) + 12 * 513) +
        (4 * ECDSAAdd.Challenge.gateSlots tailNorm + Bk) := by
    rw [step5678Cont, castFinish_gateSlots, Straight.gateSlots_append]
    have hb := fB.loadProg_slots fB_geo c
    have hbl : fB.selBits.length = 15 := by decide
    have hpl : fB.ports.length = 513 := pp16_length
    rw [hbl, hpl] at hb
    have h6 := h678 (c + codeRecords fB.selBits fB.selPaths windowRoot fB.selCode) (rs.map (Fin.castLE (Nat.le_add_right _ _)))
    generalize ECDSAAdd.Challenge.gateSlots tailNorm = gT at h6 ⊢
    omega
  have h48 (c : Nat) (rs : List (Fin c)) :
      (step4_8Cont k c rs).gateSlots ≤ (2 ^ 15 * (2 * 513) + 10 * (2 ^ 15 - 1) + 12 * 513) +
        (4 * ECDSAAdd.Challenge.gateSlots tailNorm + Bk) := by
    rw [step4_8Cont, castFinish_gateSlots]
    exact measureThen_slots_le (fun cur rs' => step5678Cont k cur rs') _ h5678 shortWires c rs
  have h38 (c : Nat) (rs : List (Fin c)) :
      (step3_8Cont k c rs).gateSlots ≤ 4 * ECDSAAdd.Challenge.gateSlots shortNorm +
        ((2 ^ 15 * (2 * 513) + 10 * (2 ^ 15 - 1) + 12 * 513) +
        (4 * ECDSAAdd.Challenge.gateSlots tailNorm + Bk)) := by
    rw [step3_8Cont, castFinish_gateSlots, Straight.gateSlots_append, literalFixed_slots]
    have hl := literal_slot_bound (n := 65536) shortNorm
    have h4 := h48 (c + mShort) (rs.map (Fin.castLE (Nat.le_add_right _ _)))
    generalize ECDSAAdd.Challenge.gateSlots shortNorm = gS at hl ⊢
    generalize ECDSAAdd.Challenge.gateSlots tailNorm = gT at h4 ⊢
    omega
  have h28 (c : Nat) :
      (step2_8Cont k c).gateSlots ≤ 4 * ECDSAAdd.Challenge.gateSlots shortNorm +
        ((2 ^ 15 * (2 * 513) + 10 * (2 ^ 15 - 1) + 12 * 513) +
        (4 * ECDSAAdd.Challenge.gateSlots tailNorm + Bk)) := by
    rw [step2_8Cont, castFinish_gateSlots]
    exact measureThen_slots_le (fun cur rs' => step3_8Cont k cur rs') _ h38 garbA c List.nil
  rw [twoPassContProg, castFinish_gateSlots, Straight.gateSlots_append]
  have ha := fA.loadProg_slots fA_geo start
  have hbl : fA.selBits.length = 14 := by decide
  have hpl : fA.ports.length = 258 := sp16_length
  rw [hbl, hpl] at ha
  have h2 := h28 (start + codeRecords fA.selBits fA.selPaths windowRoot fA.selCode)
  have hns := norm_slots_split
  generalize ECDSAAdd.Challenge.gateSlots shortNorm = gsS at h2 hns
  generalize ECDSAAdd.Challenge.gateSlots tailNorm = gsT at h2 hns
  generalize ECDSAAdd.Challenge.gateSlots (ECDSAAdd.Baselines.normalizeProgram site1Arith) = gsA at hns ⊢
  omega

private theorem phase_cancel_cont (ph : Bool) (mag c prev p : ℂ) (hp : p * p = 1) :
    (if ph then (-1 : ℂ) else 1) * (mag * p) * (if ph then (-1 : ℂ) else 1) * (c * (prev * p)) =
      mag * c * prev := by
  cases ph <;>
  · simp only [ite_true, ite_false, Bool.false_eq_true]
    calc _ = (mag * c * prev) * (p * p) := by ring
      _ = mag * c * prev := by rw [hp, mul_one]

theorem twoPassCont_sim (read : ConstantBit 65536 → Bool)
    (kSrc : List Bool → AdaptiveCircuit) (mK : Nat)
    (ValidK : Nat → ECDSAAdd.State → Prop)
    (Target : Nat → ECDSAAdd.State → List Bool → State)
    (hk : ∀ oS : List Bool, oS.length = 2058 →
      ∃ cs : List ℂ, List.Forall₂
        (fun b c => ∃ mk : List Bool, mk.length = mK ∧
          ∀ a (st2 : ECDSAAdd.State), ValidK a st2 →
            b.kraus (Bridge.signedKet st2) =
              (c * portPhase allData oS read a) • Target a st2 mk)
        (kSrc oS).run cs ∧ (cs.map Complex.normSq).sum = 1) :
    ∃ cs : List ℂ, List.Forall₂
      (fun b c => ∃ m : List Bool, ∃ mk : List Bool,
        m.length = ECDSAAdd.measurementCount site1Arith ∧ mk.length = mK ∧
        ∀ a (st : ECDSAAdd.State),
          let st2 := ECDSAAdd.run ((specialize site1_16.code a).instantiate read) m st
          AddrValid WideBank8.Fast16.windowBits windowRoot a st →
          Clean WideBank8.Fast16.pathBank st.basis →
          Clean streamLayout.dialogPool st.basis →
          (∀ m', Clean scrAllWires
            (ECDSAAdd.run ((specialize site1_16.code a).instantiate read) m' st).basis) →
          ValidK a st2 →
          b.kraus (Bridge.signedKet st) = c • Target a st2 mk)
      (twoPassContSrc read kSrc).run cs ∧ (cs.map Complex.normSq).sum = 1 := by
  have hbits_no_pe : ∀ w ∈ WideBank8.Fast16.windowBits, w ∉ pairExtraWires := fun w hw hm => by
    have hb := mem_pairExtra hm
    simp only [WideBank8.Fast16.windowBits, List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
