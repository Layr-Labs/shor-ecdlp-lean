/-! #### 4. Raw replay, packets, groups, first/end packets, logical replay, and `replayS` -/

def compiledRawReplay {n : Nat} (divide : Bool) : List MixedTranscriptLetter → CatFn n
  | [] => CatFn.noT []
  | l :: ls =>
    if divide then CatFn.seq (compiledCell true l.1.1 l.1.2) (compiledRawReplay true ls)
    else CatFn.seq (compiledRawReplay false ls) (compiledCell false l.1.1 l.1.2)

def compiledBasePacket {n : Nat} (divide : Bool) (j : Nat) : CatFn n :=
  CatFn.seq
    (CatFn.seq (CatFn.compileProg (base 1541) (base 1026) (History5.decode base (5 * j)))
      (compiledRawReplay divide (Replay5.letters j)))
    (CatFn.compileProg (base 1541) (base 1026) (History5.encode base (5 * j)))

def compiledPacket {n : Nat} (divide : Bool) (j : Nat) : CatFn n :=
  CatFn.map (shifted (Placement5.pi j)) (compiledBasePacket divide j)

def compiledGroups {n : Nat} (divide : Bool) : Nat → Nat → CatFn n
  | _, 0 => CatFn.noT List.nil
  | j, m + 1 =>
    if divide then CatFn.seq (compiledPacket true j) (compiledGroups true (j + 1) m)
    else CatFn.seq (compiledGroups false (j + 1) m) (compiledPacket false j)

def compiledFirstSwap {n : Nat} : CatFn n :=
  compiledSelW (base 1028) (base 2410) compiledSwapBody

def compiledFirstSwapM {n : Nat} : CatFn n :=
  compiledSelW (base 1028) (base 2410) (CatFn.noT SW.swapBodyM)

def compiledFirstBody {n : Nat} (divide : Bool) : CatFn n :=
  if divide then
    CatFn.seq compiledFirstSwap
      (CatFn.seq (compiledZCell (tapeLetter 1).1.1 (tapeLetter 1).1.2)
        (compiledRawReplay true OneBankReplay5.firstTailLetters))
  else
    CatFn.seq (compiledRawReplay false Replay5.restLetters) compiledFirstSwapM

def compiledBaseFirstPacket {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.seq
    (CatFn.seq (CatFn.compileProg (base 1541) (base 1026) (History5.decode base 0))
      (compiledFirstBody divide))
    (CatFn.compileProg (base 1541) (base 1026) (History5.encode base 0))

def compiledFirstPacket {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.map (shifted (Placement5.pi 0)) (compiledBaseFirstPacket divide)

def compiledRawEnd {n : Nat} (divide : Bool) : CatFn n :=
  compiledSelW (base 510) (base 2409) (compiledHalfE divide)

def compiledEndPacket {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.map (shifted Placement5.pi0) (compiledRawEnd divide)

def compiledLogicalReplayS {n : Nat} (divide : Bool) : CatFn n :=
  if divide then
    CatFn.seq (CatFn.seq (compiledFirstPacket true) (compiledGroups true 1 101)) (compiledEndPacket true)
  else
    CatFn.seq (CatFn.seq (compiledEndPacket false) (compiledGroups false 1 101)) (compiledFirstPacket false)

def compiledReplayS {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.map (OB5.sig 511) (compiledLogicalReplayS divide)

attribute [local irreducible] compiledBasePacket compiledPacket
  compiledFirstSwap compiledFirstSwapM compiledFirstBody compiledBaseFirstPacket
  compiledFirstPacket compiledRawEnd compiledEndPacket compiledLogicalReplayS compiledReplayS

-- History5 codec helpers
private theorem history_codec_avoid_ry_work (start : Nat) (hs : start + 5 ≤ 510)
    (P : ECDSAAdd.Program) (hP : P = History5.encode base start ∨ P = History5.decode base start) :
    (∀ q ∈ cellLayout.r, q ∉ ECDSAAdd.wires P) ∧
    (∀ q ∈ cellLayout.y, q ∉ ECDSAAdd.wires P) ∧
    (∀ q ∈ OneBankCell5.workIds.map base, q ∉ ECDSAAdd.wires P) ∧
    base 1541 ∉ ECDSAAdd.wires P ∧ base 1026 ∉ ECDSAAdd.wires P := by
  have hmem (q : Wire) (hq : q ∈ ECDSAAdd.wires P) : ∃ i, q = base i ∧ (i < 510 ∨ (1028 ≤ i ∧ i < 1538)) := by
    obtain ⟨u, rfl⟩ := History5.history_gate_mem base start P hP q hq
    refine ⟨History5.historyId start u, rfl, ?_⟩
    have hu := u.isLt
    unfold History5.historyId
    split <;> omega
  refine ⟨fun q hqr hqp => ?_, fun q hqy hqp => ?_, fun q hqw hqp => ?_, fun hqp => ?_, fun hqp => ?_⟩
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp; exact cell_base_not_r i (by omega) hqr
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp; exact cell_base_not_y i (by omega) hqy
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp
    obtain ⟨j, hj, he⟩ := List.mem_map.mp hqw
    have := MappedCompressed.base_injective he; subst this
    simp only [OneBankCell5.workIds, List.mem_append, List.mem_cons, List.not_mem_nil,
      List.mem_range'_1, or_false] at hj
    omega
  · obtain ⟨i, he, hi⟩ := hmem _ hqp; have := MappedCompressed.base_injective he; omega
  · obtain ⟨i, he, hi⟩ := hmem _ hqp; have := MappedCompressed.base_injective he; omega

