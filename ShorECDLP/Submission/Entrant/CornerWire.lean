  have ha0 : AddrValid WideBank8.Fast16.windowBits windowRoot a ⟨false, s⟩ := ⟨rfl, hs.2.2⟩
  have hstep01 := r₁ a ⟨false, s⟩ ha0 hclean_all.1 (fun m' hm' => (hclean_all.2 m' hm').1) hsafe_sp0.1
