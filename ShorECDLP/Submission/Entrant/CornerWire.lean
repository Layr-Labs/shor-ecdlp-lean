  | cons l ls ih =>
    cases divide
    · refine (CatFn.seq_shiftFin _ _ ih (compiledCell_shiftFin false l.1.1 l.1.2)).mono ?_
      simp only [SW.rawReplayS, Bool.false_eq_true, if_false, ECDSAAdd.measurementCount_append,
        ECDSAAdd.toffoliCount_append]; omega
    · refine (CatFn.seq_shiftFin _ _ (compiledCell_shiftFin true l.1.1 l.1.2) ih).mono ?_
      simp only [SW.rawReplayS, if_true, ECDSAAdd.measurementCount_append,
