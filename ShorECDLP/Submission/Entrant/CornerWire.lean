  omega

theorem compiledRawSub_tCount {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compiledRawSub (n := n) start).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (TopReuse.rawSub cellLayout) := by
