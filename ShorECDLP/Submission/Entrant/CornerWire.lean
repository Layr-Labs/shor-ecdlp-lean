  refine (CatFn.seq_shiftFin _ _ (CatFn.seq_shiftFin _ _ (CatFn.compileProg_shiftFin _ _ _)
    (compiledRawReplay_shiftFin divide _)) (CatFn.compileProg_shiftFin _ _ _)).mono ?_
