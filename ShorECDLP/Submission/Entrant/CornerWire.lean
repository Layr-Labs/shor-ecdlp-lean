theorem midWTP_relation :
    midWTP + PoolHost.hostCodeExtra (wLiteral (n := 32768) (arithS streamLayout false)) +
        PoolHost.hostCodeExtra (wLiteral (n := 32768) (arithS streamLayout true)) =
      WideBank8.Fast16.fcodeTP CornerWire.Wide16.midW + 4 +
        ECDSAAdd.Baselines.repeatedControls (arithS streamLayout false) +
        ECDSAAdd.Baselines.repeatedControls (arithS streamLayout true) := by
  have h1 : WideBank8.Fast16.fcodeTP CornerWire.Wide16.midW =
      WideBank8.Fast16.fblockTP midB0 + (WideBank8.Fast16.fblockTP midB1 + (WideBank8.Fast16.fblockTP midB2 +
      (WideBank8.Fast16.fblockTP midB3 + (WideBank8.Fast16.fblockTP midB4 + (WideBank8.Fast16.fblockTP midB5 +
      (WideBank8.Fast16.fblockTP midB6 + (WideBank8.Fast16.fblockTP midB7 + WideBank8.Fast16.fblockTP midB8))))))) :=
    (congrArg WideBank8.Fast16.fcodeTP midW_eq_list).trans (fcodeTP_9 midB0 midB1 midB2 midB3 midB4 midB5 midB6 midB7 midB8)
  have hm1 : midB1 = .std (.plain (Rows.code r16 (wLiteral (arithS streamLayout false)))) := rfl
  have hm6 : midB6 = .std (.plain (Rows.code r16 (wLiteral (arithS streamLayout true)))) := rfl
  have hF : WideBank8.Fast16.fblockTP midB1 + ECDSAAdd.Baselines.repeatedControls (arithS streamLayout false) =
      ECDSAAdd.toffoliCount (arithS streamLayout false) +
        PoolHost.hostCodeExtra (wLiteral (n := 32768) (arithS streamLayout false)) :=
    (congrArg (fun b => WideBank8.Fast16.fblockTP b + _) hm1).trans (hb_arith_gen (arithS streamLayout false))
  have hT : WideBank8.Fast16.fblockTP midB6 + ECDSAAdd.Baselines.repeatedControls (arithS streamLayout true) =
      ECDSAAdd.toffoliCount (arithS streamLayout true) +
        PoolHost.hostCodeExtra (wLiteral (n := 32768) (arithS streamLayout true)) :=
    (congrArg (fun b => WideBank8.Fast16.fblockTP b + _) hm6).trans (hb_arith_gen (arithS streamLayout true))
  have hmain := midWTP_rel_arith
    (WideBank8.Fast16.fblockTP midB0) (WideBank8.Fast16.fblockTP midB1)
    (WideBank8.Fast16.fblockTP midB2) (WideBank8.Fast16.fblockTP midB3)
    (WideBank8.Fast16.fblockTP midB4) (WideBank8.Fast16.fblockTP midB5)
    (WideBank8.Fast16.fblockTP midB6) (WideBank8.Fast16.fblockTP midB7)
    (WideBank8.Fast16.fblockTP midB8)
    (ECDSAAdd.toffoliCount (arithS streamLayout false))
    (ECDSAAdd.toffoliCount (arithS streamLayout true))
    (PoolHost.hostCodeExtra (wLiteral (n := 32768) (arithS streamLayout false)))
    (PoolHost.hostCodeExtra (wLiteral (n := 32768) (arithS streamLayout true)))
    (ECDSAAdd.Baselines.repeatedControls (arithS streamLayout false))
    (ECDSAAdd.Baselines.repeatedControls (arithS streamLayout true))
    hF hT
  exact hmain.trans (congrArg (fun x => x + 4 + _ + _) h1.symm)

