abbrev base : Nat → Wire := MappedCompressed.base
abbrev cellLayout : BalancedCircuit.Layout := OneBankCell5.ports base (base 2409)

def CellClean (s : BasisState) : Prop :=
  s (base 1797) = false ∧ s (base 1027) = false ∧ ∀ w ∈ cellLayout.carry, s w = false

theorem cellLayout_widths : cellLayout.Widths := OneBankCell5.ports_widths base (base 2409)

theorem cellLayout_nodup : cellLayout.wires.Nodup :=
  OneBankCell5.ports_nodup_injective base (base 2409) MappedCompressed.base_injective (by
    intro h; obtain ⟨i, hi, he⟩ := List.mem_map.mp h
    have := MappedCompressed.base_injective he; have := OneBankCell5.ids_bound i hi; omega)

theorem cellLayout_lower : cellLayout.lower = base 1797 := rfl
theorem cellLayout_one : cellLayout.one = base 1027 := rfl
theorem cellLayout_sign : cellLayout.sign = base 2409 := rfl
theorem cellLayout_parity : cellLayout.parity = base 768 := rfl

theorem base_1541_mem_carry : base 1541 ∈ cellLayout.carry := by
  simp [cellLayout, OneBankCell5.ports]

theorem base_1026_mem_carry : base 1026 ∈ cellLayout.carry := by
  simp [cellLayout, OneBankCell5.ports]

theorem base_1026_mem_carry_tail : base 1026 ∈ cellLayout.carry.tail := by
  simp [cellLayout, OneBankCell5.ports, wireBlock, List.range'_succ]

theorem cellLayout_carry_take254_ne (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ cellLayout.carry.take 254 := by
  have ht : cellLayout.carry.take 254 = wireBlock base 512 253 ++ [base 1540] := by
    have hlen : (wireBlock base 512 253).length = 253 := wireBlock_length base 512 253
    change (wireBlock base 512 253 ++ [base 1540, base 1541, base 1026]).take 254 = _
    rw [List.take_append, List.take_of_length_le (by omega), hlen]; rfl
  rw [ht]
  intro hm
  simp only [List.mem_append, List.mem_singleton, wireBlock, List.mem_map, List.mem_range'_1] at hm
  rcases hm with ⟨i, hi, he⟩ | he
  · have := MappedCompressed.base_injective he; omega
  · have := MappedCompressed.base_injective he; omega

-- Helper: `OneBankCell5.ports` rawAdd / rawSub nodup & disjointness
theorem cell_rawAdd_nd :
    (base 1797 :: cellLayout.sign :: (BalancedCircuit.rawTarget cellLayout ++ cellLayout.carry)).Nodup := by
  apply List.nodup_iff_count.mpr; intro w
  have h := List.nodup_iff_count.mp cellLayout_nodup w
  simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
    BalancedCleanup.Layout.low, BalancedCircuit.rawTarget, cellLayout_lower, cellLayout_sign,
    List.count_cons, List.count_append, List.count_nil] at h ⊢
  omega

theorem cell_rawAdd_disj :
    List.Disjoint (GuardCompression.source cellLayout)
      (base 1797 :: cellLayout.sign :: (BalancedCircuit.rawTarget cellLayout ++ cellLayout.carry)) := by
  intro w hw1 hw2
  have h := List.nodup_iff_count.mp cellLayout_nodup w
  have hp1 : 0 < List.count w cellLayout.y := by
    simp only [GuardCompression.source, List.mem_append, List.mem_singleton] at hw1
    apply List.count_pos_iff.mpr
    rcases hw1 with hw1 | rfl
    · exact hw1
    · simp [BalancedCleanup.Layout.y]
  have hp2 := List.count_pos_iff.mpr hw2
  simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
    BalancedCleanup.Layout.low, BalancedCleanup.Layout.y, BalancedCircuit.rawTarget, cellLayout_lower,
    cellLayout_sign, List.count_cons, List.count_append, List.count_nil] at h hp1 hp2
  omega

theorem cell_cmp_nd :
    (cellLayout.parity :: cellLayout.one :: (cellLayout.y ++ cellLayout.r ++ cellLayout.carry)).Nodup := by
  apply List.nodup_iff_count.mpr; intro w
  have h := List.nodup_iff_count.mp cellLayout_nodup w
  simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
    BalancedCleanup.Layout.low, BalancedCleanup.Layout.y, List.count_cons, List.count_append,
    List.count_nil] at h ⊢
  omega

