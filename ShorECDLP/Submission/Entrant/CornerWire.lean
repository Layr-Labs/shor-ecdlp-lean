theorem compiledCornerFused_sim (coeffs : Fin 65536 → PointCoeff) (Q : Secp256k1.Point)
    (oS : List Bool) (hoS : oS.length = 2058)
    (s : Nat) (refsS : List (Fin s)) (h : Fin s → Bool) (hrefs : refsS.map h = oS) :
