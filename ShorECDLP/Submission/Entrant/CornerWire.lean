  have h12 := CatFn.seq_catLitSim _ _ compiledZForward_indep ([.X (base 2409)]) (FirstZero5.forward cellLayout)
    CellClean CellClean h1 compiledZForward_catLitSim (fun st m hc _ => x2409_pres_clean st m hc)
  rw [compiledZHalf, FirstZero5.half]
  exact CatFn.seq_catLitSim _ _ (CatFn.noT_indep _) _ ([.X (base 2409)]) CellClean (fun _ => True) h12
    (CatFn.noT_catLitSim (base 1026) _ x2409_avoid_1026) (fun _ _ _ _ => trivial) s read h

