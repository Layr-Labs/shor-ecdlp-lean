  exact CatFn.swapSurround_removed18 _ _ _
    (CatFn.seq_removed18 _ _ (CatFn.seq_removed18 _ _ (CatFn.noT_removed18 _) (compileAddInPlace_removed18 _ _ _ _ _))
      (CatFn.noT_removed18 _)) start

