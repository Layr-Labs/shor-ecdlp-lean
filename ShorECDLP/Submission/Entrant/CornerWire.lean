      have h12 := CatFn.seq_catLitSim _ _ (compiledFirstBody_indep true) _ _ CellValidZero CellValidZero h1 hfb_sim
        (fun st m hv _ => cell_run_outside_pres_validZero _ st m hdec.1 hdec.2.1 hdec.2.2.1 hv)
      exact CatFn.seq_catLitSim _ _ (CatFn.compileProg_indep _ _ _) _ _ CellValidZero _ h12
