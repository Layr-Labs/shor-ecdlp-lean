-- Universal `Straight.append` T-count upper bound (works even when continuation `q` depends on history!)
private theorem b_append_tCount_le {n s m e : Nat} (p : Straight n s m) (q : Straight n m e)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) (t2 : Nat)
    (hq : ∀ h' : Fin m → Bool, (q.instantiate read h').tCount ≤ t2) :
    ((p.append q).instantiate read h).tCount ≤ (p.instantiate read h).tCount + t2 := by
  induction p with
  | done =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount, Nat.zero_add]
    exact hq h
  | gate g p ih =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount]
    have h1 := ih q h hq
    omega
  | recordGate i v g p ih =>
    by_cases hv : h i = v <;>
    · simp only [Straight.append, Straight.instantiate, hv, if_true, if_false, AdaptiveCircuit.tCount]
      have h1 := ih q h hq
      omega
  | measure w p ih =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount]
    have h0 := ih q (Fin.lastCases false h) hq
    have h1 := ih q (Fin.lastCases true h) hq
    omega

-- Step combinator: run `CatFn` `f` then continuation `k` with cast history references (zero `castFinish`!)
def stepCatFn {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (start : Nat) (refs : List (Fin start)) : CatProg n start :=
  let a := f start
  let b := k a.finish (refs.map (Fin.castLE (straight_start_le_finish a.prog)))
  ⟨b.finish, a.prog.append b.prog⟩

private theorem stepCatFn_finish {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (D1 D2 : Nat) (hf : ∀ s, (f s).finish = s + D1) (hk : ∀ c rs, (k c rs).finish = c + D2)
    (start : Nat) (refs : List (Fin start)) :
    (stepCatFn f k start refs).finish = start + (D1 + D2) := by
  change (k (f start).finish _).finish = _
  rw [hk, hf, Nat.add_assoc]

private theorem stepCatFn_removed18 {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (hf : ∀ s, removed 18 (f s).prog = 0) (hk : ∀ c rs, removed 18 (k c rs).prog = 0)
    (start : Nat) (refs : List (Fin start)) :
    removed 18 (stepCatFn f k start refs).prog = 0 := by
  change removed 18 ((f start).prog.append _) = 0
  rw [LocalFour.removed_append, hf, hk]

private theorem stepCatFn_tCount_le {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (T1 T2 : Nat) (read : ConstantBit n → Bool)
    (hf : ∀ s h, ((f s).prog.instantiate read h).tCount ≤ T1)
    (hk : ∀ c rs hh, ((k c rs).prog.instantiate read hh).tCount ≤ T2)
    (start : Nat) (refs : List (Fin start)) (h : Fin start → Bool) :
    ((stepCatFn f k start refs).prog.instantiate read h).tCount ≤ T1 + T2 := by
  change (((f start).prog.append _).instantiate read h).tCount ≤ T1 + T2
  exact (b_append_tCount_le _ _ read h T2 (fun h' => hk _ _ h')).trans (Nat.add_le_add_right (hf start h) T2)

private theorem stepCatFn_slots_le {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (S1 S2 : Nat) (hf : ∀ s, (f s).prog.gateSlots ≤ S1) (hk : ∀ c rs, (k c rs).prog.gateSlots ≤ S2)
    (start : Nat) (refs : List (Fin start)) :
    (stepCatFn f k start refs).prog.gateSlots ≤ S1 + S2 := by
  change ((f start).prog.append _).gateSlots ≤ S1 + S2
  rw [Straight.gateSlots_append]
  exact Nat.add_le_add (hf start) (hk _ _)

private theorem stepCatFn_wires {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    {S : List Wire} (hf : ∀ s, ChallengeMigration.straightWires (f s).prog ⊆ S)
    (hk : ∀ c rs, ChallengeMigration.straightWires (k c rs).prog ⊆ S)
    (start : Nat) (refs : List (Fin start)) :
    ChallengeMigration.straightWires (stepCatFn f k start refs).prog ⊆ S := by
  change ChallengeMigration.straightWires ((f start).prog.append _) ⊆ S
  rw [straightWires_append]
  exact List.append_subset.mpr ⟨hf start, hk _ _⟩

private theorem stepCatFn_wellFormed {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (hf : ∀ s, (f s).prog.WellFormed) (hk : ∀ c rs, (k c rs).prog.WellFormed)
    (start : Nat) (refs : List (Fin start)) :
    (stepCatFn f k start refs).prog.WellFormed :=
  straight_append_wellFormed _ _ (hf start) (hk _ _)

private theorem stepCatFn_sim {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (read : ConstantBit n → Bool) (start : Nat) (refs : List (Fin start)) (h : Fin start → Bool)
    (P₁ P₂ Q : InstrumentBranch → ℂ → Prop)
    (hf : ∃ cs₁ : List ℂ, List.Forall₂ P₁ ((f start).prog.instantiate read h).run cs₁ ∧
      (cs₁.map Complex.normSq).sum = 1)
    (hk : ∀ (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool), rs.map hh = refs.map h →
      ∃ cs₂ : List ℂ, List.Forall₂ P₂ ((k c rs).prog.instantiate read hh).run cs₂ ∧
        (cs₂.map Complex.normSq).sum = 1)
    (hcomb : ∀ b₁ c₁ b₂ c₂, P₁ b₁ c₁ → P₂ b₂ c₂ → Q (b₁.seq b₂) (c₁ * c₂)) :
    ∃ cs : List ℂ, List.Forall₂ Q ((stepCatFn f k start refs).prog.instantiate read h).run cs ∧
      (cs.map Complex.normSq).sum = 1 := by
  obtain ⟨cs₁, ha₁, hm₁⟩ := hf
  obtain ⟨cs, hal, hm⟩ := append_sim_forall2 (f start).prog
    (k (f start).finish (refs.map (Fin.castLE (straight_start_le_finish (f start).prog)))).prog
    read h P₁ P₂ Q cs₁ ha₁
    (fun h' hh' => hk _ _ h' (by rw [List.map_map]; exact List.map_congr_left (fun i _ => hh' i)))
    hcomb
  exact ⟨cs, hal, hm.trans hm₁⟩

-- Commutativity of `xResetRegisterKraus` with `Prep y` when `y ∉ ws`
private theorem xResetRegisterKraus_prep (y : Wire) (ws : List Wire) (hy : y ∉ ws) :
    ∀ (os : List Bool) (psi : State),
      xResetRegisterKraus ws os (Prep y psi) = Prep y (xResetRegisterKraus ws os psi) := by
  induction ws with
  | nil =>
    intro os psi
    cases os with
    | nil => rfl
    | cons _ _ => simp only [xResetRegisterKraus, LinearMap.zero_apply, map_zero]
  | cons w ws ih =>
    intro os psi
    cases os with
    | nil => simp only [xResetRegisterKraus, LinearMap.zero_apply, map_zero]
    | cons o os =>
      have hyw : y ≠ w := fun e => hy (e ▸ List.mem_cons_self)
      have hyws : y ∉ ws := fun hm => hy (List.mem_cons_of_mem _ hm)
      rw [xResetRegisterKraus, LinearMap.comp_apply, LinearMap.comp_apply,
        Catalyst.prepare_reset y w hyw o psi, ih hyws os]

-- Commutativity of `xResetRegisterKraus` applied to `Prep y (Bridge.signedKet st)`
private theorem xResetRegisterKraus_prep_signedKet (y : Wire) (ws : List Wire) (os : List Bool)
    (st : ECDSAAdd.State) (hy : y ∉ ws) (ho : os.length = ws.length) (hnd : ws.Nodup) :
    xResetRegisterKraus ws os (Prep y (Bridge.signedKet st)) =
      (registerXResetMagnitude ws.length * registerXPhase ws os st.basis) •
        Prep y (Bridge.signedKet ⟨st.phase, clearRegister ws st.basis⟩) := by
  rw [xResetRegisterKraus_prep y ws hy os, signedKet_smul_eq, signedKet_smul_eq,
    map_smul, map_smul, map_smul, xResetRegisterKraus_ket ws os st.basis ho hnd,
    registerXResetCoeff_eq_magnitude_mul_phase ws os st.basis ho, map_smul, smul_smul, smul_smul]
  exact congrArg (· • _) (by ring)

private theorem phase_cancel_prep (mag c prev p : ℂ) (hp : p * p = 1) :
    mag * p * (c * (prev * p)) = mag * c * prev := by
  calc mag * p * (c * (prev * p)) = (mag * c * prev) * (p * p) := by ring
    _ = mag * c * prev := by rw [hp, mul_one]

private theorem phase_cancel_prep_0 (mag c p : ℂ) (hp : p * p = 1) :
    mag * p * (c * p) = mag * c := by
  calc mag * p * (c * p) = (mag * c) * (p * p) := by ring
    _ = mag * c := by rw [hp, mul_one]

-- Helper for lifting `CatProg.lit` prepend/append on `Forall₂`
private theorem b_literal_append_run {n s e : Nat} (gs : Circuit) (p : Straight n s e)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    (((literalProgram (n := n) (s := s) gs).append p).instantiate read h).run =
      (p.instantiate read h).run.map (fun br => ⟨br.history, br.kraus.comp (Quantum.run gs)⟩) := by
  induction gs with
  | nil =>
    change (p.instantiate read h).run = _
    have he : (fun br : InstrumentBranch => (⟨br.history, br.kraus.comp (Quantum.run ([] : Circuit))⟩ : InstrumentBranch)) = id := by
      funext br; cases br; simp only [id_eq, InstrumentBranch.mk.injEq, true_and]
      apply LinearMap.ext; intro psi; simp only [LinearMap.comp_apply, Quantum.run_nil]
    rw [he, List.map_id]
  | cons g gs ih =>
    change ((((literalProgram gs).append p).instantiate read h).run.map
      (fun br : InstrumentBranch => (⟨br.history, br.kraus.comp (Quantum.run [g])⟩ : InstrumentBranch))) = _
    rw [ih, List.map_map]
    apply List.map_congr_left
    intro br _; cases br
    simp only [Function.comp_def, InstrumentBranch.mk.injEq, true_and]
    apply LinearMap.ext; intro psi
    simp only [LinearMap.comp_apply, Quantum.run_cons, Quantum.run_singleton, Quantum.run_nil]

private theorem b_flatMap_singleton {α β : Type*} (f : α → β) (l : List α) :
    l.flatMap (fun x => [f x]) = l.map f := by
  induction l with
  | nil => rfl
  | cons x xs ih => simp only [List.flatMap_cons, List.singleton_append, List.map_cons, ih]

private theorem b_catProg_surround_run {n start : Nat} (c₁ c₂ : Circuit)
    (body : CatProg n start) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((((CatProg.lit (n := n) (start := start) c₁).append body).append
        (CatProg.lit (n := n) (start := body.finish) c₂)).prog.instantiate read h).run =
      (body.prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run c₂).comp br.kraus).comp (Quantum.run c₁)⟩) := by
  rw [CatProg.append, indep_append_run _ _ (CatProg.lit_indep c₂) read h,
    AdaptiveCircuit.run_seq, CatProg.lit_run, CatProg.append]
  dsimp only [CatProg.lit, Instrument.seq, List.map_singleton]
  rw [b_literal_append_run c₁ body.prog read h, b_flatMap_singleton, List.map_map]
  apply List.map_congr_left
  intro br _; cases br
  simp only [Function.comp_def, InstrumentBranch.seq, List.append_nil, LinearMap.comp_assoc]

private theorem b_catProg_swapSurround_run {n start : Nat} (y₁ y₂ : Wire)
    (body : CatProg n start) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((((CatProg.lit (n := n) (start := start) (swapCircuit y₁ y₂)).append body).append
        (CatProg.lit (n := n) (start := body.finish) (swapCircuit y₂ y₁))).prog.instantiate read h).run =
      (body.prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run (swapCircuit y₂ y₁)).comp br.kraus).comp (Quantum.run (swapCircuit y₁ y₂))⟩) :=
  b_catProg_surround_run (swapCircuit y₁ y₂) (swapCircuit y₂ y₁) body read h

private theorem b_catFn_swapSurround_run {n : Nat} (y₁ y₂ : Wire) (body : CatFn n)
    (hbi : ∀ s, Indep (body s).prog) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.swapSurround y₁ y₂ body s).prog.instantiate read h).run =
      ((body s).prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run (swapCircuit y₂ y₁)).comp br.kraus).comp (Quantum.run (swapCircuit y₁ y₂))⟩) := by
  rw [CatFn.swapSurround, CatFn.seq, CatFn.seq, CatFn.lit, CatFn.lit]
  exact b_catProg_surround_run (swapCircuit y₁ y₂) (swapCircuit y₂ y₁) (body s) read h


private theorem b_seq_tCount_any {n : Nat} (a b : CatFn n) {ta tb : Nat}
    (ha : ∀ s r h, ((a s).prog.instantiate r h).tCount ≤ ta)
    (hb : ∀ s r h, ((b s).prog.instantiate r h).tCount ≤ tb)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.seq a b s).prog.instantiate read h).tCount ≤ ta + tb := by
  rw [CatFn.seq, CatProg.append]
  exact (b_append_tCount_le (a s).prog (b (a s).finish).prog read h tb (fun h' => hb _ read h')).trans
    (Nat.add_le_add_right (ha s read h) tb)

private theorem b_seq_catCoherent {n : Nat} (y : Wire) (a b : CatFn n) (read : ConstantBit n → Bool)
    (f g : BasisState → BasisState) (V₁ V₂ : BasisState → Prop)
    (ha : ∀ s h, CatCoherent y ((a s).prog.instantiate read h) (Finsupp.lmapDomain ℂ ℂ f) V₁)
    (hb : ∀ s h, CatCoherent y ((b s).prog.instantiate read h) (Finsupp.lmapDomain ℂ ℂ g) V₂)
    (hstep : ∀ bs, V₁ bs → V₂ (f bs)) (s : Nat) (h : Fin s → Bool) :
    CatCoherent y ((CatFn.seq a b s).prog.instantiate read h)
      (Finsupp.lmapDomain ℂ ℂ (g ∘ f)) V₁ := by
  obtain ⟨cs₁, al₁, m₁⟩ := ha s h
  rw [CatFn.seq, CatProg.append]
  obtain ⟨cs, al, hm⟩ := append_sim_forall2 (a s).prog (b (a s).finish).prog read h
    (fun br c => ∀ bs, V₁ bs → br.kraus (Prep y (ket bs)) = c • Prep y (Finsupp.lmapDomain ℂ ℂ f (ket bs)))
    (fun br c => ∀ bs, V₂ bs → br.kraus (Prep y (ket bs)) = c • Prep y (Finsupp.lmapDomain ℂ ℂ g (ket bs)))
    (fun br c => ∀ bs, V₁ bs → br.kraus (Prep y (ket bs)) = c • Prep y (Finsupp.lmapDomain ℂ ℂ (g ∘ f) (ket bs)))
    cs₁ al₁
    (fun h' _ => hb (a s).finish h')
    (fun b₁ c₁ b₂ c₂ hb₁ hb₂ bs hbs => by
      have hl1 : Finsupp.lmapDomain ℂ ℂ f (ket bs) = ket (f bs) := by
        simp [ket, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      have hl2 : Finsupp.lmapDomain ℂ ℂ g (ket (f bs)) = ket (g (f bs)) := by
        simp [ket, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      have hl3 : Finsupp.lmapDomain ℂ ℂ (g ∘ f) (ket bs) = ket (g (f bs)) := by
        simp [ket, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      dsimp only [InstrumentBranch.seq]
      rw [LinearMap.comp_apply, hb₁ bs hbs, hl1, map_smul, hb₂ (f bs) (hstep bs hbs), hl2, hl3, smul_smul])
  exact ⟨cs, al, hm.trans m₁⟩

private theorem swapCircuit_prep_signedKet (y w : Wire) (hne : y ≠ w)
    (st : ECDSAAdd.State) (hy : st.basis y = false) (hw : st.basis w = false) :
    Quantum.run (swapCircuit y w) (Prep y (Bridge.signedKet st)) = Prep w (Bridge.signedKet st) := by
  rw [signedKet_smul_eq, map_smul, map_smul, map_smul, swapCircuit_prep_ket y w hne st.basis hy hw]

private theorem supportedOn_signedKet {P : BasisState → Prop} (st : ECDSAAdd.State) (h : P st.basis) :
    SupportedOn P (Bridge.signedKet st) := by
  intro u hu
  by_cases heq : st.basis = u
  · exact heq ▸ h
  · exfalso
    rw [signedKet_smul_eq, Finsupp.smul_apply, ket, Finsupp.single_eq_of_ne (Ne.symm heq)] at hu
    simp at hu

private theorem stepCatFn_shiftFin {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (B1 B2 : Nat) (hf : ShiftFin f B1)
    (hk : ∃ D2, (∀ c rs, (k c rs).finish = c + D2) ∧ D2 ≤ B2) :
    ∃ D, (∀ s rs, (stepCatFn f k s rs).finish = s + D) ∧ D ≤ B1 + B2 := by
  obtain ⟨D2, hk1, hk2⟩ := hk
  exact ⟨(f 0).finish + D2, fun s rs => stepCatFn_finish f k (f 0).finish D2 hf.1 hk1 s rs, Nat.add_le_add hf.2 hk2⟩

private theorem measureThen_shiftFin {n : Nat} (k : (c : Nat) → List (Fin c) → CatProg n c)
    (ws : List Wire) (B : Nat)
    (hk : ∃ D, (∀ c rs, (k c rs).finish = c + D) ∧ D ≤ B) :
    ∃ D', (∀ s rs, (CatProg.measureThen k ws s rs).finish = s + D') ∧ D' ≤ ws.length + B := by
  obtain ⟨D, hk1, hk2⟩ := hk
  exact ⟨ws.length + D, fun s rs => CatProg.measureThen_finish k D hk1 ws s rs, Nat.add_le_add_left hk2 _⟩

private theorem portPhase_mul_self {n : Nat} (data : List (MeasuredClear.ClearPort n))
    (outcomes : List Bool) (read : ConstantBit n → Bool) (a : Nat) :
    portPhase data outcomes read a * portPhase data outcomes read a = 1 := by
  induction data generalizing outcomes with
  | nil => simp [portPhase]
  | cons q qs ih =>
    cases outcomes with
    | nil => simp [portPhase]
    | cons o os =>
      simp only [portPhase]
      have h1 : (if o && decide (read (q.ref a) = q.value) then (-1 : ℂ) else 1) *
          (if o && decide (read (q.ref a) = q.value) then (-1 : ℂ) else 1) = 1 := by
        split_ifs <;> norm_num
      calc _ = ((if o && decide (read (q.ref a) = q.value) then (-1 : ℂ) else 1) *
                (if o && decide (read (q.ref a) = q.value) then (-1 : ℂ) else 1)) *
               (portPhase qs os read a * portPhase qs os read a) := by ring
        _ = 1 := by rw [h1, ih os, mul_one]

private theorem b_catFn_compileProg_tCount {n : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.compileProg (n := n) q y P s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount P :=
  CatFn.compileProg_tCount q y P s read h

private theorem b_catFn_compileProg_finish_le {n : Nat} (q y : Wire) (P : ECDSAAdd.Program) (s : Nat) :
    (CatFn.compileProg (n := n) q y P s).finish ≤
      s + (ECDSAAdd.measurementCount P + ECDSAAdd.toffoliCount P) := by
  have h := CatFn.compileProg_shiftFin (n := n) q y P
  have hf := h.1 s
  have hb := h.2
  (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

private theorem b_catFn_lit_finish {n : Nat} (gs : Circuit) (s : Nat) :
    (CatFn.lit (n := n) gs s).finish = s := by rw [CatFn.lit]; rfl

private theorem b_catFn_seq_finish {n : Nat} (a b : CatFn n) (D1 D2 : Nat)
    (ha : ∀ s, (a s).finish = s + D1) (hb : ∀ s, (b s).finish = s + D2) (s : Nat) :
    (CatFn.seq a b s).finish = s + (D1 + D2) := by
  rw [CatFn.seq, CatProg.append, hb, ha, Nat.add_assoc]

private theorem b_catFn_surround_run {n : Nat} (c₁ c₂ : Circuit) (body : CatFn n)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.seq (CatFn.seq (CatFn.lit (n := n) c₁) body) (CatFn.lit (n := n) c₂) s).prog.instantiate read h).run =
      ((body s).prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run c₂).comp br.kraus).comp (Quantum.run c₁)⟩) := by
  rw [CatFn.seq, CatFn.seq, CatFn.lit, CatFn.lit]
  exact b_catProg_surround_run c₁ c₂ (body s) read h

private theorem catLitSim_to_ket_aux (P : ECDSAAdd.Program) (circ : AdaptiveCircuit)
    (Pred Pred' : BasisState → Prop) (R : BasisState → BasisState → Prop)
    (hsim : CatLitSim 14833 circ P Pred)
    (himp : ∀ bs, Pred' bs → Pred bs)
    (hcorr : ∀ (bs : BasisState) (m : List Bool), Pred' bs →
      (ECDSAAdd.run P m ⟨false, bs⟩).phase = false ∧ R bs (ECDSAAdd.run P m ⟨false, bs⟩).basis) :
    ∃ cs : List ℂ, List.Forall₂
      (fun b c => ∀ bs : BasisState, Pred' bs →
        ∃ bs' : BasisState, R bs bs' ∧ b.kraus (Prep 14833 (ket bs)) = c • Prep 14833 (ket bs'))
      circ.run cs ∧ (cs.map Complex.normSq).sum = 1 := by
  obtain ⟨cs, al, hm⟩ := hsim
  refine ⟨cs, al.imp (fun b c ⟨m, _, hb⟩ bs hp => ?_), hm⟩
  have hc := hcorr bs m hp
  refine ⟨(ECDSAAdd.run P m ⟨false, bs⟩).basis, hc.2, ?_⟩
  have hst : Bridge.signedKet (ECDSAAdd.run P m ⟨false, bs⟩) = ket (ECDSAAdd.run P m ⟨false, bs⟩).basis := by
    cases h : ECDSAAdd.run P m ⟨false, bs⟩ with
    | mk ph b' =>
      rw [h] at hc
      have hph : ph = false := hc.1
      subst hph; exact Bridge.signedKet_false b'
  rw [← Bridge.signedKet_false bs, hb ⟨false, bs⟩ (himp bs hp), hst]

attribute [local irreducible] Straight.gateSlots ChallengeMigration.straightWires CatProg.measureThen stepCatFn

/-! #### 1. Wire geometry (`1,612` qubits), involution `compact1612`, and `GoodW` specification -/

def bank19 : List Wire := List.range' 855 19
def bitsW (k : Nat) : List Wire := List.range' 855 k
def signBitW (k : Nat) : Wire := 855 + k
def bankW (k : Nat) : List Wire := List.range' 855 (k + 1)
def selBits1W (k : Nat) : List Wire := List.range' 856 (k - 1)
def selBits2W (k : Nat) : List Wire := List.range' 857 (k - 2)
def pathBankW (k : Nat) : List Wire := List.range' 14834 (k - 1)
def selPaths1W (k : Nat) : List Wire := List.range' 14834 (k - 1)
def selPaths2W (k : Nat) : List Wire := List.range' 14834 (k - 2)

def rootWire : Wire := 14851
def guardWire : Wire := 14852

def cxWord : List Wire := List.range' 14374 256
def cyWord : List Wire := 14883 :: List.range' 15399 255
def g1_1 : List Wire := List.range' 14115 256 ++ List.range' 14884 256
def g4_1 : List Wire := List.range' 14115 256
def g4_2 : List Wire := List.range' 14884 256
def g4_3 : List Wire := List.range' 15399 256
def g4 : List Wire := g4_1 ++ g4_2 ++ g4_3

def pool1081 : List Wire :=
  List.range' 14115 515 ++ List.range' 14832 48 ++ List.range' 14883 261 ++ List.range' 15399 257

def support1612 : List Wire :=
  List.range' 263 256 ++ List.range' 580 256 ++ bank19 ++ pool1081

theorem bitsW_length (k : Nat) : (bitsW k).length = k := List.length_range'
theorem bankW_length (k : Nat) : (bankW k).length = k + 1 := List.length_range'
theorem bitsW_nodup (k : Nat) : (bitsW k).Nodup := List.nodup_range'
theorem bankW_nodup (k : Nat) : (bankW k).Nodup := List.nodup_range'
theorem bankW_eq_append (k : Nat) : bankW k = bitsW k ++ [signBitW k] := by
  simp [bankW, bitsW, signBitW, List.range'_concat]
theorem cxWord_length : cxWord.length = 256 := by simp [cxWord]
theorem cyWord_length : cyWord.length = 256 := by simp [cyWord]
theorem g1_1_length : g1_1.length = 512 := by simp [g1_1]
theorem g4_1_length : g4_1.length = 256 := by simp [g4_1]
theorem g4_2_length : g4_2.length = 256 := by simp [g4_2]
theorem g4_3_length : g4_3.length = 256 := by simp [g4_3]
theorem g4_length : g4.length = 768 := by simp [g4, g4_1, g4_2, g4_3]
theorem selBits1W_length (k : Nat) : (selBits1W k).length = k - 1 := List.length_range'
theorem selBits2W_length (k : Nat) : (selBits2W k).length = k - 2 := List.length_range'

theorem mem_bitsW {k : Nat} {w : Wire} : w ∈ bitsW k ↔ 855 ≤ w ∧ w < 855 + k := by
  simp only [bitsW, List.mem_range'_1]

theorem mem_bankW {k : Nat} {w : Wire} : w ∈ bankW k ↔ 855 ≤ w ∧ w < 855 + (k + 1) := by
  simp only [bankW, List.mem_range'_1]

theorem mem_bank19 {w : Wire} : w ∈ bank19 ↔ 855 ≤ w ∧ w < 874 := by
  simp only [bank19, List.mem_range'_1]

theorem mem_pool1081 {w : Wire} :
    w ∈ pool1081 ↔
      (14115 ≤ w ∧ w < 14630) ∨ (14832 ≤ w ∧ w < 14880) ∨
      (14883 ≤ w ∧ w < 15144) ∨ (15399 ≤ w ∧ w < 15656) := by
  simp only [pool1081, List.mem_append, List.mem_range'_1, or_assoc]

theorem mem_support1612 {w : Wire} :
    w ∈ support1612 ↔
      (263 ≤ w ∧ w < 519) ∨ (580 ≤ w ∧ w < 836) ∨ (855 ≤ w ∧ w < 874) ∨
      (14115 ≤ w ∧ w < 14630) ∨ (14832 ≤ w ∧ w < 14880) ∨
      (14883 ≤ w ∧ w < 15144) ∨ (15399 ≤ w ∧ w < 15656) := by
  simp only [support1612, List.mem_append, List.mem_range'_1, mem_bank19, mem_pool1081, or_assoc]

private theorem mem_support1612_x {w : Wire} (h : 263 ≤ w ∧ w < 519) : w ∈ support1612 :=
  mem_support1612.mpr (Or.inl h)
