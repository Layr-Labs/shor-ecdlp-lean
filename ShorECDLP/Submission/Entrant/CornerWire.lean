  refine ⟨bs', hbs'_frame, ?_, ?_, hkr⟩
  · intro q hq
    have hqt : q.target ∈ f.g1 := by
      have hm : q.target ∈ (clearData f.garbPorts).map MeasuredClear.ClearPort.target :=
        List.mem_map.mpr ⟨q, hq, rfl⟩
      rwa [clearData_targets, f.garbPorts_targets hg] at hm
    rw [hbs'_reg q.target (List.mem_append_right _ hqt), hst2.2.2.1 q hq, hs0_gd, Bool.true_and]
  · funext w
    by_cases hwg : w ∈ f.g1
    · rw [clearRegister_clean f.g1 bs' w hwg]
      have hnt : w ∉ portTargets f.ports := fun hm =>
        (List.nodup_append.mp hg.nodup).2.2 w hm w hwg rfl
      rw [tableXorState_outside (portMask read f.ports a) _ _ w (fun hm => hnt (tableBitsMask_subset _ _ hm))]
      have ho := hreg_out w (List.mem_append_right _ hwg)
