          b.kraus (Prep 14833 (ket bs)) = c • Prep 14833 (ket bs'))
      ((wrapSS (f.loadProg 0) s).prog.instantiate read h).run cs ∧ (cs.map Complex.normSq).sum = 1 := by
  obtain ⟨c0, a0, m0⟩ := f.load_sim read hg
  rw [← f.loadProg_run read 0 Fin.elim0] at a0
  have hav := ssSup_avoid_14832_14833 _ hsub
  obtain ⟨c1, a1, m1⟩ := CatFn.lower_lift_raw 14832 14833 (f.loadProg 0) s read h
    (f.loadProg_wellFormed hg 0) hav.1 hav.2 (by decide) _ c0 a0
  refine ⟨c1, ?_, m1.trans m0⟩
  rw [wrapSS,
    b_catFn_surround_run ([.X rootWire, .X guardWire] : Circuit) ([.X rootWire, .X guardWire] : Circuit) _ s read h,
    CatFn.map, CatProg.map, mapStraight_eq_relabel rootSwap rootSwap _ (fun _ _ => rfl),
    relabelStraight_instantiate, AdaptiveCircuit.run_relabel, List.map_map, List.forall₂_map_left_iff]
  refine a1.imp (fun b' k' ⟨b, k, α, hb, hk', hlift⟩ a bs ha hcl => ?_)
  have hrt0 : bs rootWire = false := hcl rootWire (by decide) (by decide) (by decide)
  have hgd0 : bs guardWire = false := hcl guardWire (by decide) (by decide) (by decide)
  have h32_0 : bs 14832 = false := hcl 14832 (by decide) (by decide) (by decide)
  have h33_0 : bs 14833 = false := hcl 14833 (by decide) (by decide) (by decide)
  have hrg_ne : rootWire ≠ guardWire := by decide
  have hsy : rootSwap.symm = rootSwap := by
    ext w; apply rootSwap.injective; rw [Equiv.apply_symm_apply]; exact (Equiv.swap_apply_self windowRoot rootWire w).symm
  have hs33 : rootSwap 14833 = 14833 := by unfold rootSwap; decide
  have hx1 : Quantum.run [.X rootWire, .X guardWire] (Prep 14833 (ket bs)) =
      Prep 14833 (ket (bs[rootWire ↦ true][guardWire ↦ true])) := by
    rw [prep_circuit 14833 ([.X rootWire, .X guardWire] : Circuit) (by decide),
      Quantum.run_cons, Quantum.run_singleton, applyGate_X_ket, hrt0,
      applyGate_X_ket, upd_other _ _ _ hrg_ne.symm, hgd0]; rfl
  set s0 : ECDSAAdd.State := ⟨false, relabelBasis rootSwap (bs[rootWire ↦ true][guardWire ↦ true])⟩
  have hs0_w (w : Wire) : s0.basis w = (bs[rootWire ↦ true][guardWire ↦ true]) (rootSwap w) := by
    change (bs[rootWire ↦ true][guardWire ↦ true]) (rootSwap.symm w) = _; rw [hsy]
  have hrel1 : relabelState rootSwap.symm (Prep 14833 (ket (bs[rootWire ↦ true][guardWire ↦ true]))) =
      Prep 14833 (Bridge.signedKet s0) := by
    rw [relabelState_prep, hsy, hs33, relabelState_ket, Bridge.signedKet_false]
  have hs0_32 : s0.basis 14832 = false := by
    rw [hs0_w, show rootSwap 14832 = 14832 by unfold rootSwap; decide]
    simp [upd, rootWire, guardWire, h32_0]
  have hs0_33 : s0.basis 14833 = false := by
    rw [hs0_w, hs33]; simp [upd, rootWire, guardWire, h33_0]
  have hs0_sv : SimulationValid f.bits f.paths windowRoot a s0 := by
    refine ⟨?_, ?_, ?_⟩
    · intro w hw; rw [hpaths] at hw; simp only [pathBankW, List.mem_range'_1] at hw
      rw [hs0_w, rootSwap, Equiv.swap_apply_of_ne_of_ne (show w ≠ windowRoot by unfold windowRoot; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (show w ≠ rootWire by unfold rootWire; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))]
      simp [upd, show w ≠ rootWire by unfold rootWire; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)),
        show w ≠ guardWire by unfold guardWire; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)),
        hcl w (fun c => by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (fun c => by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (fun c => by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))]
    · rw [hbits, ← ha]; apply WEX.tableAddressValue_congr; intro w hw
      have hwb := mem_bitsW.mp hw
      have hwlt : w < 874 := by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))
      rw [hs0_w, rootSwap, Equiv.swap_apply_of_ne_of_ne (show w ≠ windowRoot by unfold windowRoot; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (show w ≠ rootWire by unfold rootWire; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))]
      simp [upd, show w ≠ rootWire by unfold rootWire; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)), show w ≠ guardWire by unfold guardWire; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))]
    · rw [hs0_w, rootSwap, Equiv.swap_apply_left]; simp [upd, rootWire, guardWire]
  have hs0_cl : Clean (portTargets f.ports ++ f.garb) s0.basis := fun w hw => by
    have hne := hdisj_rg w hw
    have ho := hreg_out w hw
    rw [hs0_w, rootSwap, Equiv.swap_apply_of_ne_of_ne hne.1 hne.2.1]
    simp [upd, hne.2.1, hne.2.2, hcl w ho.1 ho.2.1 ho.2.2]
  set s2 := ECDSAAdd.run f.swapNet List.nil
    (ECDSAAdd.run ((specialize f.selCode (tableAddressValue f.selBits s0.basis)).instantiate read) List.nil s0)
  have hst2 := f.load_state read hg a s0 hs0_sv hs0_cl
  have hs2_ph : s2.phase = false := hst2.1
  have hs0_gd : s0.basis f.guard = true := by
    rw [hguard, hs0_w, show rootSwap guardWire = guardWire by unfold rootSwap; decide]
    simp [upd, rootWire, guardWire]
  have hnr_wr : windowRoot ∉ portTargets f.ports ∧ windowRoot ∉ f.garb :=
    ⟨fun hm => (hdisj_rg _ (List.mem_append_left _ hm)).1 rfl, fun hm => (hdisj_rg _ (List.mem_append_right _ hm)).1 rfl⟩
  have hnr_rt : rootWire ∉ portTargets f.ports ∧ rootWire ∉ f.garb :=
    ⟨fun hm => (hdisj_rg _ (List.mem_append_left _ hm)).2.1 rfl, fun hm => (hdisj_rg _ (List.mem_append_right _ hm)).2.1 rfl⟩
  have hnr_gd : guardWire ∉ portTargets f.ports ∧ guardWire ∉ f.garb :=
    ⟨fun hm => (hdisj_rg _ (List.mem_append_left _ hm)).2.2 rfl, fun hm => (hdisj_rg _ (List.mem_append_right _ hm)).2.2 rfl⟩
  have hs2_wr : s2.basis windowRoot = true := (hst2.2.1 windowRoot hnr_wr.1 hnr_wr.2).trans hs0_sv.2.2
  have hs2_gd : s2.basis guardWire = true := (hst2.2.1 guardWire hnr_gd.1 hnr_gd.2).trans (hguard ▸ hs0_gd)
  let bs' : BasisState := (relabelBasis rootSwap s2.basis)[rootWire ↦ false][guardWire ↦ false]
  have hrel2 : relabelState rootSwap (Prep 14833 (Bridge.signedKet s2)) =
      Prep 14833 (ket (relabelBasis rootSwap s2.basis)) := by
    rw [relabelState_prep, hs33, relabelState_signedKet, hs2_ph, Bridge.signedKet_false]
  have hr2_rt : (relabelBasis rootSwap s2.basis) rootWire = true := by
    change s2.basis (rootSwap.symm rootWire) = true; rw [hsy, rootSwap, Equiv.swap_apply_right]; exact hs2_wr
  have hr2_gd : (relabelBasis rootSwap s2.basis) guardWire = true := by
    change s2.basis (rootSwap.symm guardWire) = true
    rw [hsy, show rootSwap guardWire = guardWire by unfold rootSwap; decide]; exact hs2_gd
  have hx2 : Quantum.run [.X rootWire, .X guardWire] (Prep 14833 (ket (relabelBasis rootSwap s2.basis))) =
      Prep 14833 (ket bs') := by
    rw [prep_circuit 14833 ([.X rootWire, .X guardWire] : Circuit) (by decide),
      Quantum.run_cons, Quantum.run_singleton, applyGate_X_ket, hr2_rt,
      applyGate_X_ket, upd_other _ _ _ hrg_ne.symm, hr2_gd]; rfl
  have hkr : ((Quantum.run [.X rootWire, .X guardWire]).comp
      ((relabelState rootSwap).comp (b'.kraus.comp (relabelState rootSwap.symm))) |>.comp
        (Quantum.run [.X rootWire, .X guardWire])) (Prep 14833 (ket bs)) =
      k' • Prep 14833 (ket bs') := by
    simp only [LinearMap.comp_apply]
    rw [hx1, hrel1, hlift (Bridge.signedKet s0) (supportedOn_signedKet s0 ⟨hs0_32, hs0_33⟩),
      hb a s0 hs0_sv hs0_cl, map_smul, map_smul, map_smul, map_smul, map_smul, hrel2, hx2, smul_smul, hk']
  have hbs'_reg (w : Wire) (hw : w ∈ portTargets f.ports ++ f.garb) : bs' w = s2.basis w := by
    have hne := hdisj_rg w hw
