  simp only [TopReuse.inverse, BiasedInverse.recoverPrefix, ECDSAAdd.wires_append, Finset.union_subset_iff] at hic
  exact ⟨hic.1.1.1.1.1.1.1.2, hic.1.1.1.2, hic.1.1.2⟩

private theorem compiledHalf_wires_no4 {n : Nat} (divide : Bool) (s : Nat) :
