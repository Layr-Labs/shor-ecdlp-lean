/-! #### 2. Plain block avoidance, `SquareOB5` avoidance of `15653/15654`, `tripleF` avoidance of `14849/14850` -/

theorem compile_singleton_literal_wires {n : Nat} (bits paths : List Wire) (root : Wire)
    (Q : ECDSAAdd.Program) (S : List Wire) (hQ : ECDSAAdd.wires Q ⊆ S.toFinset) (start : Nat) :
    ChallengeMigration.straightWires (WEX.compile (n := n) bits paths root ([WInstr.literal Q]) start) ⊆ S := by
  rw [WEX.compile, WEX.support_castFinish, ChallengeMigration.straightWires_append, compile_nil_wires, List.append_nil]
  exact WEX.literal_translate_support Q S hQ start

theorem blockProgH_plain_avoid {n : Nat} (code : WCode n)
    (hgeo : LitAvoid WideBank8.Fast16.bank15.bits code)
    (w : Wire) (hw_lit : w ∉ ECDSAAdd.wires (litProg code))
    (hw_host : w ≠ 10015 ∧ w ≠ 15655 ∧ w ≠ 836 ∧ w ≠ 14879 ∧ w ≠ 14114 ∧ w ≠ 14878 ∧
      w ≠ 14877 ∧ w ≠ 14876 ∧ w ≠ 14875 ∧ w ≠ 14874 ∧
      w ≠ 14111 ∧ w ≠ 19816 ∧ w ≠ 838 ∧ w ≠ 14112 ∧ w ≠ 19815 ∧ w ≠ 19814 ∧ w ≠ 14113)
    (start : Nat) :
    w ∉ ChallengeMigration.straightWires (WideBank8.blockProgH WideBank8.Fast16.bank15 (.plain code) start) := by
  have hlit : ∀ i ∈ code, ∃ p, i = .literal p := fun i hi => by
    obtain ⟨p, rfl, -⟩ := hgeo i hi; exact ⟨p, rfl⟩
  let P := ECDSAAdd.Baselines.normalizeProgram (litProg code)
  have hwP : w ∉ ECDSAAdd.wires P := by rw [ECDSAAdd.Baselines.normalize_wires]; exact hw_lit
  have hw3 : w ∉ ECDSAAdd.wires (hostBlock3 P) :=
    PoolHost.hostBlock3_avoid_extra P w hwP hw_host.1 hw_host.2.1 hw_host.2.2.1
      hw_host.2.2.2.1 hw_host.2.2.2.2.1 hw_host.2.2.2.2.2.1
  have hw7 : w ∉ ECDSAAdd.wires (PoolHost.hostBlock7 P) := by
    unfold PoolHost.hostBlock7
    split_ifs
    · simp only [ECDSAAdd.wires_append, relabel_wires, Finset.mem_union, Finset.mem_image, not_or]
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · intro hm
        have h' := enc4_wires_sub hm; simp only [Finset.mem_insert, Finset.mem_singleton] at h'
        rcases h' with rfl | rfl | rfl | rfl | rfl | rfl | rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 rfl
      · rintro ⟨v, hv, heq⟩
        have hfix : PoolHost.perm4 w = w := by
          simp only [PoolHost.perm4, hw_host.2.2.2.2.2.2.1, hw_host.2.2.2.2.2.2.2.1,
            hw_host.2.2.2.2.2.2.2.2.1, hw_host.2.2.2.2.2.2.2.2.2.1,
            hw_host.2.2.2.2.2.2.2.2.2.2.1, hw_host.2.2.2.2.2.2.2.2.2.2.2.1,
            hw_host.2.2.2.2.2.2.2.2.2.2.2.2.1, hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.1, ite_false]
        exact hw3 (PoolHost.perm4_injective (heq.trans hfix.symm) ▸ hv)
      · intro hm
        have h' := dec4_wires_sub hm; simp only [Finset.mem_insert, Finset.mem_singleton] at h'
        rcases h' with rfl | rfl | rfl | rfl | rfl | rfl | rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 rfl
        · exact hw_host.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 rfl
    · exact hw3
  intro hm
  rw [WideBank8.blockProgH, straightWires_castFinish, PoolHost.hostCode7_eq_host ((allLit_iff code).mpr hlit)] at hm
  have hsub := compile_singleton_literal_wires WideBank8.Fast16.bank15.bits WideBank8.Fast16.bank15.paths windowRoot
    (PoolHost.hostBlock7 P) (ECDSAAdd.wires (PoolHost.hostBlock7 P)).toList (by simp) start hm
  exact hw7 (Finset.mem_toList.mp hsub)

theorem squareOB5_avoid_15653_15654 :
    (15653 : Wire) ∉ ECDSAAdd.wires (SquareOB5.program streamLayout) ∧
    (15654 : Wire) ∉ ECDSAAdd.wires (SquareOB5.program streamLayout) := by
  let L := streamLayout
  have hw := streamLayout_widths
  have hn := streamLayout_nodup
  let S : Finset Wire := ((OB5Support.sites L).toFinset.erase 15653).erase 15654
