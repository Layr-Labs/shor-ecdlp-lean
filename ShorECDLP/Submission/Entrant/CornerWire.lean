  have hr_eq : cellLayout.r = base 2056 :: (wireBlock base 2057 254 ++ [base 2311]) := rfl
  have hc_eq : cellLayout.carry = base 512 :: (wireBlock base 513 252 ++ [base 1540, base 1541, base 1026]) := by
    change wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] = _
    simp only [wireBlock, List.range'_succ, List.map_cons, List.cons_append]
  have hy := cell_y_no4; have hr := cell_r_no4; have hc := cell_carry_no4
  rw [hy_eq] at hy ⊢; rw [hr_eq] at hr ⊢; rw [hc_eq] at hc ⊢
  exact compileCompareLt_wires top (base 1026) _ _ _ _ _ _ _ _ _ cellWiresNo4
    (cell_base_no4_mem 1026 (by omega)) (cellLayout_one ▸ cell_base_no4_mem 1027 (by omega))
    (cellLayout_parity ▸ cell_base_no4_mem 768 (by omega)) hy hr hc

private theorem cell_fwd_sub_no4 :
    ECDSAAdd.wires (GuardCompression.seed cellLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (OneReuse.remainder cellLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.unnormalize cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (TopReuse.unnormalizeE cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (FirstZero5.tail cellLayout) ⊆ cellWiresNo4.toFinset := by
  have hfc : ECDSAAdd.wires (TopReuse.forward cellLayout) ⊆ cellWiresNo4.toFinset :=
    cell_sub_no4_of_cell _ ((TopReuse.forward_support cellLayout cellLayout_widths).trans
      (OneBankCell5.ports_wires_sub base (base 2409) cellWires.toFinset (Finset.Subset.refl _))) cell_fwd_avoid4
  have hfe : ECDSAAdd.wires (TopReuse.forwardE cellLayout) ⊆ cellWiresNo4.toFinset :=
    (TopReuse.forwardE_wires cellLayout cellLayout_widths).trans hfc
  have hfz : ECDSAAdd.wires (FirstZero5.forward cellLayout) ⊆ cellWiresNo4.toFinset :=
    (FirstZero5.forward_wires cellLayout cellLayout_widths).trans hfc
  simp only [TopReuse.forward, TopReuse.forwardPrefix, TopReuse.cleanup,
    ECDSAAdd.wires_append, Finset.union_subset_iff] at hfc
  simp only [TopReuse.forwardE, TopReuse.cleanupE, ECDSAAdd.wires_append, Finset.union_subset_iff] at hfe
  simp only [FirstZero5.forward, ECDSAAdd.wires_append, Finset.union_subset_iff] at hfz
  exact ⟨hfc.1.1.1, hfc.1.2, hfc.2.1, hfc.2.2.2.2.1, by simpa [ECDSAAdd.wires_reverse] using hfc.2.2.2.2.2,
    hfe.2.2.2.2.1, hfz.2⟩

private theorem cell_inv_sub_no4 :
    ECDSAAdd.wires (BalancedCleanup.normalize cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
