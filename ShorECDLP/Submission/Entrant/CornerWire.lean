  rw [CatProg.append, straightWires_append]; exact List.append_subset.mpr ⟨hp, hq⟩

private theorem b_catProg_append_wellFormed {n s : Nat} (p : CatProg n s) (q : CatProg n p.finish)
    (hp : p.prog.WellFormed) (hq : q.prog.WellFormed) :
    (p.append q).prog.WellFormed := by
  rw [CatProg.append]; exact straight_append_wellFormed p.prog q.prog hp hq

private theorem b_catProg_append_slots {n s : Nat} {sp sq : Nat} (p : CatProg n s) (q : CatProg n p.finish)
    (hp : p.prog.gateSlots ≤ sp) (hq : q.prog.gateSlots ≤ sq) :
    (p.append q).prog.gateSlots ≤ sp + sq := by
  rw [CatProg.append, Straight.gateSlots_append]; exact Nat.add_le_add hp hq

private theorem b_catProg_append_tCount_indep {n s : Nat} {tp tq : Nat} (p : CatProg n s) (q : CatProg n p.finish)
    (hqi : Indep q.prog) (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (hp : (p.prog.instantiate read h).tCount ≤ tp)
    (hq : ∀ h', (q.prog.instantiate read h').tCount ≤ tq) :
    ((p.append q).prog.instantiate read h).tCount ≤ tp + tq := by
  rw [CatProg.append, indep_append_tCount p.prog q.prog hqi read h]
  exact Nat.add_le_add hp (hq _)

private theorem b_catProg_append_run_indep {n s : Nat} (p : CatProg n s) (q : CatProg n p.finish)
    (hqi : Indep q.prog) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((p.append q).prog.instantiate read h).run =
      ((p.prog.instantiate read h).seq (q.prog.instantiate read (fun _ => false))).run := by
  rw [CatProg.append, indep_append_run p.prog q.prog hqi read h]

private theorem b_seq_tCount_any {n : Nat} (a b : CatFn n) {ta tb : Nat}
    (ha : ∀ s read h, ((a s).prog.instantiate read h).tCount ≤ ta)
    (hb : ∀ s read h, ((b s).prog.instantiate read h).tCount ≤ tb)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.seq a b s).prog.instantiate read h).tCount ≤ ta + tb := by
  rw [CatFn.seq, CatProg.append]
  exact (b_append_tCount_le (a s).prog (b (a s).finish).prog read h tb (fun h' => hb _ read h')).trans
    (Nat.add_le_add_right (ha s read h) tb)

private theorem b_swapSurround_tCount {n : Nat} (y₁ y₂ : Wire) (body : CatFn n) {tb : Nat}
    (hb : ∀ s read h, ((body s).prog.instantiate read h).tCount ≤ tb)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.swapSurround y₁ y₂ body s).prog.instantiate read h).tCount ≤ tb := by
  rw [CatFn.swapSurround]
  have h1 := b_seq_tCount_any (CatFn.seq (CatFn.lit (swapCircuit y₁ y₂)) body) (CatFn.lit (swapCircuit y₂ y₁))
    (b_seq_tCount_any (CatFn.lit (swapCircuit y₁ y₂)) body
      (fun s' r' h' => by rw [CatFn.lit_tCount, swapCircuit_tCount]) hb)
    (fun s' r' h' => by rw [CatFn.lit_tCount, swapCircuit_tCount]) s read h
  omega

private theorem b_catFn_swapSurround_run_any {n : Nat} (y₁ y₂ : Wire) (body : CatFn n)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.swapSurround y₁ y₂ body s).prog.instantiate read h).run =
      ((body s).prog.instantiate read h).run.map (fun br =>
        { history := br.history, kraus := (Quantum.run (swapCircuit y₂ y₁) ∘ₗ br.kraus) ∘ₗ Quantum.run (swapCircuit y₁ y₂) }) := by
  rw [CatFn.swapSurround, CatFn.seq, CatFn.seq, CatFn.lit, CatFn.lit]
  exact b_catProg_swapSurround_run y₁ y₂ (body s) read h

private theorem b_seq_catCoherent {n : Nat} (y : Wire) (a b : CatFn n) (read : ConstantBit n → Bool)
    (f g : BasisState → BasisState) (V₁ V₂ : BasisState → Prop)
    (ha : ∀ s h, CatCoherent y ((a s).prog.instantiate read h) (Finsupp.lmapDomain ℂ ℂ f) V₁)
    (hb : ∀ s h, CatCoherent y ((b s).prog.instantiate read h) (Finsupp.lmapDomain ℂ ℂ g) V₂)
    (hstep : ∀ bs, V₁ bs → V₂ (f bs)) (s : Nat) (h : Fin s → Bool) :
    CatCoherent y ((CatFn.seq a b s).prog.instantiate read h) (Finsupp.lmapDomain ℂ ℂ (g ∘ f)) V₁ := by
  rw [CatFn.seq, CatProg.append]
  obtain ⟨cs1, a1, m1⟩ := ha s h
  obtain ⟨cs, al, hm⟩ := append_sim_forall2 (a s).prog (b (a s).finish).prog read h _ _
    (fun b c => ∀ bs, V₁ bs → b.kraus (Prep y (ket bs)) = c • Prep y (Finsupp.lmapDomain ℂ ℂ (g ∘ f) (ket bs)))
    cs1 a1 (fun h' _ => hb _ h')
    (fun b1 k1 b2 k2 hb1 hb2 bs hbs => by
      change b2.kraus (b1.kraus (Prep y (ket bs))) = _
      rw [hb1 bs hbs, map_smul]
      simp only [Finsupp.lmapDomain_apply, Finsupp.mapDomain_single, ket, Function.comp_apply] at *
      rw [hb2 (f bs) (hstep bs hbs), smul_smul, mul_comm k1 k2])
  exact ⟨cs, al, hm.trans m1⟩

private theorem swapCircuit_prep_signedKet (y w : Wire) (hne : y ≠ w)
    (st : ECDSAAdd.State) (hy : st.basis y = false) (hw : st.basis w = false) :
    Quantum.run (swapCircuit y w) (Prep y (Bridge.signedKet st)) = Prep w (Bridge.signedKet st) := by
  rw [signedKet_smul_eq, map_smul, map_smul, map_smul, swapCircuit_prep_ket y w hne st.basis hy hw]

private theorem flipSwapCircuit_prep_signedKet (y w : Wire) (hne : y ≠ w)
    (st : ECDSAAdd.State) (hy : st.basis y = false) (hw : st.basis w = true) :
    Quantum.run (flipSwapCircuit y w) (Prep y (Bridge.signedKet st)) =
      Prep w (Bridge.signedKet ⟨st.phase, st.basis[w ↦ false]⟩) := by
  rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, map_smul, map_smul,
    flipSwapCircuit_prep_ket y w hne st.basis hy hw]

private theorem unflipSwapCircuit_prep_signedKet (y w : Wire) (hne : y ≠ w)
    (st : ECDSAAdd.State) (hy : st.basis y = false) (hw : st.basis w = false) :
    Quantum.run (unflipSwapCircuit y w) (Prep w (Bridge.signedKet st)) =
      Prep y (Bridge.signedKet ⟨st.phase, st.basis[w ↦ true]⟩) := by
  rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, map_smul, map_smul,
    unflipSwapCircuit_prep_ket y w hne st.basis hy hw]

private theorem doubleFlipSwapCircuit_prep_signedKet (y w q : Wire) (hyw : y ≠ w) (hyq : y ≠ q) (hwq : w ≠ q)
    (st : ECDSAAdd.State) (hy : st.basis y = false) (hw : st.basis w = true) (hq : st.basis q = true) :
    Quantum.run (doubleFlipSwapCircuit y w q) (Prep y (Bridge.signedKet st)) =
      Prep w (Bridge.signedKet ⟨st.phase, st.basis[q ↦ false][w ↦ false]⟩) := by
  rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, map_smul, map_smul,
    doubleFlipSwapCircuit_prep_ket y w q hyw hyq hwq st.basis hy hw hq]

private theorem doubleUnflipSwapCircuit_prep_signedKet (y w q : Wire) (hyw : y ≠ w) (hyq : y ≠ q) (hwq : w ≠ q)
    (st : ECDSAAdd.State) (hy : st.basis y = false) (hw : st.basis w = false) (hq : st.basis q = false) :
    Quantum.run (doubleUnflipSwapCircuit y w q) (Prep w (Bridge.signedKet st)) =
      Prep y (Bridge.signedKet ⟨st.phase, st.basis[w ↦ true][q ↦ true]⟩) := by
  rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, map_smul, map_smul,
    doubleUnflipSwapCircuit_prep_ket y w q hyw hyq hwq st.basis hy hw hq]

