    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (e y) ((CatFn.map e a s).prog.instantiate read h) (ECDSAAdd.renameProgram e P)
      (fun bs => V (fun w => bs (e w))) := by
  unfold CatFn.map
  have hmp : ((a s).map e).prog = relabelStraight e (a s).prog := by
    dsimp only [CatProg.map]
    exact mapStraight_eq_relabel e e (a s).prog (fun _ _ => rfl)
