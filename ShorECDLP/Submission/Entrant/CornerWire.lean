private theorem cell_half_pres_valid (divide : Bool) (st : ECDSAAdd.State) (m : List Bool) (h : CellValid st.basis) :
    CellValid (ECDSAAdd.run (OneBankCell5.half divide base (base 2409)) m st).basis := by
  obtain ⟨hc, X, Y, hr, hy⟩ := h
  have hf := OneBankCell5.half_frame divide base (base 2409) cellLayout_nodup st.basis hc X Y st m ⟨hr, hy, fun _ _ _ => rfl⟩
  exact cellValid_of_pair hc hf.2

private theorem cell_zHalf_pres_valid (st : ECDSAAdd.State) (m : List Bool) (h : CellValidZero st.basis) :
    CellValid (ECDSAAdd.run (FirstZero5.half base (base 2409)) m st).basis := by
  obtain ⟨hc, X, Y, hz, hr, hy⟩ := h
  have heq := FirstZero5.half_run_eq base (base 2409) cellLayout_nodup st.basis
    (OneBankCell5.clean_work base (base 2409) st.basis hc) X Y hz st m ⟨hr, hy, fun _ _ _ => rfl⟩
  rw [heq]
  exact cell_half_pres_valid true st m ⟨hc, X, Y, hr, hy⟩

