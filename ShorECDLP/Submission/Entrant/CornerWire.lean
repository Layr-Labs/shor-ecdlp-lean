theorem negXProg_wires_sub :
    ECDSAAdd.wires negXProg ⊆ (15651 :: List.range' 263 256 ++ List.range' 14115 258).toFinset := by
  rw [negXProg, ECDSAAdd.renameProgram_support]
  intro w hw
  obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hw
  have hmem := List.mem_toFinset.mp (negXRefl_wires hu)
  have hpool := streamLayout.recoveryNegate_pool streamLayout_widths
  have htake : streamLayout.dialogPool.take 258 = List.range' 14115 258 := Site1Fast.pool_take_eq 258 (by decide)
  have hrange : u = 14113 ∨ (263 ≤ u ∧ u < 519) ∨ (14115 ≤ u ∧ u < 14373) := by
    simp only [CompactRecoveryNegateLayout.wires, List.mem_cons, List.mem_append] at hmem
    rcases hmem with rfl | rfl | rfl | hmem | hmem
    · exact Or.inl rfl
    · have hm : negXLayout.cin ∈ streamLayout.dialogPool.take 258 := by rw [← hpool]; simp [negXLayout]
      rw [htake, List.mem_range'_1] at hm; exact Or.inr (Or.inr hm)
    · have hm : negXLayout.zero ∈ streamLayout.dialogPool.take 258 := by rw [← hpool]; simp [negXLayout]
      rw [htake, List.mem_range'_1] at hm; exact Or.inr (Or.inr hm)
    · simp only [negXLayout, ControlledPointLayout.recoveryNegate, streamLayout_point_x_eq, List.mem_range'_1] at hmem
      exact Or.inr (Or.inl hmem)
    · have hm : u ∈ streamLayout.dialogPool.take 258 := by rw [← hpool]; exact List.mem_append_left _ hmem
      rw [htake, List.mem_range'_1] at hm; exact Or.inr (Or.inr hm)
  apply List.mem_toFinset.mpr
  simp only [List.mem_cons, List.mem_append, List.mem_range'_1]
  rcases hrange with rfl | hx | hp
  · left; left; exact Equiv.swap_apply_left 14113 15651
  · left; right
    rw [sqSwap, Equiv.swap_apply_of_ne_of_ne (show u ≠ 14113 by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (show u ≠ 15651 by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))]
    exact hx
  · right
    rw [sqSwap, Equiv.swap_apply_of_ne_of_ne (show u ≠ 14113 by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (show u ≠ 15651 by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))]
    exact hp

