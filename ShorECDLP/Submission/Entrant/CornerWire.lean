  · simp only [FirstZero5.eraseParity, cell_rtail_getD253, cellLayout_parity, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
      Finset.mem_union, Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false, or_assoc] at h
    rcases h with e | e | e <;> (have := MappedCompressed.base_injective e; omega)
  · exact cell_unnorm_avoid k hk h
  · rw [ECDSAAdd.wires_reverse] at h; exact cell_prepSign_avoid k hk h
  · have hrp := (FirstZero5.rep_facts 256 cellLayout.one).2.2.2.1 h
    simp only [Finset.mem_singleton, cellLayout_one] at hrp
