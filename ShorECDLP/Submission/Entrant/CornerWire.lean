  have hbs'_frame : ∀ w, w ∉ portTargets f.ports → w ∉ f.garb → bs' w = bs w := by
    intro w h1 h2
    by_cases hgd : w = guardWire
    · subst hgd; simp [bs', upd, hgd0]
    · by_cases hrt : w = rootWire
      · subst hrt; simp [bs', upd, hrg_ne, hrt0]
      · simp only [bs', upd, hgd, hrt, ↓reduceIte]
        change s2.basis (rootSwap.symm w) = bs w; rw [hsy]
