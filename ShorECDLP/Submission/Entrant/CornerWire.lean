theorem compiledDirectArithEnv_wires (E : EnvSchedule) {n : Nat} (multiply : Bool) (s : Nat) :
    ChallengeMigration.straightWires (compiledDirectArithEnv E (n := n) multiply s).prog ⊆ support1612 := by
