private theorem not_in_pointXY (w : Wire) (hw : (w < 263 ∨ 519 ≤ w) ∧ (w < 580 ∨ 836 ≤ w)) :
    w ∉ streamLayout.point.x ∧ w ∉ streamLayout.point.y := by
  constructor
  · intro hm; rw [streamLayout_point_x_eq] at hm; simp only [List.mem_range'_1] at hm; dsimp only [Wire] at *; omega
  · intro hm; rw [streamLayout_point_y_eq] at hm; simp only [List.mem_range'_1] at hm; dsimp only [Wire] at *; omega

private theorem pointDialogValues_flag_eq {X Y : ECDSAAdd.Fp} {G : Bool} {base bs : BasisState}
    (hv : PointDialogValues streamLayout X Y G base bs) (w : Wire)
    (hw : w = 10015 ∨ w = 836 ∨ w = 14114 ∨ w = 14111 ∨ w = 19816 ∨ w = 838 ∨ w = 14112 ∨ w = 19815 ∨ w = 19814) :
    bs w = base w := by
  have hxy := not_in_pointXY w (by
    rcases hw with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide)
  exact hv.rest w (fun hm => by rcases List.mem_append.mp hm with h | h; exact hxy.1 h; exact hxy.2 h)

private theorem writeBit_eq (b : BasisState) (w : Wire) (v : Bool) (u : Wire) :
    ECDSAAdd.writeBit b w v u = if u = w then v else b u := by
  by_cases h : u = w <;> simp [ECDSAAdd.writeBit, Function.update, h]

private theorem flip3_enc_congr (b₁ b₂ : BasisState)
    (h15 : b₁ 10015 = b₂ 10015) (h836 : b₁ 836 = b₂ 836) (h14 : b₁ 14114 = b₂ 14114)
    (h12 : b₁ 14112 = b₂ 14112) (h195 : b₁ 19815 = b₂ 19815) (h194 : b₁ 19814 = b₂ 19814)
    (u : Wire) (hu : b₁ u = b₂ u) :
    flip3Basis (PoolHost.encBasis b₁) u = flip3Basis (PoolHost.encBasis b₂) u := by
  have henc (x : Wire) (hx : b₁ x = b₂ x) : PoolHost.encBasis b₁ x = PoolHost.encBasis b₂ x := by
    simp only [PoolHost.encBasis, writeBit_eq]
    by_cases h1 : x = 19814; · simp only [h1, ite_true, h194, h12]
    simp only [h1, ite_false]
    by_cases h2 : x = 19815; · simp only [h2, ite_true, h195, h12]
    simp only [h2, ite_false]
    by_cases h3 : x = 14112; · simp only [h3, ite_true]
    simp only [h3, ite_false]
    by_cases h4 : x = 838; · simp only [h4, ite_true]
    simp only [h4, ite_false]
    by_cases h5 : x = 19816; · simp only [h5, ite_true]
    simp only [h5, ite_false]
    by_cases h6 : x = 14111; · simp only [h6, ite_true]
    simp only [h6, ite_false, hx]
  simp only [flip3Basis, writeBit_eq]
  by_cases h1 : u = 14114; · simp only [h1, ite_true, henc 14114 h14]
  simp only [h1, ite_false]
  by_cases h2 : u = 836; · simp only [h2, ite_true, henc 836 h836]
  simp only [h2, ite_false]
  by_cases h3 : u = 10015; · simp only [h3, ite_true, henc 10015 h15]
  simp only [h3, ite_false, henc u hu]

private theorem pointDialogValues_flagInv7 {X Y : ECDSAAdd.Fp} {G : Bool} {base bs : BasisState}
    (hv : PointDialogValues streamLayout X Y G base bs) (hf : PoolHost.FlagInv7 base) (hG : base 14113 = G) :
    PoolHost.FlagInv7 bs := by
  have e11 := pointDialogValues_flag_eq hv 14111 (by decide)
  have e16 := pointDialogValues_flag_eq hv 19816 (by decide)
  have e838 := pointDialogValues_flag_eq hv 838 (by decide)
  have e12 := pointDialogValues_flag_eq hv 14112 (by decide)
  have e15 := pointDialogValues_flag_eq hv 19815 (by decide)
  have e14 := pointDialogValues_flag_eq hv 19814 (by decide)
  have e13 : bs 14113 = base 14113 := by rw [← PoolHost.streamLayout_gen, hv.generic, PoolHost.streamLayout_gen, hG]
  rw [PoolHost.FlagInv7, e11, e16, e838, e12, e15, e14, e13]
  exact hf

theorem compiledHostArith_catLitSim (multiply : Bool) (s : Nat)
    (read : ConstantBit 65536 → Bool) (h : Fin s → Bool) :
    CatLitSim 14833 ((compiledHostArith multiply s).prog.instantiate read h)
      (arithS streamLayout multiply) ArithHostValid := by
