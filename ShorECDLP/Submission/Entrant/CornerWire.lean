          List.cons_append, List.nil_append, List.mem_cons, List.not_mem_nil, or_false] at hw
        rcases hw with rfl | rfl | rfl | rfl <;> assumption
  | [a], [b], _, cin, start, S, _, hcin, hx, hys, _ => by
      rw [compileAddInPlace, CatProg.lit_wires]
      intro w hw
      simp only [circuitWires, List.flatMap_cons, List.flatMap_nil, gateWires,
        List.cons_append, List.nil_append, List.mem_cons, List.not_mem_nil, or_false] at hw
      rcases hw with rfl | rfl | rfl | rfl
      · exact hx List.mem_cons_self
      · exact hys List.mem_cons_self
      · exact hcin
      · exact hys List.mem_cons_self
  | [], _, _, _, _, _, _, _, _, _, _ | [_], [], _, _, _, _, _, _, _, _, _
  | [_], _ :: _ :: _, _, _, _, _, _, _, _, _, _ | _ :: _ :: _, [], _, _, _, _, _, _, _, _, _
  | _ :: _ :: _, [_], _, _, _, _, _, _, _, _, _ | _ :: _ :: _, _ :: _ :: _, [], _, _, _, _, _, _, _, _ => by
      simp [compileAddInPlace, CatProg.lit_wires, circuitWires]

