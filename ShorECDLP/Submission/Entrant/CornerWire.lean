    0 < x ∧ x < p ∧
    skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int) (p : Int)) ∧
    bs (base 2400) = true ∧ FieldFrameOB5.EncodedFieldFrame origin Y Y ⟨false, bs⟩

