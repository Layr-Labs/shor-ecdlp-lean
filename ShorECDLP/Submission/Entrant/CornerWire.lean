theorem compiledRawAdd_tCount {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compiledRawAdd (n := n) start).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (GuardCompression.rawAdd cellLayout) := by
  rw [compiledRawAdd]
  refine (CatFn.swapSurround_tCount_le _ _ _
    (CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.noT_indep _) (compileAddInPlace_indep _ _ _ _ _)) (CatFn.noT_indep _))
    (CatFn.seq_tCount_le _ _ (CatFn.noT_indep _)
      (CatFn.seq_tCount_le _ _ (compileAddInPlace_indep _ _ _ _ _)
        (CatFn.noT_tCount _ cell_signComp_y_toff)
        (fun s' r' h' => le_of_eq (compileAddInPlace_tCount _ _ _ _ _ s' r' h')))
      (CatFn.noT_tCount _ cell_signComp_y_toff)) start read h).trans ?_
