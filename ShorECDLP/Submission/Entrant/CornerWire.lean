      (CatFn.seq_shiftFin _ _
        (CatFn.seq_shiftFin _ _ (CatFn.compileProg_shiftFin _ _ _) (ShiftFin.of_exact (cell_cmp_finish false) le_rfl))
        (CatFn.compileProg_shiftFin _ _ _))
