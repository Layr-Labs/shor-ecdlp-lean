    CompactRecoveryNegateLayout.add, ECDSAAdd.Challenge.gateSlots_append, hl] at h1
  (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

private theorem pullState_phase (f : Wire → Wire) (s : ECDSAAdd.State) :
    (ECDSAAdd.pullState f s).phase = s.phase := by cases s; rfl
private theorem pullState_basis (f : Wire → Wire) (s : ECDSAAdd.State) (w : Wire) :
    (ECDSAAdd.pullState f s).basis w = s.basis (f w) := by cases s; rfl
private theorem signedKet_eq_ket_of_phase (s : ECDSAAdd.State) (bs : BasisState)
    (hph : s.phase = false) (hbs : s.basis = bs) : Bridge.signedKet s = ket bs := by
  cases s with | mk ph b => simp only at hph hbs; subst hph; subst hbs; exact Bridge.signedKet_false b

