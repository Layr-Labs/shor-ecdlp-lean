-- Exact `tCount` bounds (`≤ 4 * toffoliCount`) for the 4 cell kernels
theorem compiledForwardPrefix_tCount {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compiledForwardPrefix (n := n) start).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (TopReuse.forwardPrefix cellLayout) := by
  have hseed : ECDSAAdd.toffoliCount (GuardCompression.seed cellLayout) = 0 := rfl
  rw [compiledForwardPrefix]
  refine (CatFn.seq_tCount_le _ _ (CatFn.compileProg_indep _ _ _)
    (CatFn.seq_tCount_le _ _ compiledRawAdd_indep (CatFn.noT_tCount _ hseed) compiledRawAdd_tCount)
    (CatFn.compileProg_tCount _ _ _) start read h).trans ?_
  simp only [TopReuse.forwardPrefix, ECDSAAdd.toffoliCount_append, hseed]; omega

theorem compiledCleanup_tCount {n : Nat} (isE : Bool) (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compiledCleanup (n := n) isE start).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (if isE then TopReuse.cleanupE cellLayout else TopReuse.cleanup cellLayout) := by
  have hpc0 : ECDSAAdd.toffoliCount (BalancedCleanup.prepareCompare cellLayout.toLayout) = 0 :=
    (FirstZero5.prepareCompare_counts cellLayout.toLayout).1
  rw [compiledCleanup]
  refine (CatFn.seq_tCount_le _ _ (CatFn.compileProg_indep _ _ _)
    (CatFn.seq_tCount_le _ _ (compileCompareLt_indep _ _ _ _ _ _ _)
      (CatFn.noT_tCount _ hpc0) (fun s' r' h' => le_of_eq (cell_cmp_tCount true s' r' h')))
    (CatFn.compileProg_tCount _ _ _) start read h).trans ?_
  cases isE <;>
  · simp only [TopReuse.cleanup, TopReuse.cleanupE, cmpLtProg, if_true, Bool.false_eq_true, if_false,
      ECDSAAdd.toffoliCount_append, hpc0]
    omega

theorem compiledForward_tCount {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compiledForward (n := n) start).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (TopReuse.forward cellLayout) := by
  rw [compiledForward]
  refine (CatFn.seq_tCount_le _ _ (compiledCleanup_indep false) compiledForwardPrefix_tCount
    (compiledCleanup_tCount false) start read h).trans ?_
  simp only [TopReuse.forward_split, Bool.false_eq_true, if_false, ECDSAAdd.toffoliCount_append]; omega

theorem compiledForwardE_tCount {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compiledForwardE (n := n) start).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (TopReuse.forwardE cellLayout) := by
  rw [compiledForwardE]
  refine (CatFn.seq_tCount_le _ _ (compiledCleanup_indep true) compiledForwardPrefix_tCount
    (compiledCleanup_tCount true) start read h).trans ?_
  simp only [TopReuse.forwardE, if_true, ECDSAAdd.toffoliCount_append]; omega

theorem compiledZForward_tCount {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compiledZForward (n := n) start).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (FirstZero5.forward cellLayout) := by
  have hzp : FirstZero5.zPrefix cellLayout = TopReuse.forwardPrefix cellLayout := by
    simp [FirstZero5.zPrefix, TopReuse.forwardPrefix, List.append_assoc]
  rw [compiledZForward]
  refine (CatFn.seq_tCount_le _ _ (CatFn.compileProg_indep _ _ _) compiledForwardPrefix_tCount
    (CatFn.compileProg_tCount _ _ _) start read h).trans ?_
