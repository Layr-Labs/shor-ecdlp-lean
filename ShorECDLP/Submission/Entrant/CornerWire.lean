  have hlog : w ∈ OB5Support.logicalSites := (Finset.mem_erase.mp hw).2
  have hne2400 : w ≠ base 2400 := (Finset.mem_erase.mp hw).1
  have himg := OwnParityPhysical.wire_image streamLayout streamLayout_widths w
