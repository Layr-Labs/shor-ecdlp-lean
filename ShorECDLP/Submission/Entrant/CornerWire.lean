-- Slots bounds for the 4 cell kernels
private theorem cell_sub_slots_bound :
    ECDSAAdd.Challenge.gateSlots (TopReuse.forward cellLayout) ≤ 25000 ∧
    ECDSAAdd.Challenge.gateSlots (TopReuse.forwardE cellLayout) ≤ 25000 ∧
    ECDSAAdd.Challenge.gateSlots (FirstZero5.forward cellLayout) ≤ 25000 ∧
    ECDSAAdd.Challenge.gateSlots (TopReuse.inverse cellLayout) ≤ 25000 := by
  have hf := TopReuse.forward_slots cellLayout cellLayout_widths
  have hfe := TopReuse.forwardE_slots cellLayout cellLayout_widths
  have hzf := FirstZero5.forward_slots cellLayout cellLayout_widths
  have hi := TopReuse.inverse_slots cellLayout cellLayout_widths
  omega

private theorem cell_sub_toff_bound :
    ECDSAAdd.toffoliCount (TopReuse.forward cellLayout) ≤ 1200 ∧
    ECDSAAdd.toffoliCount (TopReuse.forwardE cellLayout) ≤ 1200 ∧
    ECDSAAdd.toffoliCount (FirstZero5.forward cellLayout) ≤ 1200 ∧
    ECDSAAdd.toffoliCount (TopReuse.inverse cellLayout) ≤ 1200 := by
  have hk := TopReuse.kernel_counts cellLayout cellLayout_widths
  have hfe := (TopReuse.forwardE_counts cellLayout cellLayout_widths).1
  have hzf := (FirstZero5.forward_counts cellLayout cellLayout_widths).1
  omega

theorem compiledForwardPrefix_slots {n : Nat} (start : Nat) :
    (compiledForwardPrefix (n := n) start).prog.gateSlots ≤ 450000 := by
  have hsf := cell_sub_slots_bound.1; have htf := cell_sub_toff_bound.1
  simp only [TopReuse.forward, ECDSAAdd.Challenge.gateSlots_append, ECDSAAdd.toffoliCount_append] at hsf htf
  rw [compiledForwardPrefix]
  refine (CatFn.seq_slots _ _ (CatFn.seq_slots _ _ (CatFn.noT_slots _) compiledRawAdd_slots)
    (CatFn.compileProg_slots _ _ _) start).trans ?_
  omega

theorem compiledCleanup_slots {n : Nat} (isE : Bool) (start : Nat) :
    (compiledCleanup (n := n) isE start).prog.gateSlots ≤ 450000 := by
  rw [compiledCleanup]
  refine (CatFn.seq_slots _ _ (CatFn.seq_slots _ _ (CatFn.noT_slots _) (cell_cmp_slots true))
    (CatFn.compileProg_slots _ _ _) start).trans ?_
  cases isE
  · have hsf := cell_sub_slots_bound.1; have htf := cell_sub_toff_bound.1
    simp only [TopReuse.forward, TopReuse.cleanup, Bool.false_eq_true, if_false,
      ECDSAAdd.Challenge.gateSlots_append, ECDSAAdd.toffoliCount_append] at hsf htf ⊢
    omega
  · have hsf := cell_sub_slots_bound.2.1; have htf := cell_sub_toff_bound.2.1
    simp only [TopReuse.forwardE, TopReuse.cleanupE, if_true,
      ECDSAAdd.Challenge.gateSlots_append, ECDSAAdd.toffoliCount_append] at hsf htf ⊢
    omega

theorem compiledForward_slots {n : Nat} (start : Nat) :
    (compiledForward (n := n) start).prog.gateSlots ≤ 900000 := by
  rw [compiledForward]
  exact (CatFn.seq_slots _ _ compiledForwardPrefix_slots (compiledCleanup_slots false) start).trans (by omega)

theorem compiledForwardE_slots {n : Nat} (start : Nat) :
    (compiledForwardE (n := n) start).prog.gateSlots ≤ 900000 := by
  rw [compiledForwardE]
  exact (CatFn.seq_slots _ _ compiledForwardPrefix_slots (compiledCleanup_slots true) start).trans (by omega)

theorem compiledZForward_slots {n : Nat} (start : Nat) :
    (compiledZForward (n := n) start).prog.gateSlots ≤ 900000 := by
  have hsf := cell_sub_slots_bound.2.2.1; have htf := cell_sub_toff_bound.2.2.1
  simp only [FirstZero5.forward, ECDSAAdd.Challenge.gateSlots_append, ECDSAAdd.toffoliCount_append] at hsf htf
  rw [compiledZForward]
  exact (CatFn.seq_slots _ _ compiledForwardPrefix_slots (CatFn.compileProg_slots _ _ _) start).trans (by omega)

theorem compiledInverse_slots {n : Nat} (start : Nat) :
    (compiledInverse (n := n) start).prog.gateSlots ≤ 900000 := by
  have hsf := cell_sub_slots_bound.2.2.2; have htf := cell_sub_toff_bound.2.2.2
