      (CatFn.seq_slots _ _ b_compiledRow_slots
        (CatFn.seq_slots _ _ hn_sl (CatFn.lit_slots suffixCircuit16)))) start
  rw [b_prefixCircuit16_length, b_suffixCircuit16_length] at h
