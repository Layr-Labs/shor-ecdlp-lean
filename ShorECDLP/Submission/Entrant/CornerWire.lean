theorem fB_rec : codeRecords fB.selBits fB.selPaths windowRoot fB.selCode = 32767 := by
  rw [fB.loadProg_records fB_geo]; decide

def site1Rec : Nat := site1RecGen 16383 32767 mShort mTail fixRec8
def site1NoFixRec : Nat := site1RecGen 16383 32767 mShort mTail 0

private theorem site1Rec_arith (cA cB mS mT f : Nat) (hf : f = 510) :
    site1RecGen cA cB mS mT f = site1RecGen cA cB mS mT 0 + 510 := by
  unfold site1RecGen; omega

theorem site1Rec_eq : site1Rec = site1NoFixRec + 510 :=
  (show site1Rec = site1RecGen 16383 32767 mShort mTail fixRec8 from rfl).trans
    ((site1Rec_arith 16383 32767 mShort mTail fixRec8 fixRec8_eq).trans
      (congrArg (· + 510) (show site1RecGen 16383 32767 mShort mTail 0 = site1NoFixRec from rfl)))

private theorem twoPassCont_fin (s rA cA cB mS mT R : Nat) (hr : rA = cA) :
    s + rA + (774 + (mS + (258 + (cB + (513 + (mT + (513 + R))))))) =
      s + (site1RecGen cA cB mS mT 0 + R) := by
  subst hr; unfold site1RecGen; omega

def step8Cont {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (start : Nat) (refs123 : List (Fin start)) : Straight 65536 start (start + (513 + R)) :=
  castFinish (by rw [pairExtraWires_length]; exact Nat.add_assoc start 513 R)
    (MeasuredClear.measureThen (R := R) k pairExtraWires start refs123)

def step78Cont {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (start : Nat) (refs123 : List (Fin start)) : Straight 65536 start (start + (mTail + (513 + R))) :=
  castFinish (Nat.add_assoc start mTail (513 + R))
    ((literalFixed tailNorm mTail ((literal_meas (n := 65536) _).trans tailNorm_meas) start).append
      (step8Cont k (start + mTail) (refs123.map (Fin.castLE (Nat.le_add_right _ _)))))

def step678Cont {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (start : Nat) (refs12 : List (Fin start)) :
    Straight 65536 start (start + (513 + (mTail + (513 + R)))) :=
  castFinish (by rw [gB_len]; exact Nat.add_assoc start 513 _)
    (MeasuredClear.measureThen (R := mTail + (513 + R))
      (fun cursor rs => step78Cont k cursor rs) gB start refs12)

def step5678Cont {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (start : Nat) (refs12 : List (Fin start)) :
    Straight 65536 start (start + (32767 + (513 + (mTail + (513 + R))))) :=
  castFinish (by rw [fB_rec]; exact Nat.add_assoc start 32767 _)
    ((fB.loadProg start).append
      (step678Cont k (start + codeRecords fB.selBits fB.selPaths windowRoot fB.selCode)
        (refs12.map (Fin.castLE (Nat.le_add_right _ _)))))

def step4_8Cont {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (start : Nat) (refs1 : List (Fin start)) :
    Straight 65536 start (start + (258 + (32767 + (513 + (mTail + (513 + R)))))) :=
  castFinish (by rw [shortWires_length]; exact Nat.add_assoc start 258 _)
    (MeasuredClear.measureThen (R := 32767 + (513 + (mTail + (513 + R))))
      (fun cursor rs => step5678Cont k cursor rs) shortWires start refs1)

def step3_8Cont {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (start : Nat) (refs1 : List (Fin start)) :
    Straight 65536 start (start + (mShort + (258 + (32767 + (513 + (mTail + (513 + R))))))) :=
  castFinish (Nat.add_assoc start mShort _)
    ((literalFixed shortNorm mShort ((literal_meas (n := 65536) _).trans shortNorm_meas) start).append
      (step4_8Cont k (start + mShort) (refs1.map (Fin.castLE (Nat.le_add_right _ _)))))

def step2_8Cont {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (start : Nat) :
    Straight 65536 start (start + (774 + (mShort + (258 + (32767 + (513 + (mTail + (513 + R)))))))) :=
  castFinish (by rw [garbA_len]; exact Nat.add_assoc start 774 _)
    (MeasuredClear.measureThen (R := mShort + (258 + (32767 + (513 + (mTail + (513 + R))))))
      (fun cursor rs => step3_8Cont k cursor rs) garbA start List.nil)

def twoPassContProg {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (start : Nat) : Straight 65536 start (start + (site1NoFixRec + R)) :=
  castFinish ((twoPassCont_fin start _ 16383 32767 mShort mTail R fA_rec).trans
      (congrArg (fun x => start + (x + R)) (show site1RecGen 16383 32767 mShort mTail 0 = site1NoFixRec from rfl)))
    ((fA.loadProg start).append
      (step2_8Cont k (start + codeRecords fA.selBits fA.selPaths windowRoot fA.selCode)))

attribute [local irreducible] step8Cont step78Cont step678Cont step5678Cont step4_8Cont step3_8Cont step2_8Cont twoPassContProg

def step8ContSrc (kSrc : List Bool → AdaptiveCircuit) (o123 : List Bool) : AdaptiveCircuit :=
  measureResetThen pairExtraWires (fun o4 => kSrc (o123 ++ o4))

def step78ContSrc (kSrc : List Bool → AdaptiveCircuit) (o123 : List Bool) : AdaptiveCircuit :=
  (literalSource tailNorm).seq (step8ContSrc kSrc o123)

def step678ContSrc (kSrc : List Bool → AdaptiveCircuit) (o12 : List Bool) : AdaptiveCircuit :=
  measureResetThen gB (fun o3 => step78ContSrc kSrc (o12 ++ o3))

def step5678ContSrc (read : ConstantBit 65536 → Bool) (kSrc : List Bool → AdaptiveCircuit) (o12 : List Bool) : AdaptiveCircuit :=
  (fB.loadSource read).seq (step678ContSrc kSrc o12)

def step4_8ContSrc (read : ConstantBit 65536 → Bool) (kSrc : List Bool → AdaptiveCircuit) (o1 : List Bool) : AdaptiveCircuit :=
  measureResetThen shortWires (fun o2 => step5678ContSrc read kSrc (o1 ++ o2))

def step3_8ContSrc (read : ConstantBit 65536 → Bool) (kSrc : List Bool → AdaptiveCircuit) (o1 : List Bool) : AdaptiveCircuit :=
  (literalSource shortNorm).seq (step4_8ContSrc read kSrc o1)

def step2_8ContSrc (read : ConstantBit 65536 → Bool) (kSrc : List Bool → AdaptiveCircuit) : AdaptiveCircuit :=
  measureResetThen garbA (fun o1 => step3_8ContSrc read kSrc o1)

def twoPassContSrc (read : ConstantBit 65536 → Bool) (kSrc : List Bool → AdaptiveCircuit) : AdaptiveCircuit :=
  (fA.loadSource read).seq (step2_8ContSrc read kSrc)

theorem twoPassCont_run {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (kSrc : List Bool → AdaptiveCircuit) (read : ConstantBit 65536 → Bool)
    (hk : ∀ c rs hh, ((k c rs).instantiate read hh).run = (kSrc (rs.map hh)).run)
    (start : Nat) (h : Fin start → Bool) :
    ((twoPassContProg k start).instantiate read h).run = (twoPassContSrc read kSrc).run := by
  have h8 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step8Cont k c rs).instantiate read hh).run = (step8ContSrc kSrc (rs.map hh)).run := by
    rw [step8Cont, castFinish_instantiate, MeasuredClear.measureThen_run _ kSrc read hk]; rfl
  have h78 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step78Cont k c rs).instantiate read hh).run = (step78ContSrc kSrc (rs.map hh)).run := by
    rw [step78Cont, castFinish_instantiate,
      MeasuredClear.append_run_prefix _ _ read (Nat.le_refl c) hh hh rfl (step8ContSrc kSrc (rs.map hh)),
      AdaptiveCircuit.run_seq, literalFixed_run, ← AdaptiveCircuit.run_seq]
    · rfl
    · intro h' hh'; rw [h8, List.map_map]; congr 2; rw [← hh']; rfl
  have h678 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step678Cont k c rs).instantiate read hh).run = (step678ContSrc kSrc (rs.map hh)).run := by
    rw [step678Cont, castFinish_instantiate, MeasuredClear.measureThen_run _ (step78ContSrc kSrc) read h78]; rfl
  have h5678 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step5678Cont k c rs).instantiate read hh).run = (step5678ContSrc read kSrc (rs.map hh)).run := by
    rw [step5678Cont, castFinish_instantiate,
      MeasuredClear.append_run_prefix _ _ read (Nat.le_refl c) hh hh rfl (step678ContSrc kSrc (rs.map hh)),
      AdaptiveCircuit.run_seq, fB.loadProg_run, ← AdaptiveCircuit.run_seq]
    · rfl
    · intro h' hh'; rw [h678, List.map_map]; congr 2; rw [← hh']; rfl
  have h48 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step4_8Cont k c rs).instantiate read hh).run = (step4_8ContSrc read kSrc (rs.map hh)).run := by
    rw [step4_8Cont, castFinish_instantiate, MeasuredClear.measureThen_run _ (step5678ContSrc read kSrc) read h5678]; rfl
  have h38 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step3_8Cont k c rs).instantiate read hh).run = (step3_8ContSrc read kSrc (rs.map hh)).run := by
    rw [step3_8Cont, castFinish_instantiate,
      MeasuredClear.append_run_prefix _ _ read (Nat.le_refl c) hh hh rfl (step4_8ContSrc read kSrc (rs.map hh)),
      AdaptiveCircuit.run_seq, literalFixed_run, ← AdaptiveCircuit.run_seq]
    · rfl
    · intro h' hh'; rw [h48, List.map_map]; congr 2; rw [← hh']; rfl
  have h28 (c : Nat) (hh : Fin c → Bool) :
      ((step2_8Cont k c).instantiate read hh).run = (step2_8ContSrc read kSrc).run := by
    rw [step2_8Cont, castFinish_instantiate, MeasuredClear.measureThen_run _ (step3_8ContSrc read kSrc) read h38]
    simp only [List.map_nil, List.nil_append]; rfl
  rw [twoPassContProg, castFinish_instantiate,
    append_run_fixed _ _ _ _ _ (fun hh => h28 _ hh),
    AdaptiveCircuit.run_seq, fA.loadProg_run, ← AdaptiveCircuit.run_seq]
  rfl

theorem hot8_inj : Function.Injective hot8 := fun i j he => by
  apply Fin.ext; simp only [hot8] at he; dsimp only [Wire] at he; omega

theorem low8_ne_hot8 (i : Fin 8) (j : Fin 256) : WideBank8.low8 i ≠ hot8 j := by
  have hi := i.isLt; simp only [WideBank8.low8, hot8]; dsimp only [Wire]; omega

theorem hot8_disj : (MeasuredClear.hotBank8 hot8).Disjoint
    (windowRoot :: tree8.indexWires.dedup ++ WideBank8.Fast16.bank15.hp) := by
  apply List.disjoint_left.mpr
  intro w hw hm
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hw
  have hi := i.isLt
  rw [tree8, WideBank8.Fast16.bank15_ok.index] at hm
  simp only [hot8, windowRoot, WideBank8.Fast16.bank15, WideBank8.Fast16.high,
    List.mem_cons, List.mem_append, List.not_mem_nil, or_false, List.mem_range'_1] at hm
  dsimp only [Wire] at *; omega

theorem scratch8_not_tree : scratch8 ∉ windowRoot :: tree8.indexWires.dedup ++ WideBank8.Fast16.bank15.hp := by
  rw [tree8, WideBank8.Fast16.bank15_ok.index]
  simp only [scratch8, windowRoot, WideBank8.Fast16.bank15, WideBank8.Fast16.high,
    List.mem_cons, List.mem_append, List.not_mem_nil, or_false, List.mem_range'_1]
  dsimp only [Wire]; omega

theorem scratch8_not_hot : scratch8 ∉ MeasuredClear.hotBank8 hot8 := by
  intro hm; obtain ⟨i, hi⟩ := List.mem_ofFn.mp hm
  simp only [scratch8, hot8] at hi; dsimp only [Wire] at hi; omega

theorem hot8_in_pairExtra (i : Fin 256) : hot8 i ∈ pairExtraWires := by
  apply List.mem_append_left
  rw [scrPairWires_explicit]
  have hi := i.isLt
  simp only [hot8, List.mem_append, List.mem_cons, List.mem_range'_1, List.mem_singleton]
  dsimp only [Wire, ECDSAAdd.Wire]; omega

private theorem twoPassCont_tcount_arith (cA gA tS cB gB tT tK : Nat) :
    7 * (cA + gA) + (7 * tS + (7 * (cB + gB) + (7 * tT + tK))) =
      7 * (cA + gA + tS + cB + gB + tT) + tK := by ring

theorem twoPassCont_tCount {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (tK : Nat) (read : ConstantBit 65536 → Bool)
    (hk : ∀ c rs hh, ((k c rs).instantiate read hh).tCount = tK)
    (start : Nat) (h : Fin start → Bool) :
    ((twoPassContProg k start).instantiate read h).tCount =
      7 * (16383 + 774 + ECDSAAdd.toffoliCount shortNorm + 32767 + 513 +
        ECDSAAdd.toffoliCount tailNorm) + tK := by
  have h8 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step8Cont k c rs).instantiate read hh).tCount = tK := by
    rw [step8Cont, castFinish_instantiate, MeasuredClear.measureThen_tCount _ read hk]
  have h78 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step78Cont k c rs).instantiate read hh).tCount = 7 * ECDSAAdd.toffoliCount tailNorm + tK := by
    rw [step78Cont, castFinish_instantiate, append_tCount_fixed _ _ _ _ _ (fun h' => h8 _ _ h'), literalFixed_tCount]
  have h678 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step678Cont k c rs).instantiate read hh).tCount = 7 * ECDSAAdd.toffoliCount tailNorm + tK := by
    rw [step678Cont, castFinish_instantiate, MeasuredClear.measureThen_tCount _ read h78]
  have h5678 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step5678Cont k c rs).instantiate read hh).tCount =
        7 * (32767 + 513) + (7 * ECDSAAdd.toffoliCount tailNorm + tK) := by
    rw [step5678Cont, castFinish_instantiate, append_tCount_fixed _ _ _ _ _ (fun h' => h678 _ _ h'),
      fB.loadProg_tCount read fB_geo]
    have hbl : fB.selBits.length = 15 := by decide
    have hpl : fB.ports.length = 513 := pp16_length
    rw [hbl, hpl, show 2 ^ 15 - 1 = 32767 from rfl]
  have h48 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step4_8Cont k c rs).instantiate read hh).tCount =
        7 * (32767 + 513) + (7 * ECDSAAdd.toffoliCount tailNorm + tK) := by
    rw [step4_8Cont, castFinish_instantiate, MeasuredClear.measureThen_tCount _ read h5678]
  have h38 (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) :
      ((step3_8Cont k c rs).instantiate read hh).tCount =
        7 * ECDSAAdd.toffoliCount shortNorm +
          (7 * (32767 + 513) + (7 * ECDSAAdd.toffoliCount tailNorm + tK)) := by
    rw [step3_8Cont, castFinish_instantiate, append_tCount_fixed _ _ _ _ _ (fun h' => h48 _ _ h'), literalFixed_tCount]
  have h28 (c : Nat) (hh : Fin c → Bool) :
      ((step2_8Cont k c).instantiate read hh).tCount =
        7 * ECDSAAdd.toffoliCount shortNorm +
          (7 * (32767 + 513) + (7 * ECDSAAdd.toffoliCount tailNorm + tK)) := by
    rw [step2_8Cont, castFinish_instantiate, MeasuredClear.measureThen_tCount _ read h38]
  rw [twoPassContProg, castFinish_instantiate, append_tCount_fixed _ _ _ _ _ (fun h' => h28 _ h'),
    fA.loadProg_tCount read fA_geo]
  have hbl : fA.selBits.length = 14 := by decide
  have hpl : fA.ports.length = 258 := sp16_length
  rw [hbl, hpl, show 2 ^ 14 - 1 = 16383 from rfl, show 3 * 258 = 774 from rfl]
  exact twoPassCont_tcount_arith 16383 774 (ECDSAAdd.toffoliCount shortNorm) 32767 513 (ECDSAAdd.toffoliCount tailNorm) tK

theorem twoPassCont_residue {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (hk : ∀ c rs, AndGadget.residue (k c rs) = 0) (start : Nat) :
    AndGadget.residue (twoPassContProg k start) = 0 := by
  have h8 (c : Nat) (rs : List (Fin c)) : AndGadget.residue (step8Cont k c rs) = 0 := by
    rw [step8Cont, AndGadget.residue_cast]; exact MeasuredClear.measureThen_residue _ hk _ _ _
  have h78 (c : Nat) (rs : List (Fin c)) : AndGadget.residue (step78Cont k c rs) = 0 := by
    rw [step78Cont, AndGadget.residue_cast, AndGadget.residue_append, literalFixed, WEXCredit.residue_naive_cast,
      WEXCredit.literal_residue, h8]
  have h678 (c : Nat) (rs : List (Fin c)) : AndGadget.residue (step678Cont k c rs) = 0 := by
    rw [step678Cont, AndGadget.residue_cast]; exact MeasuredClear.measureThen_residue _ h78 _ _ _
  have h5678 (c : Nat) (rs : List (Fin c)) : AndGadget.residue (step5678Cont k c rs) = 0 := by
    rw [step5678Cont, AndGadget.residue_cast, AndGadget.residue_append, fB.loadProg_residue, h678]
  have h48 (c : Nat) (rs : List (Fin c)) : AndGadget.residue (step4_8Cont k c rs) = 0 := by
    rw [step4_8Cont, AndGadget.residue_cast]; exact MeasuredClear.measureThen_residue _ h5678 _ _ _
  have h38 (c : Nat) (rs : List (Fin c)) : AndGadget.residue (step3_8Cont k c rs) = 0 := by
    rw [step3_8Cont, AndGadget.residue_cast, AndGadget.residue_append, literalFixed, WEXCredit.residue_naive_cast,
      WEXCredit.literal_residue, h48]
  have h28 (c : Nat) : AndGadget.residue (step2_8Cont k c) = 0 := by
    rw [step2_8Cont, AndGadget.residue_cast]; exact MeasuredClear.measureThen_residue _ h38 _ _ _
  rw [twoPassContProg, AndGadget.residue_cast, AndGadget.residue_append, fA.loadProg_residue, h28]

theorem twoPassCont_wellFormed {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (hk : ∀ c rs, (k c rs).WellFormed) (start : Nat) : (twoPassContProg k start).WellFormed := by
  have h8 (c : Nat) (rs : List (Fin c)) : (step8Cont k c rs).WellFormed := by
    rw [step8Cont, castFinish_wellFormed]
    exact MeasuredClear.measureThen_wellFormed (R := R) k hk pairExtraWires c rs
  have h78 (c : Nat) (rs : List (Fin c)) : (step78Cont k c rs).WellFormed := by
    rw [step78Cont, castFinish_wellFormed]
    exact straight_append_wellFormed _ _ (literalFixed_wellFormed _ _ _ tailNorm_valid _) (h8 _ _)
  have h678 (c : Nat) (rs : List (Fin c)) : (step678Cont k c rs).WellFormed := by
    rw [step678Cont, castFinish_wellFormed]
    exact MeasuredClear.measureThen_wellFormed (R := mTail + (513 + R)) (fun cur rs' => step78Cont k cur rs') h78 gB c rs
  have h5678 (c : Nat) (rs : List (Fin c)) : (step5678Cont k c rs).WellFormed := by
    rw [step5678Cont, castFinish_wellFormed]
    exact straight_append_wellFormed _ _ (fB.loadProg_wellFormed fB_geo _) (h678 _ _)
  have h48 (c : Nat) (rs : List (Fin c)) : (step4_8Cont k c rs).WellFormed := by
    rw [step4_8Cont, castFinish_wellFormed]
    exact MeasuredClear.measureThen_wellFormed (R := 32767 + (513 + (mTail + (513 + R)))) (fun cur rs' => step5678Cont k cur rs') h5678 shortWires c rs
  have h38 (c : Nat) (rs : List (Fin c)) : (step3_8Cont k c rs).WellFormed := by
    rw [step3_8Cont, castFinish_wellFormed]
    exact straight_append_wellFormed _ _ (literalFixed_wellFormed _ _ _ shortNorm_valid _) (h48 _ _)
  have h28 (c : Nat) : (step2_8Cont k c).WellFormed := by
    rw [step2_8Cont, castFinish_wellFormed]
    exact MeasuredClear.measureThen_wellFormed (R := mShort + (258 + (32767 + (513 + (mTail + (513 + R)))))) (fun cur rs' => step3_8Cont k cur rs') h38 garbA c List.nil
  rw [twoPassContProg, castFinish_wellFormed]
  exact straight_append_wellFormed _ _ (fA.loadProg_wellFormed fA_geo _) (h28 _)

theorem twoPassCont_support {R : Nat} (k : (c : Nat) → List (Fin c) → Straight 65536 c (c + R))
    (hk : ∀ c rs, ChallengeMigration.straightWires (k c rs) ⊆ WideBank8.Fast16.Tight.support)
    (start : Nat) :
    ChallengeMigration.straightWires (twoPassContProg k start) ⊆ WideBank8.Fast16.Tight.support := by
  have hcov := WideBank8.Fast16.Tight.old_cover
  have hroot : windowRoot ∈ WideBank8.Fast16.Tight.support := WideBank8.Fast16.Tight.root_new
  have h855 : (855 : Wire) ∈ WideBank8.Fast16.Tight.support := WideBank8.Fast16.Tight.low8_new ⟨0, by decide⟩
  have h856 : (856 : Wire) ∈ WideBank8.Fast16.Tight.support := WideBank8.Fast16.Tight.low8_new ⟨1, by decide⟩
  have hsA : fA.selBits ⊆ WideBank8.Fast16.Tight.support := WideBank8.Fast16.Tight.selBits_new
  have hpA : fA.selPaths ⊆ WideBank8.Fast16.Tight.support := WideBank8.Fast16.Tight.selPaths_new
  have hsB : fB.selBits ⊆ WideBank8.Fast16.Tight.support := WideBank8.Fast16.Tight.selBits1_new
  have hpB : fB.selPaths ⊆ WideBank8.Fast16.Tight.support := WideBank8.Fast16.Tight.selPaths1_new
  have hregA : portTargets fA.ports ++ fA.garb ⊆ WideBank8.Fast16.Tight.support := fun w hw => by
    rw [fA, sp16_targets] at hw; exact hcov (pool_band_in_newH7 (mem_short_garbA hw))
  have hregB : portTargets fB.ports ++ fB.g1 ⊆ WideBank8.Fast16.Tight.support := fun w hw => by
    rw [fB, pp16_targets] at hw; exact hcov (pool_band_in_newH7 (mem_pairExtra_gB hw))
  have hgarbA : garbA ⊆ WideBank8.Fast16.Tight.support := fun w hw =>
    hcov (pool_band_in_newH7 (mem_short_garbA (List.mem_append_right _ hw)))
  have hshortW : shortWires ⊆ WideBank8.Fast16.Tight.support := fun w hw =>
    hcov (pool_band_in_newH7 (mem_short_garbA (List.mem_append_left _ hw)))
  have hgB : gB ⊆ WideBank8.Fast16.Tight.support := fun w hw =>
    hcov (pool_band_in_newH7 (mem_pairExtra_gB (List.mem_append_right _ hw)))
  have hpairW : pairExtraWires ⊆ WideBank8.Fast16.Tight.support := fun w hw =>
    hcov (pool_band_in_newH7 (mem_pairExtra_gB (List.mem_append_left _ hw)))
  have hshortN : ECDSAAdd.wires shortNorm ⊆ WideBank8.Fast16.Tight.support.toFinset := fun w hw =>
    List.mem_toFinset.mpr (hcov (List.mem_toFinset.mp (shortPart_wires_newH7 hw)))
  have htailN : ECDSAAdd.wires tailNorm ⊆ WideBank8.Fast16.Tight.support.toFinset := fun w hw =>
    List.mem_toFinset.mpr (hcov (List.mem_toFinset.mp (tailPart_wires_newH7 hw)))
  have h8 (c : Nat) (rs : List (Fin c)) :
      ChallengeMigration.straightWires (step8Cont k c rs) ⊆ WideBank8.Fast16.Tight.support := by
    rw [step8Cont, support_cast, WEX.support_agrees]
    exact MeasuredClear.measureThen_within _ _ (fun cur rs' => by rw [← WEX.support_agrees]; exact hk cur rs') _ _ _ hpairW
  have h78 (c : Nat) (rs : List (Fin c)) :
