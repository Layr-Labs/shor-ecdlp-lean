-- tCount (≤ 4 * toffoliCount) for replay hierarchy
theorem compiledRawReplay_tCount {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledRawReplay (n := n) divide ls s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.rawReplayS divide ls) := by
  induction ls generalizing s read h with
  | nil => exact (CatFn.noT_tCount List.nil rfl s read h).trans (Nat.zero_le _)
  | cons l ls ih =>
    cases divide
    · refine (CatFn.seq_tCount_le _ _ (compiledCell_indep false l.1.1 l.1.2)
        (fun s' r' h' => ih s' r' h') (compiledCell_tCount false l.1.1 l.1.2) s read h).trans ?_
      simp only [SW.rawReplayS, Bool.false_eq_true, if_false, ECDSAAdd.toffoliCount_append]; omega
    · refine (CatFn.seq_tCount_le _ _ (compiledRawReplay_indep true ls)
        (compiledCell_tCount true l.1.1 l.1.2) (fun s' r' h' => ih s' r' h') s read h).trans ?_
      simp only [SW.rawReplayS, if_true, ECDSAAdd.toffoliCount_append]; omega

theorem compiledBasePacket_tCount {n : Nat} (divide : Bool) (j s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledBasePacket (n := n) divide j s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.basePacketS divide j) := by
  rw [compiledBasePacket]
  refine (CatFn.seq_tCount_le _ _ (CatFn.compileProg_indep _ _ _)
    (CatFn.seq_tCount_le _ _ (compiledRawReplay_indep divide _)
      (CatFn.compileProg_tCount _ _ _) (compiledRawReplay_tCount divide _))
    (CatFn.compileProg_tCount _ _ _) s read h).trans ?_
  simp only [SW.basePacketS, ECDSAAdd.toffoliCount_append]; rw [base_eq_mc]; omega

theorem compiledPacket_tCount {n : Nat} (divide : Bool) (j s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledPacket (n := n) divide j s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.packetS divide j) := by
  rw [compiledPacket, SW.packetS, (ECDSAAdd.renameProgram_counts _ _).1]
  exact CatFn.map_tCount_le _ _ (compiledBasePacket_tCount divide j) s read h

theorem compiledGroups_tCount {n : Nat} (divide : Bool) (j m s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledGroups (n := n) divide j m s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.groupsS divide j m) := by
  induction m generalizing j s read h with
  | zero => exact (CatFn.noT_tCount List.nil rfl s read h).trans (Nat.zero_le _)
  | succ m ih =>
    cases divide
    · refine (CatFn.seq_tCount_le _ _ (compiledPacket_indep false j)
        (fun s' r' h' => ih (j + 1) s' r' h') (compiledPacket_tCount false j) s read h).trans ?_
      simp only [SW.groupsS, PacketSequence.program, Bool.false_eq_true, if_false,
        ECDSAAdd.toffoliCount_append]; omega
    · refine (CatFn.seq_tCount_le _ _ (compiledGroups_indep true (j + 1) m)
        (compiledPacket_tCount true j) (fun s' r' h' => ih (j + 1) s' r' h') s read h).trans ?_
      simp only [SW.groupsS, PacketSequence.program, if_true, ECDSAAdd.toffoliCount_append]; omega

theorem compiledFirstSwap_tCount {n : Nat} (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledFirstSwap (n := n) s).prog.instantiate read h).tCount ≤ 4 * ECDSAAdd.toffoliCount SW.firstSwapS := by
  rw [compiledFirstSwap]
  refine (compiledSelW_tCount_le _ _ _ compiledSwapBody_indep compiledSwapBody_tCount s read h).trans ?_
  simp only [SW.firstSwapS, SW.selW, ECDSAAdd.toffoliCount_append]
  have h1 : ECDSAAdd.toffoliCount [.CX (base 1028) (base 2410)] = 0 := rfl
  have h2 : ECDSAAdd.toffoliCount [.measureX (base 2410) List.nil ([.Z (base 1028)])] = 0 := rfl
  rw [h1, h2]; omega

theorem compiledFirstSwapM_tCount {n : Nat} (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledFirstSwapM (n := n) s).prog.instantiate read h).tCount ≤ 4 * ECDSAAdd.toffoliCount SW.firstSwapMS := by
  have hm0 : ECDSAAdd.toffoliCount SW.swapBodyM = 0 := by
    rw [swapBodyM_def]
    have w := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
    exact (UncompSwap.mswap_counts _ _ _ (w.2.1.trans w.2.2.1.symm)).1
  rw [compiledFirstSwapM]
  exact (compiledSelW_tCount_le _ _ _ (CatFn.noT_indep _) (CatFn.noT_tCount _ hm0) s read h).trans (Nat.zero_le _)

theorem compiledFirstBody_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledFirstBody (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.firstBodyS divide) := by
  rw [compiledFirstBody]; cases divide
  · refine (CatFn.seq_tCount_le _ _ compiledFirstSwapM_indep (compiledRawReplay_tCount false _)
      compiledFirstSwapM_tCount s read h).trans ?_
    simp only [SW.firstBodyS, Bool.false_eq_true, if_false, ECDSAAdd.toffoliCount_append]; omega
  · refine (CatFn.seq_tCount_le _ _ (CatFn.seq_indep _ _ (compiledZCell_indep _ _) (compiledRawReplay_indep true _))
      compiledFirstSwap_tCount
      (CatFn.seq_tCount_le _ _ (compiledRawReplay_indep true _) (compiledZCell_tCount _ _)
        (compiledRawReplay_tCount true _)) s read h).trans ?_
    simp only [SW.firstBodyS, if_true, ECDSAAdd.toffoliCount_append]; omega

theorem compiledBaseFirstPacket_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledBaseFirstPacket (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.baseFirstPacketS divide) := by
  rw [compiledBaseFirstPacket]
  refine (CatFn.seq_tCount_le _ _ (CatFn.compileProg_indep _ _ _)
    (CatFn.seq_tCount_le _ _ (compiledFirstBody_indep divide)
      (CatFn.compileProg_tCount _ _ _) (compiledFirstBody_tCount divide))
    (CatFn.compileProg_tCount _ _ _) s read h).trans ?_
  simp only [SW.baseFirstPacketS, ECDSAAdd.toffoliCount_append]; rw [base_eq_mc]; omega

theorem compiledFirstPacket_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledFirstPacket (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.firstPacketS divide) := by
  rw [compiledFirstPacket, SW.firstPacketS, (ECDSAAdd.renameProgram_counts _ _).1]
  exact CatFn.map_tCount_le _ _ (compiledBaseFirstPacket_tCount divide) s read h

theorem compiledRawEnd_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledRawEnd (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.rawEndS divide) := by
  rw [compiledRawEnd]
  refine (compiledSelW_tCount_le _ _ _ (compiledHalfE_indep divide) (compiledHalfE_tCount divide) s read h).trans ?_
  simp only [SW.rawEndS, SW.selW, ECDSAAdd.toffoliCount_append]
  rw [base_eq_mc]
  have h1 : ECDSAAdd.toffoliCount [.CX (MappedCompressed.base 510) (MappedCompressed.base 2409)] = 0 := rfl
  have h2 : ECDSAAdd.toffoliCount [.measureX (MappedCompressed.base 2409) List.nil ([.Z (MappedCompressed.base 510)])] = 0 := rfl
  rw [h1, h2]; omega

theorem compiledEndPacket_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledEndPacket (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.endPacketS divide) := by
  rw [compiledEndPacket, SW.endPacketS, (ECDSAAdd.renameProgram_counts _ _).1]
  exact CatFn.map_tCount_le _ _ (compiledRawEnd_tCount divide) s read h

theorem compiledLogicalReplayS_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledLogicalReplayS (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.logicalReplayS divide) := by
  rw [compiledLogicalReplayS]; cases divide
  · refine (CatFn.seq_tCount_le _ _ (compiledFirstPacket_indep false)
      (CatFn.seq_tCount_le _ _ (compiledGroups_indep false 1 101)
        (compiledEndPacket_tCount false) (compiledGroups_tCount false 1 101))
      (compiledFirstPacket_tCount false) s read h).trans ?_
    simp only [SW.logicalReplayS, Bool.false_eq_true, if_false, ECDSAAdd.toffoliCount_append]; omega
  · refine (CatFn.seq_tCount_le _ _ (compiledEndPacket_indep true)
      (CatFn.seq_tCount_le _ _ (compiledGroups_indep true 1 101)
        (compiledFirstPacket_tCount true) (compiledGroups_tCount true 1 101))
      (compiledEndPacket_tCount true) s read h).trans ?_
    simp only [SW.logicalReplayS, if_true, ECDSAAdd.toffoliCount_append]; omega

theorem compiledReplayS_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledReplayS (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.replayS divide) := by
  rw [compiledReplayS, SW.replayS, (ECDSAAdd.renameProgram_counts _ _).1]
  exact CatFn.map_tCount_le _ _ (compiledLogicalReplayS_tCount divide) s read h

-- Slots for replay hierarchy
private theorem history_codec_compileProg_slots {n : Nat} (start s : Nat) :
    (CatFn.compileProg (n := n) (base 1541) (base 1026) (History5.decode base start) s).prog.gateSlots ≤ 3000 ∧
    (CatFn.compileProg (n := n) (base 1541) (base 1026) (History5.encode base start) s).prog.gateSlots ≤ 3000 := by
  have hs := History5.codec_slots base start
  have hd := (History5.decode_counts base start).1
  have he := (History5.encode_counts base start).1
  exact ⟨(CatFn.compileProg_slots _ _ _ s).trans (by rw [hs.2, hd]; omega),
    (CatFn.compileProg_slots _ _ _ s).trans (by rw [hs.1, he]; omega)⟩

theorem compiledRawReplay_slots {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter) (s : Nat) :
    (compiledRawReplay (n := n) divide ls s).prog.gateSlots ≤ ls.length * 932000 := by
  induction ls generalizing s with
  | nil => exact (CatFn.noT_slots List.nil s).trans (by decide)
  | cons l ls ih =>
    cases divide
    · exact (CatFn.seq_slots _ _ (fun s' => ih s') (compiledCell_slots false l.1.1 l.1.2) s).trans
        (by simp only [List.length_cons]; omega)
    · exact (CatFn.seq_slots _ _ (compiledCell_slots true l.1.1 l.1.2) (fun s' => ih s') s).trans
        (by simp only [List.length_cons]; omega)

theorem compiledBasePacket_slots {n : Nat} (divide : Bool) (j s : Nat) :
    (compiledBasePacket (n := n) divide j s).prog.gateSlots ≤ 4700000 := by
  have hlen : (Replay5.letters j).length = 5 := by simp [Replay5.letters]
  rw [compiledBasePacket]
  refine (CatFn.seq_slots _ _
    (CatFn.seq_slots _ _ (fun s' => (history_codec_compileProg_slots (5 * j) s').1)
      (compiledRawReplay_slots divide _))
    (fun s' => (history_codec_compileProg_slots (5 * j) s').2) s).trans ?_
  rw [hlen]; omega

theorem compiledPacket_slots {n : Nat} (divide : Bool) (j s : Nat) :
    (compiledPacket (n := n) divide j s).prog.gateSlots ≤ 4700000 := by
  rw [compiledPacket]; exact CatFn.map_slots _ _ (compiledBasePacket_slots divide j) s

theorem compiledGroups_slots {n : Nat} (divide : Bool) (j m s : Nat) :
    (compiledGroups (n := n) divide j m s).prog.gateSlots ≤ m * 4700000 := by
  induction m generalizing j s with
  | zero => exact (CatFn.noT_slots List.nil s).trans (by decide)
  | succ m ih =>
    cases divide
    · exact (CatFn.seq_slots _ _ (fun s' => ih (j + 1) s') (compiledPacket_slots false j) s).trans (by omega)
    · exact (CatFn.seq_slots _ _ (compiledPacket_slots true j) (fun s' => ih (j + 1) s') s).trans (by omega)

theorem compiledFirstSwap_slots {n : Nat} (s : Nat) : (compiledFirstSwap (n := n) s).prog.gateSlots ≤ 31000 := by
  rw [compiledFirstSwap]; exact (compiledSelW_slots _ _ _ compiledSwapBody_slots s).trans (by omega)

theorem compiledFirstSwapM_slots {n : Nat} (s : Nat) : (compiledFirstSwapM (n := n) s).prog.gateSlots ≤ 31000 := by
  have w := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
  have hms : ECDSAAdd.Challenge.gateSlots SW.swapBodyM = 4 * 256 := by
    rw [swapBodyM_def]
    have h := UncompSwap.mswap_slots (base 2410) cellLayout.r cellLayout.y (w.2.1.trans w.2.2.1.symm)
    rw [w.2.1] at h; exact h
  rw [compiledFirstSwapM]
  exact (compiledSelW_slots _ _ _ (CatFn.noT_slots SW.swapBodyM) s).trans (by rw [hms]; omega)

theorem compiledFirstBody_slots {n : Nat} (divide : Bool) (s : Nat) :
    (compiledFirstBody (n := n) divide s).prog.gateSlots ≤ 4600000 := by
  rw [compiledFirstBody]; cases divide
  · have hlen : Replay5.restLetters.length = 4 := by simp [Replay5.restLetters]
    exact (CatFn.seq_slots _ _ (compiledRawReplay_slots false _) compiledFirstSwapM_slots s).trans (by rw [hlen]; omega)
  · have hlen := OneBankReplay5.firstTailLetters_length
    exact (CatFn.seq_slots _ _ compiledFirstSwap_slots
      (CatFn.seq_slots _ _ (compiledZCell_slots _ _) (compiledRawReplay_slots true _)) s).trans (by rw [hlen]; omega)

theorem compiledFirstPacket_slots {n : Nat} (divide : Bool) (s : Nat) :
    (compiledFirstPacket (n := n) divide s).prog.gateSlots ≤ 4700000 := by
  rw [compiledFirstPacket]
  refine CatFn.map_slots _ _ (fun s' => ?_) s
  rw [compiledBaseFirstPacket]
  exact (CatFn.seq_slots _ _ (CatFn.seq_slots _ _ (fun s'' => (history_codec_compileProg_slots 0 s'').1)
    (compiledFirstBody_slots divide)) (fun s'' => (history_codec_compileProg_slots 0 s'').2) s').trans (by omega)

theorem compiledEndPacket_slots {n : Nat} (divide : Bool) (s : Nat) :
    (compiledEndPacket (n := n) divide s).prog.gateSlots ≤ 932000 := by
  rw [compiledEndPacket]
  refine CatFn.map_slots _ _ (fun s' => ?_) s
  rw [compiledRawEnd]
  exact (compiledSelW_slots _ _ _ (compiledHalfE_slots divide) s').trans (by omega)

theorem compiledReplayS_slots {n : Nat} (divide : Bool) (s : Nat) :
    (compiledReplayS (n := n) divide s).prog.gateSlots ≤ 482000000 := by
  rw [compiledReplayS]
  refine CatFn.map_slots _ _ (fun s' => ?_) s
  rw [compiledLogicalReplayS]; cases divide
  · exact (CatFn.seq_slots _ _ (CatFn.seq_slots _ _ (compiledEndPacket_slots false) (compiledGroups_slots false 1 101))
      (compiledFirstPacket_slots false) s').trans (by omega)
  · exact (CatFn.seq_slots _ _ (CatFn.seq_slots _ _ (compiledFirstPacket_slots true) (compiledGroups_slots true 1 101))
      (compiledEndPacket_slots true) s').trans (by omega)

-- Wires (`⊆ segNo2400`) & WellFormed for replay hierarchy
def segNo2400 : Finset Wire := OB5Support.segSites.erase (base 2400)
def logicalNo2400 : Finset Wire := OB5Support.logicalSites.erase (base 2400)

private def readNo2400 (start : Nat) : Finset Wire :=
  (OneBankReplay5.readSites start).erase (base 2400)

private theorem cellWires_sub_readNo2400 (start : Nat) : cellWires ⊆ (readNo2400 start).toList := by
  intro w hw
  rw [Finset.mem_toList, readNo2400, Finset.mem_erase]
  refine ⟨?_, cellWires_sub_readSites start w hw⟩
  intro he; subst he
  simp only [cellWires, List.mem_cons, List.mem_map] at hw
  rcases hw with e | ⟨j, hj, e⟩
  · have := MappedCompressed.base_injective e; omega
  · have := MappedCompressed.base_injective e; have := OneBankCell5.ids_bound j hj; omega

private theorem base2410_mem_readNo2400 (start : Nat) : base 2410 ∈ (readNo2400 start).toList := by
  rw [Finset.mem_toList, readNo2400, Finset.mem_erase]
  exact ⟨base_ne 2410 2400 (by omega), Finset.mem_union_left _ (Finset.mem_union_right _ (by simp))⟩

private theorem history_codec_sub_readNo2400 (start : Nat) (hs : start + 5 ≤ 510)
    (P : ECDSAAdd.Program) (hP : P = History5.encode base start ∨ P = History5.decode base start) :
    ECDSAAdd.wires P ⊆ (readNo2400 start).toList.toFinset := by
  intro q hq
  rw [List.mem_toFinset, Finset.mem_toList, readNo2400, Finset.mem_erase]
  obtain ⟨r, rfl⟩ := History5.history_gate_mem base start P hP q hq
  have hb := History5.historyId_bound start (by omega) r
  exact ⟨fun e => by have := MappedCompressed.base_injective e; omega,
    Finset.mem_union_right _ (History5.history_site_mem base start r)⟩

private theorem compiledRawReplay_wires {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter) {S : List Wire}
    (hcw : cellWires ⊆ S) (h2410 : base 2410 ∈ S)
    (hl : ∀ l ∈ ls, l.1.1 ∈ S ∧ l.1.2 ∈ S) (s : Nat) :
    ChallengeMigration.straightWires (compiledRawReplay (n := n) divide ls s).prog ⊆ S := by
  induction ls generalizing s with
  | nil => exact CatFn.noT_wires List.nil (by simp [ECDSAAdd.wires]) s
  | cons l ls ih =>
    have h0 := hl l (by simp)
    have hrest : ∀ x ∈ ls, x.1.1 ∈ S ∧ x.1.2 ∈ S := fun x hx => hl x (List.mem_cons_of_mem _ hx)
    cases divide
    · exact CatFn.seq_wires _ _ (fun s' => ih hrest s') (compiledCell_wires false l.1.1 l.1.2 hcw h2410 h0.1 h0.2) s
    · exact CatFn.seq_wires _ _ (compiledCell_wires true l.1.1 l.1.2 hcw h2410 h0.1 h0.2) (fun s' => ih hrest s') s

private theorem readNo2400_placed_segNo2400 (j : Nat) (hj : j < 102) (q : Wire)
    (hq : q ∈ (readNo2400 (5 * j)).toList) :
    OB5.sig 511 (shifted (Placement5.pi j) q) ∈ segNo2400.toList := by
  rw [Finset.mem_toList, readNo2400, Finset.mem_erase] at hq
  rw [Finset.mem_toList, segNo2400, Finset.mem_erase]
  have hne : OB5.sig 511 (shifted (Placement5.pi j) q) ≠ base 2400 := by
    intro e
    have hfix : OB5.sig 511 (shifted (Placement5.pi j) (base 2400)) = base 2400 := by
      rw [SW.selShift_fix j hj, SW.selSig_2400]
    exact hq.1 ((shifted (Placement5.pi j)).injective (OB5.sig_injective 511 (by decide) (e.trans hfix.symm)))
  refine ⟨hne, ?_⟩
  have hsub : OB5.sig 511 (shifted (Placement5.pi j) q) ∈ OB5Support.segSites := by
    -- Reuse `OneBankReplay5Support.packet_support` logic directly on `readSites (5 * j)`
    have h1 : ECDSAAdd.wires [.X q] ⊆ OneBankReplay5.readSites (5 * j) := by
      intro x hx; simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
        Finset.mem_singleton, Finset.notMem_empty, or_false] at hx; exact hx ▸ hq.2
    -- Prove via explicit case split matching `OneBankReplay5Support`
    have hpi_mem (i : Nat) (hi : (i < 1542 ∧ i ≠ 769 ∧ i ≠ 511 ∧ i ≠ 1539) ∨ i = 1797 ∨ (2056 ≤ i ∧ i ≤ 2312) ∨ i = 2409 ∨ i = 2410)
        (hhole : ¬Placement5.holeRegion i) : OB5.sig 511 (base (Placement5.pi j i)) ∈ OB5Support.segSites := by
      have hsafe := Placement5.nonhole_pi_safe j i hj hhole
      have hfr : (Placement5.pi j i < 1542 ∧ Placement5.pi j i ≠ 769 ∧ Placement5.pi j i ≠ 511 ∧ Placement5.pi j i ≠ 1539) ∨
          Placement5.pi j i = 1797 ∨ (2056 ≤ Placement5.pi j i ∧ Placement5.pi j i ≤ 2312) ∨
          Placement5.pi j i = 2409 ∨ Placement5.pi j i = 2410 := by
        have hout (c : Nat) (hc : ¬Placement5.zeroRegion c) (k : Nat) (hk : k ≠ c) : Placement5.pi j k ≠ c := fun eq =>
          hk ((Placement5.pi j).injective (eq.trans (Placement5.pi_outside j c hj hc).symm))
        rcases hi with h | h | h | h | h
        · refine Or.inl ⟨?_, hout 769 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.1,
            hout 511 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.1,
            hout 1539 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.2⟩
          by_contra hn
          have ho : ¬Placement5.zeroRegion (Placement5.pi j i) := by
            unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega
          have := (Placement5.pi j).injective (Placement5.pi_outside j _ hj ho); omega
        all_goals
          have ho : ¬Placement5.zeroRegion i := by
            unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega
          rw [Placement5.pi_outside j i hj ho]; omega
      rw [OB5.sig_base 511 _ (by decide)]
      apply List.mem_toFinset.mpr; apply List.mem_map.mpr; refine ⟨_, ?_, rfl⟩
      simp only [OB5Support.segIndices, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil, or_false]
      unfold Placement5.omitted at hsafe
      split_ifs <;> omega
    simp only [OneBankReplay5.readSites, OneBankReplay5.fieldSites, Finset.mem_union] at hq
    rcases hq.2 with (h | h) | h
    · rcases List.mem_cons.mp (List.mem_toFinset.mp h) with rfl | h
      · rw [shifted_base]; exact hpi_mem 2409 (by omega) (by unfold Placement5.holeRegion; omega)
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp h
        rw [shifted_base]
        simp only [OneBankCell5.ids, List.mem_append, List.mem_cons, List.not_mem_nil, List.mem_range'_1, or_false] at hi
        exact hpi_mem i (by omega) (by unfold Placement5.holeRegion; omega)
    · simp only [Finset.mem_insert, Finset.mem_singleton] at h
      rcases h with rfl | rfl
      · exact absurd rfl hq.1
      · rw [shifted_base]; exact hpi_mem 2410 (by omega) (by unfold Placement5.holeRegion; omega)
    · obtain ⟨r, rfl⟩ := History5.history_gate_mem base (5 * j) _ (Or.inl rfl) q h
      rw [History5.historyMap, shifted_base]
      have hsig (k : Nat) (hk : (k < 1542 ∧ k ≠ 769 ∧ k ≠ 511 ∧ k ≠ 1539) ∧ ¬Placement5.omitted k) :
          OB5.sig 511 (base k) ∈ OB5Support.segSites := by
        rw [OB5.sig_base 511 k (by decide)]
        apply List.mem_toFinset.mpr; apply List.mem_map.mpr; refine ⟨_, ?_, rfl⟩
        simp only [OB5Support.segIndices, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil, or_false]
        unfold Placement5.omitted at hk; split_ifs <;> omega
      by_cases hole : Placement5.holeRegion (History5.historyId (5 * j) r)
      · have h2 : History5.historyId (5 * j) r = Placement5.H (2 * j) ∨
            History5.historyId (5 * j) r = Placement5.H (2 * j + 1) := by
          have hr := r.isLt
          have he : Placement5.H (2 * j) = 1030 + 5 * j := by unfold Placement5.H; omega
          have ho : Placement5.H (2 * j + 1) = 1032 + 5 * j := by unfold Placement5.H; omega
          rw [he, ho]; unfold History5.historyId at hole ⊢
          split_ifs at hole ⊢ <;> unfold Placement5.holeRegion at hole <;> omega
        rcases h2 with h2 | h2
        · rw [h2, Placement5.pi_current_even j hj]
          have hb := Placement5.H_bound (2 * j) (by omega)
          exact hsig _ ⟨by omega, by unfold Placement5.omitted; omega⟩
        · rw [h2, Placement5.pi_current_odd j hj]
          have hb := Placement5.H_bound (2 * j + 1) (by omega)
          exact hsig _ ⟨by omega, by unfold Placement5.omitted; omega⟩
      · have hr := r.isLt
        have hlo : History5.historyId (5 * j) r < 1542 ∧ History5.historyId (5 * j) r ≠ 769 ∧
            History5.historyId (5 * j) r ≠ 511 ∧ History5.historyId (5 * j) r ≠ 1539 := by
          unfold History5.historyId; split <;> omega
        exact hpi_mem _ (Or.inl hlo) hole
  exact hsub

private theorem compiledBasePacket_wires {n : Nat} (divide : Bool) (j : Nat) (hj : j < 102) (s : Nat) :
    ChallengeMigration.straightWires (compiledBasePacket (n := n) divide j s).prog ⊆ (readNo2400 (5 * j)).toList := by
  have hcw := cellWires_sub_readNo2400 (5 * j)
  have h2410 := base2410_mem_readNo2400 (5 * j)
  have hl : ∀ l ∈ Replay5.letters j, l.1.1 ∈ (readNo2400 (5 * j)).toList ∧ l.1.2 ∈ (readNo2400 (5 * j)).toList := by
    intro l hl
    have hc := Replay5.letters_controls j hj l hl
    have hnd := SW.selLetters_nodup j hj l hl
    have h1 : l.1.1 ≠ base 2400 := (nodup3_ab hnd.1).symm
    have h2 : l.1.2 ≠ base 2400 := (nodup3_ab hnd.2).symm
    rw [Finset.mem_toList, Finset.mem_toList, readNo2400, Finset.mem_erase, Finset.mem_erase]
    exact ⟨⟨h1, Finset.mem_union_right _ hc.1⟩, ⟨h2, Finset.mem_union_right _ hc.2⟩⟩
  rw [compiledBasePacket]
  exact CatFn.seq_wires _ _
    (CatFn.seq_wires _ _
      (CatFn.compileProg_wires _ _ _ (history_codec_sub_readNo2400 (5 * j) (by omega) _ (Or.inr rfl))
        (hcw (cell_mem_cellWires 1541 (Or.inl rfl))) (hcw (cell_mem_cellWires 1026 (Or.inr (Or.inl rfl)))))
      (compiledRawReplay_wires divide _ hcw h2410 hl))
    (CatFn.compileProg_wires _ _ _ (history_codec_sub_readNo2400 (5 * j) (by omega) _ (Or.inl rfl))
      (hcw (cell_mem_cellWires 1541 (Or.inl rfl))) (hcw (cell_mem_cellWires 1026 (Or.inr (Or.inl rfl))))) s

private theorem compiledBaseFirstPacket_wires {n : Nat} (divide : Bool) (s : Nat) :
    ChallengeMigration.straightWires (compiledBaseFirstPacket (n := n) divide s).prog ⊆ (readNo2400 0).toList := by
  have hcw := cellWires_sub_readNo2400 0
  have h2410 := base2410_mem_readNo2400 0
  have hmem_k (k : Nat) (hk : k < 5) : base k ∈ (readNo2400 0).toList ∧ base (1028 + k) ∈ (readNo2400 0).toList := by
    have hc := Replay5.history_controls 0 k hk
    simp only [Nat.zero_add] at hc
    rw [Finset.mem_toList, Finset.mem_toList, readNo2400, Finset.mem_erase, Finset.mem_erase]
    exact ⟨⟨base_ne k 2400 (by omega), Finset.mem_union_right _ hc.1⟩,
      ⟨base_ne (1028 + k) 2400 (by omega), Finset.mem_union_right _ hc.2⟩⟩
  have h1028 : base 1028 ∈ (readNo2400 0).toList := (hmem_k 0 (by omega)).2
  have hbody (s' : Nat) : ChallengeMigration.straightWires (compiledFirstBody (n := n) divide s').prog ⊆ (readNo2400 0).toList := by
    rw [compiledFirstBody]; cases divide
    · have hl : ∀ l ∈ Replay5.restLetters, l.1.1 ∈ (readNo2400 0).toList ∧ l.1.2 ∈ (readNo2400 0).toList := by
        intro l hl; obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hl
        have hb := List.mem_range'_1.mp hk
        have ht := mixedTape_base_getD k (by omega)
        simpa only [tapeLetter, ht] using hmem_k k (by omega)
      refine CatFn.seq_wires _ _ (compiledRawReplay_wires false _ hcw h2410 hl) (fun s'' => ?_) s'
      rw [compiledFirstSwapM]
      refine compiledSelW_wires _ _ _ h1028 h2410 (CatFn.noT_wires _ ?_) s''
      rw [swapBodyM_def, UncompSwap.mswap_wires, ← swapBody_def]
      intro q hq
      have hm := cell_swapBody_wires hq
      rw [List.mem_toFinset, Finset.mem_toList]; simp only [List.mem_toFinset, List.mem_cons, List.mem_append] at hm
      rcases hm with rfl | hr | hy
      · exact Finset.mem_toList.mp h2410
      · exact Finset.mem_toList.mp (hcw ((OneBankCell5.mem_ports_wires base (base 2409) q).mp (by
          simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
            BalancedCleanup.Layout.low, List.mem_append, List.mem_cons] at hr ⊢; tauto)))
      · exact Finset.mem_toList.mp (hcw ((OneBankCell5.mem_ports_wires base (base 2409) q).mp (by
          simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.y,
            List.mem_append, List.mem_cons] at hy ⊢; tauto)))
    · have ht1 : (tapeLetter 1).1.1 = base 1 ∧ (tapeLetter 1).1.2 = base 1029 := by
        have t1 := mixedTape_base_getD 1 (by decide)
        rw [tapeLetter, t1]; exact ⟨rfl, rfl⟩
      have htl : ∀ l ∈ OneBankReplay5.firstTailLetters, l.1.1 ∈ (readNo2400 0).toList ∧ l.1.2 ∈ (readNo2400 0).toList := by
        intro l hl; obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hl
        have hb := List.mem_range'_1.mp hk
        have ht := mixedTape_base_getD k (by omega)
        simpa only [tapeLetter, ht] using hmem_k k (by omega)
      refine CatFn.seq_wires _ _ (fun s'' => by
          rw [compiledFirstSwap]
          exact compiledSelW_wires _ _ _ h1028 h2410
            (fun s3 => (compiledSwapBody_wires s3).trans (List.cons_subset.mpr ⟨h2410, hcw⟩)) s'')
        (CatFn.seq_wires _ _
          (compiledZCell_wires _ _ hcw h2410 (ht1.1 ▸ (hmem_k 1 (by omega)).1) (ht1.2 ▸ (hmem_k 1 (by omega)).2))
          (compiledRawReplay_wires true _ hcw h2410 htl)) s'
  rw [compiledBaseFirstPacket]
  exact CatFn.seq_wires _ _
    (CatFn.seq_wires _ _
      (CatFn.compileProg_wires _ _ _ (history_codec_sub_readNo2400 0 (by omega) _ (Or.inr rfl))
        (hcw (cell_mem_cellWires 1541 (Or.inl rfl))) (hcw (cell_mem_cellWires 1026 (Or.inr (Or.inl rfl)))))
      hbody)
    (CatFn.compileProg_wires _ _ _ (history_codec_sub_readNo2400 0 (by omega) _ (Or.inl rfl))
      (hcw (cell_mem_cellWires 1541 (Or.inl rfl))) (hcw (cell_mem_cellWires 1026 (Or.inr (Or.inl rfl))))) s

theorem compiledReplayS_wires {n : Nat} (divide : Bool) (s : Nat) :
    ChallengeMigration.straightWires (compiledReplayS (n := n) divide s).prog ⊆ segNo2400.toList := by
  have hpkt_pre (j : Nat) (hj : j < 102) (s' : Nat) :
      ∀ w ∈ ChallengeMigration.straightWires (compiledPacket (n := n) divide j s').prog,
        OB5.sig 511 w ∈ segNo2400.toList := by
    intro w hw
    rw [compiledPacket, catFn_map_wires_eq] at hw
    obtain ⟨u, hu, rfl⟩ := List.mem_map.mp hw
    exact readNo2400_placed_segNo2400 j hj u (compiledBasePacket_wires divide j hj s' hu)
  have hgrp_pre (j m : Nat) (hb : j + m ≤ 102) (s' : Nat) :
      ∀ w ∈ ChallengeMigration.straightWires (compiledGroups (n := n) divide j m s').prog,
        OB5.sig 511 w ∈ segNo2400.toList := by
    induction m generalizing j s' with
    | zero =>
      intro w hw; exact absurd (CatFn.noT_wires (S := List.nil) List.nil (by simp [ECDSAAdd.wires]) s' hw) (by simp)
    | succ m ih =>
      cases divide
      · intro w hw
        change w ∈ ChallengeMigration.straightWires (CatFn.seq (compiledGroups false (j + 1) m) (compiledPacket false j) s').prog at hw
        rw [catFn_seq_wires_eq, List.mem_append] at hw
        rcases hw with h | h
        · exact ih (j + 1) (by omega) s' w h
        · exact hpkt_pre j (by omega) _ w h
      · intro w hw
        change w ∈ ChallengeMigration.straightWires (CatFn.seq (compiledPacket true j) (compiledGroups true (j + 1) m) s').prog at hw
        rw [catFn_seq_wires_eq, List.mem_append] at hw
        rcases hw with h | h
        · exact hpkt_pre j (by omega) s' w h
        · exact ih (j + 1) (by omega) _ w h
  have hfirst_pre (s' : Nat) :
      ∀ w ∈ ChallengeMigration.straightWires (compiledFirstPacket (n := n) divide s').prog,
        OB5.sig 511 w ∈ segNo2400.toList := by
    intro w hw
    rw [compiledFirstPacket, catFn_map_wires_eq] at hw
    obtain ⟨u, hu, rfl⟩ := List.mem_map.mp hw
    exact readNo2400_placed_segNo2400 0 (by omega) u (compiledBaseFirstPacket_wires divide s' hu)
  have hend_pre (s' : Nat) :
      ∀ w ∈ ChallengeMigration.straightWires (compiledEndPacket (n := n) divide s').prog,
        OB5.sig 511 w ∈ segNo2400.toList := by
    intro w hw
    rw [compiledEndPacket, catFn_map_wires_eq] at hw
    obtain ⟨u, hu, rfl⟩ := List.mem_map.mp hw
    have hu' : u ∈ base 510 :: cellWires := by
      rw [compiledRawEnd] at hu
      exact compiledSelW_wires (base 510) (base 2409) _ List.mem_cons_self
        (List.mem_cons_of_mem _ (cell_mem_cellWires 2409 (Or.inr (Or.inr rfl))))
        (fun s'' => (compiledHalfE_wires divide s'').trans (List.subset_cons_of_subset _ (List.Subset.refl _))) s' hu
    rw [Finset.mem_toList, segNo2400, Finset.mem_erase]
    have hpi0_mem (i : Nat) (hi : (i < 1542 ∧ i ≠ 769 ∧ i ≠ 511 ∧ i ≠ 1539) ∨ i = 1797 ∨ (2056 ≤ i ∧ i ≤ 2312) ∨ i = 2409)
        (hhole : ¬Placement5.holeRegion i) :
        OB5.sig 511 (shifted Placement5.pi0 (base i)) ≠ base 2400 ∧
        OB5.sig 511 (shifted Placement5.pi0 (base i)) ∈ OB5Support.segSites := by
      have hne : OB5.sig 511 (shifted Placement5.pi0 (base i)) ≠ base 2400 := by
        intro e
        have hfix : OB5.sig 511 (shifted Placement5.pi0 (base 2400)) = base 2400 := by
          rw [SW.selShift0_fix, SW.selSig_2400]
        have := MappedCompressed.base_injective ((shifted Placement5.pi0).injective (OB5.sig_injective 511 (by decide) (e.trans hfix.symm)))
        omega
      refine ⟨hne, ?_⟩
      rw [shifted_base]
      have hsafe := Placement5.nonhole_pi0_safe i hhole
      have hfr : (Placement5.pi0 i < 1542 ∧ Placement5.pi0 i ≠ 769 ∧ Placement5.pi0 i ≠ 511 ∧ Placement5.pi0 i ≠ 1539) ∨
          Placement5.pi0 i = 1797 ∨ (2056 ≤ Placement5.pi0 i ∧ Placement5.pi0 i ≤ 2312) ∨ Placement5.pi0 i = 2409 := by
        have hout (c : Nat) (hc : ¬Placement5.zeroRegion c) (k : Nat) (hk : k ≠ c) : Placement5.pi0 k ≠ c := fun eq =>
          hk (Placement5.pi0.injective (eq.trans (Placement5.pi0_outside c hc).symm))
        rcases hi with h | h | h | h
        · refine Or.inl ⟨?_, hout 769 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.1,
            hout 511 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.1,
            hout 1539 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.2⟩
          by_contra hn
          have ho : ¬Placement5.zeroRegion (Placement5.pi0 i) := by
            unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega
          have := Placement5.pi0.injective (Placement5.pi0_outside _ ho); omega
        all_goals
          have ho : ¬Placement5.zeroRegion i := by
            unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega
          rw [Placement5.pi0_outside i ho]; omega
      rw [OB5.sig_base 511 _ (by decide)]
      apply List.mem_toFinset.mpr; apply List.mem_map.mpr; refine ⟨_, ?_, rfl⟩
      simp only [OB5Support.segIndices, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil, or_false]
      unfold Placement5.omitted at hsafe; split_ifs <;> omega
    rcases List.mem_cons.mp hu' with rfl | hu'
    · exact hpi0_mem 510 (by omega) (by unfold Placement5.holeRegion; omega)
    · rcases List.mem_cons.mp hu' with rfl | hu'
      · exact hpi0_mem 2409 (by omega) (by unfold Placement5.holeRegion; omega)
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hu'
        simp only [OneBankCell5.ids, List.mem_append, List.mem_cons, List.not_mem_nil, List.mem_range'_1, or_false] at hi
        exact hpi0_mem i (by omega) (by unfold Placement5.holeRegion; omega)
  rw [compiledReplayS, catFn_map_wires_eq]
  intro w hw
  obtain ⟨u, hu, rfl⟩ := List.mem_map.mp hw
  rw [compiledLogicalReplayS] at hu
  cases divide
  · change u ∈ ChallengeMigration.straightWires
      (CatFn.seq (CatFn.seq (compiledEndPacket false) (compiledGroups false 1 101)) (compiledFirstPacket false) s).prog at hu
    rw [catFn_seq_wires_eq, catFn_seq_wires_eq, List.mem_append, List.mem_append] at hu
    rcases hu with (h | h) | h
    · exact hend_pre s u h
    · exact hgrp_pre 1 101 (by decide) _ u h
    · exact hfirst_pre _ u h
  · change u ∈ ChallengeMigration.straightWires
      (CatFn.seq (CatFn.seq (compiledFirstPacket true) (compiledGroups true 1 101)) (compiledEndPacket true) s).prog at hu
    rw [catFn_seq_wires_eq, catFn_seq_wires_eq, List.mem_append, List.mem_append] at hu
    rcases hu with (h | h) | h
    · exact hfirst_pre s u h
    · exact hgrp_pre 1 101 (by decide) _ u h
    · exact hend_pre _ u h

-- WellFormed for replay hierarchy
private theorem compiledRawReplay_wellFormed {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter)
    (hl : ∀ l ∈ ls, l.1.1 ≠ base 2409 ∧ l.1.2 ≠ base 2410) (s : Nat) :
    (compiledRawReplay (n := n) divide ls s).prog.WellFormed := by
  induction ls generalizing s with
  | nil => exact CatFn.noT_wellFormed List.nil (fun _ h => by simp at h) s
  | cons l ls ih =>
    have h0 := hl l (by simp)
    have hrest : ∀ x ∈ ls, x.1.1 ≠ base 2409 ∧ x.1.2 ≠ base 2410 := fun x hx => hl x (List.mem_cons_of_mem _ hx)
    cases divide
    · exact CatFn.seq_wellFormed _ _ (fun s' => ih hrest s') (compiledCell_wellFormed false l.1.1 l.1.2 h0.1 h0.2) s
    · exact CatFn.seq_wellFormed _ _ (compiledCell_wellFormed true l.1.1 l.1.2 h0.1 h0.2) (fun s' => ih hrest s') s

theorem compiledPacket_wellFormed {n : Nat} (divide : Bool) (j : Nat) (hj : j < 102) (s : Nat) :
    (compiledPacket (n := n) divide j s).prog.WellFormed := by
  have hdec_av := history_codec_avoid_ry_work (5 * j) (by omega) _ (Or.inr rfl)
  have henc_av := history_codec_avoid_ry_work (5 * j) (by omega) _ (Or.inl rfl)
  have hpool := skywalkShared_integer_nodup base MappedCompressed.LaneA.laneLogical_config.1
  have hl : ∀ l ∈ Replay5.letters j, l.1.1 ≠ base 2409 ∧ l.1.2 ≠ base 2410 := fun l hl => by
    have hnd := SW.selLetters_nodup j hj l hl
    exact ⟨nodup3_bc hnd.1, nodup3_bc hnd.2⟩
  rw [compiledPacket]
  refine CatFn.map_wellFormed _ _ (fun s' => ?_) (fun _ _ _ _ _ e => (shifted (Placement5.pi j)).injective e) s
  rw [compiledBasePacket]
  exact CatFn.seq_wellFormed _ _
    (CatFn.seq_wellFormed _ _
      (CatFn.compileProg_wellFormed _ _ _ hdec_av.2.2.2.1 hdec_av.2.2.2.2 (base_ne 1541 1026 (by omega))
        (History5.decode_physical base hpool (5 * j) (by omega)))
      (compiledRawReplay_wellFormed divide _ hl))
    (CatFn.compileProg_wellFormed _ _ _ henc_av.2.2.2.1 henc_av.2.2.2.2 (base_ne 1541 1026 (by omega))
      (History5.encode_physical base hpool (5 * j) (by omega))) s'

theorem compiledGroups_wellFormed {n : Nat} (divide : Bool) (j m : Nat) (hb : j + m ≤ 102) (s : Nat) :
    (compiledGroups (n := n) divide j m s).prog.WellFormed := by
  induction m generalizing j s with
  | zero => exact CatFn.noT_wellFormed List.nil (fun _ h => by simp at h) s
  | succ m ih =>
    cases divide
    · exact CatFn.seq_wellFormed _ _ (fun s' => ih (j + 1) (by omega) s') (compiledPacket_wellFormed false j (by omega)) s
    · exact CatFn.seq_wellFormed _ _ (compiledPacket_wellFormed true j (by omega)) (fun s' => ih (j + 1) (by omega) s') s

theorem compiledFirstPacket_wellFormed {n : Nat} (divide : Bool) (s : Nat) :
    (compiledFirstPacket (n := n) divide s).prog.WellFormed := by
  have hdec_av := history_codec_avoid_ry_work 0 (by omega) _ (Or.inr rfl)
  have henc_av := history_codec_avoid_ry_work 0 (by omega) _ (Or.inl rfl)
  have hpool := skywalkShared_integer_nodup base MappedCompressed.LaneA.laneLogical_config.1
  have hbody (s' : Nat) : (compiledFirstBody (n := n) divide s').prog.WellFormed := by
    rw [compiledFirstBody]; cases divide
    · have hl : ∀ l ∈ Replay5.restLetters, l.1.1 ≠ base 2409 ∧ l.1.2 ≠ base 2410 := fun l hl => by
        have hnd := SW.selRest_nodup l hl
        exact ⟨nodup3_bc hnd.1, nodup3_bc hnd.2⟩
      refine CatFn.seq_wellFormed _ _ (compiledRawReplay_wellFormed false _ hl) (fun s'' => ?_) s'
      rw [compiledFirstSwapM]
      exact compiledSelW_wellFormed _ _ _ (base_ne 1028 2410 (by omega))
        (CatFn.noT_wellFormed _ (swapBodyM_def.symm ▸ UncompSwap.mswap_physical _ _ _ cell_swap_nodup)) s''
    · have h1 := SW.selRest_nodup _ OneBankReplay5.letter1_mem
      have htl : ∀ l ∈ OneBankReplay5.firstTailLetters, l.1.1 ≠ base 2409 ∧ l.1.2 ≠ base 2410 := fun l hl => by
        have hnd := SW.selRest_nodup l (OneBankReplay5.tail_mem_rest l hl)
        exact ⟨nodup3_bc hnd.1, nodup3_bc hnd.2⟩
      exact CatFn.seq_wellFormed _ _
        (fun s'' => by rw [compiledFirstSwap]; exact compiledSelW_wellFormed _ _ _ (base_ne 1028 2410 (by omega)) compiledSwapBody_wellFormed s'')
        (CatFn.seq_wellFormed _ _
          (compiledZCell_wellFormed _ _ (nodup3_bc h1.1) (nodup3_bc h1.2))
          (compiledRawReplay_wellFormed true _ htl)) s'
  rw [compiledFirstPacket]
  refine CatFn.map_wellFormed _ _ (fun s' => ?_) (fun _ _ _ _ _ e => (shifted (Placement5.pi 0)).injective e) s
  rw [compiledBaseFirstPacket]
  exact CatFn.seq_wellFormed _ _
    (CatFn.seq_wellFormed _ _
      (CatFn.compileProg_wellFormed _ _ _ hdec_av.2.2.2.1 hdec_av.2.2.2.2 (base_ne 1541 1026 (by omega))
        (History5.decode_physical base hpool 0 (by omega))) hbody)
    (CatFn.compileProg_wellFormed _ _ _ henc_av.2.2.2.1 henc_av.2.2.2.2 (base_ne 1541 1026 (by omega))
      (History5.encode_physical base hpool 0 (by omega))) s'

theorem compiledEndPacket_wellFormed {n : Nat} (divide : Bool) (s : Nat) :
    (compiledEndPacket (n := n) divide s).prog.WellFormed := by
  rw [compiledEndPacket]
  refine CatFn.map_wellFormed _ _ (fun s' => ?_) (fun _ _ _ _ _ e => (shifted Placement5.pi0).injective e) s
  rw [compiledRawEnd]
  exact compiledSelW_wellFormed _ _ _ (base_ne 510 2409 (by omega)) (compiledHalfE_wellFormed divide) s'

theorem compiledReplayS_wellFormed {n : Nat} (divide : Bool) (s : Nat) :
    (compiledReplayS (n := n) divide s).prog.WellFormed := by
  rw [compiledReplayS]
  refine CatFn.map_wellFormed _ _ (fun s' => ?_) (fun _ _ _ _ _ e => OB5.sig_injective 511 (by decide) e) s
  rw [compiledLogicalReplayS]; cases divide
  · exact CatFn.seq_wellFormed _ _ (CatFn.seq_wellFormed _ _ (compiledEndPacket_wellFormed false)
      (compiledGroups_wellFormed false 1 101 (by decide))) (compiledFirstPacket_wellFormed false) s'
  · exact CatFn.seq_wellFormed _ _ (CatFn.seq_wellFormed _ _ (compiledFirstPacket_wellFormed true)
      (compiledGroups_wellFormed true 1 101 (by decide))) (compiledEndPacket_wellFormed true) s'

-- CatLitSim (base 1026) for rawReplay, basePacket, packet, firstPacket, endPacket
private theorem cell_rawReplayS_pres_valid (divide : Bool) (ls : List MixedTranscriptLetter)
    (st : ECDSAAdd.State) (m : List Bool) (h : CellValid st.basis) :
    CellValid (ECDSAAdd.run (SW.rawReplayS divide ls) m st).basis := by
  induction ls generalizing st m with
  | nil => simpa [SW.rawReplayS, ECDSAAdd.run] using h
  | cons l ls ih =>
    cases divide
    · simp only [SW.rawReplayS, Bool.false_eq_true, if_false, ECDSAAdd.run_append]
      exact cell_cellS_pres_valid false l.1.1 l.1.2 _ _ (ih st _ h)
    · simp only [SW.rawReplayS, if_true, ECDSAAdd.run_append]
      exact ih _ _ (cell_cellS_pres_valid true l.1.1 l.1.2 st _ h)

theorem compiledRawReplay_catLitSim {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter)
    (hl : ∀ l ∈ ls, base 1026 ≠ l.1.1 ∧ base 1026 ≠ l.1.2)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledRawReplay (n := n) divide ls s).prog.instantiate read h)
      (SW.rawReplayS divide ls) CellValid := by
  induction ls generalizing s read h with
  | nil =>
    rw [compiledRawReplay, SW.rawReplayS]
    exact catLitSim_weaken (CatFn.noT_catLitSim (base 1026) List.nil (by simp [ECDSAAdd.wires]) s read h)
      (fun _ _ => trivial)
  | cons l ls ih =>
    have h0 := hl l (by simp)
    have hrest : ∀ x ∈ ls, base 1026 ≠ x.1.1 ∧ base 1026 ≠ x.1.2 := fun x hx => hl x (List.mem_cons_of_mem _ hx)
    cases divide
    · rw [compiledRawReplay, SW.rawReplayS]; simp only [Bool.false_eq_true, if_false]
      exact CatFn.seq_catLitSim _ _ (compiledCell_indep false l.1.1 l.1.2)
        (SW.rawReplayS false ls) (SW.cellS false l.1.1 l.1.2) CellValid CellValid
        (fun s' r' h' => ih hrest s' r' h') (compiledCell_catLitSim false l.1.1 l.1.2 h0.1 h0.2)
        (fun st m hv _ => cell_rawReplayS_pres_valid false ls st m hv) s read h
    · rw [compiledRawReplay, SW.rawReplayS]; simp only [if_true]
      exact CatFn.seq_catLitSim _ _ (compiledRawReplay_indep true ls)
        (SW.cellS true l.1.1 l.1.2) (SW.rawReplayS true ls) CellValid CellValid
        (compiledCell_catLitSim true l.1.1 l.1.2 h0.1 h0.2) (fun s' r' h' => ih hrest s' r' h')
        (fun st m hv _ => cell_cellS_pres_valid true l.1.1 l.1.2 st m hv) s read h

private theorem letters_ne_1026 (i : Nat) (hi : i < 510) :
    base 1026 ≠ (tapeLetter i).1.1 ∧ base 1026 ≠ (tapeLetter i).1.2 := by
