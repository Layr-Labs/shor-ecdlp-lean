private theorem cell_mem_cellWires (k : Nat) (hk : k = 1541 ∨ k = 1026 ∨ k = 2409) :
    base k ∈ cellWires := by
  rcases hk with rfl | rfl | rfl
  · exact (OneBankCell5.mem_ports_wires base (base 2409) (base 1541)).mp (by
      have h1 : base 1541 ∈ cellLayout.carry := base_1541_mem_carry
      simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, List.mem_append, List.mem_cons]
      tauto)
  · exact (OneBankCell5.mem_ports_wires base (base 2409) (base 1026)).mp (by
      have h1 : base 1026 ∈ cellLayout.carry := base_1026_mem_carry
      simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, List.mem_append, List.mem_cons]
      tauto)
  · exact List.mem_cons_self

private theorem cellWires_sub_readSites (start : Nat) : ∀ w ∈ cellWires, w ∈ OneBankReplay5.readSites start := by
  intro w hw
  exact Finset.mem_union_left _ (Finset.mem_union_left _ (List.mem_toFinset.mpr hw))

theorem compiledSwapBody_wires {n : Nat} (s : Nat) :
    ChallengeMigration.straightWires (compiledSwapBody (n := n) s).prog ⊆ base 2410 :: cellWires := by
  rw [compiledSwapBody]
  refine CatFn.compileProg_wires _ _ _ ?_ (List.mem_cons_of_mem _ (cell_mem_cellWires 1541 (Or.inl rfl)))
    (List.mem_cons_of_mem _ (cell_mem_cellWires 1026 (Or.inr (Or.inl rfl)))) s
  intro q hq
  have hm := cell_swapBody_wires hq
  simp only [List.mem_toFinset, List.mem_cons, List.mem_append] at hm ⊢
  rcases hm with rfl | hr | hy
  · exact Or.inl rfl
  · refine Or.inr ((OneBankCell5.mem_ports_wires base (base 2409) q).mp ?_)
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.mem_append, List.mem_cons] at hr ⊢; tauto
  · refine Or.inr ((OneBankCell5.mem_ports_wires base (base 2409) q).mp ?_)
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.y,
      List.mem_append, List.mem_cons] at hy ⊢; tauto

