      ((4 * (g3 + 18 * a3) + 6) + ((4 * (g4 + 18 * a4) + 6) + (4 * (g5 + 18 * a5) +
      (1000001000 + (4 * (g7 + 18 * a7) + 4 * (g8 + 18 * a8)))))))))
    (hs0 : g0 ≤ sp0 + sl0) (hs2 : g2 ≤ sp2 + sl2) (hs3 : g3 ≤ sp3 + sl3) (hs4 : g4 ≤ sp4 + sl4)
    (hs5 : g5 ≤ sp5 + sl5) (hs7 : g7 ≤ sp7 + sl7) (hs8 : g8 ≤ sp8 + sl8)
    (ha0 : a0 = tp0) (ha2 : a2 = tp2) (ha3 : a3 = tp3) (ha4 : a4 = tp4)
    (ha5 : a5 = tp5) (ha7 : a7 = tp7) (ha8 : a8 = tp8)
    (hsp : sp0 + (sp1 + (sp2 + (sp3 + (sp4 + (sp5 + (sp6 + (sp7 + sp8))))))) ≤ 2139852392)
    (hsl : sl0 + (sl1 + (sl2 + (sl3 + (sl4 + (sl5 + (sl6 + (sl7 + sl8))))))) ≤ 335556282)
    (htp : tp0 + (tp1 + (tp2 + (tp3 + (tp4 + (tp5 + (tp6 + (tp7 + tp8))))))) ≤ 2342691) :
    g ≤ 13000000000 := by
  rw [ha0, ha2, ha3, ha4, ha5, ha7, ha8] at hg
  have hsub9 (x0 x1 x2 x3 x4 x5 x6 x7 x8 B : Nat)
      (h : x0 + (x1 + (x2 + (x3 + (x4 + (x5 + (x6 + (x7 + x8))))))) ≤ B) :
      x0 + x2 + x3 + x4 + x5 + x7 + x8 ≤ B :=
    ((Nat.le_add_right _ (x1 + x6)).trans_eq (by ring)).trans h
  have hsp' := hsub9 _ _ _ _ _ _ _ _ _ _ hsp
  have hsl' := hsub9 _ _ _ _ _ _ _ _ _ _ hsl
  have htp' := hsub9 _ _ _ _ _ _ _ _ _ _ htp
  have hG1 : g0 + g2 + g3 + g4 + g5 + g7 + g8 ≤
      (sp0 + sl0) + (sp2 + sl2) + (sp3 + sl3) + (sp4 + sl4) + (sp5 + sl5) + (sp7 + sl7) + (sp8 + sl8) :=
    Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add hs0 hs2) hs3) hs4) hs5) hs7) hs8
