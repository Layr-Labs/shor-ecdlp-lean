        (fun b c => ∃ mB : List Bool, ∃ mk : List Bool, mB.length = mTail ∧ mk.length = mK ∧
          ∀ a (sMid : ECDSAAdd.State),
            let sL2 : ECDSAAdd.State := ⟨sMid.phase, tableXorState (portMask read pp16 a) true sMid.basis⟩
