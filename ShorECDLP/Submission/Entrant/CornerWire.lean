    intro q hq
    simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_singleton,
      Finset.notMem_empty, or_false] at hq
    subst hq; exact List.mem_toFinset.mpr (cell_base_no4_mem 2409 (Or.inl rfl))
  have hfp (s' : Nat) : ChallengeMigration.straightWires (compiledForwardPrefix (n := n) s').prog ⊆ cellWiresNo4 := by
    rw [compiledForwardPrefix]
    exact CatFn.seq_wires _ _ (CatFn.seq_wires _ _ (CatFn.noT_wires _ hf.1) compiledRawAdd_wires_no4)
      (CatFn.compileProg_wires _ _ _ hf.2.1 m1541 m1026) s'
  have hcl (isE : Bool) (s' : Nat) : ChallengeMigration.straightWires (compiledCleanup (n := n) isE s').prog ⊆ cellWiresNo4 := by
    have htail : ECDSAAdd.wires ((BalancedCleanup.prepareCompare cellLayout.toLayout).reverse ++
        ((if isE then TopReuse.unnormalizeE cellLayout.toLayout else BalancedCleanup.unnormalize cellLayout.toLayout) ++
          (BalancedCleanup.prepareSign cellLayout.toLayout).reverse)) ⊆ cellWiresNo4.toFinset := by
      simp only [ECDSAAdd.wires_append, ECDSAAdd.wires_reverse, Finset.union_subset_iff]
      refine ⟨hf.2.2.1, ?_, hf.2.2.2.2.1⟩
      cases isE
      · exact hf.2.2.2.1
      · exact hf.2.2.2.2.2.1
    rw [compiledCleanup]
    exact CatFn.seq_wires _ _ (CatFn.seq_wires _ _ (CatFn.noT_wires _ hf.2.2.1) (cell_cmp_wires_no4 true))
      (CatFn.compileProg_wires _ _ _ htail m1541 m1026) s'
  have hinv (s' : Nat) : ChallengeMigration.straightWires (compiledInverse (n := n) s').prog ⊆ cellWiresNo4 := by
    have h1 : ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout ++
        BalancedCleanup.normalize cellLayout.toLayout ++ BalancedCleanup.prepareCompare cellLayout.toLayout) ⊆ cellWiresNo4.toFinset := by
      simp only [ECDSAAdd.wires_append, Finset.union_subset_iff]
      exact ⟨⟨hf.2.2.2.2.1, hi.1⟩, hf.2.2.1⟩
    have h3 : ECDSAAdd.wires ((BalancedCleanup.prepareCompare cellLayout.toLayout).reverse ++
        BiasedInverse.unbiasView cellLayout ++ OneReuse.restoreRaw cellLayout) ⊆ cellWiresNo4.toFinset := by
      simp only [ECDSAAdd.wires_append, ECDSAAdd.wires_reverse, Finset.union_subset_iff]
      exact ⟨⟨hf.2.2.1, hi.2.1⟩, hi.2.2⟩
    have h5 : ECDSAAdd.wires (GuardCompression.seed cellLayout).reverse ⊆ cellWiresNo4.toFinset := by
      rw [ECDSAAdd.wires_reverse]; exact hf.1
    rw [compiledInverse]
    exact CatFn.seq_wires _ _
      (CatFn.seq_wires _ _
        (CatFn.seq_wires _ _
          (CatFn.seq_wires _ _ (CatFn.compileProg_wires _ _ _ h1 m1541 m1026) (cell_cmp_wires_no4 false))
          (CatFn.compileProg_wires _ _ _ h3 m1541 m1026))
        compiledRawSub_wires_no4)
      (CatFn.noT_wires _ h5) s'
  rw [compiledHalf]
  refine CatFn.seq_wires _ _ (CatFn.seq_wires _ _ (CatFn.noT_wires _ hx) (fun s' => ?_)) (CatFn.noT_wires _ hx) s
  cases divide
  · exact hinv s'
  · rw [compiledForward]; exact CatFn.seq_wires _ _ hfp (hcl false) s'

