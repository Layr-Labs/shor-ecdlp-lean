    catLitSim_weaken (CatFn.noT_catLitSim y ([.CX source flag]) hy1 s' r' h') (fun _ _ => trivial)
  have h12 := CatFn.seq_catLitSim _ _ hbi ([.CX source flag]) P V₁ V₂ h1 hb (fun st m hv _ => hstep st m hv)
