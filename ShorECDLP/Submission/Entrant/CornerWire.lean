  have hs2 : ECDSAAdd.Challenge.gateSlots [.measureX flag List.nil ([.Z source])] = 2 := rfl
  rw [hs1, hs2] at h1; omega

theorem compiledSelW_wires {n : Nat} (source flag : Wire) (body : CatFn n) {S : List Wire}
    (hs : source ∈ S) (hf : flag ∈ S)
    (hb : ∀ s, ChallengeMigration.straightWires (body s).prog ⊆ S) (s : Nat) :
    ChallengeMigration.straightWires (compiledSelW source flag body s).prog ⊆ S := by
