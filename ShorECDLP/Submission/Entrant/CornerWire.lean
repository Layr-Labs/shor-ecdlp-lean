    have h2 := b_nProgram_slots
    have h3 : AndGadget.added (WideSigned.Body.nProgram .w16 0) ≤ 252 := by
      have ha : AndGadget.added (WideSigned.Body.nProgram .w16 0) = WideSigned.Body.signCredit := by
        rw [WideSigned.Body.nProgram, AndGadget.added_reindex]; exact (WEX.nFastProgram_credit 0).2.trans b_signCredit_eq.symm
      rw [ha]; exact b_signCredit_le
    omega
