private theorem run_ref_append_step {read : ConstantBit 65536 → Bool} {addr : Nat}
    {a b : Code2 65536} (P : ECDSAAdd.State → Prop) {Q : ECDSAAdd.State → Prop} {m : List Bool} {st : ECDSAAdd.State}
    (h1 : ∀ m', P (ECDSAAdd.run (reference2 read addr a) m' st))
    (h2 : ∀ st' m', P st' → Q (ECDSAAdd.run (reference2 read addr b) m' st')) :
    Q (ECDSAAdd.run (reference2 read addr (a ++ b)) m st) := by
  rw [reference2_append, ECDSAAdd.run_append]
  exact h2 _ _ (h1 _)

theorem validK_after_midW_14114 (coeffs : Fin 65536 → PointCoeff) (Q : Secp256k1.Point)
    (hQ : ShorECDLP.order • Q = 0) (hn : ∀ i, constantPoint Q (coeffs i) ≠ 0)
    (addr : Nat) (st2 : ECDSAAdd.State) (hval : ValidK coeffs Q addr st2) (m : List Bool) :
    (ECDSAAdd.run (reference2 (readConstant coeffs Q) addr (WideBank8.Fast16.fforget CornerWire.Wide16.midW)) m st2).basis 14114 = true := by
  let read := readConstant coeffs Q
  obtain ⟨d, hv0, _, _, _, h14, _⟩ := validK_to_midStage0 coeffs Q hQ hn addr st2 hval
  change (ECDSAAdd.run (reference2 read addr (WideBank8.Fast16.fforget CornerWire.Wide16.midW)) m st2).basis 14114 = true
  rw [midW_eq_list, fforget_9]
  apply run_ref_append_step (fun st => PointDialogValues streamLayout d.X1 d.Y0 d.G d.base st.basis) (Q := fun st => st.basis 14114 = true)
  · intro m'; rw [midB0, fblock_step_ref_plain]
    exact (WEXUnlookup.guard5_step d.X0 d.X1 d.Y0 d.G d.base d.hex d.hfwd1 st2 m' hv0).2
  intro st1 m1 hv1
  apply run_ref_append_step (fun st => PointDialogValues streamLayout d.X1 d.Y1 d.G d.base st.basis) (Q := fun st => st.basis 14114 = true)
  · intro m'; rw [midB1, fblock_step_ref_plain]
    have h := (arith3F_step streamLayout streamLayout_widths streamLayout_nodup d.X1 d.Y0 d.G d.base false d.hX1 st1 m' hv1).2
    simpa only [Bool.false_eq_true, if_false, ← d.hY1] using h
  intro st2' m2 hv2
  apply run_ref_append_step (fun st => PointDialogValues streamLayout d.X0 d.Y1 d.G d.base st.basis) (Q := fun st => st.basis 14114 = true)
  · intro m'; rw [midB2, fblock_step_ref_plain]
    exact (WEXUnlookup.guard5_step d.X1 d.X0 d.Y1 d.G d.base d.hex d.hbck1 st2' m' hv2).2
  intro st3 m3 hv3
  apply run_ref_append_step (fun st => PointDialogValues streamLayout d.X2 d.Y1 d.G d.base st.basis) (Q := fun st => st.basis 14114 = true)
  · intro m'; rw [midB3, fblock_step_ref_plain]
    have h := (GenericOB5.square_step streamLayout streamLayout_widths streamLayout_nodup d.X0 d.Y1 d.G d.base st3 m' hv3).2
    simpa only [← d.hX2] using h
  intro st4 m4 hv4
  apply run_ref_append_step (fun st => PointDialogValues streamLayout d.X3 d.Y1 d.G d.base st.basis) (Q := fun st => st.basis 14114 = true)
  · intro m'; exact d.htriple st4 m' hv4
  intro st5 m5 hv5
  apply run_ref_append_step (fun st => PointDialogValues streamLayout d.X4 d.Y1 d.G d.base st.basis) (Q := fun st => st.basis 14114 = true)
  · intro m'; rw [midB5, fblock_step_ref_plain]
    exact (WEXUnlookup.guard5_step d.X3 d.X4 d.Y1 d.G d.base d.hex d.hfwd2 st5 m' hv5).2
  intro st6 m6 hv6
  apply run_ref_append_step (fun st => PointDialogValues streamLayout d.X4 d.Y2 d.G d.base st.basis) (Q := fun st => st.basis 14114 = true)
  · intro m'; rw [midB6, fblock_step_ref_plain]
    have h := (arith3F_step streamLayout streamLayout_widths streamLayout_nodup d.X4 d.Y1 d.G d.base true d.hX4 st6 m' hv6).2
    simpa only [if_true, ← d.hY2] using h
  intro st7 m7 hv7
  apply run_ref_append_step (fun st => PointDialogValues streamLayout d.X3 d.Y2 d.G d.base st.basis) (Q := fun st => st.basis 14114 = true)
  · intro m'; rw [midB7, fblock_step_ref_plain]
    exact (WEXUnlookup.guard5_step d.X4 d.X3 d.Y2 d.G d.base d.hex d.hbck2 st7 m' hv7).2
  intro st8 m8 hv8
  rw [midB8, fblock_step_ref_plain]
  have hv9 := (WEXUnlookup.negXReg_step d.X3 d.Y2 d.G d.base d.hG3 st8 m8 hv8).2
  exact (pointDialogValues_flag_eq hv9 14114 (by decide)).trans h14

end
