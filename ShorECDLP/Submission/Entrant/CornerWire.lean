        exact cell_not_carry 768 ⟨by omega, by omega, by omega, by omega⟩ (e ▸ hw)
      exact (cell_cmpConjugate_pres_nonParity sN m3 m4 m5 hb.1 hb.2.2 w hwp).trans (hb.2.2 w hw)
    have hub_lo : sU.basis (base 1797) = false := by
      simp only [sU, BiasedInverse.unbiasView, ECDSAAdd.run_append]
