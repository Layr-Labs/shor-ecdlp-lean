    rw [step78ContSrc, AdaptiveCircuit.run_seq]
    apply simulationAligned_seq a1 a2
    intro b₁ k₁ b₂ k₂ hb₁ hb₂
    obtain ⟨mk, hmk, hb₂⟩ := hb₂
    refine ⟨b₁.history, mk, by rw [hb₁.1, tailNorm_meas], hmk, ?_⟩
    intro a sL2 st2 ha hclOut hval
    set sB1 := ECDSAAdd.run tailPart b₁.history sL2 with hsB1
