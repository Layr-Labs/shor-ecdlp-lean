private theorem cell_restoreRaw_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (OneReuse.restoreRaw cellLayout) := by
  have h1 : base k ∉ ECDSAAdd.wires (OneReuse.unfoldWindow cellLayout) := by
    have hms : base k ∉ ECDSAAdd.wires (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) := by
      intro hm
      simp only [mappedSub, ECDSAAdd.wires_append, Finset.mem_union, notRegister_wires] at hm
      rcases hm with (h | h) | h
      · exact cell_not_low k (by omega) (List.mem_toFinset.mp h)
      · have hsub := mappedAdd_wires_subset _ _ _ _ h
        simp only [List.mem_toFinset, List.mem_append, List.mem_singleton, cellLayout_one] at hsub
        rcases hsub with ((h' | h') | h') | h'
        · have := cell_mappedWires_lowBits _ h'; have := MappedCompressed.base_injective this; omega
        · exact cell_not_low k (by omega) h'
        · exact cellLayout_carry_take254_ne k hk h'
        · have := MappedCompressed.base_injective h'; omega
      · exact cell_not_low k (by omega) (List.mem_toFinset.mp h)
    have hrm : cellLayout.rmsb = base 2311 := rfl
    intro hm
    simp only [OneReuse.unfoldWindow, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with (h | h) | h
    · simp only [cellLayout_parity, cellLayout_lower, cellLayout_one, hrm, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
        Finset.mem_union, Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false, or_assoc] at h
      rcases h with e | e | e | e | e | e | e <;> (have := MappedCompressed.base_injective e; omega)
    · exact hms h
    · simp only [cellLayout_parity, cellLayout_lower, cellLayout_one, hrm, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
        ECDSAAdd.correctionWires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
        Finset.notMem_empty, or_false, or_assoc] at h
      rcases h with e | e | e | e | e | e | e <;> (have := MappedCompressed.base_injective e; omega)
  have h2 : base k ∉ ECDSAAdd.wires (rotateLeft (BalancedCircuit.rawTarget cellLayout)) := by
    rw [(rotate_wires _).2]
    split_ifs
    · simp
    · intro hm; exact cell_not_rawTarget k ⟨by omega, by omega⟩ (List.mem_toFinset.mp hm)
  have h3 : base k ∉ ECDSAAdd.wires ([.CX cellLayout.parity cellLayout.r0] : ECDSAAdd.Program) := by
    have hr0 : cellLayout.r0 = base 2056 := rfl
    intro hm
    simp only [cellLayout_parity, hr0, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hm
    rcases hm with e | e <;> (have := MappedCompressed.base_injective e; omega)
  simp only [OneReuse.restoreRaw, ECDSAAdd.wires_append, Finset.mem_union]
  tauto

/-! ##### Physicality extraction for cell sub-programs -/

private theorem cell_fwd_parts_phys :
    ECDSAAdd.Arithmetic.GatePhysical (GuardCompression.seed cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (GuardCompression.rawAdd cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (OneReuse.remainder cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.prepareCompare cellLayout.toLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.unnormalize cellLayout.toLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.prepareSign cellLayout.toLayout).reverse := by
  have h := TopReuse.forward_physical cellLayout cellLayout_widths cellLayout_nodup
  simp only [TopReuse.forward, TopReuse.cleanup, gatePhysical_append] at h
  exact ⟨h.1.1.1, h.1.1.2, h.1.2, h.2.1, h.2.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2⟩

private theorem cell_unnormE_phys :
    ECDSAAdd.Arithmetic.GatePhysical (TopReuse.unnormalizeE cellLayout.toLayout) := by
  have h := TopReuse.forwardE_physical cellLayout cellLayout_widths cellLayout_nodup
  simp only [TopReuse.forwardE, TopReuse.cleanupE, gatePhysical_append] at h
  exact h.2.2.2.2.1

private theorem cell_zTail_phys :
    ECDSAAdd.Arithmetic.GatePhysical (FirstZero5.tail cellLayout) := by
  have h := FirstZero5.forward_physical cellLayout cellLayout_widths cellLayout_nodup
    (TopReuse.forward_physical cellLayout cellLayout_widths cellLayout_nodup)
  simp only [FirstZero5.forward, gatePhysical_append] at h
  exact h.2

private theorem cell_inv_parts_phys :
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.prepareSign cellLayout.toLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.normalize cellLayout.toLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (BiasedInverse.unbiasView cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (OneReuse.restoreRaw cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (TopReuse.rawSub cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (GuardCompression.seed cellLayout).reverse := by
  have h := TopReuse.inverse_physical cellLayout cellLayout_widths cellLayout_nodup
  simp only [TopReuse.inverse, BiasedInverse.recoverPrefix, gatePhysical_append] at h
  exact ⟨h.1.1.1.1.1.1.1.1, h.1.1.1.1.1.1.1.2, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩

private theorem cell_signComp_y_phys :
    ECDSAAdd.Arithmetic.GatePhysical (signComplement cellLayout.sign cellLayout.y) := by
  have h := cell_fwd_parts_phys.2.1
  simp only [GuardCompression.rawAdd, gatePhysical_append] at h
  exact h.1.1

/-! ##### Support inclusions for cell sub-programs (⊆ `cellWires.toFinset`) -/

private theorem cell_fwd_parts_wires :
    ECDSAAdd.wires (OneReuse.remainder cellLayout) ⊆ cellWires.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) ⊆ cellWires.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.unnormalize cellLayout.toLayout) ⊆ cellWires.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout) ⊆ cellWires.toFinset := by
  have hsub : ECDSAAdd.wires (TopReuse.forward cellLayout) ⊆ cellWires.toFinset :=
    (TopReuse.forward_support cellLayout cellLayout_widths).trans
      (OneBankCell5.ports_wires_sub base (base 2409) cellWires.toFinset (Finset.Subset.refl _))
  simp only [TopReuse.forward, TopReuse.cleanup, ECDSAAdd.wires_append, Finset.union_subset_iff] at hsub
  refine ⟨hsub.1.2, hsub.2.1, hsub.2.2.2.2.1, ?_⟩
  simpa only [ECDSAAdd.wires_reverse] using hsub.2.2.2.2.2

private theorem cell_unnormE_wires :
    ECDSAAdd.wires (TopReuse.unnormalizeE cellLayout.toLayout) ⊆ cellWires.toFinset := by
  have hsub : ECDSAAdd.wires (TopReuse.forwardE cellLayout) ⊆ cellWires.toFinset :=
    (TopReuse.forwardE_wires cellLayout cellLayout_widths).trans
      ((TopReuse.forward_support cellLayout cellLayout_widths).trans
        (OneBankCell5.ports_wires_sub base (base 2409) cellWires.toFinset (Finset.Subset.refl _)))
  simp only [TopReuse.forwardE, TopReuse.cleanupE, ECDSAAdd.wires_append, Finset.union_subset_iff] at hsub
  exact hsub.2.2.2.2.1

private theorem cell_zTail_wires :
    ECDSAAdd.wires (FirstZero5.tail cellLayout) ⊆ cellWires.toFinset := by
  have hsub : ECDSAAdd.wires (FirstZero5.forward cellLayout) ⊆ cellWires.toFinset :=
    (FirstZero5.forward_wires cellLayout cellLayout_widths).trans
      ((TopReuse.forward_support cellLayout cellLayout_widths).trans
        (OneBankCell5.ports_wires_sub base (base 2409) cellWires.toFinset (Finset.Subset.refl _)))
  simp only [FirstZero5.forward, ECDSAAdd.wires_append, Finset.union_subset_iff] at hsub
  exact hsub.2

private theorem cell_inv_parts_wires :
    ECDSAAdd.wires (BalancedCleanup.normalize cellLayout.toLayout) ⊆ cellWires.toFinset ∧
    ECDSAAdd.wires (BiasedInverse.unbiasView cellLayout) ⊆ cellWires.toFinset ∧
    ECDSAAdd.wires (OneReuse.restoreRaw cellLayout) ⊆ cellWires.toFinset := by
  have hsub : ECDSAAdd.wires (TopReuse.inverse cellLayout) ⊆ cellWires.toFinset :=
    (TopReuse.inverse_support cellLayout cellLayout_widths).trans
      (OneBankCell5.ports_wires_sub base (base 2409) cellWires.toFinset (Finset.Subset.refl _))
  simp only [TopReuse.inverse, BiasedInverse.recoverPrefix, ECDSAAdd.wires_append, Finset.union_subset_iff] at hsub
  exact ⟨hsub.1.1.1.1.1.1.1.2, hsub.1.1.1.2, hsub.1.1.2⟩

/-! ##### Pure-Boolean state-preservation lemmas for cell sub-programs -/

private theorem addInPlaceTop_carry_clean :
    ∀ (x ys carry : List Wire) (cin : Wire),
      x.length = ys.length → carry.length + 1 = ys.length →
      carry.Nodup → List.Disjoint ys carry →
      ∀ (s : ECDSAAdd.State) (m : List Bool) (q : Wire), q ∈ carry →
      (ECDSAAdd.run (TopReuseCarry.addInPlaceTop x ys carry cin) m s).basis q = false
  | a :: a' :: as, b :: b' :: bs, c :: cs, cin, hx, hc, hnd, hdis, s, m, q, hq => by
      have hqb : q ≠ b := fun e => hdis List.mem_cons_self (e ▸ hq)
      have heq : TopReuseCarry.addInPlaceTop (a :: a' :: as) (b :: b' :: bs) (c :: cs) cin =
          ((if as = [] then [.CX b c, .CX b' c, .CX cin c] else majority a b cin c) ++
            TopReuseCarry.addInPlaceTop (a' :: as) (b' :: bs) cs c) ++
            eraseCarry a b cin c ++ [.CX a b, .CX cin b] := by
        simp only [TopReuseCarry.addInPlaceTop, List.append_assoc]
      rw [heq, ECDSAAdd.run_append]
      have hcx : ∀ (t : ECDSAAdd.State) (r : List Bool),
          (ECDSAAdd.run ([.CX a b, .CX cin b] : ECDSAAdd.Program) r t).basis q = t.basis q := by
        intro t r; simp [ECDSAAdd.run, ECDSAAdd.writeBit, hqb]
      rw [hcx, ECDSAAdd.run_append, eraseCarry_basis_local]
      by_cases hqc : q = c
      · simp [hqc]
      · rw [if_neg hqc, ECDSAAdd.run_append]
        have hqs : q ∈ cs := by simpa [hqc] using hq
        exact addInPlaceTop_carry_clean (a' :: as) (b' :: bs) cs c (by simpa using hx) (by simpa using hc)
          (List.nodup_cons.mp hnd).2
          (fun w hw1 hw2 => hdis (List.mem_cons_of_mem _ hw1) (List.mem_cons_of_mem _ hw2))
          _ _ q hqs
  | [_], [_], [], _, _, _, _, _, _, _, _, hq => by simp at hq
  | [], [], _, _, _, hc, _, _, _, _, _, _ => by simp at hc
  | [], _ :: _, _, _, hx, _, _, _, _, _, _, _ => by simp at hx
  | _ :: _, [], _, _, hx, _, _, _, _, _, _, _ => by simp at hx
  | [_], _ :: _ :: _, _, _, hx, _, _, _, _, _, _, _ => by simp at hx
  | _ :: _ :: _, [_], _, _, hx, _, _, _, _, _, _, _ => by simp at hx
  | _ :: _ :: _, _ :: _ :: _, [], _, _, hc, _, _, _, _, _, _ => by simp at hc
  | [_], [_], _ :: _, _, _, hc, _, _, _, _, _, _ => by simp at hc

private theorem cell_carry_nodup : cellLayout.carry.Nodup := by
  apply List.nodup_iff_count.mpr; intro w
  have h := List.nodup_iff_count.mp cellLayout_nodup w
  simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, List.count_cons,
    List.count_append] at h ⊢; omega

private theorem cell_rawTarget_disj_carry :
    List.Disjoint (BalancedCircuit.rawTarget cellLayout) cellLayout.carry := by
  intro w hw1 hw2
  have h := List.nodup_iff_count.mp cellLayout_nodup w
  have hp1 := List.count_pos_iff.mpr hw1
  have hp2 := List.count_pos_iff.mpr hw2
  simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
    BalancedCleanup.Layout.low, BalancedCircuit.rawTarget, List.count_cons, List.count_append,
    List.count_nil] at h hp1 hp2
  omega

private theorem cell_seed_pres_clean (st : ECDSAAdd.State) (m : List Bool) (hc : CellClean st.basis) :
    (ECDSAAdd.run (GuardCompression.seed cellLayout) m st).basis (base 1797) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (GuardCompression.seed cellLayout) m st).basis w = false := by
  refine ⟨(ECDSAAdd.run_preserves_outside _ m st _ (cell_seed_avoid 1797 (by omega))).trans hc.1, fun w hw => ?_⟩
  have hwa : w ∉ ECDSAAdd.wires (GuardCompression.seed cellLayout) := by
    change w ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hw
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
      List.mem_range'_1] at hw
    rcases hw with ⟨i, hi, rfl⟩ | rfl | rfl | rfl
    · exact cell_seed_avoid i (by omega)
    · exact cell_seed_avoid 1540 (by omega)
    · exact cell_seed_avoid 1541 (by omega)
    · exact cell_seed_avoid 1026 (by omega)
  exact (ECDSAAdd.run_preserves_outside _ m st w hwa).trans (hc.2.2 w hw)

private theorem cell_signComp_y_avoid_carry (w : Wire) (hw : w ∈ cellLayout.carry) :
    w ∉ ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y) := by
  change w ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hw
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
    List.mem_range'_1] at hw
  rcases hw with ⟨i, hi, rfl⟩ | rfl | rfl | rfl
  · exact cell_signComp_y_avoid i (by omega)
  · exact cell_signComp_y_avoid 1540 (by omega)
  · exact cell_signComp_y_avoid 1541 (by omega)
  · exact cell_signComp_y_avoid 1026 (by omega)

private theorem cell_rawAdd_pres (st : ECDSAAdd.State) (m : List Bool)
    (hl : st.basis (base 1797) = false) (hca : ∀ w ∈ cellLayout.carry, st.basis w = false) :
    (ECDSAAdd.run (GuardCompression.rawAdd cellLayout) m st).basis (base 1797) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (GuardCompression.rawAdd cellLayout) m st).basis w = false := by
  have hnd : (cellLayout.sign :: (BalancedCircuit.rawTarget cellLayout ++ cellLayout.carry)).Nodup :=
    (List.nodup_cons.mp cell_rawAdd_nd).2
  have hdis : List.Disjoint (GuardCompression.source cellLayout)
      (cellLayout.sign :: (BalancedCircuit.rawTarget cellLayout ++ cellLayout.carry)) :=
    fun w hw1 hw2 => cell_rawAdd_disj hw1 (List.mem_cons_of_mem _ hw2)
  have hsl : (GuardCompression.source cellLayout).length = (BalancedCircuit.rawTarget cellLayout).length := by
    have kw := BalancedCircuit.widths cellLayout cellLayout_widths
    simpa [GuardCompression.source, BalancedCircuit.rawSource] using kw.1.trans kw.2.1.symm
  have hcl : cellLayout.carry.length + 1 = (BalancedCircuit.rawTarget cellLayout).length := by
    have kw := BalancedCircuit.widths cellLayout cellLayout_widths
    have := cellLayout_widths.2.2; omega
  have h1797 : base 1797 ∉ BalancedCircuit.rawTarget cellLayout := cell_not_rawTarget 1797 ⟨by omega, by omega⟩
  have hsc1797 := cell_signComp_y_avoid 1797 (by omega)
  have h1 : ∀ (r : List Bool) (w : Wire), w ∈ base 1797 :: cellLayout.carry →
      (ECDSAAdd.run (signComplement cellLayout.sign cellLayout.y) r st).basis w = false := by
    intro r w hw; rcases List.mem_cons.mp hw with rfl | hw
    · exact (ECDSAAdd.run_preserves_outside _ r st _ hsc1797).trans hl
    · exact (ECDSAAdd.run_preserves_outside _ r st _ (cell_signComp_y_avoid_carry w hw)).trans (hca w hw)
  simp only [GuardCompression.rawAdd, ECDSAAdd.run_append]
  have hadd (r1 r2 : List Bool) := GuardCompression.addInPlace_readonly_correct (GuardCompression.source cellLayout)
    (BalancedCircuit.rawTarget cellLayout) cellLayout.carry cellLayout.sign hnd hdis hsl hcl
    (ECDSAAdd.run (signComplement cellLayout.sign cellLayout.y) r1 st) r2
    (fun w hw => h1 r1 w (List.mem_cons_of_mem _ hw))
  refine ⟨?_, fun w hw => ?_⟩
  · rw [ECDSAAdd.run_preserves_outside _ _ _ _ hsc1797]
    exact ((hadd _ _).2.1 _ h1797).trans (h1 _ _ List.mem_cons_self)
  · rw [ECDSAAdd.run_preserves_outside _ _ _ _ (cell_signComp_y_avoid_carry w hw)]
    exact ((hadd _ _).2.1 _ (fun hm => cell_rawTarget_disj_carry hm hw)).trans (h1 _ w (List.mem_cons_of_mem _ hw))

private theorem cell_rawSub_pres (st : ECDSAAdd.State) (m : List Bool)
    (hl : st.basis (base 1797) = false) :
    (ECDSAAdd.run (TopReuse.rawSub cellLayout) m st).basis (base 1797) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (TopReuse.rawSub cellLayout) m st).basis w = false := by
  have hsl : (GuardCompression.source cellLayout).length = (BalancedCircuit.rawTarget cellLayout).length := by
    have kw := BalancedCircuit.widths cellLayout cellLayout_widths
    simpa [GuardCompression.source, BalancedCircuit.rawSource] using kw.1.trans kw.2.1.symm
  have hcl : cellLayout.carry.length + 1 = (BalancedCircuit.rawTarget cellLayout).length := by
    have kw := BalancedCircuit.widths cellLayout cellLayout_widths
    have := cellLayout_widths.2.2; omega
  have hsc1797 := cell_signComp_y_avoid 1797 (by omega)
  have hnr1797 := cell_notRaw_avoid 1797 ⟨by omega, by omega⟩
  have hadd1797 : base 1797 ∉ ECDSAAdd.wires (TopReuseCarry.addInPlaceTop (GuardCompression.source cellLayout)
      (BalancedCircuit.rawTarget cellLayout) cellLayout.carry cellLayout.sign) := by
    intro hm
    have hsub := TopReuseCarry.addInPlaceTop_wires (GuardCompression.source cellLayout)
      (BalancedCircuit.rawTarget cellLayout) cellLayout.carry cellLayout.sign hm
    simp only [List.mem_toFinset, List.mem_cons, List.mem_append, cellLayout_sign, or_assoc] at hsub
    rcases hsub with e | h | h | h
    · have := MappedCompressed.base_injective e; omega
    · simp only [GuardCompression.source, List.mem_append, List.mem_singleton] at h
      rcases h with h | e
      · exact cell_not_y 1797 (by omega) h
      · exact cell_not_y 1797 (by omega) (by rw [e]; simp [BalancedCleanup.Layout.y])
    · exact cell_not_rawTarget 1797 ⟨by omega, by omega⟩ h
    · exact cell_not_carry 1797 ⟨by omega, by omega, by omega, by omega⟩ h
  have hnr_ca (w : Wire) (hw : w ∈ cellLayout.carry) :
      w ∉ ECDSAAdd.wires (Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) := by
    rw [notRegister_wires]; intro hm; exact cell_rawTarget_disj_carry (List.mem_toFinset.mp hm) hw
  simp only [TopReuse.rawSub, TopReuseCarry.subInPlaceTop, ECDSAAdd.run_append]
  refine ⟨?_, fun w hw => ?_⟩
  · rw [ECDSAAdd.run_preserves_outside _ _ _ _ hsc1797,
      ECDSAAdd.run_preserves_outside _ _ _ _ hnr1797,
      ECDSAAdd.run_preserves_outside _ _ _ _ hadd1797,
      ECDSAAdd.run_preserves_outside _ _ _ _ hnr1797,
      ECDSAAdd.run_preserves_outside _ _ _ _ hsc1797, hl]
  · rw [ECDSAAdd.run_preserves_outside _ _ _ _ (cell_signComp_y_avoid_carry w hw),
      ECDSAAdd.run_preserves_outside _ _ _ _ (hnr_ca w hw)]
    exact addInPlaceTop_carry_clean _ _ _ _ hsl hcl cell_carry_nodup cell_rawTarget_disj_carry _ _ w hw

private theorem cell_mappedAdd_pres (st : ECDSAAdd.State) (m : List Bool)
    (hca : ∀ w ∈ cellLayout.carry.take 254, st.basis w = false) (q : Wire) (hq : q ∉ cellLayout.low) :
    (ECDSAAdd.run (mappedAdd (ShortBiasedFold.lowBits cellLayout) cellLayout.low
      (cellLayout.carry.take 254) cellLayout.one) m st).basis q = st.basis q := by
  have hw := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
  have hnd : (cellLayout.one :: (cellLayout.low ++ cellLayout.carry.take 254)).Nodup := by
    apply List.nodup_iff_count.mpr; intro w
    have h := List.nodup_iff_count.mp cellLayout_nodup w
    have ht : List.count w (cellLayout.carry.take 254) ≤ List.count w cellLayout.carry := by
      have := congrArg (List.count w) (List.take_append_drop 254 cellLayout.carry)
      rw [List.count_append] at this; omega
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.count_cons, List.count_append] at h ⊢
    omega
  have hhs : ∀ u ∈ mappedWires (ShortBiasedFold.lowBits cellLayout),
      u ∉ cellLayout.one :: (cellLayout.low ++ cellLayout.carry.take 254) := by
    intro u hu hm
    rw [cell_mappedWires_lowBits u hu] at hm
    simp only [List.mem_cons, List.mem_append, cellLayout_one] at hm
    rcases hm with e | h | h
    · have := MappedCompressed.base_injective e; omega
    · exact cell_not_low 1797 (by omega) h
    · exact cell_not_carry 1797 ⟨by omega, by omega, by omega, by omega⟩ (List.mem_of_mem_take h)
  have hlen : (ShortBiasedFold.lowBits cellLayout).length = cellLayout.low.length := by
    rw [ShortBiasedFold.lowBits, BiasedCircuit.biasBits, List.length_take, List.length_append,
      List.length_map, List.length_range, List.length_singleton, hw.1]; omega
  exact (mappedAdd_correct _ _ _ _ hnd hhs hlen (by omega) st m hca).2.1 q hq

private theorem cell_remainder_pres (st : ECDSAAdd.State) (m : List Bool)
    (hca : ∀ w ∈ cellLayout.carry, st.basis w = false) :
    (ECDSAAdd.run (OneReuse.remainder cellLayout) m st).basis (base 1027) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (OneReuse.remainder cellLayout) m st).basis w = false := by
  have hca_not_low (w : Wire) (hw : w ∈ cellLayout.carry) : w ∉ cellLayout.low := fun hl =>
    cell_rawTarget_disj_carry (by simp [BalancedCircuit.rawTarget, BalancedCleanup.Layout.r, hl]) hw
  have hca_ne (w : Wire) (hw : w ∈ cellLayout.carry) :
      w ≠ base 1027 ∧ w ≠ base 1797 ∧ w ≠ base 768 ∧ w ≠ base 2056 ∧ w ≠ base 2311 ∧ w ≠ base 2310 := by
    change w ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hw
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
      List.mem_range'_1] at hw
    rcases hw with ⟨i, hi, rfl⟩ | rfl | rfl | rfl <;>
      exact ⟨cell_base_ne _ _ (by omega), cell_base_ne _ _ (by omega), cell_base_ne _ _ (by omega),
        cell_base_ne _ _ (by omega), cell_base_ne _ _ (by omega), cell_base_ne _ _ (by omega)⟩
  have hnp_ca (w : Wire) (hw : w ∈ cellLayout.carry) : w ∉ ECDSAAdd.wires (OneReuse.newPrepare cellLayout) := by
    have hne := hca_ne w hw; have hr0 : cellLayout.r0 = base 2056 := rfl
    intro hm
    simp only [OneReuse.newPrepare, cellLayout_one, cellLayout_lower, cellLayout_parity, hr0,
      ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
      Finset.notMem_empty, or_false] at hm
    rcases hm with e | e | e | e <;> tauto
  have hrot_ca (w : Wire) (hw : w ∈ cellLayout.carry) :
      w ∉ ECDSAAdd.wires (rotateRight (BalancedCircuit.rawTarget cellLayout)) := by
    rw [(rotate_wires _).1]; split_ifs
    · simp
    · intro hm; exact cell_rawTarget_disj_carry (List.mem_toFinset.mp hm) hw
  have hps_avoid (q : Wire) (hr : q ∉ cellLayout.r) (hl : q ≠ base 1797) :
      q ∉ ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout) := by
    have hrm : cellLayout.toLayout.rmsb ∈ cellLayout.r := by simp [BalancedCleanup.Layout.r]
    intro hm; simp only [BalancedCleanup.prepareSign, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with h | h
    · simp only [cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
        Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at h
      rcases h with rfl | rfl
      · exact hr hrm
      · exact hl rfl
    · have hs := signComplement_wires_subset _ _ h
      simp only [List.mem_toFinset, List.mem_cons, cellLayout_lower] at hs
      rcases hs with rfl | hr'; exact hl rfl; exact hr hr'
  have hfb_avoid (q : Wire) (hq : q ≠ base 2310) : q ∉ ECDSAAdd.wires (BiasedCircuit.flipBias cellLayout) := by
    intro hm
    simp only [BiasedCircuit.flipBias, cell_rtail_getD253, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hm
    exact hq hm
  have hps_one : base 1027 ∉ ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout) :=
    hps_avoid (base 1027) (cell_not_r 1027 (by omega)) (cell_base_ne 1027 1797 (by omega))
  have hfb_one : base 1027 ∉ ECDSAAdd.wires (BiasedCircuit.flipBias cellLayout) :=
    hfb_avoid (base 1027) (cell_base_ne 1027 2310 (by omega))
  simp only [OneReuse.remainder, OneReuse.foldWindow, ECDSAAdd.run_append]
  have htail_one : ∀ (t : ECDSAAdd.State) (r : List Bool),
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.rmsb, .CX cellLayout.parity cellLayout.lower,
        .CX cellLayout.rmsb cellLayout.lower,
        .measureX cellLayout.one List.nil ([.Z cellLayout.parity, .CZ cellLayout.parity cellLayout.rmsb])] : ECDSAAdd.Program) r t).basis (base 1027) = false := by
    intro t r
    cases hr : r.headD false <;>
      simp [ECDSAAdd.run, ECDSAAdd.measureAndCorrect, ECDSAAdd.correct_basis, ECDSAAdd.writeBit, cellLayout_one, hr]
  have htail_ca (w : Wire) (hw : w ∈ cellLayout.carry) : ∀ (t : ECDSAAdd.State) (r : List Bool),
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.rmsb, .CX cellLayout.parity cellLayout.lower,
        .CX cellLayout.rmsb cellLayout.lower,
        .measureX cellLayout.one List.nil ([.Z cellLayout.parity, .CZ cellLayout.parity cellLayout.rmsb])] : ECDSAAdd.Program) r t).basis w = t.basis w := by
    have hne := hca_ne w hw; have hrm : cellLayout.rmsb = base 2311 := rfl
    intro t r
    cases hr : r.headD false <;>
      simp [ECDSAAdd.run, ECDSAAdd.measureAndCorrect, ECDSAAdd.correct_basis, ECDSAAdd.writeBit,
        cellLayout_one, cellLayout_lower, cellLayout_parity, hrm, hne.1, hne.2.1, hne.2.2.2.2.1, hr]
  have hccx_ca (w : Wire) (hw : w ∈ cellLayout.carry) : ∀ (t : ECDSAAdd.State) (r : List Bool),
      (ECDSAAdd.run ([.CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r t).basis w = t.basis w := by
    have hne := hca_ne w hw
    intro t r; simp [ECDSAAdd.run, ECDSAAdd.writeBit, cellLayout_one, hne.1]
  have hbefore_ca (r1 r2 r3 : List Bool) (w : Wire) (hw : w ∈ cellLayout.carry) :
      (ECDSAAdd.run ([.CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r3
        (ECDSAAdd.run (rotateRight (BalancedCircuit.rawTarget cellLayout)) r2
          (ECDSAAdd.run (OneReuse.newPrepare cellLayout) r1 st))).basis w = false := by
    rw [hccx_ca w hw, ECDSAAdd.run_preserves_outside _ _ _ _ (hrot_ca w hw),
      ECDSAAdd.run_preserves_outside _ _ _ _ (hnp_ca w hw), hca w hw]
  refine ⟨?_, fun w hw => ?_⟩
  · rw [ECDSAAdd.run_preserves_outside _ _ _ _ hfb_one,
      ECDSAAdd.run_preserves_outside _ _ _ _ hps_one, htail_one]
  · have hne := hca_ne w hw
    have hwr : w ∉ cellLayout.r := fun hr => cell_rawTarget_disj_carry (by simp [BalancedCircuit.rawTarget, hr]) hw
    rw [ECDSAAdd.run_preserves_outside _ _ _ _ (hfb_avoid w hne.2.2.2.2.2),
      ECDSAAdd.run_preserves_outside _ _ _ _ (hps_avoid w hwr hne.2.1),
      htail_ca w hw,
      cell_mappedAdd_pres _ _ (fun u hu => hbefore_ca _ _ _ u (List.mem_of_mem_take hu)) w (hca_not_low w hw),
      hbefore_ca _ _ _ w hw]

private theorem cell_prepSign_pres (st : ECDSAAdd.State) (m : List Bool)
    (hc : CellClean st.basis) :
    (ECDSAAdd.run (BalancedCleanup.prepareSign cellLayout.toLayout) m st).basis (base 1027) = false ∧
    (ECDSAAdd.run (BalancedCleanup.prepareSign cellLayout.toLayout) m st).basis (base 2311) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (BalancedCleanup.prepareSign cellLayout.toLayout) m st).basis w = false := by
  have hlo : cellLayout.toLayout.lower ∉ cellLayout.toLayout.r := cell_not_r 1797 (by omega)
  have hrnd : cellLayout.toLayout.r.Nodup := by
    apply List.nodup_iff_count.mpr; intro w
    have h := List.nodup_iff_count.mp cellLayout_nodup w
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.count_cons, List.count_append] at h ⊢; omega
  have hrm : cellLayout.toLayout.rmsb = base 2311 := rfl
  have hrm_ne : base 2311 ≠ base 1797 := cell_base_ne 2311 1797 (by omega)
  have hrm_mem : cellLayout.toLayout.rmsb ∈ cellLayout.toLayout.r := by simp [BalancedCleanup.Layout.r]
  have hsc := signComplement_correct cellLayout.toLayout.lower cellLayout.toLayout.r hrnd hlo
  have h1 : ECDSAAdd.run ([.CX cellLayout.toLayout.rmsb cellLayout.toLayout.lower] : ECDSAAdd.Program)
      (m.take (ECDSAAdd.measurementCount [.CX cellLayout.toLayout.rmsb cellLayout.toLayout.lower])) st =
      ⟨st.phase, ECDSAAdd.writeBit st.basis (base 1797) (st.basis (base 2311))⟩ := by
    simp [ECDSAAdd.run, hrm, cellLayout_lower, hc.1]
  simp only [BalancedCleanup.prepareSign, ECDSAAdd.run_append, h1]
  refine ⟨?_, ?_, fun w hw => ?_⟩
  · rw [(hsc _ _).2.1 _ (cell_not_r 1027 (by omega))]
    simp [ECDSAAdd.writeBit, cell_base_ne 1027 1797 (by omega), hc.2.1]
  · have hbit : ∀ (l : List Wire) (r : List Bool) (s : BasisState) (q : Wire),
        l.Nodup → base 1797 ∉ l → q ∈ l →
        (ECDSAAdd.run (signComplement (base 1797) l) r ⟨st.phase, s⟩).basis q = (s q ^^ s (base 1797)) := by
      intro l; induction l with
      | nil => intro _ _ _ _ _ h; simp at h
      | cons a as ih =>
        intro r s q hnd h1797 hq
        have ha1797 : base 1797 ≠ a := fun e => h1797 (by simp [e])
        have h1797s : base 1797 ∉ as := fun hm => h1797 (List.mem_cons_of_mem _ hm)
        change (ECDSAAdd.run (signComplement (base 1797) as) r ⟨st.phase, ECDSAAdd.writeBit s a (s a ^^ s (base 1797))⟩).basis q = _
        rcases List.mem_cons.mp hq with rfl | hqs
        · have hqas : q ∉ ECDSAAdd.wires (signComplement (base 1797) as) := by
            intro hm; have hs := signComplement_wires_subset _ _ hm
            simp only [List.mem_toFinset, List.mem_cons] at hs
            rcases hs with rfl | hm'
            · exact ha1797 rfl
            · exact (List.nodup_cons.mp hnd).1 hm'
          rw [ECDSAAdd.run_preserves_outside _ _ _ _ hqas]
          simp [ECDSAAdd.writeBit]
        · have hqa : q ≠ a := fun e => (List.nodup_cons.mp hnd).1 (e ▸ hqs)
          rw [ih r _ q (List.nodup_cons.mp hnd).2 h1797s hqs]
          simp [ECDSAAdd.writeBit, hqa, ha1797]
    rw [cellLayout_lower, hbit cellLayout.toLayout.r _ _ (base 2311) hrnd (by simpa [cellLayout_lower] using hlo) (hrm ▸ hrm_mem)]
    simp [ECDSAAdd.writeBit, hrm_ne]
  · have hwr : w ∉ cellLayout.toLayout.r := fun hr => cell_rawTarget_disj_carry (by simp [BalancedCircuit.rawTarget, hr]) hw
    have hw1797 : w ≠ base 1797 := fun e => cell_not_carry 1797 ⟨by omega, by omega, by omega, by omega⟩ (e ▸ hw)
    rw [(hsc _ _).2.1 w hwr]
    simp [ECDSAAdd.writeBit, hw1797, hc.2.2 w hw]

private theorem cell_prepSign_rev_lower (st : ECDSAAdd.State) (m : List Bool)
    (hrm : st.basis (base 2311) = false) :
    (ECDSAAdd.run (BalancedCleanup.prepareSign cellLayout.toLayout).reverse m st).basis (base 1797) = false := by
  have hlo : cellLayout.toLayout.lower ∉ cellLayout.toLayout.r := cell_not_r 1797 (by omega)
  have hrnd : cellLayout.toLayout.r.Nodup := by
    apply List.nodup_iff_count.mpr; intro w
    have h := List.nodup_iff_count.mp cellLayout_nodup w
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.count_cons, List.count_append] at h ⊢; omega
  have hrev : (BalancedCleanup.prepareSign cellLayout.toLayout).reverse =
      signComplement cellLayout.toLayout.lower cellLayout.toLayout.r.reverse ++
        [.CX cellLayout.toLayout.rmsb cellLayout.toLayout.lower] := by
    simp [BalancedCleanup.prepareSign, signComplement, List.map_reverse]
  have hrm_mem : base 2311 ∈ cellLayout.toLayout.r.reverse := by
    rw [List.mem_reverse]; exact (by simp [BalancedCleanup.Layout.r] : cellLayout.toLayout.rmsb ∈ cellLayout.toLayout.r)
  have hbit : ∀ (l : List Wire) (r : List Bool) (s : BasisState) (q : Wire),
      l.Nodup → base 1797 ∉ l → q ∈ l →
      (ECDSAAdd.run (signComplement (base 1797) l) r ⟨st.phase, s⟩).basis q = (s q ^^ s (base 1797)) := by
    intro l; induction l with
    | nil => intro _ _ _ _ _ h; simp at h
    | cons a as ih =>
      intro r s q hnd h1797 hq
      have ha1797 : base 1797 ≠ a := fun e => h1797 (by simp [e])
      have h1797s : base 1797 ∉ as := fun hm => h1797 (List.mem_cons_of_mem _ hm)
      change (ECDSAAdd.run (signComplement (base 1797) as) r ⟨st.phase, ECDSAAdd.writeBit s a (s a ^^ s (base 1797))⟩).basis q = _
      rcases List.mem_cons.mp hq with rfl | hqs
      · have hqas : q ∉ ECDSAAdd.wires (signComplement (base 1797) as) := by
          intro hm; have hs := signComplement_wires_subset _ _ hm
          simp only [List.mem_toFinset, List.mem_cons] at hs
          rcases hs with rfl | hm'
          · exact ha1797 rfl
          · exact (List.nodup_cons.mp hnd).1 hm'
        rw [ECDSAAdd.run_preserves_outside _ _ _ _ hqas]; simp [ECDSAAdd.writeBit]
      · have hqa : q ≠ a := fun e => (List.nodup_cons.mp hnd).1 (e ▸ hqs)
        rw [ih r _ q (List.nodup_cons.mp hnd).2 h1797s hqs]; simp [ECDSAAdd.writeBit, hqa, ha1797]
  rw [hrev, ECDSAAdd.run_append]
  have hrm_eq (r : List Bool) :
      (ECDSAAdd.run (signComplement cellLayout.toLayout.lower cellLayout.toLayout.r.reverse) r st).basis (base 2311) =
      st.basis (base 1797) := by
    have := hbit cellLayout.toLayout.r.reverse r st.basis (base 2311) (List.nodup_reverse.mpr hrnd)
      (by simpa using hlo) hrm_mem
    simpa [hrm] using this
  have hlo_eq (r : List Bool) :
      (ECDSAAdd.run (signComplement cellLayout.toLayout.lower cellLayout.toLayout.r.reverse) r st).basis (base 1797) =
      st.basis (base 1797) :=
    (signComplement_correct _ _ (List.nodup_reverse.mpr hrnd) (by simpa using hlo) st r).2.1 _ (by simpa using hlo)
  have hrm_def : cellLayout.toLayout.rmsb = base 2311 := rfl
  have hlo_def : cellLayout.toLayout.lower = base 1797 := cellLayout_lower
  simp only [ECDSAAdd.run, ECDSAAdd.writeBit, hrm_def]
  rw [hlo_def, Function.update_self]
  change ((ECDSAAdd.run (signComplement cellLayout.toLayout.lower cellLayout.toLayout.r.reverse) _ st).basis (base 1797) ^^
    (ECDSAAdd.run (signComplement cellLayout.toLayout.lower cellLayout.toLayout.r.reverse) _ st).basis (base 2311)) = false
  rw [hlo_eq, hrm_eq, Bool.xor_self]

private theorem cell_norm_pres (st : ECDSAAdd.State) (m : List Bool)
    (ho : st.basis (base 1027) = false) (hrm : st.basis (base 2311) = false)
    (hca : ∀ w ∈ cellLayout.carry, st.basis w = false) :
    (ECDSAAdd.run (BalancedCleanup.normalize cellLayout.toLayout) m st).basis (base 1027) = false ∧
    (ECDSAAdd.run (BalancedCleanup.normalize cellLayout.toLayout) m st).basis (base 2311) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (BalancedCleanup.normalize cellLayout.toLayout) m st).basis w = false := by
  have hw := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
  have hnd : (cellLayout.one :: cellLayout.lower :: (cellLayout.low ++ cellLayout.carry.take 254)).Nodup := by
    apply List.nodup_iff_count.mpr; intro w
    have h := List.nodup_iff_count.mp cellLayout_nodup w
    have ht : List.count w (cellLayout.carry.take 254) ≤ List.count w cellLayout.carry := by
      have := congrArg (List.count w) (List.take_append_drop 254 cellLayout.carry)
      rw [List.count_append] at this; omega
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.count_cons, List.count_append] at h ⊢; omega
  have hcor := literalConstAdd_correct cellLayout.low (cellLayout.carry.take 254) cellLayout.lower cellLayout.one
    BalancedCleanup.negativeLiteral hnd (by omega) st m ho (fun w hw' => hca w (List.mem_of_mem_take hw'))
  refine ⟨(hcor.2.1 _ (cell_not_low 1027 (by omega))).trans ho,
    (hcor.2.1 _ (cell_not_low 2311 (by omega))).trans hrm, fun w hw' => ?_⟩
  have hwl : w ∉ cellLayout.low := fun hl =>
    cell_rawTarget_disj_carry (by simp [BalancedCircuit.rawTarget, BalancedCleanup.Layout.r, hl]) hw'
  exact (hcor.2.1 w hwl).trans (hca w hw')

private theorem cell_prepCmp_pres_one_carry (st : ECDSAAdd.State) (m : List Bool)
    (ho : st.basis (base 1027) = false) (hca : ∀ w ∈ cellLayout.carry, st.basis w = false) :
    (ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout) m st).basis (base 1027) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout) m st).basis w = false := by
  have h1027 : base 1027 ∉ ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) :=
    EndKnown.prepareCompare_away _ cellLayout_widths (base 1027) (cell_not_r 1027 (by omega))
      (cell_not_y 1027 (by omega)) (cell_base_ne 1027 2409 (by omega)) (cell_base_ne 1027 1797 (by omega))
  refine ⟨(ECDSAAdd.run_preserves_outside _ m st _ h1027).trans ho, fun w hw => ?_⟩
  have hwc : w ∉ ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) := by
    change w ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hw
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
      List.mem_range'_1] at hw
    rcases hw with ⟨i, hi, rfl⟩ | rfl | rfl | rfl <;>
      exact EndKnown.prepareCompare_away _ cellLayout_widths (base _) (cell_not_r _ (by omega))
        (cell_not_y _ (by omega)) (cell_base_ne _ 2409 (by omega)) (cell_base_ne _ 1797 (by omega))
  exact (ECDSAAdd.run_preserves_outside _ m st w hwc).trans (hca w hw)

private theorem cell_cmpConjugate_pres_nonParity (st : ECDSAAdd.State) (m1 m2 m3 : List Bool)
    (ho : st.basis (base 1027) = false) (hca : ∀ w ∈ cellLayout.carry, st.basis w = false)
    (q : Wire) (hq : q ≠ cellLayout.parity) :
    (ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse m3
      (ECDSAAdd.run (compareLt none cellLayout.y cellLayout.r cellLayout.carry cellLayout.one cellLayout.parity) m2
        (ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout) m1 st))).basis q = st.basis q := by
  have hpc_par : cellLayout.parity ∉ ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) :=
    EndKnown.prepareCompare_away _ cellLayout_widths (base 768) (cell_not_r 768 (by omega))
      (cell_not_y 768 (by omega)) (cell_base_ne 768 2409 (by omega)) (cell_base_ne 768 1797 (by omega))
  have hpc_rev_par : cellLayout.parity ∉ ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse := by
    rwa [ECDSAAdd.wires_reverse]
  have hpc_prop : ∀ i ∈ BalancedCleanup.prepareCompare cellLayout.toLayout, ProperGate i := by
    have hm : ECDSAAdd.measurementCount (BalancedCleanup.prepareCompare cellLayout.toLayout) = 0 :=
      (FirstZero5.prepareCompare_counts cellLayout.toLayout).2
    have hph := cell_fwd_parts_phys.2.2.2.1
    have hmeas0 : ∀ (P : ECDSAAdd.Program), ECDSAAdd.measurementCount P = 0 → ∀ i ∈ P, ∀ a c0 c1, i ≠ .measureX a c0 c1 := by
      intro P; induction P with
      | nil => intro _ _ hi; simp at hi
      | cons j Ps ih =>
        intro h0 i hi a c0 c1 heq
        rcases List.mem_cons.mp hi with rfl | hm'
        · subst heq; simp [ECDSAAdd.measurementCount] at h0
        · cases j with
          | measureX _ _ _ => simp [ECDSAAdd.measurementCount] at h0
          | X _ | CX _ _ | CCX _ _ _ => exact ih h0 i hm' a c0 c1 heq
    intro i hi
    have hp := hph i hi
    cases i with
    | X _ => trivial
    | CX _ _ => exact hp
    | CCX _ _ _ => exact hp
    | measureX a c0 c1 => exact absurd rfl (hmeas0 _ hm _ hi a c0 c1)
  have hpc_inv : ∀ u : ECDSAAdd.State,
      ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse m3
        (ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout) m1 u) = u := fun u =>
    run_reverse_proper _ hpc_prop u m1 m3
  have h1 := cell_prepCmp_pres_one_carry st m1 ho hca
  have hw := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
  have hcmp_nd : (cellLayout.parity :: cellLayout.one :: (cellLayout.y ++ cellLayout.r ++ cellLayout.carry)).Nodup :=
    cell_cmp_nd
  have hcmp := compareLt_correct none cellLayout.y cellLayout.r cellLayout.carry cellLayout.one cellLayout.parity
    hcmp_nd (by simp) (by rw [hw.2.1, hw.2.2.1]) (by rw [cellLayout_widths.2.2, hw.2.1])
    (ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout) m1 st) m2 h1.1 h1.2
  set s1 := ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout) m1 st
  set s2 := ECDSAAdd.run (compareLt none cellLayout.y cellLayout.r cellLayout.carry cellLayout.one cellLayout.parity) m2 s1
  have hag : ∀ w ∈ ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse, s2.basis w = s1.basis w := by
    intro w hw'
    have hwp : w ≠ cellLayout.parity := fun e => hpc_rev_par (e ▸ hw')
    exact hcmp.2.1 w hwp
  have hpool := ECDSAAdd.Arithmetic.pool_run_agrees (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse
    (ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse) (Finset.Subset.refl _) m3 s2 s1 hcmp.1 hag
  by_cases hqm : q ∈ ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse
  · rw [hpool.2 q hqm, hpc_inv st]
  · rw [ECDSAAdd.run_preserves_outside _ m3 s2 q hqm, hcmp.2.1 q hq]
    have hqm' : q ∉ ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) := by
      rwa [ECDSAAdd.wires_reverse] at hqm
    exact ECDSAAdd.run_preserves_outside _ m1 st q hqm'

private theorem cell_restoreRaw_pres (st : ECDSAAdd.State) (m : List Bool)
    (hlo : st.basis (base 1797) = false) (hca : ∀ w ∈ cellLayout.carry, st.basis w = false) :
    (ECDSAAdd.run (OneReuse.restoreRaw cellLayout) m st).basis (base 1797) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (OneReuse.restoreRaw cellLayout) m st).basis w = false := by
  have hrm : cellLayout.rmsb = base 2311 := rfl
  have hr0 : cellLayout.r0 = base 2056 := rfl
  have hca_not_low (w : Wire) (hw : w ∈ cellLayout.carry) : w ∉ cellLayout.low := fun hl =>
    cell_rawTarget_disj_carry (by simp [BalancedCircuit.rawTarget, BalancedCleanup.Layout.r, hl]) hw
  have hca_ne (w : Wire) (hw : w ∈ cellLayout.carry) :
      w ≠ base 1027 ∧ w ≠ base 1797 ∧ w ≠ base 768 ∧ w ≠ base 2056 ∧ w ≠ base 2311 := by
    change w ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hw
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
      List.mem_range'_1] at hw
    rcases hw with ⟨i, hi, rfl⟩ | rfl | rfl | rfl <;>
      exact ⟨cell_base_ne _ _ (by omega), cell_base_ne _ _ (by omega), cell_base_ne _ _ (by omega),
        cell_base_ne _ _ (by omega), cell_base_ne _ _ (by omega)⟩
  have hrot_avoid (q : Wire) (hq : q ∉ BalancedCircuit.rawTarget cellLayout) :
      q ∉ ECDSAAdd.wires (rotateLeft (BalancedCircuit.rawTarget cellLayout)) := by
    rw [(rotate_wires _).2]; split_ifs
    · simp
    · simpa using hq
  have hcx_avoid (q : Wire) (hp : q ≠ base 768) (hr : q ≠ base 2056) :
      q ∉ ECDSAAdd.wires ([.CX cellLayout.parity cellLayout.r0] : ECDSAAdd.Program) := by
    intro hm
    simp only [cellLayout_parity, hr0, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hm
    rcases hm with rfl | rfl; exact hp rfl; exact hr rfl
  have hms_pres (t : ECDSAAdd.State) (r : List Bool) (ht : ∀ w ∈ cellLayout.carry.take 254, t.basis w = false)
      (q : Wire) (hq : q ∉ cellLayout.low) :
      (ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) r t).basis q = t.basis q := by
    have hnr : q ∉ ECDSAAdd.wires (Arithmetic.notRegister cellLayout.low) := by rw [notRegister_wires]; simpa using hq
    have hnr_ca (r' : List Bool) (w : Wire) (hw : w ∈ cellLayout.carry.take 254) :
        (ECDSAAdd.run (Arithmetic.notRegister cellLayout.low) r' t).basis w = false := by
      have hwl : w ∉ cellLayout.low := hca_not_low w (List.mem_of_mem_take hw)
      have hnw : w ∉ ECDSAAdd.wires (Arithmetic.notRegister cellLayout.low) := by rw [notRegister_wires]; simpa using hwl
      exact (ECDSAAdd.run_preserves_outside _ _ t w hnw).trans (ht w hw)
    simp only [mappedSub, ECDSAAdd.run_append]
    rw [ECDSAAdd.run_preserves_outside _ _ _ q hnr,
      cell_mappedAdd_pres _ _ (hnr_ca _) q hq,
      ECDSAAdd.run_preserves_outside _ _ _ q hnr]
  simp only [OneReuse.restoreRaw, OneReuse.unfoldWindow, ECDSAAdd.run_append]
  have hsA_par (r1 : List Bool) :
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
        .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st).basis (base 768) =
      st.basis (base 768) := by
    simp [ECDSAAdd.run, ECDSAAdd.writeBit, cellLayout_parity, cellLayout_lower, cellLayout_one, hrm,
      cell_base_ne 768 1797 (by omega), cell_base_ne 768 1027 (by omega)]
  have hsA_rm (r1 : List Bool) :
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
        .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st).basis (base 2311) =
      st.basis (base 2311) := by
    simp [ECDSAAdd.run, ECDSAAdd.writeBit, cellLayout_parity, cellLayout_lower, cellLayout_one, hrm,
      cell_base_ne 2311 1797 (by omega), cell_base_ne 2311 1027 (by omega)]
  have hsA_lo (r1 : List Bool) :
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
        .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st).basis (base 1797) =
      (st.basis (base 768) ^^ st.basis (base 2311)) := by
    simp [ECDSAAdd.run, ECDSAAdd.writeBit, cellLayout_parity, cellLayout_lower, cellLayout_one, hrm, hlo,
      cell_base_ne 1797 1027 (by omega), cell_base_ne 2311 1797 (by omega)]
  have hsA_ca (r1 : List Bool) (w : Wire) (hw : w ∈ cellLayout.carry) :
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
        .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st).basis w = false := by
    have hne := hca_ne w hw
    simp [ECDSAAdd.run, ECDSAAdd.writeBit, cellLayout_lower, cellLayout_one, hne.1, hne.2.1, hca w hw]
  have hsB_par (r1 r2 : List Bool) :
      (ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) r2
        (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
          .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st)).basis (base 768) =
      st.basis (base 768) :=
    (hms_pres _ r2 (fun u hu => hsA_ca r1 u (List.mem_of_mem_take hu)) _ (cell_not_low 768 (by omega))).trans (hsA_par r1)
  have hsB_rm (r1 r2 : List Bool) :
      (ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) r2
        (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
          .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st)).basis (base 2311) =
      st.basis (base 2311) :=
    (hms_pres _ r2 (fun u hu => hsA_ca r1 u (List.mem_of_mem_take hu)) _ (cell_not_low 2311 (by omega))).trans (hsA_rm r1)
  have hsB_lo (r1 r2 : List Bool) :
      (ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) r2
        (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
          .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st)).basis (base 1797) =
      (st.basis (base 768) ^^ st.basis (base 2311)) :=
    (hms_pres _ r2 (fun u hu => hsA_ca r1 u (List.mem_of_mem_take hu)) _ (cell_not_low 1797 (by omega))).trans (hsA_lo r1)
  have hsB_ca (r1 r2 : List Bool) (w : Wire) (hw : w ∈ cellLayout.carry) :
      (ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) r2
        (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
          .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st)).basis w = false :=
    (hms_pres _ r2 (fun u hu => hsA_ca r1 u (List.mem_of_mem_take hu)) w (hca_not_low w hw)).trans (hsA_ca r1 w hw)
  have htail_lo (r1 r2 r3 : List Bool) :
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.rmsb, .CX cellLayout.rmsb cellLayout.lower,
        .measureX cellLayout.one List.nil ([.CZ cellLayout.parity cellLayout.rmsb])] : ECDSAAdd.Program) r3
        (ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
          (cellLayout.carry.take 254) cellLayout.one) r2
          (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
            .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st))).basis (base 1797) = false := by
    have hpar := hsB_par r1 r2; have hrm' := hsB_rm r1 r2; have hlo' := hsB_lo r1 r2
    generalize ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
      (cellLayout.carry.take 254) cellLayout.one) r2
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
        .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st) = sB at hpar hrm' hlo' ⊢
    cases hr : r3.headD false <;>
      simp [ECDSAAdd.run, ECDSAAdd.measureAndCorrect, ECDSAAdd.correct_basis, ECDSAAdd.writeBit,
        cellLayout_parity, cellLayout_lower, cellLayout_one, hrm,
        cell_base_ne 1797 1027 (by omega), cell_base_ne 1797 2311 (by omega),
        hpar, hrm', hlo', hr]
  have htail_ca (r1 r2 r3 : List Bool) (w : Wire) (hw : w ∈ cellLayout.carry) :
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.rmsb, .CX cellLayout.rmsb cellLayout.lower,
        .measureX cellLayout.one List.nil ([.CZ cellLayout.parity cellLayout.rmsb])] : ECDSAAdd.Program) r3
        (ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
          (cellLayout.carry.take 254) cellLayout.one) r2
          (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
            .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st))).basis w = false := by
    have hne := hca_ne w hw; have hca' := hsB_ca r1 r2 w hw
    generalize ECDSAAdd.run (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
      (cellLayout.carry.take 254) cellLayout.one) r2
      (ECDSAAdd.run ([.CX cellLayout.parity cellLayout.lower, .CX cellLayout.rmsb cellLayout.lower,
        .CCX cellLayout.parity cellLayout.lower cellLayout.one] : ECDSAAdd.Program) r1 st) = sB at hca' ⊢
    cases hr : r3.headD false <;>
      simp [ECDSAAdd.run, ECDSAAdd.measureAndCorrect, ECDSAAdd.correct_basis, ECDSAAdd.writeBit,
        cellLayout_parity, cellLayout_lower, cellLayout_one, hrm,
        hne.1, hne.2.1, hne.2.2.2.2, hca', hr]
  refine ⟨?_, fun w hw => ?_⟩
  · rw [ECDSAAdd.run_preserves_outside _ _ _ _ (hcx_avoid _ (cell_base_ne 1797 768 (by omega)) (cell_base_ne 1797 2056 (by omega))),
      ECDSAAdd.run_preserves_outside _ _ _ _ (hrot_avoid _ (cell_not_rawTarget 1797 ⟨by omega, by omega⟩))]
    exact htail_lo _ _ _
  · have hne := hca_ne w hw
    rw [ECDSAAdd.run_preserves_outside _ _ _ _ (hcx_avoid w hne.2.2.1 hne.2.2.2.1),
      ECDSAAdd.run_preserves_outside _ _ _ _ (hrot_avoid w (fun hm => cell_rawTarget_disj_carry hm hw))]
    exact htail_ca _ _ _ w hw

