/-! ##### Support inclusions for cell sub-programs (⊆ `cellWires.toFinset`) -/

private theorem cell_fwd_parts_wires :
    ECDSAAdd.wires (OneReuse.remainder cellLayout) ⊆ cellWires.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) ⊆ cellWires.toFinset ∧
