section CellProofs

def cellWires : List Wire := base 2409 :: OneBankCell5.ids.map base

private theorem cell_mem_wires (q : Wire) (hq : q ∈ cellLayout.wires) : q ∈ cellWires :=
  (OneBankCell5.mem_ports_wires base (base 2409) q).mp hq

private theorem cell_sub_wires (r : List Wire) (hr : ∀ q ∈ r, q ∈ cellLayout.wires) : r ⊆ cellWires :=
  fun q hq => cell_mem_wires q (hr q hq)

private theorem cell_y_sub : cellLayout.y ⊆ cellWires :=
  cell_sub_wires _ (fun q hq => by
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.y,
      List.mem_append, List.mem_cons] at hq ⊢; tauto)

private theorem cell_r_sub : cellLayout.r ⊆ cellWires :=
  cell_sub_wires _ (fun q hq => by
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.mem_append, List.mem_cons] at hq ⊢; tauto)

private theorem cell_rawTarget_sub : BalancedCircuit.rawTarget cellLayout ⊆ cellWires := by
  intro q hq
  simp only [BalancedCircuit.rawTarget, List.mem_append, List.mem_singleton] at hq
  rcases hq with hq | rfl
  · exact cell_r_sub hq
  · exact cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires])

private theorem cell_source_sub : GuardCompression.source cellLayout ⊆ cellWires := by
  intro q hq
  simp only [GuardCompression.source, List.mem_append, List.mem_singleton] at hq
  rcases hq with hq | rfl
  · exact cell_y_sub hq
  · exact cell_y_sub (by simp [BalancedCleanup.Layout.y])

private theorem cell_carry_sub : cellLayout.carry ⊆ cellWires :=
  cell_sub_wires _ (fun q hq => by
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, List.mem_append, List.mem_cons]
    tauto)

private theorem cell_lower_mem : base 1797 ∈ cellWires :=
  cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, cellLayout_lower])

private theorem cell_one_mem : base 1027 ∈ cellWires :=
  cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, cellLayout_one])

private theorem cell_sign_mem : cellLayout.sign ∈ cellWires :=
  cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires])

private theorem cell_parity_mem : cellLayout.parity ∈ cellWires :=
  cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires])

private theorem cell_1541_mem : base 1541 ∈ cellWires := cell_carry_sub base_1541_mem_carry
private theorem cell_1026_mem : base 1026 ∈ cellWires := cell_carry_sub base_1026_mem_carry

private theorem wireBlock_getD (w : Nat → Wire) (a n i : Nat) (hi : i < n) :
    (wireBlock w a n).getD i 0 = w (a + i) := by
  have hl : i < (wireBlock w a n).length := by rw [wireBlock_length]; exact hi
  rw [List.getD_eq_getElem _ _ hl]
  simp only [wireBlock, List.getElem_map, List.getElem_range', one_mul]

private theorem cell_rtail_getD253 : cellLayout.rtail.getD 253 0 = base 2310 :=
  wireBlock_getD base 2057 254 253 (by omega)

private theorem cell_r_getD254 : cellLayout.r.getD 254 0 = base 2310 := by
  have hr : cellLayout.r = (base 2056 :: wireBlock base 2057 254) ++ [base 2311] := rfl
  have hl : 254 < (base 2056 :: wireBlock base 2057 254).length := by simp [wireBlock_length]
  rw [hr, List.getD_eq_getElem _ _ (by simp [wireBlock_length]), List.getElem_append_left hl]
  change (wireBlock base 2057 254)[253]'(by rw [wireBlock_length]; omega) = base 2310
  rw [← List.getD_eq_getElem _ 0]
  exact cell_rtail_getD253

private theorem cell_base_ne (a b : Nat) (h : a ≠ b) : base a ≠ base b :=
  fun e => h (MappedCompressed.base_injective e)

private theorem cell_not_r (k : Nat) (hk : k < 2056 ∨ 2312 ≤ k) : base k ∉ cellLayout.r := by
  intro hm
  simp only [cellLayout, OneBankCell5.ports, BalancedCleanup.Layout.r, BalancedCleanup.Layout.low,
    List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map, List.mem_range'_1] at hm
  rcases hm with (e | ⟨i, hi, e⟩) | e <;> (have := MappedCompressed.base_injective e; omega)

private theorem cell_not_low (k : Nat) (hk : k < 2056 ∨ 2311 ≤ k) : base k ∉ cellLayout.low := by
  intro hm
  simp only [cellLayout, OneBankCell5.ports, BalancedCleanup.Layout.low,
    List.mem_cons, wireBlock, List.mem_map, List.mem_range'_1] at hm
  rcases hm with e | ⟨i, hi, e⟩ <;> (have := MappedCompressed.base_injective e; omega)

private theorem cell_not_y (k : Nat) (hk : k < 770 ∨ 1026 ≤ k) : base k ∉ cellLayout.y := by
  intro hm
  simp only [cellLayout, OneBankCell5.ports, BalancedCleanup.Layout.y,
    List.mem_append, List.mem_singleton, wireBlock, List.mem_map, List.mem_range'_1] at hm
  rcases hm with ⟨i, hi, e⟩ | e <;> (have := MappedCompressed.base_injective e; omega)

private theorem cell_not_rawTarget (k : Nat) (hk : k ≠ 1027 ∧ (k < 2056 ∨ 2312 ≤ k)) :
    base k ∉ BalancedCircuit.rawTarget cellLayout := by
  intro hm
  simp only [BalancedCircuit.rawTarget, List.mem_append, List.mem_singleton, cellLayout_one] at hm
  rcases hm with h | h
  · exact cell_not_r k hk.2 h
  · exact hk.1 (MappedCompressed.base_injective h)

private theorem cell_not_carry (k : Nat) (hk : (k < 512 ∨ 765 ≤ k) ∧ k ≠ 1540 ∧ k ≠ 1541 ∧ k ≠ 1026) :
    base k ∉ cellLayout.carry := by
  intro hm
  change base k ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hm
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
    List.mem_range'_1] at hm
  rcases hm with ⟨i, hi, he⟩ | he | he | he
  · have := MappedCompressed.base_injective he; omega
  · exact hk.2.1 (MappedCompressed.base_injective he)
  · exact hk.2.2.1 (MappedCompressed.base_injective he)
  · exact hk.2.2.2 (MappedCompressed.base_injective he)

private theorem cell_seed_wires : ECDSAAdd.wires (GuardCompression.seed cellLayout) ⊆ cellWires.toFinset := by
  intro q hq
  simp only [GuardCompression.seed, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
    Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false, or_assoc] at hq
  apply List.mem_toFinset.mpr
  rcases hq with rfl | rfl | rfl | rfl | rfl | rfl
  · exact cell_r_sub (by simp [BalancedCleanup.Layout.r])
  · exact cell_one_mem
  · exact cell_y_sub (by
      change cellLayout.ylow.getD 0 0 ∈ cellLayout.ylow ++ [cellLayout.ymsb]
      apply List.mem_append_left
      have hl : 0 < cellLayout.ylow.length := by rw [cellLayout_widths.2.1]; decide
      rw [List.getD_eq_getElem _ _ hl]; exact List.getElem_mem hl)
  · exact cell_parity_mem
  · exact cell_r_sub (by simp [BalancedCleanup.Layout.r, BalancedCleanup.Layout.low])
  · exact cell_parity_mem

private theorem cell_seed_avoid (k : Nat) (hk : k ≠ 2311 ∧ k ≠ 1027 ∧ k ≠ 770 ∧ k ≠ 768 ∧ k ≠ 2056) :
    base k ∉ ECDSAAdd.wires (GuardCompression.seed cellLayout) := by
  intro hq
  have hy0 : cellLayout.ylow.getD 0 0 = base 770 := wireBlock_getD base 770 255 0 (by omega)
  have hr0 : cellLayout.r0 = base 2056 := rfl
  have hrm : cellLayout.rmsb = base 2311 := rfl
  simp only [GuardCompression.seed, hy0, hr0, hrm, cellLayout_one, cellLayout_parity,
    ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
    Finset.notMem_empty, or_false, or_assoc] at hq
  rcases hq with e | e | e | e | e | e <;>
    exact (by have := MappedCompressed.base_injective e; omega)

private theorem cell_signComp_y_wires :
    ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y) ⊆ cellWires.toFinset := by
  intro q hq
  have h := signComplement_wires_subset cellLayout.sign cellLayout.y hq
  simp only [List.mem_toFinset, List.mem_cons] at h ⊢
  rcases h with rfl | h
