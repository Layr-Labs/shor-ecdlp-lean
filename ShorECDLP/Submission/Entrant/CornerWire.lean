      (fun bs ⟨⟨_, _, h1542⟩, h718⟩ => ⟨h718, h1542⟩)
      (fun st m hv _ => let ho := segHS_out_clean divide st m hv.1; ⟨ho.2.1, ho.2.2⟩)
  have h12 := CatFn.seq_catLitSim _ _ (CatFn.swapSurround_indep _ _ _ (compiledSegHS_indep divide))
    kernelPre (SW.segHS divide) (fun bs => KernelInput bs ∧ bs (base 2400) = true) MidPred h1 hsw
    (fun st m ⟨⟨x, Y, hx0, hx, hin, hg0, hs0⟩, h24⟩ _ =>
