-- Slot bound for `compiledRow`
private theorem b_fblock_low_slots (b : WideBank8.Fast16.FBlock2 65536) (hb : b ∈ WideBank8.Row16.code)
    (q y : Wire) (s : Nat) :
    (CatFn.lower q y (WideBank8.Fast16.fblockProg b 0) s).prog.gateSlots ≤ 11000000000 := by
  have h1 := CatFn.lower_slots q y (WideBank8.Fast16.fblockProg b 0) s
  have h2 := b_fblock_slots b hb
  have h3 := b_fblock_add b hb
  have hsp_all : WideBank8.codeSP2 WideBank8.Fast16.bank15 (WideBank8.Fast16.fforget WideBank8.Row16.code) ≤ 2139852392 :=
    (congrArg (WideBank8.codeSP2 WideBank8.Fast16.bank15) WideBank8.Row16.forget).trans_le WideBank8.Row16.standard_slots
  have hsl_all : WideBank8.Fast16.fslack WideBank8.Row16.code = 335556282 := WideBank8.Row16.slack
  have htp_all : WideBank8.Fast16.fcodeTP WideBank8.Row16.code ≤ 2342691 :=
    (Nat.le_add_left _ _).trans WideBank8.Row16.body_credit_bound
  have hmem_le (xs : WideBank8.Fast16.FCode2 65536) (h : b ∈ xs) :
      WideBank8.codeSP2 WideBank8.Fast16.bank15 b.forgetL ≤ WideBank8.codeSP2 WideBank8.Fast16.bank15 (WideBank8.Fast16.fforget xs) ∧
      WideBank8.Fast16.fblockSlack b ≤ WideBank8.Fast16.fslack xs ∧
      WideBank8.Fast16.fblockTP b ≤ WideBank8.Fast16.fcodeTP xs := by
    induction xs with
    | nil => cases h
    | cons x xs ih =>
      rw [WideBank8.Fast16.fforget_cons, WideBank8.Fast16.codeSP2_append, b_fslack_cons, b_fcodeTP_cons]
      rcases List.mem_cons.mp h with rfl | h
      · exact ⟨Nat.le_add_right _ _, Nat.le_add_right _ _, Nat.le_add_right _ _⟩
      · obtain ⟨a, c, d⟩ := ih h
        exact ⟨a.trans (Nat.le_add_left _ _), c.trans (Nat.le_add_left _ _), d.trans (Nat.le_add_left _ _)⟩
  obtain ⟨hsp, hsl, htp⟩ := hmem_le WideBank8.Row16.code hb
  have h4 : WideBank8.codeSP2 WideBank8.Fast16.bank15 b.forgetL ≤ 2139852392 := hsp.trans hsp_all
  have h5 : WideBank8.Fast16.fblockSlack b ≤ 335556282 := hsl.trans (le_of_eq hsl_all)
  have h6 : WideBank8.Fast16.fblockTP b ≤ 2342691 := htp.trans htp_all
  rw [h3] at h1
  omega

