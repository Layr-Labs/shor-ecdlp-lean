private theorem cell_cmp_finish {n : Nat} (top : Bool) (start : Nat) :
    (compileCompareLt (n := n) top (base 1026) cellLayout.y cellLayout.r cellLayout.carry
      cellLayout.one cellLayout.parity start).finish =
      start + ECDSAAdd.measurementCount (cmpLtProg top cellLayout.y cellLayout.r cellLayout.carry
        cellLayout.one cellLayout.parity) := by
  rw [cell_y_cons, cell_r_cons, cell_carry_cons]
  exact compileCompareLt_finish top (base 1026) _ _ _ _ _ _ _ _ _ (by simp)

private theorem cell_cmp_tCount {n : Nat} (top : Bool) (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compileCompareLt (n := n) top (base 1026) cellLayout.y cellLayout.r cellLayout.carry
      cellLayout.one cellLayout.parity start).prog.instantiate read h).tCount =
      4 * ECDSAAdd.toffoliCount (cmpLtProg top cellLayout.y cellLayout.r cellLayout.carry
        cellLayout.one cellLayout.parity) := by
  rw [cell_y_cons, cell_r_cons, cell_carry_cons]
  exact compileCompareLt_tCount top (base 1026) _ _ _ _ _ _ _ _ _ (by simp) read h

private theorem cell_cmp_slots {n : Nat} (top : Bool) (start : Nat) :
    (compileCompareLt (n := n) top (base 1026) cellLayout.y cellLayout.r cellLayout.carry
      cellLayout.one cellLayout.parity start).prog.gateSlots ≤ 16000 := by
  rw [cell_y_cons, cell_r_cons, cell_carry_cons]
  have h := compileCompareLt_slots (n := n) top (base 1026)
    (base 770) (wireBlock base 771 254 ++ [base 1025])
    (base 2056) (wireBlock base 2057 254 ++ [base 2311])
    (base 512) (wireBlock base 513 252 ++ [base 1540, base 1541, base 1026])
    cellLayout.one cellLayout.parity start
  have hl : (base 2056 :: (wireBlock base 2057 254 ++ [base 2311])).length = 256 := by
    simp [wireBlock_length]
  rw [hl] at h; omega

private theorem cell_cmp_wires {n : Nat} (top : Bool) (start : Nat) :
    ChallengeMigration.straightWires (compileCompareLt (n := n) top (base 1026) cellLayout.y cellLayout.r cellLayout.carry
      cellLayout.one cellLayout.parity start).prog ⊆ cellWires := by
  have hy := cell_y_sub; have hr := cell_r_sub; have hc := cell_carry_sub
  rw [cell_y_cons] at hy ⊢; rw [cell_r_cons] at hr ⊢; rw [cell_carry_cons] at hc ⊢
  exact compileCompareLt_wires top (base 1026) _ _ _ _ _ _ _ _ _ cellWires
    cell_1026_mem cell_one_mem cell_parity_mem hy hr hc

private theorem cell_cmp_wellFormed {n : Nat} (top : Bool) (start : Nat) :
    (compileCompareLt (n := n) top (base 1026) cellLayout.y cellLayout.r cellLayout.carry
      cellLayout.one cellLayout.parity start).prog.WellFormed := by
  have hnd := cell_cmp_nd
  rw [cell_y_cons] at hnd ⊢; rw [cell_r_cons] at hnd ⊢; rw [cell_carry_cons] at hnd ⊢
  exact compileCompareLt_wellFormed top (base 1026) _ _ _ _ _ _ _ _ _ hnd (by simp)

private theorem cell_cmp_catLitSim {n : Nat} (top : Bool) (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim (base 1026)
      ((compileCompareLt (n := n) top (base 1026) cellLayout.y cellLayout.r cellLayout.carry
        cellLayout.one cellLayout.parity start).prog.instantiate read h)
      (cmpLtProg top cellLayout.y cellLayout.r cellLayout.carry cellLayout.one cellLayout.parity)
      (fun s => s (base 1027) = false ∧ ∀ w ∈ cellLayout.carry, s w = false) := by
  have hnd := cell_cmp_nd
  rw [cell_y_cons] at hnd ⊢; rw [cell_r_cons] at hnd ⊢; rw [cell_carry_cons] at hnd ⊢
  exact compileCompareLt_catLitSim top (base 1026) _ _ _ _ _ _ _ _ _ (by simp)
    (by simp [wireBlock_length]) (by simp [wireBlock_length]) hnd (by simp) read h

-- `ShiftFin` for the 4 cell kernels
theorem compiledForwardPrefix_shiftFin {n : Nat} :
    ShiftFin (compiledForwardPrefix (n := n))
      (ECDSAAdd.measurementCount (TopReuse.forwardPrefix cellLayout) +
        ECDSAAdd.toffoliCount (TopReuse.forwardPrefix cellLayout)) := by
  rw [compiledForwardPrefix]
  refine (CatFn.seq_shiftFin _ _ (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _) compiledRawAdd_shiftFin)
    (CatFn.compileProg_shiftFin _ _ _)).mono ?_
  simp only [TopReuse.forwardPrefix, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
  omega

theorem compiledCleanup_shiftFin {n : Nat} (isE : Bool) :
    ShiftFin (compiledCleanup (n := n) isE)
      (ECDSAAdd.measurementCount (if isE then TopReuse.cleanupE cellLayout else TopReuse.cleanup cellLayout) +
        ECDSAAdd.toffoliCount (if isE then TopReuse.cleanupE cellLayout else TopReuse.cleanup cellLayout)) := by
  rw [compiledCleanup]
  refine (CatFn.seq_shiftFin _ _ (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _)
    (ShiftFin.of_exact (cell_cmp_finish true) le_rfl)) (CatFn.compileProg_shiftFin _ _ _)).mono ?_
  cases isE <;>
  · simp only [TopReuse.cleanup, TopReuse.cleanupE, cmpLtProg, if_true, Bool.false_eq_true, if_false,
      ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
    omega

theorem compiledForward_shiftFin {n : Nat} :
    ShiftFin (compiledForward (n := n))
      (ECDSAAdd.measurementCount (TopReuse.forward cellLayout) + ECDSAAdd.toffoliCount (TopReuse.forward cellLayout)) := by
  rw [compiledForward]
  refine (CatFn.seq_shiftFin _ _ compiledForwardPrefix_shiftFin (compiledCleanup_shiftFin false)).mono ?_
  simp only [TopReuse.forward_split, Bool.false_eq_true, if_false, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
  omega

theorem compiledForwardE_shiftFin {n : Nat} :
    ShiftFin (compiledForwardE (n := n))
      (ECDSAAdd.measurementCount (TopReuse.forwardE cellLayout) + ECDSAAdd.toffoliCount (TopReuse.forwardE cellLayout)) := by
  rw [compiledForwardE]
  refine (CatFn.seq_shiftFin _ _ compiledForwardPrefix_shiftFin (compiledCleanup_shiftFin true)).mono ?_
  simp only [TopReuse.forwardE, if_true, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
  omega

theorem compiledZForward_shiftFin {n : Nat} :
    ShiftFin (compiledZForward (n := n))
      (ECDSAAdd.measurementCount (FirstZero5.forward cellLayout) + ECDSAAdd.toffoliCount (FirstZero5.forward cellLayout)) := by
  have hzp : FirstZero5.zPrefix cellLayout = TopReuse.forwardPrefix cellLayout := by
    simp [FirstZero5.zPrefix, TopReuse.forwardPrefix, List.append_assoc]
  rw [compiledZForward]
  refine (CatFn.seq_shiftFin _ _ compiledForwardPrefix_shiftFin (CatFn.compileProg_shiftFin _ _ _)).mono ?_
  simp only [FirstZero5.forward, hzp, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
  omega

theorem compiledInverse_shiftFin {n : Nat} :
    ShiftFin (compiledInverse (n := n))
      (ECDSAAdd.measurementCount (TopReuse.inverse cellLayout) + ECDSAAdd.toffoliCount (TopReuse.inverse cellLayout)) := by
  rw [compiledInverse]
  refine (CatFn.seq_shiftFin _ _
    (CatFn.seq_shiftFin _ _
      (CatFn.seq_shiftFin _ _
        (CatFn.seq_shiftFin _ _ (CatFn.compileProg_shiftFin _ _ _) (ShiftFin.of_exact (cell_cmp_finish false) le_rfl))
        (CatFn.compileProg_shiftFin _ _ _))
      compiledRawSub_shiftFin)
    (CatFn.noT_shiftFin _)).mono ?_
  simp only [TopReuse.inverse, BiasedInverse.recoverPrefix, cmpLtProg, Bool.false_eq_true, if_false,
    ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
