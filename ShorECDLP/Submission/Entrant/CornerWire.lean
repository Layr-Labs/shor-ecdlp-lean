private theorem map_avoid4_of_fix {f : Wire → Wire} (hinj : Function.Injective f)
    (h765 : f (base 765) = base 765) (h766 : f (base 766) = base 766)
    (h767 : f (base 767) = base 767) (h2312 : f (base 2312) = base 2312)
    {u : Wire} (hu : avoid4 u) : avoid4 (f u) :=
  ⟨fun e => hu.1 (hinj (e.trans h765.symm)),
   fun e => hu.2.1 (hinj (e.trans h766.symm)),
   fun e => hu.2.2.1 (hinj (e.trans h767.symm)),
   fun e => hu.2.2.2 (hinj (e.trans h2312.symm))⟩

private theorem catFn_map_mem {n : Nat} (f : Wire → Wire) (a : CatFn n) (s : Nat) {w : Wire}
    (hw : w ∈ ChallengeMigration.straightWires (CatFn.map f a s).prog) :
    ∃ u ∈ ChallengeMigration.straightWires (a s).prog, f u = w := by
  rw [CatFn.map, CatProg.map, mapStraight_wires] at hw
  exact List.mem_map.mp hw

private theorem catFn_seq_avoid4 {n : Nat} (a b : CatFn n)
    (ha : ∀ s w, w ∈ ChallengeMigration.straightWires (a s).prog → avoid4 w)
    (hb : ∀ s w, w ∈ ChallengeMigration.straightWires (b s).prog → avoid4 w)
    (s : Nat) (w : Wire) (hw : w ∈ ChallengeMigration.straightWires (CatFn.seq a b s).prog) : avoid4 w := by
  rw [CatFn.seq, CatProg.append, straightWires_append, List.mem_append] at hw
  rcases hw with h | h
  · exact ha s w h
  · exact hb _ w h

private theorem catFn_compileProg_avoid4 {n : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (hq : avoid4 q) (hy : avoid4 y) (hP : ∀ w ∈ ECDSAAdd.wires P, avoid4 w)
    (s : Nat) (w : Wire) (hw : w ∈ ChallengeMigration.straightWires (CatFn.compileProg (n := n) q y P s).prog) :
    avoid4 w := by
  have hsub := CatFn.compileProg_wires (n := n) q y P (S := q :: y :: (ECDSAAdd.wires P).toList)
    (fun u hu => List.mem_toFinset.mpr (by simp [hu])) List.mem_cons_self
    (List.mem_cons_of_mem _ List.mem_cons_self) s hw
  simp only [List.mem_cons, Finset.mem_toList] at hsub
  rcases hsub with rfl | rfl | h
  · exact hq
  · exact hy
  · exact hP w h

private theorem catFn_noT_avoid4 {n : Nat} (P : ECDSAAdd.Program)
    (hP : ∀ w ∈ ECDSAAdd.wires P, avoid4 w)
    (s : Nat) (w : Wire) (hw : w ∈ ChallengeMigration.straightWires (CatFn.noT (n := n) P s).prog) :
    avoid4 w := by
  have hsub := CatFn.noT_wires (n := n) P (S := (ECDSAAdd.wires P).toList) (by simp) s hw
  exact hP w (Finset.mem_toList.mp hsub)

private theorem catFn_swapSurround_avoid4 {n : Nat} (y₁ y₂ : Wire) (body : CatFn n)
    (h1 : avoid4 y₁) (h2 : avoid4 y₂)
    (hb : ∀ s w, w ∈ ChallengeMigration.straightWires (body s).prog → avoid4 w)
    (s : Nat) (w : Wire) (hw : w ∈ ChallengeMigration.straightWires (CatFn.swapSurround y₁ y₂ body s).prog) :
    avoid4 w := by
  rw [CatFn.swapSurround] at hw
  have hsw (a b : Wire) (ha : avoid4 a) (hb' : avoid4 b) (s' : Nat) (u : Wire)
      (hu : u ∈ ChallengeMigration.straightWires (CatFn.lit (n := n) (swapCircuit a b) s').prog) : avoid4 u := by
    have hm := swapCircuit_wires a b (by simpa [CatFn.lit, CatProg.lit_wires] using hu)
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl <;> assumption
  exact catFn_seq_avoid4 _ _ (catFn_seq_avoid4 _ _ (hsw y₁ y₂ h1 h2) hb) (hsw y₂ y₁ h2 h1) s w hw

private theorem history_codec_avoid4 (start : Nat) (hs : start + 5 ≤ 510)
    (P : ECDSAAdd.Program) (hP : P = History5.encode base start ∨ P = History5.decode base start) :
    ∀ w ∈ ECDSAAdd.wires P, avoid4 w := by
  intro w hw
  obtain ⟨r, rfl⟩ := History5.history_gate_mem base start P hP w hw
  have hb := History5.historyId_bound start (by omega) r
  have hne : History5.historyId start r ≠ 765 ∧ History5.historyId start r ≠ 766 ∧
      History5.historyId start r ≠ 767 ∧ History5.historyId start r ≠ 2312 := by
    have hr := r.isLt
    unfold History5.historyId; split <;> omega
  exact base_avoid4 _ hne

private theorem tapeLetter_avoid4 (k : Nat) (hk : k < 510) :
    avoid4 (MappedCompressed.tapeLetter k).1.1 ∧ avoid4 (MappedCompressed.tapeLetter k).1.2 := by
  have hlen1 : (skywalkSharedTape base).length = 512 := by simp [skywalkSharedTape]
  have hlen2 : mixedTranscriptUnitTrace.length = 512 := by decide
  have ht : (mixedTranscriptTape base).getD k ((0, 0), false, false) =
      ((base k, base (1028 + k)), mixedTranscriptUnitTrace[k]'(by omega)) := by
    rw [mixedTranscriptTape, List.getD_eq_getElem _ _ (by simp [List.length_zip, hlen1, hlen2]; omega),
      List.getElem_zip]
    simp [skywalkSharedTape]
  simp only [MappedCompressed.tapeLetter, ht]
  exact ⟨base_avoid4 k (by omega), base_avoid4 (1028 + k) (by omega)⟩

private theorem compiledRawReplay_avoid4 {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter)
    (hl : ∀ l ∈ ls, avoid4 l.1.1 ∧ avoid4 l.1.2) (s : Nat) (w : Wire)
    (hw : w ∈ ChallengeMigration.straightWires (compiledRawReplay (n := n) divide ls s).prog) : avoid4 w := by
  induction ls generalizing s w with
  | nil =>
    rw [compiledRawReplay] at hw
    exact catFn_noT_avoid4 [] (fun _ h => by simp [ECDSAAdd.wires] at h) s w hw
  | cons l ls ih =>
    rw [compiledRawReplay] at hw
    have h0 := hl l (by simp)
    have hrest : ∀ x ∈ ls, avoid4 x.1.1 ∧ avoid4 x.1.2 := fun x hx => hl x (List.mem_cons_of_mem _ hx)
    cases divide
    · exact catFn_seq_avoid4 _ _ (fun s' u hu => ih hrest s' u hu) (fun s' => compiledCell_avoid4 false l.1.1 l.1.2 h0.1 h0.2 s') s w hw
    · exact catFn_seq_avoid4 _ _ (fun s' => compiledCell_avoid4 true l.1.1 l.1.2 h0.1 h0.2 s') (fun s' u hu => ih hrest s' u hu) s w hw

theorem compiledKernelS_avoid4 {n : Nat} (divide : Bool) (s : Nat)
    (w : Wire) (hw : w ∈ ChallengeMigration.straightWires (compiledKernelS (n := n) divide s).prog) :
    w ≠ base 765 ∧ w ≠ base 766 ∧ w ≠ base 767 ∧ w ≠ base 2312 := by
  have hpi_fix (j : Nat) (hj : j < 102) (k : Nat) (hk : k = 765 ∨ k = 766 ∨ k = 767 ∨ k = 2312) :
      MappedCompressed.shifted (Placement5.pi j) (base k) = base k := by
    rw [MappedCompressed.shifted_base, Placement5.pi_outside j k hj]
    unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega
  have hpi0_fix (k : Nat) (hk : k = 765 ∨ k = 766 ∨ k = 767 ∨ k = 2312) :
      MappedCompressed.shifted Placement5.pi0 (base k) = base k := by
    rw [MappedCompressed.shifted_base, Placement5.pi0_outside k]
    unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega
  have hsig_fix (k : Nat) (hk : k = 765 ∨ k = 766 ∨ k = 767 ∨ k = 2312) :
      OB5.sig 511 (base k) = base k := by
    unfold OB5.sig; rcases hk with rfl | rfl | rfl | rfl <;> decide +kernel
  have hhost_fix (k : Nat) (hk : k = 765 ∨ k = 766 ∨ k = 767 ∨ k = 2312) :
      HostOB5.hostSwap (base k) = base k := by
    unfold HostOB5.hostSwap; rcases hk with rfl | rfl | rfl | rfl <;> decide +kernel
  have hpkt (j : Nat) (hj : j < 102) (s' : Nat) (u : Wire)
      (hu : u ∈ ChallengeMigration.straightWires (compiledPacket (n := n) divide j s').prog) : avoid4 u := by
    rw [compiledPacket] at hu
    obtain ⟨v, hv, rfl⟩ := catFn_map_mem _ _ s' hu
    refine map_avoid4_of_fix (MappedCompressed.shifted (Placement5.pi j)).injective
      (hpi_fix j hj 765 (by omega)) (hpi_fix j hj 766 (by omega))
      (hpi_fix j hj 767 (by omega)) (hpi_fix j hj 2312 (by omega)) ?_
    rw [compiledBasePacket] at hv
    have hl : ∀ l ∈ Replay5.letters j, avoid4 l.1.1 ∧ avoid4 l.1.2 := fun l hl => by
      obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hl; have := List.mem_range.mp hk
      exact tapeLetter_avoid4 (5 * j + k) (by omega)
    exact catFn_seq_avoid4 _ _
      (catFn_seq_avoid4 _ _
        (catFn_compileProg_avoid4 _ _ _ (base_avoid4 1541 (by omega)) (base_avoid4 1026 (by omega))
          (history_codec_avoid4 (5 * j) (by omega) _ (Or.inr rfl)))
        (compiledRawReplay_avoid4 divide _ hl))
      (catFn_compileProg_avoid4 _ _ _ (base_avoid4 1541 (by omega)) (base_avoid4 1026 (by omega))
        (history_codec_avoid4 (5 * j) (by omega) _ (Or.inl rfl))) s' v hv
  have hgrp (j m : Nat) (hb : j + m ≤ 102) : ∀ s' u,
      u ∈ ChallengeMigration.straightWires (compiledGroups (n := n) divide j m s').prog → avoid4 u := by
    induction m generalizing j with
    | zero =>
      intro s' u hu; rw [compiledGroups] at hu
      exact catFn_noT_avoid4 [] (fun _ h => by simp [ECDSAAdd.wires] at h) s' u hu
    | succ m ih =>
      intro s' u hu; rw [compiledGroups] at hu; cases divide
      · exact catFn_seq_avoid4 _ _ (ih (j + 1) (by omega)) (hpkt j (by omega)) s' u hu
      · exact catFn_seq_avoid4 _ _ (hpkt j (by omega)) (ih (j + 1) (by omega)) s' u hu
  have hfirst (s' : Nat) (u : Wire)
      (hu : u ∈ ChallengeMigration.straightWires (compiledFirstPacket (n := n) divide s').prog) : avoid4 u := by
    rw [compiledFirstPacket] at hu
    obtain ⟨v, hv, rfl⟩ := catFn_map_mem _ _ s' hu
    refine map_avoid4_of_fix (MappedCompressed.shifted (Placement5.pi 0)).injective
      (hpi_fix 0 (by omega) 765 (by omega)) (hpi_fix 0 (by omega) 766 (by omega))
      (hpi_fix 0 (by omega) 767 (by omega)) (hpi_fix 0 (by omega) 2312 (by omega)) ?_
    have hfb (s'' : Nat) (x : Wire)
        (hx : x ∈ ChallengeMigration.straightWires (compiledFirstBody (n := n) divide s'').prog) : avoid4 x := by
      rw [compiledFirstBody] at hx; cases divide
      · have hl : ∀ l ∈ Replay5.restLetters, avoid4 l.1.1 ∧ avoid4 l.1.2 := fun l hl => by
          obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hl; have := List.mem_range'_1.mp hk
          exact tapeLetter_avoid4 k (by omega)
        have hswm (s3 : Nat) (z : Wire)
            (hz : z ∈ ChallengeMigration.straightWires (compiledFirstSwapM (n := n) s3).prog) : avoid4 z := by
          rw [compiledFirstSwapM] at hz
          let S := base 1028 :: base 2410 :: cellWiresNo4
          have hS : ∀ q ∈ S, avoid4 q := fun q hq => by
            simp only [S, List.mem_cons] at hq
            rcases hq with rfl | rfl | hq
            · exact base_avoid4 1028 (by omega)
            · exact base_avoid4 2410 (by omega)
            · exact ((mem_cellWiresNo4 q).mp hq).2
          have hsub : ECDSAAdd.wires SW.swapBodyM ⊆ S.toFinset := by
            have heq : ECDSAAdd.wires SW.swapBodyM = ECDSAAdd.wires SW.swapBody := by
              change ECDSAAdd.wires (UncompSwap.mswap (base 2410) cellLayout.r cellLayout.y) = _
              exact UncompSwap.mswap_wires _ _ _
            rw [heq]; exact swapBody_wires_no4.trans (fun q hq => by
              simp only [S, List.mem_toFinset, List.mem_cons] at hq ⊢; exact Or.inr hq)
          exact hS z (compiledSelW_wires (base 1028) (base 2410) _ (by simp [S]) (by simp [S])
            (CatFn.noT_wires _ hsub) s3 hz)
        exact catFn_seq_avoid4 _ _ (compiledRawReplay_avoid4 false _ hl) hswm s'' x hx
      · have ht1 := tapeLetter_avoid4 1 (by omega)
        have htl : ∀ l ∈ OneBankReplay5.firstTailLetters, avoid4 l.1.1 ∧ avoid4 l.1.2 := fun l hl => by
          obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hl; have := List.mem_range'_1.mp hk
          exact tapeLetter_avoid4 k (by omega)
        have hsw (s3 : Nat) (z : Wire)
            (hz : z ∈ ChallengeMigration.straightWires (compiledFirstSwap (n := n) s3).prog) : avoid4 z := by
          rw [compiledFirstSwap] at hz
          let S := base 1028 :: base 2410 :: cellWiresNo4
          have hS : ∀ q ∈ S, avoid4 q := fun q hq => by
            simp only [S, List.mem_cons] at hq
            rcases hq with rfl | rfl | hq
            · exact base_avoid4 1028 (by omega)
            · exact base_avoid4 2410 (by omega)
            · exact ((mem_cellWiresNo4 q).mp hq).2
          exact hS z (compiledSelW_wires (base 1028) (base 2410) _ (by simp [S]) (by simp [S])
            (fun s4 => (compiledSwapBody_wires_no4 s4).trans (List.subset_cons_of_subset _ (List.Subset.refl _))) s3 hz)
        exact catFn_seq_avoid4 _ _ hsw
          (catFn_seq_avoid4 _ _ (compiledZCell_avoid4 _ _ ht1.1 ht1.2) (compiledRawReplay_avoid4 true _ htl)) s'' x hx
    rw [compiledBaseFirstPacket] at hv
    exact catFn_seq_avoid4 _ _
      (catFn_seq_avoid4 _ _
        (catFn_compileProg_avoid4 _ _ _ (base_avoid4 1541 (by omega)) (base_avoid4 1026 (by omega))
          (history_codec_avoid4 0 (by omega) _ (Or.inr rfl))) hfb)
      (catFn_compileProg_avoid4 _ _ _ (base_avoid4 1541 (by omega)) (base_avoid4 1026 (by omega))
        (history_codec_avoid4 0 (by omega) _ (Or.inl rfl))) s' v hv
  have hend (s' : Nat) (u : Wire)
      (hu : u ∈ ChallengeMigration.straightWires (compiledEndPacket (n := n) divide s').prog) : avoid4 u := by
    rw [compiledEndPacket] at hu
    obtain ⟨v, hv, rfl⟩ := catFn_map_mem _ _ s' hu
    refine map_avoid4_of_fix (MappedCompressed.shifted Placement5.pi0).injective
      (hpi0_fix 765 (by omega)) (hpi0_fix 766 (by omega))
      (hpi0_fix 767 (by omega)) (hpi0_fix 2312 (by omega)) ?_
    rw [compiledRawEnd] at hv
    let S := base 510 :: cellWiresNo4
    have hS : ∀ q ∈ S, avoid4 q := fun q hq => by
      simp only [S, List.mem_cons] at hq
      rcases hq with rfl | hq
      · exact base_avoid4 510 (by omega)
      · exact ((mem_cellWiresNo4 q).mp hq).2
    exact hS v (compiledSelW_wires (base 510) (base 2409) _ (by simp [S])
      (by simp [S, cell_base_no4_mem 2409 (Or.inl rfl)])
      (fun s'' => (compiledHalfE_wires_no4 divide s'').trans (List.subset_cons_of_subset _ (List.Subset.refl _))) s' hv)
  have hrep (s' : Nat) (u : Wire)
      (hu : u ∈ ChallengeMigration.straightWires (compiledReplayS (n := n) divide s').prog) : avoid4 u := by
    rw [compiledReplayS] at hu
    obtain ⟨v, hv, rfl⟩ := catFn_map_mem _ _ s' hu
    refine map_avoid4_of_fix (OB5.sig_injective 511 (by decide))
      (hsig_fix 765 (by omega)) (hsig_fix 766 (by omega))
      (hsig_fix 767 (by omega)) (hsig_fix 2312 (by omega)) ?_
    rw [compiledLogicalReplayS] at hv; cases divide
    · exact catFn_seq_avoid4 _ _ (catFn_seq_avoid4 _ _ hend (hgrp 1 101 (by decide))) hfirst s' v hv
    · exact catFn_seq_avoid4 _ _ (catFn_seq_avoid4 _ _ hfirst (hgrp 1 101 (by decide))) hend s' v hv
  have hce : ∀ q ∈ ECDSAAdd.wires OwnQ4Endpoint.centerT, avoid4 q := fun q hq =>
    ⟨fun e => OwnQ4Endpoint.prior_free765.1 (by subst e; exact hq),
     fun e => OwnQ4Endpoint.prior_free766.1 (by subst e; exact hq),
     fun e => OwnQ4Endpoint.plus_free.1 (by subst e; exact hq),
     fun e => OwnQ4Endpoint.parity_free.1 (by subst e; exact hq)⟩
  have hca : ∀ q ∈ ECDSAAdd.wires OwnQ4Endpoint.canonT, avoid4 q := fun q hq =>
    ⟨fun e => OwnQ4Endpoint.prior_free765.2 (by subst e; exact hq),
     fun e => OwnQ4Endpoint.prior_free766.2 (by subst e; exact hq),
     fun e => OwnQ4Endpoint.plus_free.2 (by subst e; exact hq),
     fun e => OwnQ4Endpoint.parity_free.2 (by subst e; exact hq)⟩
  have hcp : ∀ q ∈ ECDSAAdd.wires HalfFieldOB5.copyN, avoid4 q := fun q hq =>
    ⟨fun e => OwnGuardHost.copy_avoid (by subst e; exact hq),
     fun e => OwnPlusHost.copy_avoid (by subst e; exact hq),
     fun e => OwnMinusHost.copy_avoid (by subst e; exact hq),
     fun e => OwnParityHost.copy_avoid (by subst e; exact hq)⟩
  have hseg (s' : Nat) (u : Wire)
      (hu : u ∈ ChallengeMigration.straightWires (compiledSegmentS (n := n) divide s').prog) : avoid4 u := by
    rw [compiledSegmentS] at hu; cases divide
    · exact catFn_seq_avoid4 _ _
        (catFn_compileProg_avoid4 _ _ _ (base_avoid4 2409 (by omega)) (base_avoid4 2410 (by omega)) hce)
        (catFn_seq_avoid4 _ _ (catFn_noT_avoid4 _ hcp)
          (catFn_seq_avoid4 _ _
            (catFn_swapSurround_avoid4 _ _ _ (base_avoid4 2410 (by omega)) (base_avoid4 1026 (by omega)) hrep)
            (catFn_compileProg_avoid4 _ _ _ (base_avoid4 2409 (by omega)) (base_avoid4 2410 (by omega)) hca))) s' u hu
    · exact catFn_seq_avoid4 _ _
        (catFn_compileProg_avoid4 _ _ _ (base_avoid4 2409 (by omega)) (base_avoid4 2410 (by omega)) hce)
        (catFn_seq_avoid4 _ _
          (catFn_swapSurround_avoid4 _ _ _ (base_avoid4 2410 (by omega)) (base_avoid4 1026 (by omega)) hrep)
          (catFn_seq_avoid4 _ _ (catFn_noT_avoid4 _ hcp)
            (catFn_compileProg_avoid4 _ _ _ (base_avoid4 2409 (by omega)) (base_avoid4 2410 (by omega)) hca))) s' u hu
  have hsegH (s' : Nat) (u : Wire)
      (hu : u ∈ ChallengeMigration.straightWires (compiledSegHS (n := n) divide s').prog) : avoid4 u := by
    have hx511 : ∀ q ∈ ECDSAAdd.wires [.X (base 511)], avoid4 q := fun q hq => by
      simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_singleton,
        Finset.notMem_empty, or_false] at hq
      subst hq; exact base_avoid4 511 (by omega)
    rw [compiledSegHS] at hu
    exact catFn_seq_avoid4 _ _ (catFn_noT_avoid4 _ hx511)
      (catFn_seq_avoid4 _ _
        (fun s'' v hv => by
          obtain ⟨z, hz, rfl⟩ := catFn_map_mem _ _ s'' hv
          exact map_avoid4_of_fix HostOB5.hostSwap_injective
            (hhost_fix 765 (by omega)) (hhost_fix 766 (by omega))
            (hhost_fix 767 (by omega)) (hhost_fix 2312 (by omega)) (hseg s'' z hz))
        (catFn_noT_avoid4 _ hx511)) s' u hu
  have hk_eq : KernelOB5.program divide = (kernelPre ++ KernelOB5.segH divide) ++ kernelSuf := by
    simp only [KernelOB5.program, kernelPre, kernelSuf, List.append_assoc]
  have hpre_sub : ECDSAAdd.wires kernelPre ⊆ ECDSAAdd.wires (KernelOB5.program divide) := by
    rw [hk_eq, ECDSAAdd.wires_append, ECDSAAdd.wires_append]
    exact Finset.subset_union_left.trans Finset.subset_union_left
  have hsuf_sub : ECDSAAdd.wires kernelSuf ⊆ ECDSAAdd.wires (KernelOB5.program divide) := by
    rw [hk_eq, ECDSAAdd.wires_append]
    exact Finset.subset_union_right
  have hpre4 : ∀ q ∈ ECDSAAdd.wires kernelPre, avoid4 q :=
    prog_avoid4_of_sub hpre_sub (OwnGuardFinal.kernel_free divide) (OwnPlusFinal.kernel_free divide)
      (OwnMinusFinal.kernel_free divide) (OwnParityHost.kernel_parity_free divide)
  have hsuf4 : ∀ q ∈ ECDSAAdd.wires kernelSuf, avoid4 q :=
    prog_avoid4_of_sub hsuf_sub (OwnGuardFinal.kernel_free divide) (OwnPlusFinal.kernel_free divide)
      (OwnMinusFinal.kernel_free divide) (OwnParityHost.kernel_parity_free divide)
  rw [compiledKernelS] at hw
  exact catFn_seq_avoid4 _ _
    (catFn_seq_avoid4 _ _
      (catFn_compileProg_avoid4 _ _ _ (base_avoid4 717 (by omega)) (base_avoid4 718 (by omega)) hpre4)
      (catFn_swapSurround_avoid4 _ _ _ (base_avoid4 718 (by omega)) (base_avoid4 1542 (by omega)) hsegH))
    (catFn_compileProg_avoid4 _ _ _ (base_avoid4 717 (by omega)) (base_avoid4 718 (by omega)) hsuf4) s w hw

-- 7-wire hosting permutation (`hostPerm7`) and composed map `phiArith`
def hostPerm7 (w : Wire) : Wire :=
  if w = 15655 then 10015 else if w = 10015 then 15655
  else if w = 14879 then 836 else if w = 836 then 14879
  else if w = 14878 then 14114 else if w = 14114 then 14878
  else if w = 14877 then 14111 else if w = 14111 then 14877
  else if w = 14876 then 19816 else if w = 19816 then 14876
  else if w = 14875 then 838 else if w = 838 then 14875
  else if w = 14874 then 14112 else if w = 14112 then 14874
  else w

theorem hostPerm7_involutive : Function.Involutive hostPerm7 := by
  intro w; dsimp only [Wire] at w; unfold hostPerm7
  by_cases h1 : w = 15655; · simp [h1]
  by_cases h2 : w = 10015; · simp [h2]
  by_cases h3 : w = 14879; · simp [h3]
  by_cases h4 : w = 836; · simp [h4]
  by_cases h5 : w = 14878; · simp [h5]
  by_cases h6 : w = 14114; · simp [h6]
  by_cases h7 : w = 14877; · simp [h7]
  by_cases h8 : w = 14111; · simp [h8]
  by_cases h9 : w = 14876; · simp [h9]
  by_cases h10 : w = 19816; · simp [h10]
  by_cases h11 : w = 14875; · simp [h11]
  by_cases h12 : w = 838; · simp [h12]
  by_cases h13 : w = 14874; · simp [h13]
  by_cases h14 : w = 14112; · simp [h14]
  simp [h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14]

theorem hostPerm7_injective : Function.Injective hostPerm7 := hostPerm7_involutive.injective

private theorem hostPerm7_outside (u : Wire)
    (h1 : u ≠ 15655) (h2 : u ≠ 10015) (h3 : u ≠ 14879) (h4 : u ≠ 836)
    (h5 : u ≠ 14878) (h6 : u ≠ 14114) (h7 : u ≠ 14877) (h8 : u ≠ 14111)
    (h9 : u ≠ 14876) (h10 : u ≠ 19816) (h11 : u ≠ 14875) (h12 : u ≠ 838)
    (h13 : u ≠ 14874) (h14 : u ≠ 14112) : hostPerm7 u = u := by
  simp only [hostPerm7, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, ite_false]

private theorem hostPerm7_basis_eq (bs : BasisState)
    (h : ∀ u, (u = 15655 ∨ u = 10015 ∨ u = 14879 ∨ u = 836 ∨ u = 14878 ∨ u = 14114 ∨
      u = 14877 ∨ u = 14111 ∨ u = 14876 ∨ u = 19816 ∨ u = 14875 ∨ u = 838 ∨ u = 14874 ∨ u = 14112) →
      bs u = false) (w : Wire) : bs (hostPerm7 w) = bs w := by
  by_cases c1 : w = 15655; · rw [c1, show hostPerm7 15655 = 10015 by decide, h 10015 (by decide), h 15655 (by decide)]
  by_cases c2 : w = 10015; · rw [c2, show hostPerm7 10015 = 15655 by decide, h 15655 (by decide), h 10015 (by decide)]
  by_cases c3 : w = 14879; · rw [c3, show hostPerm7 14879 = 836 by decide, h 836 (by decide), h 14879 (by decide)]
  by_cases c4 : w = 836; · rw [c4, show hostPerm7 836 = 14879 by decide, h 14879 (by decide), h 836 (by decide)]
  by_cases c5 : w = 14878; · rw [c5, show hostPerm7 14878 = 14114 by decide, h 14114 (by decide), h 14878 (by decide)]
  by_cases c6 : w = 14114; · rw [c6, show hostPerm7 14114 = 14878 by decide, h 14878 (by decide), h 14114 (by decide)]
  by_cases c7 : w = 14877; · rw [c7, show hostPerm7 14877 = 14111 by decide, h 14111 (by decide), h 14877 (by decide)]
  by_cases c8 : w = 14111; · rw [c8, show hostPerm7 14111 = 14877 by decide, h 14877 (by decide), h 14111 (by decide)]
  by_cases c9 : w = 14876; · rw [c9, show hostPerm7 14876 = 19816 by decide, h 19816 (by decide), h 14876 (by decide)]
  by_cases c10 : w = 19816; · rw [c10, show hostPerm7 19816 = 14876 by decide, h 14876 (by decide), h 19816 (by decide)]
  by_cases c11 : w = 14875; · rw [c11, show hostPerm7 14875 = 838 by decide, h 838 (by decide), h 14875 (by decide)]
  by_cases c12 : w = 838; · rw [c12, show hostPerm7 838 = 14875 by decide, h 14875 (by decide), h 838 (by decide)]
  by_cases c13 : w = 14874; · rw [c13, show hostPerm7 14874 = 14112 by decide, h 14112 (by decide), h 14874 (by decide)]
  by_cases c14 : w = 14112; · rw [c14, show hostPerm7 14112 = 14874 by decide, h 14874 (by decide), h 14112 (by decide)]
  rw [hostPerm7_outside w c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14]

def phiArith (w : Wire) : Wire := hostPerm7 (wireFn2 streamLayout w)

theorem phiArith_base718 : phiArith (base 718) = 14833 := by
  have h1 : wireFn2 streamLayout (base 718) = streamLayout.core.poolWire 718 := rfl
  rw [phiArith, h1, streamPool_at 718 (by omega)]
  decide

theorem phiArith_inj_logical (a : Wire) (ha : a ∈ logicalNo2400)
    (b : Wire) (hb : b ∈ logicalNo2400) (heq : phiArith a = phiArith b) : a = b := by
  have h1 := hostPerm7_injective heq
  exact (placement2 streamLayout streamLayout_widths streamLayout_nodup).injectiveOnSlots a
    (ArithmeticOB5.logical_sub_old (Finset.mem_erase.mp ha).2) b
    (ArithmeticOB5.logical_sub_old (Finset.mem_erase.mp hb).2) h1

theorem phiArith_mem_support (w : Wire) (hw : w ∈ logicalNo2400)
    (h4 : w ≠ base 765 ∧ w ≠ base 766 ∧ w ≠ base 767 ∧ w ≠ base 2312) :
    phiArith w ∈ WideBank8.Fast16.Tight.support := by
  have hlog : w ∈ OB5Support.logicalSites := (Finset.mem_erase.mp hw).2
  have himg := OwnParityPhysical.wire_image streamLayout streamLayout_widths w
