    rw [OneBankCell5.halfE_true]
    exact CatFn.seq_catLitSim _ _ (CatFn.noT_indep _) _ ([.X (base 2409)]) CellClean (fun _ => True) h12
      (CatFn.noT_catLitSim (base 1026) _ x2409_avoid_1026) (fun _ _ _ _ => trivial) s read h

theorem compiledZHalf_catLitSim {n : Nat} (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledZHalf (n := n) s).prog.instantiate read h)
      (FirstZero5.half base (base 2409)) CellClean := by
  have h1 : ∀ (s' : Nat) (r' : ConstantBit n → Bool) (h' : Fin s' → Bool),
