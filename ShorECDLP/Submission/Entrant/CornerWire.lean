    (h : FieldFrameOB5.EncodedCanonicalFrame origin X Y ⟨false, s.basis⟩) :
    FieldFrameOB5.EncodedCanonicalFrame origin X Y s := by
  obtain ⟨raw, _, hp, he⟩ := h
