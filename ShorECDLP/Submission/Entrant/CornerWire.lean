theorem negXProg_run_flipped (X : ECDSAAdd.Fp) (hX0 : X ≠ 0) (st : ECDSAAdd.State) (m : List Bool)
    (hx : ECDSAAdd.regValue (List.range' 263 256) st.basis = X.val)
    (hcl : CleanOutsideXYBank st.basis) :
    (ECDSAAdd.run negXProg m ⟨st.phase, st.basis[15651 ↦ true]⟩).phase = st.phase ∧
    ECDSAAdd.regValue (List.range' 263 256) (ECDSAAdd.run negXProg m ⟨st.phase, st.basis[15651 ↦ true]⟩).basis = (-X).val ∧
    (∀ w, ¬(263 ≤ w ∧ w < 519) → (ECDSAAdd.run negXProg m ⟨st.phase, st.basis[15651 ↦ true]⟩).basis w = (st.basis[15651 ↦ true]) w) := by
  set st1 : ECDSAAdd.State := ⟨st.phase, st.basis[15651 ↦ true]⟩
  let t : ECDSAAdd.State := ECDSAAdd.pullState sqSwap st1
  have hren : ECDSAAdd.pullState sqSwap (ECDSAAdd.run negXProg m st1) = ECDSAAdd.run negXRefl m t := by
    rw [negXProg]; exact ECDSAAdd.run_rename sqSwap sqSwap.injective negXRefl m st1
  generalize ECDSAAdd.run negXProg m st1 = out at hren ⊢
  have hfix_x (w : Wire) (hw : 263 ≤ w ∧ w < 519) : sqSwap w = w :=
    Equiv.swap_apply_of_ne_of_ne (by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))
  have hfix_pool (w : Wire) (hw : 14115 ≤ w ∧ w < 14373) : sqSwap w = w :=
    Equiv.swap_apply_of_ne_of_ne (by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))
  have ht_clean : ∀ w ∈ negXCleanWires, t.basis w = false := by
    intro w hw
    simp only [negXCleanWires, List.mem_cons, List.not_mem_nil, or_false] at hw
    rw [pullState_basis]
    have hfp : sqSwap w = w := hfix_pool w (by rcases hw with rfl | rfl | rfl | rfl <;> decide)
    have hne51 : w ≠ 15651 := by rcases hw with rfl | rfl | rfl | rfl <;> decide
    have hclw : st.basis w = false := hcl w (by rcases hw with rfl | rfl | rfl | rfl <;> decide)
      (by rcases hw with rfl | rfl | rfl | rfl <;> decide)
      (by rcases hw with rfl | rfl | rfl | rfl <;> decide)
    rw [hfp]; simp [st1, upd, hne51, hclw]
  have ht_run := negXRefl_run t m ht_clean
  have hwl : negXLayout.word.length = 256 := streamLayout_widths.inputX
  have hwk : negXLayout.work.length = negXLayout.word.length := by
    simp [negXLayout, ControlledPointLayout.recoveryNegate, streamLayout.dialogPool_length streamLayout_widths, streamLayout_point_x_eq]
  have ht_x : ECDSAAdd.regValue negXLayout.word t.basis = X.val := by
    change ECDSAAdd.regValue streamLayout.point.x t.basis = X.val
    rw [streamLayout_point_x_eq, ← hx]
    apply ECDSAAdd.Arithmetic.regValue_congr
    intro w hw; rw [List.mem_range'_1] at hw
    rw [pullState_basis, hfix_x w hw]; simp [st1, upd, show w ≠ 15651 by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))]
  have ht_pool : ∀ w ∈ negXLayout.work ++ [negXLayout.cin, negXLayout.zero], t.basis w = false := by
    intro w hw
    change w ∈ streamLayout.recoveryNegate.work ++ [streamLayout.recoveryNegate.cin, streamLayout.recoveryNegate.zero] at hw
    rw [streamLayout.recoveryNegate_pool streamLayout_widths, Site1Fast.pool_take_eq 258 (by decide), List.mem_range'_1] at hw
    rw [pullState_basis, hfix_pool w hw]
    simp [st1, upd, show w ≠ 15651 by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)),
      hcl w (fun c => by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (fun c => by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))) (fun c => by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))]
  have hcorr := negXLayout.reflection_correct 14113
    (streamLayout.recoveryNegate_nodup streamLayout_widths streamLayout_nodup) hwk
    (by rw [hwl]; decide) (ECDSAAdd.p + 1) X.val
    (by rw [hwl]; norm_num [ECDSAAdd.p]) (by have := X.val_lt; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))
    t m ht_x ((ECDSAAdd.Arithmetic.regValue_zero _ _).mpr (fun w hw => ht_pool w (by simp [hw])))
    (ht_pool _ (by simp)) (ht_pool _ (by simp))
  rw [← ht_run] at hcorr
  have hout_at (w : Wire) : out.basis w = (ECDSAAdd.run negXRefl m t).basis (sqSwap w) := by
    have h1 := congrFun (congrArg ECDSAAdd.State.basis hren) (sqSwap w)
    rw [pullState_basis, sqSwap_self] at h1
    exact h1
  have hph : out.phase = st.phase := by
    have h1 := congrArg ECDSAAdd.State.phase hren
    rw [pullState_phase] at h1
    exact h1.trans (hcorr.1.trans (pullState_phase sqSwap st1))
  have hx_out : ECDSAAdd.regValue (List.range' 263 256) out.basis = (-X).val := by
    have heq : ECDSAAdd.regValue (List.range' 263 256) out.basis =
        ECDSAAdd.regValue negXLayout.word (ECDSAAdd.run negXRefl m t).basis := by
      change _ = ECDSAAdd.regValue streamLayout.point.x _
      rw [streamLayout_point_x_eq]
      apply ECDSAAdd.Arithmetic.regValue_congr
      intro w hw; rw [List.mem_range'_1] at hw; rw [hout_at w, hfix_x w hw]
    rw [heq, hcorr.2.1]
    have ht13 : t.basis 14113 = true := by
      rw [pullState_basis, sqSwap, Equiv.swap_apply_left]; simp [st1, upd]
    have hXpos : 0 < X.val := Nat.pos_of_ne_zero (fun h0 => hX0 ((ZMod.val_eq_zero X).mp h0))
    have hneg : (-X).val = ECDSAAdd.p - X.val := by rw [ZMod.neg_val, if_neg hX0]
    simp only [ht13, ↓reduceIte, hneg]; (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))
  have hfr : ∀ w, ¬(263 ≤ w ∧ w < 519) → out.basis w = st1.basis w := by
    intro w hw
    rw [hout_at w]
    have hnx : sqSwap w ∉ negXLayout.word := by
      change sqSwap w ∉ streamLayout.point.x
      rw [streamLayout_point_x_eq, List.mem_range'_1]
      intro hm; have hf := hfix_x (sqSwap w) hm; rw [sqSwap_self] at hf; exact hw (hf ▸ hm)
    rw [hcorr.2.2 (sqSwap w) hnx, pullState_basis, sqSwap_self]
  exact ⟨hph, hx_out, hfr⟩

private theorem compiledNegX_sim_aux {n : Nat} (P : ECDSAAdd.Program)
    (hav1 : (14832 : Wire) ∉ ECDSAAdd.wires P) (hav2 : (14833 : Wire) ∉ ECDSAAdd.wires P)
    (hph : ECDSAAdd.Arithmetic.GatePhysical P)
    (hrunP : ∀ (X : ECDSAAdd.Fp) (hX0 : X ≠ 0) (st : ECDSAAdd.State) (m : List Bool),
      ECDSAAdd.regValue (List.range' 263 256) st.basis = X.val →
      CleanOutsideXYBank st.basis →
      (ECDSAAdd.run P m ⟨st.phase, st.basis[15651 ↦ true]⟩).phase = st.phase ∧
      ECDSAAdd.regValue (List.range' 263 256) (ECDSAAdd.run P m ⟨st.phase, st.basis[15651 ↦ true]⟩).basis = (-X).val ∧
      (∀ w, ¬(263 ≤ w ∧ w < 519) → (ECDSAAdd.run P m ⟨st.phase, st.basis[15651 ↦ true]⟩).basis w = (st.basis[15651 ↦ true]) w))
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ∃ cs : List ℂ, List.Forall₂
      (fun b c =>
        ∀ (X : ECDSAAdd.Fp) (bs : BasisState), X ≠ 0 →
          ECDSAAdd.regValue (List.range' 263 256) bs = X.val →
          CleanOutsideXYBank bs →
          ∃ bs' : BasisState,
            ECDSAAdd.regValue (List.range' 263 256) bs' = (-X).val ∧
            (∀ w, ¬(263 ≤ w ∧ w < 519) → bs' w = bs w) ∧
            b.kraus (Prep 14833 (ket bs)) = c • Prep 14833 (ket bs'))
      ((CatFn.seq (CatFn.seq (CatFn.lit [.X 15651]) (CatFn.compileProg 14832 14833 P))
        (CatFn.lit [.X 15651]) s).prog.instantiate read h).run cs ∧ (cs.map Complex.normSq).sum = 1 := by
  obtain ⟨cs, al, hm⟩ := CatFn.compileProg_catLitSim (n := n) 14832 14833 P hav1 hav2 (by decide) hph s read h
  refine ⟨cs, ?_, hm⟩
  rw [b_catFn_surround_run ([.X 15651] : Circuit) ([.X 15651] : Circuit) _ s read h, List.forall₂_map_left_iff]
  refine al.imp (fun b c ⟨m, _, hb⟩ X bs hX0 hx hcl => ?_)
  have hrun := hrunP X hX0 ⟨false, bs⟩ m hx hcl
  have h51_in : bs 15651 = false := hcl 15651 (by decide) (by decide) (by decide)
  set out := ECDSAAdd.run P m ⟨false, bs[15651 ↦ true]⟩
  have h32_1 : (⟨false, bs[15651 ↦ true]⟩ : ECDSAAdd.State).basis 14832 = false := by
    simp [upd, hcl 14832 (by decide) (by decide) (by decide)]
  have h33_1 : (⟨false, bs[15651 ↦ true]⟩ : ECDSAAdd.State).basis 14833 = false := by
    simp [upd, hcl 14833 (by decide) (by decide) (by decide)]
  have hb_st : b.kraus (Prep 14833 (Bridge.signedKet ⟨false, bs[15651 ↦ true]⟩)) =
      c • Prep 14833 (Bridge.signedKet out) := hb ⟨false, bs[15651 ↦ true]⟩ ⟨h32_1, h33_1⟩
  have h51_out : out.basis 15651 = true := (hrun.2.2 15651 (by decide)).trans (by simp [upd])
  have hx1 : Quantum.run [.X 15651] (Prep 14833 (ket bs)) =
      Prep 14833 (Bridge.signedKet ⟨false, bs[15651 ↦ true]⟩) := by
    rw [prep_circuit 14833 ([.X 15651] : Circuit) (by decide), Bridge.signedKet_false,
      Quantum.run_singleton, applyGate_X_ket, h51_in]; rfl
  have hoph : Bridge.signedKet out = ket out.basis := signedKet_eq_ket_of_phase out out.basis hrun.1 rfl
  have hx2 : Quantum.run [.X 15651] (Prep 14833 (Bridge.signedKet out)) =
      Prep 14833 (ket (out.basis[15651 ↦ false])) := by
    rw [hoph, prep_circuit 14833 ([.X 15651] : Circuit) (by decide),
      Quantum.run_singleton, applyGate_X_ket, h51_out]; rfl
  refine ⟨out.basis[15651 ↦ false], ?_, ?_, ?_⟩
  · refine (ECDSAAdd.Arithmetic.regValue_congr (List.range' 263 256) _ out.basis (fun w hw => ?_)).trans hrun.2.1
    rw [List.mem_range'_1] at hw; simp [upd, show w ≠ 15651 by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))]
  · intro w hw
    by_cases h51 : w = 15651
    · subst h51; simp [upd, h51_in]
    · simp [upd, h51, hrun.2.2 w hw]
  · dsimp only
    rw [LinearMap.comp_apply, LinearMap.comp_apply, hx1, hb_st, map_smul, hx2]

theorem compiledNegX_sim {n : Nat} (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ∃ cs : List ℂ, List.Forall₂
      (fun b c =>
        ∀ (X : ECDSAAdd.Fp) (bs : BasisState), X ≠ 0 →
          ECDSAAdd.regValue (List.range' 263 256) bs = X.val →
          CleanOutsideXYBank bs →
          ∃ bs' : BasisState,
            ECDSAAdd.regValue (List.range' 263 256) bs' = (-X).val ∧
            (∀ w, ¬(263 ≤ w ∧ w < 519) → bs' w = bs w) ∧
            b.kraus (Prep 14833 (ket bs)) = c • Prep 14833 (ket bs'))
      ((compiledNegX (n := n) s).prog.instantiate read h).run cs ∧ (cs.map Complex.normSq).sum = 1 := by
  rw [compiledNegX]
  exact compiledNegX_sim_aux negXProg negXProg_avoid_14832_14833.1 negXProg_avoid_14832_14833.2
    negXProg_physical negXProg_run_flipped s read h


/-! #### 7. Polymorphic SelectSwap table loaders (`ss1NegW`, `ss2TripleW`, `ss1RecW`), `wrapSS`, and `FixupSpec` -/

def ports1W (k : Nat) : List (LookupPort (2 ^ k)) :=
  wordPorts (rowsW k) .negX cxWord ++ wordPorts (rowsW k) .negY cyWord

def ports4W (k : Nat) : List (LookupPort (2 ^ k)) :=
  wordPorts (rowsW k) .tripleX cxWord

def ports6W (k : Nat) : List (LookupPort (2 ^ k)) :=
  wordPorts (rowsW k) .x cxWord ++ wordPorts (rowsW k) .negY cyWord

def ss1NegW (k : Nat) : SS1 (2 ^ k) where
  bits := bitsW k
  paths := pathBankW k
  selBits := selBits1W k
  selPaths := selPaths1W k
  guard := guardWire
  ports := ports1W k
  g1 := g1_1

def ss2TripleW (k : Nat) : SS2 (2 ^ k) where
  bits := bitsW k
  paths := pathBankW k
  selBits := selBits2W k
  selPaths := selPaths2W k
  guard := guardWire
  ports := ports4W k
  g1 := g4_1
  g2 := g4_2
  g3 := g4_3

def ss1RecW (k : Nat) : SS1 (2 ^ k) where
  bits := bitsW k
  paths := pathBankW k
  selBits := selBits1W k
  selPaths := selPaths1W k
  guard := guardWire
  ports := ports6W k
  g1 := g1_1

theorem wordPorts_targets {n : Nat} (rows : Nat → Fin n) (f : PointField) (ws : List Wire) :
    portTargets (wordPorts rows f ws) = ws := by
  have h (k : Nat) (l : List Wire) (hl : l.length = k) :
      ((List.range k).zipWith (fun i w => (⟨fun a => ECDSAAdd.ShorPort.bitRef (rows a) f i, true, w⟩ : LookupPort n)) l).map
        LookupPort.target = l := by
    have h1 : ∀ (xs : List Nat) (ys : List Wire), xs.length = ys.length →
        (xs.zipWith (fun i w => (⟨fun a => ECDSAAdd.ShorPort.bitRef (rows a) f i, true, w⟩ : LookupPort n)) ys).map
          LookupPort.target = ys := by
      intro xs; induction xs with
      | nil => intro ys h; cases ys with | nil => rfl | cons _ _ => simp at h
      | cons x xs ih => intro ys h; cases ys with | nil => simp at h | cons y ys => simp [ih ys (by simpa using h)]
    exact h1 (List.range k) l (by simp [hl])
  exact h ws.length ws rfl

theorem ports1W_targets (k : Nat) : portTargets (ports1W k) = cxWord ++ cyWord := by
  simp only [ports1W, portTargets, List.map_append]; exact congrArg₂ (· ++ ·) (wordPorts_targets _ _ _) (wordPorts_targets _ _ _)

theorem ports4W_targets (k : Nat) : portTargets (ports4W k) = cxWord := wordPorts_targets _ _ _

theorem ports6W_targets (k : Nat) : portTargets (ports6W k) = cxWord ++ cyWord := by
  simp only [ports6W, portTargets, List.map_append]; exact congrArg₂ (· ++ ·) (wordPorts_targets _ _ _) (wordPorts_targets _ _ _)

theorem ports1W_length (k : Nat) : (ports1W k).length = 512 := by
  have h := congrArg List.length (ports1W_targets k)
  simp only [portTargets, List.length_map, List.length_append, cxWord_length, cyWord_length] at h; exact h

theorem ports4W_length (k : Nat) : (ports4W k).length = 256 := by
  have h := congrArg List.length (ports4W_targets k)
  simp only [portTargets, List.length_map, cxWord_length] at h; exact h

theorem ports6W_length (k : Nat) : (ports6W k).length = 512 := by
  have h := congrArg List.length (ports6W_targets k)
  simp only [portTargets, List.length_map, List.length_append, cxWord_length, cyWord_length] at h; exact h

theorem cxWord_nodup : cxWord.Nodup := List.nodup_range'
theorem cyWord_nodup : cyWord.Nodup := List.nodup_cons.mpr ⟨by simp [List.mem_range'_1], List.nodup_range'⟩

theorem cxCy_nodup : (cxWord ++ cyWord).Nodup := by
  rw [List.nodup_append]
  refine ⟨cxWord_nodup, cyWord_nodup, fun a ha b hb he => ?_⟩
  subst he; simp only [cxWord, cyWord, List.mem_cons, List.mem_range'_1] at ha hb
  rcases hb with rfl | hb <;> (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

theorem g1_1_nodup : g1_1.Nodup := range'_nodup_disj 14115 256 14884 256 (by decide)

theorem g4_nodup : g4.Nodup := by
  rw [g4, List.nodup_append]
  refine ⟨range'_nodup_disj 14115 256 14884 256 (by decide), List.nodup_range', fun a ha b hb he => ?_⟩
  subst he; simp only [g4_1, g4_2, g4_3, List.mem_append, List.mem_range'_1] at ha hb
  rcases ha with ha | ha <;> (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

theorem ss1_regs_nodup : (cxWord ++ cyWord ++ g1_1).Nodup := by
  rw [List.nodup_append]
  refine ⟨cxCy_nodup, g1_1_nodup, fun a ha b hb he => ?_⟩
  subst he; simp only [cxWord, cyWord, g1_1, List.mem_append, List.mem_cons, List.mem_range'_1, or_assoc] at ha hb
  rcases ha with ha | rfl | ha <;> rcases hb with hb | hb <;> (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

theorem ss2_regs_nodup : (cxWord ++ g4).Nodup := by
  rw [List.nodup_append]
  refine ⟨cxWord_nodup, g4_nodup, fun a ha b hb he => ?_⟩
  subst he; simp only [cxWord, g4, g4_1, g4_2, g4_3, List.mem_append, List.mem_range'_1, or_assoc] at ha hb
  rcases hb with hb | hb | hb <;> (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

private theorem range'_bitsW_1 {k : Nat} (hk : 16 ≤ k) : bitsW k = 855 :: selBits1W k := by
  unfold bitsW selBits1W
  cases k with
  | zero => (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))
  | succ m => simp [List.range'_succ]

private theorem range'_bitsW_2 {k : Nat} (hk : 16 ≤ k) : bitsW k = 855 :: 856 :: selBits2W k := by
  unfold bitsW selBits2W
  match k, hk with
  | m + 2, _ => simp [List.range'_succ]

private theorem ss1_selNodup (k : Nat) (hk_hi : k ≤ 18) :
    (guardWire :: selBits1W k ++ selPaths1W k).Nodup := by
  have h1 : (selBits1W k ++ selPaths1W k).Nodup :=
    range'_nodup_disj 856 (k - 1) 14834 (k - 1) (by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))
  change (guardWire :: (selBits1W k ++ selPaths1W k)).Nodup
  refine List.nodup_cons.mpr ⟨fun hm => ?_, h1⟩
  simp only [guardWire, selBits1W, selPaths1W, List.mem_append, List.mem_range'_1] at hm
  rcases hm with h | h <;> (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

private theorem ss2_selNodup (k : Nat) (hk_hi : k ≤ 18) :
    (guardWire :: selBits2W k ++ selPaths2W k).Nodup := by
  have h1 : (selBits2W k ++ selPaths2W k).Nodup :=
    range'_nodup_disj 857 (k - 2) 14834 (k - 2) (by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))
  change (guardWire :: (selBits2W k ++ selPaths2W k)).Nodup
  refine List.nodup_cons.mpr ⟨fun hm => ?_, h1⟩
  simp only [guardWire, selBits2W, selPaths2W, List.mem_append, List.mem_range'_1] at hm
  rcases hm with h | h <;> (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

theorem ss1NegW_geo {k : Nat} (hk_lo : 16 ≤ k) (hk_hi : k ≤ 18) : (ss1NegW k).Geo where
  bitsEq := range'_bitsW_1 hk_lo
  pathsSub := fun _ h => h
  selLen := by simp [ss1NegW, selBits1W, selPaths1W]
  selNodup := ss1_selNodup k hk_hi
  selDisj := by
    rw [List.disjoint_left]; intro w hw hm
    change w ∈ portTargets (ports1W k) ++ g1_1 at hm
    rw [ports1W_targets] at hm
    simp only [ss1NegW, windowRoot, guardWire, selBits1W, selPaths1W, List.mem_cons, List.mem_append, List.mem_range'_1,
      or_assoc] at hw
    simp only [cxWord, cyWord, g1_1, List.mem_append, List.mem_cons, List.mem_range'_1, or_assoc] at hm
    rcases hw with hw | hw | hw | hw <;> rcases hm with hm | hm | hm | hm | hm <;> (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))
  len1 := by change g1_1.length = (ports1W k).length; rw [g1_1_length, ports1W_length]
  nodup := by change (portTargets (ports1W k) ++ g1_1).Nodup; rw [ports1W_targets]; exact ss1_regs_nodup
  n855 := fun hm => by
    change (855 : Wire) ∈ portTargets (ports1W k) ++ g1_1 at hm; rw [ports1W_targets] at hm
    simp only [cxWord, cyWord, g1_1, List.mem_append, List.mem_cons, List.mem_range'_1] at hm
    norm_num at hm

theorem ss1RecW_geo {k : Nat} (hk_lo : 16 ≤ k) (hk_hi : k ≤ 18) : (ss1RecW k).Geo where
  bitsEq := range'_bitsW_1 hk_lo
  pathsSub := fun _ h => h
  selLen := by simp [ss1RecW, selBits1W, selPaths1W]
  selNodup := ss1_selNodup k hk_hi
  selDisj := by
