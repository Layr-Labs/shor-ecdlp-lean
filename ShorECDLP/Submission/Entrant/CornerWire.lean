private theorem nodup5_from_readonly (y a b cin c : Wire) (xs ys cs : List Wire)
    (hnd : (y :: cin :: (b :: ys ++ c :: cs)).Nodup)
    (hdis : List.Disjoint (a :: xs) (y :: cin :: (b :: ys ++ c :: cs))) :
    [y, a, b, cin, c].Nodup := by
  have ha : a ∉ y :: cin :: (b :: ys ++ c :: cs) := hdis List.mem_cons_self
  have hc := List.nodup_iff_count.mp hnd
  have hybc : [y, b, cin, c].Nodup := by
    apply List.nodup_iff_count.mpr; intro w; have := hc w
    simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
  have ha' : a ∉ [y, b, cin, c] := fun h => ha (by simp only [List.mem_cons, List.mem_append, List.not_mem_nil, or_false] at h ⊢; tauto)
  apply List.nodup_iff_count.mpr; intro w
  have h1 := List.nodup_iff_count.mp hybc w
  by_cases hw : w = a
  · subst hw
    have h0 : List.count w ([y, b, cin, c]) = 0 := List.count_eq_zero.mpr ha'
    simp only [List.count_cons, List.count_nil, beq_self_eq_true, ↓reduceIte] at h0 ⊢; omega
  · simp only [List.count_cons, List.count_nil, beq_iff_eq, Ne.symm hw, ↓reduceIte] at h1 ⊢; omega

private theorem eraseCarry_phys_of (a b cin c : Wire) (_hnd : [a, b, cin, c].Nodup) :
    ECDSAAdd.Arithmetic.GatePhysical (eraseCarry a b cin c) :=
  eraseCarry_physical a b cin c

theorem compileAddInPlace_wellFormed {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat),
      (y :: cin :: (ys ++ carry)).Nodup →
      List.Disjoint x (y :: cin :: (ys ++ carry)) →
      (compileAddInPlace (n := n) y x ys carry cin start).prog.WellFormed
  | a :: a' :: as, b :: b' :: bs, c :: cs, cin, start, hnd, hdis => by
      have h5 := nodup5_from_readonly y a b cin c (a' :: as) (b' :: bs) cs hnd hdis
      have h4 : [a, b, cin, c].Nodup := (List.nodup_cons.mp h5).2
      have h4' := h4
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
        or_false, not_or, not_false_eq_true, and_true] at h4'
      have hnd' : (y :: c :: ((b' :: bs) ++ cs)).Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := List.nodup_iff_count.mp hnd w
        simp only [List.count_cons, List.count_append] at this ⊢; omega
      have hdis' : List.Disjoint (a' :: as) (y :: c :: ((b' :: bs) ++ cs)) := by
        intro w hw1 hw2
        exact hdis (List.mem_cons_of_mem _ hw1)
          (by simp only [List.mem_cons, List.mem_append] at hw2 ⊢; tauto)
      simp only [compileAddInPlace, CatProg.append]
      exact straight_append_wellFormed _ _
        (straight_append_wellFormed _ _
          (straight_append_wellFormed _ _
            (CatProg.lit_wellFormed _ (majorityCat_wellFormed y a b cin c h5))
            (compileAddInPlace_wellFormed y (a' :: as) (b' :: bs) cs c _ hnd' hdis'))
          (CatProg.noT_wellFormed _ (eraseCarry_phys_of a b cin c h4)))
        (CatProg.lit_wellFormed _ (by simp [CircuitWellFormed, Gate.WellFormed, h4'.1.1, Ne.symm h4'.2.1.1]))
  | [a], [b], _, cin, start, hnd, hdis => by
      have hab : a ≠ b := fun e => hdis List.mem_cons_self (by simp [e])
      have hcb : cin ≠ b := fun e => by
        have h := List.nodup_iff_count.mp hnd b; subst e
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      exact CatProg.lit_wellFormed _ (by simp [CircuitWellFormed, Gate.WellFormed, hab, hcb])
  | [], _, _, _, _, _, _ | [_], [], _, _, _, _, _ | [_], _ :: _ :: _, _, _, _, _, _
  | [_, _], [], _, _, _, _, _ | [_, _], [_], _, _, _, _, _ | [_, _], _ :: _ :: _, [], _, _, _, _
  | _ :: _ :: _ :: _, [], _, _, _, _, _ | _ :: _ :: _ :: _, [_], _, _, _, _, _
  | _ :: _ :: _ :: _, _ :: _ :: _, [], _, _, _, _ => CatProg.lit_wellFormed _ (by simp [CircuitWellFormed])

