private theorem placedField_at_2409_2410 (origin : BasisState) (ctx : OneBankReplay5.Context origin)
    (X Y : Fp) (s : ECDSAAdd.State) (h : FieldFrameOB5.EncodedFieldFrame origin X Y s) :
    s.basis (base 2409) = false ∧ s.basis (base 2410) = false := by
  obtain ⟨raw, _, hpair, heq⟩ := h
  have hfn (k : Nat) (hk : k = 2409 ∨ k = 2410) : s.basis (base k) = origin (base k) := by
    have hsig : OB5.sig 511 (base k) = base k := by rcases hk with rfl | rfl <;> decide +kernel
    have hnot : base k ∉ ECDSAAdd.wires (History5.allEncode base 102) := by
      intro hm; have hs := History5.allEncode_history_support base 102 (by omega) hm
      simp only [List.mem_toFinset, List.mem_append, wireBlock, List.mem_map, List.mem_range'_1,
        MappedCompressed.base_injective.eq_iff] at hs; omega
    have hpull : (ECDSAAdd.pullState (OB5.sig 511) s).basis (base k) = origin (base k) := by
      rw [heq]
      exact (ECDSAAdd.run_preserves_outside _ List.nil raw _ hnot).trans
        (hpair.2.2 _ (cell_base_not_r k (by omega)) (cell_base_not_y k (by omega)))
    simpa only [ECDSAAdd.pullState, hsig] using hpull
  exact ⟨(hfn 2409 (Or.inl rfl)).trans ctx.hg0, (hfn 2410 (Or.inr rfl)).trans ctx.hs0⟩

private theorem placedCanonical_at_2409_2410 (origin : BasisState) (ctx : OneBankReplay5.Context origin)
    (ha : ECDSAAdd.regValue (skywalkSharedField base).a origin = 0)
    (X : Fp) (s : ECDSAAdd.State) (h : FieldFrameOB5.EncodedCanonicalFrame origin X 0 s) :
    s.basis (base 2409) = false ∧ s.basis (base 2410) = false := by
  have inF := HalfField5.encodedCanonical_caller_frame5 ctx.hn origin ha X _ h
  have zAway (i : Nat) (hi : i = 2409 ∨ i = 2410) : base i ∉ (skywalkSharedField base).z := by
    intro hm
    rw [show (skywalkSharedField base).z = wireBlock base 2056 257 from skywalkShared_field_z base] at hm
    obtain ⟨j, hj, he⟩ := List.mem_map.mp hm
    have := MappedCompressed.base_injective he; simp only [List.mem_range'_1] at hj; omega
  have hsig9 : OB5.sig 511 (base 2409) = base 2409 := by decide +kernel
  have hsig10 : OB5.sig 511 (base 2410) = base 2410 := by decide +kernel
  have h9 := inF.2 (base 2409) (zAway 2409 (Or.inl rfl)) (ctx.hp _ (by simp))
  have h10 := inF.2 (base 2410) (zAway 2410 (Or.inr rfl)) (ctx.hp _ (by simp))
  change s.basis (OB5.sig 511 (base 2409)) = _ at h9
  change s.basis (OB5.sig 511 (base 2410)) = _ at h10
  rw [hsig9] at h9; rw [hsig10] at h10
  exact ⟨h9.trans ctx.hg0, h10.trans ctx.hs0⟩

private def AnySegInput (bs : BasisState) : Prop :=
  ∃ (origin : BasisState) (_ : OneBankReplay5.Context origin) (x : Nat) (Y : Fp),
    0 < x ∧ x < p ∧
    ECDSAAdd.regValue (skywalkSharedField base).a origin = 0 ∧
    skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int) (p : Int)) ∧
    bs (base 2400) = true ∧ FieldFrameOB5.EncodedCanonicalFrame origin Y 0 ⟨false, bs⟩

private def AnySegMid0 (bs : BasisState) : Prop :=
  ∃ (origin : BasisState) (_ : OneBankReplay5.Context origin) (x : Nat) (Y : Fp),
    0 < x ∧ x < p ∧
    skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int) (p : Int)) ∧
    bs (base 2400) = true ∧ FieldFrameOB5.EncodedFieldFrame origin Y 0 ⟨false, bs⟩

private def AnySegMidEq (bs : BasisState) : Prop :=
