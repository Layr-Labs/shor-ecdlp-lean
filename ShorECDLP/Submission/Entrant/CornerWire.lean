    catLitSim_weaken (CatFn.compileProg_catLitSim (base 717) (base 718) kernelPre ha7.1 ha8.1
      (base_ne 717 718 (by omega)) hkph.1.1 s' r' h')
      (fun bs ⟨⟨x, Y, _, _, hin, _, _⟩, _⟩ => skywalkInput_at_717_718 x Y.val bs hin)
  have hsw : ∀ (s' : Nat) (r' : ConstantBit n → Bool) (h' : Fin s' → Bool),
      CatLitSim (base 718) ((CatFn.swapSurround (base 718) (base 1542) (compiledSegHS divide) s').prog.instantiate r' h')
        (SW.segHS divide) MidPred :=
    CatFn.swapSurround_catLitSim (base_ne 718 1542 (by omega)) (compiledSegHS divide)
