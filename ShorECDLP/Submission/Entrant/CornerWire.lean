      (SW.endPacketS false) (SW.groupsS false 1 101) AnyEncField AnyEncField
      h1 (compiledGroups_catLitSim false 1 101 (by decide))
      (fun st m ⟨origin, ctx, X, Y, h24, hfr0⟩ _ => by
        obtain ⟨heq, h2400⟩ := (SW.selEnd_sel false).eq m st h24
        rw [heq]
