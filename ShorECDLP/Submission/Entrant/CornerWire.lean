theorem compiled_coherent (coeffs : Fin 65536 → PointCoeff) (Q : Secp256k1.Point)
    (hQ : ShorECDLP.order • Q = 0) (hn : ∀ i, constantPoint Q (coeffs i) ≠ 0)
    (start : Nat) (h : Fin start → Bool) :
    CatCoherent 15645 ((compiledProgram start).instantiate (readConstant coeffs Q) h)
      (Finsupp.lmapDomain ℂ ℂ (WideSigned.Body.state .w16 coeffs Q)) windowReady := by
  let read := readConstant coeffs Q
  have hclean_live (bs : BasisState) (hbs : liveReady bs) : bs 15644 = false ∧ bs 15645 = false :=
    ⟨hbs.2.1 15644 (List.mem_append_left _ (b_pool_mem_work (b_pool_mem_of_band (by dsimp only [Wire]; omega)))),
     hbs.2.1 15645 (List.mem_append_left _ (b_pool_mem_work (b_pool_mem_of_band (by dsimp only [Wire]; omega))))⟩
  have hrf (bs : BasisState) : bs[windowRoot ↦ !bs windowRoot] = rootFlip bs := by
    funext w
    by_cases hw : w = windowRoot
    · subst hw; simp [rootFlip, ECDSAAdd.writeBit, upd]
    · simp [rootFlip, ECDSAAdd.writeBit, upd, hw]
  have hlmap (f : BasisState → BasisState) (bs : BasisState) :
      Finsupp.lmapDomain ℂ ℂ f (ket bs) = ket (f bs) := by
    unfold ket; rw [Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
  have hpre_coh (s' : Nat) (h' : Fin s' → Bool) :
      CatCoherent 15645 ((CatFn.lit (n := 65536) prefixCircuit16 s').prog.instantiate read h')
        (Finsupp.lmapDomain ℂ ℂ (WideSigned.Body.preState .w16)) windowReady := by
    refine ⟨[1], ?_, by simp⟩
    rw [CatFn.lit, CatProg.lit_run]
    refine .cons (fun bs _ => ?_) .nil
    rw [one_smul, hlmap, prep_circuit 15645 prefixCircuit16 b_prefixCircuit16_no15645,
      prefixCircuit16, Quantum.run_append, Quantum.run_singleton, applyGate_X_ket, hrf,
      signedAddressCircuit_ket 836 870 (Geometry.bits .w16) b_bits16_nodup b_836_not_bits16 b_870_not_bits16 (rootFlip bs)]
    rfl
  have hsuf_coh (s' : Nat) (h' : Fin s' → Bool) :
      CatCoherent 15645 ((CatFn.lit (n := 65536) suffixCircuit16 s').prog.instantiate read h')
        (Finsupp.lmapDomain ℂ ℂ (WideSigned.Body.postState .w16)) (fun _ => True) := by
    refine ⟨[1], ?_, by simp⟩
    rw [CatFn.lit, CatProg.lit_run]
    refine .cons (fun bs _ => ?_) .nil
    rw [one_smul, hlmap, prep_circuit 15645 suffixCircuit16 b_suffixCircuit16_no15645,
      suffixCircuit16, Quantum.run_append,
      signedAddressCircuit_ket 836 870 (Geometry.bits .w16) b_bits16_nodup b_836_not_bits16 b_870_not_bits16 bs,
      Quantum.run_singleton, applyGate_X_ket, hrf]
    rfl
  have hn_coh (s' : Nat) (h' : Fin s' → Bool) :
      CatCoherent 15645 ((CatFn.lower 15644 15645 (WideSigned.Body.nProgram .w16 0) s').prog.instantiate read h')
        (Finsupp.lmapDomain ℂ ℂ signPointState) liveReady := by
    apply CatFn.lower_catCoherent 15644 15645 (WideSigned.Body.nProgram .w16 0) s' read h'
      b_nProgram_wf b_nProgram_avoid.1 b_nProgram_avoid.2 (by decide) _ liveReady hclean_live
    unfold CoherentlyImplementsOn
    rw [WideSigned.Body.n_run .w16 0 read Fin.elim0]
    exact fastWindowSign_coherent
  rw [compiledProgram, castFinish_instantiate, compiledProgramFn]
  exact b_seq_catCoherent 15645 _ _ read (WideSigned.Body.preState .w16) _ windowReady liveReady
    hpre_coh
    (b_seq_catCoherent 15645 _ _ read signPointState _ liveReady liveReady
      hn_coh
      (b_seq_catCoherent 15645 _ _ read (Add.update .w16 coeffs Q) _ liveReady liveReady
        (compiledRow_catCoherent coeffs Q hQ hn)
        (b_seq_catCoherent 15645 _ _ read signPointState (WideSigned.Body.postState .w16) liveReady (fun _ => True)
          hn_coh hsuf_coh (fun _ _ => trivial))
        (fun bs hbs => liveReady_write _ bs hbs))
      (fun bs hbs => liveReady_write _ bs hbs))
    (fun bs hbs => WideSigned.Body.prepare_live .w16 _ (rootFlip_live bs hbs)) start h

