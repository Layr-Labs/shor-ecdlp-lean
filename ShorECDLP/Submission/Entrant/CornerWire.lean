/-! #### 6. Trimmed x-negation (`compiledNegX`, `251` Toffolis, `506` records) -/

def negXLayout : CompactRecoveryNegateLayout := streamLayout.recoveryNegate
def negXCarryPrefix : ECDSAAdd.Program :=
  [.CCX 263 14371 14115, .CCX 264 14115 14116, .CCX 265 14116 14117, .CCX 266 14117 14118]
def negXCleanWires : List Wire := [14371, 14115, 14116, 14117]
def negXAdd : ECDSAAdd.Program := (negXLayout.add 14113 (ECDSAAdd.p + 1)).drop 4
def negXRefl : ECDSAAdd.Program := negXLayout.complement 14113 ++ negXAdd
def negXProg : ECDSAAdd.Program := ECDSAAdd.renameProgram sqSwap negXRefl

def compiledNegX {n : Nat} : CatFn n :=
  CatFn.seq (CatFn.seq (CatFn.lit [.X 15651]) (CatFn.compileProg 14832 14833 negXProg))
    (CatFn.lit [.X 15651])

theorem negXAdd_split : negXLayout.add 14113 (ECDSAAdd.p + 1) = negXCarryPrefix ++ negXAdd := by
  have h : (negXLayout.add 14113 (ECDSAAdd.p + 1)).take 4 = negXCarryPrefix := by decide +kernel
  simpa only [h, negXAdd] using (List.take_append_drop 4 (negXLayout.add 14113 (ECDSAAdd.p + 1))).symm

theorem negXCarryPrefix_run (st : ECDSAAdd.State) (m : List Bool)
    (hc : ∀ w ∈ negXCleanWires, st.basis w = false) : ECDSAAdd.run negXCarryPrefix m st = st := by
  have h0 := hc 14371 (by simp [negXCleanWires])
  have h1 := hc 14115 (by simp [negXCleanWires])
  have h2 := hc 14116 (by simp [negXCleanWires])
  have h3 := hc 14117 (by simp [negXCleanWires])
  have skip (a b t : Wire) (tail : ECDSAAdd.Program) (hb : st.basis b = false) :
      ECDSAAdd.run (.CCX a b t :: tail) m st = ECDSAAdd.run tail m st := by
    rw [Site1Fast.run_cons_CCX]; simp only [hb, Bool.and_false, Bool.xor_false, ECDSAAdd.writeBit, Function.update_eq_self]
  unfold negXCarryPrefix
  rw [skip _ _ _ _ h0, skip _ _ _ _ h1, skip _ _ _ _ h2, skip _ _ _ _ h3, Site1Fast.run_nil]

theorem negXRefl_run (st : ECDSAAdd.State) (m : List Bool)
    (hc : ∀ w ∈ negXCleanWires, st.basis w = false) :
    ECDSAAdd.run negXRefl m st = ECDSAAdd.run (negXLayout.reflection 14113 (ECDSAAdd.p + 1)) m st := by
  have away : ∀ w ∈ negXCleanWires, w ∉ ECDSAAdd.wires (negXLayout.complement 14113) := by decide +kernel
  have clean (records : List Bool) :
      ∀ w ∈ negXCleanWires, (ECDSAAdd.run (negXLayout.complement 14113) records st).basis w = false := by
    intro w hw; rw [ECDSAAdd.run_preserves_outside _ _ _ _ (away w hw), hc w hw]
  simp only [negXRefl, CompactRecoveryNegateLayout.reflection, negXAdd_split, ECDSAAdd.run_append]
  rw [negXCarryPrefix_run _ _ (clean _)]
  have hm0 : ECDSAAdd.measurementCount negXCarryPrefix = 0 := by decide +kernel
  simp only [hm0, List.drop_zero]

theorem negXRefl_counts : ECDSAAdd.toffoliCount negXRefl = 251 ∧ ECDSAAdd.measurementCount negXRefl = 255 := by
  have hwl : negXLayout.word.length = 256 := streamLayout_widths.inputX
  have hwk : negXLayout.work.length = negXLayout.word.length := by
    simp [negXLayout, ControlledPointLayout.recoveryNegate, streamLayout.dialogPool_length streamLayout_widths, streamLayout_point_x_eq]
  have old := negXLayout.reflection_counts 14113 (ECDSAAdd.p + 1) hwk (by (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega)))
  have ht := congrArg ECDSAAdd.toffoliCount negXAdd_split
  have hm := congrArg ECDSAAdd.measurementCount negXAdd_split
  have hcp_t : ECDSAAdd.toffoliCount negXCarryPrefix = 4 := by decide +kernel
  have hcp_m : ECDSAAdd.measurementCount negXCarryPrefix = 0 := by decide +kernel
  simp only [ECDSAAdd.toffoliCount_append, ECDSAAdd.measurementCount_append, hcp_t, hcp_m] at ht hm
  simp only [CompactRecoveryNegateLayout.reflection, ECDSAAdd.toffoliCount_append,
    ECDSAAdd.measurementCount_append, hwl] at old
  simp only [negXRefl, ECDSAAdd.toffoliCount_append, ECDSAAdd.measurementCount_append]
  (first | omega | (dsimp -zeta -zetaDelta -iota -proj only [Wire, ECDSAAdd.Wire] at *; omega))

theorem negXRefl_physical : ECDSAAdd.Arithmetic.GatePhysical negXRefl := by
  have old := negXLayout.reflection_physical 14113 (ECDSAAdd.p + 1)
