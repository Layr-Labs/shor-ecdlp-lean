-- ShiftFin for segmentS, segHS, kernelS
theorem compiledSegmentS_shiftFin {n : Nat} (divide : Bool) :
    ShiftFin (compiledSegmentS (n := n) divide)
      (ECDSAAdd.measurementCount (SW.segmentS divide) + ECDSAAdd.toffoliCount (SW.segmentS divide)) := by
  rw [compiledSegmentS]; cases divide
  · refine (CatFn.seq_shiftFin _ _ (CatFn.compileProg_shiftFin _ _ _)
      (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _)
        (CatFn.seq_shiftFin _ _ (CatFn.swapSurround_shiftFin _ _ _ (compiledReplayS_shiftFin false))
          (CatFn.compileProg_shiftFin _ _ _)))).mono ?_
    simp only [SW.segmentS, Bool.false_eq_true, if_false, ECDSAAdd.measurementCount_append,
      ECDSAAdd.toffoliCount_append]; omega
  · refine (CatFn.seq_shiftFin _ _ (CatFn.compileProg_shiftFin _ _ _)
      (CatFn.seq_shiftFin _ _ (CatFn.swapSurround_shiftFin _ _ _ (compiledReplayS_shiftFin true))
        (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _) (CatFn.compileProg_shiftFin _ _ _)))).mono ?_
    simp only [SW.segmentS, if_true, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]; omega

theorem compiledSegHS_shiftFin {n : Nat} (divide : Bool) :
    ShiftFin (compiledSegHS (n := n) divide)
      (ECDSAAdd.measurementCount (SW.segHS divide) + ECDSAAdd.toffoliCount (SW.segHS divide)) := by
  rw [compiledSegHS]
  refine (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _)
    (CatFn.seq_shiftFin _ _ (CatFn.map_shiftFin _ _ (compiledSegmentS_shiftFin divide))
      (CatFn.noT_shiftFin _))).mono ?_
  have hc := ECDSAAdd.renameProgram_counts HostOB5.hostSwap (SW.segmentS divide)
  have hx : ECDSAAdd.measurementCount [.X (base 511)] = 0 := rfl
  simp only [SW.segHS, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append, hc.1, hc.2, hx]; omega

theorem compiledKernelS_shiftFin {n : Nat} (divide : Bool) :
    ShiftFin (compiledKernelS (n := n) divide)
      (ECDSAAdd.measurementCount (SW.kernelS divide) + ECDSAAdd.toffoliCount (SW.kernelS divide)) := by
  have hk : SW.kernelS divide = (kernelPre ++ SW.segHS divide) ++ kernelSuf := by
    simp only [SW.kernelS, kernelPre, kernelSuf, List.append_assoc]
  rw [compiledKernelS, hk]
  refine (CatFn.seq_shiftFin _ _
    (CatFn.seq_shiftFin _ _ (CatFn.compileProg_shiftFin _ _ _)
      (CatFn.swapSurround_shiftFin _ _ _ (compiledSegHS_shiftFin divide)))
    (CatFn.compileProg_shiftFin _ _ _)).mono ?_
  simp only [ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]; omega

-- tCount for segmentS, segHS, kernelS
theorem compiledSegmentS_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledSegmentS (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.segmentS divide) := by
  have hcp0 : ECDSAAdd.toffoliCount HalfFieldOB5.copyN = 0 := by
    have len : (balancedSharedPorts base (base 2409)).r.length =
        (balancedSharedPorts base (base 2409)).y.length := by
      rw [balancedSharedPorts_r, balancedSharedPorts_y]; simp [wireBlock_length]
    have k := copyRegister_counts none (balancedSharedPorts base (base 2409)).r
      (balancedSharedPorts base (base 2409)).y len
    simpa only [HalfFieldOB5.copyN, HalfField5.copyN, HalfField.copyN, HalfField.ports,
      Option.isSome_none, Bool.false_eq_true, if_false] using k.1
  rw [compiledSegmentS]; cases divide
  · refine (CatFn.seq_tCount_le _ _
      (CatFn.seq_indep _ _ (CatFn.noT_indep _)
        (CatFn.seq_indep _ _ (CatFn.swapSurround_indep _ _ _ (compiledReplayS_indep false))
          (CatFn.compileProg_indep _ _ _)))
      (CatFn.compileProg_tCount _ _ _)
      (CatFn.seq_tCount_le _ _
        (CatFn.seq_indep _ _ (CatFn.swapSurround_indep _ _ _ (compiledReplayS_indep false))
          (CatFn.compileProg_indep _ _ _))
        (CatFn.noT_tCount _ hcp0)
        (CatFn.seq_tCount_le _ _ (CatFn.compileProg_indep _ _ _)
          (CatFn.swapSurround_tCount_le _ _ _ (compiledReplayS_indep false) (compiledReplayS_tCount false))
          (CatFn.compileProg_tCount _ _ _))) s read h).trans ?_
    simp only [SW.segmentS, Bool.false_eq_true, if_false, ECDSAAdd.toffoliCount_append, hcp0]; omega
  · refine (CatFn.seq_tCount_le _ _
      (CatFn.seq_indep _ _ (CatFn.swapSurround_indep _ _ _ (compiledReplayS_indep true))
        (CatFn.seq_indep _ _ (CatFn.noT_indep _) (CatFn.compileProg_indep _ _ _)))
      (CatFn.compileProg_tCount _ _ _)
      (CatFn.seq_tCount_le _ _
        (CatFn.seq_indep _ _ (CatFn.noT_indep _) (CatFn.compileProg_indep _ _ _))
        (CatFn.swapSurround_tCount_le _ _ _ (compiledReplayS_indep true) (compiledReplayS_tCount true))
        (CatFn.seq_tCount_le _ _ (CatFn.compileProg_indep _ _ _) (CatFn.noT_tCount _ hcp0)
          (CatFn.compileProg_tCount _ _ _))) s read h).trans ?_
    simp only [SW.segmentS, if_true, ECDSAAdd.toffoliCount_append, hcp0]; omega

theorem compiledSegHS_tCount {n : Nat} (divide : Bool) (s : Nat)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledSegHS (n := n) divide s).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (SW.segHS divide) := by
  rw [compiledSegHS]
