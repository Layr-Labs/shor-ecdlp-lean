  have h5 (c : Nat) (rs : List (Fin c)) : (tpStep5 c rs).prog.gateSlots ≤ 51200000000 := by
    rw [tpStep5]; exact stepCatFn_slots_le _ _ _ _ b_fB_slots h6 c rs
  have h4 (c : Nat) (rs : List (Fin c)) : (tpStep4 c rs).prog.gateSlots ≤ 51200000000 := by
    rw [tpStep4]; exact CatProg.measureThen_slots_le _ _ h5 _ c rs
  have h3 (c : Nat) (rs : List (Fin c)) : (tpStep3 c rs).prog.gateSlots ≤ 56200000000 := by
    rw [tpStep3]; exact stepCatFn_slots_le _ _ _ _ hS_le h4 c rs
  have h2 (c : Nat) (rs : List (Fin c)) : (tpStep2 c rs).prog.gateSlots ≤ 56200000000 := by
