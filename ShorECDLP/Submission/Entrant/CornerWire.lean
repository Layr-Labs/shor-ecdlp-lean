    ⟨fun hm => by have := (List.mem_filter.mp (hsub hm)).2; simp at this,
     fun hm => by have := (List.mem_filter.mp (hsub hm)).2; simp at this⟩
  obtain ⟨cs', al', m'⟩ := compileLower_lift_raw 14832 14833 (rawFixup9 k cur rs) cur id read hh hh (fun _ => rfl)
