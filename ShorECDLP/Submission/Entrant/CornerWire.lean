          rcases hm with h' | h'
          · have hr254 : cellLayout.r.getD 254 0 ∈ cellLayout.r := by
              have hl : 254 < cellLayout.r.length := by rw [(BalancedCleanup.widths cellLayout.toLayout cellLayout_widths).2.1]; decide
              rw [List.getD_eq_getElem _ _ hl]; exact List.getElem_mem hl
