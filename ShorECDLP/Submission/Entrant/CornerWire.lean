        simp only [cmpLtProg, Bool.false_eq_true, if_false, compareLt, ECDSAAdd.run_append]
        rw [ECDSAAdd.run_preserves_outside _ _ _ q hnr]
        exact compareChain_carry_clean false cellLayout.y cellLayout.r cellLayout.carry cellLayout.one cellLayout.parity
