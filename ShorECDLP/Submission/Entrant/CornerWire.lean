  have hmem : wireFn2 streamLayout w ∈ OwnParityPhysical.sites streamLayout := List.mem_toFinset.mp himg
  have hne_gen : wireFn2 streamLayout w ≠ 14113 := by
    intro eq
    have hlog24 : base 2400 ∈ OB5Support.logicalSites := by
      simp only [OB5Support.logicalSites, List.mem_toFinset, List.mem_map]
      exact ⟨2400, by decide, rfl⟩
    have hf24 : wireFn2 streamLayout (base 2400) = 14113 := rfl
    exact hne2400 ((placement2 streamLayout streamLayout_widths streamLayout_nodup).injectiveOnSlots w
      (ArithmeticOB5.logical_sub_old hlog) (base 2400) (ArithmeticOB5.logical_sub_old hlog24) (eq.trans hf24.symm))
  have hne_pool (k : Nat) (hk : k = 765 ∨ k = 766 ∨ k = 767) :
      wireFn2 streamLayout w ≠ streamLayout.core.poolWire k := by
    intro eq
    have hlogk : base k ∈ OB5Support.logicalSites := by
      simp only [OB5Support.logicalSites, List.mem_toFinset, List.mem_map]
      exact ⟨k, by rcases hk with rfl | rfl | rfl <;> decide, rfl⟩
    have hfk : wireFn2 streamLayout (base k) = streamLayout.core.poolWire k := by
      rcases hk with rfl | rfl | rfl <;> rfl
    have heq := (placement2 streamLayout streamLayout_widths streamLayout_nodup).injectiveOnSlots w
      (ArithmeticOB5.logical_sub_old hlog) (base k) (ArithmeticOB5.logical_sub_old hlogk) (eq.trans hfk.symm)
    rcases hk with rfl | rfl | rfl
    · exact h4.1 heq
    · exact h4.2.1 heq
    · exact h4.2.2.1 heq
  simp only [OwnParityPhysical.sites, List.mem_cons, List.mem_append] at hmem
  rcases hmem with ((hgen | hx) | hy) | hpool
  · rw [streamLayout_generic_eq] at hgen; exact absurd hgen hne_gen
  · rw [streamLayout_point_x_eq, List.mem_range'_1] at hx; exact mem_support1612_x hx
  · rw [streamLayout_point_y_eq, List.mem_range'_1] at hy; exact mem_support1612_y hy
  · obtain ⟨i, hi, heq⟩ := OwnParityPhysical.pool_index streamLayout _ hpool
    have h765 : i ≠ 765 := fun e => hne_pool 765 (Or.inl rfl) (heq.trans (congrArg _ e))
    have h766 : i ≠ 766 := fun e => hne_pool 766 (Or.inr (Or.inl rfl)) (heq.trans (congrArg _ e))
