private theorem mem_support_of_props (w : Wire)
    (h : (fixedPort w ∨ oldWork w) ∧ ¬PoolHost.retiredH7 w) : w ∈ WideBank8.Fast16.Tight.support :=
  WideBank8.Fast16.Tight.old_cover ((PoolHost.newSourceH7_mem w).mpr h)

theorem compiledHostArith_wires (multiply : Bool) (s : Nat) :
    ChallengeMigration.straightWires (compiledHostArith multiply s).prog ⊆ WideBank8.Fast16.Tight.support := by
  have m14832 : (14832 : Wire) ∈ WideBank8.Fast16.Tight.support :=
    mem_support_of_props 14832 (by simp only [fixedPort, oldWork, PoolHost.retiredH7, retiredH, retired]; omega)
  have m14833 : (14833 : Wire) ∈ WideBank8.Fast16.Tight.support :=
    mem_support_of_props 14833 (by simp only [fixedPort, oldWork, PoolHost.retiredH7, retiredH, retired]; omega)
  have henc_w : ECDSAAdd.wires PoolHost.enc4 ⊆ WideBank8.Fast16.Tight.support.toFinset := by
    intro w hw; apply List.mem_toFinset.mpr
    have h' := enc4_wires_sub hw; simp only [Finset.mem_insert, Finset.mem_singleton] at h'
    rcases h' with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact mem_support_of_props _ (by decide)
  have hdec_w : ECDSAAdd.wires PoolHost.dec4 ⊆ WideBank8.Fast16.Tight.support.toFinset := by
    intro w hw; apply List.mem_toFinset.mpr
    have h' := dec4_wires_sub hw; simp only [Finset.mem_insert, Finset.mem_singleton] at h'
    rcases h' with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact mem_support_of_props _ (by decide)
  have hf_w : ECDSAAdd.wires hostFlip3 ⊆ WideBank8.Fast16.Tight.support.toFinset := by
    intro w hw; apply List.mem_toFinset.mpr
    have h' := hostFlip3_wires_sub hw; simp only [Finset.mem_insert, Finset.mem_singleton] at h'
    rcases h' with rfl | rfl | rfl <;> exact mem_support_of_props _ (by decide)
  have hmid (s' : Nat) :
      ChallengeMigration.straightWires (CatFn.map phiArith (compiledKernelS (n := 65536) (!multiply)) s').prog ⊆
        WideBank8.Fast16.Tight.support := by
    intro w hw
    obtain ⟨u, hu, rfl⟩ := catFn_map_mem phiArith (compiledKernelS (n := 65536) (!multiply)) s' hw
    exact phiArith_mem_support u (Finset.mem_toList.mp (compiledKernelS_wires (!multiply) s' hu))
      (compiledKernelS_avoid4 (!multiply) s' u hu)
  rw [compiledHostArith]
  exact CatFn.seq_wires _ _
    (CatFn.seq_wires _ _
      (CatFn.seq_wires _ _
        (CatFn.seq_wires _ _ (CatFn.compileProg_wires _ _ _ henc_w m14832 m14833) (CatFn.noT_wires _ hf_w))
        hmid)
      (CatFn.noT_wires _ hf_w))
    (CatFn.compileProg_wires _ _ _ hdec_w m14832 m14833) s

