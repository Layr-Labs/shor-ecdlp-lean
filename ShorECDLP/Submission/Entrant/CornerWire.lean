theorem compiledZCell_catLitSim {n : Nat} (g sw : Wire)
    (hg : base 1026 ≠ g) (hsw : base 1026 ≠ sw) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
