theorem add_assoc_3 (s a b : Nat) : s + a + b = s + (a + b) := Nat.add_assoc s a b

theorem twoPass_fin_gen (s rA cA cB mS mT fR : Nat) (hr : rA = cA) :
    s + rA + (774 + (mS + (258 + (cB + (513 + (mT + (513 + fR))))))) =
