private theorem rawFixup16_wires_sub (cur : Nat) (rs : List (Fin cur)) :
    ChallengeMigration.straightWires (rawFixup16 cur rs) ⊆
      support1612.filter (fun w => decide (w ≠ 14832 ∧ w ≠ 14833)) := by
