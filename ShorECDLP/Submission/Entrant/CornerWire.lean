private theorem catFn_swapSurround_avoid4 {n : Nat} (y₁ y₂ : Wire) (body : CatFn n)
    (h1 : avoid4 y₁) (h2 : avoid4 y₂)
    (hb : ∀ s w, w ∈ ChallengeMigration.straightWires (body s).prog → avoid4 w)
    (s : Nat) (w : Wire) (hw : w ∈ ChallengeMigration.straightWires (CatFn.swapSurround y₁ y₂ body s).prog) :
    avoid4 w := by
  rw [CatFn.swapSurround] at hw
  have hsw (a b : Wire) (ha : avoid4 a) (hb' : avoid4 b) (s' : Nat) (u : Wire)
      (hu : u ∈ ChallengeMigration.straightWires (CatFn.lit (n := n) (swapCircuit a b) s').prog) : avoid4 u := by
    have hm := swapCircuit_wires a b (by simpa [CatFn.lit, CatProg.lit_wires] using hu)
