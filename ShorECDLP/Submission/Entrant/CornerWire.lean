  obtain ⟨u, hu, rfl⟩ := catFn_map_mem (wireFn2 streamLayout) (compiledKernelSEnv E (n := n) (!multiply)) s hw
  exact wireFn2_mem_support1612 u (Finset.mem_toList.mp (compiledKernelSEnv_wires E (!multiply) s hu))
