    h12 (CatFn.noT_catLitSim y _ hy2) (fun _ _ _ _ => trivial) s read h

/-! #### 2. `CellValid` & `CellValidZero` invariants -/

def CellValid (bs : BasisState) : Prop :=
  OneBankCell5.Clean base bs ∧
  ∃ X Y : Fp, ECDSAAdd.regValue cellLayout.r bs = BalancedField.centerWord X ∧
    ECDSAAdd.regValue cellLayout.y bs = BalancedField.centerWord Y

def CellValidZero (bs : BasisState) : Prop :=
  OneBankCell5.Clean base bs ∧
  ∃ X Y : Fp, (X = 0 ∨ Y = 0) ∧
    ECDSAAdd.regValue cellLayout.r bs = BalancedField.centerWord X ∧
    ECDSAAdd.regValue cellLayout.y bs = BalancedField.centerWord Y

private theorem cellValidZero_valid {bs : BasisState} (h : CellValidZero bs) : CellValid bs :=
  ⟨h.1, let ⟨X, Y, _, hr, hy⟩ := h.2; ⟨X, Y, hr, hy⟩⟩

private theorem mem_workIds_map (k : Nat)
    (hk : k = 765 ∨ k = 2312 ∨ k = 767 ∨ k = 766 ∨ k = 768 ∨ k = 1797 ∨ k = 1027 ∨
      (512 ≤ k ∧ k < 765) ∨ k = 1540 ∨ k = 1541 ∨ k = 1026) :
    base k ∈ OneBankCell5.workIds.map base := by
  apply List.mem_map.mpr
  refine ⟨k, ?_, rfl⟩
  simp only [OneBankCell5.workIds, List.mem_append, List.mem_cons, List.not_mem_nil,
    List.mem_range'_1, or_false]
  omega

private theorem cellValid_clean {bs : BasisState} (h : CellValid bs) : CellClean bs := by
  refine ⟨h.1 _ (mem_workIds_map 1797 (by omega)), h.1 _ (mem_workIds_map 1027 (by omega)), fun w hw => ?_⟩
  change w ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hw
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
    List.mem_range'_1] at hw
  rcases hw with ⟨i, hi, rfl⟩ | rfl | rfl | rfl
  · exact h.1 _ (mem_workIds_map i (by omega))
  · exact h.1 _ (mem_workIds_map 1540 (by omega))
  · exact h.1 _ (mem_workIds_map 1541 (by omega))
  · exact h.1 _ (mem_workIds_map 1026 (by omega))

private theorem cellValid_1541_1026 {bs : BasisState} (h : CellValid bs) :
    bs (base 1541) = false ∧ bs (base 1026) = false :=
  ⟨h.1 _ (mem_workIds_map 1541 (by omega)), h.1 _ (mem_workIds_map 1026 (by omega))⟩

private theorem cellValid_of_pair {origin bs : BasisState} {X Y : Fp}
    (hc : OneBankCell5.Clean base origin)
    (hp : PairFrame cellLayout.r cellLayout.y origin (BalancedField.centerWord X) (BalancedField.centerWord Y) bs) :
    CellValid bs := by
  refine ⟨fun q hq => ?_, X, Y, hp.1, hp.2.1⟩
  have hqw : q ∈ BalancedCircuit.work cellLayout := by
    rw [cellLayout, OneBankCell5.ports_work]; exact hq
  have haw := OneBankCore5.work_away cellLayout cellLayout_nodup q hqw
  exact (hp.2.2 q haw.1 haw.2).trans (hc q hq)

private theorem cell_work_not_ry (q : Wire) (hq : q ∈ OneBankCell5.workIds.map base) :
    q ∉ cellLayout.r ∧ q ∉ cellLayout.y := by
  have hqw : q ∈ BalancedCircuit.work cellLayout := by
    rw [cellLayout, OneBankCell5.ports_work]; exact hq
  exact OneBankCore5.work_away cellLayout cellLayout_nodup q hqw

private theorem cell_base_not_r (k : Nat) (hk : k < 2056 ∨ 2312 ≤ k) : base k ∉ cellLayout.r := by
  intro hm
  change base k ∈ base 2056 :: (wireBlock base 2057 254 ++ [base 2311]) at hm
  simp only [List.mem_cons, List.mem_append, List.not_mem_nil, or_false, wireBlock, List.mem_map,
    List.mem_range'_1, MappedCompressed.base_injective.eq_iff] at hm
  omega

private theorem cell_base_not_y (k : Nat) (hk : k < 770 ∨ 1026 ≤ k) : base k ∉ cellLayout.y := by
  intro hm
  change base k ∈ wireBlock base 770 255 ++ [base 1025] at hm
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
    List.mem_range'_1, MappedCompressed.base_injective.eq_iff] at hm
  omega

private theorem cell_base_not_work (k : Nat) (hk : 2400 ≤ k) : base k ∉ OneBankCell5.workIds.map base := by
  intro hm
  obtain ⟨j, hj, he⟩ := List.mem_map.mp hm
  have := MappedCompressed.base_injective he
  have := OneBankCell5.work_bound j hj
  omega

private theorem cell_writeBit_pres_valid (bs : BasisState) (flag : Wire) (v : Bool)
    (hr : flag ∉ cellLayout.r) (hy : flag ∉ cellLayout.y) (hw : flag ∉ OneBankCell5.workIds.map base)
    (h : CellValid bs) : CellValid (ECDSAAdd.writeBit bs flag v) := by
  obtain ⟨hc, X, Y, hxr, hyr⟩ := h
  refine ⟨fun q hq => ?_, X, Y, ?_, ?_⟩
  · have hqf : q ≠ flag := fun e => hw (e ▸ hq)
    simpa [ECDSAAdd.writeBit, Function.update_of_ne hqf] using hc q hq
  · rw [← hxr]; exact ECDSAAdd.Arithmetic.regValue_congr _ _ _ (fun q hq => by
      have hqf : q ≠ flag := fun e => hr (e ▸ hq)
      simp [ECDSAAdd.writeBit, Function.update_of_ne hqf])
  · rw [← hyr]; exact ECDSAAdd.Arithmetic.regValue_congr _ _ _ (fun q hq => by
      have hqf : q ≠ flag := fun e => hy (e ▸ hq)
      simp [ECDSAAdd.writeBit, Function.update_of_ne hqf])

private theorem cell_writeBit_pres_validZero (bs : BasisState) (flag : Wire) (v : Bool)
    (hr : flag ∉ cellLayout.r) (hy : flag ∉ cellLayout.y) (hw : flag ∉ OneBankCell5.workIds.map base)
    (h : CellValidZero bs) : CellValidZero (ECDSAAdd.writeBit bs flag v) := by
  obtain ⟨hc, X, Y, hz, hxr, hyr⟩ := h
  refine ⟨fun q hq => ?_, X, Y, hz, ?_, ?_⟩
  · have hqf : q ≠ flag := fun e => hw (e ▸ hq)
    simpa [ECDSAAdd.writeBit, Function.update_of_ne hqf] using hc q hq
  · rw [← hxr]; exact ECDSAAdd.Arithmetic.regValue_congr _ _ _ (fun q hq => by
      have hqf : q ≠ flag := fun e => hr (e ▸ hq)
      simp [ECDSAAdd.writeBit, Function.update_of_ne hqf])
  · rw [← hyr]; exact ECDSAAdd.Arithmetic.regValue_congr _ _ _ (fun q hq => by
      have hqf : q ≠ flag := fun e => hy (e ▸ hq)
      simp [ECDSAAdd.writeBit, Function.update_of_ne hqf])

private theorem cell_run_outside_pres_valid (P : ECDSAAdd.Program) (st : ECDSAAdd.State) (m : List Bool)
    (hr : ∀ q ∈ cellLayout.r, q ∉ ECDSAAdd.wires P)
    (hy : ∀ q ∈ cellLayout.y, q ∉ ECDSAAdd.wires P)
    (hw : ∀ q ∈ OneBankCell5.workIds.map base, q ∉ ECDSAAdd.wires P)
    (h : CellValid st.basis) : CellValid (ECDSAAdd.run P m st).basis := by
  obtain ⟨hc, X, Y, hxr, hyr⟩ := h
  refine ⟨fun q hq => (ECDSAAdd.run_preserves_outside P m st q (hw q hq)).trans (hc q hq), X, Y,
    (ECDSAAdd.Arithmetic.regValue_congr _ _ _ (fun q hq => ECDSAAdd.run_preserves_outside P m st q (hr q hq))).trans hxr,
    (ECDSAAdd.Arithmetic.regValue_congr _ _ _ (fun q hq => ECDSAAdd.run_preserves_outside P m st q (hy q hq))).trans hyr⟩

private theorem cell_run_outside_pres_validZero (P : ECDSAAdd.Program) (st : ECDSAAdd.State) (m : List Bool)
    (hr : ∀ q ∈ cellLayout.r, q ∉ ECDSAAdd.wires P)
    (hy : ∀ q ∈ cellLayout.y, q ∉ ECDSAAdd.wires P)
    (hw : ∀ q ∈ OneBankCell5.workIds.map base, q ∉ ECDSAAdd.wires P)
    (h : CellValidZero st.basis) : CellValidZero (ECDSAAdd.run P m st).basis := by
  obtain ⟨hc, X, Y, hz, hxr, hyr⟩ := h
  refine ⟨fun q hq => (ECDSAAdd.run_preserves_outside P m st q (hw q hq)).trans (hc q hq), X, Y, hz,
    (ECDSAAdd.Arithmetic.regValue_congr _ _ _ (fun q hq => ECDSAAdd.run_preserves_outside P m st q (hr q hq))).trans hxr,
    (ECDSAAdd.Arithmetic.regValue_congr _ _ _ (fun q hq => ECDSAAdd.run_preserves_outside P m st q (hy q hq))).trans hyr⟩

private theorem cell_swap_nodup :
    (base 2410 :: (cellLayout.r ++ cellLayout.y)).Nodup := by
  have cfg := MappedCompressed.LaneA.laneLogical_config
  have hho : base 2410 ∉ skywalkSharedWires base := cfg.2.1 _ (by simp)
  have hown : base 2410 ∉ balancedSharedIds.map base := fun h =>
    hho (balancedSharedLayout_mapSubset base balancedSharedIds balancedSharedIds_bound h)
  have nd := balancedSharedPorts_nodup base (base 2410) cfg.1 hown
  have aw := BalancedCircuit.flagAway (balancedSharedPorts base (base 2410)) nd (base 2410)
    (by simp [balancedSharedPorts])
  apply List.nodup_cons.mpr
  refine ⟨?_, balancedSharedLayout_pairND base (base 2410) cfg.1⟩
  intro hm
  rcases List.mem_append.mp hm with h | h
  · exact aw (List.mem_append_left _ (List.mem_append_left _ (by simpa only [cellLayout, OneBankCell5.ports_r, balancedSharedPorts_r] using h)))
  · exact aw (List.mem_append_left _ (List.mem_append_right _ (by simpa only [cellLayout, OneBankCell5.ports_y, balancedSharedPorts_y] using h)))

private theorem cell_swapBody_wires :
    ECDSAAdd.wires SW.swapBody ⊆ (base 2410 :: (cellLayout.r ++ cellLayout.y)).toFinset := by
  have hlen : cellLayout.r.length = cellLayout.y.length := by
    have w := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
    exact w.2.1.trans w.2.2.1.symm
  intro q hq
  simp only [SW.swapBody, swapRegisters, ECDSAAdd.wires_append, Finset.mem_union] at hq
  rcases hq with (h | h) | h
  · have hm := copyRegister_wires_subset none cellLayout.y cellLayout.r h
    simp only [Option.toList_none, List.nil_append, List.mem_toFinset, List.mem_append, List.mem_cons] at hm ⊢
    tauto
  · have hm := copyRegister_wires_subset (some (base 2410)) cellLayout.r cellLayout.y h
    simp only [Option.toList_some, List.cons_append, List.nil_append, List.mem_toFinset, List.mem_append, List.mem_cons] at hm ⊢
    exact hm
  · have hm := copyRegister_wires_subset none cellLayout.y cellLayout.r h
    simp only [Option.toList_none, List.nil_append, List.mem_toFinset, List.mem_append, List.mem_cons] at hm ⊢
    tauto

private theorem cell_swapBody_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires SW.swapBody := fun h => by
  have hm := cell_swapBody_wires h
  simp only [List.mem_toFinset, List.mem_cons, List.mem_append] at hm
  rcases hm with e | hr | hy
  · have := MappedCompressed.base_injective e; omega
  · exact cell_base_not_r k (by omega) hr
  · exact cell_base_not_y k (by omega) hy

private theorem cell_swapBody_pres_valid (st : ECDSAAdd.State) (m : List Bool) (h : CellValid st.basis) :
    CellValid (ECDSAAdd.run SW.swapBody m st).basis := by
  obtain ⟨hc, X, Y, hxr, hyr⟩ := h
  have hlen : cellLayout.r.length = cellLayout.y.length := by
    have w := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
    exact w.2.1.trans w.2.2.1.symm
  have hsw := swapRegisters_correct (base 2410) cellLayout.r cellLayout.y hlen cell_swap_nodup st m
  have hsw_eq : SW.swapBody = swapRegisters (base 2410) cellLayout.r cellLayout.y := by
    rw [SW.swapBody, OneBankCell5.ports_r, OneBankCell5.ports_y]
  rw [hsw_eq]
  refine ⟨fun q hq => (hsw.2.1 q (cell_work_not_ry q hq).1 (cell_work_not_ry q hq).2).trans (hc q hq), ?_⟩
  cases hb : st.basis (base 2410)
  · exact ⟨X, Y, by simp only [hsw.2.2.1, hb, Bool.false_eq_true, if_false, hxr], by simp only [hsw.2.2.2, hb, Bool.false_eq_true, if_false, hyr]⟩
  · exact ⟨Y, X, by simp only [hsw.2.2.1, hb, if_true, hyr], by simp only [hsw.2.2.2, hb, if_true, hxr]⟩

private theorem cell_swapBody_pres_validZero (st : ECDSAAdd.State) (m : List Bool) (h : CellValidZero st.basis) :
    CellValidZero (ECDSAAdd.run SW.swapBody m st).basis := by
  obtain ⟨hc, X, Y, hz, hxr, hyr⟩ := h
  have hlen : cellLayout.r.length = cellLayout.y.length := by
    have w := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
    exact w.2.1.trans w.2.2.1.symm
  have hsw := swapRegisters_correct (base 2410) cellLayout.r cellLayout.y hlen cell_swap_nodup st m
  have hsw_eq : SW.swapBody = swapRegisters (base 2410) cellLayout.r cellLayout.y := by
    rw [SW.swapBody, OneBankCell5.ports_r, OneBankCell5.ports_y]
  rw [hsw_eq]
  refine ⟨fun q hq => (hsw.2.1 q (cell_work_not_ry q hq).1 (cell_work_not_ry q hq).2).trans (hc q hq), ?_⟩
  cases hb : st.basis (base 2410)
  · exact ⟨X, Y, hz, by simp only [hsw.2.2.1, hb, Bool.false_eq_true, if_false, hxr], by simp only [hsw.2.2.2, hb, Bool.false_eq_true, if_false, hyr]⟩
  · exact ⟨Y, X, hz.symm, by simp only [hsw.2.2.1, hb, if_true, hyr], by simp only [hsw.2.2.2, hb, if_true, hxr]⟩

/-! #### 3. Compiled cell-level blocks (`Half`, `HalfE`, `ZHalf`, `SwapBody`, `Body`, `ZBody`, `Cell`, `ZCell`) -/

def compiledSwapBody {n : Nat} : CatFn n :=
  CatFn.compileProg (base 1541) (base 1026) SW.swapBody

def compiledHalf {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.seq
    (CatFn.seq (CatFn.noT [.X (base 2409)]) (if divide then compiledForward else compiledInverse))
    (CatFn.noT [.X (base 2409)])

def compiledHalfE {n : Nat} (divide : Bool) : CatFn n :=
  if divide then
    CatFn.seq (CatFn.seq (CatFn.noT [.X (base 2409)]) compiledForwardE) (CatFn.noT [.X (base 2409)])
  else compiledHalf false

def compiledZHalf {n : Nat} : CatFn n :=
  CatFn.seq (CatFn.seq (CatFn.noT [.X (base 2409)]) compiledZForward) (CatFn.noT [.X (base 2409)])

def compiledBody {n : Nat} (divide : Bool) : CatFn n :=
  if divide then CatFn.seq (compiledHalf true) compiledSwapBody
  else CatFn.seq compiledSwapBody (compiledHalf false)

def compiledZBody {n : Nat} : CatFn n :=
  CatFn.seq compiledZHalf compiledSwapBody

def compiledCell {n : Nat} (divide : Bool) (g sw : Wire) : CatFn n :=
  compiledSelW g (base 2409) (compiledSelW sw (base 2410) (compiledBody divide))

def compiledZCell {n : Nat} (g sw : Wire) : CatFn n :=
  compiledSelW g (base 2409) (compiledSelW sw (base 2410) compiledZBody)

attribute [local irreducible] compiledSwapBody compiledHalf compiledHalfE compiledZHalf
  compiledBody compiledZBody compiledCell compiledZCell

-- Indep
theorem compiledSwapBody_indep {n : Nat} (s : Nat) : Indep (compiledSwapBody (n := n) s).prog := by
  rw [compiledSwapBody]; exact CatFn.compileProg_indep _ _ _ s

theorem compiledHalf_indep {n : Nat} (divide : Bool) (s : Nat) : Indep (compiledHalf (n := n) divide s).prog := by
  rw [compiledHalf]
  exact CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.noT_indep _)
    (fun s' => by cases divide <;> [exact compiledInverse_indep s'; exact compiledForward_indep s']))
    (CatFn.noT_indep _) s

theorem compiledHalfE_indep {n : Nat} (divide : Bool) (s : Nat) : Indep (compiledHalfE (n := n) divide s).prog := by
  rw [compiledHalfE]; cases divide
  · exact compiledHalf_indep false s
  · exact CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.noT_indep _) compiledForwardE_indep) (CatFn.noT_indep _) s

theorem compiledZHalf_indep {n : Nat} (s : Nat) : Indep (compiledZHalf (n := n) s).prog := by
  rw [compiledZHalf]
  exact CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.noT_indep _) compiledZForward_indep) (CatFn.noT_indep _) s

theorem compiledBody_indep {n : Nat} (divide : Bool) (s : Nat) : Indep (compiledBody (n := n) divide s).prog := by
  rw [compiledBody]; cases divide
  · exact CatFn.seq_indep _ _ compiledSwapBody_indep (compiledHalf_indep false) s
  · exact CatFn.seq_indep _ _ (compiledHalf_indep true) compiledSwapBody_indep s

theorem compiledZBody_indep {n : Nat} (s : Nat) : Indep (compiledZBody (n := n) s).prog := by
  rw [compiledZBody]; exact CatFn.seq_indep _ _ compiledZHalf_indep compiledSwapBody_indep s

theorem compiledCell_indep {n : Nat} (divide : Bool) (g sw : Wire) (s : Nat) :
    Indep (compiledCell (n := n) divide g sw s).prog := by
  rw [compiledCell]
  exact compiledSelW_indep _ _ _ (compiledSelW_indep _ _ _ (compiledBody_indep divide)) s

theorem compiledZCell_indep {n : Nat} (g sw : Wire) (s : Nat) :
    Indep (compiledZCell (n := n) g sw s).prog := by
  rw [compiledZCell]
  exact compiledSelW_indep _ _ _ (compiledSelW_indep _ _ _ compiledZBody_indep) s

-- Removed18
theorem compiledSwapBody_removed18 {n : Nat} (s : Nat) : removed 18 (compiledSwapBody (n := n) s).prog = 0 := by
  rw [compiledSwapBody]; exact CatFn.compileProg_removed18 _ _ _ s

theorem compiledHalf_removed18 {n : Nat} (divide : Bool) (s : Nat) :
    removed 18 (compiledHalf (n := n) divide s).prog = 0 := by
  rw [compiledHalf]
  exact CatFn.seq_removed18 _ _ (CatFn.seq_removed18 _ _ (CatFn.noT_removed18 _)
    (fun s' => by cases divide <;> [exact compiledInverse_removed18 s'; exact compiledForward_removed18 s']))
    (CatFn.noT_removed18 _) s

theorem compiledHalfE_removed18 {n : Nat} (divide : Bool) (s : Nat) :
    removed 18 (compiledHalfE (n := n) divide s).prog = 0 := by
  rw [compiledHalfE]; cases divide
  · exact compiledHalf_removed18 false s
  · exact CatFn.seq_removed18 _ _ (CatFn.seq_removed18 _ _ (CatFn.noT_removed18 _) compiledForwardE_removed18)
      (CatFn.noT_removed18 _) s

theorem compiledZHalf_removed18 {n : Nat} (s : Nat) : removed 18 (compiledZHalf (n := n) s).prog = 0 := by
  rw [compiledZHalf]
  exact CatFn.seq_removed18 _ _ (CatFn.seq_removed18 _ _ (CatFn.noT_removed18 _) compiledZForward_removed18)
    (CatFn.noT_removed18 _) s

theorem compiledBody_removed18 {n : Nat} (divide : Bool) (s : Nat) :
    removed 18 (compiledBody (n := n) divide s).prog = 0 := by
  rw [compiledBody]; cases divide
  · exact CatFn.seq_removed18 _ _ compiledSwapBody_removed18 (compiledHalf_removed18 false) s
  · exact CatFn.seq_removed18 _ _ (compiledHalf_removed18 true) compiledSwapBody_removed18 s

theorem compiledZBody_removed18 {n : Nat} (s : Nat) : removed 18 (compiledZBody (n := n) s).prog = 0 := by
  rw [compiledZBody]; exact CatFn.seq_removed18 _ _ compiledZHalf_removed18 compiledSwapBody_removed18 s

theorem compiledCell_removed18 {n : Nat} (divide : Bool) (g sw : Wire) (s : Nat) :
    removed 18 (compiledCell (n := n) divide g sw s).prog = 0 := by
  rw [compiledCell]
  exact compiledSelW_removed18 _ _ _ (compiledSelW_removed18 _ _ _ (compiledBody_removed18 divide)) s

theorem compiledZCell_removed18 {n : Nat} (g sw : Wire) (s : Nat) :
    removed 18 (compiledZCell (n := n) g sw s).prog = 0 := by
  rw [compiledZCell]
  exact compiledSelW_removed18 _ _ _ (compiledSelW_removed18 _ _ _ compiledZBody_removed18) s

-- ShiftFin (bounded by `measurementCount + toffoliCount`)
private theorem cellLayout_eq : OneBankCell5.ports base (base 2409) = cellLayout := rfl

private theorem swapBody_eq :
    swapRegisters (base 2410) (OneBankCell5.ports base (base 2409)).r (OneBankCell5.ports base (base 2409)).y = SW.swapBody := by
  rw [SW.swapBody]; rfl

private theorem swapBody_def :
    SW.swapBody = swapRegisters (base 2410) cellLayout.r cellLayout.y := swapBody_eq.symm

private theorem swapBodyM_def :
    SW.swapBodyM = UncompSwap.mswap (base 2410) cellLayout.r cellLayout.y := by
  rw [SW.swapBodyM]; rfl

private theorem cell_half_eq (divide : Bool) :
    OneBankCell5.half divide base (base 2409) =
      [.X (base 2409)] ++ (if divide then TopReuse.forward cellLayout else TopReuse.inverse cellLayout) ++ [.X (base 2409)] := by
  unfold OneBankCell5.half OneBankCore5.half OneBankCore5.kernel
  rfl

theorem compiledSwapBody_shiftFin {n : Nat} :
    ShiftFin (compiledSwapBody (n := n)) (ECDSAAdd.measurementCount SW.swapBody + ECDSAAdd.toffoliCount SW.swapBody) := by
  rw [compiledSwapBody]; exact CatFn.compileProg_shiftFin _ _ _

theorem compiledHalf_shiftFin {n : Nat} (divide : Bool) :
    ShiftFin (compiledHalf (n := n) divide)
      (ECDSAAdd.measurementCount (OneBankCell5.half divide base (base 2409)) +
        ECDSAAdd.toffoliCount (OneBankCell5.half divide base (base 2409))) := by
  rw [compiledHalf, cell_half_eq]
  cases divide
  · refine (CatFn.seq_shiftFin _ _ (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _) compiledInverse_shiftFin)
      (CatFn.noT_shiftFin _)).mono ?_
    simp only [Bool.false_eq_true, if_false, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
    have hx : ECDSAAdd.measurementCount [.X (base 2409)] = 0 := rfl
    rw [hx]; omega
  · refine (CatFn.seq_shiftFin _ _ (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _) compiledForward_shiftFin)
      (CatFn.noT_shiftFin _)).mono ?_
    simp only [if_true, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
    have hx : ECDSAAdd.measurementCount [.X (base 2409)] = 0 := rfl
    rw [hx]; omega

theorem compiledHalfE_shiftFin {n : Nat} (divide : Bool) :
    ShiftFin (compiledHalfE (n := n) divide)
      (ECDSAAdd.measurementCount (OneBankCell5.halfE divide base (base 2409)) +
        ECDSAAdd.toffoliCount (OneBankCell5.halfE divide base (base 2409))) := by
  rw [compiledHalfE]; cases divide
  · simp only [Bool.false_eq_true, if_false, OneBankCell5.halfE]
    exact compiledHalf_shiftFin false
  · refine (CatFn.seq_shiftFin _ _ (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _) compiledForwardE_shiftFin)
      (CatFn.noT_shiftFin _)).mono ?_
    simp only [OneBankCell5.halfE_true, cellLayout_eq, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
    have hx : ECDSAAdd.measurementCount [.X (base 2409)] = 0 := rfl
    rw [hx]; omega

theorem compiledZHalf_shiftFin {n : Nat} :
    ShiftFin (compiledZHalf (n := n))
      (ECDSAAdd.measurementCount (FirstZero5.half base (base 2409)) +
        ECDSAAdd.toffoliCount (FirstZero5.half base (base 2409))) := by
  rw [compiledZHalf]
  refine (CatFn.seq_shiftFin _ _ (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin _) compiledZForward_shiftFin)
    (CatFn.noT_shiftFin _)).mono ?_
  simp only [FirstZero5.half, cellLayout_eq, ECDSAAdd.measurementCount_append, ECDSAAdd.toffoliCount_append]
