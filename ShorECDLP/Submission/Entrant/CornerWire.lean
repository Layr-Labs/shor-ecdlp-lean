    rw [hr]; exact x838_meas_zero
  have h1_m : ECDSAAdd.measurementCount (reference2 read a Site1Wire.Wide16.b1.forgetL) = 0 := by
    have hr : reference2 read a Site1Wire.Wide16.b1.forgetL = scrHeadProgram := by
