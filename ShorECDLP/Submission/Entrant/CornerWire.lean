        simp only [Bridge.signedKet, st2, map_smul, smul_smul]; cases next.phase <;> simp
      have hstep := hb a st2 hval
      rw [hfac] at hstep
      rw [show Bridge.signedKet next = (if next.phase then (-1 : ℂ) else 1) • ket next.basis from rfl,
