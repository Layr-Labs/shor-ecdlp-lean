/-! ### Local 4-T Kernel Compiler (`LocalKernel`, Part 2A: Cell Kernel Proofs) -/

section CellProofs

def cellWires : List Wire := base 2409 :: OneBankCell5.ids.map base

private theorem cell_mem_wires (q : Wire) (hq : q ∈ cellLayout.wires) : q ∈ cellWires :=
  (OneBankCell5.mem_ports_wires base (base 2409) q).mp hq

private theorem cell_sub_wires (r : List Wire) (hr : ∀ q ∈ r, q ∈ cellLayout.wires) : r ⊆ cellWires :=
  fun q hq => cell_mem_wires q (hr q hq)

private theorem cell_y_sub : cellLayout.y ⊆ cellWires :=
  cell_sub_wires _ (fun q hq => by
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.y,
      List.mem_append, List.mem_cons] at hq ⊢; tauto)

private theorem cell_r_sub : cellLayout.r ⊆ cellWires :=
  cell_sub_wires _ (fun q hq => by
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.mem_append, List.mem_cons] at hq ⊢; tauto)

private theorem cell_rawTarget_sub : BalancedCircuit.rawTarget cellLayout ⊆ cellWires := by
  intro q hq
  simp only [BalancedCircuit.rawTarget, List.mem_append, List.mem_singleton] at hq
  rcases hq with hq | rfl
  · exact cell_r_sub hq
  · exact cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires])

private theorem cell_source_sub : GuardCompression.source cellLayout ⊆ cellWires := by
  intro q hq
  simp only [GuardCompression.source, List.mem_append, List.mem_singleton] at hq
  rcases hq with hq | rfl
  · exact cell_y_sub hq
  · exact cell_y_sub (by simp [BalancedCleanup.Layout.y])

private theorem cell_carry_sub : cellLayout.carry ⊆ cellWires :=
  cell_sub_wires _ (fun q hq => by
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, List.mem_append, List.mem_cons]
    tauto)

private theorem cell_lower_mem : base 1797 ∈ cellWires :=
  cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, cellLayout_lower])

private theorem cell_one_mem : base 1027 ∈ cellWires :=
  cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, cellLayout_one])

private theorem cell_sign_mem : cellLayout.sign ∈ cellWires :=
  cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires])

private theorem cell_parity_mem : cellLayout.parity ∈ cellWires :=
  cell_mem_wires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires])

private theorem cell_1541_mem : base 1541 ∈ cellWires := cell_carry_sub base_1541_mem_carry
private theorem cell_1026_mem : base 1026 ∈ cellWires := cell_carry_sub base_1026_mem_carry

private theorem wireBlock_getD (w : Nat → Wire) (a n i : Nat) (hi : i < n) :
    (wireBlock w a n).getD i 0 = w (a + i) := by
  have hl : i < (wireBlock w a n).length := by rw [wireBlock_length]; exact hi
  rw [List.getD_eq_getElem _ _ hl]
  simp only [wireBlock, List.getElem_map, List.getElem_range', one_mul]

private theorem cell_rtail_getD253 : cellLayout.rtail.getD 253 0 = base 2310 :=
  wireBlock_getD base 2057 254 253 (by omega)

private theorem cell_r_getD254 : cellLayout.r.getD 254 0 = base 2310 := by
  have hr : cellLayout.r = (base 2056 :: wireBlock base 2057 254) ++ [base 2311] := rfl
  have hl : 254 < (base 2056 :: wireBlock base 2057 254).length := by simp [wireBlock_length]
  rw [hr, List.getD_eq_getElem _ _ (by simp [wireBlock_length]), List.getElem_append_left hl]
  change (wireBlock base 2057 254)[253]'(by rw [wireBlock_length]; omega) = base 2310
  rw [← List.getD_eq_getElem _ 0]
  exact cell_rtail_getD253

private theorem cell_base_ne (a b : Nat) (h : a ≠ b) : base a ≠ base b :=
  fun e => h (MappedCompressed.base_injective e)

private theorem cell_not_r (k : Nat) (hk : k < 2056 ∨ 2312 ≤ k) : base k ∉ cellLayout.r := by
  intro hm
  simp only [cellLayout, OneBankCell5.ports, BalancedCleanup.Layout.r, BalancedCleanup.Layout.low,
    List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map, List.mem_range'_1] at hm
  rcases hm with (e | ⟨i, hi, e⟩) | e <;> (have := MappedCompressed.base_injective e; omega)

private theorem cell_not_low (k : Nat) (hk : k < 2056 ∨ 2311 ≤ k) : base k ∉ cellLayout.low := by
  intro hm
  simp only [cellLayout, OneBankCell5.ports, BalancedCleanup.Layout.low,
    List.mem_cons, wireBlock, List.mem_map, List.mem_range'_1] at hm
  rcases hm with e | ⟨i, hi, e⟩ <;> (have := MappedCompressed.base_injective e; omega)

private theorem cell_not_y (k : Nat) (hk : k < 770 ∨ 1026 ≤ k) : base k ∉ cellLayout.y := by
  intro hm
  simp only [cellLayout, OneBankCell5.ports, BalancedCleanup.Layout.y,
    List.mem_append, List.mem_singleton, wireBlock, List.mem_map, List.mem_range'_1] at hm
  rcases hm with ⟨i, hi, e⟩ | e <;> (have := MappedCompressed.base_injective e; omega)

private theorem cell_not_rawTarget (k : Nat) (hk : k ≠ 1027 ∧ (k < 2056 ∨ 2312 ≤ k)) :
    base k ∉ BalancedCircuit.rawTarget cellLayout := by
  intro hm
  simp only [BalancedCircuit.rawTarget, List.mem_append, List.mem_singleton, cellLayout_one] at hm
  rcases hm with h | h
  · exact cell_not_r k hk.2 h
  · exact hk.1 (MappedCompressed.base_injective h)

private theorem cell_not_carry (k : Nat) (hk : (k < 512 ∨ 765 ≤ k) ∧ k ≠ 1540 ∧ k ≠ 1541 ∧ k ≠ 1026) :
    base k ∉ cellLayout.carry := by
  intro hm
  change base k ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hm
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map,
    List.mem_range'_1] at hm
  rcases hm with ⟨i, hi, he⟩ | he | he | he
  · have := MappedCompressed.base_injective he; omega
  · exact hk.2.1 (MappedCompressed.base_injective he)
  · exact hk.2.2.1 (MappedCompressed.base_injective he)
  · exact hk.2.2.2 (MappedCompressed.base_injective he)

private theorem cell_seed_wires : ECDSAAdd.wires (GuardCompression.seed cellLayout) ⊆ cellWires.toFinset := by
  intro q hq
  simp only [GuardCompression.seed, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
    Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false, or_assoc] at hq
  apply List.mem_toFinset.mpr
  rcases hq with rfl | rfl | rfl | rfl | rfl | rfl
  · exact cell_r_sub (by simp [BalancedCleanup.Layout.r])
  · exact cell_one_mem
  · exact cell_y_sub (by
      change cellLayout.ylow.getD 0 0 ∈ cellLayout.ylow ++ [cellLayout.ymsb]
      apply List.mem_append_left
      have hl : 0 < cellLayout.ylow.length := by rw [cellLayout_widths.2.1]; decide
      rw [List.getD_eq_getElem _ _ hl]; exact List.getElem_mem hl)
  · exact cell_parity_mem
  · exact cell_r_sub (by simp [BalancedCleanup.Layout.r, BalancedCleanup.Layout.low])
  · exact cell_parity_mem

private theorem cell_seed_avoid (k : Nat) (hk : k ≠ 2311 ∧ k ≠ 1027 ∧ k ≠ 770 ∧ k ≠ 768 ∧ k ≠ 2056) :
    base k ∉ ECDSAAdd.wires (GuardCompression.seed cellLayout) := by
  intro hq
  have hy0 : cellLayout.ylow.getD 0 0 = base 770 := wireBlock_getD base 770 255 0 (by omega)
  have hr0 : cellLayout.r0 = base 2056 := rfl
  have hrm : cellLayout.rmsb = base 2311 := rfl
  simp only [GuardCompression.seed, hy0, hr0, hrm, cellLayout_one, cellLayout_parity,
    ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
    Finset.notMem_empty, or_false, or_assoc] at hq
  rcases hq with e | e | e | e | e | e <;>
    exact (by have := MappedCompressed.base_injective e; omega)

private theorem cell_signComp_y_wires :
    ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y) ⊆ cellWires.toFinset := by
  intro q hq
  have h := signComplement_wires_subset cellLayout.sign cellLayout.y hq
  simp only [List.mem_toFinset, List.mem_cons] at h ⊢
  rcases h with rfl | h
  · exact cell_sign_mem
  · exact cell_y_sub h

private theorem cell_signComp_y_avoid (k : Nat) (hk : k ≠ 2409 ∧ (k < 770 ∨ 1026 ≤ k)) :
    base k ∉ ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y) := by
  intro hm
  have h := signComplement_wires_subset cellLayout.sign cellLayout.y hm
  simp only [List.mem_toFinset, List.mem_cons, cellLayout_sign] at h
  rcases h with e | h
  · exact hk.1 (MappedCompressed.base_injective e)
  · exact cell_not_y k hk.2 h

private theorem cell_signComp_y_toff :
    ECDSAAdd.toffoliCount (signComplement cellLayout.sign cellLayout.y) = 0 :=
  (signComplement_counts _ _).1

private theorem cell_signComp_y_meas :
    ECDSAAdd.measurementCount (signComplement cellLayout.sign cellLayout.y) = 0 :=
  (signComplement_counts _ _).2

private theorem cell_notRaw_wires :
    ECDSAAdd.wires (Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) ⊆ cellWires.toFinset := by
  rw [notRegister_wires]
  intro q hq; exact List.mem_toFinset.mpr (cell_rawTarget_sub (List.mem_toFinset.mp hq))

private theorem cell_notRaw_avoid (k : Nat) (hk : k ≠ 1027 ∧ (k < 2056 ∨ 2312 ≤ k)) :
    base k ∉ ECDSAAdd.wires (Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) := by
  rw [notRegister_wires]; intro hm; exact cell_not_rawTarget k hk (List.mem_toFinset.mp hm)

private theorem cell_mappedWires_lowBits :
    ∀ q ∈ mappedWires (ShortBiasedFold.lowBits cellLayout), q = base 1797 := by
  have hsub : ShortBiasedFold.lowBits cellLayout =
      (List.range 255).map (fun i => { wire := some (base 1797), flip := BiasedCircuit.jh.testBit i }) := by
    simp only [ShortBiasedFold.lowBits, BiasedCircuit.biasBits, cellLayout_lower, List.take_append,
      List.length_map, List.length_range, Nat.sub_self, List.take_zero, List.append_nil]
    exact List.take_of_length_le (by simp)
  rw [hsub]
  intro q hq
  simp only [mappedWires, List.mem_flatMap, List.mem_map] at hq
  obtain ⟨b, ⟨i, _, rfl⟩, hqb⟩ := hq
  simp only [Option.toList, List.mem_singleton] at hqb
  exact hqb

private theorem cell_remainder_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (OneReuse.remainder cellLayout) := by
  have h1 : base k ∉ ECDSAAdd.wires (OneReuse.newPrepare cellLayout) := by
    intro hm
    have hr0 : cellLayout.r0 = base 2056 := rfl
    simp only [OneReuse.newPrepare, cellLayout_one, cellLayout_lower, cellLayout_parity, hr0,
      ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
      Finset.notMem_empty, or_false, MappedCompressed.base_injective.eq_iff] at hm
    omega
  have h2 : base k ∉ ECDSAAdd.wires (rotateRight (BalancedCircuit.rawTarget cellLayout)) := by
    rw [(rotate_wires _).1]
    split_ifs
    · simp
    · intro hm; exact cell_not_rawTarget k ⟨by omega, by omega⟩ (List.mem_toFinset.mp hm)
  have h3 : base k ∉ ECDSAAdd.wires (OneReuse.foldWindow cellLayout) := by
    have hma : base k ∉ ECDSAAdd.wires (mappedAdd (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) := by
      intro hm
      have hsub := mappedAdd_wires_subset _ _ _ _ hm
      simp only [List.mem_toFinset, List.mem_append, List.mem_singleton, cellLayout_one] at hsub
      rcases hsub with ((h | h) | h) | h
      · have := cell_mappedWires_lowBits _ h; have := MappedCompressed.base_injective this; omega
      · exact cell_not_low k (by omega) h
      · exact cellLayout_carry_take254_ne k hk h
      · have := MappedCompressed.base_injective h; omega
    have hrm : cellLayout.rmsb = base 2311 := rfl
    intro hm
    simp only [OneReuse.foldWindow, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with (h | h) | h
    · simp only [cellLayout_parity, cellLayout_lower, cellLayout_one, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
        Finset.mem_union, Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false,
        MappedCompressed.base_injective.eq_iff] at h
      omega
    · exact hma h
    · simp only [cellLayout_parity, cellLayout_lower, cellLayout_one, hrm, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
        ECDSAAdd.correctionWires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
        Finset.notMem_empty, or_false, MappedCompressed.base_injective.eq_iff] at h
      omega
  have h4 : base k ∉ ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout) := by
    have hrm : cellLayout.toLayout.rmsb = base 2311 := rfl
    intro hm
    simp only [BalancedCleanup.prepareSign, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with h | h
    · simp only [hrm, cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
        Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at h
      rcases h with e | e <;> (have := MappedCompressed.base_injective e; omega)
    · have hs := signComplement_wires_subset _ _ h
      simp only [List.mem_toFinset, List.mem_cons, cellLayout_lower] at hs
      rcases hs with e | hr
      · have := MappedCompressed.base_injective e; omega
      · exact cell_not_r k (by omega) hr
  have h5 : base k ∉ ECDSAAdd.wires (BiasedCircuit.flipBias cellLayout) := by
    intro hm
    simp only [BiasedCircuit.flipBias, cell_rtail_getD253, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
      Finset.mem_union, Finset.mem_singleton, Finset.notMem_empty, or_false] at hm
    have := MappedCompressed.base_injective hm; omega
  simp only [OneReuse.remainder, ECDSAAdd.wires_append, Finset.mem_union]
  tauto

private theorem cell_prepCmp_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) :=
  EndKnown.prepareCompare_away cellLayout.toLayout cellLayout_widths (base k)
    (cell_not_r k (by omega)) (cell_not_y k (by omega))
    (cell_base_ne k 2409 (by omega)) (cell_base_ne k 1797 (by omega))

private theorem cell_prepSign_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout) := by
  have hrm : cellLayout.toLayout.rmsb = base 2311 := rfl
  intro hm
  simp only [BalancedCleanup.prepareSign, ECDSAAdd.wires_append, Finset.mem_union] at hm
  rcases hm with h | h
  · simp only [hrm, cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at h
    rcases h with e | e <;> (have := MappedCompressed.base_injective e; omega)
  · have hs := signComplement_wires_subset _ _ h
    simp only [List.mem_toFinset, List.mem_cons, cellLayout_lower] at hs
    rcases hs with e | hr
    · have := MappedCompressed.base_injective e; omega
    · exact cell_not_r k (by omega) hr

private theorem cell_norm_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (BalancedCleanup.normalize cellLayout.toLayout) := by
  intro hm
  have hs := literalConstAdd_wires _ _ _ _ _ hm
  simp only [List.mem_toFinset, List.mem_cons, List.mem_append, cellLayout_one, cellLayout_lower] at hs
  rcases hs with e | e | hr | hc
  · have := MappedCompressed.base_injective e; omega
  · have := MappedCompressed.base_injective e; omega
  · exact cell_not_low k (by omega) hr
  · exact cellLayout_carry_take254_ne k hk hc

private theorem cell_unnorm_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (BalancedCleanup.unnormalize cellLayout.toLayout) := by
  intro hm
  simp only [BalancedCleanup.unnormalize, ECDSAAdd.wires_append, Finset.mem_union] at hm
  rcases hm with (h | h) | h
  · simp only [cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at h
    have := MappedCompressed.base_injective h; omega
  · have hs := literalConstAdd_wires _ _ _ _ _ h
    simp only [List.mem_toFinset, List.mem_cons, List.mem_append, cellLayout_one, cellLayout_lower] at hs
    rcases hs with e | e | hr | hc
    · have := MappedCompressed.base_injective e; omega
    · have := MappedCompressed.base_injective e; omega
    · exact cell_not_low k (by omega) hr
    · exact cellLayout_carry_take254_ne k hk hc
  · simp only [cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at h
    have := MappedCompressed.base_injective h; omega

private theorem cell_unnormE_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (TopReuse.unnormalizeE cellLayout.toLayout) := by
  intro hm
  have hw := (BalancedCleanup.widths cellLayout.toLayout cellLayout_widths)
  simp only [TopReuse.unnormalizeE, ECDSAAdd.wires_append, Finset.mem_union] at hm
  rcases hm with (h | h) | h
  · simp only [cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at h
    have := MappedCompressed.base_injective h; omega
  · have hs := EndKnown.addK_wires cellLayout.low cellLayout.ylow (cellLayout.carry.take 254)
      cellLayout.ymsb cellLayout.lower cellLayout.one BalancedCleanup.positiveLiteral (by omega) h
    rcases Finset.mem_union.mp hs with h1 | h2
    · have hl := literalConstAdd_wires _ _ _ _ _ h1
      simp only [List.mem_toFinset, List.mem_cons, List.mem_append, cellLayout_one, cellLayout_lower] at hl
      rcases hl with e | e | hr | hc
      · have := MappedCompressed.base_injective e; omega
      · have := MappedCompressed.base_injective e; omega
      · exact cell_not_low k (by omega) hr
      · exact cellLayout_carry_take254_ne k hk hc
    · simp only [List.mem_toFinset, List.mem_cons] at h2
      rcases h2 with e | hy
      · exact cell_not_y k (by omega) (by rw [e]; simp [BalancedCleanup.Layout.y])
      · exact cell_not_y k (by omega) (by simp [BalancedCleanup.Layout.y, hy])
  · simp only [cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at h
    have := MappedCompressed.base_injective h; omega

private theorem cell_zTail_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (FirstZero5.tail cellLayout) := by
  intro hm
  simp only [FirstZero5.tail, ECDSAAdd.wires_append, Finset.mem_union] at hm
  rcases hm with h | h | h | h
  · simp only [FirstZero5.eraseParity, cell_rtail_getD253, cellLayout_parity, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
      Finset.mem_union, Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false, or_assoc] at h
    rcases h with e | e | e <;> (have := MappedCompressed.base_injective e; omega)
  · exact cell_unnorm_avoid k hk h
  · rw [ECDSAAdd.wires_reverse] at h; exact cell_prepSign_avoid k hk h
  · have hrp := (FirstZero5.rep_facts 256 cellLayout.one).2.2.2.1 h
    simp only [Finset.mem_singleton, cellLayout_one] at hrp
    have := MappedCompressed.base_injective hrp; omega

private theorem cell_unbias_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (BiasedInverse.unbiasView cellLayout) := by
  intro hm
  simp only [BiasedInverse.unbiasView, ECDSAAdd.wires_append, Finset.mem_union] at hm
  rcases hm with h | h
  · have hr254 : cellLayout.r.getD 254 0 ∈ cellLayout.r := by
      have hl : 254 < cellLayout.r.length := by rw [(BalancedCleanup.widths cellLayout.toLayout cellLayout_widths).2.1]; decide
      rw [List.getD_eq_getElem _ _ hl]; exact List.getElem_mem hl
    simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_singleton,
      Finset.notMem_empty, or_false] at h
    exact cell_not_r k (by omega) (h ▸ hr254)
  · rw [ECDSAAdd.wires_reverse] at h; exact cell_prepSign_avoid k hk h

private theorem cell_restoreRaw_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (OneReuse.restoreRaw cellLayout) := by
  have h1 : base k ∉ ECDSAAdd.wires (OneReuse.unfoldWindow cellLayout) := by
    have hms : base k ∉ ECDSAAdd.wires (mappedSub (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) := by
      intro hm
      simp only [mappedSub, ECDSAAdd.wires_append, Finset.mem_union, notRegister_wires] at hm
      rcases hm with (h | h) | h
      · exact cell_not_low k (by omega) (List.mem_toFinset.mp h)
      · have hsub := mappedAdd_wires_subset _ _ _ _ h
        simp only [List.mem_toFinset, List.mem_append, List.mem_singleton, cellLayout_one] at hsub
        rcases hsub with ((h' | h') | h') | h'
        · have := cell_mappedWires_lowBits _ h'; have := MappedCompressed.base_injective this; omega
        · exact cell_not_low k (by omega) h'
        · exact cellLayout_carry_take254_ne k hk h'
        · have := MappedCompressed.base_injective h'; omega
      · exact cell_not_low k (by omega) (List.mem_toFinset.mp h)
    have hrm : cellLayout.rmsb = base 2311 := rfl
    intro hm
    simp only [OneReuse.unfoldWindow, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with (h | h) | h
    · simp only [cellLayout_parity, cellLayout_lower, cellLayout_one, hrm, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
        Finset.mem_union, Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false, or_assoc] at h
      rcases h with e | e | e | e | e | e | e <;> (have := MappedCompressed.base_injective e; omega)
    · exact hms h
    · simp only [cellLayout_parity, cellLayout_lower, cellLayout_one, hrm, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
        ECDSAAdd.correctionWires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
        Finset.notMem_empty, or_false, or_assoc] at h
      rcases h with e | e | e | e | e | e | e <;> (have := MappedCompressed.base_injective e; omega)
  have h2 : base k ∉ ECDSAAdd.wires (rotateLeft (BalancedCircuit.rawTarget cellLayout)) := by
    rw [(rotate_wires _).2]
    split_ifs
    · simp
    · intro hm; exact cell_not_rawTarget k ⟨by omega, by omega⟩ (List.mem_toFinset.mp hm)
  have h3 : base k ∉ ECDSAAdd.wires ([.CX cellLayout.parity cellLayout.r0] : ECDSAAdd.Program) := by
    have hr0 : cellLayout.r0 = base 2056 := rfl
    intro hm
    simp only [cellLayout_parity, hr0, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hm
    rcases hm with e | e <;> (have := MappedCompressed.base_injective e; omega)
  simp only [OneReuse.restoreRaw, ECDSAAdd.wires_append, Finset.mem_union]
  tauto

/-! ##### Physicality extraction for cell sub-programs -/

private theorem cell_fwd_parts_phys :
    ECDSAAdd.Arithmetic.GatePhysical (GuardCompression.seed cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (GuardCompression.rawAdd cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (OneReuse.remainder cellLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.prepareCompare cellLayout.toLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.unnormalize cellLayout.toLayout) ∧
    ECDSAAdd.Arithmetic.GatePhysical (BalancedCleanup.prepareSign cellLayout.toLayout).reverse := by
  have h := TopReuse.forward_physical cellLayout cellLayout_widths cellLayout_nodup
  simp only [TopReuse.forward, TopReuse.cleanup, gatePhysical_append] at h
  exact ⟨h.1.1.1, h.1.1.2, h.1.2, h.2.1, h.2.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2⟩

