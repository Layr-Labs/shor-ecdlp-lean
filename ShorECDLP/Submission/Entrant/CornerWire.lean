  · exact CatFn.seq_indep _ _ (compiledGroups_indep false 1 E.nGroups) (compiledFirstPacket_indep false) s
  · exact CatFn.seq_indep _ _ (compiledFirstPacket_indep true) (compiledGroups_indep true 1 E.nGroups) s

