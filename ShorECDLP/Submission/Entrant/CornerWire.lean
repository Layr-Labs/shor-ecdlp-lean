-- Slots
theorem compiledSwapBody_slots {n : Nat} (s : Nat) :
    (compiledSwapBody (n := n) s).prog.gateSlots ≤ 30000 := by
  have w := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
  have hlen : cellLayout.r.length = cellLayout.y.length := w.2.1.trans w.2.2.1.symm
  have hres := swapRegisters_resources (base 2410) cellLayout.r cellLayout.y hlen cell_swap_nodup
  have hgs : ECDSAAdd.Challenge.gateSlots SW.swapBody = 3 * 256 := by
    rw [← swapBody_eq]
    change ECDSAAdd.Challenge.gateSlots (swapRegisters (base 2410) cellLayout.r cellLayout.y) = _
    rw [ECDSAAdd.Baselines.swapRegisters_gateSlots, w.2.1, w.2.2.1]; rfl
  have htf : ECDSAAdd.toffoliCount SW.swapBody = 256 := by
    rw [← swapBody_eq]
    change ECDSAAdd.toffoliCount (swapRegisters (base 2410) cellLayout.r cellLayout.y) = 256
    rw [hres.1, w.2.1]
  rw [compiledSwapBody]
  exact (CatFn.compileProg_slots _ _ _ s).trans (by rw [hgs, htf]; omega)

