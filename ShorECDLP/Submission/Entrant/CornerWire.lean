private theorem compiledCell_avoid4 {n : Nat} (divide : Bool) (g sw : Wire)
    (hg : avoid4 g) (hsw : avoid4 sw) (s : Nat) :
    ∀ w ∈ ChallengeMigration.straightWires (compiledCell (n := n) divide g sw s).prog, avoid4 w := by
  let S : List Wire := g :: sw :: base 2410 :: cellWiresNo4
  have hS : ∀ w ∈ S, avoid4 w := fun w hw => by
    simp only [S, List.mem_cons] at hw
    rcases hw with rfl | rfl | rfl | hw
    · exact hg
    · exact hsw
    · exact base_avoid4 2410 (by omega)
    · exact ((mem_cellWiresNo4 w).mp hw).2
  have hbody (s' : Nat) : ChallengeMigration.straightWires (compiledBody (n := n) divide s').prog ⊆ S := by
    have hsub : base 2410 :: cellWiresNo4 ⊆ S := fun w hw => by simp [S, hw]
    have hsub0 : cellWiresNo4 ⊆ S := fun w hw => hsub (List.mem_cons_of_mem _ hw)
    rw [compiledBody]; cases divide
    · exact CatFn.seq_wires _ _ (fun s'' => (compiledSwapBody_wires_no4 s'').trans hsub)
        (fun s'' => (compiledHalf_wires_no4 false s'').trans hsub0) s'
    · exact CatFn.seq_wires _ _
        (fun s'' => (compiledHalf_wires_no4 true s'').trans hsub0)
        (fun s'' => (compiledSwapBody_wires_no4 s'').trans hsub) s'
  have hcell : ChallengeMigration.straightWires (compiledCell (n := n) divide g sw s).prog ⊆ S := by
    rw [compiledCell]
    exact compiledSelW_wires g (base 2409) _ (by simp [S])
      (by simp [S, cell_base_no4_mem 2409 (Or.inl rfl)])
      (compiledSelW_wires sw (base 2410) _ (by simp [S]) (by simp [S]) hbody) s
  exact fun w hw => hS w (hcell hw)

