theorem clearData_loaded_of_xor {n : Nat} (read : ConstantBit n → Bool) (ps : List (LookupPort n))
    (a : Nat) (s0 s1 : BasisState)
    (hnd : (portTargets ps).Nodup)
    (hcl0 : Clean (portTargets ps) s0)
    (heq : ∀ w ∈ portTargets ps, s1 w = tableXorState (portMask read ps a) true s0 w) :
    ∀ q ∈ clearData ps, s1 q.target = decide (read (q.ref a) = q.value) := by
  intro q hq
  rw [clearData] at hq
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hq
  have hpt : p.target ∈ portTargets ps := List.mem_map.mpr ⟨p, hp, rfl⟩
  change s1 p.target = decide (read (p.ref a) = p.value)
  rw [heq p.target hpt]
  dsimp only [tableXorState]
  rw [port_selected read ps a hnd p hp, hcl0 p.target hpt]
  simp only [Bool.true_and, Bool.false_xor]

theorem clearRegister_eq_xor_of_loaded {n : Nat} (read : ConstantBit n → Bool) (ps : List (LookupPort n))
    (a : Nat) (s : BasisState)
    (hnd : (portTargets ps).Nodup)
    (hload : ∀ q ∈ clearData ps, s q.target = decide (read (q.ref a) = q.value)) :
    clearRegister (portTargets ps) s = tableXorState (portMask read ps a) true s := by
  funext w
  by_cases hw : w ∈ portTargets ps
  · rw [clearRegister_clean (portTargets ps) s w hw]
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hw
    have hL : s p.target = decide (read (p.ref a) = p.value) :=
      hload ⟨p.ref, p.value, p.target⟩ (by rw [clearData]; exact List.mem_map.mpr ⟨p, hp, rfl⟩)
    dsimp only [tableXorState]
    rw [port_selected read ps a hnd p hp, hL, Bool.true_and, Bool.xor_self]
  · rw [MeasuredClear.clearRegister_frame (portTargets ps) s w hw]
    exact (tableXorState_outside _ _ _ _ (fun hm => hw (tableBitsMask_subset _ _ hm))).symm


def portPhase {n : Nat} (data : List (MeasuredClear.ClearPort n)) (outcomes : List Bool)
    (read : ConstantBit n → Bool) (a : Nat) : ℂ :=
  match data, outcomes with
  | q :: qs, o :: os =>
      (if o && decide (read (q.ref a) = q.value) then -1 else 1) * portPhase qs os read a
  | _, _ => 1

theorem portPhase_append {n : Nat} (d1 d2 : List (MeasuredClear.ClearPort n)) (o1 o2 : List Bool)
    (hl : o1.length = d1.length) (read : ConstantBit n → Bool) (a : Nat) :
    portPhase (d1 ++ d2) (o1 ++ o2) read a = portPhase d1 o1 read a * portPhase d2 o2 read a := by
  induction d1 generalizing o1 with
  | nil =>
    cases o1 with
    | nil => simp [portPhase]
    | cons _ _ => simp at hl
  | cons q qs ih =>
    cases o1 with
    | nil => simp at hl
    | cons o os =>
      simp only [List.cons_append, portPhase, mul_assoc, ih os (by simpa using hl)]

theorem portPhase_eq_registerXPhase {n : Nat} (data : List (MeasuredClear.ClearPort n)) (outcomes : List Bool)
    (read : ConstantBit n → Bool) (a : Nat) (u : BasisState)
    (hu : ∀ q ∈ data, u q.target = decide (read (q.ref a) = q.value)) :
    portPhase data outcomes read a = registerXPhase (data.map MeasuredClear.ClearPort.target) outcomes u := by
  induction data generalizing outcomes with
  | nil => simp [portPhase, registerXPhase]
  | cons q qs ih =>
    cases outcomes with
    | nil => simp [portPhase, registerXPhase]
    | cons o os =>
      simp only [List.map_cons, portPhase, registerXPhase, hu q List.mem_cons_self]
      rw [ih os (fun q' hq' => hu q' (List.mem_cons_of_mem _ hq'))]

theorem fixupFactor8_eq_portPhase {n : Nat} (data : List (MeasuredClear.ClearPort n)) (outcomes : List Bool)
    (hl : outcomes.length = data.length)
    (read : ConstantBit n → Bool) (low : Fin 8 → Wire) (hot : Fin 256 → Wire)
    (tree : UnaryActionTree) (root : Wire) (paths : List Wire)
    (hi : Function.Injective hot) (hdlow : ∀ i j, low i ≠ hot j)
    (hbank : (MeasuredClear.hotBank8 hot).Disjoint (root :: tree.indexWires.dedup ++ paths))
    (t : BasisState) (a : Nat) (hhot : MeasuredClear.HotClean8 hot t)
    (haddr : 256 * tree.routeLabel t + MeasuredClear.hotAddress8 low t = a)
    (hroot : t root = true) :
    MeasuredClear.fixupFactor8 data outcomes read low hot tree root t =
      portPhase data outcomes read a := by
  induction data generalizing outcomes with
  | nil =>
    cases outcomes with
    | nil =>
      have h0 := MeasuredClear.fixupFactor8_loaded (List.nil : List (MeasuredClear.ClearPort n)) List.nil
        read low hot tree root paths hi hdlow hbank t (fun _ => false) hhot (by simp)
      simpa [portPhase, registerXPhase] using h0
    | cons _ _ => simp at hl
  | cons q qs ih =>
    cases outcomes with
    | nil => simp at hl
    | cons o os =>
      have hsp := MeasuredClear.fixupFactor8_append (q :: List.nil) qs (o :: List.nil) os rfl
        read low hot tree root t
      have h1 := MeasuredClear.fixupFactor8_loaded (q :: List.nil) (o :: List.nil)
        read low hot tree root paths hi hdlow hbank t (fun _ => decide (read (q.ref a) = q.value)) hhot (by
          intro p hp
          simp only [List.mem_singleton] at hp
          subst hp
          rw [haddr, hroot, Bool.true_and])
      have h2 := ih os (by simpa using hl)
      simpa only [List.cons_append, List.nil_append, portPhase, registerXPhase, List.map_cons, List.map_nil, mul_one] using
        hsp.trans (congrArg₂ (· * ·) h1 h2)


theorem fixupFactor9_eq_portPhase {n : Nat} (data : List (MeasuredClear.ClearPort n)) (outcomes : List Bool)
    (hl : outcomes.length = data.length)
    (read : ConstantBit n → Bool) (low : Fin 9 → Wire) (hot : Fin 512 → Wire)
    (tree : UnaryActionTree) (root : Wire) (paths : List Wire)
    (hi : Function.Injective hot) (hdlow : ∀ i j, low i ≠ hot j)
    (hbank : (MeasuredClear.hotBank9 hot).Disjoint (root :: tree.indexWires.dedup ++ paths))
    (t : BasisState) (a : Nat) (hhot : MeasuredClear.HotClean9 hot t)
    (haddr : 512 * tree.routeLabel t + MeasuredClear.hotAddress9 low t = a)
    (hroot : t root = true) :
    MeasuredClear.fixupFactor9 data outcomes read low hot tree root t =
      portPhase data outcomes read a := by
  let prepared := Classical.run (MeasuredClear.hotPrepare9 low hot) t
  have hframe (w : Wire) (hw : w ∈ root :: tree.indexWires.dedup ++ paths) : prepared w = t w :=
    MeasuredClear.hotPrepare_frame9 low hot t w (fun i he =>
      List.disjoint_left.mp hbank (List.mem_ofFn.mpr ⟨i, he.symm⟩) hw)
  have hrt : prepared root = true := (hframe root (by simp)).trans hroot
  have hroute : tree.routeLabel prepared = tree.routeLabel t :=
    tree.routeLabel_congr prepared t (fun w hw => hframe w (by simp [hw]))
  let selected : Fin 512 := ⟨MeasuredClear.hotAddress9 low t, MeasuredClear.hotAddress_bound9 low t⟩
  have hmark : ∀ i, prepared (hot i) = decide (i = selected) := fun i => by
    simpa only [Fin.ext_iff] using MeasuredClear.hotPrepare_marker9 low hot hi hdlow t hhot i
  change MeasuredClear.phaseLookupFactor (MeasuredClear.logicalPorts9 data outcomes hot) read
      MeasuredClear.boolHistory tree root prepared = portPhase data outcomes read a
  unfold MeasuredClear.phaseLookupFactor
  induction data generalizing outcomes with
  | nil =>
    cases outcomes with
    | nil =>
      simp only [MeasuredClear.logicalPorts9, MeasuredClear.phasePorts9, List.zip_nil_right,
        List.flatMap_nil, MeasuredClear.recordTargets, List.filter_nil, List.filterMap_nil,
        MeasuredClear.xorPhase, List.map_nil, List.prod_nil, portPhase]
    | cons _ _ => simp at hl
  | cons q qs ih =>
    cases outcomes with
    | nil => simp at hl
    | cons o os =>
      rw [MeasuredClear.logicalPorts_cons9, MeasuredClear.recordTargets_append, MeasuredClear.xorPhase_append,
        MeasuredClear.phasePorts_block9 q o hot read (tree.routeLabel prepared) root prepared selected hmark,
        hrt, Bool.true_and, ih os (by simpa using hl), hroute, haddr]
      rfl


/-- Lower and catalyst-compile any closed `Straight n 0 R` into a shift-invariant `CatFn n`. -/
def CatFn.lower {n R : Nat} (q y : Wire) (p0 : Straight n 0 R) : CatFn n :=
  fun start =>
    let r := compileLower q y p0 start Fin.elim0
    ⟨r.finish, r.program⟩

theorem CatFn.lower_indep {n R : Nat} (q y : Wire) (p0 : Straight n 0 R) (s : Nat) :
    Indep (CatFn.lower q y p0 s).prog := by
  intro read h₁ h₂
  have heq := compileLower_inst_indep q y p0 s Fin.elim0 read h₁ h₂ (fun i => Fin.elim0 i)
  exact ⟨congrArg AdaptiveCircuit.run heq, congrArg AdaptiveCircuit.tCount heq⟩

theorem CatFn.lower_removed18 {n R : Nat} (q y : Wire) (p0 : Straight n 0 R)
    (hres : AndGadget.residue p0 = 0) (s : Nat) :
    removed 18 (CatFn.lower q y p0 s).prog = 0 := by
  rw [CatFn.lower, compileLower_removed18]
  exact removed18_zero_of_residue p0 hres

theorem CatFn.lower_finish {n R : Nat} (q y : Wire) (p0 : Straight n 0 R) (s : Nat) :
    (CatFn.lower q y p0 s).finish = s + (R + AndGadget.added p0) := by
  have h := compileLower_finish q y p0 s Fin.elim0
  change (CatFn.lower q y p0 s).finish + 0 = s + R + AndGadget.added p0 at h
  omega

theorem CatFn.lower_shiftFin {n R : Nat} (q y : Wire) (p0 : Straight n 0 R) :
    ShiftFin (CatFn.lower q y p0) (R + AndGadget.added p0) :=
  ShiftFin.of_exact (CatFn.lower_finish q y p0) le_rfl

theorem CatFn.lower_tCount {n R : Nat} (q y : Wire) (p0 : Straight n 0 R)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.lower q y p0 s).prog.instantiate read h).tCount ≤ ConditionalCatalyst.weight4 p0 :=
  compileLower_tCount q y p0 s Fin.elim0 read h

theorem added_eq_of_residue_tCount {n R : Nat} (p0 : Straight n 0 R) (tp : Nat)
    (hres : AndGadget.residue p0 = 0)
    (ht : (p0.instantiate (fun _ => false) Fin.elim0).tCount = 7 * tp) :
    AndGadget.added p0 = tp := by
  have he := WEXCredit.exact_t p0 hres (fun _ => false) Fin.elim0
  exact Nat.eq_of_mul_eq_mul_left (by decide : 0 < 7) (he.symm.trans ht)

theorem CatFn.lower_tCount_of_credit {n R : Nat} (q y : Wire) (p0 : Straight n 0 R) (tp : Nat)
    (hres : AndGadget.residue p0 = 0)
    (ht : (p0.instantiate (fun _ => false) Fin.elim0).tCount = 7 * tp)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.lower q y p0 s).prog.instantiate read h).tCount ≤ 4 * tp := by
  have ha := added_eq_of_residue_tCount p0 tp hres ht
  have hw := ConditionalCatalyst.weight4_zero p0 hres
  rw [ha] at hw
  exact (CatFn.lower_tCount q y p0 s read h).trans (le_of_eq hw)

theorem CatFn.lower_shiftFin_of_credit {n R : Nat} (q y : Wire) (p0 : Straight n 0 R) (tp : Nat)
    (hres : AndGadget.residue p0 = 0)
    (ht : (p0.instantiate (fun _ => false) Fin.elim0).tCount = 7 * tp) :
    ShiftFin (CatFn.lower q y p0) (R + tp) := by
  have ha := added_eq_of_residue_tCount p0 tp hres ht
  simpa [ha] using CatFn.lower_shiftFin q y p0

theorem CatFn.lower_slots {n R : Nat} (q y : Wire) (p0 : Straight n 0 R) (s : Nat) :
    (CatFn.lower q y p0 s).prog.gateSlots ≤ 4 * (p0.gateSlots + 18 * AndGadget.added p0) :=
  compileLower_slots q y p0 s Fin.elim0

theorem CatFn.lower_wires {n R : Nat} (q y : Wire) (p0 : Straight n 0 R) {S : List Wire}
    (hp : ChallengeMigration.straightWires p0 ⊆ S) (hq : q ∈ S) (hy : y ∈ S) (s : Nat) :
    ChallengeMigration.straightWires (CatFn.lower q y p0 s).prog ⊆ S :=
  compileLower_straightWires q y p0 S hp hq hy s Fin.elim0

theorem CatFn.lower_wellFormed {n R : Nat} (q y : Wire) (p0 : Straight n 0 R)
    (hq : q ∉ ChallengeMigration.straightWires p0) (hy : y ∉ ChallengeMigration.straightWires p0)
    (hqy : q ≠ y) (hp : p0.WellFormed) (s : Nat) :
    (CatFn.lower q y p0 s).prog.WellFormed :=
  compileLower_wellFormed q y p0 s Fin.elim0
    (fresh_of_not_mem_straightWires q p0 hq) (fresh_of_not_mem_straightWires y p0 hy) hqy hp

theorem CatFn.lower_lift_raw {n R : Nat} (q y : Wire) (p0 : Straight n 0 R)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (hp : p0.WellFormed) (hq : q ∉ ChallengeMigration.straightWires p0)
    (hy : y ∉ ChallengeMigration.straightWires p0) (hqy : q ≠ y)
    (P : InstrumentBranch → ℂ → Prop) (cs : List ℂ)
    (hal : List.Forall₂ P (p0.instantiate read Fin.elim0).run cs) :
    ∃ cs' : List ℂ,
      List.Forall₂ (fun b' c' => ∃ b c α, P b c ∧ c' = α * c ∧ BranchLift q y b' b α)
        ((CatFn.lower q y p0 s).prog.instantiate read h).run cs' ∧
      (cs'.map Complex.normSq).sum = (cs.map Complex.normSq).sum :=
  compileLower_lift_raw q y p0 s Fin.elim0 read Fin.elim0 h (fun i => Fin.elim0 i) hp
    (fresh_of_not_mem_straightWires q p0 hq) (fresh_of_not_mem_straightWires y p0 hy) hqy P cs hal

theorem CatFn.lower_catCoherent {n R : Nat} (q y : Wire) (p0 : Straight n 0 R)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (hp : p0.WellFormed) (hq : q ∉ ChallengeMigration.straightWires p0)
    (hy : y ∉ ChallengeMigration.straightWires p0) (hqy : q ≠ y)
    (U : State →ₗ[ℂ] State) (V : BasisState → Prop)
    (hclean : ∀ bs, V bs → bs q = false ∧ bs y = false)
    (hcoh : CoherentlyImplementsOn (p0.instantiate read Fin.elim0) U V) :
    CatCoherent y ((CatFn.lower q y p0 s).prog.instantiate read h) U V :=
  compileLower_catCoherent q y p0 s Fin.elim0 read Fin.elim0 h (fun i => Fin.elim0 i) hp
    (fresh_of_not_mem_straightWires q p0 hq) (fresh_of_not_mem_straightWires y p0 hy) hqy U V hclean hcoh

theorem CatFn.lower_catLitSim {n R : Nat} (q y : Wire) (p0 : Straight n 0 R)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (hp : p0.WellFormed) (hq : q ∉ ChallengeMigration.straightWires p0)
    (hy : y ∉ ChallengeMigration.straightWires p0) (hqy : q ≠ y)
    (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hclean : ∀ bs, V bs → bs q = false ∧ bs y = false)
    (hsim : ∃ cs : List ℂ, List.Forall₂
      (fun b c => ∃ m : List Bool, m.length = ECDSAAdd.measurementCount P ∧
        ∀ st : ECDSAAdd.State, V st.basis →
          b.kraus (Bridge.signedKet st) = c • Bridge.signedKet (ECDSAAdd.run P m st))
      (p0.instantiate read Fin.elim0).run cs ∧ (cs.map Complex.normSq).sum = 1) :
    CatLitSim y ((CatFn.lower q y p0 s).prog.instantiate read h) P V :=
  compileLower_catLitSim q y p0 s Fin.elim0 read Fin.elim0 h (fun i => Fin.elim0 i) hp
    (fresh_of_not_mem_straightWires q p0 hq) (fresh_of_not_mem_straightWires y p0 hy) hqy P V hclean hsim

attribute [local irreducible] CatFn.lower


-- `patchOut`: replaces basis bits outside `S` by `bg`, commuting with any program supported in `S`
def patchBasis (S : Finset Wire) (bg u : BasisState) : BasisState :=
  fun w => if w ∈ S then u w else bg w

def patchOut (S : Finset Wire) (bg : BasisState) : State →ₗ[ℂ] State :=
  Finsupp.lmapDomain ℂ ℂ (patchBasis S bg)

theorem patchOut_ket (S : Finset Wire) (bg u : BasisState) :
    patchOut S bg (ket u) = ket (patchBasis S bg u) := by
  simp [patchOut, ket]

private theorem patchBasis_upd (S : Finset Wire) (bg u : BasisState) (t : Wire) (ht : t ∈ S) (v : Bool) :
    patchBasis S bg (u[t ↦ v]) = (patchBasis S bg u)[t ↦ v] := by
  funext w; by_cases hw : w = t
  · subst hw; simp [patchBasis, upd, ht]
  · by_cases hS : w ∈ S <;> simp [patchBasis, upd, hw, hS]

private theorem patchBasis_eval_mem (S : Finset Wire) (bg u : BasisState) (t : Wire) (ht : t ∈ S) :
    patchBasis S bg u t = u t := by simp [patchBasis, ht]

theorem applyGate_patchOut (S : Finset Wire) (bg : BasisState) (g : Gate)
    (hg : ∀ w ∈ gateWires g, w ∈ S) (psi : State) :
    applyGate g (patchOut S bg psi) = patchOut S bg (applyGate g psi) := by
  have hket (u : BasisState) :
      applyGate g (patchOut S bg (ket u)) = patchOut S bg (applyGate g (ket u)) := by
    cases g with
    | X t =>
      have ht : t ∈ S := hg t (by simp [gateWires])
      simp only [patchOut_ket, applyGate_X_ket, patchBasis_eval_mem S bg u t ht, patchBasis_upd S bg u t ht]
    | CX a t =>
      have ha : a ∈ S := hg a (by simp [gateWires])
      have ht : t ∈ S := hg t (by simp [gateWires])
      simp only [patchOut_ket, applyGate_CX_ket, patchBasis_eval_mem S bg u a ha,
        patchBasis_eval_mem S bg u t ht, patchBasis_upd S bg u t ht]
    | CCX a b t =>
      have ha : a ∈ S := hg a (by simp [gateWires])
      have hb : b ∈ S := hg b (by simp [gateWires])
      have ht : t ∈ S := hg t (by simp [gateWires])
      simp only [patchOut_ket, applyGate_CCX_ket, patchBasis_eval_mem S bg u a ha,
        patchBasis_eval_mem S bg u b hb, patchBasis_eval_mem S bg u t ht, patchBasis_upd S bg u t ht]
    | P dir k t =>
      have ht : t ∈ S := hg t (by simp [gateWires])
      simp only [patchOut_ket, applyGate_P_ket, map_smul, patchBasis_eval_mem S bg u t ht]
    | H t =>
      have ht : t ∈ S := hg t (by simp [gateWires])
      simp only [patchOut_ket, applyGate_H_ket, map_add, map_smul,
        patchBasis_eval_mem S bg u t ht, patchBasis_upd S bg u t ht]
  induction psi using Finsupp.induction with
  | zero => simp only [map_zero]
  | @single_add s c v _ _ ih =>
    have he : Finsupp.single s c = c • ket s := by simp [ket]
    simp only [map_add, he, map_smul, ih, hket]

theorem xResetKraus_patchOut (S : Finset Wire) (bg : BasisState) (w : Wire) (hw : w ∈ S) (o : Bool) (psi : State) :
    xResetKraus w o (patchOut S bg psi) = patchOut S bg (xResetKraus w o psi) := by
  have hket (u : BasisState) :
      xResetKraus w o (patchOut S bg (ket u)) = patchOut S bg (xResetKraus w o (ket u)) := by
    simp only [patchOut_ket, xResetKraus_ket, map_smul,
      patchBasis_eval_mem S bg u w hw, patchBasis_upd S bg u w hw]
  induction psi using Finsupp.induction with
  | zero => simp only [map_zero]
  | @single_add s c v _ _ ih =>
    have he : Finsupp.single s c = c • ket s := by simp [ket]
    simp only [map_add, he, map_smul, ih, hket]

theorem prep_patchOut (S : Finset Wire) (bg : BasisState) (y : Wire) (hy : y ∈ S) (psi : State) :
    Prep y (patchOut S bg psi) = patchOut S bg (Prep y psi) := by
  simp only [Prep, Catalyst.prepare, Quantum.run_cons, Quantum.run_nil, LinearMap.id_coe, id_eq]
  rw [applyGate_patchOut S bg (.H y) (by simp [gateWires, hy]),
    applyGate_patchOut S bg (.P .forward 2 y) (by simp [gateWires, hy])]

private def preBranchW (outcome : Option Bool) (before : State →ₗ[ℂ] State) (b : InstrumentBranch) :
    InstrumentBranch :=
  ⟨outcome.toList ++ b.history, b.kraus.comp before⟩

theorem straight_patchOut_comm {n s e : Nat} (S : Finset Wire) (bg : BasisState) (p : Straight n s e)
    (hp : ∀ w ∈ ChallengeMigration.straightWires p, w ∈ S)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ∀ b ∈ (p.instantiate read h).run, ∀ psi : State,
      b.kraus (patchOut S bg psi) = patchOut S bg (b.kraus psi) := by
  induction p with
  | done =>
    intro b hb psi
    simp only [Straight.instantiate, AdaptiveCircuit.run, List.mem_singleton] at hb
    subst hb; rfl
  | gate g next ih =>
    intro b hb psi
    cases g with
    | literal g =>
      have hg : ∀ w ∈ gateWires g, w ∈ S := fun w hw => hp w (by simp [ChallengeMigration.straightWires, templateGateWires, hw])
      have hnext : ∀ w ∈ ChallengeMigration.straightWires next, w ∈ S := fun w hw => hp w (by simp [ChallengeMigration.straightWires, hw])
      change b ∈ ((next.instantiate read h).run.map (preBranchW none (Quantum.run ([g])))) at hb
      obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchW]
      rw [LinearMap.comp_apply, LinearMap.comp_apply, Quantum.run_singleton, Quantum.run_singleton,
        applyGate_patchOut S bg g hg psi, ih hnext h b' hb']
    | whenBit r v g =>
      have hg : ∀ w ∈ gateWires g, w ∈ S := fun w hw => hp w (by simp [ChallengeMigration.straightWires, templateGateWires, hw])
      have hnext : ∀ w ∈ ChallengeMigration.straightWires next, w ∈ S := fun w hw => hp w (by simp [ChallengeMigration.straightWires, hw])
      change b ∈ ((next.instantiate read h).run.map
        (preBranchW none (Quantum.run (if read r = v then [g] else [])))) at hb
      obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchW]
      by_cases hr : read r = v
      · simp only [hr, if_true, LinearMap.comp_apply, Quantum.run_singleton]
        rw [applyGate_patchOut S bg g hg psi, ih hnext h b' hb']
      · simp only [hr, if_false, LinearMap.comp_apply, Quantum.run_nil]
        exact ih hnext h b' hb' psi
  | recordGate i v g next ih =>
    intro b hb psi
    have hg : ∀ w ∈ gateWires g, w ∈ S := fun w hw => hp w (by simp [ChallengeMigration.straightWires, hw])
    have hnext : ∀ w ∈ ChallengeMigration.straightWires next, w ∈ S := fun w hw => hp w (by simp [ChallengeMigration.straightWires, hw])
    change b ∈ ((next.instantiate read h).run.map
      (preBranchW none (Quantum.run (if h i = v then [g] else [])))) at hb
    obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
    dsimp only [preBranchW]
    by_cases hr : h i = v
    · simp only [hr, if_true, LinearMap.comp_apply, Quantum.run_singleton]
      rw [applyGate_patchOut S bg g hg psi, ih hnext h b' hb']
    · simp only [hr, if_false, LinearMap.comp_apply, Quantum.run_nil]
      exact ih hnext h b' hb' psi
  | measure w next ih =>
    intro b hb psi
    have hw : w ∈ S := hp w (by simp [ChallengeMigration.straightWires])
    have hnext : ∀ u ∈ ChallengeMigration.straightWires next, u ∈ S := fun u hu => hp u (by simp [ChallengeMigration.straightWires, hu])
    change b ∈ ((next.instantiate read (Fin.lastCases (motive := fun _ => Bool) false h)).run.map
        (preBranchW (some false) (xResetKraus w false)) ++
      (next.instantiate read (Fin.lastCases (motive := fun _ => Bool) true h)).run.map
        (preBranchW (some true) (xResetKraus w true))) at hb
    rcases List.mem_append.mp hb with hb | hb <;>
    · obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchW]
      rw [LinearMap.comp_apply, LinearMap.comp_apply, xResetKraus_patchOut S bg w hw _ psi, ih hnext _ b' hb']

theorem catLitSim_restrict_S {n s e : Nat} (S : Finset Wire) (y : Wire)
    (p : Straight n s e) (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hp : ∀ w ∈ ChallengeMigration.straightWires p, w ∈ S)
    (hP : ECDSAAdd.wires P ⊆ S) (hy : y ∈ S)
    (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (hsim : CatLitSim y (p.instantiate read h) P V) :
    CatLitSim y (p.instantiate read h) P (fun bs => ∃ bs', V bs' ∧ ∀ w ∈ S, bs w = bs' w) := by
  obtain ⟨cs, hal, hm⟩ := hsim
  refine ⟨cs, ?_, hm⟩
  have hmem := List.forall₂_iff_get.mp hal
  refine List.forall₂_iff_get.mpr ⟨hmem.1, fun i h1 h2 => ?_⟩
  obtain ⟨m, lm, hbr⟩ := hmem.2 i h1 h2
  refine ⟨m, lm, fun st ⟨bs', hbs', hag⟩ => ?_⟩
  let st' : ECDSAAdd.State := ⟨st.phase, bs'⟩
  have hpatch_in : patchOut S st.basis (Bridge.signedKet st') = Bridge.signedKet st := by
    rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, patchOut_ket]
    congr 2; funext w; by_cases hw : w ∈ S <;> simp [patchBasis, hw, hag]
  have hagree := ECDSAAdd.Arithmetic.pool_run_agrees P S hP m st' st rfl (fun w hw => (hag w hw).symm)
  have hpatch_out : patchOut S st.basis (Bridge.signedKet (ECDSAAdd.run P m st')) =
      Bridge.signedKet (ECDSAAdd.run P m st) := by
    rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, patchOut_ket, hagree.1]
    congr 2; funext w; by_cases hw : w ∈ S
    · simp [patchBasis, hw, hagree.2 w hw]
    · simp only [patchBasis, hw, if_false]
      exact (ECDSAAdd.run_preserves_outside P m st w (fun hmem => hw (hP hmem))).symm
  have hcomm := straight_patchOut_comm S st.basis p hp read h _ (List.get_mem _ ⟨i, h1⟩)
  rw [← hpatch_in, prep_patchOut S st.basis y hy, hcomm, hbr st' hbs', map_smul,
    ← prep_patchOut S st.basis y hy, hpatch_out]

-- Universal `Straight.append` simulation preserving prefix history agreement
private theorem forall₂_append_split_local {α β : Type*} {R : α → β → Prop}
    {xs₁ xs₂ : List α} {ys : List β} (h : List.Forall₂ R (xs₁ ++ xs₂) ys) :
    ∃ ys₁ ys₂, ys = ys₁ ++ ys₂ ∧ List.Forall₂ R xs₁ ys₁ ∧ List.Forall₂ R xs₂ ys₂ := by
  induction xs₁ generalizing ys with
  | nil => exact ⟨[], ys, rfl, .nil, h⟩
  | cons x xs₁ ih =>
    cases h with
    | cons hx hrest =>
      rename_i y ys'
      obtain ⟨ys₁, ys₂, rfl, h1, h2⟩ := ih hrest
      exact ⟨y :: ys₁, ys₂, rfl, .cons hx h1, h2⟩

private theorem map_normSq_scale_local (α : ℂ) (cs : List ℂ) :
    ((cs.map (α * ·)).map Complex.normSq).sum = Complex.normSq α * (cs.map Complex.normSq).sum := by
  induction cs with
  | nil => simp
  | cons c cs ih => simp only [List.map_cons, List.sum_cons, Complex.normSq_mul, ih, mul_add]

private theorem preBranchW_seq (o : Option Bool) (before : State →ₗ[ℂ] State) (b₁ b₂ : InstrumentBranch) :
    preBranchW o before (b₁.seq b₂) = (preBranchW o before b₁).seq b₂ := by
  rcases b₁ with ⟨h1, k1⟩; rcases b₂ with ⟨h2, k2⟩
  simp only [preBranchW, InstrumentBranch.seq, List.append_assoc, LinearMap.comp_assoc]

theorem straight_start_le_finish {n s e : Nat} (p : Straight n s e) : s ≤ e := by
  induction p with
  | done => exact le_rfl
  | gate _ _ ih => exact ih
  | recordGate _ _ _ _ ih => exact ih
  | measure _ _ ih => omega

theorem append_sim_forall2 {n start fin end_ : Nat} (p : Straight n start fin)
    (q : Straight n fin end_) (read : ConstantBit n → Bool) (h : Fin start → Bool)
    (P₁ P₂ Q : InstrumentBranch → ℂ → Prop)
    (cs₁ : List ℂ) (ha₁ : List.Forall₂ P₁ (p.instantiate read h).run cs₁)
    (h₂ : ∀ h' : Fin fin → Bool, (∀ i : Fin start, h' (Fin.castLE (straight_start_le_finish p) i) = h i) →
      ∃ cs₂ : List ℂ, List.Forall₂ P₂ (q.instantiate read h').run cs₂ ∧ (cs₂.map Complex.normSq).sum = 1)
    (hcomb : ∀ b₁ c₁ b₂ c₂, P₁ b₁ c₁ → P₂ b₂ c₂ → Q (b₁.seq b₂) (c₁ * c₂)) :
    ∃ cs : List ℂ, List.Forall₂ Q ((p.append q).instantiate read h).run cs ∧
      (cs.map Complex.normSq).sum = (cs₁.map Complex.normSq).sum := by
  induction p generalizing P₁ Q cs₁ with
  | done =>
    cases ha₁ with
    | cons h0 hnil =>
      cases hnil
      rename_i c₁
      obtain ⟨cs₂, ha₂, hm₂⟩ := h₂ h (fun _ => rfl)
      refine ⟨cs₂.map (c₁ * ·), ?_, ?_⟩
      · rw [List.forall₂_map_right_iff]
        refine ha₂.imp (fun b₂ c₂ hb₂ => ?_)
        have hseq : (⟨[], LinearMap.id⟩ : InstrumentBranch).seq b₂ = b₂ := by
          cases b₂; simp [InstrumentBranch.seq]
        simpa only [hseq] using hcomb ⟨[], LinearMap.id⟩ c₁ b₂ c₂ h0 hb₂
      · rw [map_normSq_scale_local, hm₂, mul_one, List.map_singleton, List.sum_singleton]
  | gate g next ih =>
    let U : State →ₗ[ℂ] State := Quantum.run (g.instantiate read)
    change List.Forall₂ P₁ ((next.instantiate read h).run.map (preBranchW none U)) cs₁ at ha₁
    rw [List.forall₂_map_left_iff] at ha₁
    obtain ⟨cs, hal, hm⟩ := ih q h (fun b₁ c₁ => P₁ (preBranchW none U b₁) c₁)
      (fun b c => Q (preBranchW none U b) c) cs₁ ha₁ h₂
      (fun b₁ c₁ b₂ c₂ hp₁ hp₂ => by dsimp only; rw [preBranchW_seq]; exact hcomb _ c₁ b₂ c₂ hp₁ hp₂)
    refine ⟨cs, ?_, hm⟩
    change List.Forall₂ Q (((next.append q).instantiate read h).run.map (preBranchW none U)) cs
    rwa [List.forall₂_map_left_iff]
  | recordGate i v g next ih =>
    let U : State →ₗ[ℂ] State := Quantum.run (if h i = v then [g] else [])
    change List.Forall₂ P₁ ((next.instantiate read h).run.map (preBranchW none U)) cs₁ at ha₁
    rw [List.forall₂_map_left_iff] at ha₁
    obtain ⟨cs, hal, hm⟩ := ih q h (fun b₁ c₁ => P₁ (preBranchW none U b₁) c₁)
      (fun b c => Q (preBranchW none U b) c) cs₁ ha₁ h₂
      (fun b₁ c₁ b₂ c₂ hp₁ hp₂ => by dsimp only; rw [preBranchW_seq]; exact hcomb _ c₁ b₂ c₂ hp₁ hp₂)
    refine ⟨cs, ?_, hm⟩
    change List.Forall₂ Q (((next.append q).instantiate read h).run.map (preBranchW none U)) cs
    rwa [List.forall₂_map_left_iff]
  | measure w next ih =>
    let h0 : Fin (_ + 1) → Bool := Fin.lastCases (motive := fun _ => Bool) false h
    let h1 : Fin (_ + 1) → Bool := Fin.lastCases (motive := fun _ => Bool) true h
    change List.Forall₂ P₁
      ((next.instantiate read h0).run.map (preBranchW (some false) (xResetKraus w false)) ++
       (next.instantiate read h1).run.map (preBranchW (some true) (xResetKraus w true))) cs₁ at ha₁
    obtain ⟨csL, csR, rfl, haL, haR⟩ := forall₂_append_split_local ha₁
    rw [List.forall₂_map_left_iff] at haL haR
    have h2L : ∀ h',
        (∀ i : Fin (_ + 1), h' (Fin.castLE (straight_start_le_finish next) i) = h0 i) →
        ∃ cs₂ : List ℂ, List.Forall₂ P₂ (q.instantiate read h').run cs₂ ∧ (cs₂.map Complex.normSq).sum = 1 :=
      fun h' hh' => h₂ h' (fun i => by
        have := hh' i.castSucc
        simpa [h0, Fin.lastCases_castSucc] using this)
    have h2R : ∀ h',
        (∀ i : Fin (_ + 1), h' (Fin.castLE (straight_start_le_finish next) i) = h1 i) →
        ∃ cs₂ : List ℂ, List.Forall₂ P₂ (q.instantiate read h').run cs₂ ∧ (cs₂.map Complex.normSq).sum = 1 :=
      fun h' hh' => h₂ h' (fun i => by
        have := hh' i.castSucc
        simpa [h1, Fin.lastCases_castSucc] using this)
    obtain ⟨cL, alL, mL⟩ := ih q h0 (fun b₁ c₁ => P₁ (preBranchW (some false) (xResetKraus w false) b₁) c₁)
      (fun b c => Q (preBranchW (some false) (xResetKraus w false) b) c) csL haL h2L
      (fun b₁ c₁ b₂ c₂ hp₁ hp₂ => by dsimp only; rw [preBranchW_seq]; exact hcomb _ c₁ b₂ c₂ hp₁ hp₂)
    obtain ⟨cR, alR, mR⟩ := ih q h1 (fun b₁ c₁ => P₁ (preBranchW (some true) (xResetKraus w true) b₁) c₁)
      (fun b c => Q (preBranchW (some true) (xResetKraus w true) b) c) csR haR h2R
      (fun b₁ c₁ b₂ c₂ hp₁ hp₂ => by dsimp only; rw [preBranchW_seq]; exact hcomb _ c₁ b₂ c₂ hp₁ hp₂)
    refine ⟨cL ++ cR, ?_, ?_⟩
    · change List.Forall₂ Q
        (((next.append q).instantiate read h0).run.map (preBranchW (some false) (xResetKraus w false)) ++
         ((next.append q).instantiate read h1).run.map (preBranchW (some true) (xResetKraus w true))) (cL ++ cR)
      exact WEX.simulationAligned_append (List.forall₂_map_left_iff.mpr alL) (List.forall₂_map_left_iff.mpr alR)
    · simp only [List.map_append, List.sum_append, mL, mR]

-- Open-ended `CatProg.measureThen` combinator (zero `castFinish`, direct `Forall₂` simulation)
def CatProg.measureThen {n : Nat}
    (k : (cur : Nat) → List (Fin cur) → CatProg n cur) :
    (ws : List Wire) → (start : Nat) → List (Fin start) → CatProg n start
  | [], start, refs => k start refs
  | w :: ws, start, refs =>
    let rest := CatProg.measureThen k ws (start + 1)
      (refs.map Fin.castSucc ++ [Fin.last start])
    ⟨rest.finish, .measure w rest.prog⟩

theorem CatProg.measureThen_finish {n : Nat}
    (k : (cur : Nat) → List (Fin cur) → CatProg n cur) (D : Nat)
    (hk : ∀ c rs, (k c rs).finish = c + D) :
    ∀ (ws : List Wire) (start : Nat) (refs : List (Fin start)),
      (CatProg.measureThen k ws start refs).finish = start + (ws.length + D)
  | [], start, refs => by simp [CatProg.measureThen, hk]
  | w :: ws, start, refs => by
    have ih := CatProg.measureThen_finish k D hk ws (start + 1) (refs.map Fin.castSucc ++ [Fin.last start])
    change (CatProg.measureThen k ws (start + 1) _).finish = _
    rw [ih]; simp only [List.length_cons]; omega

theorem CatProg.measureThen_removed18 {n : Nat}
    (k : (cur : Nat) → List (Fin cur) → CatProg n cur)
    (hk : ∀ c rs, removed 18 (k c rs).prog = 0) :
    ∀ (ws : List Wire) (start : Nat) (refs : List (Fin start)),
      removed 18 (CatProg.measureThen k ws start refs).prog = 0
  | [], start, refs => hk start refs
  | w :: ws, start, refs => CatProg.measureThen_removed18 k hk ws (start + 1) _

theorem CatProg.measureThen_tCount_le {n : Nat}
    (k : (cur : Nat) → List (Fin cur) → CatProg n cur) (T : Nat) (read : ConstantBit n → Bool)
    (hk : ∀ c rs hh, ((k c rs).prog.instantiate read hh).tCount ≤ T) :
    ∀ (ws : List Wire) (start : Nat) (refs : List (Fin start)) (h : Fin start → Bool),
      ((CatProg.measureThen k ws start refs).prog.instantiate read h).tCount ≤ T
  | [], start, refs, h => hk start refs h
  | w :: ws, start, refs, h => by
    change max _ _ ≤ T
    exact max_le (CatProg.measureThen_tCount_le k T read hk ws (start + 1) _ _)
      (CatProg.measureThen_tCount_le k T read hk ws (start + 1) _ _)

theorem CatProg.measureThen_slots_le {n : Nat}
    (k : (cur : Nat) → List (Fin cur) → CatProg n cur) (B : Nat)
    (hk : ∀ c rs, (k c rs).prog.gateSlots ≤ B) :
    ∀ (ws : List Wire) (start : Nat) (refs : List (Fin start)),
      (CatProg.measureThen k ws start refs).prog.gateSlots ≤ B
  | [], start, refs => hk start refs
  | w :: ws, start, refs => CatProg.measureThen_slots_le k B hk ws (start + 1) _

theorem CatProg.measureThen_wires {n : Nat}
    (k : (cur : Nat) → List (Fin cur) → CatProg n cur) {S : List Wire}
    (hk : ∀ c rs, ChallengeMigration.straightWires (k c rs).prog ⊆ S) :
    ∀ (ws : List Wire) (hws : ws ⊆ S) (start : Nat) (refs : List (Fin start)),
      ChallengeMigration.straightWires (CatProg.measureThen k ws start refs).prog ⊆ S
  | [], _, start, refs => hk start refs
  | w :: ws, hws, start, refs => by
    change w :: ChallengeMigration.straightWires (CatProg.measureThen k ws (start + 1) _).prog ⊆ S
    exact List.cons_subset.mpr ⟨hws List.mem_cons_self,
      CatProg.measureThen_wires k hk ws (fun u hu => hws (List.mem_cons_of_mem _ hu)) (start + 1) _⟩

theorem CatProg.measureThen_wellFormed {n : Nat}
    (k : (cur : Nat) → List (Fin cur) → CatProg n cur)
    (hk : ∀ c rs, (k c rs).prog.WellFormed) :
    ∀ (ws : List Wire) (start : Nat) (refs : List (Fin start)),
      (CatProg.measureThen k ws start refs).prog.WellFormed
  | [], start, refs => hk start refs
  | w :: ws, start, refs => CatProg.measureThen_wellFormed k hk ws (start + 1) _

theorem CatProg.measureThen_sim {n : Nat}
    (k : (cur : Nat) → List (Fin cur) → CatProg n cur) (read : ConstantBit n → Bool)
    (ws : List Wire) (start : Nat) (refs : List (Fin start)) (h : Fin start → Bool)
    (P : List Bool → InstrumentBranch → ℂ → Prop)
    (Q : InstrumentBranch → ℂ → Prop)
    (hk : ∀ (os : List Bool) (ho : os.length = ws.length) (cur : Nat) (rs : List (Fin cur))
      (hh : Fin cur → Bool), rs.map hh = refs.map h ++ os →
      ∃ cs : List ℂ, List.Forall₂ (P os) ((k cur rs).prog.instantiate read hh).run cs ∧
        (cs.map Complex.normSq).sum = 1)
    (hstep : ∀ (os : List Bool), os.length = ws.length → ∀ b c, P os b c →
      Q ⟨os ++ b.history, b.kraus.comp (xResetRegisterKraus ws os)⟩ (registerXResetMagnitude ws.length * c)) :
    ∃ cs : List ℂ, List.Forall₂ Q ((CatProg.measureThen k ws start refs).prog.instantiate read h).run cs ∧
      (cs.map Complex.normSq).sum = 1 := by
  induction ws generalizing start refs h P Q with
  | nil =>
    obtain ⟨cs, hal, hm⟩ := hk [] rfl start refs h (by simp)
    refine ⟨cs, hal.imp (fun b c hb => ?_), hm⟩
    have h0 := hstep [] rfl b c hb
    simpa [xResetRegisterKraus, registerXResetMagnitude] using h0
  | cons w ws ih =>
    let s2 : ℂ := (((Real.sqrt 2)⁻¹ : ℝ) : ℂ)
    let h0 : Fin (start + 1) → Bool := Fin.lastCases (motive := fun _ => Bool) false h
    let h1 : Fin (start + 1) → Bool := Fin.lastCases (motive := fun _ => Bool) true h
    let refs' : List (Fin (start + 1)) := refs.map Fin.castSucc ++ [Fin.last start]
    have hmap0 : refs'.map h0 = refs.map h ++ [false] := by
      simp [refs', h0, List.map_append, List.map_map, Function.comp_def, Fin.lastCases_castSucc, Fin.lastCases_last]
    have hmap1 : refs'.map h1 = refs.map h ++ [true] := by
      simp [refs', h1, List.map_append, List.map_map, Function.comp_def, Fin.lastCases_castSucc, Fin.lastCases_last]
    have hscale : Complex.normSq s2 = 1 / 2 := by
      simp only [s2, Complex.normSq_ofReal]
      have h2 : Real.sqrt 2 ≠ 0 := by positivity
      field_simp; nlinarith [Real.mul_self_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]
    have hmag (c : ℂ) : s2 * (registerXResetMagnitude ws.length * c) =
        registerXResetMagnitude (w :: ws).length * c := by
      simp only [s2, registerXResetMagnitude, List.length_cons, pow_succ]; ring
    obtain ⟨cs0, al0, m0⟩ := ih (start + 1) refs' h0 (fun os => P (false :: os))
      (fun b c => Q (preBranchW (some false) (xResetKraus w false) b) (s2 * c))
      (fun os ho cur rs hh hrs => hk (false :: os) (by simp [ho]) cur rs hh (by rw [hrs, hmap0, List.append_assoc]; rfl))
      (fun os ho b c hb => by
        dsimp only
        have hst := hstep (false :: os) (by simp [ho]) b c hb
        rw [hmag c]
        simpa [preBranchW, xResetRegisterKraus, LinearMap.comp_assoc] using hst)
    obtain ⟨cs1, al1, m1⟩ := ih (start + 1) refs' h1 (fun os => P (true :: os))
      (fun b c => Q (preBranchW (some true) (xResetKraus w true) b) (s2 * c))
      (fun os ho cur rs hh hrs => hk (true :: os) (by simp [ho]) cur rs hh (by rw [hrs, hmap1, List.append_assoc]; rfl))
      (fun os ho b c hb => by
        dsimp only
        have hst := hstep (true :: os) (by simp [ho]) b c hb
        rw [hmag c]
        simpa [preBranchW, xResetRegisterKraus, LinearMap.comp_assoc] using hst)
    refine ⟨cs0.map (s2 * ·) ++ cs1.map (s2 * ·), ?_, ?_⟩
    · change List.Forall₂ Q
        (((CatProg.measureThen k ws (start + 1) refs').prog.instantiate read h0).run.map
            (preBranchW (some false) (xResetKraus w false)) ++
         ((CatProg.measureThen k ws (start + 1) refs').prog.instantiate read h1).run.map
            (preBranchW (some true) (xResetKraus w true)))
        (cs0.map (s2 * ·) ++ cs1.map (s2 * ·))
      exact WEX.simulationAligned_append
        (List.forall₂_map_left_iff.mpr (List.forall₂_map_right_iff.mpr al0))
        (List.forall₂_map_left_iff.mpr (List.forall₂_map_right_iff.mpr al1))
    · simp only [List.map_append, List.sum_append, map_normSq_scale_local, hscale, m0, m1]; ring


private def avoid4 (w : Wire) : Prop :=
  w ≠ base 765 ∧ w ≠ base 766 ∧ w ≠ base 767 ∧ w ≠ base 2312

private theorem base_avoid4 (i : Nat) (hi : i ≠ 765 ∧ i ≠ 766 ∧ i ≠ 767 ∧ i ≠ 2312) :
    avoid4 (base i) :=
  ⟨fun e => hi.1 (MappedCompressed.base_injective e),
   fun e => hi.2.1 (MappedCompressed.base_injective e),
   fun e => hi.2.2.1 (MappedCompressed.base_injective e),
   fun e => hi.2.2.2 (MappedCompressed.base_injective e)⟩

private theorem prog_avoid4_of_sub {P Q : ECDSAAdd.Program} (hsub : ECDSAAdd.wires P ⊆ ECDSAAdd.wires Q)
    (h765 : base 765 ∉ ECDSAAdd.wires Q) (h766 : base 766 ∉ ECDSAAdd.wires Q)
    (h767 : base 767 ∉ ECDSAAdd.wires Q) (h2312 : base 2312 ∉ ECDSAAdd.wires Q) :
    ∀ w ∈ ECDSAAdd.wires P, avoid4 w := fun w hw =>
  ⟨fun e => h765 (hsub (e ▸ hw)), fun e => h766 (hsub (e ▸ hw)),
   fun e => h767 (hsub (e ▸ hw)), fun e => h2312 (hsub (e ▸ hw))⟩

private def cellWiresNo4 : List Wire :=
  cellWires.filter (fun w => decide (w ≠ base 765 ∧ w ≠ base 766 ∧ w ≠ base 767 ∧ w ≠ base 2312))

private theorem mem_cellWiresNo4 (w : Wire) : w ∈ cellWiresNo4 ↔ w ∈ cellWires ∧ avoid4 w := by
  simp only [cellWiresNo4, List.mem_filter, decide_eq_true_eq, avoid4]

private theorem cell_half_avoid4 (divide : Bool) :
    base 765 ∉ ECDSAAdd.wires (OneBankCell5.half divide base (base 2409)) ∧
    base 766 ∉ ECDSAAdd.wires (OneBankCell5.half divide base (base 2409)) ∧
    base 767 ∉ ECDSAAdd.wires (OneBankCell5.half divide base (base 2409)) ∧
    base 2312 ∉ ECDSAAdd.wires (OneBankCell5.half divide base (base 2409)) :=
  ⟨OwnGuardHost.half_avoid divide, OwnPlusHost.half_avoid divide,
   OwnMinusHost.half_avoid divide, OwnParityHost.half_avoid divide⟩

private theorem cell_fwd_avoid4 : ∀ w ∈ ECDSAAdd.wires (TopReuse.forward cellLayout), avoid4 w := by
  have h := cell_half_avoid4 true
  have hsub : ECDSAAdd.wires (TopReuse.forward cellLayout) ⊆
      ECDSAAdd.wires (OneBankCell5.half true base (base 2409)) := by
    intro q hq
    rw [OneBankCell5.half_true, ECDSAAdd.wires_append, ECDSAAdd.wires_append]
    exact Finset.mem_union_left _ (Finset.mem_union_right _ hq)
  exact prog_avoid4_of_sub hsub h.1 h.2.1 h.2.2.1 h.2.2.2

private theorem cell_inv_avoid4 : ∀ w ∈ ECDSAAdd.wires (TopReuse.inverse cellLayout), avoid4 w := by
  have h := cell_half_avoid4 false
  have hsub : ECDSAAdd.wires (TopReuse.inverse cellLayout) ⊆
      ECDSAAdd.wires (OneBankCell5.half false base (base 2409)) := by
    intro q hq
    change q ∈ ECDSAAdd.wires ([.X (base 2409)] ++ TopReuse.inverse cellLayout ++ [.X (base 2409)])
    rw [ECDSAAdd.wires_append, ECDSAAdd.wires_append]
    exact Finset.mem_union_left _ (Finset.mem_union_right _ hq)
  exact prog_avoid4_of_sub hsub h.1 h.2.1 h.2.2.1 h.2.2.2

private theorem cell_sub_no4_of_cell (P : ECDSAAdd.Program)
    (hc : ECDSAAdd.wires P ⊆ cellWires.toFinset) (h4 : ∀ w ∈ ECDSAAdd.wires P, avoid4 w) :
    ECDSAAdd.wires P ⊆ cellWiresNo4.toFinset := fun w hw =>
  List.mem_toFinset.mpr ((mem_cellWiresNo4 w).mpr ⟨List.mem_toFinset.mp (hc hw), h4 w hw⟩)

private theorem cellLayout_mem_cellWires (q : Wire) (hq : q ∈ cellLayout.wires) : q ∈ cellWires :=
  (OneBankCell5.mem_ports_wires base (base 2409) q).mp hq

private theorem cell_y_no4 : cellLayout.y ⊆ cellWiresNo4 := by
  intro q hq
  rw [mem_cellWiresNo4]
  refine ⟨cellLayout_mem_cellWires q (by simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires,
    BalancedCleanup.Layout.y, List.mem_append, List.mem_cons] at hq ⊢; tauto), ?_⟩
  simp only [cellLayout, OneBankCell5.ports, BalancedCleanup.Layout.y, List.mem_append, List.mem_singleton,
    wireBlock, List.mem_map, List.mem_range'_1] at hq
  rcases hq with ⟨i, hi, rfl⟩ | rfl <;> exact base_avoid4 _ (by omega)

private theorem cell_r_no4 : cellLayout.r ⊆ cellWiresNo4 := by
  intro q hq
  rw [mem_cellWiresNo4]
  refine ⟨cellLayout_mem_cellWires q (by simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires,
    BalancedCleanup.Layout.r, BalancedCleanup.Layout.low, List.mem_append, List.mem_cons] at hq ⊢; tauto), ?_⟩
  simp only [cellLayout, OneBankCell5.ports, BalancedCleanup.Layout.r, BalancedCleanup.Layout.low,
    List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map, List.mem_range'_1] at hq
  rcases hq with (rfl | ⟨i, hi, rfl⟩) | rfl <;> exact base_avoid4 _ (by omega)

private theorem cell_carry_no4 : cellLayout.carry ⊆ cellWiresNo4 := by
  intro q hq
  rw [mem_cellWiresNo4]
  refine ⟨cellLayout_mem_cellWires q (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, hq]), ?_⟩
  change q ∈ wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] at hq
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, wireBlock, List.mem_map, List.mem_range'_1] at hq
  rcases hq with ⟨i, hi, rfl⟩ | rfl | rfl | rfl <;> exact base_avoid4 _ (by omega)

private theorem cell_base_no4_mem (k : Nat) (hk : k = 2409 ∨ k = 1797 ∨ k = 1027 ∨ k = 768 ∨ k = 1541 ∨ k = 1026) :
    base k ∈ cellWiresNo4 := by
  rw [mem_cellWiresNo4]
  refine ⟨?_, base_avoid4 k (by omega)⟩
  rcases hk with rfl | rfl | rfl | rfl | rfl | rfl
  · exact List.mem_cons_self
  · exact cellLayout_mem_cellWires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, cellLayout_lower])
  · exact cellLayout_mem_cellWires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, cellLayout_one])
  · exact cellLayout_mem_cellWires _ (by simp [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires, cellLayout_parity])
  · exact (mem_cellWiresNo4 _).mp (cell_carry_no4 base_1541_mem_carry) |>.1
  · exact (mem_cellWiresNo4 _).mp (cell_carry_no4 base_1026_mem_carry) |>.1

private theorem compiledRawAdd_wires_no4 {n : Nat} (s : Nat) :
    ChallengeMigration.straightWires (compiledRawAdd (n := n) s).prog ⊆ cellWiresNo4 := by
  have hsc : ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y) ⊆ cellWiresNo4.toFinset := fun q hq => by
    have h := signComplement_wires_subset cellLayout.sign cellLayout.y hq
    simp only [List.mem_toFinset, List.mem_cons, cellLayout_sign] at h ⊢
    rcases h with rfl | h
    · exact cell_base_no4_mem 2409 (Or.inl rfl)
    · exact cell_y_no4 h
  have hsrc : GuardCompression.source cellLayout ⊆ cellWiresNo4 := fun q hq => by
    simp only [GuardCompression.source, List.mem_append, List.mem_singleton] at hq
    rcases hq with hq | rfl
    · exact cell_y_no4 hq
    · exact cell_y_no4 (by simp [BalancedCleanup.Layout.y])
  have hrt : BalancedCircuit.rawTarget cellLayout ⊆ cellWiresNo4 := fun q hq => by
    simp only [BalancedCircuit.rawTarget, List.mem_append, List.mem_singleton, cellLayout_one] at hq
    rcases hq with hq | rfl
    · exact cell_r_no4 hq
    · exact cell_base_no4_mem 1027 (Or.inr (Or.inr (Or.inl rfl)))
  rw [compiledRawAdd]
  exact CatFn.swapSurround_wires _ _ _ (cell_base_no4_mem 1026 (by omega)) (cell_base_no4_mem 1797 (by omega))
    (CatFn.seq_wires _ _ (CatFn.seq_wires _ _ (CatFn.noT_wires _ hsc)
      (fun s' => compileAddInPlace_wires _ _ _ _ _ s' cellWiresNo4
        (cell_base_no4_mem 1797 (by omega)) (cellLayout_sign ▸ cell_base_no4_mem 2409 (by omega))
        hsrc hrt cell_carry_no4))
      (CatFn.noT_wires _ hsc)) s

private theorem compiledRawSub_wires_no4 {n : Nat} (s : Nat) :
    ChallengeMigration.straightWires (compiledRawSub (n := n) s).prog ⊆ cellWiresNo4 := by
  have hsc : ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y) ⊆ cellWiresNo4.toFinset := fun q hq => by
    have h := signComplement_wires_subset cellLayout.sign cellLayout.y hq
    simp only [List.mem_toFinset, List.mem_cons, cellLayout_sign] at h ⊢
    rcases h with rfl | h
    · exact cell_base_no4_mem 2409 (Or.inl rfl)
    · exact cell_y_no4 h
  have hrt : BalancedCircuit.rawTarget cellLayout ⊆ cellWiresNo4 := fun q hq => by
    simp only [BalancedCircuit.rawTarget, List.mem_append, List.mem_singleton, cellLayout_one] at hq
    rcases hq with hq | rfl
    · exact cell_r_no4 hq
    · exact cell_base_no4_mem 1027 (Or.inr (Or.inr (Or.inl rfl)))
  have hnr : ECDSAAdd.wires (ECDSAAdd.Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) ⊆ cellWiresNo4.toFinset := by
    rw [notRegister_wires]; intro q hq; exact List.mem_toFinset.mpr (hrt (List.mem_toFinset.mp hq))
  have hsrc : GuardCompression.source cellLayout ⊆ cellWiresNo4 := fun q hq => by
    simp only [GuardCompression.source, List.mem_append, List.mem_singleton] at hq
    rcases hq with hq | rfl
    · exact cell_y_no4 hq
    · exact cell_y_no4 (by simp [BalancedCleanup.Layout.y])
  have hpre : ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y ++
      ECDSAAdd.Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) ⊆ cellWiresNo4.toFinset := by
    rw [ECDSAAdd.wires_append]; exact Finset.union_subset hsc hnr
  have hpost : ECDSAAdd.wires (ECDSAAdd.Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout) ++
      signComplement cellLayout.sign cellLayout.y) ⊆ cellWiresNo4.toFinset := by
    rw [ECDSAAdd.wires_append]; exact Finset.union_subset hnr hsc
  rw [compiledRawSub]
  exact CatFn.swapSurround_wires _ _ _ (cell_base_no4_mem 1026 (by omega)) (cell_base_no4_mem 1797 (by omega))
    (CatFn.seq_wires _ _ (CatFn.seq_wires _ _ (CatFn.noT_wires _ hpre)
      (fun s' => compileAddInPlaceTop_wires _ _ _ _ _ s' cellWiresNo4
        (cell_base_no4_mem 1797 (by omega)) (cellLayout_sign ▸ cell_base_no4_mem 2409 (by omega))
        hsrc hrt cell_carry_no4))
      (CatFn.noT_wires _ hpost)) s

private theorem cell_cmp_wires_no4 {n : Nat} (top : Bool) (s : Nat) :
    ChallengeMigration.straightWires (compileCompareLt (n := n) top (base 1026) cellLayout.y cellLayout.r cellLayout.carry
      cellLayout.one cellLayout.parity s).prog ⊆ cellWiresNo4 := by
  have hy_eq : cellLayout.y = base 770 :: (wireBlock base 771 254 ++ [base 1025]) := by
    change wireBlock base 770 255 ++ [base 1025] = _
    simp only [wireBlock, List.range'_succ, List.map_cons, List.cons_append]
  have hr_eq : cellLayout.r = base 2056 :: (wireBlock base 2057 254 ++ [base 2311]) := rfl
  have hc_eq : cellLayout.carry = base 512 :: (wireBlock base 513 252 ++ [base 1540, base 1541, base 1026]) := by
    change wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] = _
    simp only [wireBlock, List.range'_succ, List.map_cons, List.cons_append]
  have hy := cell_y_no4; have hr := cell_r_no4; have hc := cell_carry_no4
  rw [hy_eq] at hy ⊢; rw [hr_eq] at hr ⊢; rw [hc_eq] at hc ⊢
  exact compileCompareLt_wires top (base 1026) _ _ _ _ _ _ _ _ _ cellWiresNo4
    (cell_base_no4_mem 1026 (by omega)) (cellLayout_one ▸ cell_base_no4_mem 1027 (by omega))
    (cellLayout_parity ▸ cell_base_no4_mem 768 (by omega)) hy hr hc

private theorem cell_fwd_sub_no4 :
    ECDSAAdd.wires (GuardCompression.seed cellLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (OneReuse.remainder cellLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.prepareCompare cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.unnormalize cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (TopReuse.unnormalizeE cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
    ECDSAAdd.wires (FirstZero5.tail cellLayout) ⊆ cellWiresNo4.toFinset := by
  have hfc : ECDSAAdd.wires (TopReuse.forward cellLayout) ⊆ cellWiresNo4.toFinset :=
    cell_sub_no4_of_cell _ ((TopReuse.forward_support cellLayout cellLayout_widths).trans
      (OneBankCell5.ports_wires_sub base (base 2409) cellWires.toFinset (Finset.Subset.refl _))) cell_fwd_avoid4
  have hfe : ECDSAAdd.wires (TopReuse.forwardE cellLayout) ⊆ cellWiresNo4.toFinset :=
    (TopReuse.forwardE_wires cellLayout cellLayout_widths).trans hfc
  have hfz : ECDSAAdd.wires (FirstZero5.forward cellLayout) ⊆ cellWiresNo4.toFinset :=
    (FirstZero5.forward_wires cellLayout cellLayout_widths).trans hfc
  simp only [TopReuse.forward, TopReuse.forwardPrefix, TopReuse.cleanup,
    ECDSAAdd.wires_append, Finset.union_subset_iff] at hfc
  simp only [TopReuse.forwardE, TopReuse.cleanupE, ECDSAAdd.wires_append, Finset.union_subset_iff] at hfe
  simp only [FirstZero5.forward, ECDSAAdd.wires_append, Finset.union_subset_iff] at hfz
  exact ⟨hfc.1.1.1, hfc.1.2, hfc.2.1, hfc.2.2.2.2.1, by simpa [ECDSAAdd.wires_reverse] using hfc.2.2.2.2.2,
    hfe.2.2.2.2.1, hfz.2⟩

private theorem cell_inv_sub_no4 :
    ECDSAAdd.wires (BalancedCleanup.normalize cellLayout.toLayout) ⊆ cellWiresNo4.toFinset ∧
