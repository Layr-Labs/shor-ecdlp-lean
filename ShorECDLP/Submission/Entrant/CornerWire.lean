private theorem cell_mappedWires_lowBits :
    ∀ q ∈ mappedWires (ShortBiasedFold.lowBits cellLayout), q = base 1797 := by
  have hsub : ShortBiasedFold.lowBits cellLayout =
      (List.range 255).map (fun i => { wire := some (base 1797), flip := BiasedCircuit.jh.testBit i }) := by
    simp only [ShortBiasedFold.lowBits, BiasedCircuit.biasBits, cellLayout_lower, List.take_append,
      List.length_map, List.length_range, Nat.sub_self, List.take_zero, List.append_nil]
    exact List.take_of_length_le (by simp)
  rw [hsub]
  intro q hq
  simp only [mappedWires, List.mem_flatMap, List.mem_map] at hq
  obtain ⟨b, ⟨i, _, rfl⟩, hqb⟩ := hq
  simp only [Option.toList, List.mem_singleton] at hqb
  exact hqb

private theorem cell_remainder_avoid (k : Nat) (hk : k = 1541 ∨ k = 1026) :
    base k ∉ ECDSAAdd.wires (OneReuse.remainder cellLayout) := by
  have h1 : base k ∉ ECDSAAdd.wires (OneReuse.newPrepare cellLayout) := by
    intro hm
    have hr0 : cellLayout.r0 = base 2056 := rfl
    simp only [OneReuse.newPrepare, cellLayout_one, cellLayout_lower, cellLayout_parity, hr0,
      ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
      Finset.notMem_empty, or_false, MappedCompressed.base_injective.eq_iff] at hm
    omega
  have h2 : base k ∉ ECDSAAdd.wires (rotateRight (BalancedCircuit.rawTarget cellLayout)) := by
    rw [(rotate_wires _).1]
    split_ifs
    · simp
    · intro hm; exact cell_not_rawTarget k ⟨by omega, by omega⟩ (List.mem_toFinset.mp hm)
  have h3 : base k ∉ ECDSAAdd.wires (OneReuse.foldWindow cellLayout) := by
    have hma : base k ∉ ECDSAAdd.wires (mappedAdd (ShortBiasedFold.lowBits cellLayout) cellLayout.low
        (cellLayout.carry.take 254) cellLayout.one) := by
      intro hm
      have hsub := mappedAdd_wires_subset _ _ _ _ hm
      simp only [List.mem_toFinset, List.mem_append, List.mem_singleton, cellLayout_one] at hsub
      rcases hsub with ((h | h) | h) | h
      · have := cell_mappedWires_lowBits _ h; have := MappedCompressed.base_injective this; omega
      · exact cell_not_low k (by omega) h
      · exact cellLayout_carry_take254_ne k hk h
      · have := MappedCompressed.base_injective h; omega
    have hrm : cellLayout.rmsb = base 2311 := rfl
    intro hm
    simp only [OneReuse.foldWindow, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with (h | h) | h
    · simp only [cellLayout_parity, cellLayout_lower, cellLayout_one, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
        Finset.mem_union, Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false,
        MappedCompressed.base_injective.eq_iff] at h
      omega
    · exact hma h
    · simp only [cellLayout_parity, cellLayout_lower, cellLayout_one, hrm, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
        ECDSAAdd.correctionWires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
        Finset.notMem_empty, or_false, MappedCompressed.base_injective.eq_iff] at h
      omega
  have h4 : base k ∉ ECDSAAdd.wires (BalancedCleanup.prepareSign cellLayout.toLayout) := by
    have hrm : cellLayout.toLayout.rmsb = base 2311 := rfl
    intro hm
    simp only [BalancedCleanup.prepareSign, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with h | h
    · simp only [hrm, cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
        Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at h
      rcases h with e | e <;> (have := MappedCompressed.base_injective e; omega)
    · have hs := signComplement_wires_subset _ _ h
      simp only [List.mem_toFinset, List.mem_cons, cellLayout_lower] at hs
      rcases hs with e | hr
      · have := MappedCompressed.base_injective e; omega
      · exact cell_not_r k (by omega) hr
  have h5 : base k ∉ ECDSAAdd.wires (BiasedCircuit.flipBias cellLayout) := by
    intro hm
    simp only [BiasedCircuit.flipBias, cell_rtail_getD253, ECDSAAdd.wires, ECDSAAdd.Instr.wires,
      Finset.mem_union, Finset.mem_singleton, Finset.notMem_empty, or_false] at hm
    have := MappedCompressed.base_injective hm; omega
  simp only [OneReuse.remainder, ECDSAAdd.wires_append, Finset.mem_union]
  tauto

