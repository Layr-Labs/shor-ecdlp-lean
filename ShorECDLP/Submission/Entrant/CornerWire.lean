/-! #### 4. Tiny equation lemmas (before marking heavy symbols irreducible) -/

private theorem b_codeExtra_cons {n} (b : Block2 n) (bs : Code2 n) :
    PoolHost.codeExtra (b :: bs) = PoolHost.blockExtra b + PoolHost.codeExtra bs := rfl

private theorem b_codeExtra_nil {n} : PoolHost.codeExtra ([] : Code2 n) = 0 := rfl

private theorem b_blockExtra_plain {n} (c : WCode n) :
    PoolHost.blockExtra (.plain c) = PoolHost.hostCodeExtra c := rfl

private theorem b_blockExtra_unit {n} (u : UnitSite n) :
    PoolHost.blockExtra (.unit u) = 0 := rfl

private theorem b_codeExtra_cons0 {n} (b : Block2 n) (bs : Code2 n) (m : Nat)
    (hb : PoolHost.blockExtra b = 0) (hbs : PoolHost.codeExtra bs = m) :
    PoolHost.codeExtra (b :: bs) = m := by
  rw [b_codeExtra_cons, hb, hbs, Nat.zero_add]

private theorem b_codeExtra_cons_keep {n} (c : WCode n) (bs : Code2 n) (m : Nat)
    (hbs : PoolHost.codeExtra bs = m) :
    PoolHost.codeExtra (.plain c :: bs) = PoolHost.hostCodeExtra c + m := by
  rw [b_codeExtra_cons, b_blockExtra_plain, hbs]

private theorem b_signCredit_le : WideSigned.Body.signCredit ≤ 252 :=
  WEX.fastWindowSign_normalized_counts.1

private theorem b_litToff_norm_nil :
    literalToffolis (normalizeW (erase2 ([] : Code2 32768))) + 0 ≤
      literalToffolis (erase2 ([] : Code2 32768)) := le_rfl

private theorem b_litToff_norm_cons_le {n} (b : Block2 n) (bs : Code2 n) (k m : Nat)
    (hb : literalToffolis (normalizeW b.code) + k ≤ literalToffolis b.code)
    (hbs : literalToffolis (normalizeW (erase2 bs)) + m ≤ literalToffolis (erase2 bs)) :
    literalToffolis (normalizeW (erase2 (b :: bs))) + (k + m) ≤ literalToffolis (erase2 (b :: bs)) := by
  rw [erase2_cons, normalize_append, literalToffolis_append, literalToffolis_append]
  omega

private theorem b_litToff_norm_plain_lit (P : ECDSAAdd.Program) :
    literalToffolis (normalizeW (Block2.plain (wLiteral (n := 32768) P)).code) +
        ECDSAAdd.Baselines.repeatedControls P ≤
      literalToffolis (Block2.plain (wLiteral (n := 32768) P)).code := by
  change literalToffolis (normalizeW (wLiteral (n := 32768) P)) +
      ECDSAAdd.Baselines.repeatedControls P ≤
    literalToffolis (wLiteral (n := 32768) P)
  simp only [wLiteral, normalizeW, normalizeWInstr, List.map_cons, List.map_nil, literalToffolis, Nat.add_zero]
  exact le_of_eq (ECDSAAdd.Baselines.normalize_toffoli_exact P)

private theorem b_litToff_norm_any {n} (b : Block2 n) :
    literalToffolis (normalizeW b.code) + 0 ≤ literalToffolis b.code := by
  rw [Nat.add_zero]; exact WEX.literalToffolis_normalize b.code

private theorem b_litToff_norm_cons0 {n} (b : Block2 n) (bs : Code2 n) (m : Nat)
    (hbs : literalToffolis (normalizeW (erase2 bs)) + m ≤ literalToffolis (erase2 bs)) :
    literalToffolis (normalizeW (erase2 (b :: bs))) + m ≤ literalToffolis (erase2 (b :: bs)) := by
  simpa only [Nat.zero_add] using b_litToff_norm_cons_le b bs 0 m (b_litToff_norm_any b) hbs

private theorem b_litToff_norm_cons_lit (P : ECDSAAdd.Program) (bs : Code2 32768) (m : Nat)
    (hbs : literalToffolis (normalizeW (erase2 bs)) + m ≤ literalToffolis (erase2 bs)) :
    literalToffolis (normalizeW (erase2 (.plain (wLiteral P) :: bs))) +
        (ECDSAAdd.Baselines.repeatedControls P + m) ≤
      literalToffolis (erase2 (.plain (wLiteral P) :: bs)) :=
  b_litToff_norm_cons_le (.plain (wLiteral P)) bs (ECDSAAdd.Baselines.repeatedControls P) m
    (b_litToff_norm_plain_lit P) hbs

private theorem b_rowC_expand :
    WEXUnlookup.rowC =
      [.plain (wLiteral [.X 838]),
       .plain scrHead,
       .unit (WEXFast.siteUnit (site1 probeRows)),
       .plain (wLiteral guard5),
       .plain (wLiteral (arithS streamLayout false)),
       .plain (wLiteral guard5),
       .plain (wLiteral (SquareOB5.program streamLayout)),
       .unit (WEXFast.siteUnit (constSite streamLayout streamLayout.point.x (wFields probeRows .tripleX))),
       .plain (wLiteral guard5),
       .plain (wLiteral (arithS streamLayout true)),
       .plain (wLiteral guard5),
