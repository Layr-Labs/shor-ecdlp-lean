theorem compiledBasePacket_catLitSim {n : Nat} (divide : Bool) (j : Nat) (hj : j < 102)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledBasePacket (n := n) divide j s).prog.instantiate read h)
      (SW.basePacketS divide j) CellValid := by
  have hdec := history_codec_avoid_ry_work (5 * j) (by omega) _ (Or.inr rfl)
  have henc := history_codec_avoid_ry_work (5 * j) (by omega) _ (Or.inl rfl)
  have hpool := skywalkShared_integer_nodup base MappedCompressed.LaneA.laneLogical_config.1
  have hl : ∀ l ∈ Replay5.letters j, base 1026 ≠ l.1.1 ∧ base 1026 ≠ l.1.2 := fun l hl => by
    obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hl; have := List.mem_range.mp hk
    exact letters_ne_1026 (5 * j + k) (by omega)
  have h1 : ∀ (s' : Nat) (r' : ConstantBit n → Bool) (h' : Fin s' → Bool),
      CatLitSim (base 1026) ((CatFn.compileProg (base 1541) (base 1026) (History5.decode base (5 * j)) s').prog.instantiate r' h')
        (History5.decode base (5 * j)) CellValid := fun s' r' h' =>
    catLitSim_weaken (CatFn.compileProg_catLitSim (base 1541) (base 1026) _ hdec.2.2.2.1 hdec.2.2.2.2
      (base_ne 1541 1026 (by omega)) (History5.decode_physical base hpool (5 * j) (by omega)) s' r' h')
      (fun _ hv => cellValid_1541_1026 hv)
  have h12 := CatFn.seq_catLitSim _ _ (compiledRawReplay_indep divide _) _ _ CellValid CellValid h1
    (compiledRawReplay_catLitSim divide _ hl)
    (fun st m hv _ => cell_run_outside_pres_valid _ st m hdec.1 hdec.2.1 hdec.2.2.1 hv)
  rw [compiledBasePacket, SW.basePacketS]
  exact CatFn.seq_catLitSim _ _ (CatFn.compileProg_indep _ _ _) _ _ CellValid _ h12
    (CatFn.compileProg_catLitSim (base 1541) (base 1026) _ henc.2.2.2.1 henc.2.2.2.2
      (base_ne 1541 1026 (by omega)) (History5.encode_physical base hpool (5 * j) (by omega)))
    (fun st m hv _ => by
      rw [ECDSAAdd.run_append]
      exact cellValid_1541_1026 (cell_rawReplayS_pres_valid divide _ _ _
        (cell_run_outside_pres_valid _ st _ hdec.1 hdec.2.1 hdec.2.2.1 hv))) s read h

def ReplayValid (bs : BasisState) : Prop :=
  CellValid bs ∧ ∀ q, Placement5.zeroRegion q → bs (base q) = false

def ReplayValidZero (bs : BasisState) : Prop :=
  CellValidZero bs ∧ ∀ q, Placement5.zeroRegion q → bs (base q) = false

private theorem shifted_pi_zero_id (e : Equiv.Perm Nat)
    (hout : ∀ q, ¬Placement5.zeroRegion q → e q = q)
    (bs : BasisState) (hz : ∀ q, Placement5.zeroRegion q → bs (base q) = false) :
    (fun w => bs (shifted e w)) = bs := by
  funext w
  by_cases hbase : ∃ q, w = base q
  · obtain ⟨q, rfl⟩ := hbase
    rw [shifted_base]
    by_cases hq : Placement5.zeroRegion q
    · have heq : Placement5.zeroRegion (e q) := by
        by_contra hno
        have := e.injective (hout (e q) hno); exact hno (this.symm ▸ hq)
      rw [hz (e q) heq, hz q hq]
    · rw [hout q hq]
  · have hsh : shifted e w = w := by
      change shiftedFn e w = w
      unfold shiftedFn
      split_ifs with h
      · rfl
      · exfalso; exact hbase ⟨w - 16, by change w = (w - 16) + 16; omega⟩
    rw [hsh]

