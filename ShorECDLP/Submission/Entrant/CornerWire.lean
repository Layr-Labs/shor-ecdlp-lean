theorem rowC_ccx_plus_rc_upper :
    WEXUnlookup.ccx2 WEXUnlookup.rowC +
      ECDSAAdd.Baselines.repeatedControls (arithS streamLayout false) +
      ECDSAAdd.Baselines.repeatedControls (arithS streamLayout true) ≤ 2291616 := by
  have hrel := WEXUnlookup.ccx2_relation WEXUnlookup.rowC
  rw [WEXUnlookup.rowC_masks, WEXUnlookup.rowC_measures.2.1] at hrel
  have hc := (finite23_literal_counts streamLayout probeRows).1.trans
    (tight_finite_literal_counts streamLayout streamLayout_widths streamLayout_nodup probeRows).1
  have hrow : literalToffolis (clearReferenceRow probeRows) = 2158163 := by
    have h0 : literalToffolis (rowAddCode probeRows) = 2156628 := by
      simp only [rowAddCode, literalToffolis_append, wLiteral, literalToffolis, ECDSAAdd.toffoliCount,
        Nat.zero_add, Nat.add_zero, hc]
    rw [WEX.clearReferenceRow_literalToffolis, h0]
  have hmeas : literalToffolis (erase2 WEXUnlookup.rowC) = 2158163 + 510 := by
    rw [WEXUnlookup.rowC_measures.1, hrow]
  have hnorm_rc :
      literalToffolis (normalizeW (erase2 WEXUnlookup.rowC)) +
        (ECDSAAdd.Baselines.repeatedControls (arithS streamLayout false) +
         (ECDSAAdd.Baselines.repeatedControls (arithS streamLayout true) + 0)) ≤
