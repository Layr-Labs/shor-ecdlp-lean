  have h48 := catBlockSim_seq _ _ hi5 _ _ P4 P5 hS4 h58 (fun addr st m ⟨d, hs⟩ hm =>
    ⟨d, midStep_advance hmem4 hm hs (d.htriple st m hs.1)⟩)
  have h38 := catBlockSim_seq _ _ hi4 _ _ P3 P4 hS3 h48 (fun addr st m ⟨d, hs⟩ hm => by
    refine ⟨d, midStep_advance hmem3 hm hs ?_⟩
    rw [midB3, fblock_step_ref_plain]
    have hst := (GenericOB5.square_step streamLayout streamLayout_widths streamLayout_nodup d.X0 d.Y1 d.G d.base st m hs.1).2
    simpa only [← d.hX2] using hst)
  have h28 := catBlockSim_seq _ _ hi3 _ _ P2 P3 hS2 h38 (fun addr st m ⟨d, hs⟩ hm => by
    refine ⟨d, midStep_advance hmem2 hm hs ?_⟩
    rw [midB2, fblock_step_ref_plain]
    exact (WEXUnlookup.guard5_step d.X1 d.X0 d.Y1 d.G d.base d.hex d.hbck1 st m hs.1).2)
  have h18 := catBlockSim_seq _ _ hi2 _ _ P1 P2 hS1 h28 (fun addr st m ⟨d, hs⟩ hm => by
    refine ⟨d, midStep_advance hmem1 hm hs ?_⟩
    rw [midB1, fblock_step_ref_plain]
    have hst := (arith3F_step streamLayout streamLayout_widths streamLayout_nodup d.X1 d.Y0 d.G d.base false d.hX1 st m hs.1).2
    simpa only [Bool.false_eq_true, if_false, ← d.hY1] using hst)
