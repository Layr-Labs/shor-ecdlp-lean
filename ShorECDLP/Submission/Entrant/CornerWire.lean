      let sC := ECDSAAdd.run (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse m5
        (ECDSAAdd.run (compareLt none cellLayout.y cellLayout.r cellLayout.carry cellLayout.one cellLayout.parity) m4
