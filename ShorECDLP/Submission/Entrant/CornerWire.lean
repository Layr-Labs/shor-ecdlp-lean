private theorem map_avoid4_of_fix {f : Wire → Wire} (hinj : Function.Injective f)
    (h765 : f (base 765) = base 765) (h766 : f (base 766) = base 766)
    (h767 : f (base 767) = base 767) (h2312 : f (base 2312) = base 2312)
    {u : Wire} (hu : avoid4 u) : avoid4 (f u) :=
  ⟨fun e => hu.1 (hinj (e.trans h765.symm)),
   fun e => hu.2.1 (hinj (e.trans h766.symm)),
   fun e => hu.2.2.1 (hinj (e.trans h767.symm)),
   fun e => hu.2.2.2 (hinj (e.trans h2312.symm))⟩

private theorem catFn_map_mem {n : Nat} (f : Wire → Wire) (a : CatFn n) (s : Nat) {w : Wire}
    (hw : w ∈ ChallengeMigration.straightWires (CatFn.map f a s).prog) :
    ∃ u ∈ ChallengeMigration.straightWires (a s).prog, f u = w := by
  rw [CatFn.map, CatProg.map, mapStraight_wires] at hw
  exact List.mem_map.mp hw

private theorem catFn_seq_avoid4 {n : Nat} (a b : CatFn n)
    (ha : ∀ s w, w ∈ ChallengeMigration.straightWires (a s).prog → avoid4 w)
    (hb : ∀ s w, w ∈ ChallengeMigration.straightWires (b s).prog → avoid4 w)
    (s : Nat) (w : Wire) (hw : w ∈ ChallengeMigration.straightWires (CatFn.seq a b s).prog) : avoid4 w := by
  rw [CatFn.seq, CatProg.append, straightWires_append, List.mem_append] at hw
  rcases hw with h | h
  · exact ha s w h
  · exact hb _ w h

private theorem catFn_compileProg_avoid4 {n : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (hq : avoid4 q) (hy : avoid4 y) (hP : ∀ w ∈ ECDSAAdd.wires P, avoid4 w)
    (s : Nat) (w : Wire) (hw : w ∈ ChallengeMigration.straightWires (CatFn.compileProg (n := n) q y P s).prog) :
    avoid4 w := by
  have hsub := CatFn.compileProg_wires (n := n) q y P (S := q :: y :: (ECDSAAdd.wires P).toList)
    (fun u hu => List.mem_toFinset.mpr (by simp [hu])) List.mem_cons_self
    (List.mem_cons_of_mem _ List.mem_cons_self) s hw
  simp only [List.mem_cons, Finset.mem_toList] at hsub
  rcases hsub with rfl | rfl | h
  · exact hq
  · exact hy
  · exact hP w h

private theorem catFn_noT_avoid4 {n : Nat} (P : ECDSAAdd.Program)
    (hP : ∀ w ∈ ECDSAAdd.wires P, avoid4 w)
