    simp only [WideBank8.Fast16.fforget, List.flatMap_nil, reference2_nil, ECDSAAdd.measurementCount] at hm ⊢
    rw [List.eq_nil_of_length_eq_zero hm, Site1Fast.run_nil]; exact hp
  | cons x xs ih =>
    rw [WideBank8.Fast16.fforget_cons, reference2_append, ECDSAAdd.measurementCount_append] at hm
    rw [WideBank8.Fast16.fforget_cons, reference2_append, ECDSAAdd.run_append]
    have ht : (m.take (ECDSAAdd.measurementCount (reference2 read a x.forgetL))).length =
        ECDSAAdd.measurementCount (reference2 read a x.forgetL) := by rw [List.length_take]; omega
    have hd : (m.drop (ECDSAAdd.measurementCount (reference2 read a x.forgetL))).length =
        ECDSAAdd.measurementCount (reference2 read a (WideBank8.Fast16.fforget xs)) := by rw [List.length_drop]; omega
    exact ih (fun b hb => hg b (List.mem_cons_of_mem _ hb)) (fun b hb => hnp b (List.mem_cons_of_mem _ hb)) _
      (WideBank8.Fast16.fblock_addr read x (hg x List.mem_cons_self) a st ha hcl.1 _)
      (hcl.2 _ ht)
      (b_fblock_path_clean read x (hg x List.mem_cons_self) (hnp x List.mem_cons_self) a st ha hp _) _ hd

private theorem b_cornerBlocks_plain_avoid_path :
    ∀ b ∈ CornerWire.Wide16.cornerBlocks, ∀ code, b = .std (.plain code) →
      ∀ p, WInstr.literal p ∈ code → ∀ w ∈ WideBank8.Fast16.pathBank, w ∉ ECDSAAdd.wires p := by
  intro b hb code hbc p hp w hw
  obtain ⟨hz, hcn1, hcn2⟩ := b_zrep_cornerNeg_avoid_path w hw
  simp only [CornerWire.Wide16.cornerBlocks, List.mem_cons, List.not_mem_nil, or_false] at hb
  rcases hb with rfl | rfl | rfl | rfl
  · simp [CornerWire.Wide16.b12] at hbc
  · simp only [CornerWire.Wide16.b13, WideBank8.Fast16.FBlock2.std.injEq, Block2.plain.injEq] at hbc
    subst hbc; simp only [Rows.code, Rows.instr, wLiteral, List.map_cons, List.map_nil, List.mem_cons,
      List.not_mem_nil, or_false, WInstr.literal.injEq] at hp; subst hp; exact hz
  · simp only [CornerWire.Wide16.b14, WideBank8.Fast16.FBlock2.std.injEq, Block2.plain.injEq] at hbc
    subst hbc; simp only [WEX.cornerNeg, Rows.code, Rows.instr, wLiteral, List.cons_append, List.nil_append,
      List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false, WInstr.literal.injEq] at hp
    rcases hp with rfl | rfl | rfl
    · exact hcn1
    · exact hcn2
    · exact hcn1
  · simp [CornerWire.Wide16.b15] at hbc

private def rowAfterCode : Code2 65536 :=
  WideBank8.Fast16.fforget CornerWire.Wide16.midW ++
    (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks ++ WideBank8.Fast16.fforget CornerWire.Wide16.tailW)

private def rowMK : Nat := literalRecords (erase2 rowAfterCode)

private theorem b_seq_sim_forall2 {n} (f g : CatFn n) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (P₁ P₂ P₃ : InstrumentBranch → ℂ → Prop)
    (hf : ∃ cs, List.Forall₂ P₁ ((f s).prog.instantiate read h).run cs ∧ (cs.map Complex.normSq).sum = 1)
    (hg : ∀ h' : Fin (f s).finish → Bool, ∃ cs, List.Forall₂ P₂ ((g (f s).finish).prog.instantiate read h').run cs ∧ (cs.map Complex.normSq).sum = 1)
    (hcomp : ∀ b₁ k₁ b₂ k₂, P₁ b₁ k₁ → P₂ b₂ k₂ → P₃ (b₁.seq b₂) (k₁ * k₂)) :
    ∃ cs, List.Forall₂ P₃ (((CatFn.seq f g) s).prog.instantiate read h).run cs ∧ (cs.map Complex.normSq).sum = 1 := by
  obtain ⟨c1, a1, m1⟩ := hf
  rw [CatFn.seq, CatProg.append]
  obtain ⟨cs, al, hm⟩ := append_sim_forall2 (f s).prog (g (f s).finish).prog read h P₁ P₂ P₃ c1 a1 (fun h' _ => hg h') hcomp
  exact ⟨cs, al, hm.trans m1⟩

private theorem b_mPerm_len (a b c d : Nat) (h1 : a ≤ c) (h2 : b + c = d) :
    min a c + b + (c - a) = d := by omega

private theorem b_tableXorState_inv (mask : List Wire) (g : Bool) (s : BasisState) (w : Wire) :
    s w = tableXorState mask g (tableXorState mask g s) w := by
  dsimp only [tableXorState]
  cases s w <;> cases g <;> cases decide (w ∈ mask) <;> rfl

attribute [local irreducible] rowAfterCode rowMK

set_option maxHeartbeats 1200000 in
theorem compiledRow_catCoherent (coeffs : Fin 65536 → PointCoeff) (Q : Secp256k1.Point)
    (hQ : ShorECDLP.order • Q = 0) (hn : ∀ i, constantPoint Q (coeffs i) ≠ 0)
    (s : Nat) (h : Fin s → Bool) :
    CatCoherent 15645 ((compiledRow s).prog.instantiate (readConstant coeffs Q) h)
      (Finsupp.lmapDomain ℂ ℂ (Add.update .w16 coeffs Q)) liveReady := by
  let read := readConstant coeffs Q
  have hm0 : Site1Wire.Wide16.b0 ∈ WideBank8.Row16.code := by rw [CornerWire.Wide16.code_split_corner]; simp
  have hm1 : Site1Wire.Wide16.b1 ∈ WideBank8.Row16.code := by rw [CornerWire.Wide16.code_split_corner]; simp
  have hg0 := WideBank8.Row16.geometry Site1Wire.Wide16.b0 hm0
  have hg1 := WideBank8.Row16.geometry Site1Wire.Wide16.b1 hm1
  have hgm : ∀ b ∈ CornerWire.Wide16.midW, WideBank8.Fast16.FBlockGeo b := fun b hb =>
    WideBank8.Row16.geometry b (CornerWire.Wide16.mem_midW_code b hb)
  have hgc : ∀ b ∈ CornerWire.Wide16.cornerBlocks, WideBank8.Fast16.FBlockGeo b := fun b hb =>
    WideBank8.Row16.geometry b (CornerWire.Wide16.mem_corner_code b hb)
  let Target (a : Nat) (st2 : ECDSAAdd.State) (mk : List Bool) : State :=
    Prep 14833 (Bridge.signedKet (ECDSAAdd.run (reference2 read a rowAfterCode) mk st2))
  have hcode_app0 : WideBank8.Row16.code =
      [Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2] ++
        (CornerWire.Wide16.midW ++ (CornerWire.Wide16.cornerBlocks ++ CornerWire.Wide16.tailW)) := by
    rw [CornerWire.Wide16.code_split_corner]; simp [List.append_assoc]
  have hff_012 : WideBank8.Fast16.fforget [Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2] = Pre012 := by
    simp [Pre012, WideBank8.Fast16.fforget_cons, WideBank8.Fast16.fforget, List.append_assoc]
  have hff_after : WideBank8.Fast16.fforget (CornerWire.Wide16.midW ++ (CornerWire.Wide16.cornerBlocks ++ CornerWire.Wide16.tailW)) = rowAfterCode := by
    simp [rowAfterCode, WideBank8.Fast16.fforget_append]
  -- 1. Simulate `compiledAfterSite1` on `Prep 14833 (Bridge.signedKet st2)`
  have hAfter_sim (oS : List Bool) (hoS : oS.length = 2058)
      (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool) (hrs : rs.map hh = oS) :
      ∃ cs : List ℂ, List.Forall₂
        (fun b k => ∃ mk : List Bool, mk.length = rowMK ∧
          ∀ a (st2 : ECDSAAdd.State), ValidK coeffs Q a st2 →
            b.kraus (Prep 14833 (Bridge.signedKet st2)) =
              (k * Site1Wire.Wide16.portPhase Site1Wire.Wide16.allData oS read a) • Target a st2 mk)
        ((compiledAfterSite1 c rs).prog.instantiate read hh).run cs ∧ (cs.map Complex.normSq).sum = 1 := by
    -- First simulate `compiledCornerTail`
    have hCT_sim (c' : Nat) (rs' : List (Fin c')) (hh' : Fin c' → Bool) (hrs' : rs'.map hh' = oS) :
        ∃ cs : List ℂ, List.Forall₂
          (fun b k => ∃ m : List Bool, m.length = literalRecords (erase2 (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks ++ WideBank8.Fast16.fforget CornerWire.Wide16.tailW)) ∧
            ∀ a st {cx cy : ECDSAAdd.Fp} (hc : ECDSAAdd.Secp256k1.curve.toAffine.Nonsingular cx cy),
              RowReads (bRead32C coeffs Q a) (probeRows a) (.some hc) →
              ∀ (X Y : ECDSAAdd.Fp) (G : Bool) (base : BasisState),
              PointDialogValues streamLayout X Y G base st.basis →
              base windowRoot = true → base streamLayout.control = true → st.basis 14114 = true →
              (G = true → base streamLayout.infinitySelect = false ∧ base streamLayout.doubleSelect = false ∧
                base streamLayout.genericSelect = false ∧ base streamLayout.core.equalNegY = false) →
              AddrValid WideBank8.Fast16.windowBits windowRoot a st →
              WideBank8.Fast16.FCodeClean read a (CornerWire.Wide16.cornerBlocks ++ CornerWire.Wide16.tailW) st →
              Safe2 read a (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks ++ WideBank8.Fast16.fforget CornerWire.Wide16.tailW) st →
              b.kraus (Prep 14833 (Bridge.signedKet st)) =
                (k * Site1Wire.Wide16.portPhase Site1Wire.Wide16.allData oS read a) •
                  Prep 14833 (Bridge.signedKet (ECDSAAdd.run (reference2 read a
                    (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks ++ WideBank8.Fast16.fforget CornerWire.Wide16.tailW)) m st)))
          ((compiledCornerTail c' rs').prog.instantiate read hh').run cs ∧ (cs.map Complex.normSq).sum = 1 := by
      obtain ⟨cc, ac, mc⟩ := compiledCornerFused_sim coeffs Q oS hoS c' rs' hh' hrs'
      obtain ⟨ct, at_, mt⟩ := b_compiledTailW_catSim read (compiledCornerFused c' rs').finish (fun _ => false)
      refine ⟨coherentSeqCoefficients cc ct, ?_, by rw [simulationCoefficients_mass, mc, mt]; norm_num⟩
      rw [compiledCornerTail, b_catProg_append_run_indep _ _ (b_compiledTailW_indep _) read hh', AdaptiveCircuit.run_seq]
      apply simulationAligned_seq ac at_
      intro bc kc bt kt ⟨mc', lmc', rc⟩ ⟨mt', lmt', rt⟩
      refine ⟨mc' ++ mt', by simp [erase2_append, List.length_append, b_cornerBlocks_litRec, lmc', lmt'], ?_⟩
      intro a st cx cy hc hr X Y G base hv hroot hctl h14 hflag ha hcl hsafe
      have hmc' : mc'.length = ECDSAAdd.measurementCount (reference2 read a (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks)) := by
        rw [← b_cornerBlocks_litRec] at lmc'; exact lmc'.trans (specialize_counts read (erase2 _) a).2.symm
      have hsp := WideBank8.Fast16.safe2_append_inv read a
        (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks) (WideBank8.Fast16.fforget CornerWire.Wide16.tailW) st hsafe
      have hcl_sp := b_fcodeClean_append_inv read a CornerWire.Wide16.cornerBlocks CornerWire.Wide16.tailW st hcl
      have haOut := b_fcode_addr read CornerWire.Wide16.cornerBlocks hgc a st ha hcl_sp.1 mc' hmc'
      have hclTail := hcl_sp.2 mc' hmc'
      have hpathIn : Clean WideBank8.Fast16.pathBank st.basis := hcl_sp.1.1.1
      have hpathOut : Clean WideBank8.Fast16.pathBank
          (ECDSAAdd.run (reference2 read a (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks)) mc' st).basis :=
        b_fcode_path_clean read CornerWire.Wide16.cornerBlocks hgc b_cornerBlocks_plain_avoid_path a st ha hcl_sp.1 hpathIn mc' hmc'
      have hcref : reference2 read a (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks) =
          origCornerRef (bRead32C coeffs Q a) a := b_cornerBlocks_ref_eq coeffs Q a
      change bt.kraus (bc.kraus (Prep 14833 (Bridge.signedKet st))) = _
      rw [rc a st hc hr X Y G base hv hroot hctl h14 hflag ha hpathIn (hcref ▸ haOut) (hcref ▸ hpathOut),
        ← hcref, map_smul, rt a _ haOut hpathOut hclTail (hsp.2 mc' hmc'), reference2_append,
        run_append_records _ _ mc' mt' st hmc', smul_smul]
      exact congrArg (· • _) (by ring)
    rw [compiledAfterSite1]
    apply stepCatFn_sim compiledMidW compiledCornerTail read c rs hh _ _ _
      (compiledMidW_catSim coeffs Q hQ hn c hh)
      (fun cur rs' hh' hrs' => hCT_sim cur rs' hh' (hrs'.trans hrs))
    intro bm km bct kct ⟨mm', lmm', rm⟩ ⟨mct', lmct', rct⟩
    refine ⟨mm' ++ mct', by simp [rowMK, rowAfterCode, erase2_append, List.length_append, lmm', lmct'], ?_⟩
    intro a st2 hval
    obtain ⟨s0, m012, hs0, ha_s, hm012, hst2⟩ := hval
    have hsafe_all : Safe2 read a (WideBank8.Fast16.fforget WideBank8.Row16.code) ⟨false, s0⟩ := by
      rw [WideBank8.Row16.forget]; exact Rows.row_safe _ _ _ hQ hn a s0 hs0
    have hclean_all : WideBank8.Fast16.FCodeClean read a WideBank8.Row16.code ⟨false, s0⟩ :=
      WideBank8.Row16.clean_fused _ _ _ (WideBank8.Row16.clean_lift coeffs Q _ _ _
        (WEXFast.rowCF_clean (fun _ => coeffs (r16B a)) Q hQ (fun _ => hn _) a s0 hs0)
        (PoolHost.poolBand_clean_in_rowCF (fun _ => coeffs (r16B a)) Q hQ (fun _ => hn _) a s0 hs0)
        (by rw [WEXFast.fforget_rowCF]; exact PoolHost.rowC_host4 (fun _ => coeffs (r16B a)) Q hQ (fun _ => hn _) a s0 hs0))
    rw [hcode_app0] at hsafe_all hclean_all
    rw [WideBank8.Fast16.fforget_append, hff_012, hff_after] at hsafe_all
    have hsafe_012 := WideBank8.Fast16.safe2_append_inv read a Pre012 rowAfterCode ⟨false, s0⟩ hsafe_all
    have hclean_012 := b_fcodeClean_append_inv read a ([Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2])
      (CornerWire.Wide16.midW ++ (CornerWire.Wide16.cornerBlocks ++ CornerWire.Wide16.tailW)) ⟨false, s0⟩ hclean_all
    have hclAfter : WideBank8.Fast16.FCodeClean read a
        (CornerWire.Wide16.midW ++ (CornerWire.Wide16.cornerBlocks ++ CornerWire.Wide16.tailW)) st2 := by
      rw [hst2]; have h1 := hclean_012.2 m012 (by rw [hff_012]; exact hm012); rwa [hff_012] at h1
    have hsafeAfter : Safe2 read a rowAfterCode st2 := by rw [hst2]; exact hsafe_012.2 m012 hm012
    have ha2 : AddrValid WideBank8.Fast16.windowBits windowRoot a st2 := by
      have hg012 : ∀ b ∈ ([Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2] : WideBank8.Fast16.FCode2 65536),
          WideBank8.Fast16.FBlockGeo b := fun b hb => WideBank8.Row16.geometry b (by rw [hcode_app0]; exact List.mem_append_left _ hb)
      rw [hst2]; have h1 := b_fcode_addr read ([Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2]) hg012
        a ⟨false, s0⟩ ⟨ha_s, hs0.2.2⟩ hclean_012.1 m012 (by rw [hff_012]; exact hm012)
      rwa [hff_012] at h1
    have hcl_m := b_fcodeClean_append_inv read a CornerWire.Wide16.midW (CornerWire.Wide16.cornerBlocks ++ CornerWire.Wide16.tailW) st2 hclAfter
    have hsafe_m := WideBank8.Fast16.safe2_append_inv read a (WideBank8.Fast16.fforget CornerWire.Wide16.midW)
      (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks ++ WideBank8.Fast16.fforget CornerWire.Wide16.tailW) st2
      (by unfold rowAfterCode at hsafeAfter; exact hsafeAfter)
    have hmm' : mm'.length = ECDSAAdd.measurementCount (reference2 read a (WideBank8.Fast16.fforget CornerWire.Wide16.midW)) :=
      lmm'.trans (specialize_counts read (erase2 _) a).2.symm
    have hstepM := rm a st2 ⟨s0, m012, hs0, ha_s, hm012, hst2⟩
    have h14_pre := validK_after_midW_14114 coeffs Q hQ hn a st2 ⟨s0, m012, hs0, ha_s, hm012, hst2⟩ mm'
    set stPre := ECDSAAdd.run (reference2 read a (WideBank8.Fast16.fforget CornerWire.Wide16.midW)) mm' st2 with hstPre
    have haPre : AddrValid WideBank8.Fast16.windowBits windowRoot a stPre :=
      b_fcode_addr read CornerWire.Wide16.midW hgm a st2 ha2 hcl_m.1 mm' hmm'
    have hstPre_from0 : stPre = ECDSAAdd.run (reference2 read a (Pre012 ++ WideBank8.Fast16.fforget CornerWire.Wide16.midW)) (m012 ++ mm') ⟨false, s0⟩ := by
      rw [hstPre, hst2, reference2_append read a Pre012 (WideBank8.Fast16.fforget CornerWire.Wide16.midW),
        run_append_records _ _ m012 mm' ⟨false, s0⟩ hm012]
    let coeffs32 : Fin 32768 → PointCoeff := fun _ => coeffs (r16B a)
    have hstPre_ref : reference2 read a (Pre012 ++ WideBank8.Fast16.fforget CornerWire.Wide16.midW) =
        reference (bRead32C coeffs Q a) a CornerFast.preSite2Code := by
      rw [Pre012, b_pre_forget_eq, Rows.reference_blocks, bRead32C]; simp only [reference2, reference, erase2_map]
    let C := Single.Physical.tablePoint coeffs32 Q a
    have hC : C ≠ 0 := hn _
    have hord : ShorECDLP.order • C = 0 := Single.Physical.tablePoint_order coeffs32 Q hQ a
    obtain ⟨P, hP⟩ := hs0.1.2
    have work : ECDSAAdd.regValue streamLayout.work s0 = 0 :=
      (ECDSAAdd.Arithmetic.regValue_zero _ _).mpr (fun w hw => hs0.2.1 w (List.mem_append_left _ hw))
    have h838 : (838 : Wire) ∉ streamLayout.work := fun hm => by have h := streamWork_lower _ hm; norm_num at h
    have pool : ECDSAAdd.regValue streamLayout.work (flipInfinity s0) = 0 := (reg_update_outside _ _ _ _ h838).trans work
    have clean (w : Wire) (hw : w ∈ streamLayout.inPlaceFlags ++ streamLayout.dialogPool) : flipInfinity s0 w = false :=
      (ECDSAAdd.Arithmetic.regValue_zero _ _).mp pool w (one_boundary_work_subset streamLayout hw)
    have initial : PointDialogBoundary streamLayout (Bridge.toB P) true (fun _ => false) (flipInfinity s0) := by
      refine ⟨flipInfinity_holds s0 (Bridge.toB P) (StreamPoint.of_coordinates s0 P hs0.1.1.1.1 hP), ?_, ?_, ?_⟩
      · simpa [streamLayout_control, flipInfinity, ECDSAAdd.writeBit] using hs0.1.1.1.2
      · intro w hw; exact clean w (by simp [hw])
      · exact (ECDSAAdd.Arithmetic.regValue_zero _ _).mpr (fun w hw => clean w (by simp [hw]))
    cases he : Bridge.toB C with
    | zero => exact (hC (congrArg ECDSAAdd.ShorPort.toA he)).elim
    | @some cx cy hc =>
      have ce : C = toA (.some hc) := congrArg toA he
      have hr : RowReads (bRead32C coeffs Q a) (probeRows a) (.some hc) := by
        rw [bRead32C]; exact readConstant_rowReads coeffs32 Q _ _ ce
      have ho : ShorECDLP.order • (.some hc : ECDSAAdd.Secp256k1.Point) = 0 := by rw [← he]; exact hord
      have hp2 := torsion_unit_remainder_ne_zero (.some hc) ShorECDLP.order 2 (WeierstrassCurve.Affine.Point.some_ne_zero hc) ho (by norm_num [ShorECDLP.order])
      have hp3 := torsion_unit_remainder_ne_zero (.some hc) ShorECDLP.order 3 (WeierstrassCurve.Affine.Point.some_ne_zero hc) ho (by norm_num [ShorECDLP.order])
      have hd : (.some hc : ECDSAAdd.Secp256k1.Point) + .some hc ≠ 0 := by simpa only [two_nsmul] using hp2
      have ht : (.some hc : ECDSAAdd.Secp256k1.Point) + .some hc + .some hc ≠ 0 := by
        simpa only [show (3 : Nat) = 2 + 1 from rfl, succ_nsmul, two_nsmul] using hp3
      have en := enables_true hc hd ht
      have hdo : ShorECDLP.order • ((.some hc : ECDSAAdd.Secp256k1.Point) + .some hc) = 0 := by rw [nsmul_add, ho, zero_add]
      obtain ⟨X, Y, G, base, hv, hroot, hctl, hflag⟩ :=
        CornerFast.preSite2_values (bRead32C coeffs Q a) a (Bridge.toB P) hc hr en.1 en.2 hd hdo s0 initial hs0.2.2 (m012 ++ mm')
      rw [← hstPre_ref, ← hstPre_from0] at hv
      have hstepCT := rct a stPre hc hr X Y G base hv hroot hctl h14_pre hflag haPre (hcl_m.2 mm' hmm') (hsafe_m.2 mm' hmm')
      dsimp only [InstrumentBranch.seq]; rw [LinearMap.comp_apply]
      rw [hstepM, map_smul, hstepCT, smul_smul]
      have hcomb : ECDSAAdd.run (reference2 read a (WideBank8.Fast16.fforget CornerWire.Wide16.cornerBlocks ++
            WideBank8.Fast16.fforget CornerWire.Wide16.tailW)) mct' stPre =
          ECDSAAdd.run (reference2 read a rowAfterCode) (mm' ++ mct') st2 := by
        rw [hstPre, ← run_append_records _ _ mm' mct' st2 hmm', ← reference2_append]; unfold rowAfterCode; rfl
      rw [hcomb]
      exact congrArg (· • Target a st2 (mm' ++ mct')) (by ring)
  -- 2. Simulate `compiledTwoPassCont` (8 steps on wire `14833`)
  have hTP_sim (s' : Nat) (h' : Fin s' → Bool) :
      ∃ cs : List ℂ, List.Forall₂
        (fun b k => ∃ m : List Bool, ∃ mk : List Bool,
          m.length = ECDSAAdd.measurementCount site1Arith ∧ mk.length = rowMK ∧
          ∀ a (st : ECDSAAdd.State),
            let st2 := ECDSAAdd.run ((specialize Site1Wire.Wide16.site1_16.code a).instantiate read) m st
            AddrValid WideBank8.Fast16.windowBits windowRoot a st →
            Clean WideBank8.Fast16.pathBank st.basis →
            Clean streamLayout.dialogPool st.basis →
            (∀ m', Clean scrAllWires (ECDSAAdd.run ((specialize Site1Wire.Wide16.site1_16.code a).instantiate read) m' st).basis) →
            ValidK coeffs Q a st2 →
            b.kraus (Prep 14833 (Bridge.signedKet st)) = k • Target a st2 mk)
        ((compiledTwoPassCont s').prog.instantiate read h').run cs ∧ (cs.map Complex.normSq).sum = 1 := by
    have n33_pe : (14833 : Wire) ∉ pairExtraWires := fun hm => by
      have := Site1Wire.mem_pairExtra hm; dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    have n33_gB : (14833 : Wire) ∉ gB := fun hm => by
      have := Site1Wire.mem_pairExtra_gB (List.mem_append_right _ hm); dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    have n33_sh : (14833 : Wire) ∉ shortWires := fun hm => by
      have := shortWires_bounds 14833 hm; dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    have n33_gA : (14833 : Wire) ∉ garbA := fun hm => by
      have := Site1Wire.mem_garbA hm; dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    have hbits_no_pe : ∀ w ∈ WideBank8.Fast16.windowBits, w ∉ pairExtraWires := fun w hw hm => by
      have hb := Site1Wire.mem_pairExtra hm
