    harith_stage true ([midB7, midB8]) (fun _ d => (d.X4, d.Y1)) (fun _ d => d.hX4)
  have hS5 : ∀ s' h', CatBlockSim 14833 read midB5.forgetL P5
      ((CatFn.lower 14832 14833 (WideBank8.Fast16.fblockProg midB5 0) s').prog.instantiate read h') :=
    hlow_stage 14832 14833 midB5 hmem5 ([midB6, midB7, midB8]) _ hg.1 hg.2 (by decide) (pool_mem_of_idx 717 (by decide)) (pool_mem_of_idx 718 (by decide))
  have hS4 : ∀ s' h', CatBlockSim 14833 read midB4.forgetL P4
      ((CatFn.swapSurround 14833 14850 (CatFn.lower 14849 14850 (WideBank8.Fast16.fblockProg midB4 0)) s').prog.instantiate read h') :=
    catBlockSim_swapSurround (by decide) _ (CatFn.lower_indep _ _ _) _ P4
