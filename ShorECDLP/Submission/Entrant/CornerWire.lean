import ShorECDLP.Submission.Entrant.WideBank8

set_option Elab.async false

/-! ### Consolidated from `Site1Fast.lean` -/
section
/-! Two-pass SelectSwap replacement for `site1` (the entry lookup site of every window row).

`site1` loads 771 wires (`scrShortWires` = 258, `scrPairWires` = 258, `scrDExtraWires` = 255)
with a single 0-bit QROM (`N - 1` Toffolis). With 1,042 clean pool wires available in both
narrow (15-bit) and wide (16-bit) windows:
- Pass A loads `scrShortWires` (258 wires) with 2-bit SelectSwap (`4 × 258 = 1,032` wires,
  `N/4 - 1` QROM + `774` swaps), immediately measure-resets its 774 garbage wires, runs
  `shortPart`, and measure-resets `scrShortWires` (258 wires).
- Pass B loads `scrPairWires ++ scrDExtraWires` (513 wires) with 1-bit SelectSwap
  (`2 × 513 = 1,026` wires, `N/2 - 1` QROM + `513` swaps), immediately measure-resets its
  513 garbage wires, runs `pairPart ++ pointDialogGenericFlag ++ zrep ++ pair1Prog`, and
  runs one single fused measured clear that clears `scrPairWires ++ scrDExtraWires` while
  repaying all deferred X-basis phases from Pass A and Pass B.

Savings: `15,098` Toffolis per wide window and `6,906` Toffolis per narrow window
(`342,110` Toffolis = `1,368,440` T-model gates across 19 wide + 8 narrow windows). -/

namespace ShorECDLP.Entrant.Site1Fast
open Quantum Challenge Paper2607_13816 Paper2607_13816.ChallengeMigration
open WEX WEXUnlookup PathShare
open ECDSAAdd.Arithmetic ECDSAAdd.Arithmetic.ControlledPointLayout ECDSAAdd.Secp256k1
open ECDSAAdd.ShorPort ECDSAAdd.Entrant
noncomputable section
set_option maxHeartbeats 8000000
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySimpa false
set_option linter.unusedVariables false
theorem run_nil (m : List Bool) (s : ECDSAAdd.State) : ECDSAAdd.run List.nil m s = s := rfl

theorem run_cons_X (t : Wire) (p : ECDSAAdd.Program) (m : List Bool) (s : ECDSAAdd.State) :
    ECDSAAdd.run (.X t :: p) m s =
      ECDSAAdd.run p m ⟨s.phase, ECDSAAdd.writeBit s.basis t (!s.basis t)⟩ := rfl

theorem run_cons_CX (c t : Wire) (p : ECDSAAdd.Program) (m : List Bool) (s : ECDSAAdd.State) :
    ECDSAAdd.run (.CX c t :: p) m s =
      ECDSAAdd.run p m ⟨s.phase, ECDSAAdd.writeBit s.basis t (s.basis t ^^ s.basis c)⟩ := rfl

theorem run_cons_CCX (a b t : Wire) (p : ECDSAAdd.Program) (m : List Bool) (s : ECDSAAdd.State) :
    ECDSAAdd.run (.CCX a b t :: p) m s =
      ECDSAAdd.run p m ⟨s.phase, ECDSAAdd.writeBit s.basis t (s.basis t ^^ (s.basis a && s.basis b))⟩ := rfl

theorem run_cons_measureX (t : Wire) (c₀ c₁ : List ECDSAAdd.Correction) (p : ECDSAAdd.Program)
    (m : List Bool) (s : ECDSAAdd.State) :
    ECDSAAdd.run (.measureX t c₀ c₁ :: p) m s =
      ECDSAAdd.run p m.tail (ECDSAAdd.measureAndCorrect t c₀ c₁ (m.headD false) s) := rfl

theorem correct_basis : ∀ (cs : List ECDSAAdd.Correction) (s : ECDSAAdd.State),
    (ECDSAAdd.correct cs s).basis = s.basis
  | [], _ => rfl
  | .Z _ :: cs, s => correct_basis cs _
  | .CZ _ _ :: cs, s => correct_basis cs _

attribute [local irreducible] ECDSAAdd.run scrInP1 scrInP2 pair1Prog
  scrPairWires scrShortWires scrDExtraWires WEXUnlookup.rowC WEXUnlookup.rowHead
  WEX.codeRecords lookupMeasurements WEX.portOps tableAddressTree
  MeasuredClear.recordMeasurements MeasuredClear.recordUnaryOps WEX.compile Bridge.translate
  ECDSAAdd.Baselines.normalizeProgram

theorem list_all_congr {α : Type*} (l : List α) (p q : α → Bool) (h : ∀ x ∈ l, p x = q x) :
    l.all p = l.all q := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    simp only [List.all_cons, h a List.mem_cons_self, ih (fun x hx => h x (List.mem_cons_of_mem _ hx))]

theorem scrDExtraWires_explicit : scrDExtraWires = List.range' 15399 255 := by
  unfold scrDExtraWires
  exact WEX.map_poolWire 1284 255 (by norm_num)

theorem sl_yLow : yLow streamLayout = 580 := by
  simp only [yLow, streamLayout_point, List.range'_succ, List.headD_cons]
theorem sl_control : streamLayout.control = 836 := rfl
theorem sl_doubleSelect : streamLayout.doubleSelect = 19815 := rfl
theorem sl_genericSelect : streamLayout.genericSelect = 19814 := rfl
theorem sl_equalX : streamLayout.core.equalX = 14111 := rfl
theorem sl_equalNegY : streamLayout.core.equalNegY = 14112 := rfl
theorem sl_generic : streamLayout.core.generic = 14113 := rfl

/-! ### Part 1: Pure `ECDSAAdd` two-pass decomposition of `site1` -/

def pairPart : ECDSAAdd.Program :=
  cxList scrPairWires scrPairTargets ++
    (scrInP1 ++ (cxList scrPairWires scrPairTargets ++ [.X (yLow streamLayout)]))

def shortPart : ECDSAAdd.Program :=
  cxList scrShortWires scrShortTargets ++
    (scrInP2 ++ cxList scrShortWires scrShortTargets)

def tailPart : ECDSAAdd.Program :=
  pairPart ++ (pointDialogGenericFlag streamLayout ++
    (ECDSAAdd.Frontier.zrep streamLayout ++ pair1Prog))

def shortPorts (rows : Nat → Fin 32768) : List (LookupPort 32768) :=
  retarget (scrInShortBits rows) scrShortWires

def pairExtraPorts (rows : Nat → Fin 32768) : List (LookupPort 32768) :=
  retarget (scrPairBits rows (wBit rows .y)) scrPairWires ++ negYExtraPorts rows

def shortWires : List Wire := scrShortWires
def pairExtraWires : List Wire := scrPairWires ++ scrDExtraWires

theorem shortPorts_targets (rows : Nat → Fin 32768) : portTargets (shortPorts rows) = shortWires :=
  retarget_targets _ _ ((scrInShortBits_length rows).trans scrShortWires_length.symm)

theorem pairExtraPorts_targets (rows : Nat → Fin 32768) : portTargets (pairExtraPorts rows) = pairExtraWires := by
  simp only [pairExtraPorts, portTargets, List.map_append, pairExtraWires]
  exact congrArg₂ (· ++ ·)
    (retarget_targets _ _ ((scrPairBits_length rows _).trans scrPairWires_length.symm))
    (negYExtra_targets rows)

theorem shortWires_length : shortWires.length = 258 := scrShortWires_length

theorem pairExtraWires_length : pairExtraWires.length = 513 := by
  have h1 : scrPairWires.length = 258 := scrPairWires_length
  have h2 : scrDExtraWires.length = 255 := by rw [scrDExtraWires_explicit]; simp
  simp [pairExtraWires, h1, h2]

theorem shortPorts_length (rows : Nat → Fin 32768) : (shortPorts rows).length = 258 := by
  have h := congrArg List.length (shortPorts_targets rows)
  simpa [portTargets, shortWires_length] using h

theorem pairExtraPorts_length (rows : Nat → Fin 32768) : (pairExtraPorts rows).length = 513 := by
  have h := congrArg List.length (pairExtraPorts_targets rows)
  simpa [portTargets, pairExtraWires_length] using h

/-- Concrete target effect of `scrInP1` on `yLow`, `doubleSelect`, and `genericSelect`. -/
def p1Effect (v : Bool) (s : BasisState) : BasisState :=
  let s1 := ECDSAAdd.writeBit s streamLayout.doubleSelect (s streamLayout.doubleSelect ^^ (v && s (yLow streamLayout)))
  let s2 := ECDSAAdd.writeBit s1 (yLow streamLayout) (!s1 (yLow streamLayout))
  ECDSAAdd.writeBit s2 streamLayout.genericSelect (s2 streamLayout.genericSelect ^^ (v && s2 (yLow streamLayout)))

theorem p1Effect_frame (v : Bool) (s : BasisState) (w : Wire)
    (hw : w ∉ [yLow streamLayout, streamLayout.doubleSelect, streamLayout.genericSelect]) :
    p1Effect v s w = s w := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hw
  obtain ⟨h1, h2, h3⟩ := hw
  simp [p1Effect, ECDSAAdd.writeBit, Function.update, h1, h2, h3]

theorem p1Effect_write (v : Bool) (s : BasisState) (w : Wire) (z : Bool)
    (hw : w ∉ [yLow streamLayout, streamLayout.doubleSelect, streamLayout.genericSelect]) :
    p1Effect v (ECDSAAdd.writeBit s w z) = ECDSAAdd.writeBit (p1Effect v s) w z := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hw
  obtain ⟨h1, h2, h3⟩ := hw
  have hy1 : yLow streamLayout ≠ streamLayout.doubleSelect := by rw [sl_yLow, sl_doubleSelect]; decide
  have hy2 : yLow streamLayout ≠ streamLayout.genericSelect := by rw [sl_yLow, sl_genericSelect]; decide
  have h12 : streamLayout.doubleSelect ≠ streamLayout.genericSelect := by rw [sl_doubleSelect, sl_genericSelect]; decide
  funext u
  by_cases hu : u = w
  · subst hu; simp [p1Effect, ECDSAAdd.writeBit, Function.update, h1, h2, h3]
  · simp [p1Effect, ECDSAAdd.writeBit, Function.update, hu, Ne.symm h1, Ne.symm h2, Ne.symm h3,
      hy1, hy2, h12, Ne.symm hy1, Ne.symm hy2, Ne.symm h12]

theorem run_outside_basis : ∀ (p : ECDSAAdd.Program) (m : List Bool) (s : ECDSAAdd.State) (w : Wire),
    w ∉ ECDSAAdd.wires p → (ECDSAAdd.run p m s).basis w = s.basis w
  | [], _, _, _, _ => by rw [run_nil]
  | .X t :: p, m, s, w, hw => by
    simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_singleton, not_or] at hw
    rw [run_cons_X, run_outside_basis p m _ w hw.2]
    simp [ECDSAAdd.writeBit, Function.update, hw.1]
  | .CX c t :: p, m, s, w, hw => by
    simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, not_or] at hw
    rw [run_cons_CX, run_outside_basis p m _ w hw.2]
    simp [ECDSAAdd.writeBit, Function.update, hw.1.2]
  | .CCX a b t :: p, m, s, w, hw => by
    simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, not_or] at hw
    rw [run_cons_CCX, run_outside_basis p m _ w hw.2]
    simp [ECDSAAdd.writeBit, Function.update, hw.1.2.2]
  | .measureX t c₀ c₁ :: p, m, s, w, hw => by
    simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, not_or] at hw
    rw [run_cons_measureX, run_outside_basis p m.tail _ w hw.2, ECDSAAdd.measureAndCorrect, correct_basis]
    simp [ECDSAAdd.writeBit, Function.update, hw.1.1]

theorem p1Tail_run (c : Wire)
    (hc : c ∉ [yLow streamLayout, streamLayout.doubleSelect, streamLayout.genericSelect])
    (s : ECDSAAdd.State) (m : List Bool) :
    ECDSAAdd.run ([.CCX c (yLow streamLayout) streamLayout.doubleSelect,
      .X (yLow streamLayout), .CCX c (yLow streamLayout) streamLayout.genericSelect] : ECDSAAdd.Program) m s =
      ⟨s.phase, p1Effect (s.basis c) s.basis⟩ := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hc
  obtain ⟨hc1, hc2, hc3⟩ := hc
  have hy1 : yLow streamLayout ≠ streamLayout.doubleSelect := by rw [sl_yLow, sl_doubleSelect]; decide
  rw [run_cons_CCX, run_cons_X, run_cons_CCX, run_nil]
  simp [p1Effect, ECDSAAdd.writeBit, Function.update, hc1, hc2, hc3, hy1, Ne.symm hy1]

theorem pool_take_eq (k : Nat) (hk : k ≤ 2613) :
    streamLayout.dialogPool.take k = List.range' 14115 k := by
  rw [ECDSAAdd.Entrant.pool_block streamLayout streamLayout_widths k hk]
  exact WEX.map_poolWire 0 k (by omega)

theorem mem_pool_take (k : Nat) (hk : k ≤ 2613) {w : Wire} :
    w ∈ streamLayout.dialogPool.take k ↔ 14115 ≤ w ∧ w < 14115 + k := by
  rw [pool_take_eq k hk, List.mem_range'_1]

theorem zeroPorts_mem_flatMap {xs ys : List Wire} {w : Wire}
    (hw : w ∈ (zeroPorts xs ys).flatMap ZeroBit.wires) : w ∈ xs ∨ w ∈ ys := by
  induction xs generalizing ys with
  | nil => simp [zeroPorts] at hw
  | cons x xs ih =>
    cases ys with
    | nil => simp [zeroPorts] at hw
    | cons y ys =>
      simp only [zeroPorts, List.flatMap_cons, ZeroBit.wires, List.mem_append, List.mem_cons,
        List.not_mem_nil, or_false] at hw
      rcases hw with (rfl | rfl) | h
      · exact Or.inl List.mem_cons_self
      · exact Or.inr List.mem_cons_self
      · exact (ih h).imp (List.mem_cons_of_mem _) (List.mem_cons_of_mem _)

theorem zeroPorts_flatMap_nodup {xs ys : List Wire} (hx : xs.Nodup) (hy : ys.Nodup)
    (hxy : ∀ x ∈ xs, x ∉ ys) : ((zeroPorts xs ys).flatMap ZeroBit.wires).Nodup := by
  induction xs generalizing ys with
  | nil => simp [zeroPorts]
  | cons x xs ih =>
    cases ys with
    | nil => simp [zeroPorts]
    | cons y ys =>
      have ⟨hxn, hx'⟩ := List.nodup_cons.mp hx
      have ⟨hyn, hy'⟩ := List.nodup_cons.mp hy
      have hxy1 : x ≠ y := fun e => hxy x List.mem_cons_self (e ▸ List.mem_cons_self)
      have hsub : ∀ a ∈ xs, a ∉ ys := fun a ha hm => hxy a (List.mem_cons_of_mem _ ha) (List.mem_cons_of_mem _ hm)
      have hrest := ih hx' hy' hsub
      simp only [zeroPorts, List.flatMap_cons, ZeroBit.wires, List.cons_append, List.nil_append, List.nodup_cons]
      refine ⟨?_, ?_, hrest⟩
      · intro hm
        simp only [List.mem_cons] at hm
        rcases hm with rfl | hm
        · exact hxy1 rfl
        · rcases zeroPorts_mem_flatMap hm with h | h
          · exact hxn h
          · exact hxy x List.mem_cons_self (List.mem_cons_of_mem _ h)
      · intro hm
        rcases zeroPorts_mem_flatMap hm with h | h
        · exact hxy y (List.mem_cons_of_mem _ h) List.mem_cons_self
        · exact hyn h

theorem zeroPorts_mem_input_work {xs ys : List Wire} {b : ZeroBit} (hb : b ∈ zeroPorts xs ys) :
    b.input ∈ xs ∧ b.work ∈ ys := by
  induction xs generalizing ys with
  | nil => simp [zeroPorts] at hb
  | cons x xs ih =>
    cases ys with
    | nil => simp [zeroPorts] at hb
    | cons y ys =>
      simp only [zeroPorts, List.mem_cons] at hb
      rcases hb with rfl | hb
      · exact ⟨List.mem_cons_self, List.mem_cons_self⟩
      · exact ⟨List.mem_cons_of_mem _ (ih hb).1, List.mem_cons_of_mem _ (ih hb).2⟩

theorem pairSrc_eq : ECDSAAdd.Entrant.pairSrc streamLayout = 838 :: List.range' 263 256 := by
  simp [ECDSAAdd.Entrant.pairSrc, streamLayout_point]

theorem shortSrc_eq : ECDSAAdd.Entrant.shortSrc streamLayout =
    838 :: List.range' 263 256 ++ [580] := by
  simp [ECDSAAdd.Entrant.shortSrc, streamLayout_point]

theorem pairPorts_nodup : (streamLayout.control :: (pairPorts streamLayout).flatMap ZeroBit.wires).Nodup := by
  have hx : (ECDSAAdd.Entrant.pairSrc streamLayout).Nodup := by
    rw [pairSrc_eq, List.nodup_cons]
    exact ⟨by simp [List.mem_range'_1], List.nodup_range'⟩
  have hy : (streamLayout.dialogPool.take 257).Nodup := by
    rw [pool_take_eq 257 (by decide)]; exact List.nodup_range'
  have hxy : ∀ x ∈ ECDSAAdd.Entrant.pairSrc streamLayout, x ∉ streamLayout.dialogPool.take 257 := by
    intro x hx' hm
    rw [pairSrc_eq, List.mem_cons, List.mem_range'_1] at hx'
    rw [mem_pool_take 257 (by decide)] at hm
    dsimp only [Wire, ECDSAAdd.Wire] at *; omega
  rw [List.nodup_cons]
  refine ⟨?_, zeroPorts_flatMap_nodup hx hy hxy⟩
  intro hm
  rcases zeroPorts_mem_flatMap hm with h | h
  · rw [pairSrc_eq, List.mem_cons, List.mem_range'_1, sl_control] at h
    dsimp only [Wire, ECDSAAdd.Wire] at *; omega
  · rw [mem_pool_take 257 (by decide), sl_control] at h
    dsimp only [Wire, ECDSAAdd.Wire] at *; omega

theorem pairPorts_disj : ∀ b ∈ pairPorts streamLayout,
    b.input ∉ [yLow streamLayout, streamLayout.doubleSelect, streamLayout.genericSelect] ∧
    b.work ∉ [yLow streamLayout, streamLayout.doubleSelect, streamLayout.genericSelect] := by
  intro b hb
  obtain ⟨hi, hw⟩ := zeroPorts_mem_input_work hb
  rw [pairSrc_eq, List.mem_cons, List.mem_range'_1] at hi
  rw [mem_pool_take 257 (by decide)] at hw
  constructor <;> intro hm <;>
    (simp only [List.mem_cons, List.not_mem_nil, or_false, sl_yLow, sl_doubleSelect, sl_genericSelect] at hm;
     dsimp only [Wire, ECDSAAdd.Wire] at *; omega)

theorem pairPorts_work_in_pool : ∀ b ∈ pairPorts streamLayout, b.work ∈ streamLayout.dialogPool.take 258 := by
  intro b hb
  have hw := (zeroPorts_mem_input_work hb).2
  rw [mem_pool_take 257 (by decide)] at hw
  rw [mem_pool_take 258 (by decide)]
  dsimp only [Wire, ECDSAAdd.Wire] at *
  omega

theorem scrInP1_run (s : ECDSAAdd.State) (m : List Bool)
    (hz : Clean (streamLayout.dialogPool.take 258) s.basis) :
    ECDSAAdd.run scrInP1 m s =
      ⟨s.phase, p1Effect (s.basis streamLayout.control &&
        (pairPorts streamLayout).all (fun b => !s.basis b.input)) s.basis⟩ := by
  have hcu : streamLayout.control ∉ [yLow streamLayout, streamLayout.doubleSelect, streamLayout.genericSelect] := by
    simp only [List.mem_cons, List.not_mem_nil, or_false, sl_control, sl_yLow, sl_doubleSelect, sl_genericSelect]
    decide
  rw [show scrInP1 = zeroWith (fun w => [.CCX w (yLow streamLayout) streamLayout.doubleSelect,
      .X (yLow streamLayout), .CCX w (yLow streamLayout) streamLayout.genericSelect])
      streamLayout.control (pairPorts streamLayout) by unfold scrInP1; rfl]
  exact ECDSAAdd.Frontier.zeroWith_effect_run
    [yLow streamLayout, streamLayout.doubleSelect, streamLayout.genericSelect]
    (fun _ => True) p1Effect
    (fun w => [.CCX w (yLow streamLayout) streamLayout.doubleSelect,
      .X (yLow streamLayout), .CCX w (yLow streamLayout) streamLayout.genericSelect])
    (fun _ _ _ _ => Iff.rfl) p1Effect_frame p1Effect_write
    (fun c hc st k _ => p1Tail_run c hc st k)
    streamLayout.control (pairPorts streamLayout) hcu pairPorts_nodup pairPorts_disj
    s m trivial (fun b hb => hz b.work (pairPorts_work_in_pool b hb))

theorem shortPorts2_nodup :
    (streamLayout.core.equalX :: streamLayout.core.equalNegY ::
      (zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258)).flatMap ZeroBit.wires).Nodup := by
  have hx : (shortSrc streamLayout).Nodup := by
    rw [shortSrc_eq, List.cons_append, List.nodup_cons, List.nodup_append]
    refine ⟨by simp [List.mem_range'_1], List.nodup_range', List.nodup_singleton _, fun a ha b hb hab => ?_⟩
    subst hab; simp only [List.mem_range'_1, List.mem_singleton] at ha hb; dsimp only [Wire, ECDSAAdd.Wire] at *; omega
  have hy : (streamLayout.dialogPool.take 258).Nodup := by
    rw [pool_take_eq 258 (by decide)]; exact List.nodup_range'
  have hxy : ∀ x ∈ shortSrc streamLayout, x ∉ streamLayout.dialogPool.take 258 := by
    intro x hx' hm
    rw [shortSrc_eq, List.cons_append, List.mem_cons, List.mem_append, List.mem_range'_1, List.mem_singleton] at hx'
    rw [mem_pool_take 258 (by decide)] at hm
    dsimp only [Wire, ECDSAAdd.Wire] at *; omega
  rw [List.nodup_cons, List.nodup_cons]
  refine ⟨?_, ?_, zeroPorts_flatMap_nodup hx hy hxy⟩
  · intro hm
    simp only [List.mem_cons] at hm
    rcases hm with hm | hm
    · rw [sl_equalX, sl_equalNegY] at hm; exact absurd hm (by decide)
    · rcases zeroPorts_mem_flatMap hm with h | h
      · rw [shortSrc_eq, List.cons_append, List.mem_cons, List.mem_append, List.mem_range'_1, List.mem_singleton, sl_equalX] at h
        dsimp only [Wire, ECDSAAdd.Wire] at *; omega
      · rw [mem_pool_take 258 (by decide), sl_equalX] at h
        dsimp only [Wire, ECDSAAdd.Wire] at *; omega
  · intro hm
    rcases zeroPorts_mem_flatMap hm with h | h
    · rw [shortSrc_eq, List.cons_append, List.mem_cons, List.mem_append, List.mem_range'_1, List.mem_singleton, sl_equalNegY] at h
      dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    · rw [mem_pool_take 258 (by decide), sl_equalNegY] at h
      dsimp only [Wire, ECDSAAdd.Wire] at *; omega

theorem shortPorts2_work_in_pool :
    ∀ b ∈ zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258),
      b.work ∈ streamLayout.dialogPool.take 258 := fun _ hb => (zeroPorts_mem_input_work hb).2

theorem scrInP2_run (s : ECDSAAdd.State) (m : List Bool)
    (hz : Clean (streamLayout.dialogPool.take 258) s.basis) :
    ECDSAAdd.run scrInP2 m s =
      ⟨s.phase, ECDSAAdd.writeBit s.basis streamLayout.core.equalNegY
        (s.basis streamLayout.core.equalNegY ^^
          (s.basis streamLayout.core.equalX &&
            (zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258)).all
              (fun b => !s.basis b.input)))⟩ := by
  rw [show scrInP2 = zeroControlled streamLayout.core.equalX streamLayout.core.equalNegY
      (zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258)) by unfold scrInP2; rfl]
  exact zeroControlled_correct streamLayout.core.equalX streamLayout.core.equalNegY
    (zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258))
    shortPorts2_nodup s m (fun b hb => hz b.work (shortPorts2_work_in_pool b hb))

theorem cxList_run_exact : ∀ (cs ts : List Wire) (hl : cs.length = ts.length), (cs ++ ts).Nodup →
    ∀ (s : ECDSAAdd.State) (m : List Bool),
      (ECDSAAdd.run (cxList cs ts) m s).phase = s.phase ∧
      (∀ w, w ∉ ts → (ECDSAAdd.run (cxList cs ts) m s).basis w = s.basis w) ∧
      (∀ i (hi : i < ts.length),
        (ECDSAAdd.run (cxList cs ts) m s).basis (ts[i]'hi) =
          (s.basis (ts[i]'hi) ^^ s.basis (cs[i]'(hl.symm ▸ hi)))) := by
  intro cs
  induction cs with
  | nil =>
    intro ts hl _ s m
    cases ts with
    | nil =>
      have h0 : ECDSAAdd.run (cxList List.nil List.nil) m s = s := run_nil m s
      exact ⟨by rw [h0], fun _ _ => by rw [h0], fun i hi => by simp at hi⟩
    | cons _ _ => simp at hl
  | cons c cs ih =>
    intro ts hl hnd s m
    cases ts with
    | nil => simp at hl
    | cons t ts =>
      have hl' : cs.length = ts.length := by simpa using hl
      have hnd' : c ∉ cs ++ t :: ts ∧ (cs ++ t :: ts).Nodup := by
        simpa [List.cons_append] using List.nodup_cons.mp hnd
      have hts : t ∉ cs ∧ t ∉ ts ∧ (cs ++ ts).Nodup := by
        have h1 := List.nodup_append.mp hnd'.2
        have h2 := List.nodup_cons.mp h1.2.1
        exact ⟨fun hc => h1.2.2 t hc t List.mem_cons_self rfl, h2.1,
          List.nodup_append.mpr ⟨h1.1, h2.2, fun a ha b hb => h1.2.2 a ha b (List.mem_cons_of_mem _ hb)⟩⟩
      have hstep : ECDSAAdd.run (cxList (c :: cs) (t :: ts)) m s =
          ECDSAAdd.run (cxList cs ts) m ⟨s.phase, ECDSAAdd.writeBit s.basis t (s.basis t ^^ s.basis c)⟩ :=
        run_cons_CX c t (cxList cs ts) m s
      rw [hstep]
      have hrec := ih ts hl' hts.2.2 ⟨s.phase, ECDSAAdd.writeBit s.basis t (s.basis t ^^ s.basis c)⟩ m
      refine ⟨hrec.1, ?_, ?_⟩
      · intro w hw
        simp only [List.mem_cons, not_or] at hw
        rw [hrec.2.1 w hw.2]
        simp [ECDSAAdd.writeBit, Function.update, hw.1]
      · intro i hi
        cases i with
        | zero =>
          simp only [List.getElem_cons_zero]
          rw [hrec.2.1 t hts.2.1]
          simp [ECDSAAdd.writeBit, Function.update]
        | succ j =>
          simp only [List.getElem_cons_succ]
          have hj : j < ts.length := Nat.lt_of_succ_lt_succ hi
          rw [hrec.2.2 j hj]
          have hne1 : ts[j]'hj ≠ t := fun e => hts.2.1 (e ▸ List.getElem_mem hj)
          have hne2 : cs[j]'(hl'.symm ▸ hj) ≠ t := fun e => hts.1 (e ▸ List.getElem_mem _)
          simp [ECDSAAdd.writeBit, Function.update, hne1, hne2]

theorem scrPairTargets_eq : scrPairTargets = 838 :: List.range' 263 256 ++ [580] := by
  simp [scrPairTargets, sl_yLow, streamLayout_point]
theorem scrShortTargets_eq : scrShortTargets = 838 :: List.range' 263 256 ++ [580] := by
  simp [scrShortTargets, streamLayout_point]

theorem targets_nodup : (838 :: List.range' 263 256 ++ [580] : List Wire).Nodup := by
  rw [List.cons_append, List.nodup_cons, List.nodup_append]
  refine ⟨by simp [List.mem_range'_1], List.nodup_range', List.nodup_singleton _, fun a ha b hb hab => ?_⟩
  simp only [List.mem_range'_1, List.mem_singleton] at ha hb; dsimp only [Wire, ECDSAAdd.Wire] at *; omega

theorem scrPairWires_nd : scrPairWires.Nodup := (List.nodup_append.mp scrWires_nodup).1
theorem scrShortWires_nd : scrShortWires.Nodup := (List.nodup_append.mp scrWires_nodup).2.1

theorem scrPair_cx_nd : (scrPairWires ++ scrPairTargets).Nodup := by
  rw [List.nodup_append]
  refine ⟨scrPairWires_nd, by rw [scrPairTargets_eq]; exact targets_nodup, fun a ha b hb hab => ?_⟩
  subst hab
  exact scrWires_pair_targets a (List.mem_append_left _ ha) hb

theorem scrShort_cx_nd : (scrShortWires ++ scrShortTargets).Nodup := by
  rw [List.nodup_append]
  refine ⟨scrShortWires_nd, by rw [scrShortTargets_eq]; exact targets_nodup, fun a ha b hb hab => ?_⟩
  subst hab
  exact scrWires_short_targets a (List.mem_append_right _ ha) hb

theorem scrPair_len_eq : scrPairWires.length = scrPairTargets.length := by
  have h1 : scrPairWires.length = 258 := scrPairWires_length
  have h2 : scrPairTargets.length = 258 := by rw [scrPairTargets_eq]; simp
  omega

theorem scrShort_len_eq : scrShortWires.length = scrShortTargets.length := by
  have h1 : scrShortWires.length = 258 := scrShortWires_length
  have h2 : scrShortTargets.length = 258 := by rw [scrShortTargets_eq]; simp
  omega

theorem pairTargets_not_pool : ∀ w ∈ streamLayout.dialogPool.take 258, w ∉ scrPairTargets := by
  intro w hw hm
  rw [mem_pool_take 258 (by decide)] at hw
  rw [scrPairTargets_eq, List.cons_append, List.mem_cons, List.mem_append, List.mem_range'_1, List.mem_singleton] at hm
  dsimp only [Wire, ECDSAAdd.Wire] at *; omega

theorem shortTargets_not_pool : ∀ w ∈ streamLayout.dialogPool.take 258, w ∉ scrShortTargets := pairTargets_not_pool

theorem pairTargets_no_flags :
    streamLayout.doubleSelect ∉ scrPairTargets ∧ streamLayout.genericSelect ∉ scrPairTargets ∧
    streamLayout.core.equalX ∉ scrPairTargets ∧ streamLayout.core.equalNegY ∉ scrPairTargets := by
  rw [sl_doubleSelect, sl_genericSelect, sl_equalX, sl_equalNegY]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> intro hm <;>
    (rw [scrPairTargets_eq, List.cons_append, List.mem_cons, List.mem_append, List.mem_range'_1, List.mem_singleton] at hm;
     dsimp only [Wire, ECDSAAdd.Wire] at *; omega)

theorem shortTargets_no_flags :
    streamLayout.doubleSelect ∉ scrShortTargets ∧ streamLayout.genericSelect ∉ scrShortTargets ∧
    streamLayout.core.equalX ∉ scrShortTargets ∧ streamLayout.core.equalNegY ∉ scrShortTargets :=
  pairTargets_no_flags

theorem shortWires_bounds (w : Wire) (hw : w ∈ shortWires) : 14884 ≤ w ∧ w < 15142 := by
  rw [shortWires, scrShortWires_explicit] at hw
  simp only [List.mem_append, List.mem_cons, List.mem_range'_1, List.mem_singleton,
    List.not_mem_nil, or_false] at hw
  dsimp only [Wire, ECDSAAdd.Wire] at *
  omega

theorem pairWires_bounds (w : Wire) (hw : w ∈ scrPairWires) :
    (14373 ≤ w ∧ w < 14630) ∨ w = 14883 := by
  rw [scrPairWires_explicit] at hw
  simp only [List.mem_append, List.mem_cons, List.mem_range'_1, List.mem_singleton,
    List.not_mem_nil, or_false] at hw
  dsimp only [Wire, ECDSAAdd.Wire] at *
  omega

theorem scrPairWires_no_flags :
    streamLayout.doubleSelect ∉ scrPairWires ∧ streamLayout.genericSelect ∉ scrPairWires ∧
    streamLayout.core.equalX ∉ scrPairWires ∧ streamLayout.core.equalNegY ∉ scrPairWires := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> intro h <;>
    (have hb := pairWires_bounds _ h;
     simp only [sl_doubleSelect, sl_genericSelect, sl_equalX, sl_equalNegY] at hb;
     dsimp only [Wire, ECDSAAdd.Wire] at *; omega)

theorem scrShortWires_no_flags :
    streamLayout.doubleSelect ∉ scrShortWires ∧ streamLayout.genericSelect ∉ scrShortWires ∧
    streamLayout.core.equalX ∉ scrShortWires ∧ streamLayout.core.equalNegY ∉ scrShortWires := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> intro h <;>
    (have hb := shortWires_bounds _ h;
     simp only [sl_doubleSelect, sl_genericSelect, sl_equalX, sl_equalNegY] at hb;
     dsimp only [Wire, ECDSAAdd.Wire] at *; omega)

/-- Closed-form action of `pairPart`: flips only `doubleSelect` and `genericSelect`, preserves every other wire. -/
theorem pairPart_run (s : ECDSAAdd.State) (m : List Bool)
    (hz : Clean (streamLayout.dialogPool.take 258) s.basis) :
    let u := ECDSAAdd.run (cxList scrPairWires scrPairTargets) List.nil s
    let v := u.basis streamLayout.control && (pairPorts streamLayout).all (fun b => !u.basis b.input)
    let y0 := u.basis (yLow streamLayout)
    ECDSAAdd.run pairPart m s =
      ⟨s.phase, ECDSAAdd.writeBit (ECDSAAdd.writeBit s.basis streamLayout.doubleSelect
        (s.basis streamLayout.doubleSelect ^^ (v && y0)))
        streamLayout.genericSelect (s.basis streamLayout.genericSelect ^^ (v && !y0))⟩ := by
  intro u v y0
  have hcx := cxList_run_exact scrPairWires scrPairTargets scrPair_len_eq scrPair_cx_nd s List.nil
  have hu_pool : Clean (streamLayout.dialogPool.take 258) u.basis := fun w hw => by
    dsimp only [u]; rw [hcx.2.1 w (pairTargets_not_pool w hw)]; exact hz w hw
  have hmc : ECDSAAdd.measurementCount (cxList scrPairWires scrPairTargets) = 0 := cxList_records _ _
  simp only [pairPart]
  rw [run_zero_append _ _ hmc, run_meas_append scrInP1, scrInP1_run u _ hu_pool,
    run_zero_append _ _ hmc]
  set p1 : ECDSAAdd.State := ⟨u.phase, p1Effect v u.basis⟩ with hp1
  have hcx2 := cxList_run_exact scrPairWires scrPairTargets scrPair_len_eq scrPair_cx_nd p1 List.nil
  have hnd_flags : yLow streamLayout ≠ streamLayout.doubleSelect ∧
      yLow streamLayout ≠ streamLayout.genericSelect ∧
      streamLayout.doubleSelect ≠ streamLayout.genericSelect := by
    rw [sl_yLow, sl_doubleSelect, sl_genericSelect]; decide
  have hp1_agree_cs : ∀ i (hi : i < scrPairWires.length),
      p1.basis (scrPairWires[i]'hi) = u.basis (scrPairWires[i]'hi) := by
    intro i hi
    apply p1Effect_frame v u.basis
    intro hm
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with hm | hm | hm
    · have hb := pairWires_bounds _ (List.getElem_mem hi)
      rw [hm, sl_yLow] at hb; dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    · exact scrPairWires_no_flags.1 (hm ▸ List.getElem_mem hi)
    · exact scrPairWires_no_flags.2.1 (hm ▸ List.getElem_mem hi)
  have hrunX (st : ECDSAAdd.State) :
      ECDSAAdd.run ([.X (yLow streamLayout)] : ECDSAAdd.Program) (m.drop (ECDSAAdd.measurementCount scrInP1)) st =
        ⟨st.phase, ECDSAAdd.writeBit st.basis (yLow streamLayout) (!st.basis (yLow streamLayout))⟩ := by
    rw [run_cons_X, run_nil]
  rw [hrunX]
  have hph : (ECDSAAdd.run (cxList scrPairWires scrPairTargets) List.nil p1).phase = s.phase :=
    hcx2.1.trans hcx.1
  refine ECDSAAdd.State.mk.injEq _ _ _ _ |>.mpr ⟨hph, ?_⟩
  funext w
  by_cases hw2 : w = streamLayout.genericSelect
  · subst hw2
    have h1 := hcx2.2.1 _ pairTargets_no_flags.2.1
    have h2 := hcx.2.1 _ pairTargets_no_flags.2.1
    simp only [ECDSAAdd.writeBit, Function.update, Ne.symm hnd_flags.2.1, ↓reduceDIte]
    rw [h1, hp1]
    simp [p1Effect, ECDSAAdd.writeBit, Function.update, hnd_flags.1, hnd_flags.2.1, hnd_flags.2.2,
      Ne.symm hnd_flags.1, Ne.symm hnd_flags.2.1, Ne.symm hnd_flags.2.2, u, y0, h2]
  · by_cases hw1 : w = streamLayout.doubleSelect
    · subst hw1
      have h1 := hcx2.2.1 _ pairTargets_no_flags.1
      have h2 := hcx.2.1 _ pairTargets_no_flags.1
      simp only [ECDSAAdd.writeBit, Function.update, Ne.symm hnd_flags.1, Ne.symm hnd_flags.2.2,
        hnd_flags.2.2, ↓reduceDIte]
      rw [h1, hp1]
      simp [p1Effect, ECDSAAdd.writeBit, Function.update, hnd_flags.1, hnd_flags.2.1, hnd_flags.2.2,
        Ne.symm hnd_flags.1, Ne.symm hnd_flags.2.1, Ne.symm hnd_flags.2.2, u, y0, h2]
    · simp only [ECDSAAdd.writeBit, Function.update, hw2, hw1, ↓reduceDIte]
      by_cases hwy : w = yLow streamLayout
      · subst hwy
        simp only [↓reduceDIte]
        have hmem : yLow streamLayout ∈ scrPairTargets := by
          rw [scrPairTargets_eq, sl_yLow]; simp
        obtain ⟨i, hi, he⟩ := List.getElem_of_mem hmem
        have h1 := hcx2.2.2 i hi
        have h2 := hcx.2.2 i hi
        rw [he] at h1 h2
        rw [h1, hp1_agree_cs i (scrPair_len_eq.symm ▸ hi)]
        have hp1y : p1.basis (yLow streamLayout) = !u.basis (yLow streamLayout) := by
          simp [hp1, p1Effect, ECDSAAdd.writeBit, Function.update, hnd_flags.1, hnd_flags.2.1]
        have huw : u.basis (scrPairWires[i]'(scrPair_len_eq.symm ▸ hi)) =
            s.basis (scrPairWires[i]'(scrPair_len_eq.symm ▸ hi)) := by
          dsimp only [u]
          exact hcx.2.1 _ (fun hm => scrWires_pair_targets _ (List.mem_append_left _ (List.getElem_mem _)) hm)
        rw [hp1y, huw]
        dsimp only [u]
        rw [h2]
        cases s.basis (yLow streamLayout) <;> cases s.basis (scrPairWires[i]'(scrPair_len_eq.symm ▸ hi)) <;> rfl
      · simp only [hwy, ↓reduceDIte]
        by_cases hwt : w ∈ scrPairTargets
        · obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hwt
          rw [hcx2.2.2 i hi, hp1_agree_cs i (scrPair_len_eq.symm ▸ hi)]
          have hp1w : p1.basis (scrPairTargets[i]'hi) = u.basis (scrPairTargets[i]'hi) := by
            rw [hp1]; exact p1Effect_frame v u.basis _ (by simp [hwy, hw1, hw2])
          have huw : u.basis (scrPairWires[i]'(scrPair_len_eq.symm ▸ hi)) =
              s.basis (scrPairWires[i]'(scrPair_len_eq.symm ▸ hi)) := by
            dsimp only [u]
            exact hcx.2.1 _ (fun hm => scrWires_pair_targets _ (List.mem_append_left _ (List.getElem_mem _)) hm)
          rw [hp1w, huw]
          dsimp only [u]
          rw [hcx.2.2 i hi]
          cases s.basis (scrPairTargets[i]'hi) <;> cases s.basis (scrPairWires[i]'(scrPair_len_eq.symm ▸ hi)) <;> rfl
        · rw [hcx2.2.1 w hwt, hp1]
          dsimp only
          rw [p1Effect_frame v u.basis w (by simp [hwy, hw1, hw2])]
          dsimp only [u]
          exact hcx.2.1 w hwt

/-- Closed-form action of `shortPart`: flips only `equalNegY`, preserves every other wire. -/
theorem shortPart_run (s : ECDSAAdd.State) (m : List Bool)
    (hz : Clean (streamLayout.dialogPool.take 258) s.basis) :
    let u := ECDSAAdd.run (cxList scrShortWires scrShortTargets) List.nil s
    let v := u.basis streamLayout.core.equalX &&
      (zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258)).all (fun b => !u.basis b.input)
    ECDSAAdd.run shortPart m s =
      ⟨s.phase, ECDSAAdd.writeBit s.basis streamLayout.core.equalNegY (s.basis streamLayout.core.equalNegY ^^ v)⟩ := by
  intro u v
  have hcx := cxList_run_exact scrShortWires scrShortTargets scrShort_len_eq scrShort_cx_nd s List.nil
  have hu_pool : Clean (streamLayout.dialogPool.take 258) u.basis := fun w hw => by
    dsimp only [u]; rw [hcx.2.1 w (shortTargets_not_pool w hw)]; exact hz w hw
  have hmc : ECDSAAdd.measurementCount (cxList scrShortWires scrShortTargets) = 0 := cxList_records _ _
  simp only [shortPart]
  rw [run_zero_append _ _ hmc, run_meas_append scrInP2, scrInP2_run u _ hu_pool]
  set p2 : ECDSAAdd.State := ⟨u.phase, ECDSAAdd.writeBit u.basis streamLayout.core.equalNegY
    (u.basis streamLayout.core.equalNegY ^^ v)⟩ with hp2
  have hcx2 := cxList_run_exact scrShortWires scrShortTargets scrShort_len_eq scrShort_cx_nd p2
    (m.drop (ECDSAAdd.measurementCount scrInP2))
  have hp2_agree_cs : ∀ i (hi : i < scrShortWires.length),
      p2.basis (scrShortWires[i]'hi) = u.basis (scrShortWires[i]'hi) := by
    intro i hi
    have hne : scrShortWires[i]'hi ≠ streamLayout.core.equalNegY :=
      fun e => scrShortWires_no_flags.2.2.2 (e ▸ List.getElem_mem hi)
    simp [hp2, ECDSAAdd.writeBit, Function.update, hne]
  have hph : (ECDSAAdd.run (cxList scrShortWires scrShortTargets)
      (m.drop (ECDSAAdd.measurementCount scrInP2)) p2).phase = s.phase := hcx2.1.trans hcx.1
  refine ECDSAAdd.State.mk.injEq _ _ _ _ |>.mpr ⟨hph, ?_⟩
  funext w
  by_cases hw : w = streamLayout.core.equalNegY
  · subst hw
    rw [hcx2.2.1 _ shortTargets_no_flags.2.2.2]
    simp only [hp2, ECDSAAdd.writeBit, Function.update, ↓reduceDIte]
    dsimp only [u]
    rw [hcx.2.1 _ shortTargets_no_flags.2.2.2]
  · simp only [ECDSAAdd.writeBit, Function.update, hw, ↓reduceDIte]
    by_cases hwt : w ∈ scrShortTargets
    · obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hwt
      rw [hcx2.2.2 i hi, hp2_agree_cs i (scrShort_len_eq.symm ▸ hi)]
      simp only [hp2, ECDSAAdd.writeBit, Function.update, hw, ↓reduceDIte]
      have huw : u.basis (scrShortWires[i]'(scrShort_len_eq.symm ▸ hi)) =
          s.basis (scrShortWires[i]'(scrShort_len_eq.symm ▸ hi)) := by
        dsimp only [u]
        exact hcx.2.1 _ (fun hm => scrWires_short_targets _ (List.mem_append_right _ (List.getElem_mem _)) hm)
      rw [huw]
      dsimp only [u]
      rw [hcx.2.2 i hi]
      cases s.basis (scrShortTargets[i]'hi) <;> cases s.basis (scrShortWires[i]'(scrShort_len_eq.symm ▸ hi)) <;> rfl
    · rw [hcx2.2.1 w hwt]
      simp only [hp2, ECDSAAdd.writeBit, Function.update, hw, ↓reduceDIte]
      dsimp only [u]
      exact hcx.2.1 w hwt

/-- `shortPart` and `pairPart` commute on any state with clean `dialogPool.take 258`. -/
theorem shortPart_pairPart_comm (s : ECDSAAdd.State) (m₁ m₂ : List Bool)
    (hz : Clean (streamLayout.dialogPool.take 258) s.basis) :
    ECDSAAdd.run (shortPart ++ pairPart) m₁ s = ECDSAAdd.run (pairPart ++ shortPart) m₂ s := by
  have hne : streamLayout.core.equalNegY ≠ streamLayout.doubleSelect ∧
      streamLayout.core.equalNegY ≠ streamLayout.genericSelect ∧
      streamLayout.doubleSelect ≠ streamLayout.genericSelect := by
    rw [sl_equalNegY, sl_doubleSelect, sl_genericSelect]; decide
  have heq_pool : streamLayout.core.equalNegY ∉ streamLayout.dialogPool.take 258 ∧
      streamLayout.doubleSelect ∉ streamLayout.dialogPool.take 258 ∧
      streamLayout.genericSelect ∉ streamLayout.dialogPool.take 258 := by
    rw [sl_equalNegY, sl_doubleSelect, sl_genericSelect]
    refine ⟨?_, ?_, ?_⟩ <;> intro hm <;>
      (rw [mem_pool_take 258 (by decide)] at hm; dsimp only [Wire, ECDSAAdd.Wire] at *; omega)
  let uS := ECDSAAdd.run (cxList scrShortWires scrShortTargets) List.nil s
  let vS := uS.basis streamLayout.core.equalX &&
    (zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258)).all (fun b => !uS.basis b.input)
  let uP := ECDSAAdd.run (cxList scrPairWires scrPairTargets) List.nil s
  let vP := uP.basis streamLayout.control && (pairPorts streamLayout).all (fun b => !uP.basis b.input)
  let y0 := uP.basis (yLow streamLayout)
  let bA : BasisState := ECDSAAdd.writeBit s.basis streamLayout.core.equalNegY
    (s.basis streamLayout.core.equalNegY ^^ vS)
  let bB : BasisState := ECDSAAdd.writeBit (ECDSAAdd.writeBit s.basis streamLayout.doubleSelect
    (s.basis streamLayout.doubleSelect ^^ (vP && y0)))
    streamLayout.genericSelect (s.basis streamLayout.genericSelect ^^ (vP && !y0))
  have h1 : ECDSAAdd.run shortPart (m₁.take (ECDSAAdd.measurementCount shortPart)) s = ⟨s.phase, bA⟩ :=
    shortPart_run s (m₁.take (ECDSAAdd.measurementCount shortPart)) hz
  have h2 : ECDSAAdd.run pairPart (m₂.take (ECDSAAdd.measurementCount pairPart)) s = ⟨s.phase, bB⟩ :=
    pairPart_run s (m₂.take (ECDSAAdd.measurementCount pairPart)) hz
  rw [ECDSAAdd.run_append, h1, ECDSAAdd.run_append, h2]
  have hzA : Clean (streamLayout.dialogPool.take 258) bA := fun w hw => by
    have hne' : w ≠ streamLayout.core.equalNegY := fun e => heq_pool.1 (e ▸ hw)
    simp [bA, ECDSAAdd.writeBit, Function.update, hne', hz w hw]
  have hzB : Clean (streamLayout.dialogPool.take 258) bB := fun w hw => by
    have hne1 : w ≠ streamLayout.doubleSelect := fun e => heq_pool.2.1 (e ▸ hw)
    have hne2 : w ≠ streamLayout.genericSelect := fun e => heq_pool.2.2 (e ▸ hw)
    simp [bB, ECDSAAdd.writeBit, Function.update, hne1, hne2, hz w hw]
  rw [pairPart_run ⟨s.phase, bA⟩ _ hzA, shortPart_run ⟨s.phase, bB⟩ _ hzB]
  have hcxP_agree : ∀ w, w ≠ streamLayout.core.equalNegY →
      (ECDSAAdd.run (cxList scrPairWires scrPairTargets) List.nil ⟨s.phase, bA⟩).basis w = uP.basis w := by
    intro w hw
    have ha := cxList_run_exact scrPairWires scrPairTargets scrPair_len_eq scrPair_cx_nd ⟨s.phase, bA⟩ List.nil
    have hb := cxList_run_exact scrPairWires scrPairTargets scrPair_len_eq scrPair_cx_nd s List.nil
    by_cases hwt : w ∈ scrPairTargets
    · obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hwt
      rw [ha.2.2 i hi]; dsimp only [uP]; rw [hb.2.2 i hi]
      have hne1 : scrPairWires[i]'(scrPair_len_eq.symm ▸ hi) ≠ streamLayout.core.equalNegY :=
        fun e => scrPairWires_no_flags.2.2.2 (e ▸ List.getElem_mem _)
      simp [bA, ECDSAAdd.writeBit, Function.update, hw, hne1]
    · rw [ha.2.1 w hwt]; dsimp only [uP]; rw [hb.2.1 w hwt]
      simp [bA, ECDSAAdd.writeBit, Function.update, hw]
  have hcxS_agree : ∀ w, w ≠ streamLayout.doubleSelect → w ≠ streamLayout.genericSelect →
      (ECDSAAdd.run (cxList scrShortWires scrShortTargets) List.nil ⟨s.phase, bB⟩).basis w = uS.basis w := by
    intro w hw1 hw2
    have ha := cxList_run_exact scrShortWires scrShortTargets scrShort_len_eq scrShort_cx_nd ⟨s.phase, bB⟩ List.nil
    have hb := cxList_run_exact scrShortWires scrShortTargets scrShort_len_eq scrShort_cx_nd s List.nil
    by_cases hwt : w ∈ scrShortTargets
    · obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hwt
      rw [ha.2.2 i hi]; dsimp only [uS]; rw [hb.2.2 i hi]
      have hne1 : scrShortWires[i]'(scrShort_len_eq.symm ▸ hi) ≠ streamLayout.doubleSelect :=
        fun e => scrShortWires_no_flags.1 (e ▸ List.getElem_mem _)
      have hne2 : scrShortWires[i]'(scrShort_len_eq.symm ▸ hi) ≠ streamLayout.genericSelect :=
        fun e => scrShortWires_no_flags.2.1 (e ▸ List.getElem_mem _)
      simp [bB, ECDSAAdd.writeBit, Function.update, hw1, hw2, hne1, hne2]
    · rw [ha.2.1 w hwt]; dsimp only [uS]; rw [hb.2.1 w hwt]
      simp [bB, ECDSAAdd.writeBit, Function.update, hw1, hw2]
  have hallP : (pairPorts streamLayout).all
      (fun b => !(ECDSAAdd.run (cxList scrPairWires scrPairTargets) List.nil ⟨s.phase, bA⟩).basis b.input) =
      (pairPorts streamLayout).all (fun b => !uP.basis b.input) := by
    apply list_all_congr
    intro b hb
    have hne' : b.input ≠ streamLayout.core.equalNegY := by
      have hi := (zeroPorts_mem_input_work hb).1
      rw [pairSrc_eq, List.mem_cons, List.mem_range'_1] at hi
      rw [sl_equalNegY]
      dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    rw [hcxP_agree b.input hne']
  have hallS : (zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258)).all
      (fun b => !(ECDSAAdd.run (cxList scrShortWires scrShortTargets) List.nil ⟨s.phase, bB⟩).basis b.input) =
      (zeroPorts (shortSrc streamLayout) (streamLayout.dialogPool.take 258)).all (fun b => !uS.basis b.input) := by
    apply list_all_congr
    intro b hb
    have hne' : b.input ≠ streamLayout.doubleSelect ∧ b.input ≠ streamLayout.genericSelect := by
      have hi := (zeroPorts_mem_input_work hb).1
      rw [shortSrc_eq, List.cons_append, List.mem_cons, List.mem_append, List.mem_range'_1, List.mem_singleton] at hi
      rw [sl_doubleSelect, sl_genericSelect]
      dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    rw [hcxS_agree b.input hne'.1 hne'.2]
  have hctlP := hcxP_agree streamLayout.control (by rw [sl_control, sl_equalNegY]; decide)
  have hyP := hcxP_agree (yLow streamLayout) (by rw [sl_yLow, sl_equalNegY]; decide)
  have heqS := hcxS_agree streamLayout.core.equalX (by rw [sl_equalX, sl_doubleSelect]; decide)
    (by rw [sl_equalX, sl_genericSelect]; decide)
  refine ECDSAAdd.State.mk.injEq _ _ _ _ |>.mpr ⟨rfl, ?_⟩
  funext w
  dsimp only
  rw [hallP, hallS, hctlP, hyP, heqS]
  by_cases h1 : w = streamLayout.core.equalNegY
  · subst h1; simp [bA, bB, vS, vP, y0, ECDSAAdd.writeBit, Function.update, hne.1, hne.2.1, Ne.symm hne.1, Ne.symm hne.2.1]
  · by_cases h2 : w = streamLayout.doubleSelect
    · subst h2; simp [bA, bB, vS, vP, y0, ECDSAAdd.writeBit, Function.update, hne.1, hne.2.2, Ne.symm hne.1, Ne.symm hne.2.2]
    · by_cases h3 : w = streamLayout.genericSelect
      · subst h3; simp [bA, bB, vS, vP, y0, ECDSAAdd.writeBit, Function.update, hne.2.1, hne.2.2, Ne.symm hne.2.1, Ne.symm hne.2.2]
      · simp [bA, bB, vS, vP, y0, ECDSAAdd.writeBit, Function.update, h1, h2, h3]

theorem shortPart_avoid_pairExtra : ∀ w ∈ pairExtraWires, w ∉ ECDSAAdd.wires shortPart := by
  intro w hw
  have hS : w ∈ scrAllWires := by
    rcases List.mem_append.mp hw with h | h
    · exact List.mem_append_left _ (List.mem_append_left _ h)
    · exact List.mem_append_right _ h
  have hns : w ∉ scrShortWires := by
    rcases List.mem_append.mp hw with h | h
    · exact fun hm => (List.nodup_append.mp scrWires_nodup).2.2 w h w hm rfl
    · exact fun hm => extra_not_scrWires w h (List.mem_append_right _ hm)
  simp only [shortPart, ECDSAAdd.wires_append, Finset.mem_union, not_or]
  refine ⟨?_, scrAll_not_P2 w hS, ?_⟩
  · intro hm; rcases cxList_wires _ _ _ hm with hm | hm
    · exact hns hm
    · exact scrAll_short_targets w hS hm
  · intro hm; rcases cxList_wires _ _ _ hm with hm | hm
    · exact hns hm
    · exact scrAll_short_targets w hS hm

theorem tailPart_avoid_short : ∀ w ∈ shortWires, w ∉ ECDSAAdd.wires tailPart := by
  intro w hw
  have hS : w ∈ scrAllWires := List.mem_append_left _ (List.mem_append_right _ hw)
  have hnp : w ∉ scrPairWires := fun hm => (List.nodup_append.mp scrWires_nodup).2.2 w hm w hw rfl
  have hpair : w ∉ ECDSAAdd.wires pairPart := by
    simp only [pairPart, ECDSAAdd.wires_append, Finset.mem_union, not_or]
    refine ⟨?_, scrAll_not_P1 w hS, ?_, ?_⟩
    · intro hm; rcases cxList_wires _ _ _ hm with hm | hm
      · exact hnp hm
      · exact scrAll_pair_targets w hS hm
    · intro hm; rcases cxList_wires _ _ _ hm with hm | hm
      · exact hnp hm
      · exact scrAll_pair_targets w hS hm
    · intro hm
      simp only [ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.union_empty, Finset.mem_singleton] at hm
      have hb := shortWires_bounds w hw
      rw [hm, sl_yLow] at hb; dsimp only [Wire, ECDSAAdd.Wire] at *; omega
  have hp1 : w ∉ ECDSAAdd.wires pair1Prog := by
    intro hm
    have hsub := List.mem_toFinset.mp (pair1Prog_subset hm)
    have hsw := shortWires_bounds w hw
    simp only [pair1List, xAdd, yAdd, negXW, MeasuredCanonicalModLayout.wires,
      CompactRecoveryNegateLayout.wires, cxWord, cyWord, addCarry,
      streamLayout_point, sl_control, List.mem_append, List.mem_cons, List.mem_range'_1,
      List.not_mem_nil, or_false] at hsub
    dsimp only [Wire, ECDSAAdd.Wire] at *
    omega
  simp only [tailPart, ECDSAAdd.wires_append, Finset.mem_union, not_or]
  exact ⟨hpair, scrAll_avoid_gf w hS, scrAll_avoid_zrep w hS, hp1⟩

theorem site1Arith_eq : site1Arith = pairPart ++ (shortPart ++
    (pointDialogGenericFlag streamLayout ++ (ECDSAAdd.Frontier.zrep streamLayout ++ pair1Prog))) := by
  simp only [site1Arith, scrInArith_eq, pairPart, shortPart, List.append_assoc]

theorem shortPart_wires_sub : ECDSAAdd.wires shortPart ⊆ ECDSAAdd.wires site1Arith := by
  rw [site1Arith_eq]
  intro w hw
  simp [ECDSAAdd.wires_append, hw]

theorem tailPart_wires_sub : ECDSAAdd.wires tailPart ⊆ ECDSAAdd.wires site1Arith := by
  rw [site1Arith_eq, tailPart]
  intro w hw
  simp only [ECDSAAdd.wires_append, Finset.mem_union] at hw ⊢
  tauto

theorem shortPart_root : windowRoot ∉ ECDSAAdd.wires shortPart :=
  fun hm => site1Arith_window windowRoot List.mem_cons_self (shortPart_wires_sub hm)

theorem tailPart_root : windowRoot ∉ ECDSAAdd.wires tailPart :=
  fun hm => site1Arith_window windowRoot List.mem_cons_self (tailPart_wires_sub hm)

theorem site1_counts_split :
    ECDSAAdd.toffoliCount shortPart + ECDSAAdd.toffoliCount tailPart = ECDSAAdd.toffoliCount site1Arith ∧
    ECDSAAdd.measurementCount shortPart + ECDSAAdd.measurementCount tailPart = ECDSAAdd.measurementCount site1Arith ∧
    ECDSAAdd.Challenge.gateSlots shortPart + ECDSAAdd.Challenge.gateSlots tailPart = ECDSAAdd.Challenge.gateSlots site1Arith := by
  rw [site1Arith_eq, tailPart]
  simp only [ECDSAAdd.toffoliCount_append, ECDSAAdd.measurementCount_append,
    ECDSAAdd.Challenge.gateSlots_append]
  omega

theorem site1Arith_physical : GatePhysical site1Arith := by
  apply WEXUnlookup.rowC_physical site1Arith
  have h1 : WEXUnlookup.rowC = WEXUnlookup.rowHead.map toBlock2 ++ WEXUnlookup.rowPost3 := by
    unfold WEXUnlookup.rowC; rfl
  have h2 : WEXUnlookup.rowHead = WEXUnlookup.rowPre3 ++ WEXUnlookup.generic3 probeRows := by
    unfold WEXUnlookup.rowHead; rfl
  rw [h1, h2, List.map_append, erase2_append, erase2_append]
  apply List.mem_append_left
  apply List.mem_append_left
  rw [WEXUnlookup.rowPre3]
  simp only [List.map_cons, List.map_nil, erase2_cons, erase2_nil, List.append_nil, toBlock2,
    Block2.code, UnitSite.code, site1, MaskedSite.prefix]
  exact List.mem_append_right _ (List.mem_append_right _ (List.mem_cons_of_mem _ List.mem_cons_self))

theorem shortPart_physical : GatePhysical shortPart := by
  have h := site1Arith_physical
  rw [site1Arith_eq] at h
  intro i hi
  exact h i (List.mem_append_right _ (List.mem_append_left _ hi))

theorem tailPart_physical : GatePhysical tailPart := by
  have h := site1Arith_physical
  rw [site1Arith_eq] at h
  intro i hi
  rcases List.mem_append.mp hi with hi | hi
  · exact h i (List.mem_append_left _ hi)
  · exact h i (List.mem_append_right _ (List.mem_append_right _ hi))

theorem cBits_commute (c : Wire) (A B : List Wire) (kA kB : List Bool)
    (hcA : c ∉ A) (hcB : c ∉ B) (hAB : ∀ a ∈ A, a ∉ B) (s : ECDSAAdd.State) :
    ECDSAAdd.run (cBits c A kA) List.nil (ECDSAAdd.run (cBits c B kB) List.nil s) =
      ECDSAAdd.run (cBits c B kB) List.nil (ECDSAAdd.run (cBits c A kA) List.nil s) := by
  rw [cBits_run _ _ _ _ _ hcB, cBits_run _ _ _ _ _ hcA, cBits_run _ _ _ _ _ hcA, cBits_run _ _ _ _ _ hcB]
  simp only [xMask_outside B kB c hcB, xMask_outside A kA c hcA, Bool.and_false, Bool.xor_false]
  cases s with
  | mk ph b =>
    refine ECDSAAdd.State.mk.injEq _ _ _ _ |>.mpr ⟨rfl, ?_⟩
    funext w
    dsimp only
    cases b w <;> cases b c <;> cases xMask A kA w <;> cases xMask B kB w <;> rfl

theorem portMask_append {n : Nat} (read : ConstantBit n → Bool) (ps₁ ps₂ : List (LookupPort n)) (a : Nat) :
    portMask read (ps₁ ++ ps₂) a = portMask read ps₁ a ++ portMask read ps₂ a := by
  induction ps₁ with
  | nil => rfl
  | cons p ps ih =>
    simp only [List.cons_append, portMask, portTargets, List.map_cons, tableBitsMask] at ih ⊢
    by_cases h : decide (read (p.ref a) = p.value) = true
    · simp only [h, ↓reduceIte, List.cons_append, ih]
    · simp only [h, Bool.false_eq_true, ↓reduceIte, ih]

theorem xMask_get : ∀ (T : List Wire) (k : List Bool), T.Nodup → (hl : T.length = k.length) →
    ∀ (i : Nat) (hi : i < T.length), xMask T k (T[i]'hi) = k[i]'(hl ▸ hi)
  | [], [], _, _, _, hi => by simp at hi
  | [], _ :: _, _, hl, _, _ => by simp at hl
  | _ :: _, [], _, hl, _, _ => by simp at hl
  | t :: ts, b :: bs, hnd, hl, 0, _ => by
    have ⟨ht, _⟩ := List.nodup_cons.mp hnd
    simp [xMask, xMask_outside ts bs t ht]
  | t :: ts, b :: bs, hnd, hl, i + 1, hi => by
    have ⟨ht, hnd'⟩ := List.nodup_cons.mp hnd
    have hl' : ts.length = bs.length := by simpa using hl
    have hi' : i < ts.length := Nat.lt_of_succ_lt_succ hi
    have hne : ts[i]'hi' ≠ t := fun e => ht (e ▸ List.getElem_mem hi')
    simp only [List.getElem_cons_succ, xMask, hne, decide_false, Bool.false_and, Bool.false_xor]
    exact xMask_get ts bs hnd' hl' i hi'

theorem short_not_pairExtra : ∀ w ∈ shortWires, w ∉ pairExtraWires := by
  intro w hw hm
  rcases List.mem_append.mp hm with h | h
  · exact (List.nodup_append.mp scrWires_nodup).2.2 w h w hw rfl
  · exact extra_not_scrWires w h (List.mem_append_right _ hw)

theorem windowRoot_not_short : windowRoot ∉ shortWires :=
  fun h => windowRoot_not_scr (List.mem_append_right _ h)

theorem windowRoot_not_pairExtra : windowRoot ∉ pairExtraWires := by
  intro h
  rcases List.mem_append.mp h with h | h
  · exact windowRoot_not_scr (List.mem_append_left _ h)
  · have := extra_bounds windowRoot h; dsimp only [Wire, ECDSAAdd.Wire, windowRoot] at *; omega

/-- Loading all of `sitePorts` is identical to loading `shortPorts` followed by `pairExtraPorts`. -/
theorem siteLoad_eq_two {n : Nat} (read : ConstantBit n → Bool) (r : Nat → Fin n)
    (a : Nat) (s : ECDSAAdd.State) :
    let sp := WideSigned.Rows.ports r (shortPorts probeRows)
    let pp := WideSigned.Rows.ports r (pairExtraPorts probeRows)
    let allp := WideSigned.Rows.ports r (sitePorts probeRows)
    tableXorState (portMask read allp a) (s.basis windowRoot) s.basis =
      tableXorState (portMask read pp a) (s.basis windowRoot)
        (tableXorState (portMask read sp a) (s.basis windowRoot) s.basis) := by
  intro sp pp allp
  let p1 := WideSigned.Rows.ports r (retarget (scrPairBits probeRows (wBit probeRows .y)) scrPairWires)
  let p3 := WideSigned.Rows.ports r (negYExtraPorts probeRows)
  have hall : portMask read allp a = portMask read p1 a ++ portMask read sp a ++ portMask read p3 a := by
    simp only [allp, sp, p1, p3, sitePorts, scrInPorts, shortPorts, WideSigned.Rows.ports,
      List.map_append, portMask_append, List.append_assoc]
  have hpp : portMask read pp a = portMask read p1 a ++ portMask read p3 a := by
    simp only [pp, p1, p3, pairExtraPorts, WideSigned.Rows.ports, List.map_append, portMask_append]
  have hdisj_sp_p3 : ∀ w, w ∈ portMask read sp a → w ∉ portMask read p3 a := fun w h1 h2 => by
    have ha : w ∈ scrShortWires := by
      have := tableBitsMask_subset _ _ h1
      simpa [sp, WideSigned.Rows.targets, shortPorts_targets, shortWires] using this
    have hb : w ∈ scrDExtraWires := by
      have := tableBitsMask_subset _ _ h2
      simpa [p3, WideSigned.Rows.targets, negYExtra_targets] using this
    exact extra_not_scrWires w hb (List.mem_append_right _ ha)
  funext w
  simp only [tableXorState, hall, hpp, List.mem_append]
  by_cases h1 : w ∈ portMask read p1 a
  · have h2 : w ∉ portMask read sp a := fun hm => by
      have ha : w ∈ scrPairWires := by
        have := tableBitsMask_subset _ _ h1
        simpa [p1, WideSigned.Rows.targets,
          retarget_targets _ _ ((scrPairBits_length probeRows _).trans scrPairWires_length.symm)] using this
      have hb : w ∈ scrShortWires := by
        have := tableBitsMask_subset _ _ hm
        simpa [sp, WideSigned.Rows.targets, shortPorts_targets, shortWires] using this
      exact (List.nodup_append.mp scrWires_nodup).2.2 w ha w hb rfl
    simp [h1, h2]
  · by_cases h2 : w ∈ portMask read sp a
    · have h3 := hdisj_sp_p3 w h2
      simp [h1, h2, h3]
    · simp [h1, h2]

theorem twoPass_abstract (Lsp Lpp pairP shortP restP : ECDSAAdd.Program)
    (s : ECDSAAdd.State) (mA mB : List Bool)
    (hmA : mA.length = ECDSAAdd.measurementCount shortP)
    (hmB : mB.length = ECDSAAdd.measurementCount (pairP ++ restP))
    (hcomm_ps : ∀ t m₁ m₂, Clean (streamLayout.dialogPool.take 258) t.basis →
      ECDSAAdd.run (shortP ++ pairP) m₁ t = ECDSAAdd.run (pairP ++ shortP) m₂ t)
    (hclean : Clean (streamLayout.dialogPool.take 258) (ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil s)).basis)
    (hcomm_Lpp_short : ∀ k t, ECDSAAdd.run shortP k (ECDSAAdd.run Lpp List.nil t) = ECDSAAdd.run Lpp List.nil (ECDSAAdd.run shortP k t))
    (hcomm_Lsp_tail : ∀ k t, ECDSAAdd.run (pairP ++ restP) k (ECDSAAdd.run Lsp List.nil t) = ECDSAAdd.run Lsp List.nil (ECDSAAdd.run (pairP ++ restP) k t))
    (hcomm_Lpp_Lsp : ∀ t, ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil t) = ECDSAAdd.run Lsp List.nil (ECDSAAdd.run Lpp List.nil t)) :
    let mPerm := mB.take (ECDSAAdd.measurementCount pairP) ++ mA ++ mB.drop (ECDSAAdd.measurementCount pairP)
    ECDSAAdd.run Lpp List.nil (ECDSAAdd.run (pairP ++ restP) mB (ECDSAAdd.run Lpp List.nil
      (ECDSAAdd.run Lsp List.nil (ECDSAAdd.run shortP mA (ECDSAAdd.run Lsp List.nil s))))) =
    ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil
      (ECDSAAdd.run ((pairP ++ shortP) ++ restP) mPerm (ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil s)))) := by
  intro mPerm
  have hp_le : ECDSAAdd.measurementCount pairP ≤ mB.length := by
    rw [hmB, ECDSAAdd.measurementCount_append]; omega
  have hmc_ps : ECDSAAdd.measurementCount (pairP ++ shortP) =
      ECDSAAdd.measurementCount pairP + ECDSAAdd.measurementCount shortP :=
    ECDSAAdd.measurementCount_append _ _
  have htake_ps : mPerm.take (ECDSAAdd.measurementCount (pairP ++ shortP)) =
      mB.take (ECDSAAdd.measurementCount pairP) ++ mA := by
    rw [hmc_ps, show mPerm = (mB.take (ECDSAAdd.measurementCount pairP) ++ mA) ++
      mB.drop (ECDSAAdd.measurementCount pairP) from rfl, List.take_left' (by
      rw [List.length_append, List.length_take, Nat.min_eq_left hp_le, hmA])]
  have hdrop_ps : mPerm.drop (ECDSAAdd.measurementCount (pairP ++ shortP)) =
      mB.drop (ECDSAAdd.measurementCount pairP) := by
    rw [hmc_ps, show mPerm = (mB.take (ECDSAAdd.measurementCount pairP) ++ mA) ++
      mB.drop (ECDSAAdd.measurementCount pairP) from rfl, List.drop_left' (by
      rw [List.length_append, List.length_take, Nat.min_eq_left hp_le, hmA])]
  rw [ECDSAAdd.run_append (pairP ++ shortP) restP, htake_ps, hdrop_ps,
    ← hcomm_ps _ (mA ++ mB.take (ECDSAAdd.measurementCount pairP)) _ hclean,
    ECDSAAdd.run_append shortP pairP, ← hmA, List.take_left, List.drop_left]
  have hre : ECDSAAdd.run restP (mB.drop (ECDSAAdd.measurementCount pairP))
      (ECDSAAdd.run pairP (mB.take (ECDSAAdd.measurementCount pairP))
        (ECDSAAdd.run shortP mA (ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil s)))) =
      ECDSAAdd.run (pairP ++ restP) mB (ECDSAAdd.run shortP mA (ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil s))) := by
    rw [ECDSAAdd.run_append pairP restP]
  rw [hre, hcomm_Lpp_short, hcomm_Lpp_Lsp, hcomm_Lsp_tail, hcomm_Lpp_Lsp]

/-- Key two-pass equivalence on `ECDSAAdd.run`: running Pass A (`shortPorts` + `shortPart`)
    then Pass B (`pairExtraPorts` + `tailPart`) computes the exact same state as `site1`
    with permuted measurement list `mB_pair ++ mA ++ mB_pair1`. -/
theorem site1_twoPass_run {n : Nat} (read : ConstantBit n → Bool) (r : Nat → Fin n)
    (a : Nat) (s : ECDSAAdd.State) (mA mB : List Bool)
    (hmA : mA.length = ECDSAAdd.measurementCount shortPart)
    (hmB : mB.length = ECDSAAdd.measurementCount tailPart)
    (hroot : s.basis windowRoot = true)
    (hclean : Clean (streamLayout.dialogPool.take 258) s.basis) :
    let sp := WideSigned.Rows.ports r (shortPorts probeRows)
    let pp := WideSigned.Rows.ports r (pairExtraPorts probeRows)
    let sL1 : ECDSAAdd.State := ⟨s.phase, tableXorState (portMask read sp a) true s.basis⟩
    let sA1 := ECDSAAdd.run shortPart mA sL1
    let sMid : ECDSAAdd.State := ⟨sA1.phase, tableXorState (portMask read sp a) true sA1.basis⟩
    let sL2 : ECDSAAdd.State := ⟨sMid.phase, tableXorState (portMask read pp a) true sMid.basis⟩
    let sB1 := ECDSAAdd.run tailPart mB sL2
    let sOut : ECDSAAdd.State := ⟨sB1.phase, tableXorState (portMask read pp a) true sB1.basis⟩
    let mPerm := mB.take (ECDSAAdd.measurementCount pairPart) ++ mA ++ mB.drop (ECDSAAdd.measurementCount pairPart)
    mPerm.length = ECDSAAdd.measurementCount site1Arith ∧
    sOut = ECDSAAdd.run ((specialize (WideSigned.Rows.site r (site1 probeRows)).code a).instantiate read) mPerm s := by
  intro sp pp sL1 sA1 sMid sL2 sB1 sOut mPerm
  let allp := WideSigned.Rows.ports r (sitePorts probeRows)
  have hmc_len : mPerm.length = ECDSAAdd.measurementCount site1Arith := by
    have hcs := site1_counts_split.2.1
    have htail_mc : ECDSAAdd.measurementCount pairPart ≤ ECDSAAdd.measurementCount tailPart := by
      rw [tailPart, ECDSAAdd.measurementCount_append]; omega
    simp only [mPerm, List.length_append, List.length_take, List.length_drop]
    omega
  refine ⟨hmc_len, ?_⟩
  have hsp_t : portTargets sp = shortWires := by
    simpa [sp, WideSigned.Rows.targets] using shortPorts_targets probeRows
  have hpp_t : portTargets pp = pairExtraWires := by
    simpa [pp, WideSigned.Rows.targets] using pairExtraPorts_targets probeRows
  have hall_t : portTargets allp = scrAllWires := by
    simpa [allp, WideSigned.Rows.targets] using sitePorts_targets probeRows
  have hsp_nd : (portTargets sp).Nodup := by rw [hsp_t]; exact scrShortWires_nd
  have hpp_nd : (portTargets pp).Nodup := by
    rw [hpp_t, pairExtraWires, List.nodup_append]
    refine ⟨scrPairWires_nd, ?_, fun x hx y hy hxy => ?_⟩
    · have := (List.nodup_append.mp WEX.scrAllWires_nodup).2.1
      simpa [scrAllWires] using this
    · subst hxy
      exact extra_not_scrWires x hy (List.mem_append_left _ hx)
  have hall_nd : (portTargets allp).Nodup := by rw [hall_t]; exact WEX.scrAllWires_nodup
  have hroot_all : windowRoot ∉ portTargets allp := by
    rw [hall_t]; intro h; rcases List.mem_append.mp h with h | h
    · exact windowRoot_not_scr h
    · have := extra_bounds windowRoot h; dsimp only [Wire, ECDSAAdd.Wire, windowRoot] at *; omega
  have hrhs_inst : (specialize (WideSigned.Rows.site r (site1 probeRows)).code a).instantiate read =
      (portTemplate (some windowRoot) allp a).instantiate read ++
        (site1Arith ++ (portTemplate (some windowRoot) allp a).instantiate read) := by
    simp only [WideSigned.Rows.site, site1, MaskedSite.code, MaskedSite.prefix, specialize,
      List.flatMap_append, List.flatMap_cons, List.flatMap_nil, WInstr.specialize,
      Tmpl.instantiate_append, specialize_literal, Tmpl.instantiate_lit, List.append_nil,
      List.append_assoc, WideSigned.Rows.code, WideSigned.Rows.instr, wLiteral, List.map_cons,
      List.map_nil]
    rfl
  rw [hrhs_inst]
  have hpt_all (t : ECDSAAdd.State) (hr : t.basis windowRoot = true) :
      ECDSAAdd.run ((portTemplate (some windowRoot) allp a).instantiate read) List.nil t =
        ⟨t.phase, tableXorState (portMask read allp a) true t.basis⟩ := by
    simpa [lookupRoot, hr] using portTemplate_run read (some windowRoot) allp a windowRoot List.nil t hall_nd hroot_all hr
  have hpt_all_mc : ECDSAAdd.measurementCount ((portTemplate (some windowRoot) allp a).instantiate read) = 0 :=
    (portTemplate_counts read (some windowRoot) allp a).2
  rw [run_zero_append _ _ hpt_all_mc, hpt_all s hroot, run_meas_append site1Arith,
    run_zero_records _ hpt_all_mc]
  have hxor_cBits (ps : List (LookupPort n)) (hnd : (portTargets ps).Nodup) (hrp : windowRoot ∉ portTargets ps)
      (t : ECDSAAdd.State) (hr : t.basis windowRoot = true) :
      (⟨t.phase, tableXorState (portMask read ps a) true t.basis⟩ : ECDSAAdd.State) =
        ECDSAAdd.run (cBits windowRoot (portTargets ps) (portBits read ps a)) List.nil t := by
    rw [cBits_run windowRoot _ _ List.nil t hrp]
    refine ECDSAAdd.State.mk.injEq _ _ _ _ |>.mpr ⟨rfl, ?_⟩
    funext w
    simp only [hr, Bool.true_and, tableXorState]
    by_cases hw : w ∈ portTargets ps
    · obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hw
      have hi' : i < ps.length := by simpa [portTargets] using hi
      have hp : ps[i]'hi' ∈ ps := List.getElem_mem hi'
      have hmask : (portTargets ps)[i]'hi ∈ portMask read ps a ↔
          decide (read ((ps[i]'hi').ref a) = (ps[i]'hi').value) = true := by
        have hps := port_selected read ps a hnd (ps[i]'hi') hp
        simpa [portTargets, List.getElem_map] using hps
      have hxmask : xMask (portTargets ps) (portBits read ps a) ((portTargets ps)[i]'hi) =
          decide (read ((ps[i]'hi').ref a) = (ps[i]'hi').value) := by
        have hlen : (portTargets ps).length = (portBits read ps a).length := by simp [portTargets, portBits]
        have hx := xMask_get (portTargets ps) (portBits read ps a) hnd hlen i hi
        simpa [portBits, List.getElem_map] using hx
      rw [hxmask]
      by_cases hb : decide (read ((ps[i]'hi').ref a) = (ps[i]'hi').value) = true
      · simp [hb, hmask.mpr hb]
      · have hbf : decide (read ((ps[i]'hi').ref a) = (ps[i]'hi').value) = false := Bool.eq_false_iff.mpr hb
        have hnm : (portTargets ps)[i]'hi ∉ portMask read ps a := fun hm => hb (hmask.mp hm)
        simp [hbf, hnm]
    · have hnm : w ∉ portMask read ps a := fun hm => hw (tableBitsMask_subset _ _ hm)
      rw [xMask_outside _ _ w hw]
      simp [hnm]
  have hroot_sp : windowRoot ∉ portTargets sp := by rw [hsp_t]; exact windowRoot_not_short
  have hroot_pp : windowRoot ∉ portTargets pp := by rw [hpp_t]; exact windowRoot_not_pairExtra
  set Lsp := cBits windowRoot (portTargets sp) (portBits read sp a)
  set Lpp := cBits windowRoot (portTargets pp) (portBits read pp a)
  have hroot_Lsp (t : ECDSAAdd.State) (hr : t.basis windowRoot = true) :
      (ECDSAAdd.run Lsp List.nil t).basis windowRoot = true := by
    rw [cBits_run _ _ _ _ _ hroot_sp]; dsimp only
    rw [xMask_outside _ _ windowRoot hroot_sp]; simpa using hr
  have hroot_Lpp (t : ECDSAAdd.State) (hr : t.basis windowRoot = true) :
      (ECDSAAdd.run Lpp List.nil t).basis windowRoot = true := by
    rw [cBits_run _ _ _ _ _ hroot_pp]; dsimp only
    rw [xMask_outside _ _ windowRoot hroot_pp]; simpa using hr
  have hroot_short (t : ECDSAAdd.State) (k : List Bool) (hr : t.basis windowRoot = true) :
      (ECDSAAdd.run shortPart k t).basis windowRoot = true := by
    rw [run_outside_basis shortPart k t windowRoot shortPart_root]; exact hr
  have hroot_tail (t : ECDSAAdd.State) (k : List Bool) (hr : t.basis windowRoot = true) :
      (ECDSAAdd.run tailPart k t).basis windowRoot = true := by
    rw [run_outside_basis tailPart k t windowRoot tailPart_root]; exact hr
  have h1 : sL1 = ECDSAAdd.run Lsp List.nil s := hxor_cBits sp hsp_nd hroot_sp s hroot
  have hr1 : sL1.basis windowRoot = true := h1 ▸ hroot_Lsp s hroot
  have h2 : sA1 = ECDSAAdd.run shortPart mA (ECDSAAdd.run Lsp List.nil s) := congrArg (ECDSAAdd.run shortPart mA) h1
  have hr2 : sA1.basis windowRoot = true := hroot_short sL1 mA hr1
  have h3 : sMid = ECDSAAdd.run Lsp List.nil (ECDSAAdd.run shortPart mA (ECDSAAdd.run Lsp List.nil s)) :=
    (hxor_cBits sp hsp_nd hroot_sp sA1 hr2).trans (congrArg (ECDSAAdd.run Lsp List.nil) h2)
  have hr3 : sMid.basis windowRoot = true := h3 ▸ hroot_Lsp _ (hroot_short _ mA (hroot_Lsp s hroot))
  have h4 : sL2 = ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil (ECDSAAdd.run shortPart mA (ECDSAAdd.run Lsp List.nil s))) :=
    (hxor_cBits pp hpp_nd hroot_pp sMid hr3).trans (congrArg (ECDSAAdd.run Lpp List.nil) h3)
  have hr4 : sL2.basis windowRoot = true := h4 ▸ hroot_Lpp _ (hroot_Lsp _ (hroot_short _ mA (hroot_Lsp s hroot)))
  have h5 : sB1 = ECDSAAdd.run tailPart mB (ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil (ECDSAAdd.run shortPart mA (ECDSAAdd.run Lsp List.nil s)))) :=
    congrArg (ECDSAAdd.run tailPart mB) h4
  have hr5 : sB1.basis windowRoot = true := hroot_tail sL2 mB hr4
  have hsOut_eq : sOut = ECDSAAdd.run Lpp List.nil (ECDSAAdd.run tailPart mB (ECDSAAdd.run Lpp List.nil
      (ECDSAAdd.run Lsp List.nil (ECDSAAdd.run shortPart mA (ECDSAAdd.run Lsp List.nil s))))) :=
    (hxor_cBits pp hpp_nd hroot_pp sB1 hr5).trans (congrArg (ECDSAAdd.run Lpp List.nil) h5)
  have hall_eq (t : ECDSAAdd.State) (hr : t.basis windowRoot = true) :
      (⟨t.phase, tableXorState (portMask read allp a) true t.basis⟩ : ECDSAAdd.State) =
        ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil t) := by
    have h1' := siteLoad_eq_two read r a t
    rw [hr] at h1'
    rw [← hxor_cBits pp hpp_nd hroot_pp _ (hroot_Lsp t hr), ← hxor_cBits sp hsp_nd hroot_sp t hr]
    exact ECDSAAdd.State.mk.injEq _ _ _ _ |>.mpr ⟨rfl, h1'⟩
  have hroot_site : (ECDSAAdd.run site1Arith mPerm
      ⟨s.phase, tableXorState (portMask read allp a) true s.basis⟩).basis windowRoot = true := by
    have hroot_sAll : (⟨s.phase, tableXorState (portMask read allp a) true s.basis⟩ : ECDSAAdd.State).basis windowRoot = true := by
      rw [hall_eq s hroot]; exact hroot_Lpp _ (hroot_Lsp s hroot)
    rw [run_outside_basis site1Arith mPerm _ windowRoot (site1Arith_window windowRoot List.mem_cons_self)]
    exact hroot_sAll
  rw [hpt_all _ hroot_site, hall_eq _ hroot_site, hall_eq s hroot, hsOut_eq]
  let rest := pointDialogGenericFlag streamLayout ++ (ECDSAAdd.Frontier.zrep streamLayout ++ pair1Prog)
  have hsite1_split : site1Arith = (pairPart ++ shortPart) ++ rest := by
    rw [site1Arith_eq]; simp [rest, List.append_assoc]
  have htail_split : tailPart = pairPart ++ rest := rfl
  have hclean_all : Clean (streamLayout.dialogPool.take 258)
      (ECDSAAdd.run Lpp List.nil (ECDSAAdd.run Lsp List.nil s)).basis := by
    have hpool_sp : ∀ w ∈ streamLayout.dialogPool.take 258, w ∉ portTargets sp := by
      intro w hw hm
      rw [mem_pool_take 258 (by decide)] at hw
      rw [hsp_t] at hm
      have := shortWires_bounds w hm
      dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    have hpool_pp : ∀ w ∈ streamLayout.dialogPool.take 258, w ∉ portTargets pp := by
      intro w hw hm
      rw [mem_pool_take 258 (by decide)] at hw
      rw [hpp_t, pairExtraWires, List.mem_append] at hm
      rcases hm with hm | hm
      · have := pairWires_bounds w hm; dsimp only [Wire, ECDSAAdd.Wire] at *; omega
      · have := extra_bounds w hm; dsimp only [Wire, ECDSAAdd.Wire] at *; omega
    intro w hw
    rw [cBits_run _ _ _ _ _ hroot_pp]; dsimp only
    rw [xMask_outside _ _ w (hpool_pp w hw), cBits_run _ _ _ _ _ hroot_sp]; dsimp only
    rw [xMask_outside _ _ w (hpool_sp w hw)]
    simpa using hclean w hw
  rw [hsite1_split, htail_split]
  exact twoPass_abstract Lsp Lpp pairPart shortPart rest s mA mB hmA hmB
    (fun t m₁ m₂ hc => shortPart_pairPart_comm t m₁ m₂ hc) hclean_all
    (fun k t => load_commute windowRoot (portTargets pp) (portBits read pp a) shortPart
      shortPart_root (by rw [hpp_t]; exact shortPart_avoid_pairExtra) k t)
    (fun k t => load_commute windowRoot (portTargets sp) (portBits read sp a) tailPart
      tailPart_root (by rw [hsp_t]; exact tailPart_avoid_short) k t)
    (fun t => cBits_commute windowRoot (portTargets pp) (portTargets sp) _ _ hroot_pp hroot_sp
      (by rw [hpp_t, hsp_t]; exact fun w hw hm => short_not_pairExtra w hm hw) t)

/-! ### Part 2: Bank-generic SelectSwap load + swap gadgets (2-bit and 1-bit) -/

/-- A bank-generic 2-bit SelectSwap load + swap gadget (4 registers: targets + `g1, g2, g3`). -/
structure SS2 (n : Nat) where
  bits : List Wire
  paths : List Wire
  selBits : List Wire
  selPaths : List Wire
  guard : Wire
  ports : List (LookupPort n)
  g1 : List Wire
  g2 : List Wire
  g3 : List Wire

namespace SS2
variable {n : Nat} (f : SS2 n)

def garb : List Wire := f.g1 ++ f.g2 ++ f.g3

def rowOf1 (a : Nat) : Nat := 4 * (a / 4) + (1 - a % 2)
def rowOf2 (a : Nat) : Nat := 4 * (a / 4) + 2 * (1 - a / 2 % 2) + a % 2
def rowOf3 (a : Nat) : Nat := 4 * (a / 4) + 3 - a % 2

def selPorts : List (LookupPort n) :=
  f.ports.map (fun p => ⟨fun h => p.ref (4 * h), p.value, p.target⟩) ++
  WideBank8.Fast16.regPorts (fun h => 4 * h + 1) f.ports f.g1 ++
  WideBank8.Fast16.regPorts (fun h => 4 * h + 2) f.ports f.g2 ++
  WideBank8.Fast16.regPorts (fun h => 4 * h + 3) f.ports f.g3

def garbPorts : List (LookupPort n) :=
  WideBank8.Fast16.regPorts rowOf1 f.ports f.g1 ++
  WideBank8.Fast16.regPorts rowOf2 f.ports f.g2 ++
  WideBank8.Fast16.regPorts rowOf3 f.ports f.g3

def swapNet : ECDSAAdd.Program :=
  WideBank8.Fast16.swapLayer 855 (portTargets f.ports) f.g1 ++
  WideBank8.Fast16.swapLayer 855 f.g2 f.g3 ++
  WideBank8.Fast16.swapLayer 856 (portTargets f.ports) f.g2

def selCode : WCode n := [.lookup (some f.guard) f.selPorts]

def loadProg (start : Nat) : Straight n start (start + codeRecords f.selBits f.selPaths windowRoot f.selCode) :=
  castFinish (by omega)
    ((compile f.selBits f.selPaths windowRoot f.selCode start).append
      (literalFixed f.swapNet 0 ((literal_meas (n := n) _).trans (by
        simp [swapNet, ECDSAAdd.measurementCount_append, WideBank8.Fast16.swapLayer_meas]))
        (start + codeRecords f.selBits f.selPaths windowRoot f.selCode)))

def loadSource (read : ConstantBit n → Bool) : AdaptiveCircuit :=
  (source read f.selBits f.selPaths windowRoot f.selCode).seq (literalSource f.swapNet)

structure Geo : Prop where
  bitsEq : f.bits = 855 :: 856 :: f.selBits
  pathsSub : ∀ w ∈ f.selPaths, w ∈ f.paths
  selLen : f.selPaths.length = f.selBits.length
  selNodup : (f.guard :: f.selBits ++ f.selPaths).Nodup
  selDisj : List.Disjoint (windowRoot :: f.guard :: f.selBits ++ f.selPaths) (portTargets f.ports ++ f.garb)
  len1 : f.g1.length = f.ports.length
  len2 : f.g2.length = f.ports.length
  len3 : f.g3.length = f.ports.length
  nodup : (portTargets f.ports ++ f.garb).Nodup
  n855 : (855 : Wire) ∉ portTargets f.ports ++ f.garb
  n856 : (856 : Wire) ∉ portTargets f.ports ++ f.garb

theorem selPorts_targets (hg : f.Geo) : portTargets f.selPorts = portTargets f.ports ++ f.garb := by
  have h1 : portTargets (WideBank8.Fast16.regPorts (fun h => 4 * h + 1) f.ports f.g1) = f.g1 :=
    WideBank8.Fast16.regPorts_targets _ _ _ hg.len1
  have h2 : portTargets (WideBank8.Fast16.regPorts (fun h => 4 * h + 2) f.ports f.g2) = f.g2 :=
    WideBank8.Fast16.regPorts_targets _ _ _ hg.len2
  have h3 : portTargets (WideBank8.Fast16.regPorts (fun h => 4 * h + 3) f.ports f.g3) = f.g3 :=
    WideBank8.Fast16.regPorts_targets _ _ _ hg.len3
  simp only [selPorts, WideBank8.Fast16.FastSite.portTargets_append, h1, h2, h3, garb, List.append_assoc]
  congr 1
  simp [portTargets, List.map_map, Function.comp_def]

theorem garbPorts_targets (hg : f.Geo) : portTargets f.garbPorts = f.garb := by
  have h1 := WideBank8.Fast16.regPorts_targets rowOf1 f.ports f.g1 hg.len1
  have h2 := WideBank8.Fast16.regPorts_targets rowOf2 f.ports f.g2 hg.len2
  have h3 := WideBank8.Fast16.regPorts_targets rowOf3 f.ports f.g3 hg.len3
  simp only [garbPorts, WideBank8.Fast16.FastSite.portTargets_append, h1, h2, h3, garb]

theorem garbPorts_length (hg : f.Geo) : f.garbPorts.length = 3 * f.ports.length := by
  have h := congrArg List.length (garbPorts_targets f hg)
  simp only [portTargets, List.length_map, garb, List.length_append, hg.len1, hg.len2, hg.len3] at h
  omega

theorem selPorts_length (hg : f.Geo) : f.selPorts.length = 4 * f.ports.length := by
  have h := congrArg List.length (selPorts_targets f hg)
  simp only [portTargets, List.length_map, List.length_append, garb, hg.len1, hg.len2, hg.len3] at h
  omega

theorem sel_placed (hg : f.Geo) : Placed f.selBits f.selPaths windowRoot (.lookup (some f.guard) f.selPorts) := by
  refine ⟨by simpa [lookupRoot] using hg.selNodup, by rw [selPorts_targets f hg]; exact hg.nodup,
    by rw [selPorts_targets f hg]; simpa [lookupRoot] using hg.selDisj⟩

theorem sel_layouts (hg : f.Geo) : LookupLayouts f.selBits f.selPaths windowRoot f.selCode := by
  refine ⟨hg.selLen.ge, fun c ps hm => ?_⟩
  simp only [selCode, List.mem_singleton, WInstr.lookup.injEq] at hm
  obtain ⟨rfl, rfl⟩ := hm
  simpa [lookupRoot] using hg.selNodup

theorem swapNet_toff (hg : f.Geo) : ECDSAAdd.toffoliCount f.swapNet = 3 * f.ports.length := by
  have ht : (portTargets f.ports).length = f.ports.length := by simp [portTargets]
  simp only [swapNet, ECDSAAdd.toffoliCount_append, WideBank8.Fast16.swapLayer_toff, ht,
    hg.len1, hg.len2, hg.len3, Nat.min_self]
  omega

theorem swapNet_slots (hg : f.Geo) : ECDSAAdd.Challenge.gateSlots f.swapNet = 9 * f.ports.length := by
  have ht : (portTargets f.ports).length = f.ports.length := by simp [portTargets]
  simp only [swapNet, ECDSAAdd.Challenge.gateSlots_append, WideBank8.Fast16.swapLayer_slots, ht,
    hg.len1, hg.len2, hg.len3, Nat.min_self]
  omega

theorem swapNet_valid (hg : f.Geo) : ∀ i ∈ f.swapNet, ECDSAAdd.Challenge.instructionValid i := by
  have sub1 : List.Sublist (portTargets f.ports ++ f.g1) (portTargets f.ports ++ f.garb) :=
    ((List.sublist_append_left f.g1 f.g2).trans (List.sublist_append_left (f.g1 ++ f.g2) f.g3)).append_left _
  have sub2 : List.Sublist (f.g2 ++ f.g3) (portTargets f.ports ++ f.garb) := by
    have h23 : List.Sublist (f.g2 ++ f.g3) f.garb := by
      simp only [garb, List.append_assoc]; exact List.sublist_append_right f.g1 (f.g2 ++ f.g3)
    exact h23.trans (List.sublist_append_right _ _)
  have sub3 : List.Sublist (portTargets f.ports ++ f.g2) (portTargets f.ports ++ f.garb) :=
    ((List.sublist_append_right f.g1 f.g2).trans (List.sublist_append_left (f.g1 ++ f.g2) f.g3)).append_left _
  have hp1 := WideBank8.Fast16.swapLayer_valid 855 _ _ (fun h => hg.n855 (sub1.subset h)) (hg.nodup.sublist sub1)
  have hp2 := WideBank8.Fast16.swapLayer_valid 855 _ _ (fun h => hg.n855 (sub2.subset h)) (hg.nodup.sublist sub2)
  have hp3 := WideBank8.Fast16.swapLayer_valid 856 _ _ (fun h => hg.n856 (sub3.subset h)) (hg.nodup.sublist sub3)
  intro i hi
  simp only [swapNet, List.mem_append] at hi
  rcases hi with (hi | hi) | hi
  · exact hp1 i hi
  · exact hp2 i hi
  · exact hp3 i hi

theorem loadProg_run (read : ConstantBit n → Bool) (start : Nat) (history : Fin start → Bool) :
    ((f.loadProg start).instantiate read history).run = (f.loadSource read).run := by
  rw [loadProg, castFinish_instantiate,
    append_run_fixed _ _ _ _ _ (fun h => literalFixed_run (n := n) _ _ _ _ read h),
    AdaptiveCircuit.run_seq, compile_run]
  simp only [loadSource, AdaptiveCircuit.run_seq]

theorem loadProg_tCount (read : ConstantBit n → Bool) (hg : f.Geo) (start : Nat) (history : Fin start → Bool) :
    ((f.loadProg start).instantiate read history).tCount =
      7 * (2 ^ f.selBits.length - 1 + 3 * f.ports.length) := by
  rw [loadProg, castFinish_instantiate,
    append_tCount_fixed _ _ _ _ _ (fun h => literalFixed_tCount (n := n) _ _ _ _ read h),
    compile_tCount read f.selBits f.selPaths windowRoot f.selCode (sel_layouts f hg),
    swapNet_toff f hg]
  simp only [selCode, literalToffolis, traversals, Nat.zero_add, Nat.one_mul]
  ring

theorem loadProg_records (hg : f.Geo) :
    codeRecords f.selBits f.selPaths windowRoot f.selCode = 2 ^ f.selBits.length - 1 := by
  rw [codeRecords_eq _ _ _ _ (sel_layouts f hg)]
  simp [selCode, literalRecords, traversals]

theorem loadProg_slots (hg : f.Geo) (start : Nat) :
    (f.loadProg start).gateSlots ≤ 2 ^ f.selBits.length * (4 * f.ports.length) + 10 * (2 ^ f.selBits.length - 1) +
      36 * f.ports.length := by
  rw [loadProg, castFinish_gateSlots, Straight.gateSlots_append,
    compile_slots _ _ _ _ (sel_layouts f hg), literalFixed_slots]
  have h1 : codeSlots f.selBits f.selCode = 2 ^ f.selBits.length * f.selPorts.length + 10 * (2 ^ f.selBits.length - 1) := by
    simp [selCode, codeSlots]
  have h2 := literal_slot_bound (n := n) f.swapNet
  rw [swapNet_slots f hg] at h2
  rw [h1, selPorts_length f hg]
  omega

theorem loadProg_wellFormed (hg : f.Geo) (start : Nat) : (f.loadProg start).WellFormed := by
  rw [loadProg, castFinish_wellFormed]
  refine straight_append_wellFormed _ _ ?_ (literalFixed_wellFormed _ _ _ (swapNet_valid f hg) _)
  exact pair_compile_wellFormed _ _ _ _ hg.selLen.ge
    (fun i hi => by
      simp only [selCode, List.mem_singleton] at hi; subst hi
      exact placed_implies_pair _ _ _ _ (sel_placed f hg))
    (fun p hp => by simp [selCode] at hp) start

theorem loadProg_residue (start : Nat) : AndGadget.residue (f.loadProg start) = 0 := by
  rw [loadProg, AndGadget.residue_cast, AndGadget.residue_append, WEXCredit.compile_residue,
    literalFixed, WEXCredit.residue_naive_cast, WEXCredit.literal_residue]

theorem loadProg_support (hg : f.Geo) (S : List Wire)
    (hroot : windowRoot ∈ S) (hguard : f.guard ∈ S) (h855 : (855 : Wire) ∈ S) (h856 : (856 : Wire) ∈ S)
    (hbits : f.selBits ⊆ S) (hpaths : f.selPaths ⊆ S) (hreg : portTargets f.ports ++ f.garb ⊆ S)
    (start : Nat) : ChallengeMigration.straightWires (f.loadProg start) ⊆ S := by
  rw [loadProg, support_cast, straightWires_append]
  refine List.append_subset.mpr ⟨?_, ?_⟩
  · refine compile_support f.selBits f.selPaths windowRoot f.selCode S hroot hbits hpaths
      (fun p hp => by simp [selCode] at hp) ?_ start
    intro c ps hm
    simp only [selCode, List.mem_singleton, WInstr.lookup.injEq] at hm
    obtain ⟨rfl, rfl⟩ := hm
    exact ⟨fun q hq => by rw [Option.mem_def, Option.some_inj] at hq; exact hq ▸ hguard,
      by rw [selPorts_targets f hg]; exact hreg⟩
  · refine literalFixed_support _ _ _ S ?_ _
    intro w hw
    simp only [swapNet, ECDSAAdd.wires_append, Finset.mem_union] at hw
    simp only [List.mem_toFinset]
    rcases hw with (hw | hw) | hw
    · have h := WideBank8.Fast16.swapLayer_wires 855 _ _ hw
      simp only [List.mem_toFinset, List.cons_append, List.mem_cons, List.mem_append] at h
      rcases h with rfl | h | h
      · exact h855
      · exact hreg (List.mem_append_left _ h)
      · exact hreg (List.mem_append_right _ (by simp [garb, h]))
    · have h := WideBank8.Fast16.swapLayer_wires 855 _ _ hw
      simp only [List.mem_toFinset, List.cons_append, List.mem_cons, List.mem_append] at h
      rcases h with rfl | h | h
      · exact h855
      · exact hreg (List.mem_append_right _ (by simp [garb, h]))
      · exact hreg (List.mem_append_right _ (by simp [garb, h]))
    · have h := WideBank8.Fast16.swapLayer_wires 856 _ _ hw
      simp only [List.mem_toFinset, List.cons_append, List.mem_cons, List.mem_append] at h
      rcases h with rfl | h | h
      · exact h856
      · exact hreg (List.mem_append_left _ h)
      · exact hreg (List.mem_append_right _ (by simp [garb, h]))

theorem load_state (read : ConstantBit n → Bool) (hg : f.Geo) (a : Nat) (st : ECDSAAdd.State)
    (hs : SimulationValid f.bits f.paths windowRoot a st)
    (hc : Clean (portTargets f.ports ++ f.garb) st.basis) :
    let s₂ := ECDSAAdd.run f.swapNet List.nil
      (ECDSAAdd.run ((specialize f.selCode (tableAddressValue f.selBits st.basis)).instantiate read) List.nil st)
    s₂.phase = st.phase ∧
    (∀ w, w ∉ portTargets f.ports → w ∉ f.garb → s₂.basis w = st.basis w) ∧
    (∀ q ∈ clearData f.garbPorts, s₂.basis q.target = (st.basis f.guard && decide (read (q.ref a) = q.value))) ∧
    clearRegister f.garb s₂.basis = tableXorState (portMask read f.ports a) (st.basis f.guard) st.basis := by
  intro s₂
  have hsel := selPorts_targets f hg
  have hselnd : (portTargets f.selPorts).Nodup := by rw [hsel]; exact hg.nodup
  have hguard : f.guard ∉ portTargets f.selPorts := by
    rw [hsel]; exact List.disjoint_left.mp hg.selDisj (by simp)
  have lt : (portTargets f.ports).length = f.ports.length := by simp [portTargets]
  have hnd_app := List.nodup_append.mp hg.nodup
  have hd : ∀ w ∈ f.garb, w ∉ portTargets f.ports := fun w hw hm => hnd_app.2.2 w hm w hw rfl
  have hgn := hnd_app.2.1
  have h' := List.nodup_append.mp hgn
  have h'' := List.nodup_append.mp h'.1
  have d1 : ∀ w ∈ f.g1, w ∉ portTargets f.ports := fun w hw => hd w (by simp [garb, hw])
  have d2 : ∀ w ∈ f.g2, w ∉ portTargets f.ports := fun w hw => hd w (by simp [garb, hw])
  have d3 : ∀ w ∈ f.g3, w ∉ portTargets f.ports := fun w hw => hd w (by simp [garb, hw])
  have d21 : ∀ w ∈ f.g2, w ∉ f.g1 := fun w hw h1 => h''.2.2 w h1 w hw rfl
  have d31 : ∀ w ∈ f.g3, w ∉ f.g1 := fun w hw h1 => h'.2.2 w (List.mem_append_left _ h1) w hw rfl
  have d32 : ∀ w ∈ f.g3, w ∉ f.g2 := fun w hw h2 => h'.2.2 w (List.mem_append_right _ h2) w hw rfl
  set h := tableAddressValue f.selBits st.basis with hh
  have e1 : specialize f.selCode h = portTemplate (some f.guard) f.selPorts h := by
    simp [selCode, specialize, WInstr.specialize]
  set s₁ := ECDSAAdd.run ((specialize f.selCode h).instantiate read) List.nil st with hs₁
  have r1 : s₁ = ⟨st.phase, tableXorState (portMask read f.selPorts h) (st.basis f.guard) st.basis⟩ := by
    rw [hs₁, e1]
    exact portTemplate_run read (some f.guard) f.selPorts h windowRoot List.nil st hselnd hguard hs.2.2
  have sel_at : ∀ q ∈ f.selPorts, s₁.basis q.target =
      (st.basis f.guard && decide (read (q.ref h) = q.value)) := by
    intro q hq
    rw [r1]; show tableXorState _ _ _ q.target = _
    simp only [tableXorState, port_selected read f.selPorts h hselnd q hq]
    have hm : q.target ∈ portTargets f.selPorts := List.mem_map.mpr ⟨q, hq, rfl⟩
    rw [hsel] at hm
    simp [hc _ hm]
  have frame1 : ∀ w, w ∉ portTargets f.ports → w ∉ f.garb → s₁.basis w = st.basis w := by
    intro w h1 h2
    rw [r1]; show tableXorState _ _ _ w = _
    apply tableXorState_outside
    intro hm
    have hm' := tableBitsMask_subset _ _ hm
    rw [hsel] at hm'
    rcases List.mem_append.mp hm' with h | h
    · exact h1 h
    · exact h2 h
  have H0 : WideBank8.Fast16.FastSite.Holds read f.ports (portTargets f.ports) (4 * h) (st.basis f.guard) s₁.basis := by
    intro i hi hgi
    have hq : (⟨fun h => (f.ports[i]'hi).ref (4 * h), (f.ports[i]'hi).value, (f.ports[i]'hi).target⟩ : LookupPort n) ∈
        f.selPorts := by
      simp only [selPorts, List.mem_append]; left; left; left
      exact List.mem_map.mpr ⟨f.ports[i]'hi, List.getElem_mem hi, rfl⟩
    simpa [portTargets, List.getElem_map] using sel_at _ hq
  have H1 : WideBank8.Fast16.FastSite.Holds read f.ports f.g1 (4 * h + 1) (st.basis f.guard) s₁.basis := fun i hi hgi =>
    sel_at _ (by simp only [selPorts, List.mem_append]; left; left; right; exact WideBank8.Fast16.mem_regPorts _ _ _ i hi hgi)
  have H2 : WideBank8.Fast16.FastSite.Holds read f.ports f.g2 (4 * h + 2) (st.basis f.guard) s₁.basis := fun i hi hgi =>
    sel_at _ (by simp only [selPorts, List.mem_append]; left; right; exact WideBank8.Fast16.mem_regPorts _ _ _ i hi hgi)
  have H3 : WideBank8.Fast16.FastSite.Holds read f.ports f.g3 (4 * h + 3) (st.basis f.guard) s₁.basis := fun i hi hgi =>
    sel_at _ (by simp only [selPorts, List.mem_append]; right; exact WideBank8.Fast16.mem_regPorts _ _ _ i hi hgi)
  have sub1 : List.Sublist (portTargets f.ports ++ f.g1) (portTargets f.ports ++ f.garb) :=
    ((List.sublist_append_left f.g1 f.g2).trans (List.sublist_append_left (f.g1 ++ f.g2) f.g3)).append_left _
  have sub2 : List.Sublist (f.g2 ++ f.g3) (portTargets f.ports ++ f.garb) := by
    have h23 : List.Sublist (f.g2 ++ f.g3) f.garb := by
      simp only [garb, List.append_assoc]; exact List.sublist_append_right f.g1 (f.g2 ++ f.g3)
    exact h23.trans (List.sublist_append_right _ _)
  have sub3 : List.Sublist (portTargets f.ports ++ f.g2) (portTargets f.ports ++ f.garb) :=
    ((List.sublist_append_right f.g1 f.g2).trans (List.sublist_append_left (f.g1 ++ f.g2) f.g3)).append_left _
  have nd1 := hg.nodup.sublist sub1
  have nd2 := hg.nodup.sublist sub2
  have nd3 := hg.nodup.sublist sub3
  have c1 : (855 : Wire) ∉ portTargets f.ports ++ f.g1 := fun h => hg.n855 (sub1.subset h)
  have c2 : (855 : Wire) ∉ f.g2 ++ f.g3 := fun h => hg.n855 (sub2.subset h)
  have c3 : (856 : Wire) ∉ portTargets f.ports ++ f.g2 := fun h => hg.n856 (sub3.subset h)
  set t₁ := ECDSAAdd.run (WideBank8.Fast16.swapLayer 855 (portTargets f.ports) f.g1) List.nil s₁ with ht₁
  set t₂ := ECDSAAdd.run (WideBank8.Fast16.swapLayer 855 f.g2 f.g3) List.nil t₁ with ht₂
  have hs₂ : s₂ = ECDSAAdd.run (WideBank8.Fast16.swapLayer 856 (portTargets f.ports) f.g2) List.nil t₂ := by
    show ECDSAAdd.run f.swapNet List.nil s₁ = _
    simp only [swapNet, ECDSAAdd.run_append, ECDSAAdd.measurementCount_append, WideBank8.Fast16.swapLayer_meas,
      Nat.add_zero, List.take_zero, List.drop_zero, List.take_nil, List.drop_nil]
    rw [ht₂, ht₁]
  obtain ⟨p1, fr1, -⟩ := WideBank8.Fast16.swapLayer_run 855 _ _ c1 nd1 (by rw [lt, hg.len1]) s₁ List.nil
  obtain ⟨p2, fr2, -⟩ := WideBank8.Fast16.swapLayer_run 855 _ _ c2 nd2 (by rw [hg.len2, hg.len3]) t₁ List.nil
  obtain ⟨p3, fr3, -⟩ := WideBank8.Fast16.swapLayer_run 856 _ _ c3 nd3 (by rw [lt, hg.len2]) t₂ List.nil
  have frame : ∀ w, w ∉ portTargets f.ports → w ∉ f.garb → s₂.basis w = st.basis w := fun w h1 h2 => by
    rw [hs₂, fr3 w h1 (fun hm => h2 (by simp [garb, hm])),
      ht₂, fr2 w (fun hm => h2 (by simp [garb, hm])) (fun hm => h2 (by simp [garb, hm])),
      ht₁, fr1 w h1 (fun hm => h2 (by simp [garb, hm])), frame1 w h1 h2]
  have n855t : (855 : Wire) ∉ portTargets f.ports := fun h => hg.n855 (List.mem_append_left _ h)
  have n855g : (855 : Wire) ∉ f.garb := fun h => hg.n855 (List.mem_append_right _ h)
  have n856t : (856 : Wire) ∉ portTargets f.ports := fun h => hg.n856 (List.mem_append_left _ h)
  have n856g : (856 : Wire) ∉ f.garb := fun h => hg.n856 (List.mem_append_right _ h)
  have b0_1 : s₁.basis 855 = st.basis 855 := frame1 _ n855t n855g
  have b0_2 : t₁.basis 855 = st.basis 855 := by rw [ht₁, fr1 855 n855t (fun h => n855g (by simp [garb, h])), b0_1]
  have b1_3 : t₂.basis 856 = st.basis 856 := by
    rw [ht₂, fr2 856 (fun h => n856g (by simp [garb, h])) (fun h => n856g (by simp [garb, h])),
      ht₁, fr1 856 n856t (fun h => n856g (by simp [garb, h])), frame1 856 n856t n856g]
  obtain ⟨T1, G1⟩ := WideBank8.Fast16.FastSite.holds_swap read f.ports _ _ 855 (4 * h) (4 * h + 1) (st.basis f.guard) s₁ List.nil
    c1 nd1 lt hg.len1 H0 H1
  rw [b0_1] at T1 G1
  have H2' := WideBank8.Fast16.FastSite.holds_frame read f.ports f.g2 _ _ _ _ H2 (fun w hw => fr1 w (d2 w hw) (d21 w hw))
  have H3' := WideBank8.Fast16.FastSite.holds_frame read f.ports f.g3 _ _ _ _ H3 (fun w hw => fr1 w (d3 w hw) (d31 w hw))
  obtain ⟨G2, G3⟩ := WideBank8.Fast16.FastSite.holds_swap read f.ports _ _ 855 (4 * h + 2) (4 * h + 3) (st.basis f.guard) t₁ List.nil
    c2 nd2 hg.len2 hg.len3 H2' H3'
  rw [b0_2] at G2 G3
  have T2 := WideBank8.Fast16.FastSite.holds_frame read f.ports _ _ _ _ _ T1 (fun w hw => fr2 w (fun hm => d2 _ hm hw) (fun hm => d3 _ hm hw))
  have G1' := WideBank8.Fast16.FastSite.holds_frame read f.ports f.g1 _ _ _ _ G1 (fun w hw => fr2 w (fun hm => d21 _ hm hw) (fun hm => d31 _ hm hw))
  obtain ⟨T3, G2'⟩ := WideBank8.Fast16.FastSite.holds_swap read f.ports _ _ 856 _ _ (st.basis f.guard) t₂ List.nil
    c3 nd3 lt hg.len2 T2 G2
  rw [b1_3] at T3 G2'
  have G1'' := WideBank8.Fast16.FastSite.holds_frame read f.ports f.g1 _ _ _ _ G1' (fun w hw => fr3 w (d1 w hw) (fun hm => d21 _ hm hw))
  have G3'' := WideBank8.Fast16.FastSite.holds_frame read f.ports f.g3 _ _ _ _ G3 (fun w hw => fr3 w (d3 w hw) (d32 w hw))
  have haddr : a = (st.basis 855).toNat + 2 * (st.basis 856).toNat + 4 * h := by
    have htv := hs.2.1
    rw [hg.bitsEq] at htv
    simp only [tableAddressValue, wireValues, List.map_cons, boolWordToNat] at htv
    omega
  have hr0 : (if st.basis 856 then (if st.basis 855 then 4 * h + 3 else 4 * h + 2)
      else (if st.basis 855 then 4 * h + 1 else 4 * h)) = a := by
    cases hb0 : st.basis 855 <;> cases hb1 : st.basis 856 <;> simp [hb0, hb1] at haddr ⊢ <;> omega
  have hr1 : (if st.basis 855 then 4 * h else 4 * h + 1) = rowOf1 a := by
    cases hb0 : st.basis 855 <;> cases hb1 : st.basis 856 <;> simp [hb0, hb1, rowOf1] at haddr ⊢ <;> omega
  have hr2 : (if st.basis 856 then (if st.basis 855 then 4 * h + 1 else 4 * h)
      else (if st.basis 855 then 4 * h + 3 else 4 * h + 2)) = rowOf2 a := by
    cases hb0 : st.basis 855 <;> cases hb1 : st.basis 856 <;> simp [hb0, hb1, rowOf2] at haddr ⊢ <;> omega
  have hr3 : (if st.basis 855 then 4 * h + 2 else 4 * h + 3) = rowOf3 a := by
    cases hb0 : st.basis 855 <;> cases hb1 : st.basis 856 <;> simp [hb0, hb1, rowOf3] at haddr ⊢ <;> omega
  rw [hr0] at T3; rw [hr1] at G1''; rw [hr2] at G2'; rw [hr3] at G3''
  refine ⟨by rw [hs₂, p3, ht₂, p2, ht₁, p1, r1], frame, ?_, ?_⟩
  · intro q hq
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hq
    simp only [garbPorts, List.mem_append] at hp
    rcases hp with (hp | hp) | hp
    · obtain ⟨i, hi, hgi, rfl⟩ := WideBank8.Fast16.of_mem_regPorts _ _ _ p hp
      rw [hs₂]; exact G1'' i hi hgi
    · obtain ⟨i, hi, hgi, rfl⟩ := WideBank8.Fast16.of_mem_regPorts _ _ _ p hp
      rw [hs₂]; exact G2' i hi hgi
    · obtain ⟨i, hi, hgi, rfl⟩ := WideBank8.Fast16.of_mem_regPorts _ _ _ p hp
      rw [hs₂]; exact G3'' i hi hgi
  · funext w
    by_cases hwg : w ∈ f.garb
    · rw [clearRegister_clean f.garb s₂.basis w hwg]
      have hnt : w ∉ portTargets f.ports := hd w hwg
      rw [tableXorState_outside (portMask read f.ports a) _ _ w (fun hm => hnt (tableBitsMask_subset _ _ hm))]
      exact (hc w (List.mem_append_right _ hwg)).symm
    · rw [MeasuredClear.clearRegister_frame f.garb s₂.basis w hwg]
      by_cases hwt : w ∈ portTargets f.ports
      · obtain ⟨i, hi, he⟩ := List.getElem_of_mem hwt
        have hi' : i < f.ports.length := by simpa [portTargets] using hi
        have hT := T3 i hi' hi
        rw [he] at hT
        have hp : f.ports[i]'hi' ∈ f.ports := List.getElem_mem hi'
        have htg : (f.ports[i]'hi').target = w := by simpa [portTargets, List.getElem_map] using he
        have hsel' := port_selected read f.ports a hnd_app.1 (f.ports[i]'hi') hp
        rw [htg] at hsel'
        have hcw := hc w (List.mem_append_left _ hwt)
        simp only [tableXorState, hsel', hcw, Bool.false_xor]
        rw [hs₂]; exact hT
      · rw [frame w hwt hwg]
        exact (tableXorState_outside _ _ _ _ (fun hm => hwt (tableBitsMask_subset _ _ hm))).symm

theorem load_sim (read : ConstantBit n → Bool) (hg : f.Geo) :
    ∃ cs : List ℂ, List.Forall₂
      (fun b c => ∀ a (st : ECDSAAdd.State),
        SimulationValid f.bits f.paths windowRoot a st →
        Clean (portTargets f.ports ++ f.garb) st.basis →
        b.kraus (Bridge.signedKet st) = c • Bridge.signedKet
          (ECDSAAdd.run f.swapNet List.nil
            (ECDSAAdd.run ((specialize f.selCode (tableAddressValue f.selBits st.basis)).instantiate read) List.nil st)))
      (f.loadSource read).run cs ∧ (cs.map Complex.normSq).sum = 1 := by
  have hp1 : ∀ i ∈ f.selCode, PlacedPair f.selBits f.selPaths windowRoot i := by
    intro i hi
    simp only [selCode, List.mem_singleton] at hi; subst hi
    exact placed_implies_pair _ _ _ _ (sel_placed f hg)
  obtain ⟨c1, a1, m1⟩ := pair_source_simulation read f.selBits f.selPaths windowRoot hg.selLen.ge f.selCode hp1
  obtain ⟨c2, a2, m2⟩ := literal_simulation f.swapNet
  have h1 : ∀ a (st : ECDSAAdd.State), SimulationValid f.bits f.paths windowRoot a st →
      SimulationValid f.selBits f.selPaths windowRoot (tableAddressValue f.selBits st.basis) st :=
    fun a st hs => ⟨fun w hw => hs.1 w (hg.pathsSub w hw), rfl, hs.2.2⟩
  refine ⟨coherentSeqCoefficients c1 c2, ?_, by rw [simulationCoefficients_mass, m1, m2]; norm_num⟩
  rw [loadSource, AdaptiveCircuit.run_seq]
  apply simulationAligned_seq a1 a2
  intro b₁ k₁ b₂ k₂ hb₁ hb₂ a st hs _
  obtain ⟨m, hm, hb₁⟩ := hb₁
  have hm0 : m = List.nil := List.eq_nil_of_length_eq_zero (by simpa [selCode, literalRecords] using hm)
  have hh0 : b₂.history = List.nil := List.eq_nil_of_length_eq_zero (by
    rw [hb₂.1]; simp [swapNet, ECDSAAdd.measurementCount_append, WideBank8.Fast16.swapLayer_meas])
  change b₂.kraus (b₁.kraus (Bridge.signedKet st)) = _
  rw [hb₁ _ st (h1 a st hs), map_smul, hb₂.2, hm0, hh0]
  simp [smul_smul]

end SS2

/-- A bank-generic 1-bit SelectSwap load + swap gadget (2 registers: targets + `g1`). -/
structure SS1 (n : Nat) where
  bits : List Wire
  paths : List Wire
  selBits : List Wire
  selPaths : List Wire
  guard : Wire
  ports : List (LookupPort n)
  g1 : List Wire

namespace SS1
variable {n : Nat} (f : SS1 n)

def rowOf1 (a : Nat) : Nat := 2 * (a / 2) + (1 - a % 2)

def selPorts : List (LookupPort n) :=
  f.ports.map (fun p => ⟨fun h => p.ref (2 * h), p.value, p.target⟩) ++
  WideBank8.Fast16.regPorts (fun h => 2 * h + 1) f.ports f.g1

def garbPorts : List (LookupPort n) :=
  WideBank8.Fast16.regPorts rowOf1 f.ports f.g1

def swapNet : ECDSAAdd.Program :=
  WideBank8.Fast16.swapLayer 855 (portTargets f.ports) f.g1

def selCode : WCode n := [.lookup (some f.guard) f.selPorts]

def loadProg (start : Nat) : Straight n start (start + codeRecords f.selBits f.selPaths windowRoot f.selCode) :=
  castFinish (by omega)
    ((compile f.selBits f.selPaths windowRoot f.selCode start).append
      (literalFixed f.swapNet 0 ((literal_meas (n := n) _).trans (by
        simp [swapNet, WideBank8.Fast16.swapLayer_meas]))
        (start + codeRecords f.selBits f.selPaths windowRoot f.selCode)))

def loadSource (read : ConstantBit n → Bool) : AdaptiveCircuit :=
  (source read f.selBits f.selPaths windowRoot f.selCode).seq (literalSource f.swapNet)

structure Geo : Prop where
  bitsEq : f.bits = 855 :: f.selBits
  pathsSub : ∀ w ∈ f.selPaths, w ∈ f.paths
  selLen : f.selPaths.length = f.selBits.length
  selNodup : (f.guard :: f.selBits ++ f.selPaths).Nodup
  selDisj : List.Disjoint (windowRoot :: f.guard :: f.selBits ++ f.selPaths) (portTargets f.ports ++ f.g1)
  len1 : f.g1.length = f.ports.length
  nodup : (portTargets f.ports ++ f.g1).Nodup
  n855 : (855 : Wire) ∉ portTargets f.ports ++ f.g1

theorem selPorts_targets (hg : f.Geo) : portTargets f.selPorts = portTargets f.ports ++ f.g1 := by
  have h1 := WideBank8.Fast16.regPorts_targets (fun h => 2 * h + 1) f.ports f.g1 hg.len1
  simp only [selPorts, WideBank8.Fast16.FastSite.portTargets_append, h1]
  congr 1; simp [portTargets, List.map_map, Function.comp_def]

theorem garbPorts_targets (hg : f.Geo) : portTargets f.garbPorts = f.g1 :=
  WideBank8.Fast16.regPorts_targets _ _ _ hg.len1

theorem garbPorts_length (hg : f.Geo) : f.garbPorts.length = f.ports.length := by
  have h := congrArg List.length (garbPorts_targets f hg)
  simp only [portTargets, List.length_map, hg.len1] at h; exact h

theorem selPorts_length (hg : f.Geo) : f.selPorts.length = 2 * f.ports.length := by
  have h := congrArg List.length (selPorts_targets f hg)
  simp only [portTargets, List.length_map, List.length_append, hg.len1] at h; omega

theorem sel_placed (hg : f.Geo) : Placed f.selBits f.selPaths windowRoot (.lookup (some f.guard) f.selPorts) := by
  refine ⟨by simpa [lookupRoot] using hg.selNodup, by rw [selPorts_targets f hg]; exact hg.nodup,
    by rw [selPorts_targets f hg]; simpa [lookupRoot] using hg.selDisj⟩

theorem sel_layouts (hg : f.Geo) : LookupLayouts f.selBits f.selPaths windowRoot f.selCode := by
  refine ⟨hg.selLen.ge, fun c ps hm => ?_⟩
  simp only [selCode, List.mem_singleton, WInstr.lookup.injEq] at hm
  obtain ⟨rfl, rfl⟩ := hm
  simpa [lookupRoot] using hg.selNodup

theorem swapNet_toff (hg : f.Geo) : ECDSAAdd.toffoliCount f.swapNet = f.ports.length := by
  have ht : (portTargets f.ports).length = f.ports.length := by simp [portTargets]
  simp only [swapNet, WideBank8.Fast16.swapLayer_toff, ht, hg.len1, Nat.min_self]

theorem swapNet_slots (hg : f.Geo) : ECDSAAdd.Challenge.gateSlots f.swapNet = 3 * f.ports.length := by
  have ht : (portTargets f.ports).length = f.ports.length := by simp [portTargets]
  simp only [swapNet, WideBank8.Fast16.swapLayer_slots, ht, hg.len1, Nat.min_self]

theorem swapNet_valid (hg : f.Geo) : ∀ i ∈ f.swapNet, ECDSAAdd.Challenge.instructionValid i :=
  WideBank8.Fast16.swapLayer_valid 855 _ _ hg.n855 hg.nodup

theorem loadProg_run (read : ConstantBit n → Bool) (start : Nat) (history : Fin start → Bool) :
    ((f.loadProg start).instantiate read history).run = (f.loadSource read).run := by
  rw [loadProg, castFinish_instantiate,
    append_run_fixed _ _ _ _ _ (fun h => literalFixed_run (n := n) _ _ _ _ read h),
    AdaptiveCircuit.run_seq, compile_run]
  simp only [loadSource, AdaptiveCircuit.run_seq]

theorem loadProg_tCount (read : ConstantBit n → Bool) (hg : f.Geo) (start : Nat) (history : Fin start → Bool) :
    ((f.loadProg start).instantiate read history).tCount =
      7 * (2 ^ f.selBits.length - 1 + f.ports.length) := by
  rw [loadProg, castFinish_instantiate,
    append_tCount_fixed _ _ _ _ _ (fun h => literalFixed_tCount (n := n) _ _ _ _ read h),
    compile_tCount read f.selBits f.selPaths windowRoot f.selCode (sel_layouts f hg),
    swapNet_toff f hg]
  simp only [selCode, literalToffolis, traversals, Nat.zero_add, Nat.one_mul]
  ring

theorem loadProg_records (hg : f.Geo) :
    codeRecords f.selBits f.selPaths windowRoot f.selCode = 2 ^ f.selBits.length - 1 := by
  rw [codeRecords_eq _ _ _ _ (sel_layouts f hg)]
  simp [selCode, literalRecords, traversals]

theorem loadProg_slots (hg : f.Geo) (start : Nat) :
    (f.loadProg start).gateSlots ≤ 2 ^ f.selBits.length * (2 * f.ports.length) + 10 * (2 ^ f.selBits.length - 1) +
      12 * f.ports.length := by
  rw [loadProg, castFinish_gateSlots, Straight.gateSlots_append,
    compile_slots _ _ _ _ (sel_layouts f hg), literalFixed_slots]
  have h1 : codeSlots f.selBits f.selCode = 2 ^ f.selBits.length * f.selPorts.length + 10 * (2 ^ f.selBits.length - 1) := by
    simp [selCode, codeSlots]
  have h2 := literal_slot_bound (n := n) f.swapNet
  rw [swapNet_slots f hg] at h2
  rw [h1, selPorts_length f hg]
  omega

theorem loadProg_wellFormed (hg : f.Geo) (start : Nat) : (f.loadProg start).WellFormed := by
  rw [loadProg, castFinish_wellFormed]
  refine straight_append_wellFormed _ _ ?_ (literalFixed_wellFormed _ _ _ (swapNet_valid f hg) _)
  exact pair_compile_wellFormed _ _ _ _ hg.selLen.ge
    (fun i hi => by
      simp only [selCode, List.mem_singleton] at hi; subst hi
      exact placed_implies_pair _ _ _ _ (sel_placed f hg))
    (fun p hp => by simp [selCode] at hp) start

theorem loadProg_residue (start : Nat) : AndGadget.residue (f.loadProg start) = 0 := by
  rw [loadProg, AndGadget.residue_cast, AndGadget.residue_append, WEXCredit.compile_residue,
    literalFixed, WEXCredit.residue_naive_cast, WEXCredit.literal_residue]

theorem loadProg_support (hg : f.Geo) (S : List Wire)
    (hroot : windowRoot ∈ S) (hguard : f.guard ∈ S) (h855 : (855 : Wire) ∈ S)
    (hbits : f.selBits ⊆ S) (hpaths : f.selPaths ⊆ S) (hreg : portTargets f.ports ++ f.g1 ⊆ S)
    (start : Nat) : ChallengeMigration.straightWires (f.loadProg start) ⊆ S := by
  rw [loadProg, support_cast, straightWires_append]
  refine List.append_subset.mpr ⟨?_, ?_⟩
  · refine compile_support f.selBits f.selPaths windowRoot f.selCode S hroot hbits hpaths
      (fun p hp => by simp [selCode] at hp) ?_ start
    intro c ps hm
    simp only [selCode, List.mem_singleton, WInstr.lookup.injEq] at hm
    obtain ⟨rfl, rfl⟩ := hm
    exact ⟨fun q hq => by rw [Option.mem_def, Option.some_inj] at hq; exact hq ▸ hguard,
      by rw [selPorts_targets f hg]; exact hreg⟩
  · refine literalFixed_support _ _ _ S ?_ _
    intro w hw
    have h := WideBank8.Fast16.swapLayer_wires 855 _ _ hw
    simp only [List.mem_toFinset, List.cons_append, List.mem_cons, List.mem_append] at h ⊢
    rcases h with rfl | h | h
    · exact h855
    · exact hreg (List.mem_append_left _ h)
    · exact hreg (List.mem_append_right _ h)

theorem load_state (read : ConstantBit n → Bool) (hg : f.Geo) (a : Nat) (st : ECDSAAdd.State)
    (hs : SimulationValid f.bits f.paths windowRoot a st)
    (hc : Clean (portTargets f.ports ++ f.g1) st.basis) :
    let s₂ := ECDSAAdd.run f.swapNet List.nil
      (ECDSAAdd.run ((specialize f.selCode (tableAddressValue f.selBits st.basis)).instantiate read) List.nil st)
    s₂.phase = st.phase ∧
    (∀ w, w ∉ portTargets f.ports → w ∉ f.g1 → s₂.basis w = st.basis w) ∧
    (∀ q ∈ clearData f.garbPorts, s₂.basis q.target = (st.basis f.guard && decide (read (q.ref a) = q.value))) ∧
    clearRegister f.g1 s₂.basis = tableXorState (portMask read f.ports a) (st.basis f.guard) st.basis := by
  intro s₂
  have hsel := selPorts_targets f hg
  have hselnd : (portTargets f.selPorts).Nodup := by rw [hsel]; exact hg.nodup
  have hguard : f.guard ∉ portTargets f.selPorts := by
    rw [hsel]; exact List.disjoint_left.mp hg.selDisj (by simp)
  have lt : (portTargets f.ports).length = f.ports.length := by simp [portTargets]
  have hnd_app := List.nodup_append.mp hg.nodup
  have hd : ∀ w ∈ f.g1, w ∉ portTargets f.ports := fun w hw hm => hnd_app.2.2 w hm w hw rfl
  set h := tableAddressValue f.selBits st.basis with hh
  have e1 : specialize f.selCode h = portTemplate (some f.guard) f.selPorts h := by
    simp [selCode, specialize, WInstr.specialize]
  set s₁ := ECDSAAdd.run ((specialize f.selCode h).instantiate read) List.nil st with hs₁
  have r1 : s₁ = ⟨st.phase, tableXorState (portMask read f.selPorts h) (st.basis f.guard) st.basis⟩ := by
    rw [hs₁, e1]
    exact portTemplate_run read (some f.guard) f.selPorts h windowRoot List.nil st hselnd hguard hs.2.2
  have sel_at : ∀ q ∈ f.selPorts, s₁.basis q.target =
      (st.basis f.guard && decide (read (q.ref h) = q.value)) := by
    intro q hq
    rw [r1]; show tableXorState _ _ _ q.target = _
    simp only [tableXorState, port_selected read f.selPorts h hselnd q hq]
    have hm : q.target ∈ portTargets f.selPorts := List.mem_map.mpr ⟨q, hq, rfl⟩
    rw [hsel] at hm
    simp [hc _ hm]
  have frame1 : ∀ w, w ∉ portTargets f.ports → w ∉ f.g1 → s₁.basis w = st.basis w := by
    intro w h1 h2
    rw [r1]; show tableXorState _ _ _ w = _
    apply tableXorState_outside
    intro hm
    have hm' := tableBitsMask_subset _ _ hm
    rw [hsel] at hm'
    rcases List.mem_append.mp hm' with h | h
    · exact h1 h
    · exact h2 h
  have H0 : WideBank8.Fast16.FastSite.Holds read f.ports (portTargets f.ports) (2 * h) (st.basis f.guard) s₁.basis := by
    intro i hi hgi
    have hq : (⟨fun h => (f.ports[i]'hi).ref (2 * h), (f.ports[i]'hi).value, (f.ports[i]'hi).target⟩ : LookupPort n) ∈
        f.selPorts := by
      simp only [selPorts, List.mem_append]; left
      exact List.mem_map.mpr ⟨f.ports[i]'hi, List.getElem_mem hi, rfl⟩
    simpa [portTargets, List.getElem_map] using sel_at _ hq
  have H1 : WideBank8.Fast16.FastSite.Holds read f.ports f.g1 (2 * h + 1) (st.basis f.guard) s₁.basis := fun i hi hgi =>
    sel_at _ (by simp only [selPorts, List.mem_append]; right; exact WideBank8.Fast16.mem_regPorts _ _ _ i hi hgi)
  obtain ⟨p1, fr1, -⟩ := WideBank8.Fast16.swapLayer_run 855 _ _ hg.n855 hg.nodup (by rw [lt, hg.len1]) s₁ List.nil
  have frame : ∀ w, w ∉ portTargets f.ports → w ∉ f.g1 → s₂.basis w = st.basis w := fun w h1 h2 => by
    change (ECDSAAdd.run (WideBank8.Fast16.swapLayer 855 _ _) List.nil s₁).basis w = _
    rw [fr1 w h1 h2, frame1 w h1 h2]
  have b0_1 : s₁.basis 855 = st.basis 855 :=
    frame1 _ (fun h => hg.n855 (List.mem_append_left _ h)) (fun h => hg.n855 (List.mem_append_right _ h))
  obtain ⟨T1, G1⟩ := WideBank8.Fast16.FastSite.holds_swap read f.ports _ _ 855 (2 * h) (2 * h + 1) (st.basis f.guard) s₁ List.nil
    hg.n855 hg.nodup lt hg.len1 H0 H1
  rw [b0_1] at T1 G1
  have haddr : a = (st.basis 855).toNat + 2 * h := by
    have htv := hs.2.1
    rw [hg.bitsEq] at htv
    simp only [tableAddressValue, wireValues, List.map_cons, boolWordToNat] at htv
    omega
  have hr0 : (if st.basis 855 then 2 * h + 1 else 2 * h) = a := by
    cases hb0 : st.basis 855 <;> simp [hb0] at haddr ⊢ <;> omega
  have hr1 : (if st.basis 855 then 2 * h else 2 * h + 1) = rowOf1 a := by
    cases hb0 : st.basis 855 <;> simp [hb0, rowOf1] at haddr ⊢ <;> omega
  rw [hr0] at T1; rw [hr1] at G1
  refine ⟨by change (ECDSAAdd.run (WideBank8.Fast16.swapLayer 855 _ _) List.nil s₁).phase = _; rw [p1, r1], frame, ?_, ?_⟩
  · intro q hq
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hq
    obtain ⟨i, hi, hgi, rfl⟩ := WideBank8.Fast16.of_mem_regPorts _ _ _ p hp
    exact G1 i hi hgi
  · funext w
    by_cases hwg : w ∈ f.g1
    · rw [clearRegister_clean f.g1 s₂.basis w hwg]
      have hnt : w ∉ portTargets f.ports := hd w hwg
      rw [tableXorState_outside (portMask read f.ports a) _ _ w (fun hm => hnt (tableBitsMask_subset _ _ hm))]
      exact (hc w (List.mem_append_right _ hwg)).symm
    · rw [MeasuredClear.clearRegister_frame f.g1 s₂.basis w hwg]
      by_cases hwt : w ∈ portTargets f.ports
      · obtain ⟨i, hi, he⟩ := List.getElem_of_mem hwt
        have hi' : i < f.ports.length := by simpa [portTargets] using hi
        have hT := T1 i hi' hi
        rw [he] at hT
        have hp : f.ports[i]'hi' ∈ f.ports := List.getElem_mem hi'
        have htg : (f.ports[i]'hi').target = w := by simpa [portTargets, List.getElem_map] using he
        have hsel' := port_selected read f.ports a hnd_app.1 (f.ports[i]'hi') hp
        rw [htg] at hsel'
        have hcw := hc w (List.mem_append_left _ hwt)
        simp only [tableXorState, hsel', hcw, Bool.false_xor]
        exact hT
      · rw [frame w hwt hwg]
        exact (tableXorState_outside _ _ _ _ (fun hm => hwt (tableBitsMask_subset _ _ hm))).symm

theorem load_sim (read : ConstantBit n → Bool) (hg : f.Geo) :
    ∃ cs : List ℂ, List.Forall₂
      (fun b c => ∀ a (st : ECDSAAdd.State),
        SimulationValid f.bits f.paths windowRoot a st →
        Clean (portTargets f.ports ++ f.g1) st.basis →
        b.kraus (Bridge.signedKet st) = c • Bridge.signedKet
          (ECDSAAdd.run f.swapNet List.nil
            (ECDSAAdd.run ((specialize f.selCode (tableAddressValue f.selBits st.basis)).instantiate read) List.nil st)))
      (f.loadSource read).run cs ∧ (cs.map Complex.normSq).sum = 1 := by
  have hp1 : ∀ i ∈ f.selCode, PlacedPair f.selBits f.selPaths windowRoot i := by
    intro i hi
    simp only [selCode, List.mem_singleton] at hi; subst hi
    exact placed_implies_pair _ _ _ _ (sel_placed f hg)
  obtain ⟨c1, a1, m1⟩ := pair_source_simulation read f.selBits f.selPaths windowRoot hg.selLen.ge f.selCode hp1
  obtain ⟨c2, a2, m2⟩ := literal_simulation f.swapNet
  have h1 : ∀ a (st : ECDSAAdd.State), SimulationValid f.bits f.paths windowRoot a st →
      SimulationValid f.selBits f.selPaths windowRoot (tableAddressValue f.selBits st.basis) st :=
    fun a st hs => ⟨fun w hw => hs.1 w (hg.pathsSub w hw), rfl, hs.2.2⟩
  refine ⟨coherentSeqCoefficients c1 c2, ?_, by rw [simulationCoefficients_mass, m1, m2]; norm_num⟩
  rw [loadSource, AdaptiveCircuit.run_seq]
  apply simulationAligned_seq a1 a2
  intro b₁ k₁ b₂ k₂ hb₁ hb₂ a st hs _
  obtain ⟨m, hm, hb₁⟩ := hb₁
  have hm0 : m = List.nil := List.eq_nil_of_length_eq_zero (by simpa [selCode, literalRecords] using hm)
  have hh0 : b₂.history = List.nil := List.eq_nil_of_length_eq_zero (by
    rw [hb₂.1]; simp [swapNet, WideBank8.Fast16.swapLayer_meas])
  change b₂.kraus (b₁.kraus (Bridge.signedKet st)) = _
  rw [hb₁ _ st (h1 a st hs), map_smul, hb₂.2, hm0, hh0]
  simp [smul_smul]

end SS1

end
end ShorECDLP.Entrant.Site1Fast
end

/-! ### Local 4-T Catalyst Compiler (`LocalFour`) -/
section
namespace ShorECDLP.Entrant.LocalFour
open Quantum Challenge AndGadget ConditionalCatalyst ApproximatePhase34
open Paper2607_13816 Paper2607_13816.ChallengeMigration
noncomputable section
set_option maxHeartbeats 2000000
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySimpa false
set_option linter.unusedVariables false

attribute [local irreducible] Quantum.run Quantum.applyGate Quantum.ket

/-- Preparing the local `|S⟩` catalyst state on wire `y`. -/
abbrev Prep (y : Wire) : State →ₗ[ℂ] State := Quantum.run (Catalyst.prepare y)

theorem prepare_wellFormed (y : Wire) : CircuitWellFormed (Catalyst.prepare y) := by
  simp [Catalyst.prepare, CircuitWellFormed, Gate.WellFormed]

theorem normSq_prep (y : Wire) (psi : State) : normSq (Prep y psi) = normSq psi :=
  normSq_run (Catalyst.prepare y) (prepare_wellFormed y) psi

theorem prep_circuit (y : Wire) (gs : Circuit) (hy : y ∉ circuitWires gs) (psi : State) :
    Quantum.run gs (Prep y psi) = Prep y (Quantum.run gs psi) := by
  induction gs generalizing psi with
  | nil => simp [Quantum.run_nil]
  | cons g gs ih =>
    have h1 : y ∉ gateWires g ∧ y ∉ circuitWires gs := by
      simpa [circuitWires, List.mem_append, not_or] using hy
    rw [Quantum.run_cons, Quantum.run_cons, Catalyst.prepare_gate y g h1.1 psi, ih h1.2]

theorem gate_frame_pair (q y : Wire) (g : Gate) (hq : q ∉ gateWires g) (hy : y ∉ gateWires g)
    (psi : State) (hp : SupportedOn (fun s => s q = false ∧ s y = false) psi) :
    SupportedOn (fun s => s q = false ∧ s y = false) (applyGate g psi) := by
  have h1 := ConditionalCatalyst.gate_frame q g hq psi (fun s hs => (hp s hs).1)
  have h2 := ConditionalCatalyst.gate_frame y g hy psi (fun s hs => (hp s hs).2)
  exact fun s hs => ⟨h1 s hs, h2 s hs⟩

theorem circuit_frame (y : Wire) (gs : Circuit) (hy : y ∉ circuitWires gs)
    (psi : State) (hp : SupportedOn (fun s => s y = false) psi) :
    SupportedOn (fun s => s y = false) (Quantum.run gs psi) := by
  induction gs generalizing psi with
  | nil => simpa [Quantum.run_nil] using hp
  | cons g gs ih =>
    have hy' : y ∉ gateWires g ∧ y ∉ circuitWires gs := by
      simpa [circuitWires, List.mem_append, not_or] using hy
    rw [Quantum.run_cons]
    exact ih hy'.2 _ (ConditionalCatalyst.gate_frame y g hy'.1 psi hp)

theorem circuit_frame_pair (q y : Wire) (gs : Circuit) (hq : q ∉ circuitWires gs) (hy : y ∉ circuitWires gs)
    (psi : State) (hp : SupportedOn (fun s => s q = false ∧ s y = false) psi) :
    SupportedOn (fun s => s q = false ∧ s y = false) (Quantum.run gs psi) :=
  fun s hs => ⟨circuit_frame q gs hq psi (fun t ht => (hp t ht).1) s hs,
    circuit_frame y gs hy psi (fun t ht => (hp t ht).2) s hs⟩

theorem reset_frame_pair (q y w : Wire) (hq : q ≠ w) (hy : y ≠ w) (outcome : Bool)
    (psi : State) (hp : SupportedOn (fun s => s q = false ∧ s y = false) psi) :
    SupportedOn (fun s => s q = false ∧ s y = false) (xResetKraus w outcome psi) := by
  have h1 := ConditionalCatalyst.reset_frame q w hq outcome psi (fun s hs => (hp s hs).1)
  have h2 := ConditionalCatalyst.reset_frame y w hy outcome psi (fun s hs => (hp s hs).2)
  exact fun s hs => ⟨h1 s hs, h2 s hs⟩

/-- Branch-level simulation under local `(q, y)` lowering + catalyst compilation. -/
def BranchLift (q y : Wire) (b' b : InstrumentBranch) (α : ℂ) : Prop :=
  ∀ psi : State, SupportedOn (fun s => s q = false ∧ s y = false) psi →
    b'.kraus (Prep y psi) = α • Prep y (b.kraus psi)

/-- Coherent implementation preserving `|S⟩` on catalyst wire `y`. -/
def CatCoherent (y : Wire) (C : AdaptiveCircuit) (U : State →ₗ[ℂ] State) (V : BasisState → Prop) : Prop :=
  ∃ cs : List ℂ, List.Forall₂
    (fun b c => ∀ s, V s → b.kraus (Prep y (ket s)) = c • Prep y (U (ket s)))
    C.run cs ∧ (cs.map Complex.normSq).sum = 1

/-- Literal `ECDSAAdd.Program` simulation preserving `|S⟩` on catalyst wire `y`. -/
def CatLitSim (y : Wire) (C : AdaptiveCircuit) (p : ECDSAAdd.Program) (V : BasisState → Prop) : Prop :=
  ∃ cs : List ℂ, List.Forall₂
    (fun b c => ∃ m : List Bool, m.length = ECDSAAdd.measurementCount p ∧
      ∀ st : ECDSAAdd.State, V st.basis →
        b.kraus (Prep y (Bridge.signedKet st)) = c • Prep y (Bridge.signedKet (ECDSAAdd.run p m st)))
    C.run cs ∧ (cs.map Complex.normSq).sum = 1

/-! #### Pure circuit compilation helpers (`compileCircuit`, `literals`, `whenLiterals`, `recordLiterals`) -/

def compileCircuit (y : Wire) : Circuit → Circuit
  | [] => []
  | g :: gs => ConditionalCatalyst.replacement y g ++ compileCircuit y gs

theorem compileCircuit_prep (y : Wire) (gs : Circuit) (hy : y ∉ circuitWires gs)
    (psi : State) (hp : SupportedOn (fun s => s y = false) psi) :
    Quantum.run (compileCircuit y gs) (Prep y psi) = Prep y (Quantum.run gs psi) := by
  induction gs generalizing psi with
  | nil => simp [compileCircuit, Quantum.run_nil]
  | cons g gs ih =>
    have h1 : y ∉ gateWires g ∧ y ∉ circuitWires gs := by
      simpa [circuitWires, List.mem_append, not_or] using hy
    rw [compileCircuit, Quantum.run_append, Quantum.run_cons,
      ConditionalCatalyst.replacement_correct y g h1.1 psi hp]
    exact ih h1.2 _ (ConditionalCatalyst.gate_frame y g h1.1 psi hp)

theorem compile_literals {n s e : Nat} (y : Wire) (gs : Circuit) (p : Straight n s e) :
    ConditionalCatalyst.compile y (AndGadget.literals gs p) =
      AndGadget.literals (compileCircuit y gs) (ConditionalCatalyst.compile y p) := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    change AndGadget.literals (ConditionalCatalyst.replacement y g)
        (ConditionalCatalyst.compile y (AndGadget.literals gs p)) =
      AndGadget.literals (ConditionalCatalyst.replacement y g ++ compileCircuit y gs)
        (ConditionalCatalyst.compile y p)
    rw [ih]
    have hl (a b : Circuit) (tail : Straight n s e) :
        AndGadget.literals (a ++ b) tail = AndGadget.literals a (AndGadget.literals b tail) := by
      induction a with
      | nil => rfl
      | cons x xs ihx => exact congrArg (Straight.gate (.literal x)) ihx
    exact (hl _ _ _).symm

private def preBranch (outcome : Option Bool) (before : State →ₗ[ℂ] State) (b : InstrumentBranch) :
    InstrumentBranch :=
  ⟨outcome.toList ++ b.history, b.kraus.comp before⟩

private theorem run_nil_eq : Quantum.run ([] : Circuit) = LinearMap.id := by
  apply LinearMap.ext; intro psi; exact Quantum.run_nil psi

theorem literals_instantiate_run {n s e : Nat} (read : ConstantBit n → Bool)
    (gs : Circuit) (p : Straight n s e) (h : Fin s → Bool) :
    ((AndGadget.literals gs p).instantiate read h).run =
      (p.instantiate read h).run.map (preBranch none (Quantum.run gs)) := by
  induction gs with
  | nil =>
    simp only [AndGadget.literals, List.foldr_nil, run_nil_eq]
    have he : preBranch none LinearMap.id = id := funext fun b => by cases b; simp [preBranch]
    rw [he, List.map_id]
  | cons g gs ih =>
    change (AdaptiveCircuit.unitary [g] ((AndGadget.literals gs p).instantiate read h)).run = _
    change ((AndGadget.literals gs p).instantiate read h).run.map (preBranch none (Quantum.run ([g]))) = _
    rw [ih, List.map_map]
    apply List.map_congr_left
    intro b _
    cases b with
    | mk hist k =>
      simp only [Function.comp_def, preBranch, Option.toList_none, List.nil_append,
        InstrumentBranch.mk.injEq, true_and]
      apply LinearMap.ext; intro psi
      simp only [LinearMap.comp_apply, Quantum.run_cons, Quantum.run_singleton, Quantum.run_nil]

theorem whenLiterals_instantiate_run {n s e : Nat} (read : ConstantBit n → Bool)
    (r : ConstantBit n) (v : Bool) (gs : Circuit) (p : Straight n s e) (h : Fin s → Bool) :
    ((ConditionalCatalyst.whenLiterals r v gs p).instantiate read h).run =
      (p.instantiate read h).run.map (preBranch none (if read r = v then Quantum.run gs else LinearMap.id)) := by
  induction gs with
  | nil =>
    simp only [ConditionalCatalyst.whenLiterals, run_nil_eq, ite_self]
    have he : preBranch none LinearMap.id = id := funext fun b => by cases b; simp [preBranch]
    rw [he, List.map_id]
  | cons g gs ih =>
    by_cases hr : read r = v
    · simp only [ConditionalCatalyst.whenLiterals, Straight.instantiate, TemplateGate.instantiate, hr, if_true]
      change ((ConditionalCatalyst.whenLiterals r v gs p).instantiate read h).run.map
        (preBranch none (Quantum.run ([g]))) = _
      rw [ih, if_pos hr, List.map_map]
      apply List.map_congr_left
      intro b _; cases b with
      | mk hist k =>
        simp only [Function.comp_def, preBranch, Option.toList_none, List.nil_append,
          InstrumentBranch.mk.injEq, true_and]
        apply LinearMap.ext; intro psi
        simp only [LinearMap.comp_apply, Quantum.run_cons, Quantum.run_singleton, Quantum.run_nil]
    · simp only [ConditionalCatalyst.whenLiterals, Straight.instantiate, TemplateGate.instantiate, hr, if_false]
      change ((ConditionalCatalyst.whenLiterals r v gs p).instantiate read h).run.map
        (preBranch none (Quantum.run ([] : Circuit))) = _
      rw [ih, if_neg hr, List.map_map]
      apply List.map_congr_left
      intro b _; cases b with
      | mk hist k =>
        simp only [Function.comp_def, preBranch, Option.toList_none, List.nil_append,
          run_nil_eq, InstrumentBranch.mk.injEq, true_and]
        apply LinearMap.ext; intro psi; simp only [LinearMap.comp_apply, LinearMap.id_coe, id_eq]

theorem recordLiterals_instantiate_run {n s e : Nat} (read : ConstantBit n → Bool)
    (i : Fin s) (v : Bool) (gs : Circuit) (p : Straight n s e) (h : Fin s → Bool) :
    ((ConditionalCatalyst.recordLiterals i v gs p).instantiate read h).run =
      (p.instantiate read h).run.map (preBranch none (if h i = v then Quantum.run gs else LinearMap.id)) := by
  induction gs with
  | nil =>
    simp only [ConditionalCatalyst.recordLiterals, run_nil_eq, ite_self]
    have he : preBranch none LinearMap.id = id := funext fun b => by cases b; simp [preBranch]
    rw [he, List.map_id]
  | cons g gs ih =>
    by_cases hr : h i = v
    · simp only [ConditionalCatalyst.recordLiterals, Straight.instantiate, hr, if_true]
      change ((ConditionalCatalyst.recordLiterals i v gs p).instantiate read h).run.map
        (preBranch none (Quantum.run ([g]))) = _
      rw [ih, if_pos hr, List.map_map]
      apply List.map_congr_left
      intro b _; cases b with
      | mk hist k =>
        simp only [Function.comp_def, preBranch, Option.toList_none, List.nil_append,
          InstrumentBranch.mk.injEq, true_and]
        apply LinearMap.ext; intro psi
        simp only [LinearMap.comp_apply, Quantum.run_cons, Quantum.run_singleton, Quantum.run_nil]
    · simp only [ConditionalCatalyst.recordLiterals, Straight.instantiate, hr, if_false]
      change ((ConditionalCatalyst.recordLiterals i v gs p).instantiate read h).run.map
        (preBranch none (Quantum.run ([] : Circuit))) = _
      rw [ih, if_neg hr, List.map_map]
      apply List.map_congr_left
      intro b _; cases b with
      | mk hist k =>
        simp only [Function.comp_def, preBranch, Option.toList_none, List.nil_append,
          run_nil_eq, InstrumentBranch.mk.injEq, true_and]
        apply LinearMap.ext; intro psi; simp only [LinearMap.comp_apply, LinearMap.id_coe, id_eq]

private theorem normSq_invSqrt2 : Complex.normSq (((Real.sqrt 2)⁻¹ : ℝ) : ℂ) = 1 / 2 := by
  simp only [Complex.normSq_ofReal]
  have h : Real.sqrt 2 ≠ 0 := by positivity
  field_simp
  nlinarith [Real.mul_self_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]

private theorem map_normSq_scale (α : ℂ) (cs : List ℂ) :
    ((cs.map (α * ·)).map Complex.normSq).sum = Complex.normSq α * (cs.map Complex.normSq).sum := by
  induction cs with
  | nil => simp
  | cons c cs ih =>
    simp only [List.map_cons, List.sum_cons, Complex.normSq_mul, ih, mul_add]

private theorem forall₂_map_left {α β γ : Type*} (f : α → β) (R : β → γ → Prop)
    (xs : List α) (ys : List γ) :
    List.Forall₂ R (xs.map f) ys ↔ List.Forall₂ (fun a c => R (f a) c) xs ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys <;> simp
  | cons x xs ih =>
    cases ys with
    | nil => simp
    | cons y ys => simp [ih]

private theorem forall₂_map_right {α β γ : Type*} (g : β → γ) (R : α → γ → Prop)
    (xs : List α) (ys : List β) :
    List.Forall₂ R xs (ys.map g) ↔ List.Forall₂ (fun a b => R a (g b)) xs ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys <;> simp
  | cons x xs ih =>
    cases ys with
    | nil => simp
    | cons y ys => simp [ih]

private theorem forall₂_append_split {α β : Type*} {R : α → β → Prop}
    {xs₁ xs₂ : List α} {ys : List β} (h : List.Forall₂ R (xs₁ ++ xs₂) ys) :
    ∃ ys₁ ys₂, ys = ys₁ ++ ys₂ ∧ List.Forall₂ R xs₁ ys₁ ∧ List.Forall₂ R xs₂ ys₂ := by
  induction xs₁ generalizing ys with
  | nil => exact ⟨[], ys, rfl, .nil, h⟩
  | cons x xs₁ ih =>
    cases h with
    | cons hx hrest =>
      rename_i y ys'
      obtain ⟨ys₁, ys₂, rfl, h1, h2⟩ := ih hrest
      exact ⟨y :: ys₁, ys₂, rfl, .cons hx h1, h2⟩

/-- Combined local lowering (`q`) + catalyst compilation (`y`). -/
def compileLower {n oldStart oldFinish : Nat} (q y : Wire) (p : Straight n oldStart oldFinish)
    (start : Nat) (records : Fin oldStart → Fin start) : AndGadget.Lowered n oldFinish start :=
  let r := AndGadget.lower q p start records
  ⟨r.finish, ConditionalCatalyst.compile y r.program, r.records⟩

private theorem circuitWires_append (c₁ c₂ : Circuit) :
    circuitWires (c₁ ++ c₂) = circuitWires c₁ ++ circuitWires c₂ :=
  List.flatMap_append

private theorem parityPhase_wires (a b c : Wire) :
    circuitWires (AndGadget.parityPhase a b c) ⊆ [a, b, c] := by
  intro w hw
  simp only [AndGadget.parityPhase, AndGadget.xorPhase, circuitWires, List.cons_append, List.nil_append,
    List.flatMap_cons, List.flatMap_nil, gateWires, List.mem_cons, List.not_mem_nil, or_false] at hw ⊢
  rcases hw with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

private theorem parityPhase_wellFormed (a b c : Wire) (hac : a ≠ c) (hbc : b ≠ c) :
    CircuitWellFormed (AndGadget.parityPhase a b c) := by
  simp only [AndGadget.parityPhase, AndGadget.xorPhase, List.cons_append, List.nil_append,
    CircuitWellFormed, List.forall_mem_cons, List.not_mem_nil, false_implies, implies_true,
    Gate.WellFormed, and_true, true_and]
  exact ⟨hac, hac, hac, hbc, hbc, hac, hbc, hbc⟩

private theorem parityPhase_tCount (a b c : Wire) : ShorECDLP.tCount (AndGadget.parityPhase a b c) = 4 := rfl

private theorem parityPhase_removed18 (a b c : Wire) :
    ((AndGadget.parityPhase a b c).map (fun g => (largePhase 18 g).toNat)).sum = 0 := by
  simp only [AndGadget.parityPhase, AndGadget.xorPhase, List.cons_append, List.nil_append,
    List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, largePhase]
  rfl

private theorem andCompute_cx_wires_not_mem (q y a b t : Wire)
    (hys : y ≠ a ∧ y ≠ b ∧ y ≠ t) (hqy : q ≠ y) :
    y ∉ circuitWires (andCompute a b q ++ [.CX q t]) := by
  intro hm
  simp only [andCompute, circuitWires_append, List.mem_append] at hm
  rcases hm with (((h | h) | h) | h)
  · simp only [circuitWires, List.flatMap_cons, List.flatMap_nil, List.append_nil, gateWires,
      List.mem_cons, List.not_mem_nil, or_false] at h
    exact hqy h.symm
  · have h' := parityPhase_wires a b q h
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
    rcases h' with rfl | rfl | rfl
    · exact hys.1 rfl
    · exact hys.2.1 rfl
    · exact hqy rfl
  · simp only [circuitWires, List.flatMap_cons, List.flatMap_nil, List.append_nil, gateWires,
      List.cons_append, List.nil_append, List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with rfl | rfl <;> exact hqy rfl
  · simp only [circuitWires, List.flatMap_cons, List.flatMap_nil, List.append_nil, gateWires,
      List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with rfl | rfl
    · exact hqy rfl
    · exact hys.2.2 rfl

private theorem ccx_step_false (q y a b t : Wire) (hwg : a ≠ b ∧ a ≠ t ∧ b ≠ t)
    (hqs : q ≠ a ∧ q ≠ b ∧ q ≠ t) (hys : y ≠ a ∧ y ≠ b ∧ y ≠ t) (hqy : q ≠ y)
    (psi : State) (hpsi : SupportedOn (fun s => s q = false ∧ s y = false) psi) :
    xResetKraus q false (Quantum.run (compileCircuit y (andCompute a b q ++ [.CX q t])) (Prep y psi)) =
      (((Real.sqrt 2)⁻¹ : ℝ) : ℂ) • Prep y (applyGate (.CCX a b t) psi) := by
  have hy_pre := andCompute_cx_wires_not_mem q y a b t hys hqy
  have htb := AndGadget.toffoliBranch_supported a b t q false hwg.1 hqs.1.symm hqs.2.1.symm
    hwg.2.1 hwg.2.2 hqs.2.2 psi (fun s hs => (hpsi s hs).1)
  rw [AndGadget.toffoliBranch, LinearMap.comp_apply, LinearMap.comp_apply,
    if_neg Bool.false_ne_true, Quantum.run_nil] at htb
  rw [compileCircuit_prep y _ hy_pre psi (fun s hs => (hpsi s hs).2),
    Catalyst.prepare_reset y q hqy.symm false, htb, map_smul]

private theorem ccx_step_true (q y a b t : Wire) (hwg : a ≠ b ∧ a ≠ t ∧ b ≠ t)
    (hqs : q ≠ a ∧ q ≠ b ∧ q ≠ t) (hys : y ≠ a ∧ y ≠ b ∧ y ≠ t) (hqy : q ≠ y)
    (psi : State) (hpsi : SupportedOn (fun s => s q = false ∧ s y = false) psi) :
    Quantum.run (controlledZ a b)
        (xResetKraus q true (Quantum.run (compileCircuit y (andCompute a b q ++ [.CX q t])) (Prep y psi))) =
      (((Real.sqrt 2)⁻¹ : ℝ) : ℂ) • Prep y (applyGate (.CCX a b t) psi) := by
  have hy_pre := andCompute_cx_wires_not_mem q y a b t hys hqy
  have hcz : y ∉ circuitWires (controlledZ a b) := by
    simp only [controlledZ, circuitWires, List.flatMap_cons, List.flatMap_nil, List.cons_append,
      List.nil_append, List.append_nil, gateWires, List.mem_cons, List.not_mem_nil, or_false, not_or]
    exact ⟨hys.2.1, hys.1, hys.2.1, hys.2.1⟩
  have htb := AndGadget.toffoliBranch_supported a b t q true hwg.1 hqs.1.symm hqs.2.1.symm
    hwg.2.1 hwg.2.2 hqs.2.2 psi (fun s hs => (hpsi s hs).1)
  rw [AndGadget.toffoliBranch, LinearMap.comp_apply, LinearMap.comp_apply, if_pos rfl] at htb
  rw [compileCircuit_prep y _ hy_pre psi (fun s hs => (hpsi s hs).2),
    Catalyst.prepare_reset y q hqy.symm true, prep_circuit y (controlledZ a b) hcz, htb, map_smul]

private theorem ccx_lift_false (q y a b t : Wire) (hwg : a ≠ b ∧ a ≠ t ∧ b ≠ t)
    (hqg : q ∉ gateWires (.CCX a b t)) (hyg : y ∉ gateWires (.CCX a b t))
    (hqs : q ≠ a ∧ q ≠ b ∧ q ≠ t) (hys : y ≠ a ∧ y ≠ b ∧ y ≠ t) (hqy : q ≠ y)
    (br' br : InstrumentBranch) (α : ℂ) (hlift : BranchLift q y br' br α) :
    BranchLift q y
      (preBranch (some false) ((xResetKraus q false).comp (Quantum.run (compileCircuit y (andCompute a b q ++ [.CX q t])))) br')
      (preBranch none (Quantum.run ([.CCX a b t])) br)
      ((((Real.sqrt 2)⁻¹ : ℝ) : ℂ) * α) := by
  intro psi hpsi
  dsimp only [preBranch]
  rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply,
    ccx_step_false q y a b t hwg hqs hys hqy psi hpsi, map_smul,
    hlift _ (gate_frame_pair q y (.CCX a b t) hqg hyg psi hpsi), smul_smul, Quantum.run_singleton]

private theorem ccx_lift_true (q y a b t : Wire) (hwg : a ≠ b ∧ a ≠ t ∧ b ≠ t)
    (hqg : q ∉ gateWires (.CCX a b t)) (hyg : y ∉ gateWires (.CCX a b t))
    (hqs : q ≠ a ∧ q ≠ b ∧ q ≠ t) (hys : y ≠ a ∧ y ≠ b ∧ y ≠ t) (hqy : q ≠ y)
    (br' br : InstrumentBranch) (α : ℂ) (hlift : BranchLift q y br' br α) :
    BranchLift q y
      (preBranch (some true) (((Quantum.run (controlledZ a b)).comp (xResetKraus q true)).comp
        (Quantum.run (compileCircuit y (andCompute a b q ++ [.CX q t])))) br')
      (preBranch none (Quantum.run ([.CCX a b t])) br)
      ((((Real.sqrt 2)⁻¹ : ℝ) : ℂ) * α) := by
  intro psi hpsi
  dsimp only [preBranch]
  rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply,
    ccx_step_true q y a b t hwg hqs hys hqy psi hpsi, map_smul,
    hlift _ (gate_frame_pair q y (.CCX a b t) hqg hyg psi hpsi), smul_smul, Quantum.run_singleton]

/-- Master lifting theorem: `compileLower q y p` lifts EVERY `Forall₂ P` alignment on `p`
to a matching `Forall₂` alignment preserving `|S⟩` on `y` and total Born mass! -/
theorem compileLower_lift_raw {n oldStart oldFinish : Nat} (q y : Wire)
    (p : Straight n oldStart oldFinish) (start : Nat) (records : Fin oldStart → Fin start)
    (read : ConstantBit n → Bool) (h : Fin oldStart → Bool) (h' : Fin start → Bool)
    (hmap : ∀ i, h' (records i) = h i)
    (hwf : p.WellFormed) (hq : Fresh q p) (hy : Fresh y p) (hqy : q ≠ y)
    (P : InstrumentBranch → ℂ → Prop) (cs : List ℂ)
    (hal : List.Forall₂ P (p.instantiate read h).run cs) :
    ∃ cs' : List ℂ,
      List.Forall₂ (fun b' c' => ∃ b c α, P b c ∧ c' = α * c ∧ BranchLift q y b' b α)
        ((compileLower q y p start records).program.instantiate read h').run cs' ∧
      (cs'.map Complex.normSq).sum = (cs.map Complex.normSq).sum := by
  induction p generalizing start h' P cs with
  | done =>
    cases hal with
    | cons h0 hnil =>
      cases hnil
      rename_i c0
      refine ⟨[c0], .cons ⟨⟨[], LinearMap.id⟩, c0, 1, h0, (one_mul c0).symm, ?_⟩ .nil, rfl⟩
      intro psi _; simp [LinearMap.id_coe]
  | gate g next ih =>
    cases g with
    | literal g =>
      have stepNonCCX
          (hrun_eq :
            ((compileLower q y (.gate (.literal g) next) start records).program.instantiate read h').run =
              ((compileLower q y next start records).program.instantiate read h').run.map
                (preBranch none (Quantum.run (ConditionalCatalyst.replacement y g)))) :
          ∃ cs' : List ℂ,
            List.Forall₂ (fun b' c' => ∃ b c α, P b c ∧ c' = α * c ∧ BranchLift q y b' b α)
              ((compileLower q y (.gate (.literal g) next) start records).program.instantiate read h').run cs' ∧
            (cs'.map Complex.normSq).sum = (cs.map Complex.normSq).sum := by
        change List.Forall₂ P ((next.instantiate read h).run.map (preBranch none (Quantum.run ([g])))) cs at hal
        rw [forall₂_map_left] at hal
        obtain ⟨cs', hal', hm'⟩ := ih start records h h' hmap hwf.2 hq.2 hy.2
          (fun br c => P (preBranch none (Quantum.run ([g])) br) c) cs hal
        refine ⟨cs', ?_, hm'⟩
        rw [hrun_eq, forall₂_map_left]
        refine List.Forall₂.imp ?_ hal'
        intro br' c' ⟨br, c, α, hp', hc', hlift⟩
        refine ⟨preBranch none (Quantum.run ([g])) br, c, α, hp', hc', ?_⟩
        intro psi hpsi
        dsimp only [preBranch]
        rw [LinearMap.comp_apply, LinearMap.comp_apply,
          ConditionalCatalyst.replacement_correct y g hy.1 psi (fun s hs => (hpsi s hs).2),
          hlift _ (gate_frame_pair q y g hq.1 hy.1 psi hpsi), Quantum.run_singleton]
      cases g with
      | CCX a b t =>
        obtain ⟨hqg, hqnext⟩ := hq
        obtain ⟨hyg, hynext⟩ := hy
        have hqs : q ≠ a ∧ q ≠ b ∧ q ≠ t := by simpa [gateWires] using hqg
        have hys : y ≠ a ∧ y ≠ b ∧ y ≠ t := by simpa [gateWires] using hyg
        have hwg : a ≠ b ∧ a ≠ t ∧ b ≠ t := hwf.1
        change List.Forall₂ P ((next.instantiate read h).run.map (preBranch none (Quantum.run ([.CCX a b t])))) cs at hal
        rw [forall₂_map_left] at hal
        let h0' : Fin (start + 1) → Bool := Fin.lastCases (motive := fun _ => Bool) false h'
        let h1' : Fin (start + 1) → Bool := Fin.lastCases (motive := fun _ => Bool) true h'
        have hmap0 : ∀ i, h0' ((records i).castSucc) = h i := fun i => by
          simp [h0', Fin.lastCases_castSucc, hmap i]
        have hmap1 : ∀ i, h1' ((records i).castSucc) = h i := fun i => by
          simp [h1', Fin.lastCases_castSucc, hmap i]
        obtain ⟨cs0, hal0, hm0⟩ := ih (start + 1) (fun i => (records i).castSucc) h h0'
          hmap0 hwf.2 hqnext hynext (fun br c => P (preBranch none (Quantum.run ([.CCX a b t])) br) c) cs hal
        obtain ⟨cs1, hal1, hm1⟩ := ih (start + 1) (fun i => (records i).castSucc) h h1'
          hmap1 hwf.2 hqnext hynext (fun br c => P (preBranch none (Quantum.run ([.CCX a b t])) br) c) cs hal
        let r := AndGadget.lower q next (start + 1) (fun i => (records i).castSucc)
        let preC : Circuit := andCompute a b q ++ [.CX q t]
        have hrun_eq :
            ((compileLower q y (.gate (.literal (.CCX a b t)) next) start records).program.instantiate read h').run =
              ((((ConditionalCatalyst.compile y r.program).instantiate read h0').run.map
                  (preBranch (some false) ((xResetKraus q false).comp (Quantum.run (compileCircuit y preC))))) ++
               (((ConditionalCatalyst.compile y r.program).instantiate read h1').run.map
                  (preBranch (some true) (((Quantum.run (controlledZ a b)).comp (xResetKraus q true)).comp
                    (Quantum.run (compileCircuit y preC)))))) := by
          have hc : (compileLower q y (.gate (.literal (.CCX a b t)) next) start records).program =
              AndGadget.literals (compileCircuit y preC)
                (.measure q
                  (.recordGate (Fin.last start) true (.H b)
                    (.recordGate (Fin.last start) true (.CX a b)
                      (.recordGate (Fin.last start) true (.H b)
                        (ConditionalCatalyst.compile y r.program))))) := by
            simp only [compileLower, AndGadget.lower, AndGadget.toffoliPrefix, preC, r]
            rw [compile_literals]
            rfl
          rw [hc, literals_instantiate_run]
          simp only [Straight.instantiate, Fin.lastCases_last, Bool.false_eq_true, if_false, if_true]
          let B0 := ((ConditionalCatalyst.compile y r.program).instantiate read h0').run
          let B1 := ((ConditionalCatalyst.compile y r.program).instantiate read h1').run
          change ((((B0.map (preBranch none (Quantum.run ([] : Circuit)))).map
              (preBranch none (Quantum.run ([] : Circuit)))).map
              (preBranch none (Quantum.run ([] : Circuit)))).map
              (preBranch (some false) (xResetKraus q false)) ++
            (((B1.map (preBranch none (Quantum.run ([.H b])))).map
              (preBranch none (Quantum.run ([.CX a b])))).map
              (preBranch none (Quantum.run ([.H b])))).map
              (preBranch (some true) (xResetKraus q true))).map
              (preBranch none (Quantum.run (compileCircuit y preC))) = _
          rw [List.map_append]
          congr 1
          · simp only [List.map_map]
            apply List.map_congr_left
            intro br _; cases br with
            | mk hist k =>
              simp only [Function.comp_def, preBranch, Option.toList_none, Option.toList_some,
                List.nil_append, List.cons_append, InstrumentBranch.mk.injEq, true_and]
              apply LinearMap.ext; intro psi
              simp only [LinearMap.comp_apply, Quantum.run_nil]
          · simp only [List.map_map]
            apply List.map_congr_left
            intro br _; cases br with
            | mk hist k =>
              simp only [Function.comp_def, preBranch, Option.toList_none, Option.toList_some,
                List.nil_append, List.cons_append, InstrumentBranch.mk.injEq, true_and]
              apply LinearMap.ext; intro psi
              simp only [LinearMap.comp_apply, controlledZ, Quantum.run_cons, Quantum.run_singleton, Quantum.run_nil]
        let s2 : ℂ := (((Real.sqrt 2)⁻¹ : ℝ) : ℂ)
        refine ⟨cs0.map (s2 * ·) ++ cs1.map (s2 * ·), ?_, ?_⟩
        · rw [hrun_eq]
          apply WEX.simulationAligned_append
          · rw [forall₂_map_left, forall₂_map_right]
            refine List.Forall₂.imp ?_ hal0
            intro br' c0' ⟨br, c, α, hp0, hc0, hlift⟩
            refine ⟨preBranch none (Quantum.run ([.CCX a b t])) br, c, s2 * α, hp0, by rw [hc0]; ring, ?_⟩
            exact ccx_lift_false q y a b t hwg hqg hyg hqs hys hqy br' br α hlift
          · rw [forall₂_map_left, forall₂_map_right]
            refine List.Forall₂.imp ?_ hal1
            intro br' c1' ⟨br, c, α, hp1, hc1, hlift⟩
            refine ⟨preBranch none (Quantum.run ([.CCX a b t])) br, c, s2 * α, hp1, by rw [hc1]; ring, ?_⟩
            exact ccx_lift_true q y a b t hwg hqg hyg hqs hys hqy br' br α hlift
        · rw [List.map_append, List.sum_append, map_normSq_scale, map_normSq_scale,
            normSq_invSqrt2, hm0, hm1]
          ring
      | X t =>
        exact stepNonCCX (by
          simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
          exact literals_instantiate_run read _ _ h')
      | H t =>
        exact stepNonCCX (by
          simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
          exact literals_instantiate_run read _ _ h')
      | CX a t =>
        exact stepNonCCX (by
          simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
          exact literals_instantiate_run read _ _ h')
      | P dir k t =>
        exact stepNonCCX (by
          simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
          exact literals_instantiate_run read _ _ h')
    | whenBit r v g =>
      change List.Forall₂ P ((next.instantiate read h).run.map
        (preBranch none (Quantum.run (if read r = v then [g] else [])))) cs at hal
      rw [forall₂_map_left] at hal
      obtain ⟨cs', hal', hm'⟩ := ih start records h h' hmap hwf.2 hq.2 hy.2
        (fun br c => P (preBranch none (Quantum.run (if read r = v then [g] else [])) br) c) cs hal
      refine ⟨cs', ?_, hm'⟩
      have hrun_eq :
          ((compileLower q y (.gate (.whenBit r v g) next) start records).program.instantiate read h').run =
            ((compileLower q y next start records).program.instantiate read h').run.map
              (preBranch none (if read r = v then Quantum.run (ConditionalCatalyst.replacement y g) else LinearMap.id)) := by
        simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
        exact whenLiterals_instantiate_run read r v _ _ h'
      rw [hrun_eq, forall₂_map_left]
      refine List.Forall₂.imp ?_ hal'
      intro br' c' ⟨br, c, α, hp', hc', hlift⟩
      refine ⟨preBranch none (Quantum.run (if read r = v then [g] else [])) br, c, α, hp', hc', ?_⟩
      intro psi hpsi
      by_cases hrv : read r = v
      · simp only [preBranch, hrv, if_true, LinearMap.comp_apply, Quantum.run_singleton]
        rw [ConditionalCatalyst.replacement_correct y g hy.1 psi (fun s hs => (hpsi s hs).2)]
        exact hlift _ (gate_frame_pair q y g hq.1 hy.1 psi hpsi)
      · simp only [preBranch, hrv, if_false, LinearMap.comp_apply, LinearMap.id_coe, id_eq, Quantum.run_nil]
        exact hlift psi hpsi
  | recordGate i v g next ih =>
    change List.Forall₂ P ((next.instantiate read h).run.map
      (preBranch none (Quantum.run (if h i = v then [g] else [])))) cs at hal
    rw [forall₂_map_left] at hal
    obtain ⟨cs', hal', hm'⟩ := ih start records h h' hmap hwf.2 hq.2 hy.2
      (fun br c => P (preBranch none (Quantum.run (if h i = v then [g] else [])) br) c) cs hal
    refine ⟨cs', ?_, hm'⟩
    have hrun_eq :
        ((compileLower q y (.recordGate i v g next) start records).program.instantiate read h').run =
          ((compileLower q y next start records).program.instantiate read h').run.map
            (preBranch none (if h' (records i) = v then Quantum.run (ConditionalCatalyst.replacement y g) else LinearMap.id)) := by
      simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
      exact recordLiterals_instantiate_run read (records i) v _ _ h'
    rw [hrun_eq, hmap i, forall₂_map_left]
    refine List.Forall₂.imp ?_ hal'
    intro br' c' ⟨br, c, α, hp', hc', hlift⟩
    refine ⟨preBranch none (Quantum.run (if h i = v then [g] else [])) br, c, α, hp', hc', ?_⟩
    intro psi hpsi
    by_cases hiv : h i = v
    · simp only [preBranch, hiv, if_true, LinearMap.comp_apply, Quantum.run_singleton]
      rw [ConditionalCatalyst.replacement_correct y g hy.1 psi (fun s hs => (hpsi s hs).2)]
      exact hlift _ (gate_frame_pair q y g hq.1 hy.1 psi hpsi)
    · simp only [preBranch, hiv, if_false, LinearMap.comp_apply, LinearMap.id_coe, id_eq, Quantum.run_nil]
      exact hlift psi hpsi
  | measure w next ih =>
    let hm0 : Fin _ → Bool := Fin.lastCases (motive := fun _ => Bool) false h
    let hm1 : Fin _ → Bool := Fin.lastCases (motive := fun _ => Bool) true h
    let hm0' : Fin (start + 1) → Bool := Fin.lastCases (motive := fun _ => Bool) false h'
    let hm1' : Fin (start + 1) → Bool := Fin.lastCases (motive := fun _ => Bool) true h'
    let rec' : Fin _ → Fin (start + 1) :=
      Fin.lastCases (motive := fun _ => Fin (start + 1)) (Fin.last start) (fun j => (records j).castSucc)
    change List.Forall₂ P
      ((next.instantiate read hm0).run.map (preBranch (some false) (xResetKraus w false)) ++
       (next.instantiate read hm1).run.map (preBranch (some true) (xResetKraus w true))) cs at hal
    obtain ⟨cs0, cs1, rfl, hal0, hal1⟩ := forall₂_append_split hal
    rw [forall₂_map_left] at hal0 hal1
    have hmap_ext (o : Bool) : ∀ i,
        (Fin.lastCases (motive := fun _ => Bool) o h') (rec' i) =
          Fin.lastCases (motive := fun _ => Bool) o h i := fun i =>
      Fin.lastCases (by simp [rec']) (fun j => by simp [rec', hmap j]) i
    obtain ⟨cs0', hal0', hmass0'⟩ := ih (start + 1) rec' hm0 hm0' (hmap_ext false) hwf hq.2 hy.2
      (fun br c => P (preBranch (some false) (xResetKraus w false) br) c) cs0 hal0
    obtain ⟨cs1', hal1', hmass1'⟩ := ih (start + 1) rec' hm1 hm1' (hmap_ext true) hwf hq.2 hy.2
      (fun br c => P (preBranch (some true) (xResetKraus w true) br) c) cs1 hal1
    refine ⟨cs0' ++ cs1', ?_, by rw [List.map_append, List.sum_append, hmass0', hmass1', List.map_append, List.sum_append]⟩
    change List.Forall₂ _
      (((compileLower q y next (start + 1) rec').program.instantiate read hm0').run.map
          (preBranch (some false) (xResetKraus w false)) ++
       ((compileLower q y next (start + 1) rec').program.instantiate read hm1').run.map
          (preBranch (some true) (xResetKraus w true))) (cs0' ++ cs1')
    apply WEX.simulationAligned_append
    · rw [forall₂_map_left]
      refine List.Forall₂.imp ?_ hal0'
      intro br' c' ⟨br, c, α, hp', hc', hlift⟩
      refine ⟨preBranch (some false) (xResetKraus w false) br, c, α, hp', hc', ?_⟩
      intro psi hpsi
      dsimp only [preBranch]
      rw [LinearMap.comp_apply, LinearMap.comp_apply,
        Catalyst.prepare_reset y w hy.1 false psi, hlift _ (reset_frame_pair q y w hq.1 hy.1 false psi hpsi)]
    · rw [forall₂_map_left]
      refine List.Forall₂.imp ?_ hal1'
      intro br' c' ⟨br, c, α, hp', hc', hlift⟩
      refine ⟨preBranch (some true) (xResetKraus w true) br, c, α, hp', hc', ?_⟩
      intro psi hpsi
      dsimp only [preBranch]
      rw [LinearMap.comp_apply, LinearMap.comp_apply,
        Catalyst.prepare_reset y w hy.1 true psi, hlift _ (reset_frame_pair q y w hq.1 hy.1 true psi hpsi)]

/-! #### Static properties of `compileLower` -/

theorem fresh_of_not_mem_straightWires {n s e : Nat} (w : Wire) (p : Straight n s e)
    (h : w ∉ ChallengeMigration.straightWires p) : Fresh w p := by
  induction p with
  | done => trivial
  | gate g p ih =>
    cases g with
    | literal g =>
      simp only [ChallengeMigration.straightWires, templateGateWires, List.mem_append, not_or] at h
      exact ⟨h.1, ih h.2⟩
    | whenBit r v g =>
      simp only [ChallengeMigration.straightWires, templateGateWires, List.mem_append, not_or] at h
      exact ⟨h.1, ih h.2⟩
  | recordGate i v g p ih =>
    simp only [ChallengeMigration.straightWires, List.mem_append, not_or] at h
    exact ⟨h.1, ih h.2⟩
  | measure t p ih =>
    simp only [ChallengeMigration.straightWires, List.mem_cons, not_or] at h
    exact ⟨h.1, ih h.2⟩

theorem within_of_straightWires {n s e : Nat} (ws : List Wire) (p : Straight n s e)
    (h : ChallengeMigration.straightWires p ⊆ ws) : Within ws p := by
  induction p with
  | done => trivial
  | gate g p ih =>
    cases g with
    | literal g =>
      simp only [ChallengeMigration.straightWires, templateGateWires, List.append_subset] at h
      exact ⟨h.1, ih h.2⟩
    | whenBit r v g =>
      simp only [ChallengeMigration.straightWires, templateGateWires, List.append_subset] at h
      exact ⟨h.1, ih h.2⟩
  | recordGate i v g p ih =>
    simp only [ChallengeMigration.straightWires, List.append_subset] at h
    exact ⟨h.1, ih h.2⟩
  | measure t p ih =>
    simp only [ChallengeMigration.straightWires, List.cons_subset] at h
    exact ⟨h.1, ih h.2⟩

theorem straightWires_of_within {n s e : Nat} (ws : List Wire) (p : Straight n s e)
    (h : Within ws p) : ChallengeMigration.straightWires p ⊆ ws := by
  induction p with
  | done => exact List.nil_subset _
  | gate g p ih =>
    cases g with
    | literal g =>
      simp only [ChallengeMigration.straightWires, templateGateWires, List.append_subset]
      exact ⟨h.1, ih h.2⟩
    | whenBit r v g =>
      simp only [ChallengeMigration.straightWires, templateGateWires, List.append_subset]
      exact ⟨h.1, ih h.2⟩
  | recordGate i v g p ih =>
    simp only [ChallengeMigration.straightWires, List.append_subset]
    exact ⟨h.1, ih h.2⟩
  | measure t p ih =>
    simp only [ChallengeMigration.straightWires, List.cons_subset]
    exact ⟨h.1, ih h.2⟩

theorem compileLower_finish {n s e : Nat} (q y : Wire) (p : Straight n s e)
    (start : Nat) (records : Fin s → Fin start) :
    (compileLower q y p start records).finish + s = start + e + AndGadget.added p :=
  AndGadget.lower_finish q p start records

theorem compileLower_wellFormed {n s e : Nat} (q y : Wire) (p : Straight n s e)
    (start : Nat) (records : Fin s → Fin start)
    (hq : Fresh q p) (hy : Fresh y p) (hqy : q ≠ y) (hp : p.WellFormed) :
    (compileLower q y p start records).program.WellFormed := by
  apply ConditionalCatalyst.compile_wellFormed y _ _ (AndGadget.lower_wellFormed q p start records hq hp)
  have hsub : ChallengeMigration.straightWires (AndGadget.lower q p start records).program ⊆
      q :: ChallengeMigration.straightWires p :=
    straightWires_of_within _ _ (AndGadget.lower_within q p _ (within_of_straightWires _ p (List.Subset.refl _)) start records)
  apply fresh_of_not_mem_straightWires
  intro hm
  have hm' := hsub hm
  simp only [List.mem_cons] at hm'
  rcases hm' with rfl | hm'
  · exact hqy rfl
  · exact (fresh_of_not_mem_straightWires_iff y p).mp hy hm'
where
  fresh_of_not_mem_straightWires_iff {n s e : Nat} (w : Wire) (p : Straight n s e) :
      Fresh w p ↔ w ∉ ChallengeMigration.straightWires p := by
    induction p with
    | done => simp [Fresh, ChallengeMigration.straightWires]
    | gate g p ih =>
      cases g <;> simp [Fresh, ChallengeMigration.straightWires, templateGateWires, ih]
    | recordGate i v g p ih =>
      simp [Fresh, ChallengeMigration.straightWires, ih]
    | measure t p ih =>
      simp [Fresh, ChallengeMigration.straightWires, ih]

theorem compileLower_within {n s e : Nat} (q y : Wire) (p : Straight n s e)
    (ws : List Wire) (hp : Within ws p) (start : Nat) (records : Fin s → Fin start) :
    Within (y :: q :: ws) (compileLower q y p start records).program :=
  ConditionalCatalyst.compile_within y _ (q :: ws) (AndGadget.lower_within q p ws hp start records)

theorem compileLower_straightWires {n s e : Nat} (q y : Wire) (p : Straight n s e)
    (ws : List Wire) (hp : ChallengeMigration.straightWires p ⊆ ws)
    (hq : q ∈ ws) (hy : y ∈ ws) (start : Nat) (records : Fin s → Fin start) :
    ChallengeMigration.straightWires (compileLower q y p start records).program ⊆ ws := by
  have h := straightWires_of_within _ _ (compileLower_within q y p ws (within_of_straightWires ws p hp) start records)
  intro w hw
  have hm := h hw
  simp only [List.mem_cons] at hm
  rcases hm with rfl | rfl | hm
  · exact hy
  · exact hq
  · exact hm

theorem compileLower_tCount {n s e : Nat} (q y : Wire) (p : Straight n s e)
    (start : Nat) (records : Fin s → Fin start)
    (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compileLower q y p start records).program.instantiate read h).tCount ≤ ConditionalCatalyst.weight4 p := by
  have h1 := ConditionalCatalyst.compile_t y (AndGadget.lower q p start records).program read h
  rwa [ConditionalCatalyst.weight7_lower] at h1

theorem compileLower_slots {n s e : Nat} (q y : Wire) (p : Straight n s e)
    (start : Nat) (records : Fin s → Fin start) :
    (compileLower q y p start records).program.gateSlots ≤ 4 * (p.gateSlots + 18 * AndGadget.added p) := by
  have h1 := ConditionalCatalyst.compile_slots y (AndGadget.lower q p start records).program
  have h2 := ConditionalCatalyst.phaseTwos_le_slots (AndGadget.lower q p start records).program
  have h3 := AndGadget.lower_slots q p start records
  change (ConditionalCatalyst.compile y (AndGadget.lower q p start records).program).gateSlots ≤ _
  omega

theorem removed_literals {n s e : Nat} (cutoff : Nat) (gs : Circuit) (p : Straight n s e) :
    removed cutoff (AndGadget.literals gs p) = (gs.map (fun g => (largePhase cutoff g).toNat)).sum + removed cutoff p := by
  induction gs with
  | nil => simp [AndGadget.literals]
  | cons g gs ih =>
    simp only [AndGadget.literals] at ih ⊢
    simp [List.foldr_cons, removed, ih, Nat.add_assoc]

theorem removed_whenLiterals {n s e : Nat} (cutoff : Nat) (r : ConstantBit n) (v : Bool)
    (gs : Circuit) (p : Straight n s e) :
    removed cutoff (ConditionalCatalyst.whenLiterals r v gs p) =
      (gs.map (fun g => (largePhase cutoff g).toNat)).sum + removed cutoff p := by
  induction gs with
  | nil => simp [ConditionalCatalyst.whenLiterals]
  | cons g gs ih => simp [ConditionalCatalyst.whenLiterals, removed, ih, Nat.add_assoc]

theorem removed_recordLiterals {n s e : Nat} (cutoff : Nat) (i : Fin s) (v : Bool)
    (gs : Circuit) (p : Straight n s e) :
    removed cutoff (ConditionalCatalyst.recordLiterals i v gs p) =
      (gs.map (fun g => (largePhase cutoff g).toNat)).sum + removed cutoff p := by
  induction gs with
  | nil => simp [ConditionalCatalyst.recordLiterals]
  | cons g gs ih => simp [ConditionalCatalyst.recordLiterals, removed, ih, Nat.add_assoc]

theorem removed_replacement (cutoff : Nat) (hc : 2 ≤ cutoff) (y : Wire) (g : Gate) :
    ((ConditionalCatalyst.replacement y g).map (fun x => (largePhase cutoff x).toNat)).sum =
      (largePhase cutoff g).toNat := by
  cases g with
  | X _ | H _ | CX _ _ | CCX _ _ _ => rfl
  | P dir k t =>
    by_cases hk : k = 2
    · subst k
      have hlt : ¬(cutoff < 2) := by omega
      cases dir <;> simp [ConditionalCatalyst.replacement, ConditionalCatalyst.inverseKick,
        Catalyst.kick, controlledZ, Circuit.adjoint, largePhase, hlt]
    · unfold ConditionalCatalyst.replacement
      split <;> simp_all [largePhase]

theorem removed_compile {n s e : Nat} (cutoff : Nat) (hc : 2 ≤ cutoff) (y : Wire) (p : Straight n s e) :
    removed cutoff (ConditionalCatalyst.compile y p) = removed cutoff p := by
  induction p with
  | done => rfl
  | gate g p ih =>
    cases g with
    | literal g =>
      simp only [ConditionalCatalyst.compile, removed_literals, removed_replacement cutoff hc y g, removed, ih]
    | whenBit r v g =>
      simp only [ConditionalCatalyst.compile, removed_whenLiterals, removed_replacement cutoff hc y g, removed, ih]
  | recordGate i v g p ih =>
    simp only [ConditionalCatalyst.compile, removed_recordLiterals, removed_replacement cutoff hc y g, removed, ih]
  | measure w p ih =>
    simp only [ConditionalCatalyst.compile, removed, ih]

theorem removed_lower {n s e : Nat} (cutoff : Nat) (hc : 3 ≤ cutoff) (q : Wire) (p : Straight n s e)
    (start : Nat) (records : Fin s → Fin start) :
    removed cutoff (AndGadget.lower q p start records).program = removed cutoff p := by
  induction p generalizing start with
  | done => rfl
  | gate g p ih =>
    cases g with
    | literal g =>
      cases g with
      | CCX a b t =>
        have h3 : ¬(cutoff < 3) := by omega
        have h2 : ¬(cutoff < 2) := by omega
        simp only [AndGadget.lower, AndGadget.toffoliPrefix, removed_literals, removed,
          andCompute, parityPhase, xorPhase, largePhase, h3, h2, decide_false, Bool.toNat_false,
          List.map_append, List.map_cons, List.map_nil, List.sum_append, List.sum_cons, List.sum_nil,
          Nat.zero_add, Nat.add_zero]
        exact ih _ _
      | X _ | H _ | CX _ _ | P _ _ _ => simp only [AndGadget.lower, removed, ih]
    | whenBit r v g => simp only [AndGadget.lower, removed, ih]
  | recordGate i v g p ih => simp only [AndGadget.lower, removed, ih]
  | measure w p ih => simp only [AndGadget.lower, removed, ih]

theorem compileLower_removed18 {n s e : Nat} (q y : Wire) (p : Straight n s e)
    (start : Nat) (records : Fin s → Fin start) :
    removed 18 (compileLower q y p start records).program = removed 18 p := by
  rw [compileLower, removed_compile 18 (by decide), removed_lower 18 (by decide)]

theorem removed18_zero_of_residue {n s e : Nat} (p : Straight n s e) (hz : AndGadget.residue p = 0) :
    removed 18 p = 0 := by
  induction p with
  | done => rfl
  | gate g p ih =>
    cases g with
    | literal g =>
      simp only [AndGadget.residue] at hz
      have h1 : primitivePhaseCost g = 0 := by omega
      have h2 : largePhase 18 g = false := by
        cases g with
        | P dir k t =>
          simp only [primitivePhaseCost, tCost] at h1
          have : k < 2 := by by_contra hc; simp [show 2 ≤ k by omega] at h1
          simp [largePhase, show ¬(18 < k) by omega]
        | _ => rfl
      simp only [removed, h2, Bool.toNat_false, Nat.zero_add]
      exact ih (by omega)
    | whenBit r v g =>
      simp only [AndGadget.residue] at hz
      have h1 : tCost g = 0 := by omega
      have h2 : largePhase 18 g = false := by
        cases g with
        | P dir k t =>
          simp only [tCost] at h1
          have : k < 2 := by by_contra hc; simp [show 2 ≤ k by omega] at h1
          simp [largePhase, show ¬(18 < k) by omega]
        | _ => rfl
      simp only [removed, h2, Bool.toNat_false, Nat.zero_add]
      exact ih (by omega)
  | recordGate i v g p ih =>
    simp only [AndGadget.residue] at hz
    have h1 : tCost g = 0 := by omega
    have h2 : largePhase 18 g = false := by
      cases g with
      | P dir k t =>
        simp only [tCost] at h1
        have : k < 2 := by by_contra hc; simp [show 2 ≤ k by omega] at h1
        simp [largePhase, show ¬(18 < k) by omega]
      | _ => rfl
    simp only [removed, h2, Bool.toNat_false, Nat.zero_add]
    exact ih (by omega)
  | measure w p ih => exact ih hz

theorem removed_append {n s m e : Nat} (cutoff : Nat) (p : Straight n s m) (q : Straight n m e) :
    removed cutoff (p.append q) = removed cutoff p + removed cutoff q := by
  induction p with
  | done => simp [Straight.append, removed]
  | gate g p ih => cases g <;> simp [Straight.append, removed, ih, Nat.add_assoc]
  | recordGate i v g p ih => simp [Straight.append, removed, ih, Nat.add_assoc]
  | measure w p ih => simp [Straight.append, removed, ih]

theorem removed_castFinish {n s e f : Nat} (cutoff : Nat) (h : e = f) (p : Straight n s e) :
    removed cutoff (castFinish h p) = removed cutoff p := by subst h; rfl

theorem removed_relabel {n s e : Nat} (cutoff : Nat) (f : Wire ≃ Wire) (p : Straight n s e) :
    removed cutoff (relabelStraight f p) = removed cutoff p := by
  induction p with
  | done => rfl
  | gate g p ih =>
    cases g with
    | literal g => cases g <;> simp [relabelStraight, relabelTemplateGate, Gate.relabel, largePhase, removed, ih]
    | whenBit r v g => cases g <;> simp [relabelStraight, relabelTemplateGate, Gate.relabel, largePhase, removed, ih]
  | recordGate i v g p ih => cases g <;> simp [relabelStraight, Gate.relabel, largePhase, removed, ih]
  | measure w p ih => simp [relabelStraight, removed, ih]

/-! #### `CatCoherent` and `CatLitSim` from `compileLower` and composition -/

theorem compileLower_catCoherent {n oldStart oldFinish : Nat} (q y : Wire)
    (p : Straight n oldStart oldFinish) (start : Nat) (records : Fin oldStart → Fin start)
    (read : ConstantBit n → Bool) (h : Fin oldStart → Bool) (h' : Fin start → Bool)
    (hmap : ∀ i, h' (records i) = h i)
    (hwf : p.WellFormed) (hq : Fresh q p) (hy : Fresh y p) (hqy : q ≠ y)
    (U : State →ₗ[ℂ] State) (V : BasisState → Prop)
    (hclean : ∀ s, V s → s q = false ∧ s y = false)
    (hcoh : CoherentlyImplementsOn (p.instantiate read h) U V) :
    CatCoherent y ((compileLower q y p start records).program.instantiate read h') U V := by
  obtain ⟨cs, hal, hmass⟩ := hcoh
  obtain ⟨cs', hal', hmass'⟩ := compileLower_lift_raw q y p start records read h h' hmap hwf hq hy hqy
    (fun b c => ∀ s, V s → b.kraus (ket s) = c • U (ket s)) cs hal
  refine ⟨cs', ?_, hmass'.trans hmass⟩
  refine List.Forall₂.imp ?_ hal'
  intro b' c' ⟨b, c, α, hb, hc', hlift⟩ s hs
  rw [hlift (ket s) (supportedOn_ket _ _ (hclean s hs)), hb s hs, map_smul, smul_smul, hc']

theorem compileLower_catLitSim {n oldStart oldFinish : Nat} (q y : Wire)
    (p : Straight n oldStart oldFinish) (start : Nat) (records : Fin oldStart → Fin start)
    (read : ConstantBit n → Bool) (h : Fin oldStart → Bool) (h' : Fin start → Bool)
    (hmap : ∀ i, h' (records i) = h i)
    (hwf : p.WellFormed) (hq : Fresh q p) (hy : Fresh y p) (hqy : q ≠ y)
    (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hclean : ∀ s, V s → s q = false ∧ s y = false)
    (hsim : ∃ cs : List ℂ, List.Forall₂
      (fun b c => ∃ m : List Bool, m.length = ECDSAAdd.measurementCount P ∧
        ∀ st : ECDSAAdd.State, V st.basis →
          b.kraus (Bridge.signedKet st) = c • Bridge.signedKet (ECDSAAdd.run P m st))
      (p.instantiate read h).run cs ∧ (cs.map Complex.normSq).sum = 1) :
    CatLitSim y ((compileLower q y p start records).program.instantiate read h') P V := by
  obtain ⟨cs, hal, hmass⟩ := hsim
  obtain ⟨cs', hal', hmass'⟩ := compileLower_lift_raw q y p start records read h h' hmap hwf hq hy hqy
    (fun b c => ∃ m : List Bool, m.length = ECDSAAdd.measurementCount P ∧
      ∀ st : ECDSAAdd.State, V st.basis →
        b.kraus (Bridge.signedKet st) = c • Bridge.signedKet (ECDSAAdd.run P m st)) cs hal
  refine ⟨cs', ?_, hmass'.trans hmass⟩
  refine List.Forall₂.imp ?_ hal'
  intro b' c' ⟨b, c, α, ⟨m, lm, hb⟩, hc', hlift⟩
  refine ⟨m, lm, fun st hst => ?_⟩
  have hsup : SupportedOn (fun s => s q = false ∧ s y = false) (Bridge.signedKet st) := by
    intro s hs
    apply supportedOn_ket (fun s => s q = false ∧ s y = false) st.basis (hclean st.basis hst) s
    simp only [Bridge.signedKet, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul] at hs
    exact right_ne_zero_of_mul hs
  rw [hlift _ hsup, hb st hst, map_smul, smul_smul, hc']

theorem catCoherent_seq {y : Wire} {C₁ C₂ : AdaptiveCircuit} {U₁ U₂ : State →ₗ[ℂ] State}
    {V₁ V₂ : BasisState → Prop}
    (h1 : CatCoherent y C₁ U₁ V₁) (h2 : CatCoherent y C₂ U₂ V₂)
    (hstep : ∀ s, V₁ s → SupportedOn V₂ (U₁ (ket s))) :
    CatCoherent y (C₁.seq C₂) (U₂.comp U₁) V₁ := by
  obtain ⟨c1, a1, m1⟩ := h1
  obtain ⟨c2, a2, m2⟩ := h2
  refine ⟨coherentSeqCoefficients c1 c2, ?_, by rw [WEX.simulationCoefficients_mass, m1, m2]; norm_num⟩
  rw [AdaptiveCircuit.run_seq]
  apply WEX.simulationAligned_seq a1 a2
  intro b1 k1 b2 k2 hb1 hb2 s hs
  change b2.kraus (b1.kraus (Prep y (ket s))) = (k1 * k2) • Prep y (U₂ (U₁ (ket s)))
  rw [hb1 s hs, map_smul]
  have hlin : b2.kraus (Prep y (U₁ (ket s))) = k2 • Prep y (U₂ (U₁ (ket s))) :=
    Catalyst.linear_comp_supported b2.kraus (Prep y) (k2 • Prep y) U₂ V₂
      (fun t ht => by simpa [LinearMap.smul_apply] using hb2 t ht) (U₁ (ket s)) (hstep s hs)
  rw [hlin, smul_smul, mul_comm k1 k2]

theorem catLitSim_seq {y : Wire} {C₁ C₂ : AdaptiveCircuit} {P₁ P₂ : ECDSAAdd.Program}
    {V₁ V₂ : BasisState → Prop}
    (h1 : CatLitSim y C₁ P₁ V₁) (h2 : CatLitSim y C₂ P₂ V₂)
    (hstep : ∀ st m, V₁ st.basis → m.length = ECDSAAdd.measurementCount P₁ → V₂ (ECDSAAdd.run P₁ m st).basis) :
    CatLitSim y (C₁.seq C₂) (P₁ ++ P₂) V₁ := by
  obtain ⟨c1, a1, m1⟩ := h1
  obtain ⟨c2, a2, m2⟩ := h2
  refine ⟨coherentSeqCoefficients c1 c2, ?_, by rw [WEX.simulationCoefficients_mass, m1, m2]; norm_num⟩
  rw [AdaptiveCircuit.run_seq]
  apply WEX.simulationAligned_seq a1 a2
  intro b1 k1 b2 k2 ⟨m₁, lm₁, hb1⟩ ⟨m₂, lm₂, hb2⟩
  refine ⟨m₁ ++ m₂, by rw [List.length_append, ECDSAAdd.measurementCount_append, lm₁, lm₂], fun st hst => ?_⟩
  change b2.kraus (b1.kraus (Prep y (Bridge.signedKet st))) = _
  rw [hb1 st hst, map_smul, hb2 _ (hstep st m₁ hst lm₁), smul_smul,
    WEX.run_append_records P₁ P₂ m₁ m₂ st lm₁, mul_comm k1 k2]

/-! #### Zero-T catalyst move (`swapCircuit`, `flipSwap`) and clean-target 4-T AND / `majorityCat` -/

/-- 3-CNOT wire swap (0 T-gates, 0 measurements) moving `|S⟩` between two clean `|0⟩` wires. -/
def swapCircuit (y₁ y₂ : Wire) : Circuit := [.CX y₁ y₂, .CX y₂ y₁, .CX y₁ y₂]

theorem swapCircuit_wellFormed (y₁ y₂ : Wire) (hne : y₁ ≠ y₂) : CircuitWellFormed (swapCircuit y₁ y₂) := by
  simp [swapCircuit, CircuitWellFormed, Gate.WellFormed, hne, hne.symm]

theorem swapCircuit_tCount (y₁ y₂ : Wire) : ShorECDLP.tCount (swapCircuit y₁ y₂) = 0 := rfl

theorem swapCircuit_length (y₁ y₂ : Wire) : (swapCircuit y₁ y₂).length = 3 := rfl

theorem swapCircuit_wires (y₁ y₂ : Wire) : circuitWires (swapCircuit y₁ y₂) ⊆ [y₁, y₂] := by
  intro w hw; simp [swapCircuit, circuitWires, gateWires] at hw ⊢; tauto

theorem swapCircuit_ket (y₁ y₂ : Wire) (hne : y₁ ≠ y₂) (s : BasisState) :
    Quantum.run (swapCircuit y₁ y₂) (ket s) = ket (s[y₁ ↦ s y₂][y₂ ↦ s y₁]) := by
  have he : s[y₂ ↦ s y₂ ^^ s y₁][y₁ ↦ s y₁ ^^ (s y₂ ^^ s y₁)][y₂ ↦ (s y₂ ^^ s y₁) ^^ (s y₁ ^^ (s y₂ ^^ s y₁))] =
      s[y₁ ↦ s y₂][y₂ ↦ s y₁] := by
    funext w
    by_cases h1 : w = y₁
    · subst h1; simp [upd, hne, Bool.xor_assoc, Bool.xor_left_comm]
    · by_cases h2 : w = y₂
      · subst h2; simp [upd, hne.symm, Bool.xor_assoc, Bool.xor_left_comm]
      · simp [upd, h1, h2]
  simp only [swapCircuit, Quantum.run_cons, Quantum.run_nil, LinearMap.id_coe, id_eq,
    applyGate_CX_ket, upd_same, upd_other _ _ _ hne, upd_other _ _ _ hne.symm, he]

theorem swapCircuit_prep_ket (y₁ y₂ : Wire) (hne : y₁ ≠ y₂) (s : BasisState)
    (h1 : s y₁ = false) (h2 : s y₂ = false) :
    Quantum.run (swapCircuit y₁ y₂) (Prep y₁ (ket s)) = Prep y₂ (ket s) := by
  have h1s : s[y₁ ↦ false] = s := by funext w; by_cases hw : w = y₁ <;> simp [upd, hw, h1]
  have h2s : s[y₂ ↦ false] = s := by funext w; by_cases hw : w = y₂ <;> simp [upd, hw, h2]
  have hsw0 : s[y₁ ↦ s y₂][y₂ ↦ s y₁] = s := by
    funext w; by_cases hw1 : w = y₁
    · subst hw1; simp [upd, hne, h1, h2]
    · by_cases hw2 : w = y₂
      · subst hw2; simp [upd, hne.symm, h1, h2]
      · simp [upd, hw1, hw2]
  have hsw1 : s[y₁ ↦ true][y₁ ↦ s[y₁ ↦ true] y₂][y₂ ↦ true] = s[y₂ ↦ true] := by
    funext w; by_cases hw1 : w = y₁
    · subst hw1; simp [upd, hne, hne.symm, h1, h2]
    · by_cases hw2 : w = y₂
      · subst hw2; simp [upd, hne.symm, h1, h2]
      · simp [upd, hw1, hw2]
  simp only [Prep, Catalyst.prepare, Quantum.run_cons, Quantum.run_nil, LinearMap.id_coe, id_eq,
    applyGate_H_ket, map_smul, map_add, applyGate_P_ket, upd_same, h1, h2, h1s, h2s,
    Bool.false_eq_true, if_false, if_true, one_smul, swapCircuit_ket y₁ y₂ hne, hsw0, hsw1]

theorem swapCircuit_prep (y₁ y₂ : Wire) (hne : y₁ ≠ y₂) (psi : State)
    (hp : SupportedOn (fun s => s y₁ = false ∧ s y₂ = false) psi) :
    Quantum.run (swapCircuit y₁ y₂) (Prep y₁ psi) = Prep y₂ psi :=
  Catalyst.linear_comp_supported (Quantum.run (swapCircuit y₁ y₂)) (Prep y₁) (Prep y₂) LinearMap.id
    (fun s => s y₁ = false ∧ s y₂ = false) (fun s hs => swapCircuit_prep_ket y₁ y₂ hne s hs.1 hs.2) psi hp

/-- Clean-target 4-T AND using catalyst `y` (0 scratch wire, 0 measurements!). -/
def andComputeCat (y a b c : Wire) : Circuit :=
  [.H c] ++ AndGadget.parityPhase a b c ++ [.H c] ++ Catalyst.kick c y

theorem andComputeCat_tCount (y a b c : Wire) : ShorECDLP.tCount (andComputeCat y a b c) = 4 := by
  rw [andComputeCat, ShorECDLP.tCount_append, ShorECDLP.tCount_append, ShorECDLP.tCount_append,
    parityPhase_tCount]
  rfl

theorem andComputeCat_length (y a b c : Wire) : (andComputeCat y a b c).length = 18 := rfl

theorem andComputeCat_wellFormed (y a b c : Wire) (hac : a ≠ c) (hbc : b ≠ c) (hcy : c ≠ y) :
    CircuitWellFormed (andComputeCat y a b c) := by
  rw [andComputeCat, circuitWellFormed_append, circuitWellFormed_append, circuitWellFormed_append]
  refine ⟨⟨⟨by simp [CircuitWellFormed, Gate.WellFormed],
    parityPhase_wellFormed a b c hac hbc⟩,
    by simp [CircuitWellFormed, Gate.WellFormed]⟩,
    by simp [Catalyst.kick, controlledZ, CircuitWellFormed, Gate.WellFormed, hcy]⟩

theorem andComputeCat_wires (y a b c : Wire) : circuitWires (andComputeCat y a b c) ⊆ [y, a, b, c] := by
  intro w hw
  simp only [andComputeCat, circuitWires_append, List.mem_append] at hw
  rcases hw with ((h | h) | h) | h
  · simp only [circuitWires, List.flatMap_cons, List.flatMap_nil, List.append_nil, gateWires,
      List.mem_cons, List.not_mem_nil, or_false] at h
    subst h; simp
  · have h' := parityPhase_wires a b c h
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h' ⊢
    tauto
  · simp only [circuitWires, List.flatMap_cons, List.flatMap_nil, List.append_nil, gateWires,
      List.mem_cons, List.not_mem_nil, or_false] at h
    subst h; simp
  · simp only [Catalyst.kick, controlledZ, circuitWires, List.cons_append, List.nil_append,
      List.flatMap_cons, List.flatMap_nil, gateWires, List.mem_cons, List.not_mem_nil, or_false] at h ⊢
    tauto

theorem andComputeCat_removed18 (y a b c : Wire) :
    ((andComputeCat y a b c).map (fun g => (largePhase 18 g).toNat)).sum = 0 := by
  simp only [andComputeCat, List.map_append, List.sum_append, parityPhase_removed18]
  rfl

theorem andComputeCat_prep_ket (y a b c : Wire)
    (hac : a ≠ c) (hbc : b ≠ c) (hya : y ≠ a) (hyb : y ≠ b) (hyc : y ≠ c)
    (s : BasisState) (hc : s c = false) (hy : s y = false) :
    Quantum.run (andComputeCat y a b c) (Prep y (ket s)) = Prep y (ket (s[c ↦ s a && s b])) := by
  let pre : Circuit := [.H c] ++ AndGadget.parityPhase a b c ++ [.H c]
  have hy_pre : y ∉ circuitWires pre := by
    intro hm
    simp only [pre, circuitWires_append, List.mem_append] at hm
    rcases hm with (h | h) | h
    · simp only [circuitWires, List.flatMap_cons, List.flatMap_nil, List.append_nil, gateWires,
        List.mem_cons, List.not_mem_nil, or_false] at h
      exact hyc h
    · have h' := parityPhase_wires a b c h
      simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
      rcases h' with rfl | rfl | rfl <;> first | exact hya rfl | exact hyb rfl | exact hyc rfl
    · simp only [circuitWires, List.flatMap_cons, List.flatMap_nil, List.append_nil, gateWires,
        List.mem_cons, List.not_mem_nil, or_false] at h
      exact hyc h
  have hpre_sup : SupportedOn (fun t => t y = false) (Quantum.run pre (ket s)) :=
    circuit_frame y pre hy_pre (ket s) (supportedOn_ket _ _ hy)
  have hrun : Quantum.run (andComputeCat y a b c) (Prep y (ket s)) =
      Quantum.run (Catalyst.kick c y) (Quantum.run pre (Prep y (ket s))) := by
    simp only [andComputeCat, pre, Quantum.run_append]
  rw [hrun, prep_circuit y pre hy_pre, Catalyst.kick_supported c y hyc.symm _ hpre_sup]
  have hand : applyGate (.P .forward 2 c) (Quantum.run pre (ket s)) = Quantum.run (AndGadget.andCompute a b c) (ket s) := by
    simp only [AndGadget.andCompute, pre, Quantum.run_append, Quantum.run_cons, Quantum.run_nil,
      LinearMap.id_coe, id_eq]
  rw [hand, AndGadget.andCompute_ket a b c hac hbc s hc]

/-- Clean-target 4-T `majority` using catalyst `y` (0 scratch wire, 0 measurements!). -/
def majorityCat (y a b cin c : Wire) : Circuit :=
  [.CX a b, .CX a cin] ++ andComputeCat y b cin c ++ [.CX a c, .CX a cin, .CX a b]

theorem majorityCat_tCount (y a b cin c : Wire) : ShorECDLP.tCount (majorityCat y a b cin c) = 4 := by
  rw [majorityCat, ShorECDLP.tCount_append, ShorECDLP.tCount_append, andComputeCat_tCount]; rfl

theorem majorityCat_length (y a b cin c : Wire) : (majorityCat y a b cin c).length = 23 := by
  simp [majorityCat, andComputeCat_length]

theorem majorityCat_wellFormed (y a b cin c : Wire) (hnd : [y, a, b, cin, c].Nodup) :
    CircuitWellFormed (majorityCat y a b cin c) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or, not_false_eq_true,
    List.nodup_nil, and_true] at hnd
  obtain ⟨⟨hya, hyb, hyi, hyc⟩, ⟨hab, hai, hac⟩, ⟨hbi, hbc⟩, hic⟩ := hnd
  rw [majorityCat, circuitWellFormed_append, circuitWellFormed_append]
  refine ⟨⟨by simp [CircuitWellFormed, Gate.WellFormed, hab, hai],
    andComputeCat_wellFormed y b cin c hbc hic (Ne.symm hyc)⟩,
    by simp [CircuitWellFormed, Gate.WellFormed, hac, hai, hab]⟩

theorem majorityCat_wires (y a b cin c : Wire) :
    circuitWires (majorityCat y a b cin c) ⊆ [y, a, b, cin, c] := by
  intro w hw
  simp only [majorityCat, circuitWires, List.flatMap_append, List.mem_append] at hw
  rcases hw with (h | h) | h
  · simp [gateWires, List.mem_cons] at h ⊢; tauto
  · have h' := andComputeCat_wires y b cin c h; simp [List.mem_cons] at h' ⊢; tauto
  · simp [gateWires, List.mem_cons] at h ⊢; tauto

theorem majorityCat_removed18 (y a b cin c : Wire) :
    ((majorityCat y a b cin c).map (fun g => (largePhase 18 g).toNat)).sum = 0 := by
  simp only [majorityCat, List.map_append, List.sum_append, andComputeCat_removed18]; rfl

theorem majorityCat_prep_ket (y a b cin c : Wire) (hnd : [y, a, b, cin, c].Nodup)
    (s : BasisState) (hc : s c = false) (hy : s y = false) :
    Quantum.run (majorityCat y a b cin c) (Prep y (ket s)) =
      Prep y (ket (s[c ↦ ECDSAAdd.Arithmetic.carryBit (s a) (s b) (s cin)])) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or, not_false_eq_true,
    List.nodup_nil, and_true] at hnd
  obtain ⟨⟨hya, hyb, hyi, hyc⟩, ⟨hab, hai, hac⟩, ⟨hbi, hbc⟩, hic⟩ := hnd
  let c1 : Circuit := [.CX a b, .CX a cin]
  let c2 : Circuit := [.CX a c, .CX a cin, .CX a b]
  have hy1 : y ∉ circuitWires c1 := by simp [c1, circuitWires, gateWires, hya, hyb, hyi]
  have hy2 : y ∉ circuitWires c2 := by simp [c2, circuitWires, gateWires, hya, hyb, hyi, hyc]
  rw [majorityCat, Quantum.run_append, Quantum.run_append, prep_circuit y c1 hy1]
  have h1 : Quantum.run c1 (ket s) = ket (s[b ↦ s b ^^ s a][cin ↦ s cin ^^ s a]) := by
    simp only [c1, Quantum.run_cons, Quantum.run_nil, LinearMap.id_coe, id_eq,
      applyGate_CX_ket, upd_other _ _ _ hab, upd_other _ _ _ (Ne.symm hbi)]
  rw [h1, andComputeCat_prep_ket y b cin c hbc hic hyb hyi hyc _
    (by simp [upd, Ne.symm hic, Ne.symm hbc, hc]) (by simp [upd, hyi, hyb, hy]),
    prep_circuit y c2 hy2]
  let s1 := s[b ↦ s b ^^ s a][cin ↦ s cin ^^ s a]
  have hs1b : s1 b = (s b ^^ s a) := by simp [s1, upd, hbi]
  have hs1i : s1 cin = (s cin ^^ s a) := by simp [s1, upd]
  have hs1a : s1 a = s a := by simp [s1, upd, hai, hab]
  have h2 : Quantum.run c2 (ket (s1[c ↦ s1 b && s1 cin])) =
      ket (s[c ↦ ECDSAAdd.Arithmetic.carryBit (s a) (s b) (s cin)]) := by
    rw [hs1b, hs1i]
    let v : Bool := (s b ^^ s a) && (s cin ^^ s a)
    let s2 : BasisState := s1[c ↦ v]
    have hs2a : s2 a = s a := by simp [s2, upd, hac, hs1a]
    have hs2b : s2 b = (s b ^^ s a) := by simp [s2, upd, hbc, hs1b]
    have hs2i : s2 cin = (s cin ^^ s a) := by simp [s2, upd, hic, hs1i]
    have hs2c : s2 c = v := by simp [s2, upd]
    have hrun2 : Quantum.run c2 (ket s2) =
        ket (s2[c ↦ v ^^ s a][cin ↦ (s cin ^^ s a) ^^ s a][b ↦ (s b ^^ s a) ^^ s a]) := by
      simp only [c2, Quantum.run_cons, Quantum.run_nil, LinearMap.id_coe, id_eq, applyGate_CX_ket,
        upd_other _ _ _ hac, upd_other _ _ _ hai, upd_other _ _ _ hic, upd_other _ _ _ hbc,
        upd_other _ _ _ hbi, hs2a, hs2b, hs2i, hs2c]
    rw [hrun2]
    congr 1
    funext w
    by_cases hwc : w = c
    · rw [hwc]; simp only [upd, Ne.symm hbc, Ne.symm hic, if_true, if_false, v, ECDSAAdd.Arithmetic.carryBit]
      cases s a <;> cases s b <;> cases s cin <;> rfl
    · by_cases hwi : w = cin
      · rw [hwi]; simp only [upd, Ne.symm hbi, hic, if_true, if_false, Bool.xor_assoc, Bool.xor_self, Bool.xor_false]
      · by_cases hwb : w = b
        · rw [hwb]; simp only [upd, hbc, if_true, if_false, Bool.xor_assoc, Bool.xor_self, Bool.xor_false]
        · simp [s2, s1, upd, hwc, hwi, hwb]
  exact congrArg (Prep y) h2

/-! #### Generalized injective wire renaming (`mapStraight`) via `relabelStraight` -/

def mapGate (f : Wire → Wire) : Gate → Gate
  | .X t => .X (f t)
  | .H t => .H (f t)
  | .CX a b => .CX (f a) (f b)
  | .CCX a b t => .CCX (f a) (f b) (f t)
  | .P d k t => .P d k (f t)

def mapStraight {n s e : Nat} (f : Wire → Wire) : Straight n s e → Straight n s e
  | .done => .done
  | .gate (.literal g) p => .gate (.literal (mapGate f g)) (mapStraight f p)
  | .gate (.whenBit r v g) p => .gate (.whenBit r v (mapGate f g)) (mapStraight f p)
  | .recordGate i v g p => .recordGate i v (mapGate f g) (mapStraight f p)
  | .measure w p => .measure (f w) (mapStraight f p)

theorem mapGate_eq_relabel (e : Wire ≃ Wire) (g : Gate) : mapGate e g = g.relabel e := by
  cases g <;> rfl

theorem mapStraight_eq_relabel {n s e : Nat} (f : Wire → Wire) (eqv : Wire ≃ Wire)
    (p : Straight n s e) (h : ∀ w ∈ ChallengeMigration.straightWires p, f w = eqv w) :
    mapStraight f p = relabelStraight eqv p := by
  induction p with
  | done => rfl
  | gate g p ih =>
    cases g with
    | literal g =>
      simp only [ChallengeMigration.straightWires, templateGateWires, List.mem_append] at h
      have hg : mapGate f g = g.relabel eqv := by
        cases g <;> simp only [mapGate, Gate.relabel, gateWires, List.mem_cons, List.not_mem_nil, or_false] at h ⊢
        · rw [h _ (Or.inl rfl)]
        · rw [h _ (Or.inl rfl)]
        · rw [h _ (Or.inl (Or.inl rfl)), h _ (Or.inl (Or.inr rfl))]
        · rw [h _ (Or.inl (Or.inl rfl)), h _ (Or.inl (Or.inr (Or.inl rfl))), h _ (Or.inl (Or.inr (Or.inr rfl)))]
        · rw [h _ (Or.inl rfl)]
      simp only [mapStraight, relabelStraight, relabelTemplateGate, hg, ih (fun w hw => h w (Or.inr hw))]
    | whenBit r v g =>
      simp only [ChallengeMigration.straightWires, templateGateWires, List.mem_append] at h
      have hg : mapGate f g = g.relabel eqv := by
        cases g <;> simp only [mapGate, Gate.relabel, gateWires, List.mem_cons, List.not_mem_nil, or_false] at h ⊢
        · rw [h _ (Or.inl rfl)]
        · rw [h _ (Or.inl rfl)]
        · rw [h _ (Or.inl (Or.inl rfl)), h _ (Or.inl (Or.inr rfl))]
        · rw [h _ (Or.inl (Or.inl rfl)), h _ (Or.inl (Or.inr (Or.inl rfl))), h _ (Or.inl (Or.inr (Or.inr rfl)))]
        · rw [h _ (Or.inl rfl)]
      simp only [mapStraight, relabelStraight, relabelTemplateGate, hg, ih (fun w hw => h w (Or.inr hw))]
  | recordGate i v g p ih =>
    simp only [ChallengeMigration.straightWires, List.mem_append] at h
    have hg : mapGate f g = g.relabel eqv := by
      cases g <;> simp only [mapGate, Gate.relabel, gateWires, List.mem_cons, List.not_mem_nil, or_false] at h ⊢
      · rw [h _ (Or.inl rfl)]
      · rw [h _ (Or.inl rfl)]
      · rw [h _ (Or.inl (Or.inl rfl)), h _ (Or.inl (Or.inr rfl))]
      · rw [h _ (Or.inl (Or.inl rfl)), h _ (Or.inl (Or.inr (Or.inl rfl))), h _ (Or.inl (Or.inr (Or.inr rfl)))]
      · rw [h _ (Or.inl rfl)]
    simp only [mapStraight, relabelStraight, hg, ih (fun w hw => h w (Or.inr hw))]
  | measure w p ih =>
    simp only [ChallengeMigration.straightWires, List.mem_cons] at h
    simp only [mapStraight, relabelStraight, h w (Or.inl rfl), ih (fun u hu => h u (Or.inr hu))]

theorem mapStraight_slots {n s e : Nat} (f : Wire → Wire) (p : Straight n s e) :
    (mapStraight f p).gateSlots = p.gateSlots := by
  induction p with
  | done => rfl
  | gate g p ih => cases g <;> simp [mapStraight, Straight.gateSlots, ih]
  | recordGate i v g p ih => simp [mapStraight, Straight.gateSlots, ih]
  | measure w p ih => simp [mapStraight, Straight.gateSlots, ih]

theorem mapStraight_removed {n s e : Nat} (cutoff : Nat) (f : Wire → Wire) (p : Straight n s e) :
    removed cutoff (mapStraight f p) = removed cutoff p := by
  induction p with
  | done => rfl
  | gate g p ih =>
    cases g with
    | literal g => cases g <;> simp [mapStraight, mapGate, largePhase, removed, ih]
    | whenBit r v g => cases g <;> simp [mapStraight, mapGate, largePhase, removed, ih]
  | recordGate i v g p ih => cases g <;> simp [mapStraight, mapGate, largePhase, removed, ih]
  | measure w p ih => simp [mapStraight, removed, ih]

theorem mapStraight_tCount {n s e : Nat} (f : Wire → Wire) (p : Straight n s e)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((mapStraight f p).instantiate read h).tCount = (p.instantiate read h).tCount := by
  have ht (g : Gate) : tCost (mapGate f g) = tCost g := by cases g <;> rfl
  induction p with
  | done => rfl
  | gate g p ih =>
    cases g with
    | literal g =>
      simp only [mapStraight, Straight.instantiate, TemplateGate.instantiate, AdaptiveCircuit.tCount,
        ShorECDLP.tCount, List.map_singleton, List.sum_singleton, ht, ih]
    | whenBit r v g =>
      by_cases hr : read r = v
      · simp only [mapStraight, Straight.instantiate, TemplateGate.instantiate, hr, if_true,
          AdaptiveCircuit.tCount, ShorECDLP.tCount, List.map_singleton, List.sum_singleton, ht, ih]
      · simp only [mapStraight, Straight.instantiate, TemplateGate.instantiate, hr, if_false,
          AdaptiveCircuit.tCount, ShorECDLP.tCount, List.map_nil, List.sum_nil, ih]
  | recordGate i v g p ih =>
    by_cases hr : h i = v
    · simp only [mapStraight, Straight.instantiate, hr, if_true, AdaptiveCircuit.tCount,
        ShorECDLP.tCount, List.map_singleton, List.sum_singleton, ht, ih]
    · simp only [mapStraight, Straight.instantiate, hr, if_false, AdaptiveCircuit.tCount,
        ShorECDLP.tCount, List.map_nil, List.sum_nil, ih]
  | measure w p ih =>
    simp only [mapStraight, Straight.instantiate, AdaptiveCircuit.tCount, ih]

theorem mapStraight_wires {n s e : Nat} (f : Wire → Wire) (p : Straight n s e) :
    ChallengeMigration.straightWires (mapStraight f p) = (ChallengeMigration.straightWires p).map f := by
  have hw (g : Gate) : gateWires (mapGate f g) = (gateWires g).map f := by cases g <;> rfl
  induction p with
  | done => rfl
  | gate g p ih =>
    cases g <;> simp [mapStraight, ChallengeMigration.straightWires, templateGateWires, hw, ih, List.map_append]
  | recordGate i v g p ih =>
    simp [mapStraight, ChallengeMigration.straightWires, hw, ih, List.map_append]
  | measure w p ih =>
    simp [mapStraight, ChallengeMigration.straightWires, ih]

theorem mapStraight_wellFormed {n s e : Nat} (f : Wire → Wire) (p : Straight n s e)
    (hinj : ∀ a ∈ ChallengeMigration.straightWires p, ∀ b ∈ ChallengeMigration.straightWires p, f a = f b → a = b)
    (hp : p.WellFormed) : (mapStraight f p).WellFormed := by
  have hgw (g : Gate) (hg : g.WellFormed) (hi : ∀ a ∈ gateWires g, ∀ b ∈ gateWires g, f a = f b → a = b) :
      (mapGate f g).WellFormed := by
    cases g with
    | X _ | H _ | P _ _ _ => trivial
    | CX a b => exact fun e => hg (hi a (by simp [gateWires]) b (by simp [gateWires]) e)
    | CCX a b t =>
      exact ⟨fun e => hg.1 (hi a (by simp [gateWires]) b (by simp [gateWires]) e),
        fun e => hg.2.1 (hi a (by simp [gateWires]) t (by simp [gateWires]) e),
        fun e => hg.2.2 (hi b (by simp [gateWires]) t (by simp [gateWires]) e)⟩
  induction p with
  | done => trivial
  | gate g p ih =>
    cases g with
    | literal g =>
      exact ⟨hgw g hp.1 (fun a ha b hb => hinj a (by simp [ChallengeMigration.straightWires, templateGateWires, ha])
          b (by simp [ChallengeMigration.straightWires, templateGateWires, hb])),
        ih (fun a ha b hb => hinj a (by simp [ChallengeMigration.straightWires, templateGateWires, ha])
          b (by simp [ChallengeMigration.straightWires, templateGateWires, hb])) hp.2⟩
    | whenBit r v g =>
      exact ⟨hgw g hp.1 (fun a ha b hb => hinj a (by simp [ChallengeMigration.straightWires, templateGateWires, ha])
          b (by simp [ChallengeMigration.straightWires, templateGateWires, hb])),
        ih (fun a ha b hb => hinj a (by simp [ChallengeMigration.straightWires, templateGateWires, ha])
          b (by simp [ChallengeMigration.straightWires, templateGateWires, hb])) hp.2⟩
  | recordGate i v g p ih =>
    exact ⟨hgw g hp.1 (fun a ha b hb => hinj a (by simp [ChallengeMigration.straightWires, ha])
        b (by simp [ChallengeMigration.straightWires, hb])),
      ih (fun a ha b hb => hinj a (by simp [ChallengeMigration.straightWires, ha])
        b (by simp [ChallengeMigration.straightWires, hb])) hp.2⟩
  | measure w p ih =>
    exact ih (fun a ha b hb => hinj a (by simp [ChallengeMigration.straightWires, ha])
      b (by simp [ChallengeMigration.straightWires, hb])) hp

/-- Extend any injection on a finite set `S : Finset Wire` to a bijection `Wire ≃ Wire`. -/
theorem extend_finset_inj (S : Finset Wire) (f : Wire → Wire)
    (hinj : ∀ a ∈ S, ∀ b ∈ S, f a = f b → a = b) :
    ∃ e : Wire ≃ Wire, ∀ w ∈ S, e w = f w := by
  classical
  induction S using Finset.induction_on with
  | empty => exact ⟨Equiv.refl Wire, fun _ h => by simp at h⟩
  | @insert a s ha ih =>
    obtain ⟨e, he⟩ := ih (fun x hx y hy => hinj x (Finset.mem_insert_of_mem hx) y (Finset.mem_insert_of_mem hy))
    let b := f a
    have hb : b ∉ s.image f := by
      intro hm
      obtain ⟨x, hx, hfx⟩ := Finset.mem_image.mp hm
      exact ha (hinj x (Finset.mem_insert_of_mem hx) a (Finset.mem_insert_self a s) hfx ▸ hx)
    have hnea : ∀ x ∈ s, e x ≠ b := fun x hx h => hb (Finset.mem_image.mpr ⟨x, hx, (he x hx).symm.trans h⟩)
    refine ⟨e.trans (Equiv.swap (e a) b), fun w hw => ?_⟩
    rcases Finset.mem_insert.mp hw with rfl | hw
    · simp [b]
    · have h1 : e w ≠ e a := fun h => ha (e.injective h ▸ hw)
      have h2 : e w ≠ b := hnea w hw
      rw [Equiv.trans_apply, Equiv.swap_apply_of_ne_of_ne h1 h2, he w hw]

theorem relabelState_prep (e : Wire ≃ Wire) (y : Wire) (psi : State) :
    relabelState e (Prep y psi) = Prep (e y) (relabelState e psi) := by
  simpa [Prep, Catalyst.prepare, Gate.relabel] using (Quantum.run_relabel e (Catalyst.prepare y) psi).symm

theorem relabelState_signedKet (e : Wire ≃ Wire) (st : ECDSAAdd.State) :
    relabelState e (Bridge.signedKet st) = Bridge.signedKet ⟨st.phase, relabelBasis e st.basis⟩ := by
  cases hph : st.phase <;> simp [Bridge.signedKet, hph, map_smul, relabelState_ket]

theorem relabelStraight_catLitSim {n s t : Nat} (e : Wire ≃ Wire) (y : Wire)
    (p : Straight n s t) (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hsim : CatLitSim y (p.instantiate read h) P V) :
    CatLitSim (e y) ((relabelStraight e p).instantiate read h) (ECDSAAdd.renameProgram e P)
      (fun bs => V (relabelBasis e.symm bs)) := by
  obtain ⟨cs, hal, hmass⟩ := hsim
  refine ⟨cs, ?_, hmass⟩
  rw [relabelStraight_instantiate, AdaptiveCircuit.run_relabel, forall₂_map_left]
  refine List.Forall₂.imp ?_ hal
  intro br c ⟨m, lm, hb⟩
  refine ⟨m, by rw [lm, (ECDSAAdd.renameProgram_counts e P).2], fun st hst => ?_⟩
  change relabelState e (br.kraus (relabelState e.symm (Prep (e y) (Bridge.signedKet st)))) = _
  have h1 : relabelState e.symm (Prep (e y) (Bridge.signedKet st)) =
      Prep y (Bridge.signedKet ⟨st.phase, relabelBasis e.symm st.basis⟩) := by
    rw [relabelState_prep, Equiv.symm_apply_apply, relabelState_signedKet]
  rw [h1, hb ⟨st.phase, relabelBasis e.symm st.basis⟩ hst, map_smul, relabelState_prep, relabelState_signedKet]
  congr 3
  have hpull : ECDSAAdd.pullState e st = ⟨st.phase, relabelBasis e.symm st.basis⟩ := by
    apply ECDSAAdd.State.extensionality
    · rfl
    · funext w; simp [ECDSAAdd.pullState, relabelBasis, Equiv.symm_symm]
  have hren := ECDSAAdd.run_rename e e.injective P m st
  rw [hpull] at hren
  apply ECDSAAdd.State.extensionality
  · exact (congrArg ECDSAAdd.State.phase hren).symm
  · funext w
    have := congrFun (congrArg ECDSAAdd.State.basis hren) (e.symm w)
    simpa [ECDSAAdd.pullState, relabelBasis] using this.symm

theorem mapStraight_catLitSim {n s t : Nat} (f : Wire → Wire) (y : Wire) (S : Finset Wire)
    (p : Straight n s t) (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hpS : ∀ w ∈ ChallengeMigration.straightWires p, w ∈ S)
    (hPS : ECDSAAdd.wires P ⊆ S) (hyS : y ∈ S)
    (hinj : ∀ a ∈ S, ∀ b ∈ S, f a = f b → a = b)
    (hsim : CatLitSim y (p.instantiate read h) P V) :
    CatLitSim (f y) ((mapStraight f p).instantiate read h) (ECDSAAdd.renameProgram f P)
      (fun bs => ∀ bs0 : BasisState, (∀ w ∈ S, bs0 w = bs (f w)) → V bs0) := by
  obtain ⟨e, he⟩ := extend_finset_inj S f hinj
  have hmp : mapStraight f p = relabelStraight e p :=
    mapStraight_eq_relabel f e p (fun w hw => (he w (hpS w hw)).symm)
  have hren : ECDSAAdd.renameProgram f P = ECDSAAdd.renameProgram e P := by
    have hgo (Q : ECDSAAdd.Program) (hQS : ECDSAAdd.wires Q ⊆ S) :
        ECDSAAdd.renameProgram f Q = ECDSAAdd.renameProgram e Q := by
      induction Q with
      | nil => rfl
      | cons i Q ih =>
        have hi : ECDSAAdd.Instr.wires i ⊆ S := Finset.Subset.trans Finset.subset_union_left hQS
        have hQ : ECDSAAdd.wires Q ⊆ S := Finset.Subset.trans Finset.subset_union_right hQS
        change ECDSAAdd.renameInstr f i :: ECDSAAdd.renameProgram f Q =
          ECDSAAdd.renameInstr e i :: ECDSAAdd.renameProgram e Q
        rw [ih hQ]
        congr 1
        cases i with
        | X a =>
          simp only [ECDSAAdd.renameInstr]
          rw [he a (hi (by simp [ECDSAAdd.Instr.wires]))]
        | CX a b =>
          simp only [ECDSAAdd.renameInstr]
          rw [he a (hi (by simp [ECDSAAdd.Instr.wires])), he b (hi (by simp [ECDSAAdd.Instr.wires]))]
        | CCX a b c =>
          simp only [ECDSAAdd.renameInstr]
          rw [he a (hi (by simp [ECDSAAdd.Instr.wires])), he b (hi (by simp [ECDSAAdd.Instr.wires])),
            he c (hi (by simp [ECDSAAdd.Instr.wires]))]
        | measureX a c0 c1 =>
          have hcorr (cs : List ECDSAAdd.Correction) (hcs : ECDSAAdd.correctionWires cs ⊆ S) :
              cs.map (ECDSAAdd.renameCorrection f) = cs.map (ECDSAAdd.renameCorrection e) := by
            induction cs with
            | nil => rfl
            | cons c cs ihc =>
              have hc : (match c with | .Z u => {u} | .CZ u v => {u, v}) ⊆ S := by
                cases c <;> exact Finset.Subset.trans Finset.subset_union_left hcs
              have hrest : ECDSAAdd.correctionWires cs ⊆ S := by
                cases c <;> exact Finset.Subset.trans Finset.subset_union_right hcs
              simp only [List.map_cons, ihc hrest]
              congr 1
              cases c with
              | Z u =>
                simp only [ECDSAAdd.renameCorrection]
                rw [he u (hc (by simp))]
              | CZ u v =>
                simp only [ECDSAAdd.renameCorrection]
                rw [he u (hc (by simp)), he v (hc (by simp))]
          simp only [ECDSAAdd.renameInstr]
          rw [he a (hi (by simp [ECDSAAdd.Instr.wires])),
            hcorr c0 (Finset.Subset.trans (by intro w hw; simp [ECDSAAdd.Instr.wires, hw]) hi),
            hcorr c1 (Finset.Subset.trans (by intro w hw; simp [ECDSAAdd.Instr.wires, hw]) hi)]
    exact hgo P hPS
  rw [hmp, hren, ← he y hyS]
  obtain ⟨cs, hal, hmass⟩ := relabelStraight_catLitSim e y p read h P V hsim
  refine ⟨cs, ?_, hmass⟩
  refine List.Forall₂.imp ?_ hal
  intro br c ⟨m, lm, hb⟩
  exact ⟨m, lm, fun st hst => hb st (hst (relabelBasis e.symm st.basis) (fun w hw => by
    simp [relabelBasis, he w hw]))⟩

end
end ShorECDLP.Entrant.LocalFour
end

section
namespace ShorECDLP.Entrant.LocalFour
open Quantum Challenge AndGadget ConditionalCatalyst ApproximatePhase34
open Paper2607_13816 Paper2607_13816.ChallengeMigration
noncomputable section
set_option maxHeartbeats 2000000
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySimpa false
set_option linter.unusedVariables false

attribute [local irreducible] Quantum.run Quantum.applyGate Quantum.ket

/-! #### `LocalFour` extensions: `flipSwap`, `fresh_prep_comm`, `Indep`, `CatProg` -/

theorem swapCircuit_removed18 (y₁ y₂ : Wire) :
    ((swapCircuit y₁ y₂).map (fun g => (largePhase 18 g).toNat)).sum = 0 := rfl

def flipSwapCircuit (y w : Wire) : Circuit := [.X w] ++ swapCircuit y w

def unflipSwapCircuit (y w : Wire) : Circuit := swapCircuit w y ++ [.X w]

theorem flipSwapCircuit_wellFormed (y w : Wire) (hne : y ≠ w) : CircuitWellFormed (flipSwapCircuit y w) := by
  rw [flipSwapCircuit, circuitWellFormed_append]
  exact ⟨by simp [CircuitWellFormed, Gate.WellFormed], swapCircuit_wellFormed y w hne⟩

theorem unflipSwapCircuit_wellFormed (y w : Wire) (hne : y ≠ w) : CircuitWellFormed (unflipSwapCircuit y w) := by
  rw [unflipSwapCircuit, circuitWellFormed_append]
  exact ⟨swapCircuit_wellFormed w y hne.symm, by simp [CircuitWellFormed, Gate.WellFormed]⟩

theorem flipSwapCircuit_tCount (y w : Wire) : ShorECDLP.tCount (flipSwapCircuit y w) = 0 := rfl
theorem unflipSwapCircuit_tCount (y w : Wire) : ShorECDLP.tCount (unflipSwapCircuit y w) = 0 := rfl
theorem flipSwapCircuit_length (y w : Wire) : (flipSwapCircuit y w).length = 4 := rfl
theorem unflipSwapCircuit_length (y w : Wire) : (unflipSwapCircuit y w).length = 4 := rfl
theorem flipSwapCircuit_removed18 (y w : Wire) :
    ((flipSwapCircuit y w).map (fun g => (largePhase 18 g).toNat)).sum = 0 := rfl
theorem unflipSwapCircuit_removed18 (y w : Wire) :
    ((unflipSwapCircuit y w).map (fun g => (largePhase 18 g).toNat)).sum = 0 := rfl

theorem flipSwapCircuit_wires (y w : Wire) : circuitWires (flipSwapCircuit y w) ⊆ [y, w] := by
  intro u hu; simp [flipSwapCircuit, swapCircuit, circuitWires, gateWires] at hu ⊢; tauto

theorem unflipSwapCircuit_wires (y w : Wire) : circuitWires (unflipSwapCircuit y w) ⊆ [y, w] := by
  intro u hu; simp [unflipSwapCircuit, swapCircuit, circuitWires, gateWires] at hu ⊢; tauto

theorem flipSwapCircuit_prep_ket (y w : Wire) (hne : y ≠ w) (s : BasisState)
    (hy : s y = false) (hw : s w = true) :
    Quantum.run (flipSwapCircuit y w) (Prep y (ket s)) = Prep w (ket (s[w ↦ false])) := by
  have hyw : y ∉ circuitWires ([.X w] : Circuit) := by simp [circuitWires, gateWires, hne]
  rw [flipSwapCircuit, Quantum.run_append, prep_circuit y _ hyw, Quantum.run_singleton,
    applyGate_X_ket, hw]
  exact swapCircuit_prep_ket y w hne _ (by simp [upd, hne, hy]) (by simp [upd])

theorem unflipSwapCircuit_prep_ket (y w : Wire) (hne : y ≠ w) (s : BasisState)
    (hy : s y = false) (hw : s w = false) :
    Quantum.run (unflipSwapCircuit y w) (Prep w (ket s)) = Prep y (ket (s[w ↦ true])) := by
  have hyw : y ∉ circuitWires ([.X w] : Circuit) := by simp [circuitWires, gateWires, hne]
  rw [unflipSwapCircuit, Quantum.run_append, swapCircuit_prep_ket w y hne.symm s hw hy,
    prep_circuit y _ hyw, Quantum.run_singleton, applyGate_X_ket, hw]
  rfl

private def preBranchExt (outcome : Option Bool) (before : State →ₗ[ℂ] State) (b : InstrumentBranch) :
    InstrumentBranch :=
  ⟨outcome.toList ++ b.history, b.kraus.comp before⟩

private theorem upd_swap_ext (s : BasisState) (a b : Wire) (ha : a ≠ b) (x y : Bool) :
    s[a ↦ x][b ↦ y] = s[b ↦ y][a ↦ x] := by
  funext w; by_cases hwa : w = a <;> by_cases hwb : w = b <;> simp_all [upd]

theorem fresh_prep_comm {n s e : Nat} (y : Wire) (p : Straight n s e) (hy : Fresh y p)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ∀ b ∈ (p.instantiate read h).run, ∀ psi : State, b.kraus (Prep y psi) = Prep y (b.kraus psi) := by
  induction p with
  | done =>
    intro b hb psi
    simp only [Straight.instantiate, AdaptiveCircuit.run, List.mem_singleton] at hb
    subst hb; rfl
  | gate g next ih =>
    intro b hb psi
    cases g with
    | literal g =>
      change b ∈ ((next.instantiate read h).run.map (preBranchExt none (Quantum.run ([g])))) at hb
      obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchExt]
      rw [LinearMap.comp_apply, LinearMap.comp_apply, Quantum.run_singleton, Quantum.run_singleton,
        Catalyst.prepare_gate y g hy.1 psi, ih hy.2 h b' hb']
    | whenBit r v g =>
      change b ∈ ((next.instantiate read h).run.map
        (preBranchExt none (Quantum.run (if read r = v then [g] else [])))) at hb
      obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchExt]
      by_cases hr : read r = v
      · simp only [hr, if_true, LinearMap.comp_apply, Quantum.run_singleton]
        rw [Catalyst.prepare_gate y g hy.1 psi, ih hy.2 h b' hb']
      · simp only [hr, if_false, LinearMap.comp_apply, Quantum.run_nil]
        exact ih hy.2 h b' hb' psi
  | recordGate i v g next ih =>
    intro b hb psi
    change b ∈ ((next.instantiate read h).run.map
      (preBranchExt none (Quantum.run (if h i = v then [g] else [])))) at hb
    obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
    dsimp only [preBranchExt]
    by_cases hr : h i = v
    · simp only [hr, if_true, LinearMap.comp_apply, Quantum.run_singleton]
      rw [Catalyst.prepare_gate y g hy.1 psi, ih hy.2 h b' hb']
    · simp only [hr, if_false, LinearMap.comp_apply, Quantum.run_nil]
      exact ih hy.2 h b' hb' psi
  | measure w next ih =>
    intro b hb psi
    change b ∈ ((next.instantiate read (Fin.lastCases (motive := fun _ => Bool) false h)).run.map
        (preBranchExt (some false) (xResetKraus w false)) ++
      (next.instantiate read (Fin.lastCases (motive := fun _ => Bool) true h)).run.map
        (preBranchExt (some true) (xResetKraus w true))) at hb
    rcases List.mem_append.mp hb with hb | hb <;>
    · obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchExt]
      rw [LinearMap.comp_apply, LinearMap.comp_apply, Catalyst.prepare_reset y w hy.1 _ psi,
        ih hy.2 _ b' hb']

theorem applyGate_X_comm_gate (x : Wire) (g : Gate) (hx : x ∉ gateWires g) (psi : State) :
    applyGate g (applyGate (.X x) psi) = applyGate (.X x) (applyGate g psi) := by
  have hket : ∀ s : BasisState, applyGate g (applyGate (.X x) (ket s)) = applyGate (.X x) (applyGate g (ket s)) := by
    intro s
    cases g with
    | X t =>
      have h : x ≠ t := by simpa [gateWires] using hx
      simp only [applyGate_X_ket, upd_other _ _ _ h, upd_other _ _ _ h.symm, upd_swap_ext _ _ _ h]
    | CX c t =>
      have h : x ≠ c ∧ x ≠ t := by simpa [gateWires] using hx
      simp only [applyGate_X_ket, applyGate_CX_ket, upd_other _ _ _ h.2, upd_other _ _ _ h.1.symm,
        upd_other _ _ _ h.2.symm, upd_swap_ext _ _ _ h.2]
    | CCX a b t =>
      have h : x ≠ a ∧ x ≠ b ∧ x ≠ t := by simpa [gateWires] using hx
      simp only [applyGate_X_ket, applyGate_CCX_ket, upd_other _ _ _ h.2.2, upd_other _ _ _ h.1.symm,
        upd_other _ _ _ h.2.1.symm, upd_other _ _ _ h.2.2.symm, upd_swap_ext _ _ _ h.2.2]
    | P dir k t =>
      have h : x ≠ t := by simpa [gateWires] using hx
      simp only [applyGate_X_ket, applyGate_P_ket, map_smul, upd_other _ _ _ h.symm]
    | H t =>
      have h : x ≠ t := by simpa [gateWires] using hx
      simp only [applyGate_X_ket, applyGate_H_ket, map_add, map_smul, upd_other _ _ _ h,
        upd_other _ _ _ h.symm, upd_swap_ext _ _ _ h]
  induction psi using Finsupp.induction with
  | zero => simp only [map_zero]
  | @single_add s c v _ _ ih =>
    have he : Finsupp.single s c = c • ket s := by simp [ket]
    simp only [map_add, he, map_smul, ih, hket]

theorem applyGate_X_comm_reset (x w : Wire) (hne : x ≠ w) (o : Bool) (psi : State) :
    xResetKraus w o (applyGate (.X x) psi) = applyGate (.X x) (xResetKraus w o psi) := by
  have hket : ∀ s : BasisState, xResetKraus w o (applyGate (.X x) (ket s)) =
      applyGate (.X x) (xResetKraus w o (ket s)) := by
    intro s
    simp only [applyGate_X_ket, xResetKraus_ket, map_smul, upd_other _ _ _ hne,
      upd_other _ _ _ hne.symm, upd_swap_ext _ _ _ hne]
  induction psi using Finsupp.induction with
  | zero => simp only [map_zero]
  | @single_add s c v _ _ ih =>
    have he : Finsupp.single s c = c • ket s := by simp [ket]
    simp only [map_add, he, map_smul, ih, hket]

theorem fresh_x_comm {n s e : Nat} (x : Wire) (p : Straight n s e) (hx : Fresh x p)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ∀ b ∈ (p.instantiate read h).run, ∀ psi : State,
      b.kraus (applyGate (.X x) psi) = applyGate (.X x) (b.kraus psi) := by
  induction p with
  | done =>
    intro b hb psi
    simp only [Straight.instantiate, AdaptiveCircuit.run, List.mem_singleton] at hb
    subst hb; rfl
  | gate g next ih =>
    intro b hb psi
    cases g with
    | literal g =>
      change b ∈ ((next.instantiate read h).run.map (preBranchExt none (Quantum.run ([g])))) at hb
      obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchExt]
      rw [LinearMap.comp_apply, LinearMap.comp_apply, Quantum.run_singleton, Quantum.run_singleton,
        applyGate_X_comm_gate x g hx.1 psi, ih hx.2 h b' hb']
    | whenBit r v g =>
      change b ∈ ((next.instantiate read h).run.map
        (preBranchExt none (Quantum.run (if read r = v then [g] else [])))) at hb
      obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchExt]
      by_cases hr : read r = v
      · simp only [hr, if_true, LinearMap.comp_apply, Quantum.run_singleton]
        rw [applyGate_X_comm_gate x g hx.1 psi, ih hx.2 h b' hb']
      · simp only [hr, if_false, LinearMap.comp_apply, Quantum.run_nil]
        exact ih hx.2 h b' hb' psi
  | recordGate i v g next ih =>
    intro b hb psi
    change b ∈ ((next.instantiate read h).run.map
      (preBranchExt none (Quantum.run (if h i = v then [g] else [])))) at hb
    obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
    dsimp only [preBranchExt]
    by_cases hr : h i = v
    · simp only [hr, if_true, LinearMap.comp_apply, Quantum.run_singleton]
      rw [applyGate_X_comm_gate x g hx.1 psi, ih hx.2 h b' hb']
    · simp only [hr, if_false, LinearMap.comp_apply, Quantum.run_nil]
      exact ih hx.2 h b' hb' psi
  | measure w next ih =>
    intro b hb psi
    change b ∈ ((next.instantiate read (Fin.lastCases (motive := fun _ => Bool) false h)).run.map
        (preBranchExt (some false) (xResetKraus w false)) ++
      (next.instantiate read (Fin.lastCases (motive := fun _ => Bool) true h)).run.map
        (preBranchExt (some true) (xResetKraus w true))) at hb
    rcases List.mem_append.mp hb with hb | hb <;>
    · obtain ⟨b', hb', rfl⟩ := List.mem_map.mp hb
      dsimp only [preBranchExt]
      rw [LinearMap.comp_apply, LinearMap.comp_apply, applyGate_X_comm_reset x w hx.1 _ psi,
        ih hx.2 _ b' hb']

theorem compileLower_inst_indep {n oldStart oldFinish : Nat} (q y : Wire)
    (p : Straight n oldStart oldFinish) (start : Nat) (records : Fin oldStart → Fin start)
    (read : ConstantBit n → Bool) (h₁ h₂ : Fin start → Bool)
    (hagree : ∀ i : Fin oldStart, h₁ (records i) = h₂ (records i)) :
    (compileLower q y p start records).program.instantiate read h₁ =
      (compileLower q y p start records).program.instantiate read h₂ := by
  have hlit {m e : Nat} (gs : Circuit) (tail : Straight n m e) (a b : Fin m → Bool)
      (ht : tail.instantiate read a = tail.instantiate read b) :
      (AndGadget.literals gs tail).instantiate read a = (AndGadget.literals gs tail).instantiate read b := by
    induction gs with
    | nil => exact ht
    | cons g gs ih =>
      change AdaptiveCircuit.unitary _ ((AndGadget.literals gs tail).instantiate read a) =
        AdaptiveCircuit.unitary _ ((AndGadget.literals gs tail).instantiate read b)
      rw [ih]
  have hwhen {m e : Nat} (r : ConstantBit n) (v : Bool) (gs : Circuit) (tail : Straight n m e)
      (a b : Fin m → Bool) (ht : tail.instantiate read a = tail.instantiate read b) :
      (ConditionalCatalyst.whenLiterals r v gs tail).instantiate read a =
        (ConditionalCatalyst.whenLiterals r v gs tail).instantiate read b := by
    induction gs with
    | nil => exact ht
    | cons g gs ih => simp only [ConditionalCatalyst.whenLiterals, Straight.instantiate, ih]
  have hrec {m e : Nat} (idx : Fin m) (v : Bool) (gs : Circuit) (tail : Straight n m e)
      (a b : Fin m → Bool) (ha : a idx = b idx)
      (ht : tail.instantiate read a = tail.instantiate read b) :
      (ConditionalCatalyst.recordLiterals idx v gs tail).instantiate read a =
        (ConditionalCatalyst.recordLiterals idx v gs tail).instantiate read b := by
    induction gs with
    | nil => exact ht
    | cons g gs ih => simp only [ConditionalCatalyst.recordLiterals, Straight.instantiate, ha, ih]
  induction p generalizing start with
  | done => rfl
  | gate g next ih =>
    cases g with
    | literal g =>
      cases g with
      | CCX a b t =>
        have hc : (compileLower q y (.gate (.literal (.CCX a b t)) next) start records).program =
            AndGadget.literals (compileCircuit y (andCompute a b q ++ [.CX q t]))
              (.measure q
                (.recordGate (Fin.last start) true (.H b)
                  (.recordGate (Fin.last start) true (.CX a b)
                    (.recordGate (Fin.last start) true (.H b)
                      (compileLower q y next (start + 1) (fun i => (records i).castSucc)).program)))) := by
          simp only [compileLower, AndGadget.lower, AndGadget.toffoliPrefix]
          rw [compile_literals]; rfl
        rw [hc]
        apply hlit
        simp only [Straight.instantiate, Fin.lastCases_last]
        congr 1 <;> congr 1 <;> congr 1 <;> congr 1
        · exact ih (start + 1) _ _ _ (fun i => by simp [Fin.lastCases_castSucc, hagree i])
        · exact ih (start + 1) _ _ _ (fun i => by simp [Fin.lastCases_castSucc, hagree i])
      | X _ | H _ | CX _ _ | P _ _ _ =>
        simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
        exact hlit _ _ _ _ (ih start records h₁ h₂ hagree)
    | whenBit r v g =>
      simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
      exact hwhen r v _ _ _ _ (ih start records h₁ h₂ hagree)
  | recordGate i v g next ih =>
    simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile]
    exact hrec (records i) v _ _ _ _ (hagree i) (ih start records h₁ h₂ hagree)
  | measure w next ih =>
    simp only [compileLower, AndGadget.lower, ConditionalCatalyst.compile, Straight.instantiate]
    congr 1
    · exact ih (start + 1) _ _ _ (fun i => Fin.lastCases (by simp) (fun j => by simp [hagree j]) i)
    · exact ih (start + 1) _ _ _ (fun i => Fin.lastCases (by simp) (fun j => by simp [hagree j]) i)

/-- History-independent `Straight` program (both `.run` and `.tCount` ignore initial history). -/
def Indep {n s e : Nat} (p : Straight n s e) : Prop :=
  ∀ (read : ConstantBit n → Bool) (h₁ h₂ : Fin s → Bool),
    (p.instantiate read h₁).run = (p.instantiate read h₂).run ∧
    (p.instantiate read h₁).tCount = (p.instantiate read h₂).tCount

theorem indep_append_run {n s m e : Nat} (p : Straight n s m) (q : Straight n m e)
    (hq : Indep q) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((p.append q).instantiate read h).run =
      ((p.instantiate read h).seq (q.instantiate read (fun _ => false))).run :=
  append_run_fixed p q read h (q.instantiate read (fun _ => false))
    (fun h' => (hq read h' (fun _ => false)).1)

theorem indep_append_tCount {n s m e : Nat} (p : Straight n s m) (q : Straight n m e)
    (hq : Indep q) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((p.append q).instantiate read h).tCount =
      (p.instantiate read h).tCount + (q.instantiate read (fun _ => false)).tCount := by
  induction p with
  | done =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount, Nat.zero_add]
    exact (hq read h (fun _ => false)).2
  | gate g p ih =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount, ih q hq h, Nat.add_assoc]
  | recordGate i v g p ih =>
    by_cases hv : h i = v <;>
      simp only [Straight.append, Straight.instantiate, hv, if_true, if_false, AdaptiveCircuit.tCount, ih q hq h, Nat.add_assoc]
  | measure w p ih =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount, ih q hq]
    omega

theorem indep_append {n s m e : Nat} (p : Straight n s m) (q : Straight n m e)
    (hp : Indep p) (hq : Indep q) : Indep (p.append q) := by
  intro read h₁ h₂
  constructor
  · rw [indep_append_run p q hq read h₁, indep_append_run p q hq read h₂,
      AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq, (hp read h₁ h₂).1]
  · rw [indep_append_tCount p q hq read h₁, indep_append_tCount p q hq read h₂,
      (hp read h₁ h₂).2]

theorem indep_literalProgram {n s : Nat} (gs : Circuit) : Indep (literalProgram (n := n) (s := s) gs) := by
  intro read h₁ h₂
  have hinst : (literalProgram (n := n) (s := s) gs).instantiate read h₁ =
      (literalProgram (n := n) (s := s) gs).instantiate read h₂ := by
    induction gs with
    | nil => rfl
    | cons g gs ih =>
      change AdaptiveCircuit.unitary [g] ((literalProgram gs).instantiate read h₁) =
        AdaptiveCircuit.unitary [g] ((literalProgram gs).instantiate read h₂)
      rw [ih]
  rw [hinst]; exact ⟨rfl, rfl⟩

theorem mapStraight_instantiate_run {n s e : Nat} (f : Wire → Wire) (p : Straight n s e)
    (read : ConstantBit n → Bool) (h₁ h₂ : Fin s → Bool)
    (hrun : (p.instantiate read h₁).run = (p.instantiate read h₂).run)
    (hinj : ∀ a ∈ ChallengeMigration.straightWires p, ∀ b ∈ ChallengeMigration.straightWires p, f a = f b → a = b) :
    ((mapStraight f p).instantiate read h₁).run = ((mapStraight f p).instantiate read h₂).run := by
  obtain ⟨eqv, heqv⟩ := extend_finset_inj (ChallengeMigration.straightWires p).toFinset f
    (fun a ha b hb => hinj a (List.mem_toFinset.mp ha) b (List.mem_toFinset.mp hb))
  rw [mapStraight_eq_relabel f eqv p (fun w hw => (heqv w (List.mem_toFinset.mpr hw)).symm),
    relabelStraight_instantiate, relabelStraight_instantiate,
    AdaptiveCircuit.run_relabel, AdaptiveCircuit.run_relabel, hrun]

theorem indep_mapStraight {n s e : Nat} (f : Wire → Wire) (p : Straight n s e)
    (hp : Indep p)
    (hinj : ∀ a ∈ ChallengeMigration.straightWires p, ∀ b ∈ ChallengeMigration.straightWires p, f a = f b → a = b) :
    Indep (mapStraight f p) := by
  intro read h₁ h₂
  exact ⟨mapStraight_instantiate_run f p read h₁ h₂ (hp read h₁ h₂).1 hinj,
    by rw [mapStraight_tCount, mapStraight_tCount, (hp read h₁ h₂).2]⟩

/-- Open-ended straight-line program wrapper avoiding intermediate `castFinish` proofs. -/
structure CatProg (n start : Nat) where
  finish : Nat
  prog : Straight n start finish

namespace CatProg

def lit {n start : Nat} (gs : Circuit) : CatProg n start :=
  ⟨start, literalProgram gs⟩

def append {n start : Nat} (a : CatProg n start) (b : CatProg n a.finish) : CatProg n start :=
  ⟨b.finish, a.prog.append b.prog⟩

def map {n start : Nat} (f : Wire → Wire) (a : CatProg n start) : CatProg n start :=
  ⟨a.finish, mapStraight f a.prog⟩

def noT {n start : Nat} (P : ECDSAAdd.Program) : CatProg n start :=
  let Pn := ECDSAAdd.Baselines.normalizeProgram P
  ⟨start + Bridge.tmplMeas (WEX.literalT (n := n) Pn), Bridge.translate (WEX.literalT (n := n) Pn) start⟩

def compileProg {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program) : CatProg n start :=
  let Pn := ECDSAAdd.Baselines.normalizeProgram P
  let r := compileLower q y (Bridge.translate (WEX.literalT (n := n) Pn) 0) start Fin.elim0
  ⟨r.finish, r.program⟩

theorem lit_indep {n start : Nat} (gs : Circuit) : Indep (lit (n := n) (start := start) gs).prog :=
  indep_literalProgram gs

theorem lit_tCount {n start : Nat} (gs : Circuit) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((lit (n := n) (start := start) gs).prog.instantiate read h).tCount = ShorECDLP.tCount gs := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    change ShorECDLP.tCount [g] + ((lit gs).prog.instantiate read h).tCount = ShorECDLP.tCount (g :: gs)
    rw [ih]; simp [ShorECDLP.tCount]

theorem lit_slots {n start : Nat} (gs : Circuit) : (lit (n := n) (start := start) gs).prog.gateSlots = gs.length := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    change 1 + (lit (n := n) (start := start) gs).prog.gateSlots = gs.length + 1
    rw [ih]; omega

theorem lit_wires {n start : Nat} (gs : Circuit) :
    ChallengeMigration.straightWires (lit (n := n) (start := start) gs).prog = circuitWires gs :=
  literalProgram_support n start gs

theorem lit_wellFormed {n start : Nat} (gs : Circuit) (hw : CircuitWellFormed gs) :
    (lit (n := n) (start := start) gs).prog.WellFormed :=
  literalProgram_wellFormed gs hw

theorem lit_removed {n start : Nat} (cutoff : Nat) (gs : Circuit) :
    removed cutoff (lit (n := n) (start := start) gs).prog = (gs.map (fun g => (largePhase cutoff g).toNat)).sum := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    change (largePhase cutoff g).toNat + removed cutoff (lit (n := n) (start := start) gs).prog = _
    rw [ih]; rfl

theorem lit_run {n start : Nat} (gs : Circuit) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((lit (n := n) (start := start) gs).prog.instantiate read h).run = [⟨[], Quantum.run gs⟩] := by
  induction gs with
  | nil =>
    simp only [lit, literalProgram, gateProgram, List.map_nil, Straight.instantiate, AdaptiveCircuit.run,
      List.cons.injEq, InstrumentBranch.mk.injEq, true_and, and_true]
    apply LinearMap.ext; intro psi; exact (Quantum.run_nil psi).symm
  | cons g gs ih =>
    change ((lit gs).prog.instantiate read h).run.map (preBranchExt none (Quantum.run ([g]))) = _
    rw [ih]
    simp only [List.map_singleton, preBranchExt, Option.toList_none, List.nil_append, List.cons.injEq,
      InstrumentBranch.mk.injEq, true_and, and_true]
    apply LinearMap.ext; intro psi
    simp only [LinearMap.comp_apply, Quantum.run_cons, Quantum.run_singleton, Quantum.run_nil]

theorem noT_indep {n start : Nat} (P : ECDSAAdd.Program) : Indep (noT (n := n) (start := start) P).prog := by
  intro read h₁ h₂
  exact ⟨(WEX.literal_run _ start read h₁).trans (WEX.literal_run _ start read h₂).symm,
    (WEX.literal_program_tCount _ start read h₁).trans (WEX.literal_program_tCount _ start read h₂).symm⟩

theorem noT_tCount {n start : Nat} (P : ECDSAAdd.Program) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((noT (n := n) (start := start) P).prog.instantiate read h).tCount =
      7 * ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram P) :=
  WEX.literal_program_tCount _ start read h

theorem noT_slots {n start : Nat} (P : ECDSAAdd.Program) :
    (noT (n := n) (start := start) P).prog.gateSlots ≤ 3 * ECDSAAdd.Challenge.gateSlots P := by
  rw [noT, Bridge.translate_gateSlots]
  have h := WEX.literal_slot_bound (n := n) (ECDSAAdd.Baselines.normalizeProgram P)
  rwa [ECDSAAdd.Baselines.normalize_slots] at h

theorem noT_wires {n start : Nat} (P : ECDSAAdd.Program) (S : List Wire)
    (hP : ECDSAAdd.wires P ⊆ S.toFinset) :
    ChallengeMigration.straightWires (noT (n := n) (start := start) P).prog ⊆ S := by
  apply WEX.literal_translate_support (n := n) (ECDSAAdd.Baselines.normalizeProgram P) S
  rwa [ECDSAAdd.Baselines.normalize_wires]

theorem noT_wires_mem {n start : Nat} (P : ECDSAAdd.Program) :
    ∀ w ∈ ChallengeMigration.straightWires (noT (n := n) (start := start) P).prog, w ∈ ECDSAAdd.wires P := by
  intro w hw
  have hsub := noT_wires (n := n) (start := start) P (ECDSAAdd.wires P).toList (by simp)
  exact Finset.mem_toList.mp (hsub hw)

theorem noT_wellFormed {n start : Nat} (P : ECDSAAdd.Program) (hp : ECDSAAdd.Arithmetic.GatePhysical P) :
    (noT (n := n) (start := start) P).prog.WellFormed := by
  apply Bridge.translate_wellFormed
  intro i hi
  obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hi
  exact ECDSAAdd.Baselines.normalize_physical P hp j hj

theorem noT_removed18 {n start : Nat} (P : ECDSAAdd.Program) :
    removed 18 (noT (n := n) (start := start) P).prog = 0 :=
  removed18_zero_of_residue _ (WEXCredit.literal_residue _ _)

theorem noT_finish {n start : Nat} (P : ECDSAAdd.Program) :
    (noT (n := n) (start := start) P).finish = start + ECDSAAdd.measurementCount P := by
  simp only [noT, WEX.literal_meas, ECDSAAdd.Baselines.normalize_measurements]

theorem noT_catLitSim {n start : Nat} (y : Wire) (P : ECDSAAdd.Program)
    (hy : y ∉ ECDSAAdd.wires P) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim y ((noT (n := n) (start := start) P).prog.instantiate read h) P (fun _ => True) := by
  have hyf : Fresh y (noT (n := n) (start := start) P).prog :=
    fresh_of_not_mem_straightWires y _ (fun hm => hy (noT_wires_mem P y hm))
  have hcomm := fresh_prep_comm y _ hyf read h
  obtain ⟨cs, hal, hmass⟩ := WEX.literal_simulation (ECDSAAdd.Baselines.normalizeProgram P)
  have hrun : ((noT (n := n) (start := start) P).prog.instantiate read h).run =
      (WEX.literalSource (ECDSAAdd.Baselines.normalizeProgram P)).run :=
    WEX.literal_run (n := n) (ECDSAAdd.Baselines.normalizeProgram P) start read h
  rw [← hrun] at hal
  refine ⟨cs, ?_, hmass⟩
  have hmem := List.forall₂_iff_get.mp hal
  refine List.forall₂_iff_get.mpr ⟨hmem.1, fun i h1 h2 => ?_⟩
  obtain ⟨hl, hkr⟩ := hmem.2 i h1 h2
  refine ⟨(((noT P).prog.instantiate read h).run.get ⟨i, h1⟩).history,
    by rw [hl, ECDSAAdd.Baselines.normalize_measurements], fun st _ => ?_⟩
  rw [hcomm _ (List.get_mem _ ⟨i, h1⟩), hkr st, map_smul, ECDSAAdd.Baselines.normalize_run]

theorem compileProg_indep {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program) :
    Indep (compileProg (n := n) (start := start) q y P).prog := by
  intro read h₁ h₂
  have heq := compileLower_inst_indep q y
    (Bridge.translate (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) 0)
    start Fin.elim0 read h₁ h₂ (fun i => Fin.elim0 i)
  exact ⟨congrArg AdaptiveCircuit.run heq, congrArg AdaptiveCircuit.tCount heq⟩

theorem compileProg_tCount {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compileProg (n := n) (start := start) q y P).prog.instantiate read h).tCount ≤
      4 * ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram P) := by
  have h1 := compileLower_tCount q y
    (Bridge.translate (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) 0) start Fin.elim0 read h
  have h2 : ConditionalCatalyst.weight4
      (Bridge.translate (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) 0) =
      4 * ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram P) := by
    rw [ConditionalCatalyst.weight4_zero _ (WEXCredit.literal_residue _ _), WEXCredit.literal_added]
  exact h1.trans (le_of_eq h2)

theorem compileProg_slots {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program) :
    (compileProg (n := n) (start := start) q y P).prog.gateSlots ≤
      4 * (3 * ECDSAAdd.Challenge.gateSlots P + 18 * ECDSAAdd.toffoliCount P) := by
  have h1 := compileLower_slots q y
    (Bridge.translate (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) 0) start Fin.elim0
  have h2 : (Bridge.translate (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) 0).gateSlots ≤
      3 * ECDSAAdd.Challenge.gateSlots P := by
    rw [Bridge.translate_gateSlots]
    have hs := WEX.literal_slot_bound (n := n) (ECDSAAdd.Baselines.normalizeProgram P)
    rwa [ECDSAAdd.Baselines.normalize_slots] at hs
  have h3 : AndGadget.added (Bridge.translate (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) 0) ≤
      ECDSAAdd.toffoliCount P := by
    rw [WEXCredit.literal_added]
    exact ECDSAAdd.Baselines.normalize_toffoli P
  change (compileLower q y _ start Fin.elim0).program.gateSlots ≤ _
  omega

theorem compileProg_finish {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program) :
    (compileProg (n := n) (start := start) q y P).finish =
      start + ECDSAAdd.measurementCount P + ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram P) := by
  have h := compileLower_finish q y
    (Bridge.translate (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) 0) start Fin.elim0
  have hm : Bridge.tmplMeas (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) = ECDSAAdd.measurementCount P :=
    (WEX.literal_meas _).trans (ECDSAAdd.Baselines.normalize_measurements P)
  have ha : AndGadget.added (Bridge.translate (WEX.literalT (n := n) (ECDSAAdd.Baselines.normalizeProgram P)) 0) =
      ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram P) := WEXCredit.literal_added _ 0
  change (compileLower q y _ start Fin.elim0).finish = _
  omega

theorem compileProg_wires {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program) (S : List Wire)
    (hP : ECDSAAdd.wires P ⊆ S.toFinset) (hq : q ∈ S) (hy : y ∈ S) :
    ChallengeMigration.straightWires (compileProg (n := n) (start := start) q y P).prog ⊆ S := by
  apply compileLower_straightWires q y _ S _ hq hy start Fin.elim0
  apply WEX.literal_translate_support (n := n) (ECDSAAdd.Baselines.normalizeProgram P) S
  rwa [ECDSAAdd.Baselines.normalize_wires]

theorem compileProg_wellFormed {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (hq : q ∉ ECDSAAdd.wires P) (hy : y ∉ ECDSAAdd.wires P) (hqy : q ≠ y)
    (hp : ECDSAAdd.Arithmetic.GatePhysical P) :
    (compileProg (n := n) (start := start) q y P).prog.WellFormed := by
  apply compileLower_wellFormed q y _ start Fin.elim0
  · exact fresh_of_not_mem_straightWires q _ (fun hm => hq (noT_wires_mem (start := 0) P q hm))
  · exact fresh_of_not_mem_straightWires y _ (fun hm => hy (noT_wires_mem (start := 0) P y hm))
  · exact hqy
  · exact noT_wellFormed (start := 0) P hp

theorem compileProg_removed18 {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program) :
    removed 18 (compileProg (n := n) (start := start) q y P).prog = 0 := by
  rw [compileProg, compileLower_removed18]
  exact removed18_zero_of_residue _ (WEXCredit.literal_residue _ _)

theorem compileProg_catLitSim {n start : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (hq : q ∉ ECDSAAdd.wires P) (hy : y ∉ ECDSAAdd.wires P) (hqy : q ≠ y)
    (hp : ECDSAAdd.Arithmetic.GatePhysical P)
    (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim y ((compileProg (n := n) (start := start) q y P).prog.instantiate read h) P
      (fun s => s q = false ∧ s y = false) := by
  apply compileLower_catLitSim q y _ start Fin.elim0 read Fin.elim0 h (fun i => Fin.elim0 i)
    (noT_wellFormed (start := 0) P hp)
    (fresh_of_not_mem_straightWires q _ (fun hm => hq (noT_wires_mem (start := 0) P q hm)))
    (fresh_of_not_mem_straightWires y _ (fun hm => hy (noT_wires_mem (start := 0) P y hm)))
    hqy P _ (fun _ hs => hs)
  obtain ⟨cs, hal, hmass⟩ := WEX.literal_simulation (ECDSAAdd.Baselines.normalizeProgram P)
  rw [← WEX.literal_run (n := n) (ECDSAAdd.Baselines.normalizeProgram P) 0 read Fin.elim0] at hal
  refine ⟨cs, ?_, hmass⟩
  refine List.Forall₂.imp ?_ hal
  intro b c ⟨hl, hkr⟩
  exact ⟨b.history, by rw [hl, ECDSAAdd.Baselines.normalize_measurements],
    fun st _ => by rw [hkr st, ECDSAAdd.Baselines.normalize_run]⟩

end CatProg

theorem catLitSim_weaken {y : Wire} {C : AdaptiveCircuit} {P : ECDSAAdd.Program} {V₁ V₂ : BasisState → Prop}
    (h : CatLitSim y C P V₁) (himp : ∀ s, V₂ s → V₁ s) : CatLitSim y C P V₂ := by
  obtain ⟨cs, hal, hm⟩ := h
  exact ⟨cs, hal.imp (fun b c ⟨m, lm, hb⟩ => ⟨m, lm, fun st hst => hb st (himp _ hst)⟩), hm⟩

theorem catLitSim_congr_prog {y : Wire} {C : AdaptiveCircuit} {P₁ P₂ : ECDSAAdd.Program} {V : BasisState → Prop}
    (h : CatLitSim y C P₁ V)
    (hmc : ECDSAAdd.measurementCount P₁ = ECDSAAdd.measurementCount P₂)
    (hrun : ∀ st m, V st.basis → m.length = ECDSAAdd.measurementCount P₁ →
      ECDSAAdd.run P₁ m st = ECDSAAdd.run P₂ m st) :
    CatLitSim y C P₂ V := by
  obtain ⟨cs, hal, hm⟩ := h
  exact ⟨cs, hal.imp (fun b c ⟨m, lm, hb⟩ =>
    ⟨m, lm.trans hmc, fun st hst => by rw [hb st hst, hrun st m hst lm]⟩), hm⟩

theorem catLitSim_append {n start : Nat} {y : Wire}
    (a : CatProg n start) (b : CatProg n a.finish) (hb : Indep b.prog)
    (read : ConstantBit n → Bool) (h : Fin start → Bool)
    (P₁ P₂ : ECDSAAdd.Program) (V₁ V₂ : BasisState → Prop)
    (ha : CatLitSim y (a.prog.instantiate read h) P₁ V₁)
    (hbb : ∀ h', CatLitSim y (b.prog.instantiate read h') P₂ V₂)
    (hstep : ∀ st m, V₁ st.basis → m.length = ECDSAAdd.measurementCount P₁ → V₂ (ECDSAAdd.run P₁ m st).basis) :
    CatLitSim y ((a.append b).prog.instantiate read h) (P₁ ++ P₂) V₁ := by
  have hseq := catLitSim_seq ha (hbb (fun _ => false)) hstep
  obtain ⟨cs, hal, hm⟩ := hseq
  refine ⟨cs, ?_, hm⟩
  rw [CatProg.append, indep_append_run a.prog b.prog hb read h]
  exact hal

theorem catLitSim_lit_unitary {n start : Nat} {y : Wire}
    (gs : Circuit) (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hm0 : ECDSAAdd.measurementCount P = 0)
    (hket : ∀ st : ECDSAAdd.State, V st.basis →
      Quantum.run gs (Prep y (Bridge.signedKet st)) = Prep y (Bridge.signedKet (ECDSAAdd.run P List.nil st)))
    (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim y ((CatProg.lit gs).prog.instantiate read h) P V := by
  refine ⟨[1], ?_, by simp⟩
  rw [CatProg.lit_run]
  refine .cons ⟨[], by simp [hm0], fun st hst => ?_⟩ .nil
  simpa only [one_smul] using hket st hst

theorem signedKet_smul_eq (ph : Bool) (bs : BasisState) :
    Bridge.signedKet ⟨ph, bs⟩ = (if ph then (-1 : ℂ) else 1) • ket bs := by
  cases ph <;> simp [Bridge.signedKet]

theorem catLitSim_swap_surround {n start : Nat} {y₁ y₂ : Wire}
    (hne : y₁ ≠ y₂) (body : CatProg n start) (hbi : Indep body.prog)
    (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (read : ConstantBit n → Bool) (h : Fin start → Bool)
    (hsim : ∀ h', CatLitSim y₂ (body.prog.instantiate read h') P V)
    (hclean_in : ∀ s, V s → s y₁ = false ∧ s y₂ = false)
    (hclean_out : ∀ st m, V st.basis → m.length = ECDSAAdd.measurementCount P →
      (ECDSAAdd.run P m st).basis y₁ = false ∧ (ECDSAAdd.run P m st).basis y₂ = false) :
    CatLitSim y₁
      ((((CatProg.lit (swapCircuit y₁ y₂)).append body).append (CatProg.lit (swapCircuit y₂ y₁))).prog.instantiate read h)
      P V := by
  have hrun_eq :
      ((((CatProg.lit (n := n) (start := start) (swapCircuit y₁ y₂)).append body).append
          (CatProg.lit (n := n) (start := body.finish) (swapCircuit y₂ y₁))).prog.instantiate read h).run =
        (((CatProg.lit (n := n) (start := start) (swapCircuit y₁ y₂)).prog.instantiate read h).seq
          ((body.prog.instantiate read (fun _ => false)).seq
            ((CatProg.lit (n := n) (start := body.finish) (swapCircuit y₂ y₁)).prog.instantiate read (fun _ => false)))).run := by
    rw [CatProg.append, indep_append_run _ _ (CatProg.lit_indep _) read h,
      AdaptiveCircuit.run_seq, CatProg.append, indep_append_run _ _ hbi read h,
      AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq]
    simp only [Instrument.seq, List.flatMap_assoc, List.flatMap_map, List.map_flatMap, List.map_map, Function.comp_def]
    apply List.flatMap_congr; intro x _; apply List.flatMap_congr; intro y _; apply List.map_congr_left; intro z _
    rcases x with ⟨xh, xk⟩; rcases y with ⟨yh, yk⟩; rcases z with ⟨zh, zk⟩
    simp [InstrumentBranch.seq, LinearMap.comp_assoc, List.append_assoc]
  obtain ⟨cs, hal, hm⟩ := hsim (fun _ => false)
  refine ⟨cs, ?_, hm⟩
  have hfm : ∀ l : List InstrumentBranch,
      l.flatMap (fun before => [before.seq ⟨[], Quantum.run (swapCircuit y₂ y₁)⟩]) =
        l.map (fun before => before.seq ⟨[], Quantum.run (swapCircuit y₂ y₁)⟩) := fun l => by
    induction l <;> simp [*]
  rw [hrun_eq, AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq, CatProg.lit_run, CatProg.lit_run]
  simp only [Instrument.seq, List.flatMap_cons, List.flatMap_nil, List.append_nil, List.map_singleton]
  rw [hfm, List.map_map, List.forall₂_map_left_iff]
  refine hal.imp ?_
  intro br c ⟨m, lm, hbr⟩
  refine ⟨m, lm, fun st hst => ?_⟩
  change Quantum.run (swapCircuit y₂ y₁) (br.kraus (Quantum.run (swapCircuit y₁ y₂) (Prep y₁ (Bridge.signedKet st)))) = _
  have hci := hclean_in st.basis hst
  have hco := hclean_out st m hst lm
  have hsw1 : Quantum.run (swapCircuit y₁ y₂) (Prep y₁ (Bridge.signedKet st)) = Prep y₂ (Bridge.signedKet st) := by
    rw [signedKet_smul_eq, map_smul, map_smul, map_smul, swapCircuit_prep_ket y₁ y₂ hne _ hci.1 hci.2]
  have hsw2 : Quantum.run (swapCircuit y₂ y₁) (Prep y₂ (Bridge.signedKet (ECDSAAdd.run P m st))) =
      Prep y₁ (Bridge.signedKet (ECDSAAdd.run P m st)) := by
    rw [signedKet_smul_eq, map_smul, map_smul, map_smul, swapCircuit_prep_ket y₂ y₁ hne.symm _ hco.2 hco.1]
  rw [hsw1, hbr st hst, map_smul, hsw2]

theorem catLitSim_flipSwap_surround {n start : Nat} {y w : Wire}
    (hne : y ≠ w) (body : CatProg n start) (hbi : Indep body.prog)
    (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (read : ConstantBit n → Bool) (h : Fin start → Bool)
    (hwP : w ∉ ECDSAAdd.wires P)
    (hsim : ∀ h', CatLitSim w (body.prog.instantiate read h') P (fun bs => ∃ bs0, V bs0 ∧ bs = bs0[w ↦ false]))
    (hclean_in : ∀ s, V s → s y = false ∧ s w = true)
    (hclean_out : ∀ st m, V st.basis → m.length = ECDSAAdd.measurementCount P →
      (ECDSAAdd.run P m st).basis y = false) :
    CatLitSim y
      ((((CatProg.lit (flipSwapCircuit y w)).append body).append (CatProg.lit (unflipSwapCircuit y w))).prog.instantiate read h)
      P V := by
  have hrun_eq :
      ((((CatProg.lit (n := n) (start := start) (flipSwapCircuit y w)).append body).append
          (CatProg.lit (n := n) (start := body.finish) (unflipSwapCircuit y w))).prog.instantiate read h).run =
        (((CatProg.lit (n := n) (start := start) (flipSwapCircuit y w)).prog.instantiate read h).seq
          ((body.prog.instantiate read (fun _ => false)).seq
            ((CatProg.lit (n := n) (start := body.finish) (unflipSwapCircuit y w)).prog.instantiate read (fun _ => false)))).run := by
    rw [CatProg.append, indep_append_run _ _ (CatProg.lit_indep _) read h,
      AdaptiveCircuit.run_seq, CatProg.append, indep_append_run _ _ hbi read h,
      AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq]
    simp only [Instrument.seq, List.flatMap_assoc, List.flatMap_map, List.map_flatMap, List.map_map, Function.comp_def]
    apply List.flatMap_congr; intro x _; apply List.flatMap_congr; intro y _; apply List.map_congr_left; intro z _
    rcases x with ⟨xh, xk⟩; rcases y with ⟨yh, yk⟩; rcases z with ⟨zh, zk⟩
    simp [InstrumentBranch.seq, LinearMap.comp_assoc, List.append_assoc]
  obtain ⟨cs, hal, hm⟩ := hsim (fun _ => false)
  refine ⟨cs, ?_, hm⟩
  have hfm : ∀ l : List InstrumentBranch,
      l.flatMap (fun before => [before.seq ⟨[], Quantum.run (unflipSwapCircuit y w)⟩]) =
        l.map (fun before => before.seq ⟨[], Quantum.run (unflipSwapCircuit y w)⟩) := fun l => by
    induction l <;> simp [*]
  rw [hrun_eq, AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq, CatProg.lit_run, CatProg.lit_run]
  simp only [Instrument.seq, List.flatMap_cons, List.flatMap_nil, List.append_nil, List.map_singleton]
  rw [hfm, List.map_map, List.forall₂_map_left_iff]
  refine hal.imp ?_
  intro br c ⟨m, lm, hbr⟩
  refine ⟨m, lm, fun st hst => ?_⟩
  change Quantum.run (unflipSwapCircuit y w)
    (br.kraus (Quantum.run (flipSwapCircuit y w) (Prep y (Bridge.signedKet st)))) = _
  have hci := hclean_in st.basis hst
  let st' : ECDSAAdd.State := ⟨st.phase, st.basis[w ↦ false]⟩
  have hsw1 : Quantum.run (flipSwapCircuit y w) (Prep y (Bridge.signedKet st)) = Prep w (Bridge.signedKet st') := by
    rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, map_smul, map_smul, flipSwapCircuit_prep_ket y w hne _ hci.1 hci.2]
  have hag : ∀ u ∈ ECDSAAdd.wires P, st'.basis u = st.basis u := fun u hu => by
    have huw : u ≠ w := fun e => hwP (e ▸ hu)
    simp [st', upd, huw]
  have hinc := ECDSAAdd.Arithmetic.pool_run_agrees P (ECDSAAdd.wires P) (Finset.Subset.refl _) m st' st rfl hag
  have hph : (ECDSAAdd.run P m st').phase = (ECDSAAdd.run P m st).phase := hinc.1
  have hbas : ∀ u, u ≠ w → (ECDSAAdd.run P m st').basis u = (ECDSAAdd.run P m st).basis u := by
    intro u hu
    by_cases hmem : u ∈ ECDSAAdd.wires P
    · exact hinc.2 u hmem
    · rw [ECDSAAdd.run_preserves_outside P m st' u hmem, ECDSAAdd.run_preserves_outside P m st u hmem]
      simp [st', upd, hu]
  have hw0 : (ECDSAAdd.run P m st').basis w = false := by
    rw [ECDSAAdd.run_preserves_outside P m st' w hwP]; simp [st', upd]
  have hw1 : (ECDSAAdd.run P m st).basis w = true := by
    rw [ECDSAAdd.run_preserves_outside P m st w hwP]; exact hci.2
  have hy0 : (ECDSAAdd.run P m st').basis y = false :=
    (hbas y hne).trans (hclean_out st m hst lm)
  have hback : (ECDSAAdd.run P m st').basis[w ↦ true] = (ECDSAAdd.run P m st).basis := by
    funext u; by_cases hu : u = w
    · subst hu; simp [upd, hw1]
    · simp [upd, hu, hbas u hu]
  rw [hsw1, hbr st' ⟨st.basis, hst, rfl⟩, map_smul, signedKet_smul_eq, map_smul, map_smul,
    unflipSwapCircuit_prep_ket y w hne _ hy0 hw0, hback, hph, ← map_smul, ← signedKet_smul_eq]

/-- Drop a fresh wire-bit hypothesis `s x = true` from `CatLitSim` when `x` is untouched by both programs. -/
theorem catLitSim_drop_bit {n s e : Nat} {y x : Wire} (hne : x ≠ y)
    (p : Straight n s e) (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hxp : Fresh x p) (hxP : x ∉ ECDSAAdd.wires P)
    (hV : ∀ bs, V bs → V (bs[x ↦ true]))
    (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (hsim : CatLitSim y (p.instantiate read h) P (fun bs => V bs ∧ bs x = true)) :
    CatLitSim y (p.instantiate read h) P V := by
  obtain ⟨cs, hal, hm⟩ := hsim
  refine ⟨cs, ?_, hm⟩
  have hcomm := fresh_x_comm x p hxp read h
  have hmem := List.forall₂_iff_get.mp hal
  refine List.forall₂_iff_get.mpr ⟨hmem.1, fun i h1 h2 => ?_⟩
  obtain ⟨m, lm, hbr⟩ := hmem.2 i h1 h2
  refine ⟨m, lm, fun st hst => ?_⟩
  by_cases hx : st.basis x = true
  · exact hbr st ⟨hst, hx⟩
  · have hxf : st.basis x = false := Bool.eq_false_iff.mpr hx
    let st1 : ECDSAAdd.State := ⟨st.phase, st.basis[x ↦ true]⟩
    have hst1 : V st1.basis ∧ st1.basis x = true := ⟨hV st.basis hst, by simp [st1, upd]⟩
    have hxket : applyGate (.X x) (Bridge.signedKet st1) = Bridge.signedKet st := by
      rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, applyGate_X_ket]
      congr 2; funext w; by_cases hw : w = x
      · rw [hw]; simp [st1, upd, hxf]
      · simp [st1, upd, hw]
    have hpx : Prep y (applyGate (.X x) (Bridge.signedKet st1)) = applyGate (.X x) (Prep y (Bridge.signedKet st1)) :=
      (Catalyst.prepare_gate y (.X x) (by simp [gateWires, hne.symm]) _).symm
    have hrun1 : ECDSAAdd.run P m st1 = ⟨(ECDSAAdd.run P m st).phase, (ECDSAAdd.run P m st).basis[x ↦ true]⟩ := by
      have hag : ∀ u ∈ ECDSAAdd.wires P, st1.basis u = st.basis u := fun u hu => by
        have hux : u ≠ x := fun e => hxP (e ▸ hu)
        simp [st1, upd, hux]
      have hinc := ECDSAAdd.Arithmetic.pool_run_agrees P (ECDSAAdd.wires P) (Finset.Subset.refl _) m st1 st rfl hag
      apply ECDSAAdd.State.extensionality
      · exact hinc.1
      · funext u; by_cases hu : u = x
        · rw [hu, ECDSAAdd.run_preserves_outside P m st1 x hxP]; simp [st1, upd]
        · simp only [upd, hu, if_false]
          by_cases hmem : u ∈ ECDSAAdd.wires P
          · exact hinc.2 u hmem
          · rw [ECDSAAdd.run_preserves_outside P m st1 u hmem, ECDSAAdd.run_preserves_outside P m st u hmem]
            simp [st1, upd, hu]
    have hxout : (ECDSAAdd.run P m st).basis x = false := by
      rw [ECDSAAdd.run_preserves_outside P m st x hxP]; exact hxf
    have hxket2 : applyGate (.X x) (Bridge.signedKet (ECDSAAdd.run P m st1)) =
        Bridge.signedKet (ECDSAAdd.run P m st) := by
      rw [hrun1, signedKet_smul_eq, signedKet_smul_eq, map_smul, applyGate_X_ket]
      congr 2; funext w; by_cases hw : w = x
      · rw [hw]; simp [upd, hxout]
      · simp [upd, hw]
    have hbr1 := hbr st1 hst1
    rw [← hxket, hpx, hcomm _ (List.get_mem _ ⟨i, h1⟩), hbr1, map_smul,
      Catalyst.prepare_gate y (.X x) (by simp [gateWires, hne.symm]), hxket2]

/-- Generalize `CatLitSim` across any list of fresh wires untouched by both `p` and `P`. -/
theorem catLitSim_agree_list {n s e : Nat} {y : Wire} (xs : List Wire)
    (hne : ∀ x ∈ xs, x ≠ y)
    (p : Straight n s e) (P : ECDSAAdd.Program) (V V' : BasisState → Prop)
    (hxp : ∀ x ∈ xs, Fresh x p) (hxP : ∀ x ∈ xs, x ∉ ECDSAAdd.wires P)
    (hagree : ∀ bs, V' bs → ∃ bs0, V bs0 ∧ ∀ q, q ∉ xs → bs q = bs0 q)
    (read : ConstantBit n → Bool) (h : Fin s → Bool)
    (hsim : CatLitSim y (p.instantiate read h) P V) :
    CatLitSim y (p.instantiate read h) P V' := by
  obtain ⟨cs, hal, hm⟩ := hsim
  refine ⟨cs, ?_, hm⟩
  have hmem := List.forall₂_iff_get.mp hal
  refine List.forall₂_iff_get.mpr ⟨hmem.1, fun i h1 h2 => ?_⟩
  obtain ⟨m, lm, hbr⟩ := hmem.2 i h1 h2
  refine ⟨m, lm, fun st hst' => ?_⟩
  obtain ⟨bs0, hbs0, hag0⟩ := hagree st.basis hst'
  have hstep : ∀ (zs : List Wire),
      (∀ x ∈ zs, x ≠ y) → (∀ x ∈ zs, Fresh x p) → (∀ x ∈ zs, x ∉ ECDSAAdd.wires P) →
      ∀ (s1 : ECDSAAdd.State), (∀ q, q ∉ zs → s1.basis q = bs0 q) →
      ((p.instantiate read h).run.get ⟨i, h1⟩).kraus (Prep y (Bridge.signedKet s1)) =
        (cs.get ⟨i, h2⟩) • Prep y (Bridge.signedKet (ECDSAAdd.run P m s1)) := by
    intro zs
    induction zs with
    | nil =>
      intro _ _ _ s1 hs1
      have heq : s1 = ⟨s1.phase, bs0⟩ := by
        apply ECDSAAdd.State.extensionality
        · rfl
        · funext q; exact hs1 q (by simp)
      rw [heq]; exact hbr ⟨s1.phase, bs0⟩ hbs0
    | cons x rest ih =>
      intro hneZ hxpZ hxPZ s1 hs1
      have hxy : x ≠ y := hneZ x List.mem_cons_self
      have hfx : Fresh x p := hxpZ x List.mem_cons_self
      have hxoutP : x ∉ ECDSAAdd.wires P := hxPZ x List.mem_cons_self
      let s2 : ECDSAAdd.State := ⟨s1.phase, s1.basis[x ↦ bs0 x]⟩
      have hs2_ag : ∀ q, q ∉ rest → s2.basis q = bs0 q := fun q hq => by
        by_cases hqx : q = x
        · subst hqx; simp [s2, upd]
        · simp only [s2, upd, hqx, if_false]; exact hs1 q (by simp [hqx, hq])
      have hbr2 := ih (fun z hz => hneZ z (List.mem_cons_of_mem _ hz))
        (fun z hz => hxpZ z (List.mem_cons_of_mem _ hz))
        (fun z hz => hxPZ z (List.mem_cons_of_mem _ hz)) s2 hs2_ag
      by_cases hsame : s1.basis x = bs0 x
      · have heq : s2 = s1 := by
          apply ECDSAAdd.State.extensionality
          · rfl
          · funext q; by_cases hqx : q = x
            · subst hqx; simp [s2, upd, hsame]
            · simp [s2, upd, hqx]
        rwa [heq] at hbr2
      · have hcomm := fresh_x_comm x p hfx read h
        have hflip : (!bs0 x) = s1.basis x := by
          cases hb : bs0 x <;> cases hs : s1.basis x <;> simp_all
        have hxket : applyGate (.X x) (Bridge.signedKet s2) = Bridge.signedKet s1 := by
          rw [signedKet_smul_eq, signedKet_smul_eq, map_smul, applyGate_X_ket]
          congr 2; funext w; by_cases hw : w = x
          · subst hw; simp [s2, upd, hflip]
          · simp [s2, upd, hw]
        have hpx : Prep y (applyGate (.X x) (Bridge.signedKet s2)) = applyGate (.X x) (Prep y (Bridge.signedKet s2)) :=
          (Catalyst.prepare_gate y (.X x) (by simp [gateWires, hxy.symm]) _).symm
        have hrun2 : ECDSAAdd.run P m s2 = ⟨(ECDSAAdd.run P m s1).phase, (ECDSAAdd.run P m s1).basis[x ↦ bs0 x]⟩ := by
          have hagP : ∀ u ∈ ECDSAAdd.wires P, s2.basis u = s1.basis u := fun u hu => by
            have hux : u ≠ x := fun e => hxoutP (e ▸ hu)
            simp [s2, upd, hux]
          have hinc := ECDSAAdd.Arithmetic.pool_run_agrees P (ECDSAAdd.wires P) (Finset.Subset.refl _) m s2 s1 rfl hagP
          apply ECDSAAdd.State.extensionality
          · exact hinc.1
          · funext u; by_cases hu : u = x
            · rw [hu, ECDSAAdd.run_preserves_outside P m s2 x hxoutP]; simp [s2, upd]
            · simp only [upd, hu, if_false]
              by_cases hmemP : u ∈ ECDSAAdd.wires P
              · exact hinc.2 u hmemP
              · rw [ECDSAAdd.run_preserves_outside P m s2 u hmemP, ECDSAAdd.run_preserves_outside P m s1 u hmemP]
                simp [s2, upd, hu]
        have hxout : (ECDSAAdd.run P m s1).basis x = s1.basis x :=
          ECDSAAdd.run_preserves_outside P m s1 x hxoutP
        have hxket2 : applyGate (.X x) (Bridge.signedKet (ECDSAAdd.run P m s2)) =
            Bridge.signedKet (ECDSAAdd.run P m s1) := by
          rw [hrun2, signedKet_smul_eq, signedKet_smul_eq, map_smul, applyGate_X_ket]
          congr 2; funext w; by_cases hw : w = x
          · subst hw; simp [upd, hflip, hxout]
          · simp [upd, hw]
        rw [← hxket, hpx, hcomm _ (List.get_mem _ ⟨i, h1⟩), hbr2, map_smul,
          Catalyst.prepare_gate y (.X x) (by simp [gateWires, hxy.symm]), hxket2]
  exact hstep xs hne hxp hxP st hag0

end
end ShorECDLP.Entrant.LocalFour
end

/-! ### Local 4-T Kernel Compiler (`LocalKernel`, Part 1: Ripple Adders, Comparators, and Cell Kernels) -/
section
namespace ShorECDLP.Entrant.LocalKernel
open Quantum Challenge AndGadget ConditionalCatalyst ApproximatePhase34 LocalFour
open Paper2607_13816 Paper2607_13816.ChallengeMigration
open ECDSAAdd ECDSAAdd.Arithmetic ECDSAAdd.Frontier
noncomputable section
set_option maxHeartbeats 400000
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySimpa false
set_option linter.unusedVariables false

attribute [local irreducible] Quantum.run Quantum.applyGate Quantum.ket

/-! #### 0. Start-parameterized `CatFn` combinators (O(1) term size, zero kernel unfolding) -/

abbrev CatFn (n : Nat) := (start : Nat) → CatProg n start

/-- Shift-invariant finish with a concrete upper bound on added measurements. -/
def ShiftFin {n : Nat} (f : CatFn n) (B : Nat) : Prop :=
  (∀ s, (f s).finish = s + (f 0).finish) ∧ (f 0).finish ≤ B

theorem ShiftFin.mono {n : Nat} {f : CatFn n} {B₁ B₂ : Nat} (h : ShiftFin f B₁) (hle : B₁ ≤ B₂) :
    ShiftFin f B₂ := ⟨h.1, h.2.trans hle⟩

theorem ShiftFin.of_exact {n : Nat} {f : CatFn n} {d B : Nat}
    (heq : ∀ s, (f s).finish = s + d) (hle : d ≤ B) : ShiftFin f B := by
  have h0 : (f 0).finish = d := by simpa using heq 0
  exact ⟨fun s => by rw [heq s, h0], h0 ▸ hle⟩

namespace CatFn

def lit {n : Nat} (gs : Circuit) : CatFn n :=
  fun start => CatProg.lit (n := n) (start := start) gs

def noT {n : Nat} (P : ECDSAAdd.Program) : CatFn n :=
  fun start => CatProg.noT (n := n) (start := start) P

def compileProg {n : Nat} (q y : Wire) (P : ECDSAAdd.Program) : CatFn n :=
  fun start => CatProg.compileProg (n := n) (start := start) q y P

def seq {n : Nat} (a b : CatFn n) : CatFn n :=
  fun start =>
    let pa := a start
    pa.append (b pa.finish)

def map {n : Nat} (f : Wire → Wire) (a : CatFn n) : CatFn n :=
  fun start => (a start).map f

def swapSurround {n : Nat} (y₁ y₂ : Wire) (body : CatFn n) : CatFn n :=
  seq (seq (lit (swapCircuit y₁ y₂)) body) (lit (swapCircuit y₂ y₁))

def flipSwapSurround {n : Nat} (y w : Wire) (body : CatFn n) : CatFn n :=
  seq (seq (lit (flipSwapCircuit y w)) body) (lit (unflipSwapCircuit y w))

-- `lit` lemmas
theorem lit_indep {n : Nat} (gs : Circuit) (s : Nat) : Indep (lit (n := n) gs s).prog :=
  CatProg.lit_indep gs

theorem lit_removed18 {n : Nat} (gs : Circuit)
    (h : (gs.map (fun g => (largePhase 18 g).toNat)).sum = 0) (s : Nat) :
    removed 18 (lit (n := n) gs s).prog = 0 := by
  rw [lit, CatProg.lit_removed, h]

theorem lit_finish {n : Nat} (gs : Circuit) (s : Nat) : (lit (n := n) gs s).finish = s + 0 := rfl

theorem lit_shiftFin {n : Nat} (gs : Circuit) : ShiftFin (lit (n := n) gs) 0 :=
  ⟨fun _ => rfl, le_rfl⟩

theorem lit_tCount {n : Nat} (gs : Circuit) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((lit (n := n) gs s).prog.instantiate read h).tCount = ShorECDLP.tCount gs :=
  CatProg.lit_tCount gs read h

theorem lit_slots {n : Nat} (gs : Circuit) (s : Nat) : (lit (n := n) gs s).prog.gateSlots ≤ gs.length :=
  le_of_eq (CatProg.lit_slots gs)

theorem lit_wires {n : Nat} (gs : Circuit) {S : List Wire} (h : circuitWires gs ⊆ S) (s : Nat) :
    ChallengeMigration.straightWires (lit (n := n) gs s).prog ⊆ S := by
  rw [lit, CatProg.lit_wires]; exact h

theorem lit_wellFormed {n : Nat} (gs : Circuit) (hw : CircuitWellFormed gs) (s : Nat) :
    (lit (n := n) gs s).prog.WellFormed := CatProg.lit_wellFormed gs hw

theorem lit_catLitSim {n : Nat} {y : Wire} (gs : Circuit) (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hm0 : ECDSAAdd.measurementCount P = 0)
    (hket : ∀ st : ECDSAAdd.State, V st.basis →
      Quantum.run gs (Prep y (Bridge.signedKet st)) = Prep y (Bridge.signedKet (ECDSAAdd.run P List.nil st)))
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim y ((lit (n := n) gs s).prog.instantiate read h) P V :=
  catLitSim_lit_unitary gs P V hm0 hket read h

-- `noT` lemmas
theorem noT_indep {n : Nat} (P : ECDSAAdd.Program) (s : Nat) : Indep (noT (n := n) P s).prog :=
  CatProg.noT_indep P

theorem noT_removed18 {n : Nat} (P : ECDSAAdd.Program) (s : Nat) : removed 18 (noT (n := n) P s).prog = 0 :=
  CatProg.noT_removed18 P

theorem noT_finish {n : Nat} (P : ECDSAAdd.Program) (s : Nat) :
    (noT (n := n) P s).finish = s + ECDSAAdd.measurementCount P :=
  CatProg.noT_finish P

theorem noT_shiftFin {n : Nat} (P : ECDSAAdd.Program) : ShiftFin (noT (n := n) P) (ECDSAAdd.measurementCount P) :=
  ShiftFin.of_exact (noT_finish P) le_rfl

theorem noT_tCount {n : Nat} (P : ECDSAAdd.Program) (h0 : ECDSAAdd.toffoliCount P = 0)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((noT (n := n) P s).prog.instantiate read h).tCount ≤ 0 := by
  rw [noT, CatProg.noT_tCount]
  have hn := ECDSAAdd.Baselines.normalize_toffoli P
  omega

theorem noT_slots {n : Nat} (P : ECDSAAdd.Program) (s : Nat) :
    (noT (n := n) P s).prog.gateSlots ≤ 3 * ECDSAAdd.Challenge.gateSlots P :=
  CatProg.noT_slots P

theorem noT_wires {n : Nat} (P : ECDSAAdd.Program) {S : List Wire} (hP : ECDSAAdd.wires P ⊆ S.toFinset) (s : Nat) :
    ChallengeMigration.straightWires (noT (n := n) P s).prog ⊆ S :=
  CatProg.noT_wires P S hP

theorem noT_wellFormed {n : Nat} (P : ECDSAAdd.Program) (hp : ECDSAAdd.Arithmetic.GatePhysical P) (s : Nat) :
    (noT (n := n) P s).prog.WellFormed :=
  CatProg.noT_wellFormed P hp

theorem noT_catLitSim {n : Nat} (y : Wire) (P : ECDSAAdd.Program) (hy : y ∉ ECDSAAdd.wires P)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim y ((noT (n := n) P s).prog.instantiate read h) P (fun _ => True) :=
  CatProg.noT_catLitSim y P hy read h

-- `compileProg` lemmas
theorem compileProg_indep {n : Nat} (q y : Wire) (P : ECDSAAdd.Program) (s : Nat) :
    Indep (compileProg (n := n) q y P s).prog :=
  CatProg.compileProg_indep q y P

theorem compileProg_removed18 {n : Nat} (q y : Wire) (P : ECDSAAdd.Program) (s : Nat) :
    removed 18 (compileProg (n := n) q y P s).prog = 0 :=
  CatProg.compileProg_removed18 q y P

theorem compileProg_shiftFin {n : Nat} (q y : Wire) (P : ECDSAAdd.Program) :
    ShiftFin (compileProg (n := n) q y P) (ECDSAAdd.measurementCount P + ECDSAAdd.toffoliCount P) := by
  refine ShiftFin.of_exact (d := ECDSAAdd.measurementCount P + ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram P))
    (fun s => by rw [compileProg, CatProg.compileProg_finish]; omega) ?_
  have hn := ECDSAAdd.Baselines.normalize_toffoli P
  omega

theorem compileProg_tCount {n : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compileProg (n := n) q y P s).prog.instantiate read h).tCount ≤ 4 * ECDSAAdd.toffoliCount P := by
  have h1 := CatProg.compileProg_tCount (n := n) (start := s) q y P read h
  have h2 := ECDSAAdd.Baselines.normalize_toffoli P
  exact h1.trans (Nat.mul_le_mul_left 4 h2)

theorem compileProg_slots {n : Nat} (q y : Wire) (P : ECDSAAdd.Program) (s : Nat) :
    (compileProg (n := n) q y P s).prog.gateSlots ≤
      4 * (3 * ECDSAAdd.Challenge.gateSlots P + 18 * ECDSAAdd.toffoliCount P) :=
  CatProg.compileProg_slots q y P

theorem compileProg_wires {n : Nat} (q y : Wire) (P : ECDSAAdd.Program) {S : List Wire}
    (hP : ECDSAAdd.wires P ⊆ S.toFinset) (hq : q ∈ S) (hy : y ∈ S) (s : Nat) :
    ChallengeMigration.straightWires (compileProg (n := n) q y P s).prog ⊆ S :=
  CatProg.compileProg_wires q y P S hP hq hy

theorem compileProg_wellFormed {n : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (hq : q ∉ ECDSAAdd.wires P) (hy : y ∉ ECDSAAdd.wires P) (hqy : q ≠ y)
    (hp : ECDSAAdd.Arithmetic.GatePhysical P) (s : Nat) :
    (compileProg (n := n) q y P s).prog.WellFormed :=
  CatProg.compileProg_wellFormed q y P hq hy hqy hp

theorem compileProg_catLitSim {n : Nat} (q y : Wire) (P : ECDSAAdd.Program)
    (hq : q ∉ ECDSAAdd.wires P) (hy : y ∉ ECDSAAdd.wires P) (hqy : q ≠ y)
    (hp : ECDSAAdd.Arithmetic.GatePhysical P) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim y ((compileProg (n := n) q y P s).prog.instantiate read h) P (fun bs => bs q = false ∧ bs y = false) :=
  CatProg.compileProg_catLitSim q y P hq hy hqy hp read h

-- `seq` lemmas
theorem seq_indep {n : Nat} (a b : CatFn n)
    (ha : ∀ s, Indep (a s).prog) (hb : ∀ s, Indep (b s).prog) (s : Nat) :
    Indep (seq a b s).prog :=
  indep_append (a s).prog (b (a s).finish).prog (ha s) (hb (a s).finish)

theorem seq_removed18 {n : Nat} (a b : CatFn n)
    (ha : ∀ s, removed 18 (a s).prog = 0) (hb : ∀ s, removed 18 (b s).prog = 0) (s : Nat) :
    removed 18 (seq a b s).prog = 0 := by
  simp only [seq, CatProg.append, LocalFour.removed_append, ha, hb]

theorem seq_shiftFin {n : Nat} (a b : CatFn n) {Ba Bb : Nat}
    (ha : ShiftFin a Ba) (hb : ShiftFin b Bb) : ShiftFin (seq a b) (Ba + Bb) := by
  have h0 : (seq a b 0).finish = (a 0).finish + (b 0).finish := by
    change (b (a 0).finish).finish = _; exact hb.1 (a 0).finish
  refine ⟨fun s => ?_, by rw [h0]; exact Nat.add_le_add ha.2 hb.2⟩
  change (b (a s).finish).finish = s + (seq a b 0).finish
  rw [hb.1 (a s).finish, ha.1 s, h0]; omega

theorem seq_tCount_le {n : Nat} (a b : CatFn n) {ta tb : Nat}
    (hbi : ∀ s, Indep (b s).prog)
    (ha : ∀ s read h, ((a s).prog.instantiate read h).tCount ≤ ta)
    (hb : ∀ s read h, ((b s).prog.instantiate read h).tCount ≤ tb)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((seq a b s).prog.instantiate read h).tCount ≤ ta + tb := by
  rw [seq, CatProg.append, indep_append_tCount _ _ (hbi _)]
  exact Nat.add_le_add (ha s read h) (hb _ read _)

theorem seq_slots {n : Nat} (a b : CatFn n) {sa sb : Nat}
    (ha : ∀ s, (a s).prog.gateSlots ≤ sa) (hb : ∀ s, (b s).prog.gateSlots ≤ sb) (s : Nat) :
    (seq a b s).prog.gateSlots ≤ sa + sb := by
  rw [seq, CatProg.append, Straight.gateSlots_append]
  exact Nat.add_le_add (ha s) (hb _)

theorem seq_wires {n : Nat} (a b : CatFn n) {S : List Wire}
    (ha : ∀ s, ChallengeMigration.straightWires (a s).prog ⊆ S)
    (hb : ∀ s, ChallengeMigration.straightWires (b s).prog ⊆ S) (s : Nat) :
    ChallengeMigration.straightWires (seq a b s).prog ⊆ S := by
  rw [seq, CatProg.append, straightWires_append, List.append_subset]
  exact ⟨ha s, hb _⟩

theorem seq_wellFormed {n : Nat} (a b : CatFn n)
    (ha : ∀ s, (a s).prog.WellFormed) (hb : ∀ s, (b s).prog.WellFormed) (s : Nat) :
    (seq a b s).prog.WellFormed :=
  straight_append_wellFormed _ _ (ha s) (hb _)

theorem seq_catLitSim {n : Nat} {y : Wire} (a b : CatFn n)
    (hbi : ∀ s, Indep (b s).prog) (P₁ P₂ : ECDSAAdd.Program) (V₁ V₂ : BasisState → Prop)
    (ha : ∀ s read h, CatLitSim y ((a s).prog.instantiate read h) P₁ V₁)
    (hb : ∀ s read h, CatLitSim y ((b s).prog.instantiate read h) P₂ V₂)
    (hstep : ∀ st m, V₁ st.basis → m.length = ECDSAAdd.measurementCount P₁ → V₂ (ECDSAAdd.run P₁ m st).basis)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim y ((seq a b s).prog.instantiate read h) (P₁ ++ P₂) V₁ :=
  catLitSim_append (a s) (b (a s).finish) (hbi _) read h P₁ P₂ V₁ V₂ (ha s read h) (fun h' => hb _ read h') hstep

-- `map` lemmas
theorem map_indep {n : Nat} (f : Wire → Wire) (a : CatFn n)
    (ha : ∀ s, Indep (a s).prog)
    (hinj : ∀ s, ∀ x ∈ ChallengeMigration.straightWires (a s).prog,
      ∀ y ∈ ChallengeMigration.straightWires (a s).prog, f x = f y → x = y) (s : Nat) :
    Indep (map f a s).prog :=
  indep_mapStraight f (a s).prog (ha s) (hinj s)

theorem map_removed18 {n : Nat} (f : Wire → Wire) (a : CatFn n)
    (ha : ∀ s, removed 18 (a s).prog = 0) (s : Nat) :
    removed 18 (map f a s).prog = 0 := by
  rw [map, CatProg.map, mapStraight_removed, ha s]

theorem map_shiftFin {n : Nat} (f : Wire → Wire) (a : CatFn n) {B : Nat} (ha : ShiftFin a B) :
    ShiftFin (map f a) B := ha

theorem map_tCount_le {n : Nat} (f : Wire → Wire) (a : CatFn n) {ta : Nat}
    (ha : ∀ s read h, ((a s).prog.instantiate read h).tCount ≤ ta)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((map f a s).prog.instantiate read h).tCount ≤ ta := by
  rw [map, CatProg.map, mapStraight_tCount]; exact ha s read h

theorem map_slots {n : Nat} (f : Wire → Wire) (a : CatFn n) {sa : Nat}
    (ha : ∀ s, (a s).prog.gateSlots ≤ sa) (s : Nat) :
    (map f a s).prog.gateSlots ≤ sa := by
  rw [map, CatProg.map, mapStraight_slots]; exact ha s

theorem map_wires {n : Nat} (f : Wire → Wire) (a : CatFn n) {S T : List Wire}
    (ha : ∀ s, ChallengeMigration.straightWires (a s).prog ⊆ S) (hmap : ∀ w ∈ S, f w ∈ T) (s : Nat) :
    ChallengeMigration.straightWires (map f a s).prog ⊆ T := by
  rw [map, CatProg.map, mapStraight_wires]
  intro w hw
  obtain ⟨u, hu, rfl⟩ := List.mem_map.mp hw
  exact hmap u (ha s hu)

theorem map_wellFormed {n : Nat} (f : Wire → Wire) (a : CatFn n)
    (ha : ∀ s, (a s).prog.WellFormed)
    (hinj : ∀ s, ∀ x ∈ ChallengeMigration.straightWires (a s).prog,
      ∀ y ∈ ChallengeMigration.straightWires (a s).prog, f x = f y → x = y) (s : Nat) :
    (map f a s).prog.WellFormed :=
  mapStraight_wellFormed f (a s).prog (hinj s) (ha s)

theorem map_catLitSim {n : Nat} (f : Wire → Wire) (y : Wire) (S : Finset Wire)
    (a : CatFn n) (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (haS : ∀ s, ∀ w ∈ ChallengeMigration.straightWires (a s).prog, w ∈ S)
    (hPS : ECDSAAdd.wires P ⊆ S) (hyS : y ∈ S)
    (hinj : ∀ x ∈ S, ∀ z ∈ S, f x = f z → x = z)
    (hsim : ∀ s read h, CatLitSim y ((a s).prog.instantiate read h) P V)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (f y) ((map f a s).prog.instantiate read h) (ECDSAAdd.renameProgram f P)
      (fun bs => ∀ bs0 : BasisState, (∀ w ∈ S, bs0 w = bs (f w)) → V bs0) :=
  mapStraight_catLitSim f y S (a s).prog read h P V (haS s) hPS hyS hinj (hsim s read h)

-- `swapSurround` lemmas
theorem swapSurround_indep {n : Nat} (y₁ y₂ : Wire) (body : CatFn n)
    (hb : ∀ s, Indep (body s).prog) (s : Nat) : Indep (swapSurround y₁ y₂ body s).prog :=
  seq_indep _ _ (seq_indep _ _ (lit_indep _) hb) (lit_indep _) s

theorem swapSurround_removed18 {n : Nat} (y₁ y₂ : Wire) (body : CatFn n)
    (hb : ∀ s, removed 18 (body s).prog = 0) (s : Nat) : removed 18 (swapSurround y₁ y₂ body s).prog = 0 :=
  seq_removed18 _ _ (seq_removed18 _ _ (lit_removed18 _ (swapCircuit_removed18 y₁ y₂)) hb)
    (lit_removed18 _ (swapCircuit_removed18 y₂ y₁)) s

theorem swapSurround_shiftFin {n : Nat} (y₁ y₂ : Wire) (body : CatFn n) {B : Nat} (hb : ShiftFin body B) :
    ShiftFin (swapSurround y₁ y₂ body) B := hb

theorem swapSurround_tCount_le {n : Nat} (y₁ y₂ : Wire) (body : CatFn n) {tb : Nat}
    (hbi : ∀ s, Indep (body s).prog)
    (hb : ∀ s read h, ((body s).prog.instantiate read h).tCount ≤ tb)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((swapSurround y₁ y₂ body s).prog.instantiate read h).tCount ≤ tb := by
  have h1 := seq_tCount_le _ _ (lit_indep (swapCircuit y₂ y₁))
    (seq_tCount_le _ _ hbi (fun s' r' h' => le_of_eq ((lit_tCount _ s' r' h').trans (swapCircuit_tCount y₁ y₂))) hb)
    (fun s' r' h' => le_of_eq ((lit_tCount _ s' r' h').trans (swapCircuit_tCount y₂ y₁))) s read h
  simpa using h1

theorem swapSurround_slots {n : Nat} (y₁ y₂ : Wire) (body : CatFn n) {sb : Nat}
    (hb : ∀ s, (body s).prog.gateSlots ≤ sb) (s : Nat) :
    (swapSurround y₁ y₂ body s).prog.gateSlots ≤ sb + 6 := by
  rw [swapSurround]
  have h1 := seq_slots _ _ (seq_slots _ _ (lit_slots (swapCircuit y₁ y₂)) hb) (lit_slots (swapCircuit y₂ y₁)) s
  have hl1 : (swapCircuit y₁ y₂).length = 3 := swapCircuit_length y₁ y₂
  have hl2 : (swapCircuit y₂ y₁).length = 3 := swapCircuit_length y₂ y₁
  omega

theorem swapSurround_wires {n : Nat} (y₁ y₂ : Wire) (body : CatFn n) {S : List Wire}
    (hy₁ : y₁ ∈ S) (hy₂ : y₂ ∈ S)
    (hb : ∀ s, ChallengeMigration.straightWires (body s).prog ⊆ S) (s : Nat) :
    ChallengeMigration.straightWires (swapSurround y₁ y₂ body s).prog ⊆ S := by
  refine seq_wires _ _ (seq_wires _ _ (lit_wires _ ?_) hb) (lit_wires _ ?_) s
  · intro w hw; have h' := swapCircuit_wires y₁ y₂ hw; simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
    rcases h' with rfl | rfl <;> assumption
  · intro w hw; have h' := swapCircuit_wires y₂ y₁ hw; simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
    rcases h' with rfl | rfl <;> assumption

theorem swapSurround_wellFormed {n : Nat} (y₁ y₂ : Wire) (body : CatFn n)
    (hne : y₁ ≠ y₂) (hb : ∀ s, (body s).prog.WellFormed) (s : Nat) :
    (swapSurround y₁ y₂ body s).prog.WellFormed :=
  seq_wellFormed _ _ (seq_wellFormed _ _ (lit_wellFormed _ (swapCircuit_wellFormed y₁ y₂ hne)) hb)
    (lit_wellFormed _ (swapCircuit_wellFormed y₂ y₁ hne.symm)) s

theorem swapSurround_catLitSim {n : Nat} {y₁ y₂ : Wire} (hne : y₁ ≠ y₂) (body : CatFn n)
    (hbi : ∀ s, Indep (body s).prog) (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hsim : ∀ s read h, CatLitSim y₂ ((body s).prog.instantiate read h) P V)
    (hclean_in : ∀ bs, V bs → bs y₁ = false ∧ bs y₂ = false)
    (hclean_out : ∀ st m, V st.basis → m.length = ECDSAAdd.measurementCount P →
      (ECDSAAdd.run P m st).basis y₁ = false ∧ (ECDSAAdd.run P m st).basis y₂ = false)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim y₁ ((swapSurround y₁ y₂ body s).prog.instantiate read h) P V :=
  catLitSim_swap_surround hne (body s) (hbi s) P V read h (fun h' => hsim s read h') hclean_in hclean_out

-- `flipSwapSurround` lemmas
theorem flipSwapSurround_indep {n : Nat} (y w : Wire) (body : CatFn n)
    (hb : ∀ s, Indep (body s).prog) (s : Nat) : Indep (flipSwapSurround y w body s).prog :=
  seq_indep _ _ (seq_indep _ _ (lit_indep _) hb) (lit_indep _) s

theorem flipSwapSurround_removed18 {n : Nat} (y w : Wire) (body : CatFn n)
    (hb : ∀ s, removed 18 (body s).prog = 0) (s : Nat) : removed 18 (flipSwapSurround y w body s).prog = 0 :=
  seq_removed18 _ _ (seq_removed18 _ _ (lit_removed18 _ (flipSwapCircuit_removed18 y w)) hb)
    (lit_removed18 _ (unflipSwapCircuit_removed18 y w)) s

theorem flipSwapSurround_shiftFin {n : Nat} (y w : Wire) (body : CatFn n) {B : Nat} (hb : ShiftFin body B) :
    ShiftFin (flipSwapSurround y w body) B := hb

theorem flipSwapSurround_tCount_le {n : Nat} (y w : Wire) (body : CatFn n) {tb : Nat}
    (hbi : ∀ s, Indep (body s).prog)
    (hb : ∀ s read h, ((body s).prog.instantiate read h).tCount ≤ tb)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((flipSwapSurround y w body s).prog.instantiate read h).tCount ≤ tb := by
  have h1 := seq_tCount_le _ _ (lit_indep (unflipSwapCircuit y w))
    (seq_tCount_le _ _ hbi (fun s' r' h' => le_of_eq ((lit_tCount _ s' r' h').trans (flipSwapCircuit_tCount y w))) hb)
    (fun s' r' h' => le_of_eq ((lit_tCount _ s' r' h').trans (unflipSwapCircuit_tCount y w))) s read h
  simpa using h1

theorem flipSwapSurround_slots {n : Nat} (y w : Wire) (body : CatFn n) {sb : Nat}
    (hb : ∀ s, (body s).prog.gateSlots ≤ sb) (s : Nat) :
    (flipSwapSurround y w body s).prog.gateSlots ≤ sb + 8 := by
  rw [flipSwapSurround]
  have h1 := seq_slots _ _ (seq_slots _ _ (lit_slots (flipSwapCircuit y w)) hb) (lit_slots (unflipSwapCircuit y w)) s
  have hl1 : (flipSwapCircuit y w).length = 4 := flipSwapCircuit_length y w
  have hl2 : (unflipSwapCircuit y w).length = 4 := unflipSwapCircuit_length y w
  omega

theorem flipSwapSurround_wires {n : Nat} (y w : Wire) (body : CatFn n) {S : List Wire}
    (hy : y ∈ S) (hw' : w ∈ S)
    (hb : ∀ s, ChallengeMigration.straightWires (body s).prog ⊆ S) (s : Nat) :
    ChallengeMigration.straightWires (flipSwapSurround y w body s).prog ⊆ S := by
  refine seq_wires _ _ (seq_wires _ _ (lit_wires _ ?_) hb) (lit_wires _ ?_) s
  · intro u hu; have h' := flipSwapCircuit_wires y w hu; simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
    rcases h' with rfl | rfl <;> assumption
  · intro u hu; have h' := unflipSwapCircuit_wires y w hu; simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
    rcases h' with rfl | rfl <;> assumption

theorem flipSwapSurround_wellFormed {n : Nat} (y w : Wire) (body : CatFn n)
    (hne : y ≠ w) (hb : ∀ s, (body s).prog.WellFormed) (s : Nat) :
    (flipSwapSurround y w body s).prog.WellFormed :=
  seq_wellFormed _ _ (seq_wellFormed _ _ (lit_wellFormed _ (flipSwapCircuit_wellFormed y w hne)) hb)
    (lit_wellFormed _ (unflipSwapCircuit_wellFormed y w hne)) s

theorem flipSwapSurround_catLitSim {n : Nat} {y w : Wire} (hne : y ≠ w) (body : CatFn n)
    (hbi : ∀ s, Indep (body s).prog) (P : ECDSAAdd.Program) (V : BasisState → Prop)
    (hwP : w ∉ ECDSAAdd.wires P)
    (hsim : ∀ s read h, CatLitSim w ((body s).prog.instantiate read h) P (fun bs => ∃ bs0, V bs0 ∧ bs = bs0[w ↦ false]))
    (hclean_in : ∀ bs, V bs → bs y = false ∧ bs w = true)
    (hclean_out : ∀ st m, V st.basis → m.length = ECDSAAdd.measurementCount P → (ECDSAAdd.run P m st).basis y = false)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim y ((flipSwapSurround y w body s).prog.instantiate read h) P V :=
  catLitSim_flipSwap_surround hne (body s) (hbi s) P V read h hwP (fun h' => hsim s read h') hclean_in hclean_out

end CatFn

attribute [local irreducible] CatFn.lit CatFn.noT CatFn.compileProg CatFn.seq CatFn.map
  CatFn.swapSurround CatFn.flipSwapSurround

/-! #### 1. Clean-catalyst `addInPlace` and `addInPlaceTop` (0 scratch, 4 T/Toffoli, 0 extra meas) -/

def compileAddInPlace {n : Nat} (y : Wire) :
    List Wire → List Wire → List Wire → Wire → (start : Nat) → CatProg n start
  | a :: (a' :: as), b :: (b' :: bs), c :: cs, cin, start =>
      let p1 := CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)
      let p2 := compileAddInPlace y (a' :: as) (b' :: bs) cs c p1.finish
      let p3 := CatProg.noT (n := n) (start := p2.finish) (eraseCarry a b cin c)
      let p4 := CatProg.lit (n := n) (start := p3.finish) [.CX a b, .CX cin b]
      ((p1.append p2).append p3).append p4
  | [a], [b], _, cin, start => CatProg.lit [.CX a b, .CX cin b]
  | _, _, _, _, start => CatProg.lit []

def compileAddInPlaceTop {n : Nat} (y : Wire) :
    List Wire → List Wire → List Wire → Wire → (start : Nat) → CatProg n start
  | [a, a'], b :: (b' :: bs), c :: cs, cin, start =>
      let p1 := CatProg.lit (n := n) (start := start) [.CX b c, .CX b' c, .CX cin c]
      let p2 := compileAddInPlaceTop y ([a']) (b' :: bs) cs c p1.finish
      let p3 := CatProg.noT (n := n) (start := p2.finish) (eraseCarry a b cin c)
      let p4 := CatProg.lit (n := n) (start := p3.finish) [.CX a b, .CX cin b]
      ((p1.append p2).append p3).append p4
  | a :: (a' :: a'' :: as), b :: (b' :: bs), c :: cs, cin, start =>
      let p1 := CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)
      let p2 := compileAddInPlaceTop y (a' :: a'' :: as) (b' :: bs) cs c p1.finish
      let p3 := CatProg.noT (n := n) (start := p2.finish) (eraseCarry a b cin c)
      let p4 := CatProg.lit (n := n) (start := p3.finish) [.CX a b, .CX cin b]
      ((p1.append p2).append p3).append p4
  | [a], [b], _, cin, start => CatProg.lit [.CX a b, .CX cin b]
  | _, _, _, _, start => CatProg.lit []

private theorem cx2_tCount (a b cin : Wire) : ShorECDLP.tCount ([.CX a b, .CX cin b] : Circuit) = 0 := rfl
private theorem cx3_tCount (a b c d : Wire) : ShorECDLP.tCount ([.CX a d, .CX b d, .CX c d] : Circuit) = 0 := rfl
private theorem eraseCarry_norm_toff (a b cin c : Wire) :
    ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram (eraseCarry a b cin c)) = 0 := by
  have h := ECDSAAdd.Baselines.normalize_toffoli (eraseCarry a b cin c)
  have h0 : ECDSAAdd.toffoliCount (eraseCarry a b cin c) = 0 := rfl
  omega

private theorem majority_norm_toff (a b cin c : Wire) (hbc : b ≠ cin) :
    ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram (majority a b cin c)) = 1 := by
  simp [majority, ECDSAAdd.Baselines.normalizeProgram, ECDSAAdd.Baselines.normalizeInstr, hbc,
    ECDSAAdd.toffoliCount]

theorem compileAddInPlace_indep {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat),
      Indep (compileAddInPlace (n := n) y x ys carry cin start).prog
  | a :: a' :: as, b :: b' :: bs, c :: cs, cin, start =>
      indep_append _ _ (indep_append _ _ (indep_append _ _ (CatProg.lit_indep _)
        (compileAddInPlace_indep y (a' :: as) (b' :: bs) cs c _)) (CatProg.noT_indep _)) (CatProg.lit_indep _)
  | [a], [b], _, cin, start => CatProg.lit_indep _
  | [], _, _, _, _ | [_], [], _, _, _ | [_], _ :: _ :: _, _, _, _
  | [_, _], [], _, _, _ | [_, _], [_], _, _, _ | [_, _], _ :: _ :: _, [], _, _
  | _ :: _ :: _ :: _, [], _, _, _ | _ :: _ :: _ :: _, [_], _, _, _
  | _ :: _ :: _ :: _, _ :: _ :: _, [], _, _ => CatProg.lit_indep _

