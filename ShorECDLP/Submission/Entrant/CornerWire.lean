  | true, _, [], [], [], _, _, _, _, _ => by
      simp [compileCompareChain, cmpChainProg, TopReuseCarry.compareChainTop, CatProg.lit_tCount,
        ShorECDLP.tCount, ECDSAAdd.toffoliCount]
  | false, _, [], _ :: _, _, _, _, _, _, _ | false, _, [], [], _ :: _, _, _, _, _, _
