      simp only [compileCompareChain, cmpChainProg, if_true, CatProg.append] at ih ⊢
      rw [indep_append_tCount _ _ (CatProg.noT_indep _),
        indep_append_tCount _ _ (compileCompareChain_indep true y (a' :: as) bs cs c target _),
        CatProg.lit_tCount, majorityCat_tCount, ih, CatProg.noT_tCount, eraseCarry_norm_toff]
