/-- Entry invariant for `compiledHostArith` at `m1` and `m6` in `midW`. -/
def ArithHostValid (bs : BasisState) : Prop :=
  ∃ (X Y : ECDSAAdd.Fp) (G : Bool) (base : BasisState),
    X ≠ 0 ∧
    PointDialogValues streamLayout X Y G base bs ∧
    PoolHost.FlagInv7 base ∧
    base 10015 = true ∧ base 836 = true ∧ base 14114 = true ∧ base 14113 = G

private def flip3Basis (bs : BasisState) : BasisState :=
  ECDSAAdd.writeBit (ECDSAAdd.writeBit (ECDSAAdd.writeBit bs 10015 (!bs 10015)) 836 (!bs 836)) 14114 (!bs 14114)

private theorem hostFlip3_run (st : ECDSAAdd.State) (m : List Bool) :
    ECDSAAdd.run hostFlip3 m st = ⟨st.phase, flip3Basis st.basis⟩ := by
  cases st with
  | mk ph b =>
    rw [hostFlip3]
    simp only [ECDSAAdd.run, flip3Basis, ECDSAAdd.writeBit, Function.update,
      show (836 : Wire) ≠ 10015 by decide, show (14114 : Wire) ≠ 836 by decide,
      show (14114 : Wire) ≠ 10015 by decide, dite_false]

private theorem pointDialogValues_pool_false {X Y : ECDSAAdd.Fp} {G : Bool} {base bs : BasisState}
    (hv : PointDialogValues streamLayout X Y G base bs) (w : Wire) (hw : w ∈ streamLayout.dialogPool) :
    bs w = false := (ECDSAAdd.Arithmetic.regValue_zero _ _).mp hv.clean w hw

