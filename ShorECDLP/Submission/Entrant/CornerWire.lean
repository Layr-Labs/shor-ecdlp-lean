-- `CatSim` for `compiledMidW` on `ValidK`
def Pre012 : Code2 65536 :=
  Site1Wire.Wide16.b0.forgetL ++ Site1Wire.Wide16.b1.forgetL ++ Site1Wire.Wide16.b2.forgetL

def ValidK (coeffs : Fin 65536 → PointCoeff) (Q : Secp256k1.Point) (a : Nat) (st2 : ECDSAAdd.State) : Prop :=
  ∃ (s : BasisState) (m012 : List Bool),
    liveReady s ∧
    tableAddressValue WideBank8.Fast16.windowBits s = a ∧
    m012.length = ECDSAAdd.measurementCount (reference2 (readConstant coeffs Q) a Pre012) ∧
    st2 = ECDSAAdd.run (reference2 (readConstant coeffs Q) a Pre012) m012 ⟨false, s⟩

private def CatBlockSim (y : Wire) (read : ConstantBit 65536 → Bool) (code : Code2 65536)
    (P : Nat → ECDSAAdd.State → Prop) (C : AdaptiveCircuit) : Prop :=
  ∃ cs : List ℂ, List.Forall₂
    (fun b c => ∃ m : List Bool, m.length = literalRecords (erase2 code) ∧
      ∀ a st, P a st →
        b.kraus (Prep y (Bridge.signedKet st)) =
          c • Prep y (Bridge.signedKet (ECDSAAdd.run (reference2 read a code) m st)))
    C.run cs ∧ (cs.map Complex.normSq).sum = 1

private theorem catBlockSim_seq {y : Wire} {read : ConstantBit 65536 → Bool}
    (a b : CatFn 65536) (hbi : ∀ s, Indep (b s).prog)
    (c₁ c₂ : Code2 65536) (P₁ P₂ : Nat → ECDSAAdd.State → Prop)
    (ha : ∀ s h, CatBlockSim y read c₁ P₁ ((a s).prog.instantiate read h))
    (hb : ∀ s h, CatBlockSim y read c₂ P₂ ((b s).prog.instantiate read h))
    (hstep : ∀ addr st m, P₁ addr st → m.length = ECDSAAdd.measurementCount (reference2 read addr c₁) →
      P₂ addr (ECDSAAdd.run (reference2 read addr c₁) m st))
    (s : Nat) (h : Fin s → Bool) :
    CatBlockSim y read (c₁ ++ c₂) P₁ ((CatFn.seq a b s).prog.instantiate read h) := by
  obtain ⟨cs1, al1, m1⟩ := ha s h
  obtain ⟨cs2, al2, m2⟩ := hb (a s).finish (fun _ => false)
  refine ⟨coherentSeqCoefficients cs1 cs2, ?_, by rw [WEX.simulationCoefficients_mass, m1, m2]; norm_num⟩
  rw [CatFn.seq, CatProg.append, indep_append_run _ _ (hbi _) read h, AdaptiveCircuit.run_seq]
  apply WEX.simulationAligned_seq al1 al2
  intro b1 k1 b2 k2 ⟨m₁, lm₁, hb1⟩ ⟨m₂, lm₂, hb2⟩
  refine ⟨m₁ ++ m₂, by rw [List.length_append, erase2_append, literalRecords_append, lm₁, lm₂], fun addr st hst => ?_⟩
  have hmc : m₁.length = ECDSAAdd.measurementCount (reference2 read addr c₁) :=
    lm₁.trans (specialize_counts read (erase2 c₁) addr).2.symm
  change b2.kraus (b1.kraus (Prep y (Bridge.signedKet st))) = _
  rw [hb1 addr st hst, map_smul, hb2 addr _ (hstep addr st m₁ hst hmc), smul_smul,
    reference2_append, WEX.run_append_records _ _ m₁ m₂ st hmc, mul_comm k1 k2]

private theorem catBlockSim_swapSurround {y₁ y₂ : Wire} {read : ConstantBit 65536 → Bool}
    (hne : y₁ ≠ y₂) (body : CatFn 65536) (hbi : ∀ s, Indep (body s).prog)
    (code : Code2 65536) (P : Nat → ECDSAAdd.State → Prop)
    (hb : ∀ s h, CatBlockSim y₂ read code P ((body s).prog.instantiate read h))
    (hclean_in : ∀ addr st, P addr st → st.basis y₁ = false ∧ st.basis y₂ = false)
    (hclean_out : ∀ addr st m, P addr st → m.length = ECDSAAdd.measurementCount (reference2 read addr code) →
      (ECDSAAdd.run (reference2 read addr code) m st).basis y₁ = false ∧
      (ECDSAAdd.run (reference2 read addr code) m st).basis y₂ = false)
    (s : Nat) (h : Fin s → Bool) :
    CatBlockSim y₁ read code P ((CatFn.swapSurround y₁ y₂ body s).prog.instantiate read h) := by
  have hrun_eq :
      ((CatFn.swapSurround y₁ y₂ body s).prog.instantiate read h).run =
        (((CatFn.lit (n := 65536) (swapCircuit y₁ y₂) s).prog.instantiate read h).seq
          (((body s).prog.instantiate read (fun _ => false)).seq
            ((CatFn.lit (n := 65536) (swapCircuit y₂ y₁) (body s).finish).prog.instantiate read (fun _ => false)))).run := by
    rw [CatFn.swapSurround, CatFn.seq, CatFn.seq, CatProg.append,
      indep_append_run _ _ (CatFn.lit_indep _ _) read h, AdaptiveCircuit.run_seq,
      CatProg.append, indep_append_run _ _ (hbi _) read h,
      AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq]
    simp only [CatFn.lit, Instrument.seq, List.flatMap_assoc, List.flatMap_map, List.map_flatMap, List.map_map, Function.comp_def]
    apply List.flatMap_congr; intro x _; apply List.flatMap_congr; intro y _; apply List.map_congr_left; intro z _
    rcases x with ⟨xh, xk⟩; rcases y with ⟨yh, yk⟩; rcases z with ⟨zh, zk⟩
    simp [InstrumentBranch.seq, LinearMap.comp_assoc, List.append_assoc]
  obtain ⟨cs, al, hm⟩ := hb s (fun _ => false)
  refine ⟨cs, ?_, hm⟩
  have hfm : ∀ l : List InstrumentBranch,
      l.flatMap (fun before => [before.seq ⟨[], Quantum.run (swapCircuit y₂ y₁)⟩]) =
        l.map (fun before => before.seq ⟨[], Quantum.run (swapCircuit y₂ y₁)⟩) := fun l => by
    induction l <;> simp [*]
  rw [hrun_eq, AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq, CatFn.lit, CatFn.lit, CatProg.lit_run, CatProg.lit_run]
  simp only [Instrument.seq, List.flatMap_cons, List.flatMap_nil, List.append_nil, List.map_singleton]
  rw [hfm, List.map_map, List.forall₂_map_left_iff]
  refine al.imp fun br c ⟨m, lm, hbr⟩ => ⟨m, lm, fun addr st hst => ?_⟩
  have hmc : m.length = ECDSAAdd.measurementCount (reference2 read addr code) :=
    lm.trans (specialize_counts read (erase2 code) addr).2.symm
  have hci := hclean_in addr st hst
  have hco := hclean_out addr st m hst hmc
  change Quantum.run (swapCircuit y₂ y₁) (br.kraus (Quantum.run (swapCircuit y₁ y₂) (Prep y₁ (Bridge.signedKet st)))) = _
  have hsw1 : Quantum.run (swapCircuit y₁ y₂) (Prep y₁ (Bridge.signedKet st)) = Prep y₂ (Bridge.signedKet st) := by
    rw [signedKet_smul_eq, map_smul, map_smul, map_smul, swapCircuit_prep_ket y₁ y₂ hne _ hci.1 hci.2]
  have hsw2 : Quantum.run (swapCircuit y₂ y₁) (Prep y₂ (Bridge.signedKet (ECDSAAdd.run (reference2 read addr code) m st))) =
      Prep y₁ (Bridge.signedKet (ECDSAAdd.run (reference2 read addr code) m st)) := by
    rw [signedKet_smul_eq, map_smul, map_smul, map_smul, swapCircuit_prep_ket y₂ y₁ hne.symm _ hco.2 hco.1]
  rw [hsw1, hbr addr st hst, map_smul, hsw2]

private theorem catBlockSim_lower_fblock {read : ConstantBit 65536 → Bool} (q y : Wire)
    (b : WideBank8.Fast16.FBlock2 65536) (hb : b ∈ CornerWire.Wide16.midW)
    (hq : q ∉ ChallengeMigration.straightWires (WideBank8.Fast16.fblockProg b 0))
    (hy : y ∉ ChallengeMigration.straightWires (WideBank8.Fast16.fblockProg b 0))
    (hqy : q ≠ y) (P : Nat → ECDSAAdd.State → Prop)
    (hP : ∀ addr st, P addr st →
      AddrValid WideBank8.Fast16.windowBits windowRoot addr st ∧
      WideBank8.Fast16.FBlockClean b st ∧
      Safe2 read addr b.forgetL st ∧
      st.basis q = false ∧ st.basis y = false)
    (s : Nat) (h : Fin s → Bool) :
    CatBlockSim y read b.forgetL P ((CatFn.lower q y (WideBank8.Fast16.fblockProg b 0) s).prog.instantiate read h) := by
  obtain ⟨cs, al, mass⟩ := WideBank8.Fast16.fblock_sim read b (midB_geo b hb)
  rw [← WideBank8.Fast16.fblockProg_run read b 0 Fin.elim0] at al
  obtain ⟨cs', al', mass'⟩ := CatFn.lower_lift_raw q y (WideBank8.Fast16.fblockProg b 0) s read h
    (midB_wellFormed b hb) hq hy hqy (WideBank8.Fast16.FBlockSim read b) cs al
  refine ⟨cs', ?_, mass'.trans mass⟩
  refine al'.imp fun br' c' ⟨br, c, α, ⟨m, lm, hbr⟩, hc', hlift⟩ => ⟨m, lm, fun addr st hst => ?_⟩
  obtain ⟨ha, hcl, hsf, hsq, hsy⟩ := hP addr st hst
  have hsup : SupportedOn (fun u => u q = false ∧ u y = false) (Bridge.signedKet st) := fun u hu => by
    apply supportedOn_ket (fun u => u q = false ∧ u y = false) st.basis ⟨hsq, hsy⟩ u
    simp only [Bridge.signedKet, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul] at hu
    exact right_ne_zero_of_mul hu
  rw [hlift _ hsup, hbr addr st ha hcl hsf, map_smul, smul_smul, hc']

/-- State predicate tracking `PointDialogValues`, `FlagInv7`, `10015/836/14114`, and `FCodeClean/Safe2/AddrValid`
through any suffix of `midW`! -/
private def MidStep (read : ConstantBit 65536 → Bool) (rem : WideBank8.Fast16.FCode2 65536)
    (X Y : ECDSAAdd.Fp) (G : Bool) (base : BasisState) (addr : Nat) (st : ECDSAAdd.State) : Prop :=
  PointDialogValues streamLayout X Y G base st.basis ∧
  PoolHost.FlagInv7 base ∧ base 10015 = true ∧ base 836 = true ∧ base 14114 = true ∧ base 14113 = G ∧
  AddrValid WideBank8.Fast16.windowBits windowRoot addr st ∧
  WideBank8.Fast16.FCodeClean read addr rem st ∧
  Safe2 read addr (WideBank8.Fast16.fforget rem) st

-- Cleaner: parameterize the 9-step state directly by a concrete witness structure!
private structure MidData (read : ConstantBit 65536 → Bool) (addr : Nat) where
  base : BasisState
  G : Bool
  X0 : ECDSAAdd.Fp
  Y0 : ECDSAAdd.Fp
  X1 : ECDSAAdd.Fp
  Y1 : ECDSAAdd.Fp
  X2 : ECDSAAdd.Fp
  X3 : ECDSAAdd.Fp
  X4 : ECDSAAdd.Fp
  Y2 : ECDSAAdd.Fp
  cx : ECDSAAdd.Fp
  hex : ¬ (base streamLayout.doubleSelect = true ∧ base streamLayout.genericSelect = true)
  hfwd1 : X1.val = (X0.val ^^^ (if base streamLayout.doubleSelect then 5 else 0)) ^^^ (if base streamLayout.genericSelect then 5 else 0)
  hbck1 : X0.val = (X1.val ^^^ (if base streamLayout.doubleSelect then 5 else 0)) ^^^ (if base streamLayout.genericSelect then 5 else 0)
  hX1 : X1 ≠ 0
  hY1 : Y1 = Y0 / X1
  hX2 : X2 = X0 - (if G then Y1 * Y1 else 0)
  hX3 : X3 = X2 + (if G then 3 * cx else 0)
  htriple : ∀ (st' : ECDSAAdd.State) (m : List Bool),
    PointDialogValues streamLayout X2 Y1 G base st'.basis →
    PointDialogValues streamLayout X3 Y1 G base
      (ECDSAAdd.run (reference2 read addr midB4.forgetL) m st').basis
  hfwd2 : X4.val = (X3.val ^^^ (if base streamLayout.doubleSelect then 5 else 0)) ^^^ (if base streamLayout.genericSelect then 5 else 0)
  hbck2 : X3.val = (X4.val ^^^ (if base streamLayout.doubleSelect then 5 else 0)) ^^^ (if base streamLayout.genericSelect then 5 else 0)
  hX4 : X4 ≠ 0
  hY2 : Y2 = Y1 * X4
  hG3 : G = true → X3 ≠ 0

private def MidStage (read : ConstantBit 65536 → Bool) (rem : WideBank8.Fast16.FCode2 65536)
    (getXY : ∀ addr, MidData read addr → ECDSAAdd.Fp × ECDSAAdd.Fp)
    (addr : Nat) (st : ECDSAAdd.State) : Prop :=
  ∃ d : MidData read addr,
    MidStep read rem (getXY addr d).1 (getXY addr d).2 d.G d.base addr st

private theorem fblock_step_ref_plain (read : ConstantBit 65536 → Bool) (addr : Nat) (P : ECDSAAdd.Program) :
    reference2 read addr (WideBank8.Fast16.FBlock2.std (.plain (Rows.code r16 (wLiteral P)))).forgetL = P := by
  simp [WideBank8.Fast16.FBlock2.forgetL, reference2, erase2, Block2.code, Rows.code, Rows.instr,
    wLiteral, specialize, WInstr.specialize, ECDSAAdd.ShorPort.Tmpl.instantiate_lit]

private theorem midStep_advance {read : ConstantBit 65536 → Bool}
    {b : WideBank8.Fast16.FBlock2 65536} {rem : WideBank8.Fast16.FCode2 65536}
    (hb : b ∈ CornerWire.Wide16.midW)
    {X Y X' Y' : ECDSAAdd.Fp} {G : Bool} {base : BasisState} {addr : Nat} {st : ECDSAAdd.State} {m : List Bool}
    (hm : m.length = ECDSAAdd.measurementCount (reference2 read addr b.forgetL))
    (hs : MidStep read (b :: rem) X Y G base addr st)
    (hp : PointDialogValues streamLayout X' Y' G base (ECDSAAdd.run (reference2 read addr b.forgetL) m st).basis) :
    MidStep read rem X' Y' G base addr (ECDSAAdd.run (reference2 read addr b.forgetL) m st) := by
  obtain ⟨hv, hf, h15, h836, h14, h13, ha, hcl, hsf⟩ := hs
  have hsf_sp := WideBank8.Fast16.safe2_append_inv read addr b.forgetL (WideBank8.Fast16.fforget rem) st
    (by simpa [WideBank8.Fast16.fforget_cons] using hsf)
  exact ⟨hp, hf, h15, h836, h14, h13,
    WideBank8.Fast16.fblock_addr read b (midB_geo b hb) addr st ha hcl.1 m,
    hcl.2 m hm, hsf_sp.2 m hm⟩

private theorem validK_to_midStage0 (coeffs : Fin 65536 → PointCoeff) (Q : Secp256k1.Point)
    (hQ : ShorECDLP.order • Q = 0) (hn : ∀ i, constantPoint Q (coeffs i) ≠ 0)
    (addr : Nat) (st2 : ECDSAAdd.State) (hval : ValidK coeffs Q addr st2) :
    MidStage (readConstant coeffs Q) ([midB0, midB1, midB2, midB3, midB4, midB5, midB6, midB7, midB8])
      (fun _ d => (d.X0, d.Y0)) addr st2 := by
  classical
  let read := readConstant coeffs Q
  obtain ⟨s, m012, hs, ha_s, hm012, hst2⟩ := hval
  have hcode_app : WideBank8.Row16.code = [Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2] ++
      (CornerWire.Wide16.midW ++ (CornerWire.Wide16.cornerBlocks ++ CornerWire.Wide16.tailW)) := by
    rw [CornerWire.Wide16.code_split_corner]; simp [List.append_assoc]
  have hff_012 : WideBank8.Fast16.fforget ([Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2]) = Pre012 := by
    simp [Pre012, WideBank8.Fast16.fforget_cons, WideBank8.Fast16.fforget, List.append_assoc]
  have hsafe_all : Safe2 read addr (WideBank8.Fast16.fforget WideBank8.Row16.code) ⟨false, s⟩ := by
    rw [WideBank8.Row16.forget]; exact Rows.row_safe _ _ _ hQ hn addr s hs
  have hclean_all : WideBank8.Fast16.FCodeClean read addr WideBank8.Row16.code ⟨false, s⟩ :=
    WideBank8.Row16.clean_fused _ _ _ (WideBank8.Row16.clean_lift coeffs Q _ _ _
      (WEXFast.rowCF_clean (fun _ => coeffs (r16 addr)) Q hQ (fun _ => hn _) addr s hs)
      (PoolHost.poolBand_clean_in_rowCF (fun _ => coeffs (r16 addr)) Q hQ (fun _ => hn _) addr s hs)
      (by rw [WEXFast.fforget_rowCF]; exact PoolHost.rowC_host4 (fun _ => coeffs (r16 addr)) Q hQ (fun _ => hn _) addr s hs))
  -- Split `FCodeClean` and `Safe2` across `[b0, b1, b2] ++ midW ++ ...`
  have fcodeClean_app {xs ys : WideBank8.Fast16.FCode2 65536} {st : ECDSAAdd.State}
      (h : WideBank8.Fast16.FCodeClean read addr (xs ++ ys) st) :
      WideBank8.Fast16.FCodeClean read addr xs st ∧
        ∀ m, m.length = ECDSAAdd.measurementCount (reference2 read addr (WideBank8.Fast16.fforget xs)) →
          WideBank8.Fast16.FCodeClean read addr ys (ECDSAAdd.run (reference2 read addr (WideBank8.Fast16.fforget xs)) m st) := by
    induction xs generalizing st with
    | nil =>
      refine ⟨trivial, fun m hm => ?_⟩
      simp only [WideBank8.Fast16.fforget, List.flatMap_nil, reference2_nil, ECDSAAdd.measurementCount] at hm ⊢
      rw [List.eq_nil_of_length_eq_zero hm, Site1Fast.run_nil]; exact h
    | cons x xs ih =>
      rcases h with ⟨hx, hrest⟩
      refine ⟨⟨hx, fun m hm => (ih (hrest m hm)).1⟩, fun m hm => ?_⟩
      rw [WideBank8.Fast16.fforget_cons, reference2_append, ECDSAAdd.measurementCount_append] at hm
      rw [WideBank8.Fast16.fforget_cons, reference2_append, ECDSAAdd.run_append]
      have ht : (m.take (ECDSAAdd.measurementCount (reference2 read addr x.forgetL))).length =
          ECDSAAdd.measurementCount (reference2 read addr x.forgetL) := by rw [List.length_take]; omega
      have hd : (m.drop (ECDSAAdd.measurementCount (reference2 read addr x.forgetL))).length =
          ECDSAAdd.measurementCount (reference2 read addr (WideBank8.Fast16.fforget xs)) := by rw [List.length_drop]; omega
      exact (ih (hrest _ ht)).2 _ hd
  have fcode_addr_loc {xs : WideBank8.Fast16.FCode2 65536}
      (hg : ∀ b ∈ xs, WideBank8.Fast16.FBlockGeo b) {st : ECDSAAdd.State}
      (ha : AddrValid WideBank8.Fast16.windowBits windowRoot addr st)
      (hcl : WideBank8.Fast16.FCodeClean read addr xs st) {m : List Bool}
      (hm : m.length = ECDSAAdd.measurementCount (reference2 read addr (WideBank8.Fast16.fforget xs))) :
      AddrValid WideBank8.Fast16.windowBits windowRoot addr (ECDSAAdd.run (reference2 read addr (WideBank8.Fast16.fforget xs)) m st) := by
    induction xs generalizing st m with
    | nil =>
      simp only [WideBank8.Fast16.fforget, List.flatMap_nil, reference2_nil, ECDSAAdd.measurementCount] at hm ⊢
      rw [List.eq_nil_of_length_eq_zero hm, Site1Fast.run_nil]; exact ha
    | cons x xs ih =>
      rw [WideBank8.Fast16.fforget_cons, reference2_append, ECDSAAdd.measurementCount_append] at hm
      rw [WideBank8.Fast16.fforget_cons, reference2_append, ECDSAAdd.run_append]
      have ht : (m.take (ECDSAAdd.measurementCount (reference2 read addr x.forgetL))).length =
          ECDSAAdd.measurementCount (reference2 read addr x.forgetL) := by rw [List.length_take]; omega
      have hd : (m.drop (ECDSAAdd.measurementCount (reference2 read addr x.forgetL))).length =
          ECDSAAdd.measurementCount (reference2 read addr (WideBank8.Fast16.fforget xs)) := by rw [List.length_drop]; omega
      exact ih (fun b hb => hg b (List.mem_cons_of_mem _ hb))
        (WideBank8.Fast16.fblock_addr read x (hg x List.mem_cons_self) addr st ha hcl.1 _) (hcl.2 _ ht) hd
  rw [hcode_app] at hsafe_all hclean_all
  rw [WideBank8.Fast16.fforget_append, WideBank8.Fast16.fforget_append, hff_012] at hsafe_all
  have hsf_012 := WideBank8.Fast16.safe2_append_inv read addr Pre012 _ ⟨false, s⟩ hsafe_all
  have hcl_012 := fcodeClean_app hclean_all
  have hcl_mid : WideBank8.Fast16.FCodeClean read addr CornerWire.Wide16.midW st2 := by
    rw [hst2]
    have h1 := hcl_012.2 m012 (by rw [hff_012]; exact hm012); rw [hff_012] at h1
    exact (fcodeClean_app h1).1
  have hsf_mid : Safe2 read addr (WideBank8.Fast16.fforget CornerWire.Wide16.midW) st2 := by
    rw [hst2]; exact (WideBank8.Fast16.safe2_append_inv read addr (WideBank8.Fast16.fforget CornerWire.Wide16.midW) _ _
      (hsf_012.2 m012 hm012)).1
  have ha2 : AddrValid WideBank8.Fast16.windowBits windowRoot addr st2 := by
    have hg012 : ∀ b ∈ ([Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2] : WideBank8.Fast16.FCode2 65536),
        WideBank8.Fast16.FBlockGeo b := fun b hb => WideBank8.Row16.geometry b (by rw [hcode_app]; exact List.mem_append_left _ hb)
    rw [hst2]
    have h1 := fcode_addr_loc hg012 ⟨ha_s, hs.2.2⟩ hcl_012.1 (by rw [hff_012]; exact hm012)
    rwa [hff_012] at h1
  -- Connect `Pre012` to `rowPre ++ preBlock probeRows`!
  let coeffs32 : Fin 32768 → PointCoeff := fun _ => coeffs (r16 addr)
  let read32 : ConstantBit 32768 → Bool := readConstant coeffs32 Q
  have hpre_eq : Pre012 = Rows.blocks r16 (WEXUnlookup.rowPre3.map toBlock2) := by
    simp only [Pre012, Site1Wire.Wide16.b0, Site1Wire.Wide16.b1, Site1Wire.Wide16.b2, WideBank8.Fast16.FBlock2.forgetL,
      WEXUnlookup.rowPre3, Rows.blocks, Rows.block, toBlock2, r16, List.map_cons, List.map_nil, List.cons_append, List.nil_append]
    rfl
  have href_pre : reference2 read addr Pre012 = reference read32 addr WEXUnlookup.rowPre3 := by
    rw [hpre_eq, Rows.reference_blocks]
    simp only [reference2, reference, erase2_map]
    rfl
  have href_triple : reference2 read addr midB4.forgetL =
      reference read32 addr (constAdd streamLayout streamLayout.point.x (wFields probeRows .tripleX)) := by
    have h1 : midB4.forgetL = Rows.blocks r16 ([Block2.unit (WEXFast.siteUnit WEXFast.tripleSite)]) := by
      simp only [midB4, WideBank8.Fast16.FBlock2.forgetL, WideBank8.Row16.fast, WEXFast.tripleF, Rows.blocks, Rows.block,
        WEXFast.siteUnit, Rows.unit, r16, List.map_cons, List.map_nil]
      rfl
    rw [h1, Rows.reference_blocks]
    simp only [reference2, reference, erase2_cons, erase2_nil, List.append_nil, Block2.code, WEXFast.siteUnit_code,
      WEXFast.tripleSite, constAdd, erase, Block.code]
    rfl
  -- Mirror `preSite2_values` / `generic3_host4` on `st3 = run rowPre mPre ⟨false, s⟩`!
  let mPre := m012.take (ECDSAAdd.measurementCount (reference read32 addr rowPre))
  let mPB := m012.drop (ECDSAAdd.measurementCount (reference read32 addr rowPre))
  set st3 := ECDSAAdd.run (reference read32 addr rowPre) mPre ⟨false, s⟩ with hst3_def
  have hst2_eq : st2 = ECDSAAdd.run (reference read32 addr (preBlock probeRows)) mPB st3 := by
    rw [hst2, href_pre, rowPre3_run, reference_append, ECDSAAdd.run_append]
  let C := Single.Physical.tablePoint coeffs32 Q addr
  have hC : C ≠ 0 := hn _
  have hord : ShorECDLP.order • C = 0 := Single.Physical.tablePoint_order coeffs32 Q hQ addr
  obtain ⟨P0, hP0⟩ := hs.1.2
  have work : ECDSAAdd.regValue streamLayout.work s = 0 :=
    (ECDSAAdd.Arithmetic.regValue_zero _ _).mpr (fun w hw => hs.2.1 w (List.mem_append_left _ hw))
  have h838 : (838 : Wire) ∉ streamLayout.work := by
    intro hm; have h := streamWork_lower _ hm; norm_num at h
  have pool : ECDSAAdd.regValue streamLayout.work (flipInfinity s) = 0 :=
    (reg_update_outside _ _ _ _ h838).trans work
  have clean (w : Wire) (hw : w ∈ streamLayout.inPlaceFlags ++ streamLayout.dialogPool) :
      flipInfinity s w = false := (ECDSAAdd.Arithmetic.regValue_zero _ _).mp pool w (one_boundary_work_subset streamLayout hw)
  have initial : PointDialogBoundary streamLayout (Bridge.toB P0) true (fun _ => false) (flipInfinity s) := by
    refine ⟨flipInfinity_holds s (Bridge.toB P0) (StreamPoint.of_coordinates s P0 hs.1.1.1.1 hP0), ?_, ?_, ?_⟩
    · simpa [streamLayout_control, flipInfinity, ECDSAAdd.writeBit] using hs.1.1.1.2
    · intro w hw; exact clean w (by simp [hw])
    · exact (ECDSAAdd.Arithmetic.regValue_zero _ _).mpr (fun w hw => clean w (by simp [hw]))
  cases he : Bridge.toB C with
  | zero => exact (hC (congrArg ECDSAAdd.ShorPort.toA he)).elim
  | @some cx cy hc =>
    have ce : C = toA (.some hc) := congrArg toA he
    have hr : RowReads read32 (probeRows addr) (.some hc) := readConstant_rowReads coeffs32 Q _ _ ce
    have ho : ShorECDLP.order • (.some hc : ECDSAAdd.Secp256k1.Point) = 0 := by rw [← he]; exact hord
    have hp2 := torsion_unit_remainder_ne_zero (.some hc) ShorECDLP.order 2
      (WeierstrassCurve.Affine.Point.some_ne_zero hc) ho (by norm_num [ShorECDLP.order])
    have hp3 := torsion_unit_remainder_ne_zero (.some hc) ShorECDLP.order 3
      (WeierstrassCurve.Affine.Point.some_ne_zero hc) ho (by norm_num [ShorECDLP.order])
    have hd : (.some hc : ECDSAAdd.Secp256k1.Point) + .some hc ≠ 0 := by simpa only [two_nsmul] using hp2
    have ht : (.some hc : ECDSAAdd.Secp256k1.Point) + .some hc + .some hc ≠ 0 := by
      simpa only [show (3 : Nat) = 2 + 1 from rfl, succ_nsmul, two_nsmul] using hp3
    have en := enables_true hc hd ht
    have hdo : ShorECDLP.order • ((.some hc : ECDSAAdd.Secp256k1.Point) + .some hc) = 0 := by rw [nsmul_add, ho, zero_add]
    have hen : dialogExceptionEnabled (.some hc) := by
      refine ⟨neg_ne_zero.mpr hd, ?_, ?_⟩
      · intro e; unfold dialogExceptionPoint at e
        have h3 : ((.some hc : ECDSAAdd.Secp256k1.Point) + .some hc) + .some hc = 0 := by
          have h0 := add_neg_cancel ((.some hc : ECDSAAdd.Secp256k1.Point) + .some hc); rwa [e] at h0
        exact ht h3
      · intro e; unfold dialogExceptionPoint at e
        have h2 : (.some hc : ECDSAAdd.Secp256k1.Point) + .some hc = .some hc := neg_inj.mp e
        have h1 : (.some hc : ECDSAAdd.Secp256k1.Point) = 0 := by
          have := congrArg (· - (.some hc : ECDSAAdd.Secp256k1.Point)) h2; simpa using this
        exact WeierstrassCurve.Affine.Point.some_ne_zero hc h1
    have bnd := rowPre_boundary read32 addr (Bridge.toB P0) hc hr en.1 en.2 hd hdo s initial hs.2.2 mPre
    rw [← hst3_def] at bnd
    have root3 : st3.basis windowRoot = true :=
      WEX.root_preserves read32 windowBits windowPaths windowRoot (erase rowPre) addr rowPre_placed ⟨false, s⟩ hs.2.2 mPre
    have hp := (point_holds _ _ _).mp bnd.point
    have hctl : st3.basis streamLayout.control = true := bnd.control
    have hCneg := some_ne_neg hc en.1
    have hC0 : (.some hc : ECDSAAdd.Secp256k1.Point) ≠ 0 := WeierstrassCurve.Affine.Point.some_ne_zero hc
    have rd := dialogFlagState_read streamLayout streamLayout_nodup (dialogInfinity true (Bridge.toB P0))
      (dialogDouble true (Bridge.toB P0) (.some hc)) (dialogInversePoint true (Bridge.toB P0) (.some hc))
      (dialogOrdinary true (Bridge.toB P0) (.some hc))
      (true && decide (dialogExceptionEnabled (.some hc))) (dialogException true (Bridge.toB P0) (.some hc))
      (true && decide (cy ≠ -cy))
    have sO : st3.basis 19816 = dialogInfinity true (Bridge.toB P0) := by
      rw [← PoolHost.streamLayout_infSel]; exact (bnd.flags _ (by simp [inPlaceFlags])).trans rd.1
    have sD : st3.basis 19815 = dialogDouble true (Bridge.toB P0) (.some hc) := by
      rw [← PoolHost.streamLayout_dblSel]; exact (bnd.flags _ (by simp [inPlaceFlags])).trans rd.2.1
    have sI : st3.basis 19814 = dialogInversePoint true (Bridge.toB P0) (.some hc) := by
      rw [← PoolHost.streamLayout_genSel]; exact (bnd.flags _ (by simp [inPlaceFlags])).trans rd.2.2.1
    have sG : st3.basis 14113 = dialogOrdinary true (Bridge.toB P0) (.some hc) := by
      rw [← PoolHost.streamLayout_gen]; exact (bnd.flags _ (by simp [inPlaceFlags])).trans rd.2.2.2.1
    have sE : st3.basis 14111 = (true && decide (dialogExceptionEnabled (.some hc))) := by
      rw [← PoolHost.streamLayout_eqX]; exact (bnd.flags _ (by simp [inPlaceFlags])).trans rd.2.2.2.2.1
    have sH : st3.basis 14112 = dialogException true (Bridge.toB P0) (.some hc) := by
      rw [← PoolHost.streamLayout_eqNegY]; exact (bnd.flags _ (by simp [inPlaceFlags])).trans rd.2.2.2.2.2.1
    have sDbl : st3.basis 14114 = (true && decide (cy ≠ -cy)) := by
      rw [← PoolHost.streamLayout_dbl]; exact (bnd.flags _ (by simp [inPlaceFlags])).trans rd.2.2.2.2.2.2
    have h14_true : st3.basis 14114 = true := by rw [sDbl, decide_eq_true en.1]; rfl
    have sD' : st3.basis 19815 = decide (Bridge.toB P0 = (.some hc : ECDSAAdd.Secp256k1.Point)) := by
      rw [sD, dialogDouble, decide_eq_true hCneg]; simp
    have sI' : st3.basis 19814 = decide (Bridge.toB P0 = -(.some hc : ECDSAAdd.Secp256k1.Point)) := by
      rw [sI]; simp [dialogInversePoint]
    have h11 : st3.basis 14111 = true := by rw [sE, decide_eq_true hen]; rfl
    have hfin_eq : st3.basis 838 = !dialogInfinity true (Bridge.toB P0) := by
      rw [← PoolHost.streamLayout_fin]
      cases hP : Bridge.toB P0 with
      | zero =>
        have hp0 : st3.basis streamLayout.point.finite = false := by rw [hP] at bnd; exact ((point_holds _ _ _).mp bnd.point).1
        rw [hp0, dialogInfinity, show (WeierstrassCurve.Affine.Point.zero : ECDSAAdd.Secp256k1.Point) = 0 from rfl]; simp
      | @some _ _ hrp =>
        have hp1 := (point_holds _ _ _).mp (hP ▸ bnd.point)
        rw [hp1.1, dialogInfinity, decide_eq_false (WeierstrassCurve.Affine.Point.some_ne_zero hrp)]; rfl
    have h16 : st3.basis 19816 = !st3.basis 838 := by rw [sO, hfin_eq, Bool.not_not]
    have h838_f : st3.basis 838 = (st3.basis 14113 ^^ st3.basis 19815 ^^ st3.basis 19814 ^^ st3.basis 14112) := by
      rw [hfin_eq, sG, sD, sI, sH, dialogOrdinary]
      cases dialogInfinity true (Bridge.toB P0) <;> cases dialogDouble true (Bridge.toB P0) (.some hc) <;>
        cases dialogInversePoint true (Bridge.toB P0) (.some hc) <;> cases dialogException true (Bridge.toB P0) (.some hc) <;> rfl
    have hex : ¬ (st3.basis 19815 = true ∧ st3.basis 19814 = true) := by
      rw [sD', sI']; simp only [decide_eq_true_eq, not_and]; intro h1 h2; exact hCneg (h1.symm.trans h2)
    have hDI : st3.basis 19815 = true → st3.basis 19814 = false := fun hD1 => by
      cases hI1 : st3.basis 19814
      · rfl
      · exact absurd ⟨hD1, hI1⟩ hex
    have hH_ex : st3.basis 14112 = true → st3.basis 19815 = false ∧ st3.basis 19814 = false := fun hh => by
      rw [sH] at hh; constructor
      · cases hD1 : st3.basis 19815
        · rfl
        · rw [sD', decide_eq_true_eq] at hD1; rw [hD1, dialogException_self] at hh; cases hh
      · cases hI1 : st3.basis 19814
        · rfl
        · rw [sI', decide_eq_true_eq] at hI1; rw [hI1, dialogException_neg] at hh; cases hh
    have hf7 : PoolHost.FlagInv7 st3.basis := ⟨h11, h16, h838_f, hDI, hH_ex⟩
    have h15_true : st3.basis 10015 = true := root3
    have h836_true : st3.basis 836 = true := hctl
    have htriple_of (X2 Y1 : ECDSAAdd.Fp) (G : Bool) :
        ∀ (st' : ECDSAAdd.State) (m : List Bool),
          PointDialogValues streamLayout X2 Y1 G st3.basis st'.basis →
          PointDialogValues streamLayout (X2 + (if G then 3 * cx else 0)) Y1 G st3.basis
            (ECDSAAdd.run (reference2 read addr midB4.forgetL) m st').basis := fun st' m hv => by
      rw [href_triple]
      have hchk := addX_checked read32 addr streamLayout streamLayout_widths streamLayout_nodup X2 Y1 G st3.basis (3 * cx)
        (wFields probeRows .tripleX) (row_bits hc hr .tripleX (3 * cx) (field_some_tripleX hc))
      exact (hchk.correct st' m hv).2
    rw [midW_eq_list] at hcl_mid hsf_mid
    -- Split into the 3 cases (`R = 0`, `R = some` with `G = false`, `R = some` with `G = true`)
    have hPB_step (X Y X0 : ECDSAAdd.Fp) (G : Bool)
        (hX0 : X0.val = X.val ^^^ (if st3.basis streamLayout.point.finite then 0 else 5))
        (hval3 : PointDialogValues streamLayout X Y G st3.basis st3.basis) :
        PointDialogValues streamLayout (X0 - cx) (Y - cy) G st3.basis st2.basis := by
      rw [hst2_eq]
      have z1 := literal_checked read32 addr _ _ _ (zrep_step streamLayout streamLayout_widths streamLayout_nodup X X0 Y G st3.basis hX0)
      have p1 := pair1_checked read32 addr probeRows hc hr X0 Y G st3.basis root3 hctl
      exact ((z1.seq p1).correct st3 mPB hval3).2
    cases hR : Bridge.toB P0 with
    | zero =>
      rw [hR] at bnd hp sG sD' sI'
      have hG : st3.basis 14113 = false := by
        rw [sG]; cases h : dialogOrdinary true 0 (.some hc)
        · rfl
        · exact absurd rfl ((dialogOrdinary_true true 0 _ hC0).mp h).2.1
      have hD0 : st3.basis streamLayout.doubleSelect = false := by rw [PoolHost.streamLayout_dblSel, sD']; simp [hC0.symm]
      have hI0 : st3.basis streamLayout.genericSelect = false := by rw [PoolHost.streamLayout_genSel, sI']; simp [(neg_ne_zero.mpr hC0).symm]
      have hfin : st3.basis streamLayout.point.finite = false := hp.1
      have hX1 : (5 : ECDSAAdd.Fp) - cx ≠ 0 := sub_ne_zero.mpr (x_ne_five hc).symm
      have hv2 := hPB_step 0 0 5 false (by rw [hfin, finFive_val, ZMod.val_zero]; decide)
        ⟨hp.2.1, hp.2.2, by rw [PoolHost.streamLayout_gen]; exact hG, bnd.clean, fun _ _ => rfl⟩
      refine ⟨⟨st3.basis, false, 5 - cx, 0 - cy, 5 - cx, (0 - cy) / (5 - cx), 5 - cx, 5 - cx, 5 - cx,
        ((0 - cy) / (5 - cx)) * (5 - cx), cx, by rw [hD0]; simp, by rw [hD0, hI0]; simp, by rw [hD0, hI0]; simp,
        hX1, rfl, by simp, by simp, by simpa using htriple_of (5 - cx) ((0 - cy) / (5 - cx)) false,
        by rw [hD0, hI0]; simp, by rw [hD0, hI0]; simp, hX1, rfl, fun h => by cases h⟩,
        hv2, hf7, h15_true, h836_true, h14_true, hG, ha2, hcl_mid, hsf_mid⟩
    | @some x y hrp =>
      rw [hR] at bnd hp sG sD' sI'
      have hfin : st3.basis streamLayout.point.finite = true := hp.1
      cases hGv : dialogOrdinary true (.some hrp) (.some hc) with
      | false =>
        have sG' : st3.basis 14113 = false := sG.trans hGv
        have hD_imp : st3.basis streamLayout.doubleSelect = true → x = cx := by
          rw [PoolHost.streamLayout_dblSel, sD']; intro h; exact (WeierstrassCurve.Affine.Point.some.inj (of_decide_eq_true h)).1
        have hI_imp : st3.basis streamLayout.genericSelect = true → x = cx := by
          rw [PoolHost.streamLayout_genSel, sI']; intro h
          have h' := of_decide_eq_true h; rw [WeierstrassCurve.Affine.Point.neg_some] at h'
          exact (WeierstrassCurve.Affine.Point.some.inj h').1
        have hX1_ne : st3.basis streamLayout.doubleSelect = false → st3.basis streamLayout.genericSelect = false → x - cx ≠ 0 := by
          rw [PoolHost.streamLayout_dblSel, PoolHost.streamLayout_genSel, sD', sI']; intro h1 h2 hz
          rcases (sameX_iff_eq_or_neg hrp hc).mp (sub_eq_zero.mp hz) with h | h
          · exact absurd (decide_eq_true h) (by rw [h1]; decide)
          · exact absurd (decide_eq_true h) (by rw [h2]; decide)
        set E := (st3.basis streamLayout.doubleSelect || st3.basis streamLayout.genericSelect) with hE
        let xg : ECDSAAdd.Fp := if E then 5 else x - cx
        have hxg0 : xg ≠ 0 := by
          simp only [xg]; split
          · exact finFive_ne_zero
          · rename_i hne; simp only [hE, Bool.or_eq_true, not_or, Bool.not_eq_true] at hne; exact hX1_ne hne.1 hne.2
        have hzero : E = true → x - cx = 0 := fun h => by
          simp only [hE, Bool.or_eq_true] at h
          rcases h with h | h <;> [rw [hD_imp h, sub_self]; rw [hI_imp h, sub_self]]
        have hex' : ¬ (st3.basis streamLayout.doubleSelect = true ∧ st3.basis streamLayout.genericSelect = true) := by
          simpa [PoolHost.streamLayout_dblSel, PoolHost.streamLayout_genSel] using hex
        have fwd : xg.val = ((x - cx).val ^^^ (if st3.basis streamLayout.doubleSelect then 5 else 0)) ^^^
            (if st3.basis streamLayout.genericSelect then 5 else 0) := by
          simp only [xg]; cases hd : st3.basis streamLayout.doubleSelect <;> cases hi : st3.basis streamLayout.genericSelect
          · simp [hE, hd, hi]
          · have : E = true := by simp [hE, hd, hi]
            simp only [this, if_true, hd, hi, if_false]; rw [hzero this, ZMod.val_zero, finFive_val]; simp
          · have : E = true := by simp [hE, hd, hi]
            simp only [this, if_true, hd, hi, if_false]; rw [hzero this, ZMod.val_zero, finFive_val]; simp
          · exact absurd ⟨hd, hi⟩ hex'
        have bck : (x - cx).val = (xg.val ^^^ (if st3.basis streamLayout.doubleSelect then 5 else 0)) ^^^
            (if st3.basis streamLayout.genericSelect then 5 else 0) := by
          simp only [xg]; cases hd : st3.basis streamLayout.doubleSelect <;> cases hi : st3.basis streamLayout.genericSelect
          · simp [hE, hd, hi]
          · have : E = true := by simp [hE, hd, hi]
            simp only [this, if_true, hd, hi, if_false]; rw [hzero this, ZMod.val_zero, finFive_val]; simp
          · have : E = true := by simp [hE, hd, hi]
            simp only [this, if_true, hd, hi, if_false]; rw [hzero this, ZMod.val_zero, finFive_val]; simp
          · exact absurd ⟨hd, hi⟩ hex'
        have hv2 := hPB_step x y x false (by rw [hfin]; simp)
          ⟨hp.2.1, hp.2.2, by rw [PoolHost.streamLayout_gen]; exact sG', bnd.clean, fun _ _ => rfl⟩
        refine ⟨⟨st3.basis, false, x - cx, y - cy, xg, (y - cy) / xg, x - cx, x - cx, xg, ((y - cy) / xg) * xg, cx,
          hex', fwd, bck, hxg0, rfl, by simp, by simp, by simpa using htriple_of (x - cx) ((y - cy) / xg) false,
          fwd, bck, hxg0, rfl, fun h => by cases h⟩,
          hv2, hf7, h15_true, h836_true, h14_true, sG', ha2, hcl_mid, hsf_mid⟩
      | true =>
        have he' := ((dialogOrdinary_true true _ _ hC0).mp hGv).2
        have den := dialog_denominators_ne_zero hrp hc he'.2.1 he'.2.2.1 he'.2.2.2
        have sG' : st3.basis 14113 = true := sG.trans hGv
        have hD0 : st3.basis streamLayout.doubleSelect = false := by rw [PoolHost.streamLayout_dblSel, sD']; exact decide_eq_false he'.2.1
        have hI0 : st3.basis streamLayout.genericSelect = false := by rw [PoolHost.streamLayout_genSel, sI']; exact decide_eq_false he'.2.2.1
        let a_sl := genericSlope x y cx cy
        let d_x := cx - genericX x y cx cy
        have hv_in := generic_inplace_values x y cx cy den.1
        have hv2 := hPB_step x y x true (by rw [hfin]; simp)
          ⟨hp.2.1, hp.2.2, by rw [PoolHost.streamLayout_gen]; exact sG', bnd.clean, fun _ _ => rfl⟩
        refine ⟨⟨st3.basis, true, x - cx, y - cy, x - cx, a_sl, (x - cx) - a_sl * a_sl, d_x, d_x, a_sl * d_x, cx,
          by rw [hD0]; simp, by rw [hD0, hI0]; simp, by rw [hD0, hI0]; simp,
          sub_ne_zero.mpr den.1, rfl, by simp, by simp only [if_true]; exact hv_in.2.1.symm,
          by have hd_eq : x - cx - a_sl * a_sl + 3 * cx = d_x := hv_in.2.1; simpa only [if_true, hd_eq] using htriple_of ((x - cx) - a_sl * a_sl) a_sl true,
          by rw [hD0, hI0]; simp, by rw [hD0, hI0]; simp, den.2, rfl, fun _ => den.2⟩,
          hv2, hf7, h15_true, h836_true, h14_true, sG', ha2, hcl_mid, hsf_mid⟩

private theorem literalRecords_plain (P : ECDSAAdd.Program) :
    literalRecords (erase2 (WideBank8.Fast16.FBlock2.std (.plain (Rows.code r16 (wLiteral P)))).forgetL) =
      ECDSAAdd.measurementCount P := by
  simp only [WideBank8.Fast16.FBlock2.forgetL, erase2, Block2.code, Rows.code, Rows.instr, wLiteral,
    literalRecords, List.flatMap_cons, List.flatMap_nil, List.map_cons, List.map_nil, List.append_nil, Nat.add_zero]

theorem compiledMidW_catSim (coeffs : Fin 65536 → PointCoeff) (Q : Secp256k1.Point)
    (hQ : ShorECDLP.order • Q = 0) (hn : ∀ i, constantPoint Q (coeffs i) ≠ 0)
    (s : Nat) (h : Fin s → Bool) :
    ∃ cs : List ℂ, List.Forall₂
      (fun b c => ∃ m : List Bool, m.length = literalRecords (erase2 (WideBank8.Fast16.fforget CornerWire.Wide16.midW)) ∧
        ∀ addr st2, ValidK coeffs Q addr st2 →
          b.kraus (Prep 14833 (Bridge.signedKet st2)) =
            c • Prep 14833 (Bridge.signedKet (ECDSAAdd.run (reference2 (readConstant coeffs Q) addr
              (WideBank8.Fast16.fforget CornerWire.Wide16.midW)) m st2)))
      ((compiledMidW s).prog.instantiate (readConstant coeffs Q) h).run cs ∧
      (cs.map Complex.normSq).sum = 1 := by
  let read := readConstant coeffs Q
  have hg := guard5_avoid_14832_14833
  have hn8 := negXReg_avoid_14832_14833
  have hsq := midB3_avoid_15653_15654
  have htr := midB4_avoid_14849_14850
  have hmem0 : midB0 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  have hmem1 : midB1 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  have hmem2 : midB2 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  have hmem3 : midB3 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  have hmem4 : midB4 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  have hmem5 : midB5 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  have hmem6 : midB6 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  have hmem7 : midB7 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  have hmem8 : midB8 ∈ CornerWire.Wide16.midW := by rw [midW_eq_list]; simp only [List.mem_cons, true_or, or_true]
  -- Define the 9 stage predicates `P0..P8`
  let P0 := MidStage read ([midB0, midB1, midB2, midB3, midB4, midB5, midB6, midB7, midB8]) (fun _ d => (d.X0, d.Y0))
  let P1 := MidStage read ([midB1, midB2, midB3, midB4, midB5, midB6, midB7, midB8]) (fun _ d => (d.X1, d.Y0))
  let P2 := MidStage read ([midB2, midB3, midB4, midB5, midB6, midB7, midB8]) (fun _ d => (d.X1, d.Y1))
  let P3 := MidStage read ([midB3, midB4, midB5, midB6, midB7, midB8]) (fun _ d => (d.X0, d.Y1))
  let P4 := MidStage read ([midB4, midB5, midB6, midB7, midB8]) (fun _ d => (d.X2, d.Y1))
  let P5 := MidStage read ([midB5, midB6, midB7, midB8]) (fun _ d => (d.X3, d.Y1))
  let P6 := MidStage read ([midB6, midB7, midB8]) (fun _ d => (d.X4, d.Y1))
  let P7 := MidStage read ([midB7, midB8]) (fun _ d => (d.X4, d.Y2))
  let P8 := MidStage read ([midB8]) (fun _ d => (d.X3, d.Y2))
  -- Linear `Indep` chain with exact syntactic `CatFn` trees (zero `let` aliases!)
  have hi8 := CatFn.lower_indep 14832 14833 (WideBank8.Fast16.fblockProg midB8 0)
  have hi7 := CatFn.seq_indep _ _ (CatFn.lower_indep 14832 14833 (WideBank8.Fast16.fblockProg midB7 0)) hi8
  have hi6 := CatFn.seq_indep _ _ (compiledHostArith_indep true) hi7
  have hi5 := CatFn.seq_indep _ _ (CatFn.lower_indep 14832 14833 (WideBank8.Fast16.fblockProg midB5 0)) hi6
  have hi4 := CatFn.seq_indep _ _ (CatFn.swapSurround_indep 14833 14850 _ (CatFn.lower_indep 14849 14850 (WideBank8.Fast16.fblockProg midB4 0))) hi5
  have hi3 := CatFn.seq_indep _ _ (CatFn.swapSurround_indep 14833 15654 _ (CatFn.lower_indep 15653 15654 (WideBank8.Fast16.fblockProg midB3 0))) hi4
  have hi2 := CatFn.seq_indep _ _ (CatFn.lower_indep 14832 14833 (WideBank8.Fast16.fblockProg midB2 0)) hi3
  have hi1 := CatFn.seq_indep _ _ (compiledHostArith_indep false) hi2
  -- Helper for extracting `CatBlockSim` of a lowered block at stage `rem = b :: tail`
  have hlow_stage (q y : Wire) (b : WideBank8.Fast16.FBlock2 65536) (hb : b ∈ CornerWire.Wide16.midW)
      (tail : WideBank8.Fast16.FCode2 65536) (getXY : ∀ addr, MidData read addr → ECDSAAdd.Fp × ECDSAAdd.Fp)
      (hq : q ∉ ChallengeMigration.straightWires (WideBank8.Fast16.fblockProg b 0))
      (hy : y ∉ ChallengeMigration.straightWires (WideBank8.Fast16.fblockProg b 0)) (hqy : q ≠ y)
      (hqp : q ∈ streamLayout.dialogPool) (hyp : y ∈ streamLayout.dialogPool)
      (s' : Nat) (h' : Fin s' → Bool) :
      CatBlockSim y read b.forgetL (MidStage read (b :: tail) getXY)
        ((CatFn.lower q y (WideBank8.Fast16.fblockProg b 0) s').prog.instantiate read h') :=
    catBlockSim_lower_fblock q y b hb hq hy hqy _ (fun addr st ⟨d, hv, _, _, _, _, _, ha, hcl, hsf⟩ =>
      ⟨ha, hcl.1, (WideBank8.Fast16.safe2_append_inv read addr b.forgetL (WideBank8.Fast16.fforget tail) st
        (by simpa [WideBank8.Fast16.fforget_cons] using hsf)).1,
       pointDialogValues_pool_false hv q hqp, pointDialogValues_pool_false hv y hyp⟩) s' h'
  -- Helper for `compiledHostArith` as a `CatBlockSim`
  have harith_stage (mul : Bool) (tail : WideBank8.Fast16.FCode2 65536)
      (getXY : ∀ addr, MidData read addr → ECDSAAdd.Fp × ECDSAAdd.Fp)
      (hXne : ∀ addr (d : MidData read addr), (getXY addr d).1 ≠ 0)
      (s' : Nat) (h' : Fin s' → Bool) :
      CatBlockSim 14833 read (WideBank8.Fast16.FBlock2.std (.plain (Rows.code r16 (wLiteral (arithS streamLayout mul))))).forgetL
