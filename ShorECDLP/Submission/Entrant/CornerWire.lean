        rw [allData, portPhase_append _ _ _ _ hlen123, portPhase_append _ _ _ _ hlen12,
          portPhase_append _ _ _ _ (by rw [ho1, d1_len]),
          portPhase_eq_registerXPhase d4 o4 read a next.basis hu4, d4_targets]
      change b.kraus (xResetRegisterKraus pairExtraWires o4 (Bridge.signedKet next)) = _
      have he : b.kraus (ket (clearRegister pairExtraWires next.basis)) =
