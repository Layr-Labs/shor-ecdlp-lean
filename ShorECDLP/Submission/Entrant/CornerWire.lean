  · have hs := literalConstAdd_wires _ _ _ _ _ h
    simp only [List.mem_toFinset, List.mem_cons, List.mem_append, cellLayout_one, cellLayout_lower] at hs
    rcases hs with e | e | hr | hc
    · have := MappedCompressed.base_injective e; omega
    · have := MappedCompressed.base_injective e; omega
    · exact cell_not_low k (by omega) hr
    · exact cellLayout_carry_take254_ne k hk hc
  · simp only [cellLayout_lower, ECDSAAdd.wires, ECDSAAdd.Instr.wires, Finset.mem_union,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at h
