/-! ##### `CatLitSim (base 1026)` for all 4 Cell Kernels (pure Boolean `CellClean`) -/

theorem compiledForwardPrefix_catLitSim {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim (base 1026) ((compiledForwardPrefix (n := n) start).prog.instantiate read h)
      (TopReuse.forwardPrefix cellLayout) CellClean := by
  have h1 : ∀ (s : Nat) (r : ConstantBit n → Bool) (h' : Fin s → Bool),
      CatLitSim (base 1026) ((CatFn.noT (GuardCompression.seed cellLayout) s).prog.instantiate r h')
        (GuardCompression.seed cellLayout) CellClean := fun s r h' =>
    catLitSim_weaken (CatFn.noT_catLitSim (base 1026) (GuardCompression.seed cellLayout)
      (cell_seed_avoid 1026 (by omega)) s r h') (fun _ _ => trivial)
  have h12 := CatFn.seq_catLitSim _ _ compiledRawAdd_indep _ _ CellClean _ h1 compiledRawAdd_catLitSim
    (fun st m hc _ => cell_seed_pres_clean st m hc)
  have h123 := CatFn.seq_catLitSim _ _ (CatFn.compileProg_indep _ _ _) _ (OneReuse.remainder cellLayout) CellClean _ h12
    (CatFn.compileProg_catLitSim (base 1541) (base 1026) (OneReuse.remainder cellLayout)
      (cell_remainder_avoid 1541 (Or.inl rfl)) (cell_remainder_avoid 1026 (Or.inr rfl))
      (cell_base_ne 1541 1026 (by omega)) cell_fwd_parts_phys.2.2.1)
    (fun st m hc _ => by
      rw [ECDSAAdd.run_append]
      have hs (r : List Bool) := cell_seed_pres_clean st r hc
      have hr (r1 r2 : List Bool) := cell_rawAdd_pres _ r2 (hs r1).1 (hs r1).2
      exact ⟨(hr _ _).2 _ base_1541_mem_carry, (hr _ _).2 _ base_1026_mem_carry⟩)
  rw [compiledForwardPrefix, TopReuse.forwardPrefix]
  exact h123 start read h

theorem compiledCleanup_catLitSim {n : Nat} (isE : Bool) (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim (base 1026) ((compiledCleanup (n := n) isE start).prog.instantiate read h)
      (if isE then TopReuse.cleanupE cellLayout else TopReuse.cleanup cellLayout)
      (fun s => s (base 1027) = false ∧ ∀ w ∈ cellLayout.carry, s w = false) := by
  let tailProg := (BalancedCleanup.prepareCompare cellLayout.toLayout).reverse ++
    ((if isE then TopReuse.unnormalizeE cellLayout.toLayout else BalancedCleanup.unnormalize cellLayout.toLayout) ++
      (BalancedCleanup.prepareSign cellLayout.toLayout).reverse)
  have ht_av (k : Nat) (hk : k = 1541 ∨ k = 1026) : base k ∉ ECDSAAdd.wires tailProg := by
    simp only [tailProg, ECDSAAdd.wires_append, ECDSAAdd.wires_reverse, Finset.mem_union]
    rintro (h' | h' | h')
    · exact cell_prepCmp_avoid k hk h'
    · cases isE
      · exact cell_unnorm_avoid k hk h'
      · exact cell_unnormE_avoid k hk h'
    · exact cell_prepSign_avoid k hk h'
  have ht_ph : ECDSAAdd.Arithmetic.GatePhysical tailProg := by
    simp only [tailProg, gatePhysical_append]
    refine ⟨cell_fwd_parts_phys.2.2.2.2.1, ?_, cell_fwd_parts_phys.2.2.2.2.2.2⟩
    cases isE
    · exact cell_fwd_parts_phys.2.2.2.2.2.1
    · exact cell_unnormE_phys
  have h1 : ∀ (s : Nat) (r : ConstantBit n → Bool) (h' : Fin s → Bool),
      CatLitSim (base 1026) ((CatFn.noT (BalancedCleanup.prepareCompare cellLayout.toLayout) s).prog.instantiate r h')
        (BalancedCleanup.prepareCompare cellLayout.toLayout)
        (fun s => s (base 1027) = false ∧ ∀ w ∈ cellLayout.carry, s w = false) := fun s r h' =>
    catLitSim_weaken (CatFn.noT_catLitSim (base 1026) (BalancedCleanup.prepareCompare cellLayout.toLayout)
      (cell_prepCmp_avoid 1026 (Or.inr rfl)) s r h') (fun _ _ => trivial)
  have h12 := CatFn.seq_catLitSim _ _ (compileCompareLt_indep _ _ _ _ _ _ _) _ _ _ _ h1 (cell_cmp_catLitSim true)
    (fun st m ⟨ho, hca⟩ _ => cell_prepCmp_pres_one_carry st m ho hca)
  have h123 := CatFn.seq_catLitSim _ _ (CatFn.compileProg_indep _ _ _) _ tailProg _ _ h12
    (CatFn.compileProg_catLitSim (base 1541) (base 1026) tailProg
      (ht_av 1541 (Or.inl rfl)) (ht_av 1026 (Or.inr rfl)) (cell_base_ne 1541 1026 (by omega)) ht_ph)
    (fun st m _ _ => by
      have hw := BalancedCleanup.widths cellLayout.toLayout cellLayout_widths
      have haway : ∀ q ∈ cellLayout.carry, q ∉ cellLayout.one :: cellLayout.r := fun q hq hm => by
        simp only [List.mem_cons] at hm
        rcases hm with rfl | hr
        · exact cell_not_carry 1027 ⟨by omega, by omega, by omega, by omega⟩ hq
        · exact cell_rawTarget_disj_carry (by simp [BalancedCircuit.rawTarget, hr]) hq
      rw [ECDSAAdd.run_append]
      exact ⟨EndKnown.compareLtTop_carry _ _ _ _ _ (by rw [cellLayout_widths.2.2, hw.2.1]) (by omega)
          cell_carry_nodup haway _ _ _ base_1541_mem_carry,
        EndKnown.compareLtTop_carry _ _ _ _ _ (by rw [cellLayout_widths.2.2, hw.2.1]) (by omega)
          cell_carry_nodup haway _ _ _ base_1026_mem_carry⟩)
  have hpeq :
      (BalancedCleanup.prepareCompare cellLayout.toLayout ++
        cmpLtProg true cellLayout.y cellLayout.r cellLayout.carry cellLayout.one cellLayout.parity) ++ tailProg =
      if isE then TopReuse.cleanupE cellLayout else TopReuse.cleanup cellLayout := by
    cases isE <;> simp [TopReuse.cleanup, TopReuse.cleanupE, cmpLtProg, tailProg, List.append_assoc]
  rw [compiledCleanup, ← hpeq]
  exact h123 start read h

private theorem cell_fwdPrefix_out (st : ECDSAAdd.State) (m : List Bool) (hc : CellClean st.basis) :
    (ECDSAAdd.run (TopReuse.forwardPrefix cellLayout) m st).basis (base 1027) = false ∧
    ∀ w ∈ cellLayout.carry, (ECDSAAdd.run (TopReuse.forwardPrefix cellLayout) m st).basis w = false := by
  simp only [TopReuse.forwardPrefix, ECDSAAdd.run_append]
  have hs (r : List Bool) := cell_seed_pres_clean st r hc
  have hr (r1 r2 : List Bool) := cell_rawAdd_pres _ r2 (hs r1).1 (hs r1).2
  exact cell_remainder_pres _ _ (hr _ _).2

theorem compiledForward_catLitSim {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
