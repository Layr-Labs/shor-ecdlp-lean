-- Universal `Straight.append` T-count upper bound (works even when continuation `q` depends on history!)
private theorem b_append_tCount_le {n s m e : Nat} (p : Straight n s m) (q : Straight n m e)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) (t2 : Nat)
    (hq : ∀ h' : Fin m → Bool, (q.instantiate read h').tCount ≤ t2) :
    ((p.append q).instantiate read h).tCount ≤ (p.instantiate read h).tCount + t2 := by
  induction p with
  | done =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount, Nat.zero_add]
    exact hq h
  | gate g p ih =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount]
    have h1 := ih q h hq
    omega
  | recordGate i v g p ih =>
    by_cases hv : h i = v <;>
    · simp only [Straight.append, Straight.instantiate, hv, if_true, if_false, AdaptiveCircuit.tCount]
      have h1 := ih q h hq
      omega
  | measure w p ih =>
    simp only [Straight.append, Straight.instantiate, AdaptiveCircuit.tCount]
    have h0 := ih q (Fin.lastCases false h) hq
    have h1 := ih q (Fin.lastCases true h) hq
    omega

-- Step combinator: run `CatFn` `f` then continuation `k` with cast history references (zero `castFinish`!)
def stepCatFn {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (start : Nat) (refs : List (Fin start)) : CatProg n start :=
  let a := f start
  let b := k a.finish (refs.map (Fin.castLE (straight_start_le_finish a.prog)))
  ⟨b.finish, a.prog.append b.prog⟩

private theorem stepCatFn_finish {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (D1 D2 : Nat) (hf : ∀ s, (f s).finish = s + D1) (hk : ∀ c rs, (k c rs).finish = c + D2)
    (start : Nat) (refs : List (Fin start)) :
    (stepCatFn f k start refs).finish = start + (D1 + D2) := by
  change (k (f start).finish _).finish = _
  rw [hk, hf, Nat.add_assoc]

private theorem stepCatFn_removed18 {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (hf : ∀ s, removed 18 (f s).prog = 0) (hk : ∀ c rs, removed 18 (k c rs).prog = 0)
    (start : Nat) (refs : List (Fin start)) :
    removed 18 (stepCatFn f k start refs).prog = 0 := by
  change removed 18 ((f start).prog.append _) = 0
  rw [LocalFour.removed_append, hf, hk]

private theorem stepCatFn_tCount_le {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (T1 T2 : Nat) (read : ConstantBit n → Bool)
    (hf : ∀ s h, ((f s).prog.instantiate read h).tCount ≤ T1)
    (hk : ∀ c rs hh, ((k c rs).prog.instantiate read hh).tCount ≤ T2)
    (start : Nat) (refs : List (Fin start)) (h : Fin start → Bool) :
    ((stepCatFn f k start refs).prog.instantiate read h).tCount ≤ T1 + T2 := by
  change (((f start).prog.append _).instantiate read h).tCount ≤ T1 + T2
  exact (b_append_tCount_le _ _ read h T2 (fun h' => hk _ _ h')).trans (Nat.add_le_add_right (hf start h) T2)

private theorem stepCatFn_slots_le {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (S1 S2 : Nat) (hf : ∀ s, (f s).prog.gateSlots ≤ S1) (hk : ∀ c rs, (k c rs).prog.gateSlots ≤ S2)
    (start : Nat) (refs : List (Fin start)) :
    (stepCatFn f k start refs).prog.gateSlots ≤ S1 + S2 := by
  change ((f start).prog.append _).gateSlots ≤ S1 + S2
  rw [Straight.gateSlots_append]
  exact Nat.add_le_add (hf start) (hk _ _)

private theorem stepCatFn_wires {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    {S : List Wire} (hf : ∀ s, ChallengeMigration.straightWires (f s).prog ⊆ S)
    (hk : ∀ c rs, ChallengeMigration.straightWires (k c rs).prog ⊆ S)
    (start : Nat) (refs : List (Fin start)) :
    ChallengeMigration.straightWires (stepCatFn f k start refs).prog ⊆ S := by
  change ChallengeMigration.straightWires ((f start).prog.append _) ⊆ S
  rw [straightWires_append]
  exact List.append_subset.mpr ⟨hf start, hk _ _⟩

private theorem stepCatFn_wellFormed {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (hf : ∀ s, (f s).prog.WellFormed) (hk : ∀ c rs, (k c rs).prog.WellFormed)
    (start : Nat) (refs : List (Fin start)) :
    (stepCatFn f k start refs).prog.WellFormed :=
  straight_append_wellFormed _ _ (hf start) (hk _ _)

private theorem stepCatFn_sim {n : Nat} (f : CatFn n) (k : (c : Nat) → List (Fin c) → CatProg n c)
    (read : ConstantBit n → Bool) (start : Nat) (refs : List (Fin start)) (h : Fin start → Bool)
    (P₁ P₂ Q : InstrumentBranch → ℂ → Prop)
    (hf : ∃ cs₁ : List ℂ, List.Forall₂ P₁ ((f start).prog.instantiate read h).run cs₁ ∧
      (cs₁.map Complex.normSq).sum = 1)
    (hk : ∀ (c : Nat) (rs : List (Fin c)) (hh : Fin c → Bool), rs.map hh = refs.map h →
      ∃ cs₂ : List ℂ, List.Forall₂ P₂ ((k c rs).prog.instantiate read hh).run cs₂ ∧
        (cs₂.map Complex.normSq).sum = 1)
    (hcomb : ∀ b₁ c₁ b₂ c₂, P₁ b₁ c₁ → P₂ b₂ c₂ → Q (b₁.seq b₂) (c₁ * c₂)) :
    ∃ cs : List ℂ, List.Forall₂ Q ((stepCatFn f k start refs).prog.instantiate read h).run cs ∧
      (cs.map Complex.normSq).sum = 1 := by
  obtain ⟨cs₁, ha₁, hm₁⟩ := hf
  obtain ⟨cs, hal, hm⟩ := append_sim_forall2 (f start).prog
    (k (f start).finish (refs.map (Fin.castLE (straight_start_le_finish (f start).prog)))).prog
    read h P₁ P₂ Q cs₁ ha₁
    (fun h' hh' => hk _ _ h' (by rw [List.map_map]; exact List.map_congr_left (fun i _ => hh' i)))
    hcomb
  exact ⟨cs, hal, hm.trans hm₁⟩

-- Commutativity of `xResetRegisterKraus` with `Prep y` when `y ∉ ws`
private theorem xResetRegisterKraus_prep (y : Wire) (ws : List Wire) (hy : y ∉ ws) :
    ∀ (os : List Bool) (psi : State),
      xResetRegisterKraus ws os (Prep y psi) = Prep y (xResetRegisterKraus ws os psi) := by
  induction ws with
  | nil =>
    intro os psi
    cases os with
    | nil => rfl
    | cons _ _ => simp only [xResetRegisterKraus, LinearMap.zero_apply, map_zero]
  | cons w ws ih =>
    intro os psi
    cases os with
    | nil => simp only [xResetRegisterKraus, LinearMap.zero_apply, map_zero]
    | cons o os =>
      have hyw : y ≠ w := fun e => hy (e ▸ List.mem_cons_self)
      have hyws : y ∉ ws := fun hm => hy (List.mem_cons_of_mem _ hm)
      rw [xResetRegisterKraus, LinearMap.comp_apply, LinearMap.comp_apply,
        Catalyst.prepare_reset y w hyw o psi, ih hyws os]

-- Commutativity of `xResetRegisterKraus` applied to `Prep y (Bridge.signedKet st)`
private theorem xResetRegisterKraus_prep_signedKet (y : Wire) (ws : List Wire) (os : List Bool)
    (st : ECDSAAdd.State) (hy : y ∉ ws) (ho : os.length = ws.length) (hnd : ws.Nodup) :
    xResetRegisterKraus ws os (Prep y (Bridge.signedKet st)) =
      (registerXResetMagnitude ws.length * registerXPhase ws os st.basis) •
        Prep y (Bridge.signedKet ⟨st.phase, clearRegister ws st.basis⟩) := by
  rw [xResetRegisterKraus_prep y ws hy os, signedKet_smul_eq, signedKet_smul_eq,
    map_smul, map_smul, map_smul, xResetRegisterKraus_ket ws os st.basis ho hnd,
    registerXResetCoeff_eq_magnitude_mul_phase ws os st.basis ho, map_smul, smul_smul, smul_smul]
  exact congrArg (· • _) (by ring)

private theorem phase_cancel_prep (mag c prev p : ℂ) (hp : p * p = 1) :
    mag * p * (c * (prev * p)) = mag * c * prev := by
  calc mag * p * (c * (prev * p)) = (mag * c * prev) * (p * p) := by ring
    _ = mag * c * prev := by rw [hp, mul_one]

private theorem phase_cancel_prep_0 (mag c p : ℂ) (hp : p * p = 1) :
    mag * p * (c * p) = mag * c := by
  calc mag * p * (c * p) = (mag * c) * (p * p) := by ring
    _ = mag * c := by rw [hp, mul_one]

-- Helper for lifting `CatProg.lit` prepend/append on `Forall₂`
private theorem b_literal_append_run {n s e : Nat} (gs : Circuit) (p : Straight n s e)
    (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    (((literalProgram (n := n) (s := s) gs).append p).instantiate read h).run =
      (p.instantiate read h).run.map (fun br => ⟨br.history, br.kraus.comp (Quantum.run gs)⟩) := by
  induction gs with
  | nil =>
    change (p.instantiate read h).run = _
    have he : (fun br : InstrumentBranch => (⟨br.history, br.kraus.comp (Quantum.run ([] : Circuit))⟩ : InstrumentBranch)) = id := by
      funext br; cases br; simp only [id_eq, InstrumentBranch.mk.injEq, true_and]
      apply LinearMap.ext; intro psi; simp only [LinearMap.comp_apply, Quantum.run_nil]
    rw [he, List.map_id]
  | cons g gs ih =>
    change ((((literalProgram gs).append p).instantiate read h).run.map
      (fun br : InstrumentBranch => (⟨br.history, br.kraus.comp (Quantum.run [g])⟩ : InstrumentBranch))) = _
    rw [ih, List.map_map]
    apply List.map_congr_left
    intro br _; cases br
    simp only [Function.comp_def, InstrumentBranch.mk.injEq, true_and]
    apply LinearMap.ext; intro psi
    simp only [LinearMap.comp_apply, Quantum.run_cons, Quantum.run_singleton, Quantum.run_nil]

private theorem b_flatMap_singleton {α β : Type*} (f : α → β) (l : List α) :
    l.flatMap (fun x => [f x]) = l.map f := by
  induction l with
  | nil => rfl
  | cons x xs ih => simp only [List.flatMap_cons, List.singleton_append, List.map_cons, ih]

private theorem b_catProg_surround_run {n start : Nat} (c₁ c₂ : Circuit)
    (body : CatProg n start) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((((CatProg.lit (n := n) (start := start) c₁).append body).append
        (CatProg.lit (n := n) (start := body.finish) c₂)).prog.instantiate read h).run =
      (body.prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run c₂).comp br.kraus).comp (Quantum.run c₁)⟩) := by
  rw [CatProg.append, indep_append_run _ _ (CatProg.lit_indep c₂) read h,
    AdaptiveCircuit.run_seq, CatProg.lit_run, CatProg.append]
  dsimp only [CatProg.lit, Instrument.seq, List.map_singleton]
  rw [b_literal_append_run c₁ body.prog read h, b_flatMap_singleton, List.map_map]
  apply List.map_congr_left
  intro br _; cases br
  simp only [Function.comp_def, InstrumentBranch.seq, List.append_nil, LinearMap.comp_assoc]

private theorem b_catProg_swapSurround_run {n start : Nat} (y₁ y₂ : Wire)
    (body : CatProg n start) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((((CatProg.lit (n := n) (start := start) (swapCircuit y₁ y₂)).append body).append
        (CatProg.lit (n := n) (start := body.finish) (swapCircuit y₂ y₁))).prog.instantiate read h).run =
      (body.prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run (swapCircuit y₂ y₁)).comp br.kraus).comp (Quantum.run (swapCircuit y₁ y₂))⟩) :=
  b_catProg_surround_run (swapCircuit y₁ y₂) (swapCircuit y₂ y₁) body read h

private theorem b_catFn_swapSurround_run {n : Nat} (y₁ y₂ : Wire) (body : CatFn n)
    (hbi : ∀ s, Indep (body s).prog) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.swapSurround y₁ y₂ body s).prog.instantiate read h).run =
      ((body s).prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run (swapCircuit y₂ y₁)).comp br.kraus).comp (Quantum.run (swapCircuit y₁ y₂))⟩) := by
  rw [CatFn.swapSurround, CatFn.seq, CatFn.seq, CatFn.lit, CatFn.lit]
  exact b_catProg_surround_run (swapCircuit y₁ y₂) (swapCircuit y₂ y₁) (body s) read h

private theorem b_catFn_flipSwapSurround_run {n : Nat} (y w : Wire) (body : CatFn n)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.flipSwapSurround y w body s).prog.instantiate read h).run =
      ((body s).prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run (unflipSwapCircuit y w)).comp br.kraus).comp (Quantum.run (flipSwapCircuit y w))⟩) := by
  rw [CatFn.flipSwapSurround, CatFn.seq, CatFn.seq, CatFn.lit, CatFn.lit]
  exact b_catProg_surround_run (flipSwapCircuit y w) (unflipSwapCircuit y w) (body s) read h

private theorem b_catFn_doubleFlipSwapSurround_run {n : Nat} (y w q : Wire) (body : CatFn n)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((CatFn.doubleFlipSwapSurround y w q body s).prog.instantiate read h).run =
      ((body s).prog.instantiate read h).run.map (fun br =>
        ⟨br.history, ((Quantum.run (doubleUnflipSwapCircuit y w q)).comp br.kraus).comp (Quantum.run (doubleFlipSwapCircuit y w q))⟩) := by
  rw [CatFn.doubleFlipSwapSurround, CatFn.seq, CatFn.seq, CatFn.lit, CatFn.lit]
  exact b_catProg_surround_run (doubleFlipSwapCircuit y w q) (doubleUnflipSwapCircuit y w q) (body s) read h

