    (CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.noT_indep _) (compileAddInPlaceTop_indep _ _ _ _ _)) (CatFn.noT_indep _))
    (CatFn.seq_tCount_le _ _ (CatFn.noT_indep _)
      (CatFn.seq_tCount_le _ _ (compileAddInPlaceTop_indep _ _ _ _ _)
        (CatFn.noT_tCount _ hpre0)
        (fun s' r' h' => le_of_eq (compileAddInPlaceTop_tCount _ _ _ _ _ s' r' h')))
      (CatFn.noT_tCount _ hpost0)) start read h).trans ?_
  simp only [TopReuse.rawSub, TopReuseCarry.subInPlaceTop, ECDSAAdd.toffoliCount_append, cell_signComp_y_toff, hnr0]
  omega

theorem compiledRawAdd_slots {n : Nat} (start : Nat) :
    (compiledRawAdd (n := n) start).prog.gateSlots ≤ 18000 := by
  have hrt : (BalancedCircuit.rawTarget cellLayout).length = 257 :=
    (BalancedCircuit.widths cellLayout cellLayout_widths).2.1
  have hsc_s : ECDSAAdd.Challenge.gateSlots (signComplement cellLayout.sign cellLayout.y) = 256 := by
    have hlen : cellLayout.y.length = 256 := (BalancedCleanup.widths cellLayout.toLayout cellLayout_widths).2.2.1
    rw [ECDSAAdd.Baselines.signComplement_gateSlots, hlen]
  rw [compiledRawAdd]
  refine (CatFn.swapSurround_slots _ _ _
    (CatFn.seq_slots _ _ (CatFn.seq_slots _ _ (CatFn.noT_slots _) (compileAddInPlace_slots _ _ _ _ _))
      (CatFn.noT_slots _)) start).trans ?_
  rw [hrt, hsc_s]; omega

theorem compiledRawSub_slots {n : Nat} (start : Nat) :
    (compiledRawSub (n := n) start).prog.gateSlots ≤ 20000 := by
  have hrt : (BalancedCircuit.rawTarget cellLayout).length = 257 :=
    (BalancedCircuit.widths cellLayout cellLayout_widths).2.1
  have hsc_s : ECDSAAdd.Challenge.gateSlots (signComplement cellLayout.sign cellLayout.y) = 256 := by
    have hlen : cellLayout.y.length = 256 := (BalancedCleanup.widths cellLayout.toLayout cellLayout_widths).2.2.1
    rw [ECDSAAdd.Baselines.signComplement_gateSlots, hlen]
  have hnr_s : ECDSAAdd.Challenge.gateSlots (Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) = 257 := by
    have go (l : List Wire) : ECDSAAdd.Challenge.gateSlots (Arithmetic.notRegister l) = l.length := by
      induction l with
      | nil => rfl
      | cons w ws ih =>
        change ECDSAAdd.Challenge.instructionSlots (.X w) + ECDSAAdd.Challenge.gateSlots (Arithmetic.notRegister ws) = ws.length + 1
        rw [ih]; change 1 + ws.length = ws.length + 1; omega
    rw [go, hrt]
  rw [compiledRawSub]
  refine (CatFn.swapSurround_slots _ _ _
    (CatFn.seq_slots _ _ (CatFn.seq_slots _ _ (CatFn.noT_slots _) (compileAddInPlaceTop_slots _ _ _ _ _))
      (CatFn.noT_slots _)) start).trans ?_
  simp only [ECDSAAdd.Challenge.gateSlots_append, hsc_s, hnr_s, hrt]; omega

theorem compiledRawAdd_wires {n : Nat} (start : Nat) :
    ChallengeMigration.straightWires (compiledRawAdd (n := n) start).prog ⊆ cellWires := by
  rw [compiledRawAdd]
  exact CatFn.swapSurround_wires _ _ _ cell_1026_mem cell_lower_mem
    (CatFn.seq_wires _ _ (CatFn.seq_wires _ _ (CatFn.noT_wires _ cell_signComp_y_wires)
      (fun s => compileAddInPlace_wires _ _ _ _ _ s cellWires cell_lower_mem cell_sign_mem cell_source_sub cell_rawTarget_sub cell_carry_sub))
      (CatFn.noT_wires _ cell_signComp_y_wires)) start

theorem compiledRawSub_wires {n : Nat} (start : Nat) :
    ChallengeMigration.straightWires (compiledRawSub (n := n) start).prog ⊆ cellWires := by
  have hpre : ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y ++
      Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) ⊆ cellWires.toFinset := by
    rw [ECDSAAdd.wires_append]; exact Finset.union_subset cell_signComp_y_wires cell_notRaw_wires
  have hpost : ECDSAAdd.wires (Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout) ++
      signComplement cellLayout.sign cellLayout.y) ⊆ cellWires.toFinset := by
    rw [ECDSAAdd.wires_append]; exact Finset.union_subset cell_notRaw_wires cell_signComp_y_wires
  rw [compiledRawSub]
  exact CatFn.swapSurround_wires _ _ _ cell_1026_mem cell_lower_mem
    (CatFn.seq_wires _ _ (CatFn.seq_wires _ _ (CatFn.noT_wires _ hpre)
      (fun s => compileAddInPlaceTop_wires _ _ _ _ _ s cellWires cell_lower_mem cell_sign_mem cell_source_sub cell_rawTarget_sub cell_carry_sub))
      (CatFn.noT_wires _ hpost)) start

theorem compiledRawAdd_wellFormed {n : Nat} (start : Nat) :
    (compiledRawAdd (n := n) start).prog.WellFormed := by
  rw [compiledRawAdd]
  exact CatFn.swapSurround_wellFormed _ _ _ (cell_base_ne 1026 1797 (by omega))
    (CatFn.seq_wellFormed _ _ (CatFn.seq_wellFormed _ _ (CatFn.noT_wellFormed _ cell_signComp_y_phys)
      (fun s => compileAddInPlace_wellFormed _ _ _ _ _ s cell_rawAdd_nd cell_rawAdd_disj))
      (CatFn.noT_wellFormed _ cell_signComp_y_phys)) start

theorem compiledRawSub_wellFormed {n : Nat} (start : Nat) :
    (compiledRawSub (n := n) start).prog.WellFormed := by
  have hpre : ECDSAAdd.Arithmetic.GatePhysical (signComplement cellLayout.sign cellLayout.y ++
      Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) :=
    (gatePhysical_append _ _).mpr ⟨cell_signComp_y_phys, notRegister_physical _⟩
  have hpost : ECDSAAdd.Arithmetic.GatePhysical (Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout) ++
      signComplement cellLayout.sign cellLayout.y) :=
    (gatePhysical_append _ _).mpr ⟨notRegister_physical _, cell_signComp_y_phys⟩
  rw [compiledRawSub]
  exact CatFn.swapSurround_wellFormed _ _ _ (cell_base_ne 1026 1797 (by omega))
    (CatFn.seq_wellFormed _ _ (CatFn.seq_wellFormed _ _ (CatFn.noT_wellFormed _ hpre)
      (fun s => compileAddInPlaceTop_wellFormed _ _ _ _ _ s cell_rawAdd_nd cell_rawAdd_disj))
      (CatFn.noT_wellFormed _ hpost)) start

theorem compiledRawAdd_catLitSim {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim (base 1026) ((compiledRawAdd (n := n) start).prog.instantiate read h)
      (GuardCompression.rawAdd cellLayout)
      (fun s => s (base 1797) = false ∧ ∀ w ∈ cellLayout.carry, s w = false) := by
  rw [compiledRawAdd]
  apply CatFn.swapSurround_catLitSim (cell_base_ne 1026 1797 (by omega)) _
    (CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.noT_indep _) (compileAddInPlace_indep _ _ _ _ _)) (CatFn.noT_indep _))
    (GuardCompression.rawAdd cellLayout) _
  · intro s' r' h'
    have hsc_av := cell_signComp_y_avoid 1797 (by omega)
    have h1 : ∀ (s'' : Nat) (r'' : ConstantBit n → Bool) (h'' : Fin s'' → Bool),
        CatLitSim (base 1797) ((CatFn.noT (signComplement cellLayout.sign cellLayout.y) s'').prog.instantiate r'' h'')
          (signComplement cellLayout.sign cellLayout.y)
          (fun s => s (base 1797) = false ∧ ∀ w ∈ cellLayout.carry, s w = false) := fun s'' r'' h'' =>
      catLitSim_weaken (CatFn.noT_catLitSim (base 1797) (signComplement cellLayout.sign cellLayout.y) hsc_av s'' r'' h'')
        (fun _ _ => trivial)
    have h12 := CatFn.seq_catLitSim _ _ (compileAddInPlace_indep _ _ _ _ _) _ _ _ _ h1
      (fun s'' r'' h'' => compileAddInPlace_catLitSim (base 1797) _ _ _ _ s'' cell_rawAdd_nd cell_rawAdd_disj r'' h'')
      (fun st m ⟨hl, hca⟩ _ => ⟨(ECDSAAdd.run_preserves_outside _ m st _ hsc_av).trans hl,
        fun w hw => (ECDSAAdd.run_preserves_outside _ m st w (cell_signComp_y_avoid_carry w hw)).trans (hca w hw)⟩)
    exact CatFn.seq_catLitSim _ _ (CatFn.noT_indep _) _ _ _ (fun _ => True) h12
      (CatFn.noT_catLitSim (base 1797) _ hsc_av) (fun _ _ _ _ => trivial) s' r' h'
  · intro s ⟨hl, hca⟩; exact ⟨hca _ base_1026_mem_carry, hl⟩
  · intro st m ⟨hl, hca⟩ _
    have hp := cell_rawAdd_pres st m hl hca
    exact ⟨hp.2 _ base_1026_mem_carry, hp.1⟩

theorem compiledRawSub_catLitSim {n : Nat} (start : Nat) (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim (base 1026) ((compiledRawSub (n := n) start).prog.instantiate read h)
      (TopReuse.rawSub cellLayout)
      (fun s => s (base 1797) = false ∧ ∀ w ∈ cellLayout.carry, s w = false) := by
  have hpeq :
      ((signComplement cellLayout.sign cellLayout.y ++ Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) ++
        TopReuseCarry.addInPlaceTop (GuardCompression.source cellLayout) (BalancedCircuit.rawTarget cellLayout) cellLayout.carry cellLayout.sign) ++
        (Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout) ++ signComplement cellLayout.sign cellLayout.y) =
      TopReuse.rawSub cellLayout := by
    simp only [TopReuse.rawSub, TopReuseCarry.subInPlaceTop, List.append_assoc]
  rw [compiledRawSub, ← hpeq]
  apply CatFn.swapSurround_catLitSim (cell_base_ne 1026 1797 (by omega)) _
    (CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.noT_indep _) (compileAddInPlaceTop_indep _ _ _ _ _)) (CatFn.noT_indep _))
    _ _
  · intro s' r' h'
    have hsc_av := cell_signComp_y_avoid 1797 (by omega)
    have hnr_av := cell_notRaw_avoid 1797 ⟨by omega, by omega⟩
    have hpre_av : base 1797 ∉ ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y ++
        Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) := by
      rw [ECDSAAdd.wires_append, Finset.mem_union]; tauto
    have hpost_av : base 1797 ∉ ECDSAAdd.wires (Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout) ++
        signComplement cellLayout.sign cellLayout.y) := by
      rw [ECDSAAdd.wires_append, Finset.mem_union]; tauto
    have hpre_ca (w : Wire) (hw : w ∈ cellLayout.carry) :
        w ∉ ECDSAAdd.wires (signComplement cellLayout.sign cellLayout.y ++
          Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) := by
      rw [ECDSAAdd.wires_append, Finset.mem_union, notRegister_wires]
      exact fun h => h.elim (cell_signComp_y_avoid_carry w hw) (fun hm => cell_rawTarget_disj_carry (List.mem_toFinset.mp hm) hw)
    have h1 : ∀ (s'' : Nat) (r'' : ConstantBit n → Bool) (h'' : Fin s'' → Bool),
        CatLitSim (base 1797) ((CatFn.noT (signComplement cellLayout.sign cellLayout.y ++
            Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout)) s'').prog.instantiate r'' h'')
          (signComplement cellLayout.sign cellLayout.y ++ Arithmetic.notRegister (BalancedCircuit.rawTarget cellLayout))
          (fun s => s (base 1797) = false ∧ ∀ w ∈ cellLayout.carry, s w = false) := fun s'' r'' h'' =>
      catLitSim_weaken (CatFn.noT_catLitSim (base 1797) _ hpre_av s'' r'' h'') (fun _ _ => trivial)
    have h12 := CatFn.seq_catLitSim _ _ (compileAddInPlaceTop_indep _ _ _ _ _) _ _ _ _ h1
      (fun s'' r'' h'' => compileAddInPlaceTop_catLitSim (base 1797) _ _ _ _ s'' cell_rawAdd_nd cell_rawAdd_disj r'' h'')
      (fun st m ⟨hl, hca⟩ _ => ⟨(ECDSAAdd.run_preserves_outside _ m st _ hpre_av).trans hl,
        fun w hw => (ECDSAAdd.run_preserves_outside _ m st w (hpre_ca w hw)).trans (hca w hw)⟩)
    exact CatFn.seq_catLitSim _ _ (CatFn.noT_indep _) _ _ _ (fun _ => True) h12
      (CatFn.noT_catLitSim (base 1797) _ hpost_av) (fun _ _ _ _ => trivial) s' r' h'
  · intro s ⟨hl, hca⟩; exact ⟨hca _ base_1026_mem_carry, hl⟩
  · intro st m ⟨hl, _⟩ _
    rw [hpeq]
    have hp := cell_rawSub_pres st m hl
    exact ⟨hp.2 _ base_1026_mem_carry, hp.1⟩

/-! ##### Full 7-property verification of the 4 Cell Kernels -/

private theorem cell_y_cons : cellLayout.y = base 770 :: (wireBlock base 771 254 ++ [base 1025]) := by
  change wireBlock base 770 255 ++ [base 1025] = _
  rw [wireBlock, wireBlock, List.range'_succ, List.map_cons, List.cons_append]

private theorem cell_r_cons : cellLayout.r = base 2056 :: (wireBlock base 2057 254 ++ [base 2311]) := rfl

private theorem cell_carry_cons : cellLayout.carry = base 512 :: (wireBlock base 513 252 ++ [base 1540, base 1541, base 1026]) := by
  change wireBlock base 512 253 ++ [base 1540, base 1541, base 1026] = _
  rw [wireBlock, wireBlock, List.range'_succ, List.map_cons, List.cons_append]

