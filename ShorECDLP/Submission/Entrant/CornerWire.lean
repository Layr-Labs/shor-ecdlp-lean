theorem compiledReplaySEnv_wires (E : EnvSchedule) {n : Nat} (divide : Bool) (s : Nat) :
    ChallengeMigration.straightWires (compiledReplaySEnv E (n := n) divide s).prog ⊆ segNo2400.toList := by
