/-! #### 1. `compiledSelW` combinator -/

def compiledSelW {n : Nat} (source flag : Wire) (body : CatFn n) : CatFn n :=
  CatFn.seq (CatFn.seq (CatFn.noT [.CX source flag]) body)
    (CatFn.noT [.measureX flag List.nil ([.Z source])])

attribute [local irreducible] compiledSelW

theorem compiledSelW_indep {n : Nat} (source flag : Wire) (body : CatFn n)
    (hb : ∀ s, Indep (body s).prog) (s : Nat) : Indep (compiledSelW source flag body s).prog := by
  rw [compiledSelW]
  exact CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.noT_indep _) hb) (CatFn.noT_indep _) s

theorem compiledSelW_removed18 {n : Nat} (source flag : Wire) (body : CatFn n)
    (hb : ∀ s, removed 18 (body s).prog = 0) (s : Nat) :
    removed 18 (compiledSelW source flag body s).prog = 0 := by
  rw [compiledSelW]
  exact CatFn.seq_removed18 _ _ (CatFn.seq_removed18 _ _ (CatFn.noT_removed18 _) hb) (CatFn.noT_removed18 _) s

theorem compiledSelW_shiftFin {n : Nat} (source flag : Wire) (body : CatFn n) {B : Nat}
    (hb : ShiftFin body B) : ShiftFin (compiledSelW source flag body) (B + 1) := by
  rw [compiledSelW]
  have h1 := CatFn.seq_shiftFin _ _ (CatFn.seq_shiftFin _ _ (CatFn.noT_shiftFin [.CX source flag]) hb)
    (CatFn.noT_shiftFin [.measureX flag List.nil ([.Z source])])
  refine h1.mono ?_
  have hm1 : ECDSAAdd.measurementCount [.CX source flag] = 0 := rfl
  have hm2 : ECDSAAdd.measurementCount [.measureX flag List.nil ([.Z source])] = 1 := rfl
  rw [hm1, hm2]; omega

theorem compiledSelW_tCount_le {n : Nat} (source flag : Wire) (body : CatFn n) {tb : Nat}
    (hbi : ∀ s, Indep (body s).prog)
    (hb : ∀ s read h, ((body s).prog.instantiate read h).tCount ≤ tb)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    ((compiledSelW source flag body s).prog.instantiate read h).tCount ≤ tb := by
  rw [compiledSelW]
  have h1 := CatFn.seq_tCount_le _ _ (CatFn.noT_indep _)
    (CatFn.seq_tCount_le _ _ hbi (CatFn.noT_tCount [.CX source flag] rfl) hb)
    (CatFn.noT_tCount [.measureX flag List.nil ([.Z source])] rfl) s read h
  omega

theorem compiledSelW_slots {n : Nat} (source flag : Wire) (body : CatFn n) {sb : Nat}
    (hb : ∀ s, (body s).prog.gateSlots ≤ sb) (s : Nat) :
    (compiledSelW source flag body s).prog.gateSlots ≤ sb + 9 := by
  rw [compiledSelW]
  have h1 := CatFn.seq_slots _ _ (CatFn.seq_slots _ _ (CatFn.noT_slots [.CX source flag]) hb)
