private theorem cell_selW_cx_pres_valid (source : Wire) (k : Nat) (hk : 2400 ≤ k) (st : ECDSAAdd.State) (m : List Bool)
    (h : CellValid st.basis) : CellValid (ECDSAAdd.run [.CX source (base k)] m st).basis := by
  simpa [ECDSAAdd.run] using cell_writeBit_pres_valid st.basis (base k) (st.basis (base k) ^^ st.basis source)
    (cell_base_not_r k (by omega)) (cell_base_not_y k (by omega)) (cell_base_not_work k hk) h

private theorem cell_selW_cx_pres_validZero (source : Wire) (k : Nat) (hk : 2400 ≤ k) (st : ECDSAAdd.State) (m : List Bool)
    (h : CellValidZero st.basis) : CellValidZero (ECDSAAdd.run [.CX source (base k)] m st).basis := by
  simpa [ECDSAAdd.run] using cell_writeBit_pres_validZero st.basis (base k) (st.basis (base k) ^^ st.basis source)
    (cell_base_not_r k (by omega)) (cell_base_not_y k (by omega)) (cell_base_not_work k hk) h

private theorem cell_selW_meas_pres_valid (source : Wire) (k : Nat) (hk : 2400 ≤ k) (st : ECDSAAdd.State) (m : List Bool)
    (h : CellValid st.basis) :
    CellValid (ECDSAAdd.run [.measureX (base k) List.nil ([.Z source])] m st).basis := by
  have hb : (ECDSAAdd.run [.measureX (base k) List.nil ([.Z source])] m st).basis =
      ECDSAAdd.writeBit st.basis (base k) false := by
    cases hm : m.headD false <;> simp [ECDSAAdd.run, ECDSAAdd.measureAndCorrect, ECDSAAdd.correct_basis, hm]
  rw [hb]
  exact cell_writeBit_pres_valid st.basis (base k) false
    (cell_base_not_r k (by omega)) (cell_base_not_y k (by omega)) (cell_base_not_work k hk) h

private theorem cell_selW_meas_pres_validZero (source : Wire) (k : Nat) (hk : 2400 ≤ k) (st : ECDSAAdd.State) (m : List Bool)
    (h : CellValidZero st.basis) :
    CellValidZero (ECDSAAdd.run [.measureX (base k) List.nil ([.Z source])] m st).basis := by
  have hb : (ECDSAAdd.run [.measureX (base k) List.nil ([.Z source])] m st).basis =
      ECDSAAdd.writeBit st.basis (base k) false := by
    cases hm : m.headD false <;> simp [ECDSAAdd.run, ECDSAAdd.measureAndCorrect, ECDSAAdd.correct_basis, hm]
  rw [hb]
  exact cell_writeBit_pres_validZero st.basis (base k) false
    (cell_base_not_r k (by omega)) (cell_base_not_y k (by omega)) (cell_base_not_work k hk) h

private theorem cell_cellS_pres_valid (divide : Bool) (g sw : Wire) (st : ECDSAAdd.State) (m : List Bool)
    (h : CellValid st.basis) : CellValid (ECDSAAdd.run (SW.cellS divide g sw) m st).basis := by
  simp only [SW.cellS, SW.selW, ECDSAAdd.run_append]
  exact cell_selW_meas_pres_valid g 2409 (by omega) _ _
    (cell_selW_meas_pres_valid sw 2410 (by omega) _ _
      (cell_body_pres_valid divide _ _
        (cell_selW_cx_pres_valid sw 2410 (by omega) _ _
          (cell_selW_cx_pres_valid g 2409 (by omega) st _ h))))

private theorem cell_zCellS_pres_valid (g sw : Wire) (st : ECDSAAdd.State) (m : List Bool)
    (h : CellValidZero st.basis) : CellValid (ECDSAAdd.run (SW.zCellS g sw) m st).basis := by
  simp only [SW.zCellS, SW.selW, ECDSAAdd.run_append]
  exact cell_selW_meas_pres_valid g 2409 (by omega) _ _
    (cell_selW_meas_pres_valid sw 2410 (by omega) _ _
      (cell_zBody_pres_valid _ _
        (cell_selW_cx_pres_validZero sw 2410 (by omega) _ _
          (cell_selW_cx_pres_validZero g 2409 (by omega) st _ h))))

theorem compiledBody_catLitSim {n : Nat} (divide : Bool) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledBody (n := n) divide s).prog.instantiate read h)
      (OneBankCell5.body divide base (base 2409) (base 2410)) CellValid := by
  rw [compiledBody]; cases divide
  · simp only [OneBankCell5.body, Bool.false_eq_true, if_false, swapBody_eq]
    exact CatFn.seq_catLitSim _ _ (compiledHalf_indep false) SW.swapBody
      (OneBankCell5.half false base (base 2409)) CellValid CellClean
      compiledSwapBody_catLitSim (compiledHalf_catLitSim false)
      (fun st m hv _ => cellValid_clean (cell_swapBody_pres_valid st m hv)) s read h
  · simp only [OneBankCell5.body, if_true, swapBody_eq]
    exact CatFn.seq_catLitSim _ _ compiledSwapBody_indep
      (OneBankCell5.half true base (base 2409)) SW.swapBody CellValid CellValid
      (fun s' r' h' => catLitSim_weaken (compiledHalf_catLitSim true s' r' h') (fun _ hv => cellValid_clean hv))
      compiledSwapBody_catLitSim
      (fun st m hv _ => cell_half_pres_valid true st m hv) s read h

theorem compiledZBody_catLitSim {n : Nat} (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledZBody (n := n) s).prog.instantiate read h)
      (FirstZero5.zBody base (base 2409) (base 2410)) CellValidZero := by
  rw [compiledZBody, FirstZero5.zBody, swapBody_eq]
  exact CatFn.seq_catLitSim _ _ compiledSwapBody_indep
    (FirstZero5.half base (base 2409)) SW.swapBody CellValidZero CellValid
    (fun s' r' h' => catLitSim_weaken (compiledZHalf_catLitSim s' r' h') (fun _ hv => cellValid_clean (cellValidZero_valid hv)))
    compiledSwapBody_catLitSim
    (fun st m hv _ => cell_zHalf_pres_valid st m hv) s read h

theorem compiledCell_catLitSim {n : Nat} (divide : Bool) (g sw : Wire)
    (hg : base 1026 ≠ g) (hsw : base 1026 ≠ sw) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledCell (n := n) divide g sw s).prog.instantiate read h)
      (SW.cellS divide g sw) CellValid := by
  rw [compiledCell, SW.cellS]
  exact compiledSelW_catLitSim g (base 2409) _ hg (base_ne 1026 2409 (by omega))
    (compiledSelW_indep _ _ _ (compiledBody_indep divide))
    (SW.selW sw (base 2410) (OneBankCell5.body divide base (base 2409) (base 2410))) CellValid CellValid
    (compiledSelW_catLitSim sw (base 2410) _ hsw (base_ne 1026 2410 (by omega))
      (compiledBody_indep divide) _ CellValid CellValid (compiledBody_catLitSim divide)
      (fun st m hv => cell_selW_cx_pres_valid sw 2410 (by omega) st m hv))
    (fun st m hv => cell_selW_cx_pres_valid g 2409 (by omega) st m hv) s read h

theorem compiledZCell_catLitSim {n : Nat} (g sw : Wire)
    (hg : base 1026 ≠ g) (hsw : base 1026 ≠ sw) (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledZCell (n := n) g sw s).prog.instantiate read h)
      (SW.zCellS g sw) CellValidZero := by
  rw [compiledZCell, SW.zCellS]
  exact compiledSelW_catLitSim g (base 2409) _ hg (base_ne 1026 2409 (by omega))
    (compiledSelW_indep _ _ _ compiledZBody_indep)
    (SW.selW sw (base 2410) (FirstZero5.zBody base (base 2409) (base 2410))) CellValidZero CellValidZero
    (compiledSelW_catLitSim sw (base 2410) _ hsw (base_ne 1026 2410 (by omega))
      compiledZBody_indep _ CellValidZero CellValidZero compiledZBody_catLitSim
      (fun st m hv => cell_selW_cx_pres_validZero sw 2410 (by omega) st m hv))
    (fun st m hv => cell_selW_cx_pres_validZero g 2409 (by omega) st m hv) s read h

/-! #### 4. Raw replay, packets, groups, first/end packets, logical replay, and `replayS` -/

def compiledRawReplay {n : Nat} (divide : Bool) : List MixedTranscriptLetter → CatFn n
  | [] => CatFn.noT []
  | l :: ls =>
    if divide then CatFn.seq (compiledCell true l.1.1 l.1.2) (compiledRawReplay true ls)
    else CatFn.seq (compiledRawReplay false ls) (compiledCell false l.1.1 l.1.2)

def compiledBasePacket {n : Nat} (divide : Bool) (j : Nat) : CatFn n :=
  CatFn.seq
    (CatFn.seq (CatFn.compileProg (base 1541) (base 1026) (History5.decode base (5 * j)))
      (compiledRawReplay divide (Replay5.letters j)))
    (CatFn.compileProg (base 1541) (base 1026) (History5.encode base (5 * j)))

def compiledPacket {n : Nat} (divide : Bool) (j : Nat) : CatFn n :=
  CatFn.map (shifted (Placement5.pi j)) (compiledBasePacket divide j)

def compiledGroups {n : Nat} (divide : Bool) : Nat → Nat → CatFn n
  | _, 0 => CatFn.noT List.nil
  | j, m + 1 =>
    if divide then CatFn.seq (compiledPacket true j) (compiledGroups true (j + 1) m)
    else CatFn.seq (compiledGroups false (j + 1) m) (compiledPacket false j)

def compiledFirstSwap {n : Nat} : CatFn n :=
  compiledSelW (base 1028) (base 2410) compiledSwapBody

def compiledFirstSwapM {n : Nat} : CatFn n :=
  compiledSelW (base 1028) (base 2410) (CatFn.noT SW.swapBodyM)

def compiledFirstBody {n : Nat} (divide : Bool) : CatFn n :=
  if divide then
    CatFn.seq compiledFirstSwap
      (CatFn.seq (compiledZCell (tapeLetter 1).1.1 (tapeLetter 1).1.2)
        (compiledRawReplay true OneBankReplay5.firstTailLetters))
  else
    CatFn.seq (compiledRawReplay false Replay5.restLetters) compiledFirstSwapM

def compiledBaseFirstPacket {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.seq
    (CatFn.seq (CatFn.compileProg (base 1541) (base 1026) (History5.decode base 0))
      (compiledFirstBody divide))
    (CatFn.compileProg (base 1541) (base 1026) (History5.encode base 0))

def compiledFirstPacket {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.map (shifted (Placement5.pi 0)) (compiledBaseFirstPacket divide)

def compiledRawEnd {n : Nat} (divide : Bool) : CatFn n :=
  compiledSelW (base 510) (base 2409) (compiledHalfE divide)

def compiledEndPacket {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.map (shifted Placement5.pi0) (compiledRawEnd divide)

def compiledLogicalReplayS {n : Nat} (divide : Bool) : CatFn n :=
  if divide then
    CatFn.seq (CatFn.seq (compiledFirstPacket true) (compiledGroups true 1 101)) (compiledEndPacket true)
  else
    CatFn.seq (CatFn.seq (compiledEndPacket false) (compiledGroups false 1 101)) (compiledFirstPacket false)

def compiledReplayS {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.map (OB5.sig 511) (compiledLogicalReplayS divide)

attribute [local irreducible] compiledBasePacket compiledPacket
  compiledFirstSwap compiledFirstSwapM compiledFirstBody compiledBaseFirstPacket
  compiledFirstPacket compiledRawEnd compiledEndPacket compiledLogicalReplayS compiledReplayS

-- History5 codec helpers
private theorem history_codec_avoid_ry_work (start : Nat) (hs : start + 5 ≤ 510)
    (P : ECDSAAdd.Program) (hP : P = History5.encode base start ∨ P = History5.decode base start) :
    (∀ q ∈ cellLayout.r, q ∉ ECDSAAdd.wires P) ∧
    (∀ q ∈ cellLayout.y, q ∉ ECDSAAdd.wires P) ∧
    (∀ q ∈ OneBankCell5.workIds.map base, q ∉ ECDSAAdd.wires P) ∧
    base 1541 ∉ ECDSAAdd.wires P ∧ base 1026 ∉ ECDSAAdd.wires P := by
  have hmem (q : Wire) (hq : q ∈ ECDSAAdd.wires P) : ∃ i, q = base i ∧ (i < 510 ∨ (1028 ≤ i ∧ i < 1538)) := by
    obtain ⟨u, rfl⟩ := History5.history_gate_mem base start P hP q hq
    refine ⟨History5.historyId start u, rfl, ?_⟩
    have hu := u.isLt
    unfold History5.historyId
    split <;> omega
  refine ⟨fun q hqr hqp => ?_, fun q hqy hqp => ?_, fun q hqw hqp => ?_, fun hqp => ?_, fun hqp => ?_⟩
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp; exact cell_base_not_r i (by omega) hqr
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp; exact cell_base_not_y i (by omega) hqy
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp
    obtain ⟨j, hj, he⟩ := List.mem_map.mp hqw
    have := MappedCompressed.base_injective he; subst this
    simp only [OneBankCell5.workIds, List.mem_append, List.mem_cons, List.not_mem_nil,
      List.mem_range'_1, or_false] at hj
    omega
  · obtain ⟨i, he, hi⟩ := hmem _ hqp; have := MappedCompressed.base_injective he; omega
  · obtain ⟨i, he, hi⟩ := hmem _ hqp; have := MappedCompressed.base_injective he; omega

-- Indep for replay hierarchy
theorem compiledRawReplay_indep {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter) (s : Nat) :
    Indep (compiledRawReplay (n := n) divide ls s).prog := by
  induction ls generalizing s with
  | nil => exact CatFn.noT_indep List.nil s
  | cons l ls ih =>
    cases divide
    · exact CatFn.seq_indep _ _ (fun s' => ih s') (compiledCell_indep false l.1.1 l.1.2) s
    · exact CatFn.seq_indep _ _ (compiledCell_indep true l.1.1 l.1.2) (fun s' => ih s') s

theorem compiledBasePacket_indep {n : Nat} (divide : Bool) (j s : Nat) :
    Indep (compiledBasePacket (n := n) divide j s).prog := by
  rw [compiledBasePacket]
  exact CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.compileProg_indep _ _ _) (compiledRawReplay_indep divide _))
    (CatFn.compileProg_indep _ _ _) s

theorem compiledPacket_indep {n : Nat} (divide : Bool) (j s : Nat) :
    Indep (compiledPacket (n := n) divide j s).prog := by
  rw [compiledPacket]
  exact CatFn.map_indep _ _ (compiledBasePacket_indep divide j)
    (fun _ _ _ _ _ e => (shifted (Placement5.pi j)).injective e) s

theorem compiledGroups_indep {n : Nat} (divide : Bool) (j m s : Nat) :
    Indep (compiledGroups (n := n) divide j m s).prog := by
  induction m generalizing j s with
  | zero => exact CatFn.noT_indep List.nil s
  | succ m ih =>
    cases divide
    · exact CatFn.seq_indep _ _ (fun s' => ih (j + 1) s') (compiledPacket_indep false j) s
    · exact CatFn.seq_indep _ _ (compiledPacket_indep true j) (fun s' => ih (j + 1) s') s

theorem compiledFirstSwap_indep {n : Nat} (s : Nat) : Indep (compiledFirstSwap (n := n) s).prog := by
  rw [compiledFirstSwap]; exact compiledSelW_indep _ _ _ compiledSwapBody_indep s

theorem compiledFirstSwapM_indep {n : Nat} (s : Nat) : Indep (compiledFirstSwapM (n := n) s).prog := by
  rw [compiledFirstSwapM]; exact compiledSelW_indep _ _ _ (CatFn.noT_indep _) s

theorem compiledFirstBody_indep {n : Nat} (divide : Bool) (s : Nat) :
    Indep (compiledFirstBody (n := n) divide s).prog := by
  rw [compiledFirstBody]; cases divide
  · exact CatFn.seq_indep _ _ (compiledRawReplay_indep false _) compiledFirstSwapM_indep s
  · exact CatFn.seq_indep _ _ compiledFirstSwap_indep
      (CatFn.seq_indep _ _ (compiledZCell_indep _ _) (compiledRawReplay_indep true _)) s

theorem compiledBaseFirstPacket_indep {n : Nat} (divide : Bool) (s : Nat) :
    Indep (compiledBaseFirstPacket (n := n) divide s).prog := by
  rw [compiledBaseFirstPacket]
  exact CatFn.seq_indep _ _ (CatFn.seq_indep _ _ (CatFn.compileProg_indep _ _ _) (compiledFirstBody_indep divide))
    (CatFn.compileProg_indep _ _ _) s

theorem compiledFirstPacket_indep {n : Nat} (divide : Bool) (s : Nat) :
    Indep (compiledFirstPacket (n := n) divide s).prog := by
  rw [compiledFirstPacket]
  exact CatFn.map_indep _ _ (compiledBaseFirstPacket_indep divide)
    (fun _ _ _ _ _ e => (shifted (Placement5.pi 0)).injective e) s

theorem compiledRawEnd_indep {n : Nat} (divide : Bool) (s : Nat) :
    Indep (compiledRawEnd (n := n) divide s).prog := by
  rw [compiledRawEnd]; exact compiledSelW_indep _ _ _ (compiledHalfE_indep divide) s

theorem compiledEndPacket_indep {n : Nat} (divide : Bool) (s : Nat) :
    Indep (compiledEndPacket (n := n) divide s).prog := by
  rw [compiledEndPacket]
