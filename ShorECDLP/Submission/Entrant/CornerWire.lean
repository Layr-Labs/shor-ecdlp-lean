def portPhase {n : Nat} (data : List (MeasuredClear.ClearPort n)) (outcomes : List Bool)
    (read : ConstantBit n → Bool) (a : Nat) : ℂ :=
  match data, outcomes with
  | q :: qs, o :: os =>
      (if o && decide (read (q.ref a) = q.value) then -1 else 1) * portPhase qs os read a
  | _, _ => 1

theorem portPhase_append {n : Nat} (d1 d2 : List (MeasuredClear.ClearPort n)) (o1 o2 : List Bool)
    (hl : o1.length = d1.length) (read : ConstantBit n → Bool) (a : Nat) :
    portPhase (d1 ++ d2) (o1 ++ o2) read a = portPhase d1 o1 read a * portPhase d2 o2 read a := by
  induction d1 generalizing o1 with
  | nil =>
    cases o1 with
    | nil => simp [portPhase]
    | cons _ _ => simp at hl
  | cons q qs ih =>
    cases o1 with
    | nil => simp at hl
    | cons o os =>
      simp only [List.cons_append, portPhase, mul_assoc, ih os (by simpa using hl)]

theorem portPhase_eq_registerXPhase {n : Nat} (data : List (MeasuredClear.ClearPort n)) (outcomes : List Bool)
    (read : ConstantBit n → Bool) (a : Nat) (u : BasisState)
    (hu : ∀ q ∈ data, u q.target = decide (read (q.ref a) = q.value)) :
    portPhase data outcomes read a = registerXPhase (data.map MeasuredClear.ClearPort.target) outcomes u := by
  induction data generalizing outcomes with
  | nil => simp [portPhase, registerXPhase]
  | cons q qs ih =>
    cases outcomes with
    | nil => simp [portPhase, registerXPhase]
    | cons o os =>
      simp only [List.map_cons, portPhase, registerXPhase, hu q List.mem_cons_self]
      rw [ih os (fun q' hq' => hu q' (List.mem_cons_of_mem _ hq'))]

theorem fixupFactor8_eq_portPhase {n : Nat} (data : List (MeasuredClear.ClearPort n)) (outcomes : List Bool)
    (hl : outcomes.length = data.length)
    (read : ConstantBit n → Bool) (low : Fin 8 → Wire) (hot : Fin 256 → Wire)
    (tree : UnaryActionTree) (root : Wire) (paths : List Wire)
    (hi : Function.Injective hot) (hdlow : ∀ i j, low i ≠ hot j)
    (hbank : (MeasuredClear.hotBank8 hot).Disjoint (root :: tree.indexWires.dedup ++ paths))
    (t : BasisState) (a : Nat) (hhot : MeasuredClear.HotClean8 hot t)
    (haddr : 256 * tree.routeLabel t + MeasuredClear.hotAddress8 low t = a)
    (hroot : t root = true) :
    MeasuredClear.fixupFactor8 data outcomes read low hot tree root t =
      portPhase data outcomes read a := by
  induction data generalizing outcomes with
  | nil =>
    cases outcomes with
    | nil =>
      have h0 := MeasuredClear.fixupFactor8_loaded (List.nil : List (MeasuredClear.ClearPort n)) List.nil
        read low hot tree root paths hi hdlow hbank t (fun _ => false) hhot (by simp)
      simpa [portPhase, registerXPhase] using h0
    | cons _ _ => simp at hl
  | cons q qs ih =>
    cases outcomes with
    | nil => simp at hl
    | cons o os =>
      have hsp := MeasuredClear.fixupFactor8_append (q :: List.nil) qs (o :: List.nil) os rfl
        read low hot tree root t
      have h1 := MeasuredClear.fixupFactor8_loaded (q :: List.nil) (o :: List.nil)
        read low hot tree root paths hi hdlow hbank t (fun _ => decide (read (q.ref a) = q.value)) hhot (by
          intro p hp
          simp only [List.mem_singleton] at hp
          subst hp
          rw [haddr, hroot, Bool.true_and])
      have h2 := ih os (by simpa using hl)
      simpa only [List.cons_append, List.nil_append, portPhase, registerXPhase, List.map_cons, List.map_nil, mul_one] using
        hsp.trans (congrArg₂ (· * ·) h1 h2)

