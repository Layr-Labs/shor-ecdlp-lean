    rcases hm with rfl | rfl <;> assumption
  exact catFn_seq_avoid4 _ _ (catFn_seq_avoid4 _ _ (hsw y₁ y₂ h1 h2) hb) (hsw y₂ y₁ h2 h1) s w hw

private theorem history_codec_avoid4 (start : Nat) (hs : start + 5 ≤ 510)
    (P : ECDSAAdd.Program) (hP : P = History5.encode base start ∨ P = History5.decode base start) :
    ∀ w ∈ ECDSAAdd.wires P, avoid4 w := by
  intro w hw
  obtain ⟨r, rfl⟩ := History5.history_gate_mem base start P hP w hw
  have hb := History5.historyId_bound start (by omega) r
  have hne : History5.historyId start r ≠ 765 ∧ History5.historyId start r ≠ 766 ∧
      History5.historyId start r ≠ 767 ∧ History5.historyId start r ≠ 2312 := by
    have hr := r.isLt
    unfold History5.historyId; split <;> omega
  exact base_avoid4 _ hne

private theorem tapeLetter_avoid4 (k : Nat) (hk : k < 510) :
    avoid4 (MappedCompressed.tapeLetter k).1.1 ∧ avoid4 (MappedCompressed.tapeLetter k).1.2 := by
  have hlen1 : (skywalkSharedTape base).length = 512 := by simp [skywalkSharedTape]
  have hlen2 : mixedTranscriptUnitTrace.length = 512 := by decide
  have ht : (mixedTranscriptTape base).getD k ((0, 0), false, false) =
      ((base k, base (1028 + k)), mixedTranscriptUnitTrace[k]'(by omega)) := by
    rw [mixedTranscriptTape, List.getD_eq_getElem _ _ (by simp [List.length_zip, hlen1, hlen2]; omega),
      List.getElem_zip]
    simp [skywalkSharedTape]
  simp only [MappedCompressed.tapeLetter, ht]
  exact ⟨base_avoid4 k (by omega), base_avoid4 (1028 + k) (by omega)⟩

private theorem compiledRawReplay_avoid4 {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter)
    (hl : ∀ l ∈ ls, avoid4 l.1.1 ∧ avoid4 l.1.2) (s : Nat) (w : Wire)
    (hw : w ∈ ChallengeMigration.straightWires (compiledRawReplay (n := n) divide ls s).prog) : avoid4 w := by
  induction ls generalizing s w with
  | nil =>
    rw [compiledRawReplay] at hw
    exact catFn_noT_avoid4 [] (fun _ h => by simp [ECDSAAdd.wires] at h) s w hw
  | cons l ls ih =>
    rw [compiledRawReplay] at hw
    have h0 := hl l (by simp)
    have hrest : ∀ x ∈ ls, avoid4 x.1.1 ∧ avoid4 x.1.2 := fun x hx => hl x (List.mem_cons_of_mem _ hx)
    cases divide
    · exact catFn_seq_avoid4 _ _ (fun s' u hu => ih hrest s' u hu) (fun s' => compiledCell_avoid4 false l.1.1 l.1.2 h0.1 h0.2 s') s w hw
    · exact catFn_seq_avoid4 _ _ (fun s' => compiledCell_avoid4 true l.1.1 l.1.2 h0.1 h0.2 s') (fun s' u hu => ih hrest s' u hu) s w hw

private theorem compiledKernelS_avoid4_both {n : Nat} (divide : Bool) :
    (∀ (s : Nat) (w : Wire), w ∈ ChallengeMigration.straightWires (compiledKernelS (n := n) divide s).prog →
      w ≠ base 765 ∧ w ≠ base 766 ∧ w ≠ base 767 ∧ w ≠ base 2312) ∧
    (∀ (E : EnvSchedule) (s : Nat) (w : Wire), w ∈ ChallengeMigration.straightWires (compiledKernelSEnv E (n := n) divide s).prog →
      w ≠ base 765 ∧ w ≠ base 766 ∧ w ≠ base 767 ∧ w ≠ base 2312) := by
