      (compiledGroups_wellFormed false 1 101 (by decide))) (compiledFirstPacket_wellFormed false) s'
  · exact CatFn.seq_wellFormed _ _ (CatFn.seq_wellFormed _ _ (compiledFirstPacket_wellFormed true)
      (compiledGroups_wellFormed true 1 101 (by decide))) (compiledEndPacket_wellFormed true) s'

-- CatLitSim (base 1026) for rawReplay, basePacket, packet, firstPacket, endPacket
private theorem cell_rawReplayS_pres_valid (divide : Bool) (ls : List MixedTranscriptLetter)
    (st : ECDSAAdd.State) (m : List Bool) (h : CellValid st.basis) :
    CellValid (ECDSAAdd.run (SW.rawReplayS divide ls) m st).basis := by
  induction ls generalizing st m with
  | nil => simpa [SW.rawReplayS, ECDSAAdd.run] using h
  | cons l ls ih =>
    cases divide
    · simp only [SW.rawReplayS, Bool.false_eq_true, if_false, ECDSAAdd.run_append]
      exact cell_cellS_pres_valid false l.1.1 l.1.2 _ _ (ih st _ h)
    · simp only [SW.rawReplayS, if_true, ECDSAAdd.run_append]
      exact ih _ _ (cell_cellS_pres_valid true l.1.1 l.1.2 st _ h)

theorem compiledRawReplay_catLitSim {n : Nat} (divide : Bool) (ls : List MixedTranscriptLetter)
    (hl : ∀ l ∈ ls, base 1026 ≠ l.1.1 ∧ base 1026 ≠ l.1.2)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledRawReplay (n := n) divide ls s).prog.instantiate read h)
      (SW.rawReplayS divide ls) CellValid := by
  induction ls generalizing s read h with
  | nil =>
    rw [compiledRawReplay, SW.rawReplayS]
    exact catLitSim_weaken (CatFn.noT_catLitSim (base 1026) List.nil (by simp [ECDSAAdd.wires]) s read h)
      (fun _ _ => trivial)
  | cons l ls ih =>
    have h0 := hl l (by simp)
    have hrest : ∀ x ∈ ls, base 1026 ≠ x.1.1 ∧ base 1026 ≠ x.1.2 := fun x hx => hl x (List.mem_cons_of_mem _ hx)
    cases divide
    · rw [compiledRawReplay, SW.rawReplayS]; simp only [Bool.false_eq_true, if_false]
      exact CatFn.seq_catLitSim _ _ (compiledCell_indep false l.1.1 l.1.2)
        (SW.rawReplayS false ls) (SW.cellS false l.1.1 l.1.2) CellValid CellValid
        (fun s' r' h' => ih hrest s' r' h') (compiledCell_catLitSim false l.1.1 l.1.2 h0.1 h0.2)
        (fun st m hv _ => cell_rawReplayS_pres_valid false ls st m hv) s read h
    · rw [compiledRawReplay, SW.rawReplayS]; simp only [if_true]
      exact CatFn.seq_catLitSim _ _ (compiledRawReplay_indep true ls)
        (SW.cellS true l.1.1 l.1.2) (SW.rawReplayS true ls) CellValid CellValid
        (compiledCell_catLitSim true l.1.1 l.1.2 h0.1 h0.2) (fun s' r' h' => ih hrest s' r' h')
        (fun st m hv _ => cell_cellS_pres_valid true l.1.1 l.1.2 st m hv) s read h

