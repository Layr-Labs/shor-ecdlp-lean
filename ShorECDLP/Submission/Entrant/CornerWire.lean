  rintro bs m ⟨X₀, Y₀, ⟨hX₀, hgood₀⟩, hx₀, hy₀, hcl₀⟩
  have hpos₀ : 0 < X₀.val := Nat.pos_of_ne_zero (fun h0 => hX₀ ((ZMod.val_eq_zero X₀).mp h0))
