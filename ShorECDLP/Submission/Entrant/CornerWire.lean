      (PoolHost.hostCodeExtra (wLiteral (n := 32768) (arithS streamLayout true)) + 0)) := by
    rw [b_rowC_expand]
    refine b_codeExtra_cons0 _ _ _ (h0 _ PoolHost.flip_avoidsB) ?_
