        have h2 : (toBlock2 (.plain (wLiteral (n := 32768) (ECDSAAdd.Frontier.zrep streamLayout)))).code =
            [.literal (ECDSAAdd.Frontier.zrep streamLayout)] := rfl
        rw [erase2_cons, erase2_cons, erase2_nil, h1, h2]
