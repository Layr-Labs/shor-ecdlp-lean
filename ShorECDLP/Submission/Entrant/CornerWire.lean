      exact congrArg (· • _) (phase_cancel_cont next.phase (registerXResetMagnitude pairExtraWires.length) c _ _ hsq)
  have h78_sim (o1 o2 o3 : List Bool) (ho1 : o1.length = 774) (ho2 : o2.length = 258) (ho3 : o3.length = 513) :
