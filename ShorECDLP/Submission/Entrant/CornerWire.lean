-- Phase independence of `ECDSAAdd.run`'s `.basis`
private theorem ecdsa_run_basis_indep_phase (P : ECDSAAdd.Program) :
    ∀ (m : List Bool) (p1 p2 : Bool) (b : BasisState),
      (ECDSAAdd.run P m ⟨p1, b⟩).basis = (ECDSAAdd.run P m ⟨p2, b⟩).basis := by
  induction P with
  | nil => intro m p1 p2 b; rfl
  | cons i P ih =>
    intro m p1 p2 b
    cases i with
    | X w => exact ih m p1 p2 _
    | CX c t => exact ih m p1 p2 _
    | CCX a c t => exact ih m p1 p2 _
    | measureX w c0 c1 =>
      simp only [ECDSAAdd.run]
      have h1 : (ECDSAAdd.measureAndCorrect w c0 c1 (m.headD false) ⟨p1, b⟩).basis =
          (ECDSAAdd.measureAndCorrect w c0 c1 (m.headD false) ⟨p2, b⟩).basis := by
        simp [ECDSAAdd.measureAndCorrect, ECDSAAdd.correct_basis]
      generalize ECDSAAdd.measureAndCorrect w c0 c1 (m.headD false) ⟨p1, b⟩ = s1 at h1 ⊢
      generalize ECDSAAdd.measureAndCorrect w c0 c1 (m.headD false) ⟨p2, b⟩ = s2 at h1 ⊢
      rcases s1 with ⟨q1, b1⟩; rcases s2 with ⟨q2, b2⟩; dsimp only at h1; subst h1
      exact ih m.tail q1 q2 b1

-- Existential frame predicates for uniform `CatLitSim` (independent of input `origin, x, Y`)
private def AnyEncField (bs : BasisState) : Prop :=
  ∃ (origin : BasisState) (_ : OneBankReplay5.Context origin) (X Y : Fp),
    bs (base 2400) = true ∧ History5.EncodedFieldFrame5 base (base 2409) origin X Y ⟨false, bs⟩

private def AnyEncFieldY0 (bs : BasisState) : Prop :=
  ∃ (origin : BasisState) (_ : OneBankReplay5.Context origin) (Y : Fp),
    bs (base 2400) = true ∧ History5.EncodedFieldFrame5 base (base 2409) origin Y 0 ⟨false, bs⟩

private theorem encFieldFrame_of_basis (origin : BasisState) (X Y : Fp) (s : ECDSAAdd.State)
    (h : History5.EncodedFieldFrame5 base (base 2409) origin X Y ⟨false, s.basis⟩) :
    History5.EncodedFieldFrame5 base (base 2409) origin X Y s := by
  obtain ⟨raw, _, hp, he⟩ := h
  refine ⟨⟨s.phase, raw.basis⟩, rfl, hp, ?_⟩
  have hpool := skywalkShared_integer_nodup base MappedCompressed.LaneA.laneLogical_config.1
  apply ECDSAAdd.State.extensionality
  · exact (History5.allEncode_zero_phase base hpool 102 (by decide) ⟨s.phase, raw.basis⟩).symm
  · exact (congrArg ECDSAAdd.State.basis he).trans (ecdsa_run_basis_indep_phase _ List.nil raw.phase s.phase raw.basis)

private theorem encFieldFrame_to_basis (origin : BasisState) (X Y : Fp) (s : ECDSAAdd.State)
    (h : History5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    History5.EncodedFieldFrame5 base (base 2409) origin X Y ⟨false, s.basis⟩ := by
  obtain ⟨raw, _, hp, he⟩ := h
  refine ⟨⟨false, raw.basis⟩, rfl, hp, ?_⟩
  have hpool := skywalkShared_integer_nodup base MappedCompressed.LaneA.laneLogical_config.1
  apply ECDSAAdd.State.extensionality
  · exact (History5.allEncode_zero_phase base hpool 102 (by decide) ⟨false, raw.basis⟩).symm
  · exact (congrArg ECDSAAdd.State.basis he).trans (ecdsa_run_basis_indep_phase _ List.nil raw.phase false raw.basis)

private theorem allEncode_avoid_ry_work :
    (∀ q ∈ cellLayout.r, q ∉ ECDSAAdd.wires (History5.allEncode base 102)) ∧
    (∀ q ∈ cellLayout.y, q ∉ ECDSAAdd.wires (History5.allEncode base 102)) ∧
    (∀ q ∈ OneBankCell5.workIds.map base, q ∉ ECDSAAdd.wires (History5.allEncode base 102)) := by
  have hmem (q : Wire) (hq : q ∈ ECDSAAdd.wires (History5.allEncode base 102)) :
      ∃ i, q = base i ∧ (i < 512 ∨ (1028 ≤ i ∧ i < 1540)) := by
    have hs := History5.allEncode_history_support base 102 (by omega) hq
    simp only [List.mem_toFinset, List.mem_append, wireBlock, List.mem_map, List.mem_range'_1] at hs
    rcases hs with ⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩
    · exact ⟨i, rfl, Or.inl (by omega)⟩
    · exact ⟨i, rfl, Or.inr ⟨by omega, by omega⟩⟩
  refine ⟨fun q hqr hqp => ?_, fun q hqy hqp => ?_, fun q hqw hqp => ?_⟩
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp; exact cell_base_not_r i (by omega) hqr
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp; exact cell_base_not_y i (by omega) hqy
  · obtain ⟨i, rfl, hi⟩ := hmem q hqp
    obtain ⟨j, hj, he⟩ := List.mem_map.mp hqw
    have := MappedCompressed.base_injective he; subst this
    simp only [OneBankCell5.workIds, List.mem_append, List.mem_cons, List.not_mem_nil,
      List.mem_range'_1, or_false] at hj
    omega

private theorem anyEncField_replayValid {bs : BasisState} (h : AnyEncField bs) : ReplayValid bs := by
  obtain ⟨origin, ctx, X, Y, _, raw, hph, hpair, heq⟩ := h
  have hclean := OneBankCell5.clean_of_env base origin ctx.env ctx.parity
  have hraw : CellValid raw.basis := cellValid_of_pair hclean hpair
  have hcv : CellValid bs := by
    have hb : bs = (ECDSAAdd.run (History5.allEncode base 102) List.nil raw).basis := congrArg ECDSAAdd.State.basis heq
    rw [hb]
    exact cell_run_outside_pres_valid _ raw List.nil allEncode_avoid_ry_work.1 allEncode_avoid_ry_work.2.1
      allEncode_avoid_ry_work.2.2 hraw
  have hz : ∀ q, Placement5.zeroRegion q → bs (base q) = false :=
    History5.encoded_zero_region base (base 2409) ctx.hn (ctx.hp _ (by simp)) origin ctx.env ctx.legal X Y ⟨false, bs⟩
      ⟨raw, hph, hpair, heq⟩
  exact ⟨hcv, hz⟩

private theorem anyEncFieldY0_replayValidZero {bs : BasisState} (h : AnyEncFieldY0 bs) : ReplayValidZero bs := by
  obtain ⟨origin, ctx, Y, h24, hf⟩ := h
  have hrv := anyEncField_replayValid ⟨origin, ctx, Y, 0, h24, hf⟩
  obtain ⟨raw, _, hpair, heq⟩ := hf
  have hclean := OneBankCell5.clean_of_env base origin ctx.env ctx.parity
  have hraw : CellValidZero raw.basis := ⟨(cellValid_of_pair hclean hpair).1, Y, 0, Or.inr rfl, hpair.1, hpair.2.1⟩
  have hcv : CellValidZero bs := by
    have hb : bs = (ECDSAAdd.run (History5.allEncode base 102) List.nil raw).basis := congrArg ECDSAAdd.State.basis heq
    rw [hb]
    exact cell_run_outside_pres_validZero _ raw List.nil allEncode_avoid_ry_work.1 allEncode_avoid_ry_work.2.1
      allEncode_avoid_ry_work.2.2 hraw
  exact ⟨hcv, hrv.2⟩

theorem compiledGroups_catLitSim {n : Nat} (divide : Bool) (j m : Nat) (hb : j + m ≤ 102)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledGroups (n := n) divide j m s).prog.instantiate read h)
      (SW.groupsS divide j m) AnyEncField := by
  induction m generalizing j s read h with
  | zero =>
    simp only [compiledGroups, SW.groupsS, PacketSequence.program]
    exact catLitSim_weaken (CatFn.noT_catLitSim (base 1026) List.nil (by simp [ECDSAAdd.wires]) s read h)
      (fun _ _ => trivial)
  | succ m ih =>
    cases divide
    · rw [compiledGroups, SW.groupsS]; dsimp only [PacketSequence.program]; rw [← SW.groupsS]
      change CatLitSim (base 1026)
        ((CatFn.seq (compiledGroups false (j + 1) m) (compiledPacket false j) s).prog.instantiate read h)
        (SW.groupsS false (j + 1) m ++ SW.packetS false j) AnyEncField
      exact CatFn.seq_catLitSim _ _ (compiledPacket_indep false j)
        (SW.groupsS false (j + 1) m) (SW.packetS false j) AnyEncField ReplayValid
        (fun s' r' h' => ih (j + 1) (by omega) s' r' h')
        (compiledPacket_catLitSim false j (by omega))
        (fun st m' ⟨origin, ctx, X, Y, h24, hfr0⟩ _ => by
          obtain ⟨heq, h2400⟩ := (SW.selGroups_sel false (j + 1) m (by omega)).eq m' st h24
          rw [heq]
          have hfr := OneBankReplay5.groups_frame false (j + 1) m (by omega) origin ctx X Y st m'
            (encFieldFrame_of_basis origin X Y st hfr0)
          exact anyEncField_replayValid ⟨origin, ctx, _, _, h2400, encFieldFrame_to_basis origin _ _ _ hfr.2⟩) s read h
    · rw [compiledGroups, SW.groupsS]; dsimp only [PacketSequence.program]; rw [← SW.groupsS]
      change CatLitSim (base 1026)
        ((CatFn.seq (compiledPacket true j) (compiledGroups true (j + 1) m) s).prog.instantiate read h)
        (SW.packetS true j ++ SW.groupsS true (j + 1) m) AnyEncField
      exact CatFn.seq_catLitSim _ _ (compiledGroups_indep true (j + 1) m)
        (SW.packetS true j) (SW.groupsS true (j + 1) m) AnyEncField AnyEncField
        (fun s' r' h' => catLitSim_weaken (compiledPacket_catLitSim true j (by omega) s' r' h')
          (fun _ hv => anyEncField_replayValid hv))
        (fun s' r' h' => ih (j + 1) (by omega) s' r' h')
        (fun st m' ⟨origin, ctx, X, Y, h24, hfr0⟩ _ => by
          obtain ⟨heq, h2400⟩ := (SW.selPacket_sel true j (by omega)).eq m' st h24
          rw [heq]
          have hfr := OneBankReplay5.packet_frame true j (by omega) origin ctx X Y st m'
            (encFieldFrame_of_basis origin X Y st hfr0)
          exact ⟨origin, ctx, _, _, h2400, encFieldFrame_to_basis origin _ _ _ hfr.2⟩) s read h

theorem compiledLogicalReplayS_catLitSim {n : Nat} (divide : Bool)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledLogicalReplayS (n := n) divide s).prog.instantiate read h)
      (SW.logicalReplayS divide) (if divide then AnyEncFieldY0 else AnyEncField) := by
  rw [compiledLogicalReplayS, SW.logicalReplayS]
  cases divide
  · simp only [Bool.false_eq_true, if_false]
    have h1 : ∀ (s' : Nat) (r' : ConstantBit n → Bool) (h' : Fin s' → Bool),
        CatLitSim (base 1026) ((compiledEndPacket (n := n) false s').prog.instantiate r' h')
          (SW.endPacketS false) AnyEncField := fun s' r' h' =>
      catLitSim_weaken (compiledEndPacket_catLitSim false s' r' h') (fun _ hv => anyEncField_replayValid hv)
    have h12 := CatFn.seq_catLitSim _ _ (compiledGroups_indep false 1 101)
      (SW.endPacketS false) (SW.groupsS false 1 101) AnyEncField AnyEncField
      h1 (compiledGroups_catLitSim false 1 101 (by decide))
      (fun st m ⟨origin, ctx, X, Y, h24, hfr0⟩ _ => by
        obtain ⟨heq, h2400⟩ := (SW.selEnd_sel false).eq m st h24
        rw [heq]
        have hfr := OneBankReplay5.endPacket_frame false origin ctx X Y (fun e => absurd e (by decide)) st m
          (encFieldFrame_of_basis origin X Y st hfr0)
        exact ⟨origin, ctx, _, _, h2400, encFieldFrame_to_basis origin _ _ _ hfr.2⟩)
    exact CatFn.seq_catLitSim _ _ (compiledFirstPacket_indep false)
      (SW.endPacketS false ++ SW.groupsS false 1 101) (SW.firstPacketS false) AnyEncField ReplayValid
      h12 (fun s' r' h' => by simpa only [Bool.false_eq_true, if_false] using compiledFirstPacket_catLitSim false s' r' h')
      (fun st m ⟨origin, ctx, X, Y, h24, hfr0⟩ _ => by
        rw [ECDSAAdd.run_append]
        let m1 := m.take (ECDSAAdd.measurementCount (SW.endPacketS false))
        let m2 := m.drop (ECDSAAdd.measurementCount (SW.endPacketS false))
        obtain ⟨heq1, hb1⟩ := (SW.selEnd_sel false).eq m1 st h24
        change ReplayValid (ECDSAAdd.run (SW.groupsS false 1 101) m2 (ECDSAAdd.run (SW.endPacketS false) m1 st)).basis
        rw [heq1]
        have hfr1 := OneBankReplay5.endPacket_frame false origin ctx X Y (fun e => absurd e (by decide)) st m1
          (encFieldFrame_of_basis origin X Y st hfr0)
        obtain ⟨heq2, hb2⟩ := (SW.selGroups_sel false 1 101 (by decide)).eq m2 (ECDSAAdd.run (OneBankReplay5.endPacket false) m1 st) hb1
        rw [heq2]
        have hfr2 := OneBankReplay5.groups_frame false 1 101 (by decide) origin ctx _ _ _ m2 hfr1.2
        exact anyEncField_replayValid ⟨origin, ctx, _, _, hb2, encFieldFrame_to_basis origin _ _ _ hfr2.2⟩) s read h
  · simp only [if_true]
    have h1 : ∀ (s' : Nat) (r' : ConstantBit n → Bool) (h' : Fin s' → Bool),
        CatLitSim (base 1026) ((compiledFirstPacket (n := n) true s').prog.instantiate r' h')
          (SW.firstPacketS true) AnyEncFieldY0 := fun s' r' h' =>
      catLitSim_weaken (by simpa only [if_true] using compiledFirstPacket_catLitSim true s' r' h')
        (fun _ hv => anyEncFieldY0_replayValidZero hv)
    have h12 := CatFn.seq_catLitSim _ _ (compiledGroups_indep true 1 101)
      (SW.firstPacketS true) (SW.groupsS true 1 101) AnyEncFieldY0 AnyEncField
      h1 (compiledGroups_catLitSim true 1 101 (by decide))
      (fun st m ⟨origin, ctx, Y, h24, hfr0⟩ _ => by
        obtain ⟨heq, h2400⟩ := (SW.selFirstPacket_sel true).eq m st h24
        rw [heq]
        have hfr := OneBankReplay5.firstPacket_frame true origin ctx Y 0 st m
          (encFieldFrame_of_basis origin Y 0 st hfr0) ⟨fun e => absurd e (by decide), fun _ => rfl⟩
        exact ⟨origin, ctx, _, _, h2400, encFieldFrame_to_basis origin _ _ _ hfr.2⟩)
    exact CatFn.seq_catLitSim _ _ (compiledEndPacket_indep true)
      (SW.firstPacketS true ++ SW.groupsS true 1 101) (SW.endPacketS true) AnyEncFieldY0 ReplayValid
      h12 (compiledEndPacket_catLitSim true)
      (fun st m ⟨origin, ctx, Y, h24, hfr0⟩ _ => by
        rw [ECDSAAdd.run_append]
        let m1 := m.take (ECDSAAdd.measurementCount (SW.firstPacketS true))
        let m2 := m.drop (ECDSAAdd.measurementCount (SW.firstPacketS true))
        obtain ⟨heq1, hb1⟩ := (SW.selFirstPacket_sel true).eq m1 st h24
        change ReplayValid (ECDSAAdd.run (SW.groupsS true 1 101) m2 (ECDSAAdd.run (SW.firstPacketS true) m1 st)).basis
        rw [heq1]
        have hfr1 := OneBankReplay5.firstPacket_frame true origin ctx Y 0 st m1
          (encFieldFrame_of_basis origin Y 0 st hfr0) ⟨fun e => absurd e (by decide), fun _ => rfl⟩
        obtain ⟨heq2, hb2⟩ := (SW.selGroups_sel true 1 101 (by decide)).eq m2 (ECDSAAdd.run (OneBankReplay5.firstPacket true) m1 st) hb1
        rw [heq2]
        have hfr2 := OneBankReplay5.groups_frame true 1 101 (by decide) origin ctx _ _ _ m2 hfr1.2
        exact anyEncField_replayValid ⟨origin, ctx, _, _, hb2, encFieldFrame_to_basis origin _ _ _ hfr2.2⟩) s read h

private def sig511Perm : Wire ≃ Wire :=
  ⟨OB5.sig 511, OB5.sig 511, OB5.sig_invol 511 (by decide), OB5.sig_invol 511 (by decide)⟩

private def AnyPlacedField (bs : BasisState) : Prop :=
  ∃ (origin : BasisState) (_ : OneBankReplay5.Context origin) (X Y : Fp),
    bs (base 2400) = true ∧ FieldFrameOB5.EncodedFieldFrame origin X Y ⟨false, bs⟩

private def AnyPlacedFieldY0 (bs : BasisState) : Prop :=
  ∃ (origin : BasisState) (_ : OneBankReplay5.Context origin) (Y : Fp),
    bs (base 2400) = true ∧ FieldFrameOB5.EncodedFieldFrame origin Y 0 ⟨false, bs⟩

theorem compiledReplayS_catLitSim {n : Nat} (divide : Bool)
    (s : Nat) (read : ConstantBit n → Bool) (h : Fin s → Bool) :
    CatLitSim (base 1026) ((compiledReplayS (n := n) divide s).prog.instantiate read h)
      (SW.replayS divide) (if divide then AnyPlacedFieldY0 else AnyPlacedField) := by
  have h1026 : sig511Perm (base 1026) = base 1026 := by
    change OB5.sig 511 (base 1026) = base 1026; decide +kernel
  have h2400 : sig511Perm (base 2400) = base 2400 := SW.selSig_2400
  rw [compiledReplayS, SW.replayS]
  have hm := CatFn.map_perm_catLitSim sig511Perm (base 1026)
    (compiledLogicalReplayS divide) (SW.logicalReplayS divide)
    (if divide then AnyEncFieldY0 else AnyEncField) (compiledLogicalReplayS_catLitSim divide) s read h
  rw [h1026] at hm
  exact catLitSim_weaken hm (fun bs hv => by
    cases divide
    · obtain ⟨origin, ctx, X, Y, h24, hfr⟩ := hv
      exact ⟨origin, ctx, X, Y, by dsimp only; rw [h2400]; exact h24, hfr⟩
    · obtain ⟨origin, ctx, Y, h24, hfr⟩ := hv
      exact ⟨origin, ctx, Y, by dsimp only; rw [h2400]; exact h24, hfr⟩)

/-! #### 5. `compiledSegmentS`, `compiledSegHS`, and `compiledKernelS` -/

def compiledSegmentS {n : Nat} (divide : Bool) : CatFn n :=
  if divide then
    CatFn.seq (CatFn.compileProg (base 2409) (base 2410) OwnQ4Endpoint.centerT)
      (CatFn.seq (CatFn.swapSurround (base 2410) (base 1026) (compiledReplayS true))
        (CatFn.seq (CatFn.noT HalfFieldOB5.copyN)
          (CatFn.compileProg (base 2409) (base 2410) OwnQ4Endpoint.canonT)))
  else
    CatFn.seq (CatFn.compileProg (base 2409) (base 2410) OwnQ4Endpoint.centerT)
      (CatFn.seq (CatFn.noT HalfFieldOB5.copyN)
        (CatFn.seq (CatFn.swapSurround (base 2410) (base 1026) (compiledReplayS false))
          (CatFn.compileProg (base 2409) (base 2410) OwnQ4Endpoint.canonT)))

def compiledSegHS {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.seq (CatFn.noT [.X (base 511)])
    (CatFn.seq (CatFn.map HostOB5.hostSwap (compiledSegmentS divide))
      (CatFn.noT [.X (base 511)]))

def kernelPre : ECDSAAdd.Program :=
  NativeFirstDirect.forward base ++ stackForwardT ++ skywalkArithmeticClear base

def kernelSuf : ECDSAAdd.Program :=
  skywalkArithmeticClear base ++ stackReverseT ++ NativeFirstKnown.inverse base

def compiledKernelS {n : Nat} (divide : Bool) : CatFn n :=
  CatFn.seq
    (CatFn.seq (CatFn.compileProg (base 717) (base 718) kernelPre)
      (CatFn.swapSurround (base 718) (base 1542) (compiledSegHS divide)))
    (CatFn.compileProg (base 717) (base 718) kernelSuf)

attribute [local irreducible] compiledSegmentS compiledSegHS compiledKernelS kernelPre kernelSuf

-- Avoid helpers for endpoints & kernelPre/Suf
private theorem ownQ4_avoid_2409_2410_2400 (q : Nat) (hq : q = 2400 ∨ q = 2409 ∨ q = 2410) :
    base q ∉ ECDSAAdd.wires OwnQ4Endpoint.centerT ∧ base q ∉ ECDSAAdd.wires OwnQ4Endpoint.canonT := by
  have no : base q ∉ (HalfField.ids.map base).toFinset := by
    intro h; obtain ⟨i, hi, e⟩ := List.mem_map.mp (List.mem_toFinset.mp h)
    have := MappedCompressed.base_injective e
    simp only [HalfField.ids, List.mem_append, List.mem_cons, List.not_mem_nil, List.mem_range'_1, or_false] at hi
    omega
  have a : base q ∉ ECDSAAdd.wires HalfField5.centerT := fun h => no (@HalfField.centerT_sites (base q) h)
  have b : base q ∉ ECDSAAdd.wires HalfField5.canonT := fun h => no (@HalfField.canonT_sites (base q) h)
  have f0 : HalfFieldOB5.endpointMap (base q) = base q := by rcases hq with rfl | rfl | rfl <;> decide +kernel
  have f1 : OwnPlusEndpoint.swap (base q) = base q := by rcases hq with rfl | rfl | rfl <;> decide +kernel
  have f2 : OwnGuardEndpoint.swap (base q) = base q := by rcases hq with rfl | rfl | rfl <;> decide +kernel
  have f3 : OwnQ4Endpoint.swap (base q) = base q := by rcases hq with rfl | rfl | rfl <;> decide +kernel
  exact ⟨OwnPlusHost.rename_avoid _ _ _ f3 (OwnPlusHost.rename_avoid _ _ _ f2
      (OwnPlusHost.rename_avoid _ _ _ f1 (OwnPlusHost.rename_avoid _ _ _ f0 a))),
    OwnPlusHost.rename_avoid _ _ _ f3 (OwnPlusHost.rename_avoid _ _ _ f2
      (OwnPlusHost.rename_avoid _ _ _ f1 (OwnPlusHost.rename_avoid _ _ _ f0 b)))⟩

private theorem copyN_avoid_2400_2410 (q : Nat) (hq : q = 2400 ∨ q = 2410) :
    base q ∉ ECDSAAdd.wires HalfFieldOB5.copyN := by
  intro hm
  have h := copyRegister_wires_subset none HalfField.ports.r HalfField.ports.y (by
    simpa only [HalfFieldOB5.copyN, HalfField5.copyN, HalfField.copyN] using hm)
  have pr : HalfField.ports.r = wireBlock base 2056 256 := balancedSharedPorts_r base (base 2409)
  have py : HalfField.ports.y = wireBlock base 770 256 := balancedSharedPorts_y base (base 2409)
  rw [pr, py] at h
  simp only [Option.toList_none, List.nil_append, List.mem_toFinset, List.mem_append, wireBlock,
    List.mem_map, List.mem_range'_1, MappedCompressed.base_injective.eq_iff] at h
  omega

private theorem kernelPreSuf_avoid (q : Nat) (hq : q = 717 ∨ q = 718 ∨ q = 2400) :
    base q ∉ ECDSAAdd.wires kernelPre ∧ base q ∉ ECDSAAdd.wires kernelSuf := by
  have hpre : base q ∉ (NativeFirstDirect.prefixSites base).toFinset := by
    intro hm
    simp only [NativeFirstDirect.prefixSites, wireBlock, List.mem_toFinset, List.mem_append,
      List.mem_cons, List.mem_map, List.mem_range'_1, List.not_mem_nil, or_false,
      MappedCompressed.base_injective.eq_iff] at hm
    omega
  have hint : base q ∉ OB5.integerSites := by
    intro hm; obtain ⟨l, e, hl⟩ := (OB5.integerSites_mem _).mp hm
    have := MappedCompressed.base_injective e; omega
  have hclr : base q ∉ ECDSAAdd.wires (skywalkArithmeticClear base) := by
    rw [skywalkArithmeticClear, skywalkTerminalClear_wires]
    simp only [List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false, MappedCompressed.base_injective.eq_iff]
    omega
  have hn := NativeFirstDirect.prefix_support base
  have hk := NativeFirstKnown.inverse_support base
  constructor
  · intro hm; simp only [kernelPre, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with (h | h) | h
    · exact hpre (hn.1 h)
    · exact hint (StackOB5.forward_support (stackForwardT_subset h))
    · exact hclr h
  · intro hm; simp only [kernelSuf, ECDSAAdd.wires_append, Finset.mem_union] at hm
    rcases hm with (h | h) | h
    · exact hclr h
    · exact hint (StackOB5.reverse_support (stackReverseT_subset h))
    · exact hpre (hk h)

