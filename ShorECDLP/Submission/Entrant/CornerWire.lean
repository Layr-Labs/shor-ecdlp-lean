      append_run_fixed _ _ _ _ _ (fun h2 => WideBank8.Fast16.fprog_run read tailW _ h2),
      AdaptiveCircuit.run_seq, cornerFused_run read _ _ h', List.map_map]
    have hm : refsS.map (h' ∘ Fin.castLE (Nat.le_add_right _ _)) = refsS.map h := by
