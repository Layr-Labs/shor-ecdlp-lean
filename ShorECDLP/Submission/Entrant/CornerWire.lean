theorem compileCompareChain_wellFormed {n : Nat} :
    ∀ (top : Bool) (y : Wire) (x ys carry : List Wire) (cin target start : Nat),
      (y :: target :: cin :: (x ++ ys ++ carry)).Nodup →
      (compileCompareChain (n := n) top y x ys carry cin target start).prog.WellFormed
  | true, y, [a], b :: bs, c :: cs, cin, target, start, hnd => by
      have hcnt := List.nodup_iff_count.mp hnd
      have h4 : [a, b, cin, c].Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
      have htc : target ≠ c := fun e => by
        have h := hcnt c; subst e
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      exact straight_append_wellFormed _ _
        (CatProg.lit_wellFormed _ (by simp [CircuitWellFormed, Gate.WellFormed, htc, htc.symm]))
        (CatProg.noT_wellFormed _ (eraseCarry_phys_of a b cin c h4))
  | true, y, a :: a' :: as, b :: bs, c :: cs, cin, target, start, hnd => by
      have hcnt := List.nodup_iff_count.mp hnd
      have h5 : [y, a, b, cin, c].Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
      have h4 : [a, b, cin, c].Nodup := (List.nodup_cons.mp h5).2
      have hnd' : (y :: target :: c :: ((a' :: as) ++ bs ++ cs)).Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append] at this ⊢; omega
      exact straight_append_wellFormed _ _
        (straight_append_wellFormed _ _
          (CatProg.lit_wellFormed _ (majorityCat_wellFormed y a b cin c h5))
          (compileCompareChain_wellFormed true y (a' :: as) bs cs c target _ hnd'))
        (CatProg.noT_wellFormed _ (eraseCarry_phys_of a b cin c h4))
  | false, y, a :: as, b :: bs, c :: cs, cin, target, start, hnd => by
      have hcnt := List.nodup_iff_count.mp hnd
      have h5 : [y, a, b, cin, c].Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
      have h4 : [a, b, cin, c].Nodup := (List.nodup_cons.mp h5).2
      have hnd' : (y :: target :: c :: (as ++ bs ++ cs)).Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append] at this ⊢; omega
      exact straight_append_wellFormed _ _
        (straight_append_wellFormed _ _
          (CatProg.lit_wellFormed _ (majorityCat_wellFormed y a b cin c h5))
          (compileCompareChain_wellFormed false y as bs cs c target _ hnd'))
        (CatProg.noT_wellFormed _ (eraseCarry_phys_of a b cin c h4))
  | false, _, [], [], [], cin, target, _, hnd => by
      have hct : cin ≠ target := fun e => by
        have h := List.nodup_iff_count.mp hnd target; subst e
        simp only [List.count_cons, beq_self_eq_true, ↓reduceIte] at h; omega
      exact CatProg.lit_wellFormed _ (by simp [CircuitWellFormed, Gate.WellFormed, hct])
  | true, _, [], [], [], _, _, _, _ => CatProg.lit_wellFormed _ (by simp [CircuitWellFormed])
  | false, _, [], _ :: _, _, _, _, _, _ | false, _, [], [], _ :: _, _, _, _, _
  | false, _, _ :: _, [], _, _, _, _, _ | false, _, _ :: _, _ :: _, [], _, _, _, _
  | true, _, [], _ :: _, _, _, _, _, _ | true, _, [], [], _ :: _, _, _, _, _
  | true, _, [_], [], _, _, _, _, _ | true, _, _ :: _ :: _, [], _, _, _, _, _
  | true, _, [_], _ :: _, [], _, _, _, _ | true, _, _ :: _ :: _, _ :: _, [], _, _, _, _ =>
      CatProg.lit_wellFormed _ (by simp [CircuitWellFormed])

theorem compileCompareChain_catLitSim {n : Nat} :
    ∀ (top : Bool) (y : Wire) (x ys carry : List Wire) (cin target start : Nat)
      (hnd : (y :: target :: cin :: (x ++ ys ++ carry)).Nodup)
      (read : ConstantBit n → Bool) (h : Fin start → Bool),
      CatLitSim y ((compileCompareChain (n := n) top y x ys carry cin target start).prog.instantiate read h)
        (cmpChainProg top x ys carry cin target) (fun s => s y = false ∧ ∀ w ∈ carry, s w = false)
  | true, y, [a], b :: bs, c :: cs, cin, target, start, hnd, read, h => by
      have hcnt := List.nodup_iff_count.mp hnd
      have h5 : [y, a, b, cin, c].Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
      have h5' := h5
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
        or_false, not_or, not_false_eq_true, and_true] at h5'
      have hyt : y ≠ target := fun e => by
        have hc := hcnt target; subst e
        simp only [List.count_cons, beq_self_eq_true, ↓reduceIte] at hc; omega
      have hcy : y ∉ ECDSAAdd.wires (eraseCarry a b cin c) := by
        intro hm; rw [eraseCarry_wires] at hm
        simp only [Finset.mem_insert, Finset.mem_singleton] at hm
        rcases hm with e | e | e | e <;> [exact h5'.1.1 e; exact h5'.1.2.1 e; exact h5'.1.2.2.1 e; exact h5'.1.2.2.2 e]
      have htop : CatLitSim y ((CatProg.lit (n := n) (start := start) [.X target, .CX target c, .CX c target]).prog.instantiate read h)
          ([.X target, .CX target c, .CX c target] : ECDSAAdd.Program)
          (fun s => s y = false ∧ ∀ w ∈ c :: cs, s w = false) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st _
        have hyc : y ∉ circuitWires ([.X target, .CX target c, .CX c target] : Circuit) := by
          simp [circuitWires, gateWires, hyt, h5'.1.2.2.2]
        rw [prep_circuit y _ hyc, signedKet_smul_eq, map_smul, Quantum.run_cons, Quantum.run_cons,
          Quantum.run_singleton, applyGate_X_ket, applyGate_CX_ket, applyGate_CX_ket]
        have hrun : ECDSAAdd.run ([.X target, .CX target c, .CX c target] : ECDSAAdd.Program) List.nil st =
            ⟨st.phase,
              let s1 := st.basis[target ↦ !st.basis target]
              let s2 := s1[c ↦ s1 c ^^ s1 target]
              s2[target ↦ s2 target ^^ s2 c]⟩ := by
          simp only [ECDSAAdd.run, writeBit_eq_upd]
        rw [hrun, signedKet_smul_eq, map_smul]
      have h12 := catLitSim_append _ _ (CatProg.noT_indep _) read h _ (eraseCarry a b cin c) _ (fun _ => True)
        htop (fun h' => CatProg.noT_catLitSim y (eraseCarry a b cin c) hcy read h') (fun _ _ _ _ => trivial)
      have hpe : cmpChainProg true ([a]) (b :: bs) (c :: cs) cin target =
          ([.X target, .CX target c, .CX c target] : ECDSAAdd.Program) ++ eraseCarry a b cin c := by
        simp only [cmpChainProg, if_true, TopReuseCarry.compareChainTop]
      rw [hpe]; exact h12
  | true, y, a :: a' :: as, b :: bs, c :: cs, cin, target, start, hnd, read, h => by
      have hcnt := List.nodup_iff_count.mp hnd
      have h5 : [y, a, b, cin, c].Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
      have h5' := h5
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
        or_false, not_or, not_false_eq_true, and_true] at h5'
      have hnd' : (y :: target :: c :: ((a' :: as) ++ bs ++ cs)).Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append] at this ⊢; omega
      have hcy : y ∉ ECDSAAdd.wires (eraseCarry a b cin c) := by
        intro hm; rw [eraseCarry_wires] at hm
        simp only [Finset.mem_insert, Finset.mem_singleton] at hm
        rcases hm with e | e | e | e <;> [exact h5'.1.1 e; exact h5'.1.2.1 e; exact h5'.1.2.2.1 e; exact h5'.1.2.2.2 e]
      have hstep_maj : ∀ st m, (st.basis y = false ∧ ∀ w ∈ c :: cs, st.basis w = false) →
          m.length = ECDSAAdd.measurementCount (majority a b cin c) →
          (ECDSAAdd.run (majority a b cin c) m st).basis y = false ∧
            ∀ w ∈ cs, (ECDSAAdd.run (majority a b cin c) m st).basis w = false := by
        intro st m ⟨hy0, hca⟩ _
        rw [majority_correct a b cin c (List.nodup_cons.mp h5).2 st m]
        refine ⟨by simp [ECDSAAdd.writeBit, h5'.1.2.2.2, hy0], fun w hw => ?_⟩
        have hwc : w ≠ c := fun e => by
          have hc := hcnt c; have hp := List.count_pos_iff.mpr (e ▸ hw)
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at hc; omega
        simp [ECDSAAdd.writeBit, hwc, hca w (List.mem_cons_of_mem _ hw)]
      have hmaj : CatLitSim y ((CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)).prog.instantiate read h)
          (majority a b cin c) (fun s => s y = false ∧ ∀ w ∈ c :: cs, s w = false) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st ⟨hy0, hca⟩
        rw [signedKet_smul_eq, map_smul, map_smul,
          majorityCat_prep_ket y a b cin c h5 st.basis (hca c List.mem_cons_self) hy0,
          majority_correct a b cin c (List.nodup_cons.mp h5).2 st List.nil,
          hca c List.mem_cons_self, Bool.false_xor, signedKet_smul_eq, map_smul, writeBit_eq_upd]
      have h12 := catLitSim_append _ _ (compileCompareChain_indep true y (a' :: as) bs cs c target _) read h
        (majority a b cin c) (cmpChainProg true (a' :: as) bs cs c target) _ _
        hmaj (fun h' => compileCompareChain_catLitSim true y (a' :: as) bs cs c target _ hnd' read h') hstep_maj
      have h123 := catLitSim_append _ _ (CatProg.noT_indep _) read h _ (eraseCarry a b cin c) _ (fun _ => True)
        h12 (fun h' => CatProg.noT_catLitSim y (eraseCarry a b cin c) hcy read h') (fun _ _ _ _ => trivial)
      have hpe : cmpChainProg true (a :: a' :: as) (b :: bs) (c :: cs) cin target =
          (majority a b cin c ++ cmpChainProg true (a' :: as) bs cs c target) ++ eraseCarry a b cin c := by
        simp only [cmpChainProg, if_true, TopReuseCarry.compareChainTop, reduceCtorEq, if_false]
      rw [hpe]; exact h123
  | false, y, a :: as, b :: bs, c :: cs, cin, target, start, hnd, read, h => by
      have hcnt := List.nodup_iff_count.mp hnd
      have h5 : [y, a, b, cin, c].Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
      have h5' := h5
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
        or_false, not_or, not_false_eq_true, and_true] at h5'
      have hnd' : (y :: target :: c :: (as ++ bs ++ cs)).Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := hcnt w
        simp only [List.count_cons, List.count_append] at this ⊢; omega
      have hcy : y ∉ ECDSAAdd.wires (eraseCarry a b cin c) := by
        intro hm; rw [eraseCarry_wires] at hm
        simp only [Finset.mem_insert, Finset.mem_singleton] at hm
        rcases hm with e | e | e | e <;> [exact h5'.1.1 e; exact h5'.1.2.1 e; exact h5'.1.2.2.1 e; exact h5'.1.2.2.2 e]
      have hstep_maj : ∀ st m, (st.basis y = false ∧ ∀ w ∈ c :: cs, st.basis w = false) →
          m.length = ECDSAAdd.measurementCount (majority a b cin c) →
          (ECDSAAdd.run (majority a b cin c) m st).basis y = false ∧
            ∀ w ∈ cs, (ECDSAAdd.run (majority a b cin c) m st).basis w = false := by
        intro st m ⟨hy0, hca⟩ _
        rw [majority_correct a b cin c (List.nodup_cons.mp h5).2 st m]
        refine ⟨by simp [ECDSAAdd.writeBit, h5'.1.2.2.2, hy0], fun w hw => ?_⟩
        have hwc : w ≠ c := fun e => by
          have hc := hcnt c; have hp := List.count_pos_iff.mpr (e ▸ hw)
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at hc; omega
        simp [ECDSAAdd.writeBit, hwc, hca w (List.mem_cons_of_mem _ hw)]
      have hmaj : CatLitSim y ((CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)).prog.instantiate read h)
          (majority a b cin c) (fun s => s y = false ∧ ∀ w ∈ c :: cs, s w = false) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st ⟨hy0, hca⟩
        rw [signedKet_smul_eq, map_smul, map_smul,
          majorityCat_prep_ket y a b cin c h5 st.basis (hca c List.mem_cons_self) hy0,
          majority_correct a b cin c (List.nodup_cons.mp h5).2 st List.nil,
          hca c List.mem_cons_self, Bool.false_xor, signedKet_smul_eq, map_smul, writeBit_eq_upd]
      have h12 := catLitSim_append _ _ (compileCompareChain_indep false y as bs cs c target start) read h
        (majority a b cin c) (cmpChainProg false as bs cs c target) _ _
        hmaj (fun h' => compileCompareChain_catLitSim false y as bs cs c target start hnd' read h') hstep_maj
      have h123 := catLitSim_append _ _ (CatProg.noT_indep _) read h _ (eraseCarry a b cin c) _ (fun _ => True)
        h12 (fun h' => CatProg.noT_catLitSim y (eraseCarry a b cin c) hcy read h') (fun _ _ _ _ => trivial)
      have hpe : cmpChainProg false (a :: as) (b :: bs) (c :: cs) cin target =
          (majority a b cin c ++ cmpChainProg false as bs cs c target) ++ eraseCarry a b cin c := by
        simp only [cmpChainProg, Bool.false_eq_true, if_false, compareChain]
      rw [hpe]; exact h123
  | false, y, [], [], [], cin, target, _, hnd, _, _ => by
      have hcnt := List.nodup_iff_count.mp hnd
      have hyt : y ≠ target := fun e => by
        have hc := hcnt target; subst e; simp only [List.count_cons, beq_self_eq_true, ↓reduceIte] at hc; omega
      have hyc : y ≠ cin := fun e => by
        have hc := hcnt cin; subst e; simp only [List.count_cons, beq_self_eq_true, ↓reduceIte] at hc; omega
      apply catLitSim_lit_unitary _ _ _ rfl
      intro st _
      have hyf : y ∉ circuitWires ([.X target, .CX cin target] : Circuit) := by
        simp [circuitWires, gateWires, hyt, hyc]
      rw [prep_circuit y _ hyf, signedKet_smul_eq, map_smul, Quantum.run_cons, Quantum.run_singleton,
        applyGate_X_ket, applyGate_CX_ket]
      have hrun : ECDSAAdd.run (cmpChainProg false List.nil List.nil List.nil cin target) List.nil st =
          ⟨st.phase, let s1 := st.basis[target ↦ !st.basis target]; s1[target ↦ s1 target ^^ s1 cin]⟩ := by
        simp only [cmpChainProg, Bool.false_eq_true, if_false, compareChain, flipBelow, ECDSAAdd.run, writeBit_eq_upd]
      rw [hrun, signedKet_smul_eq, map_smul]
  | true, _, [], [], [], _, _, _, _, _, _ => by
      apply catLitSim_lit_unitary _ _ _ rfl
      intro st _; simp [cmpChainProg, TopReuseCarry.compareChainTop, Quantum.run_nil, ECDSAAdd.run]
  | false, _, [], _ :: _, _, _, _, _, _, _, _ | false, _, [], [], _ :: _, _, _, _, _, _, _
  | false, _, _ :: _, [], _, _, _, _, _, _, _ | false, _, _ :: _, _ :: _, [], _, _, _, _, _, _ => by
      apply catLitSim_lit_unitary _ _ _ rfl
      intro st _; simp [cmpChainProg, compareChain, Quantum.run_nil, ECDSAAdd.run]
  | true, _, [], _ :: _, _, _, _, _, _, _, _ | true, _, [], [], _ :: _, _, _, _, _, _, _
  | true, _, [_], [], _, _, _, _, _, _, _ | true, _, _ :: _ :: _, [], _, _, _, _, _, _, _
  | true, _, [_], _ :: _, [], _, _, _, _, _, _ | true, _, _ :: _ :: _, _ :: _, [], _, _, _, _, _, _ => by
      apply catLitSim_lit_unitary _ _ _ rfl
      intro st _; simp [cmpChainProg, TopReuseCarry.compareChainTop, Quantum.run_nil, ECDSAAdd.run]

/-- Full `compareLt` / `compareLtTop` where `y` is in `cs` (`carry = c0 :: cs`) and `cin` starts `false`. -/
def compileCompareLt {n : Nat} (top : Bool) (y : Wire) (x ys carry : List Wire) (cin target : Wire)
    (start : Nat) : CatProg n start :=
  match x, ys, carry with
  | a0 :: as, b0 :: bs, c0 :: cs =>
      let p0 := CatProg.noT (n := n) (start := start) (Arithmetic.notRegister (cin :: b0 :: bs))
      let p1 := CatProg.lit (n := n) (start := p0.finish) (majorityCat y a0 b0 cin c0)
      let p2a := CatProg.lit (n := n) (start := p1.finish) (flipSwapCircuit y cin)
      let p2b := compileCompareChain top cin as bs cs c0 target p2a.finish
      let p2 := (p2a.append p2b).append (CatProg.lit (n := n) (start := p2b.finish) (unflipSwapCircuit y cin))
      let p3 := CatProg.noT (n := n) (start := p2.finish) (eraseCarry a0 b0 cin c0)
      let p4 := CatProg.noT (n := n) (start := p3.finish) (Arithmetic.notRegister (cin :: b0 :: bs))
      (((p0.append p1).append p2).append p3).append p4
  | _, _, _ => CatProg.lit []

theorem eraseCarry_basis_local (a b cin c : Wire) (r : List Bool) (t : ECDSAAdd.State) (q : Wire) :
    (ECDSAAdd.run (eraseCarry a b cin c) r t).basis q = if q = c then false else t.basis q := by
  cases hm : r.headD false <;> by_cases hq : q = c <;>
    simp [eraseCarry, ECDSAAdd.run, ECDSAAdd.measureAndCorrect, ECDSAAdd.correct_basis,
      ECDSAAdd.writeBit, Function.update, hq, hm]

theorem compareChain_carry_clean :
    ∀ (top : Bool) (x ys carry : List Wire) (cin target : Wire),
      x.length = ys.length → carry.length = ys.length → carry.Nodup →
      ∀ (s : ECDSAAdd.State) (m : List Bool) (q : Wire), q ∈ carry →
      (ECDSAAdd.run (cmpChainProg top x ys carry cin target) m s).basis q = false
  | _, [], [], [], _, _, _, _, _, _, _, _, hq => by simp at hq
  | top, a :: as, b :: bs, c :: cs, cin, target, hx, hc, hn, s, m, q, hq => by
      cases top
      · have e : cmpChainProg false (a :: as) (b :: bs) (c :: cs) cin target =
            (majority a b cin c ++ cmpChainProg false as bs cs c target) ++ eraseCarry a b cin c := rfl
        rw [e, ECDSAAdd.run_append, eraseCarry_basis_local]
        by_cases qc : q = c
        · simp [qc]
        · rw [if_neg qc, ECDSAAdd.run_append]
          exact compareChain_carry_clean false as bs cs c target (by simpa using hx) (by simpa using hc)
            (List.nodup_cons.mp hn).2 _ _ q (by simpa [qc] using hq)
      · have e : cmpChainProg true (a :: as) (b :: bs) (c :: cs) cin target =
            (if as = [] then [.X target, .CX target c, .CX c target]
              else majority a b cin c ++ cmpChainProg true as bs cs c target) ++ eraseCarry a b cin c := rfl
        rw [e, ECDSAAdd.run_append, eraseCarry_basis_local]
        by_cases qc : q = c
        · simp [qc]
        · rw [if_neg qc]
          by_cases has : as = []
          · subst has; simp only [List.length_cons, List.length_nil] at hx hc
            have hcs : cs = [] := List.eq_nil_of_length_eq_zero (by omega)
            subst hcs; simp [qc] at hq
          · rw [if_neg has, ECDSAAdd.run_append]
            exact compareChain_carry_clean true as bs cs c target (by simpa using hx) (by simpa using hc)
              (List.nodup_cons.mp hn).2 _ _ q (by simpa [qc] using hq)
  | _, [], _ :: _, _, _, _, hx, _, _, _, _, _, _ | _, _ :: _, [], _, _, _, hx, _, _, _, _, _, _ => by simp at hx
  | _, _ :: _, _ :: _, [], _, _, _, hc, _, _, _, _, _ | _, [], [], _ :: _, _, _, _, hc, _, _, _, _, _ => by simp at hc

private theorem notRegister_toff (r : List Wire) : ECDSAAdd.toffoliCount (Arithmetic.notRegister r) = 0 :=
  (notRegister_counts r).1

private theorem notRegister_norm_toff (r : List Wire) :
    ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram (Arithmetic.notRegister r)) = 0 := by
  have h := ECDSAAdd.Baselines.normalize_toffoli (Arithmetic.notRegister r); rw [notRegister_toff] at h; omega

private theorem notRegister_phys (r : List Wire) : ECDSAAdd.Arithmetic.GatePhysical (Arithmetic.notRegister r) :=
  notRegister_physical r

theorem compileCompareLt_indep {n : Nat} (top : Bool) (y : Wire) (x ys carry : List Wire) (cin target start : Nat) :
    Indep (compileCompareLt (n := n) top y x ys carry cin target start).prog := by
  cases x with
  | nil => exact CatProg.lit_indep _
  | cons a0 as =>
    cases ys with
    | nil => exact CatProg.lit_indep _
    | cons b0 bs =>
      cases carry with
      | nil => exact CatProg.lit_indep _
      | cons c0 cs =>
        dsimp only [compileCompareLt]
        exact indep_append _ _
          (indep_append _ _
            (indep_append _ _
              (indep_append _ _ (CatProg.noT_indep _) (CatProg.lit_indep _))
              (indep_append _ _ (indep_append _ _ (CatProg.lit_indep _)
                (compileCompareChain_indep top cin as bs cs c0 target _)) (CatProg.lit_indep _)))
            (CatProg.noT_indep _))
          (CatProg.noT_indep _)

theorem compileCompareLt_removed18 {n : Nat} (top : Bool) (y : Wire) (x ys carry : List Wire) (cin target start : Nat) :
    removed 18 (compileCompareLt (n := n) top y x ys carry cin target start).prog = 0 := by
  cases x with
  | nil => rfl
  | cons a0 as =>
    cases ys with
    | nil => rfl
    | cons b0 bs =>
      cases carry with
      | nil => rfl
      | cons c0 cs =>
        simp only [compileCompareLt, CatProg.append, LocalFour.removed_append, CatProg.noT_removed18,
          CatProg.lit_removed, majorityCat_removed18, flipSwapCircuit_removed18, unflipSwapCircuit_removed18,
          compileCompareChain_removed18]

theorem compileCompareLt_finish {n : Nat} (top : Bool) (y : Wire)
    (a0 : Wire) (as : List Wire) (b0 : Wire) (bs : List Wire) (c0 : Wire) (cs : List Wire)
    (cin target start : Nat) (has : as ≠ []) :
    (compileCompareLt (n := n) top y (a0 :: as) (b0 :: bs) (c0 :: cs) cin target start).finish =
      start + ECDSAAdd.measurementCount (cmpLtProg top (a0 :: as) (b0 :: bs) (c0 :: cs) cin target) := by
  have hnr : ECDSAAdd.measurementCount (Arithmetic.notRegister (cin :: b0 :: bs)) = 0 := (notRegister_counts _).2
  have hm : ECDSAAdd.measurementCount (majority a0 b0 cin c0) = 0 := rfl
  have he : ECDSAAdd.measurementCount (eraseCarry a0 b0 cin c0) = 1 := rfl
  simp only [compileCompareLt, CatProg.append, CatProg.lit, CatProg.noT_finish, compileCompareChain_finish, hnr, he]
  cases top
  · simp only [cmpLtProg, cmpChainProg, Bool.false_eq_true, if_false, compareLt, compareChain,
      ECDSAAdd.measurementCount_append, hnr, hm, he]
    omega
  · simp only [cmpLtProg, cmpChainProg, if_true, TopReuseCarry.compareLtTop, TopReuseCarry.compareChainTop,
      if_neg has, ECDSAAdd.measurementCount_append, hnr, hm, he]
    omega

theorem compileCompareLt_tCount {n : Nat} (top : Bool) (y : Wire)
    (a0 : Wire) (as : List Wire) (b0 : Wire) (bs : List Wire) (c0 : Wire) (cs : List Wire)
    (cin target start : Nat) (has : as ≠ [])
    (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    ((compileCompareLt (n := n) top y (a0 :: as) (b0 :: bs) (c0 :: cs) cin target start).prog.instantiate read h).tCount =
      4 * ECDSAAdd.toffoliCount (cmpLtProg top (a0 :: as) (b0 :: bs) (c0 :: cs) cin target) := by
  simp only [compileCompareLt, CatProg.append]
  rw [indep_append_tCount _ _ (CatProg.noT_indep _),
    indep_append_tCount _ _ (CatProg.noT_indep _),
    indep_append_tCount _ _ (indep_append _ _ (indep_append _ _ (CatProg.lit_indep _)
      (compileCompareChain_indep top cin as bs cs c0 target _)) (CatProg.lit_indep _)),
    indep_append_tCount _ _ (CatProg.lit_indep _),
    indep_append_tCount _ _ (CatProg.lit_indep _),
    indep_append_tCount _ _ (compileCompareChain_indep top cin as bs cs c0 target _),
    CatProg.noT_tCount, notRegister_norm_toff, CatProg.lit_tCount, majorityCat_tCount,
    CatProg.lit_tCount, flipSwapCircuit_tCount, compileCompareChain_tCount,
    CatProg.lit_tCount, unflipSwapCircuit_tCount,
    CatProg.noT_tCount, eraseCarry_norm_toff, CatProg.noT_tCount, notRegister_norm_toff]
  have hnt : ECDSAAdd.toffoliCount (Arithmetic.notRegister (cin :: b0 :: bs)) = 0 := notRegister_toff _
  have hm : ECDSAAdd.toffoliCount (majority a0 b0 cin c0) = 1 := rfl
  have he : ECDSAAdd.toffoliCount (eraseCarry a0 b0 cin c0) = 0 := rfl
  cases top
  · simp only [cmpLtProg, cmpChainProg, Bool.false_eq_true, if_false, compareLt, compareChain,
      ECDSAAdd.toffoliCount_append, hnt, hm, he]
    omega
  · simp only [cmpLtProg, cmpChainProg, if_true, TopReuseCarry.compareLtTop, TopReuseCarry.compareChainTop,
      if_neg has, ECDSAAdd.toffoliCount_append, hnt, hm, he]
    omega

theorem compileCompareLt_slots {n : Nat} (top : Bool) (y : Wire)
    (a0 : Wire) (as : List Wire) (b0 : Wire) (bs : List Wire) (c0 : Wire) (cs : List Wire)
    (cin target start : Nat) :
    (compileCompareLt (n := n) top y (a0 :: as) (b0 :: bs) (c0 :: cs) cin target start).prog.gateSlots ≤
      60 * (b0 :: bs).length + 60 := by
  have hns : ECDSAAdd.Challenge.gateSlots (Arithmetic.notRegister (cin :: b0 :: bs)) = (cin :: b0 :: bs).length := by
    have go (l : List Wire) : ECDSAAdd.Challenge.gateSlots (Arithmetic.notRegister l) = l.length := by
      induction l with
      | nil => rfl
      | cons w ws ih =>
        change ECDSAAdd.Challenge.instructionSlots (.X w) + ECDSAAdd.Challenge.gateSlots (Arithmetic.notRegister ws) = ws.length + 1
        rw [ih]; change 1 + ws.length = ws.length + 1; omega
    exact go _
  have hes : ECDSAAdd.Challenge.gateSlots (eraseCarry a0 b0 cin c0) = 4 := rfl
  have h1 : ∀ k, (CatProg.noT (n := n) (start := k) (Arithmetic.notRegister (cin :: b0 :: bs))).prog.gateSlots ≤
      3 * (b0 :: bs).length + 3 := fun k => by
    have h := CatProg.noT_slots (n := n) (start := k) (Arithmetic.notRegister (cin :: b0 :: bs))
    rw [hns] at h; simp only [List.length_cons] at h ⊢; omega
  have h3 : ∀ k, (CatProg.noT (n := n) (start := k) (eraseCarry a0 b0 cin c0)).prog.gateSlots ≤ 12 := fun k => by
    have h := CatProg.noT_slots (n := n) (start := k) (eraseCarry a0 b0 cin c0)
    rw [hes] at h; omega
  dsimp only [compileCompareLt]
  simp only [CatProg.append, Straight.gateSlots_append, CatProg.lit_slots, majorityCat_length,
    flipSwapCircuit_length, unflipSwapCircuit_length]
  refine Nat.le_trans (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (h1 _) le_rfl)
    (Nat.add_le_add (Nat.add_le_add le_rfl (compileCompareChain_slots top cin as bs cs c0 target _)) le_rfl)) (h3 _)) (h1 _)) ?_
  simp only [List.length_cons]
  omega

theorem compileCompareLt_wires {n : Nat} (top : Bool) (y : Wire)
    (a0 : Wire) (as : List Wire) (b0 : Wire) (bs : List Wire) (c0 : Wire) (cs : List Wire)
    (cin target start : Nat) (S : List Wire)
    (hy : y ∈ S) (hcin : cin ∈ S) (htgt : target ∈ S)
    (hx : (a0 :: as) ⊆ S) (hys : (b0 :: bs) ⊆ S) (hca : (c0 :: cs) ⊆ S) :
    ChallengeMigration.straightWires (compileCompareLt (n := n) top y (a0 :: as) (b0 :: bs) (c0 :: cs) cin target start).prog ⊆ S := by
  have ha0 : a0 ∈ S := hx List.mem_cons_self
  have hb0 : b0 ∈ S := hys List.mem_cons_self
  have hc0 : c0 ∈ S := hca List.mem_cons_self
  have hnr : ECDSAAdd.wires (notRegister (cin :: b0 :: bs)) ⊆ S.toFinset := by
    rw [notRegister_wires]
    intro w hw; simp only [List.mem_toFinset, List.mem_cons] at hw ⊢
    rcases hw with rfl | rfl | hw
    · exact hcin
    · exact hb0
    · exact hys (List.mem_cons_of_mem _ hw)
  have hec : ECDSAAdd.wires (eraseCarry a0 b0 cin c0) ⊆ S.toFinset := by
    intro w hw; rw [eraseCarry_wires] at hw
    simp only [Finset.mem_insert, Finset.mem_singleton] at hw
    simp only [List.mem_toFinset]
    rcases hw with rfl | rfl | rfl | rfl <;> assumption
  dsimp only [compileCompareLt]
  simp only [CatProg.append, straightWires_append, List.append_subset]
  refine ⟨⟨⟨⟨CatProg.noT_wires _ S hnr, ?_⟩, ⟨⟨?_, ?_⟩, ?_⟩⟩, CatProg.noT_wires _ S hec⟩, CatProg.noT_wires _ S hnr⟩
  · rw [CatProg.lit_wires]; intro w hw
    have h' := majorityCat_wires y a0 b0 cin c0 hw
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
    rcases h' with rfl | rfl | rfl | rfl | rfl <;> assumption
  · rw [CatProg.lit_wires]; intro w hw
    have h' := flipSwapCircuit_wires y cin hw
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
    rcases h' with rfl | rfl <;> assumption
  · exact compileCompareChain_wires top cin as bs cs c0 target _ S hcin hc0 htgt
      (fun w hw => hx (List.mem_cons_of_mem _ hw))
      (fun w hw => hys (List.mem_cons_of_mem _ hw))
      (fun w hw => hca (List.mem_cons_of_mem _ hw))
  · rw [CatProg.lit_wires]; intro w hw
    have h' := unflipSwapCircuit_wires y cin hw
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h'
    rcases h' with rfl | rfl <;> assumption

theorem compileCompareLt_wellFormed {n : Nat} (top : Bool) (y : Wire)
    (a0 : Wire) (as : List Wire) (b0 : Wire) (bs : List Wire) (c0 : Wire) (cs : List Wire)
    (cin target start : Nat)
    (hnd : (target :: cin :: ((a0 :: as) ++ (b0 :: bs) ++ (c0 :: cs))).Nodup)
    (hycs : y ∈ cs) :
    (compileCompareLt (n := n) top y (a0 :: as) (b0 :: bs) (c0 :: cs) cin target start).prog.WellFormed := by
  have hcnt := List.nodup_iff_count.mp hnd
  have hypos : 0 < List.count y cs := List.count_pos_iff.mpr hycs
  have h5 : [y, a0, b0, cin, c0].Nodup := by
    apply List.nodup_iff_count.mpr; intro w
    by_cases hwy : w = y
    · subst hwy
      have h := hcnt w
      have ha0 : (a0 == w) = false := by
        by_contra hc; simp only [Bool.not_eq_false, beq_iff_eq] at hc; subst hc
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      have hb0 : (b0 == w) = false := by
        by_contra hc; simp only [Bool.not_eq_false, beq_iff_eq] at hc; subst hc
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      have hcin : (cin == w) = false := by
        by_contra hc; simp only [Bool.not_eq_false, beq_iff_eq] at hc; subst hc
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      have hc0 : (c0 == w) = false := by
        by_contra hc; simp only [Bool.not_eq_false, beq_iff_eq] at hc; subst hc
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      simp [List.count_cons, List.count_nil, ha0, hb0, hcin, hc0]
    · have h := hcnt w
      simp only [List.count_cons, List.count_append, List.count_nil, beq_iff_eq, Ne.symm hwy, ↓reduceIte] at h ⊢
      omega
  have h4 : [a0, b0, cin, c0].Nodup := (List.nodup_cons.mp h5).2
  have hycin : y ≠ cin := by
    have := List.nodup_cons.mp h5; intro e; exact this.1 (by simp [e])
  have hnd' : (cin :: target :: c0 :: (as ++ bs ++ cs)).Nodup := by
    apply List.nodup_iff_count.mpr; intro w; have := hcnt w
    simp only [List.count_cons, List.count_append] at this ⊢; omega
  dsimp only [compileCompareLt]
  exact straight_append_wellFormed _ _
    (straight_append_wellFormed _ _
      (straight_append_wellFormed _ _
        (straight_append_wellFormed _ _
          (CatProg.noT_wellFormed _ (notRegister_phys _))
          (CatProg.lit_wellFormed _ (majorityCat_wellFormed y a0 b0 cin c0 h5)))
        (straight_append_wellFormed _ _
          (straight_append_wellFormed _ _
            (CatProg.lit_wellFormed _ (flipSwapCircuit_wellFormed y cin hycin))
            (compileCompareChain_wellFormed top cin as bs cs c0 target _ hnd'))
          (CatProg.lit_wellFormed _ (unflipSwapCircuit_wellFormed y cin hycin))))
      (CatProg.noT_wellFormed _ (eraseCarry_phys_of a0 b0 cin c0 h4)))
    (CatProg.noT_wellFormed _ (notRegister_phys _))

theorem compileCompareLt_catLitSim {n : Nat} (top : Bool) (y : Wire)
    (a0 : Wire) (as : List Wire) (b0 : Wire) (bs : List Wire) (c0 : Wire) (cs : List Wire)
    (cin target start : Nat) (has : as ≠ [])
    (hx : as.length = bs.length) (hc : cs.length = bs.length)
    (hnd : (target :: cin :: ((a0 :: as) ++ (b0 :: bs) ++ (c0 :: cs))).Nodup)
    (hycs : y ∈ cs)
    (read : ConstantBit n → Bool) (h : Fin start → Bool) :
    CatLitSim y ((compileCompareLt (n := n) top y (a0 :: as) (b0 :: bs) (c0 :: cs) cin target start).prog.instantiate read h)
      (cmpLtProg top (a0 :: as) (b0 :: bs) (c0 :: cs) cin target)
      (fun s => s cin = false ∧ ∀ w ∈ c0 :: cs, s w = false) := by
  have hcnt := List.nodup_iff_count.mp hnd
  have hypos : 0 < List.count y cs := List.count_pos_iff.mpr hycs
  have h5 : [y, a0, b0, cin, c0].Nodup := by
    apply List.nodup_iff_count.mpr; intro w
    by_cases hwy : w = y
    · subst hwy; have h := hcnt w
      have : (a0 == w) = false ∧ (b0 == w) = false ∧ (cin == w) = false ∧ (c0 == w) = false := by
        refine ⟨?_, ?_, ?_, ?_⟩
        · by_contra hc'; simp only [Bool.not_eq_false, beq_iff_eq] at hc'; subst hc'
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
        · by_contra hc'; simp only [Bool.not_eq_false, beq_iff_eq] at hc'; subst hc'
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
        · by_contra hc'; simp only [Bool.not_eq_false, beq_iff_eq] at hc'; subst hc'
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
        · by_contra hc'; simp only [Bool.not_eq_false, beq_iff_eq] at hc'; subst hc'
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      simp [List.count_cons, List.count_nil, this.1, this.2.1, this.2.2.1, this.2.2.2]
    · have h := hcnt w
      simp only [List.count_cons, List.count_append, List.count_nil, beq_iff_eq, Ne.symm hwy, ↓reduceIte] at h ⊢; omega
  have h5' := h5
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    or_false, not_or, not_false_eq_true, and_true] at h5'
  have hycin : y ≠ cin := h5'.1.2.2.1
  have hnd' : (cin :: target :: c0 :: (as ++ bs ++ cs)).Nodup := by
    apply List.nodup_iff_count.mpr; intro w; have := hcnt w
    simp only [List.count_cons, List.count_append] at this ⊢; omega
  have hnr_nd : (cin :: b0 :: bs).Nodup := by
    apply List.nodup_iff_count.mpr; intro w; have := hcnt w
    simp only [List.count_cons, List.count_append] at this ⊢; omega
  have hy_not_nr : y ∉ ECDSAAdd.wires (notRegister (cin :: b0 :: bs)) := by
    rw [notRegister_wires]; intro hm
    have h := hcnt y; have hp := List.count_pos_iff.mpr (List.mem_toFinset.mp hm)
    simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h hp; omega
  have hy_not_ec : y ∉ ECDSAAdd.wires (eraseCarry a0 b0 cin c0) := by
    intro hm; rw [eraseCarry_wires] at hm
    simp only [Finset.mem_insert, Finset.mem_singleton] at hm
    rcases hm with e | e | e | e <;> [exact h5'.1.1 e; exact h5'.1.2.1 e; exact h5'.1.2.2.1 e; exact h5'.1.2.2.2 e]
  have hcin_not_chain : cin ∉ ECDSAAdd.wires (cmpChainProg top as bs cs c0 target) := by
    intro hm
    have hsub : ECDSAAdd.wires (cmpChainProg top as bs cs c0 target) ⊆ (target :: c0 :: (as ++ bs ++ cs)).toFinset := by
      cases top
      · have heq := compareChain_wires none as bs cs c0 target hx hc
        simp only [cmpChainProg, Bool.false_eq_true, if_false, Option.toList_none, List.nil_append] at heq ⊢
        exact heq.subset
      · exact TopReuseCarry.compareChainTop_wires as bs cs c0 target
    have hp := List.count_pos_iff.mpr (List.mem_toFinset.mp (hsub hm))
    have h := hcnt cin
    simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h hp; omega
  have hcs_nd : cs.Nodup := by
    apply List.nodup_iff_count.mpr; intro w; have := hcnt w
    simp only [List.count_cons, List.count_append] at this ⊢; omega
  -- Step 0: notRegister (cin :: b0 :: bs)
  have h0 : CatLitSim y ((CatProg.noT (n := n) (start := start) (notRegister (cin :: b0 :: bs))).prog.instantiate read h)
      (notRegister (cin :: b0 :: bs)) (fun s => s cin = false ∧ ∀ w ∈ c0 :: cs, s w = false) :=
    catLitSim_weaken (CatProg.noT_catLitSim y _ hy_not_nr read h) (fun _ _ => trivial)
  have hstep0 : ∀ st m, (st.basis cin = false ∧ ∀ w ∈ c0 :: cs, st.basis w = false) →
      m.length = ECDSAAdd.measurementCount (notRegister (cin :: b0 :: bs)) →
      (ECDSAAdd.run (notRegister (cin :: b0 :: bs)) m st).basis cin = true ∧
        ∀ w ∈ c0 :: cs, (ECDSAAdd.run (notRegister (cin :: b0 :: bs)) m st).basis w = false := by
    intro st m ⟨hc0, hca⟩ _
    rw [notRegister_correct _ hnr_nd st m]
    refine ⟨by simp [hc0], fun w hw => ?_⟩
    have hwnr : w ∉ cin :: b0 :: bs := fun hm => by
      have h := hcnt w; have hp1 := List.count_pos_iff.mpr hm; have hp2 := List.count_pos_iff.mpr hw
      simp only [List.count_cons, List.count_append] at h hp1 hp2; omega
    simp [hwnr, hca w hw]
  -- Step 1: majorityCat y a0 b0 cin c0
  have h1 (k : Nat) (h' : Fin k → Bool) :
      CatLitSim y ((CatProg.lit (n := n) (start := k) (majorityCat y a0 b0 cin c0)).prog.instantiate read h')
        (majority a0 b0 cin c0) (fun s => s cin = true ∧ ∀ w ∈ c0 :: cs, s w = false) := by
    apply catLitSim_lit_unitary _ _ _ rfl
    intro st ⟨_, hca⟩
    rw [signedKet_smul_eq, map_smul, map_smul,
      majorityCat_prep_ket y a0 b0 cin c0 h5 st.basis (hca c0 List.mem_cons_self) (hca y (List.mem_cons_of_mem _ hycs)),
      majority_correct a0 b0 cin c0 (List.nodup_cons.mp h5).2 st List.nil,
      hca c0 List.mem_cons_self, Bool.false_xor, signedKet_smul_eq, map_smul, writeBit_eq_upd]
  have hp01 := catLitSim_append _ _ (CatProg.lit_indep _) read h _ _ _ _ h0 (h1 _) hstep0
  have hstep01 : ∀ st m, (st.basis cin = false ∧ ∀ w ∈ c0 :: cs, st.basis w = false) →
      m.length = ECDSAAdd.measurementCount (Arithmetic.notRegister (cin :: b0 :: bs) ++ majority a0 b0 cin c0) →
      (ECDSAAdd.run (Arithmetic.notRegister (cin :: b0 :: bs) ++ majority a0 b0 cin c0) m st).basis cin = true ∧
        ∀ w ∈ cs, (ECDSAAdd.run (Arithmetic.notRegister (cin :: b0 :: bs) ++ majority a0 b0 cin c0) m st).basis w = false := by
    intro st m hst _
    rw [ECDSAAdd.run_append, majority_correct a0 b0 cin c0 (List.nodup_cons.mp h5).2]
    have hs0 := hstep0 st (m.take (ECDSAAdd.measurementCount (Arithmetic.notRegister (cin :: b0 :: bs)))) hst (by simp [notRegister_counts])
    refine ⟨by simp [ECDSAAdd.writeBit, h5'.2.2.2, hs0.1], fun w hw => ?_⟩
    have hwc0 : w ≠ c0 := fun e => by
      have h := hcnt c0; have hp := List.count_pos_iff.mpr (e ▸ hw)
      simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
    simp [ECDSAAdd.writeBit, hwc0, hs0.2 w (List.mem_cons_of_mem _ hw)]
  -- Step 2: flipSwap ++ compileCompareChain top cin ++ unflipSwap
  have hp2 (k : Nat) (h' : Fin k → Bool) :
      CatLitSim y
        ((((CatProg.lit (n := n) (start := k) (flipSwapCircuit y cin)).append
            (compileCompareChain top cin as bs cs c0 target _)).append
            (CatProg.lit (unflipSwapCircuit y cin))).prog.instantiate read h')
        (cmpChainProg top as bs cs c0 target)
        (fun s => s cin = true ∧ ∀ w ∈ cs, s w = false) := by
    apply catLitSim_flipSwap_surround hycin _ (compileCompareChain_indep top cin as bs cs c0 target _)
      (cmpChainProg top as bs cs c0 target) _ read h' hcin_not_chain
    · intro h''
      apply catLitSim_weaken (compileCompareChain_catLitSim top cin as bs cs c0 target _ hnd' read h'')
      rintro bs ⟨bs0, ⟨_, hcs0⟩, rfl⟩
      refine ⟨by simp [upd], fun w hw => ?_⟩
      have hwcin : w ≠ cin := fun e => by
        have h := hcnt cin; have hp := List.count_pos_iff.mpr (e ▸ hw)
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      simp [upd, hwcin, hcs0 w hw]
    · intro s ⟨hcin1, hcs0⟩; exact ⟨hcs0 y hycs, hcin1⟩
    · intro st m _ _
      exact compareChain_carry_clean top as bs cs c0 target hx hc hcs_nd st m y hycs
  have hp012 := catLitSim_append _ _
    (indep_append _ _ (indep_append _ _ (CatProg.lit_indep _)
      (compileCompareChain_indep top cin as bs cs c0 target _)) (CatProg.lit_indep _))
    read h _ _ _ _ hp01 (hp2 _) hstep01
  have hp0123 := catLitSim_append _ _ (CatProg.noT_indep _) read h _ (eraseCarry a0 b0 cin c0) _ (fun _ => True)
    hp012 (fun h' => CatProg.noT_catLitSim y _ hy_not_ec read h') (fun _ _ _ _ => trivial)
  have hp01234 := catLitSim_append _ _ (CatProg.noT_indep _) read h _ (Arithmetic.notRegister (cin :: b0 :: bs)) _ (fun _ => True)
    hp0123 (fun h' => CatProg.noT_catLitSim y _ hy_not_nr read h') (fun _ _ _ _ => trivial)
  have hpeq :
      (((Arithmetic.notRegister (cin :: b0 :: bs) ++ majority a0 b0 cin c0) ++ cmpChainProg top as bs cs c0 target) ++
        eraseCarry a0 b0 cin c0) ++ Arithmetic.notRegister (cin :: b0 :: bs) =
      cmpLtProg top (a0 :: as) (b0 :: bs) (c0 :: cs) cin target := by
    cases top
    · simp only [cmpLtProg, cmpChainProg, Bool.false_eq_true, if_false, compareLt, compareChain, List.append_assoc]
    · simp only [cmpLtProg, cmpChainProg, if_true, TopReuseCarry.compareLtTop, TopReuseCarry.compareChainTop,
        if_neg has, List.append_assoc]
  rw [← hpeq]; exact hp01234

