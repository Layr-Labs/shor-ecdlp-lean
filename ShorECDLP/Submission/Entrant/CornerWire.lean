    (h5 : op1 + op2 + op3 + op4 + op5 ≤ L) (hL : L ≤ 50115160) :
    ha0 + hb0 ≤ 1499000000 := by omega

theorem cornerFused_slots (start : Nat) (refsS : List (Fin start)) :
