      exact CatProg.lit_wellFormed _ (by simp [CircuitWellFormed, Gate.WellFormed, hab, hcb])
  | [], _, _, _, _, _, _ | [_], [], _, _, _, _, _ | [_], _ :: _ :: _, _, _, _, _, _
  | [_, _], [], _, _, _, _, _ | [_, _], [_], _, _, _, _, _ | [_, _], _ :: _ :: _, [], _, _, _, _
  | _ :: _ :: _ :: _, [], _, _, _, _, _ | _ :: _ :: _ :: _, [_], _, _, _, _, _
  | _ :: _ :: _ :: _, _ :: _ :: _, [], _, _, _, _ => CatProg.lit_wellFormed _ (by simp [CircuitWellFormed])

private theorem writeBit_eq_upd (s : BasisState) (w : Wire) (v : Bool) : ECDSAAdd.writeBit s w v = s[w ↦ v] := by
  funext u; by_cases h : u = w <;> simp [ECDSAAdd.writeBit, Function.update, upd, h]

private theorem run_cx2_ket (y a b cin : Wire) (hy : y ≠ a ∧ y ≠ b ∧ y ≠ cin) (st : ECDSAAdd.State) :
    Quantum.run ([.CX a b, .CX cin b] : Circuit) (Prep y (Bridge.signedKet st)) =
      Prep y (Bridge.signedKet (ECDSAAdd.run ([.CX a b, .CX cin b] : ECDSAAdd.Program) List.nil st)) := by
  have hyc : y ∉ circuitWires ([.CX a b, .CX cin b] : Circuit) := by
    simp [circuitWires, gateWires, hy.1, hy.2.1, hy.2.2]
  rw [prep_circuit y _ hyc, signedKet_smul_eq, map_smul, Quantum.run_cons, Quantum.run_singleton,
    applyGate_CX_ket, applyGate_CX_ket]
  have hrun : ECDSAAdd.run ([.CX a b, .CX cin b] : ECDSAAdd.Program) List.nil st =
      ⟨st.phase, st.basis[b ↦ st.basis b ^^ st.basis a][b ↦ (st.basis[b ↦ st.basis b ^^ st.basis a]) b ^^
        (st.basis[b ↦ st.basis b ^^ st.basis a]) cin]⟩ := by
    simp only [ECDSAAdd.run, writeBit_eq_upd]
  rw [hrun, signedKet_smul_eq, map_smul]

private theorem run_cx3_ket (y b b' cin c : Wire) (hy : y ≠ b ∧ y ≠ b' ∧ y ≠ cin ∧ y ≠ c) (st : ECDSAAdd.State) :
    Quantum.run ([.CX b c, .CX b' c, .CX cin c] : Circuit) (Prep y (Bridge.signedKet st)) =
      Prep y (Bridge.signedKet (ECDSAAdd.run ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) List.nil st)) := by
  have hyc : y ∉ circuitWires ([.CX b c, .CX b' c, .CX cin c] : Circuit) := by
    simp [circuitWires, gateWires, hy.1, hy.2.1, hy.2.2.1, hy.2.2.2]
  rw [prep_circuit y _ hyc, signedKet_smul_eq, map_smul, Quantum.run_cons, Quantum.run_cons,
    Quantum.run_singleton, applyGate_CX_ket, applyGate_CX_ket, applyGate_CX_ket]
  have hrun : ECDSAAdd.run ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) List.nil st =
      ⟨st.phase,
        let s1 := st.basis[c ↦ st.basis c ^^ st.basis b]
        let s2 := s1[c ↦ s1 c ^^ s1 b']
        s2[c ↦ s2 c ^^ s2 cin]⟩ := by
    simp only [ECDSAAdd.run, writeBit_eq_upd]
  rw [hrun, signedKet_smul_eq, map_smul]

theorem compileAddInPlace_catLitSim {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat)
      (hnd : (y :: cin :: (ys ++ carry)).Nodup)
      (hdis : List.Disjoint x (y :: cin :: (ys ++ carry)))
      (read : ConstantBit n → Bool) (h : Fin start → Bool),
      CatLitSim y ((compileAddInPlace (n := n) y x ys carry cin start).prog.instantiate read h)
        (addInPlace x ys carry cin) (fun s => s y = false ∧ ∀ w ∈ carry, s w = false)
  | a :: a' :: as, b :: b' :: bs, c :: cs, cin, start, hnd, hdis, read, h => by
      have h5 := nodup5_from_readonly y a b cin c (a' :: as) (b' :: bs) cs hnd hdis
      have h5' := h5
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
        or_false, not_or, not_false_eq_true, and_true] at h5'
      have hnd' : (y :: c :: ((b' :: bs) ++ cs)).Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := List.nodup_iff_count.mp hnd w
        simp only [List.count_cons, List.count_append] at this ⊢; omega
      have hdis' : List.Disjoint (a' :: as) (y :: c :: ((b' :: bs) ++ cs)) := by
        intro w hw1 hw2
        exact hdis (List.mem_cons_of_mem _ hw1)
          (by simp only [List.mem_cons, List.mem_append] at hw2 ⊢; tauto)
      have hcy : y ∉ ECDSAAdd.wires (eraseCarry a b cin c) := by
        intro hm; rw [eraseCarry_wires] at hm
        simp only [Finset.mem_insert, Finset.mem_singleton] at hm
        rcases hm with e | e | e | e <;> [exact h5'.1.1 e; exact h5'.1.2.1 e; exact h5'.1.2.2.1 e; exact h5'.1.2.2.2 e]
      have hmaj : CatLitSim y ((CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)).prog.instantiate read h)
          (majority a b cin c) (fun s => s y = false ∧ ∀ w ∈ c :: cs, s w = false) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st ⟨hy0, hca⟩
        rw [signedKet_smul_eq, map_smul, map_smul,
          majorityCat_prep_ket y a b cin c h5 st.basis (hca c List.mem_cons_self) hy0,
          majority_correct a b cin c (List.nodup_cons.mp h5).2 st List.nil,
          hca c List.mem_cons_self, Bool.false_xor, signedKet_smul_eq, map_smul, writeBit_eq_upd]
      have hstep1 : ∀ st m, (st.basis y = false ∧ ∀ w ∈ c :: cs, st.basis w = false) →
          m.length = ECDSAAdd.measurementCount (majority a b cin c) →
          (ECDSAAdd.run (majority a b cin c) m st).basis y = false ∧
            ∀ w ∈ cs, (ECDSAAdd.run (majority a b cin c) m st).basis w = false := by
        intro st m ⟨hy0, hca⟩ _
        rw [majority_correct a b cin c (List.nodup_cons.mp h5).2 st m]
        refine ⟨by simp [ECDSAAdd.writeBit, h5'.1.2.2.2, hy0], fun w hw => ?_⟩
        have hwc : w ≠ c := fun e => by
          have hcnt := List.nodup_iff_count.mp hnd c
          have hpos := List.count_pos_iff.mpr (e ▸ hw)
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at hcnt; omega
        simp [ECDSAAdd.writeBit, hwc, hca w (List.mem_cons_of_mem _ hw)]
      have hp12 := catLitSim_append _ _ (compileAddInPlace_indep y (a' :: as) (b' :: bs) cs c _) read h
        (majority a b cin c) (addInPlace (a' :: as) (b' :: bs) cs c) _ _
        hmaj (fun h' => compileAddInPlace_catLitSim y (a' :: as) (b' :: bs) cs c _ hnd' hdis' read h') hstep1
      have hp123 := catLitSim_append _ _ (CatProg.noT_indep _) read h _ (eraseCarry a b cin c) _ (fun _ => True)
        hp12 (fun h' => CatProg.noT_catLitSim y (eraseCarry a b cin c) hcy read h') (fun _ _ _ _ => trivial)
      have hp4 (k : Nat) (h' : Fin k → Bool) :
          CatLitSim y ((CatProg.lit (n := n) (start := k) [.CX a b, .CX cin b]).prog.instantiate read h')
            ([.CX a b, .CX cin b] : ECDSAAdd.Program) (fun _ => True) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st _
        exact run_cx2_ket y a b cin ⟨h5'.1.1, h5'.1.2.1, h5'.1.2.2.1⟩ st
      simpa only [compileAddInPlace, addInPlace] using
        catLitSim_append _ _ (CatProg.lit_indep _) read h _ _ _ (fun _ => True) hp123 (hp4 _) (fun _ _ _ _ => trivial)
  | [a], [b], _, cin, start, hnd, hdis, read, h => by
      have hyb : y ≠ b := fun e => by
        have h := List.nodup_iff_count.mp hnd b; subst e
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      have hyc : y ≠ cin := fun e => by
        have h := List.nodup_iff_count.mp hnd cin; subst e
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      have hya : y ≠ a := fun e => hdis List.mem_cons_self (by simp [e])
      apply catLitSim_lit_unitary _ _ _ rfl
      intro st _; exact run_cx2_ket y a b cin ⟨hya, hyb, hyc⟩ st
  | [], _, _, _, _, _, _, _, _ | [_], [], _, _, _, _, _, _, _ | [_], _ :: _ :: _, _, _, _, _, _, _, _
  | _ :: _ :: _, [], _, _, _, _, _, _, _ | _ :: _ :: _, [_], _, _, _, _, _, _, _
  | _ :: _ :: _, _ :: _ :: _, [], _, _, _, _, _, _ => by
      apply catLitSim_lit_unitary _ _ _ rfl
      intro st _; simp [Quantum.run_nil, addInPlace, ECDSAAdd.run]

theorem compileAddInPlaceTop_catLitSim {n : Nat} (y : Wire) :
    ∀ (x ys carry : List Wire) (cin start : Nat)
      (hnd : (y :: cin :: (ys ++ carry)).Nodup)
      (hdis : List.Disjoint x (y :: cin :: (ys ++ carry)))
      (read : ConstantBit n → Bool) (h : Fin start → Bool),
      CatLitSim y ((compileAddInPlaceTop (n := n) y x ys carry cin start).prog.instantiate read h)
        (TopReuseCarry.addInPlaceTop x ys carry cin) (fun s => s y = false ∧ ∀ w ∈ carry, s w = false)
  | [a, a'], b :: b' :: bs, c :: cs, cin, start, hnd, hdis, read, h => by
      have h5 := nodup5_from_readonly y a b cin c ([a']) (b' :: bs) cs hnd hdis
      have h5' := h5
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
        or_false, not_or, not_false_eq_true, and_true] at h5'
      have hyb' : y ≠ b' := fun e => by
        have hc := List.nodup_iff_count.mp hnd b'; subst e
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at hc; omega
      have hnd' : (y :: c :: ((b' :: bs) ++ cs)).Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := List.nodup_iff_count.mp hnd w
        simp only [List.count_cons, List.count_append] at this ⊢; omega
      have hdis' : List.Disjoint ([a']) (y :: c :: ((b' :: bs) ++ cs)) := by
        intro w hw1 hw2
        exact hdis (List.mem_cons_of_mem _ hw1)
          (by simp only [List.mem_cons, List.mem_append] at hw2 ⊢; tauto)
      have hcy : y ∉ ECDSAAdd.wires (eraseCarry a b cin c) := by
        intro hm; rw [eraseCarry_wires] at hm
        simp only [Finset.mem_insert, Finset.mem_singleton] at hm
        rcases hm with e | e | e | e <;> [exact h5'.1.1 e; exact h5'.1.2.1 e; exact h5'.1.2.2.1 e; exact h5'.1.2.2.2 e]
      have hp1 : CatLitSim y ((CatProg.lit (n := n) (start := start) [.CX b c, .CX b' c, .CX cin c]).prog.instantiate read h)
          ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) (fun s => s y = false ∧ ∀ w ∈ c :: cs, s w = false) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st _
        exact run_cx3_ket y b b' cin c ⟨h5'.1.2.1, hyb', h5'.1.2.2.1, h5'.1.2.2.2⟩ st
      have hstep1 : ∀ st m, (st.basis y = false ∧ ∀ w ∈ c :: cs, st.basis w = false) →
          m.length = ECDSAAdd.measurementCount ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) →
          (ECDSAAdd.run ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) m st).basis y = false ∧
            ∀ w ∈ cs, (ECDSAAdd.run ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) m st).basis w = false := by
        intro st m ⟨hy0, hca⟩ _
        have hpres (w : Wire) (hwc : w ≠ c) :
            (ECDSAAdd.run ([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) m st).basis w = st.basis w := by
          simp [ECDSAAdd.run, ECDSAAdd.writeBit, hwc]
        refine ⟨(hpres y h5'.1.2.2.2).trans hy0, fun w hw => ?_⟩
        have hwc : w ≠ c := fun e => by
          have hcnt := List.nodup_iff_count.mp hnd c
          have hpos := List.count_pos_iff.mpr (e ▸ hw)
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at hcnt; omega
        exact (hpres w hwc).trans (hca w (List.mem_cons_of_mem _ hw))
      have hp12 := catLitSim_append _ _ (compileAddInPlaceTop_indep y ([a']) (b' :: bs) cs c _) read h
        _ (TopReuseCarry.addInPlaceTop ([a']) (b' :: bs) cs c) _ _
        hp1 (fun h' => compileAddInPlaceTop_catLitSim y ([a']) (b' :: bs) cs c _ hnd' hdis' read h') hstep1
      have hp123 := catLitSim_append _ _ (CatProg.noT_indep _) read h _ (eraseCarry a b cin c) _ (fun _ => True)
        hp12 (fun h' => CatProg.noT_catLitSim y (eraseCarry a b cin c) hcy read h') (fun _ _ _ _ => trivial)
      have hp4 (k : Nat) (h' : Fin k → Bool) :
          CatLitSim y ((CatProg.lit (n := n) (start := k) [.CX a b, .CX cin b]).prog.instantiate read h')
            ([.CX a b, .CX cin b] : ECDSAAdd.Program) (fun _ => True) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st _
        exact run_cx2_ket y a b cin ⟨h5'.1.1, h5'.1.2.1, h5'.1.2.2.1⟩ st
      have hres := catLitSim_append _ _ (CatProg.lit_indep _) read h _ _ _ (fun _ => True) hp123 (hp4 _) (fun _ _ _ _ => trivial)
      have hpe : TopReuseCarry.addInPlaceTop ([a, a']) (b :: b' :: bs) (c :: cs) cin =
          ((([.CX b c, .CX b' c, .CX cin c] : ECDSAAdd.Program) ++ TopReuseCarry.addInPlaceTop ([a']) (b' :: bs) cs c) ++
            eraseCarry a b cin c) ++ [.CX a b, .CX cin b] := by
        simp only [TopReuseCarry.addInPlaceTop, if_true]
      rw [hpe]; exact hres
  | a :: a' :: a'' :: as, b :: b' :: bs, c :: cs, cin, start, hnd, hdis, read, h => by
      have h5 := nodup5_from_readonly y a b cin c (a' :: a'' :: as) (b' :: bs) cs hnd hdis
      have h5' := h5
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
        or_false, not_or, not_false_eq_true, and_true] at h5'
      have hnd' : (y :: c :: ((b' :: bs) ++ cs)).Nodup := by
        apply List.nodup_iff_count.mpr; intro w; have := List.nodup_iff_count.mp hnd w
        simp only [List.count_cons, List.count_append] at this ⊢; omega
      have hdis' : List.Disjoint (a' :: a'' :: as) (y :: c :: ((b' :: bs) ++ cs)) := by
        intro w hw1 hw2
        exact hdis (List.mem_cons_of_mem _ hw1)
          (by simp only [List.mem_cons, List.mem_append] at hw2 ⊢; tauto)
      have hcy : y ∉ ECDSAAdd.wires (eraseCarry a b cin c) := by
        intro hm; rw [eraseCarry_wires] at hm
        simp only [Finset.mem_insert, Finset.mem_singleton] at hm
        rcases hm with e | e | e | e <;> [exact h5'.1.1 e; exact h5'.1.2.1 e; exact h5'.1.2.2.1 e; exact h5'.1.2.2.2 e]
      have hmaj : CatLitSim y ((CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)).prog.instantiate read h)
          (majority a b cin c) (fun s => s y = false ∧ ∀ w ∈ c :: cs, s w = false) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st ⟨hy0, hca⟩
        rw [signedKet_smul_eq, map_smul, map_smul,
          majorityCat_prep_ket y a b cin c h5 st.basis (hca c List.mem_cons_self) hy0,
          majority_correct a b cin c (List.nodup_cons.mp h5).2 st List.nil,
          hca c List.mem_cons_self, Bool.false_xor, signedKet_smul_eq, map_smul, writeBit_eq_upd]
      have hstep1 : ∀ st m, (st.basis y = false ∧ ∀ w ∈ c :: cs, st.basis w = false) →
          m.length = ECDSAAdd.measurementCount (majority a b cin c) →
          (ECDSAAdd.run (majority a b cin c) m st).basis y = false ∧
            ∀ w ∈ cs, (ECDSAAdd.run (majority a b cin c) m st).basis w = false := by
        intro st m ⟨hy0, hca⟩ _
        rw [majority_correct a b cin c (List.nodup_cons.mp h5).2 st m]
        refine ⟨by simp [ECDSAAdd.writeBit, h5'.1.2.2.2, hy0], fun w hw => ?_⟩
        have hwc : w ≠ c := fun e => by
          have hcnt := List.nodup_iff_count.mp hnd c
          have hpos := List.count_pos_iff.mpr (e ▸ hw)
          simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at hcnt; omega
        simp [ECDSAAdd.writeBit, hwc, hca w (List.mem_cons_of_mem _ hw)]
      have hp12 := catLitSim_append _ _ (compileAddInPlaceTop_indep y (a' :: a'' :: as) (b' :: bs) cs c _) read h
        (majority a b cin c) (TopReuseCarry.addInPlaceTop (a' :: a'' :: as) (b' :: bs) cs c) _ _
        hmaj (fun h' => compileAddInPlaceTop_catLitSim y (a' :: a'' :: as) (b' :: bs) cs c _ hnd' hdis' read h') hstep1
      have hp123 := catLitSim_append _ _ (CatProg.noT_indep _) read h _ (eraseCarry a b cin c) _ (fun _ => True)
        hp12 (fun h' => CatProg.noT_catLitSim y (eraseCarry a b cin c) hcy read h') (fun _ _ _ _ => trivial)
      have hp4 (k : Nat) (h' : Fin k → Bool) :
          CatLitSim y ((CatProg.lit (n := n) (start := k) [.CX a b, .CX cin b]).prog.instantiate read h')
            ([.CX a b, .CX cin b] : ECDSAAdd.Program) (fun _ => True) := by
        apply catLitSim_lit_unitary _ _ _ rfl
        intro st _
        exact run_cx2_ket y a b cin ⟨h5'.1.1, h5'.1.2.1, h5'.1.2.2.1⟩ st
      have hres := catLitSim_append _ _ (CatProg.lit_indep _) read h _ _ _ (fun _ => True) hp123 (hp4 _) (fun _ _ _ _ => trivial)
      have hpe : TopReuseCarry.addInPlaceTop (a :: a' :: a'' :: as) (b :: b' :: bs) (c :: cs) cin =
          ((majority a b cin c ++ TopReuseCarry.addInPlaceTop (a' :: a'' :: as) (b' :: bs) cs c) ++
            eraseCarry a b cin c) ++ [.CX a b, .CX cin b] := by
        simp only [TopReuseCarry.addInPlaceTop, reduceCtorEq, if_false]
      rw [hpe]; exact hres
  | [a], [b], _, cin, start, hnd, hdis, read, h => by
      have hyb : y ≠ b := fun e => by
        have h := List.nodup_iff_count.mp hnd b; subst e
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      have hyc : y ≠ cin := fun e => by
        have h := List.nodup_iff_count.mp hnd cin; subst e
        simp only [List.count_cons, List.count_append, beq_self_eq_true, ↓reduceIte] at h; omega
      have hya : y ≠ a := fun e => hdis List.mem_cons_self (by simp [e])
      apply catLitSim_lit_unitary _ _ _ rfl
      intro st _; exact run_cx2_ket y a b cin ⟨hya, hyb, hyc⟩ st
  | [], _, _, _, _, _, _, _, _ | [_], [], _, _, _, _, _, _, _ | [_], _ :: _ :: _, _, _, _, _, _, _, _
  | [_, _], [], _, _, _, _, _, _, _ | [_, _], [_], _, _, _, _, _, _, _
  | [_, _], _ :: _ :: _, [], _, _, _, _, _, _
  | _ :: _ :: _ :: _, [], _, _, _, _, _, _, _ | _ :: _ :: _ :: _, [_], _, _, _, _, _, _, _
  | _ :: _ :: _ :: _, _ :: _ :: _, [], _, _, _, _, _, _ => by
      apply catLitSim_lit_unitary _ _ _ rfl
      intro st _; simp [Quantum.run_nil, TopReuseCarry.addInPlaceTop, ECDSAAdd.run]

/-! #### 2. Clean-catalyst `compareChain` / `compareLt` / `compareLtTop` -/

def cmpChainProg (top : Bool) (x ys carry : List Wire) (cin target : Wire) : ECDSAAdd.Program :=
  if top then TopReuseCarry.compareChainTop x ys carry cin target else compareChain none x ys carry cin target

def cmpLtProg (top : Bool) (x ys carry : List Wire) (cin target : Wire) : ECDSAAdd.Program :=
  if top then TopReuseCarry.compareLtTop x ys carry cin target else compareLt none x ys carry cin target

def compileCompareChain {n : Nat} :
    Bool → Wire → List Wire → List Wire → List Wire → Wire → Wire → (start : Nat) → CatProg n start
  | true, _, [a], b :: _, c :: _, cin, target, start =>
      let p1 := CatProg.lit (n := n) (start := start) [.X target, .CX target c, .CX c target]
      p1.append (CatProg.noT (n := n) (start := p1.finish) (eraseCarry a b cin c))
  | true, y, a :: a' :: as, b :: bs, c :: cs, cin, target, start =>
      let p1 := CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)
      let p2 := compileCompareChain true y (a' :: as) bs cs c target p1.finish
      (p1.append p2).append (CatProg.noT (n := n) (start := (p1.append p2).finish) (eraseCarry a b cin c))
  | false, y, a :: as, b :: bs, c :: cs, cin, target, start =>
      let p1 := CatProg.lit (n := n) (start := start) (majorityCat y a b cin c)
      let p2 := compileCompareChain false y as bs cs c target p1.finish
      (p1.append p2).append (CatProg.noT (n := n) (start := (p1.append p2).finish) (eraseCarry a b cin c))
  | false, _, [], [], [], cin, target, start => CatProg.lit [.X target, .CX cin target]
  | _, _, _, _, _, _, _, start => CatProg.lit []

theorem compileCompareChain_indep {n : Nat} :
    ∀ (top : Bool) (y : Wire) (x ys carry : List Wire) (cin target start : Nat),
      Indep (compileCompareChain (n := n) top y x ys carry cin target start).prog
  | true, _, [a], b :: _, c :: _, cin, target, start =>
      indep_append _ _ (CatProg.lit_indep _) (CatProg.noT_indep _)
  | true, y, a :: a' :: as, b :: bs, c :: cs, cin, target, start =>
      indep_append _ _ (indep_append _ _ (CatProg.lit_indep _)
        (compileCompareChain_indep true y (a' :: as) bs cs c target _)) (CatProg.noT_indep _)
  | false, y, a :: as, b :: bs, c :: cs, cin, target, start =>
      indep_append _ _ (indep_append _ _ (CatProg.lit_indep _)
