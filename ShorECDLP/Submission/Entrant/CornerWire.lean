  · simp only [OneBankCell5.body, Bool.false_eq_true, if_false, swapBody_eq]
    exact CatFn.seq_catLitSim _ _ (compiledHalf_indep false) SW.swapBody
      (OneBankCell5.half false base (base 2409)) CellValid CellClean
      compiledSwapBody_catLitSim (compiledHalf_catLitSim false)
      (fun st m hv _ => cellValid_clean (cell_swapBody_pres_valid st m hv)) s read h
  · simp only [OneBankCell5.body, if_true, swapBody_eq]
    exact CatFn.seq_catLitSim _ _ compiledSwapBody_indep
      (OneBankCell5.half true base (base 2409)) SW.swapBody CellValid CellValid
      (fun s' r' h' => catLitSim_weaken (compiledHalf_catLitSim true s' r' h') (fun _ hv => cellValid_clean hv))
      compiledSwapBody_catLitSim
      (fun st m hv _ => cell_half_pres_valid true st m hv) s read h

