    dsimp only [Wire] at *
    omega
  · obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hh
    exact Or.inr (hg.bounds _ (hg.bank i)).2
  · right
    rw [hr]
    unfold oldWork
    rcases (facts f hg).2.2.1 with e | e <;> rw [e] <;> omega
  · left
    simp only [high, List.mem_range'_1] at hb
    unfold fixedPort
    dsimp only [Wire] at *
    omega
  · right
    simp only [bankHp, List.mem_range'_1] at hp
    unfold oldWork
