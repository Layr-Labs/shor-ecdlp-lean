/-! EDITABLE. The ShorECDLP side of the ecdsa.fail port, as one module.

The Entrant keeps few modules (the kernel replay loads each module's whole import closure in its
own task). Sections, in order:

1. `WindowMassSharp`, `Success`: phase-estimation window mass and the single-trial success bound.
2. `Chain`, `Coherent`: chaining 526 straight-line blocks and the per-block coherent contract
   `AddsCoherently`, composed into the Naive `ecdlpOracle` on an untouched ideal workspace.
3. `Translate`, `PointCode`, `Sound`, `Resources`: ECDSAAdd templates as challenge straight-line
   programs (`translate`), the point-register identification, soundness (`block_adds`) and the
   static resource counts.
4. `AdaptiveTrial`, `Assembly`: the observed trial and the generic `AddProvider` assembly
   (`AddProvider.certificate`).
-/

/-! ---------------------------------------------------------------------------
(formerly `WindowMassSharp.lean`) -/

/-! Sharp window mass for quantum phase estimation.

With `N = 2 ^ t ≥ 128 r` outcomes, the QPE outcome distribution for the phase `n / r`
puts mass at least `200 / 201` on the outcomes `a` whose rounding `round (r a / N)`
equals `n`.  Compared with `WindowMass.lean`, the pointwise estimate uses
`sin z ≥ z - z ^ 3 / 6` and `sin z = cos (π / 2 - z) ≥ 1 - (π / 2 - z) ^ 2 / 2`, giving
`1 / sin² z ≤ (3 / 2) (1 / z² + 1 / (π - z)²)` on `(0, π)`, so that
`|amplitude a|² ≤ 3 / (2 π²) (1 / u² + 1 / (N - u)²)`.  The two families of terms are
regrouped by the wrapped distances `phiR`, `phiL` (each injective with values `≥ L`), and a
telescoping estimate bounds the tail by `3 / (π² (L - 1)) < 1 / 201` for `L ≥ 64`. -/

-- The common sharp-window proof is supplied by the producer.

/-! ---------------------------------------------------------------------------
(formerly `Success.lean`) -/

/-! EDITABLE. Single-trial success from rounding-window mass.

For every nonzero character `k`, the joint distribution of the two phase
registers is a product of two phase-estimation distributions.  If each
distribution puts mass at least `c` on the samples that round to the correct
numerator, the canonical postprocessing recovers the secret with probability
at least `((r - 1) / r) * c ^ 2`. -/

namespace ShorECDLP.Entrant
open ShorECDLP.Quantum ShorECDLP.Quantum.OrderFinding ShorECDLP.Quantum.PhaseEstimation
open scoped BigOperators
noncomputable section

/-- A pair in the two correct rounding windows decodes to the secret. -/
theorem postprocess_of_windows {r t d : ℕ} (hr : Nat.Prime r)
    (k : Fin r) (hk : k.val ≠ 0) (a b : Fin (2 ^ t))
    (ha : nearestNumerator r t a.val = k.val)
    (hb : nearestNumerator r t b.val = (k.val * d) % r) :
    orderFindingPostprocess r t hr (a, b) = some (d : ZMod r) := by
  haveI : Fact (Nat.Prime r) := ⟨hr⟩
  have hk0 : ((k.val : ℕ) : ZMod r) ≠ 0 := by
    intro h
    rw [ZMod.natCast_eq_zero_iff] at h
    exact hk (Nat.eq_zero_of_dvd_of_lt h k.isLt)
  unfold orderFindingPostprocess
  simp only [ha, hb, ZMod.natCast_mod, Nat.cast_mul]
  rw [if_neg hk0]
  congr 1
  field_simp

theorem mod_mul_ne_zero {r d : ℕ} (hr : Nat.Prime r) (hd : d % r ≠ 0) (k : Fin r)
    (hk : k.val ≠ 0) : (k.val * d) % r ≠ 0 := by
  intro h
  have hdvd : r ∣ k.val * d := Nat.dvd_of_mod_eq_zero h
  rcases (Nat.Prime.dvd_mul hr).mp hdvd with h1 | h1
  · exact hk (Nat.eq_zero_of_dvd_of_lt h1 k.isLt)
  · exact hd (Nat.mod_eq_zero_of_dvd h1)

/-- Generic single-trial lower bound from a rounding-window mass bound. -/
theorem success_of_window_mass {G : Type*} [AddCommGroup G] {w r d t : ℕ}
    (enc : PointEncoding G w) (oracle : State →ₗ[ℂ] State) (P Q : G)
    (aReg bReg pointReg oracleWork : List Wire) (anc : Wire) (s : BasisState)
    (hsetting : ECDLPSetting P Q r d)
    (hspec : ECDLPOracleSpec enc oracle P Q aReg bReg pointReg oracleWork)
    (hsetup : OrderFindingSetup enc aReg bReg pointReg oracleWork anc t s)
    (hd : d % r ≠ 0) (c : ℝ) (hc : 0 ≤ c)
    (hwin : ∀ n : ℕ, 0 < n → n < r →
      c ≤ ∑ a : Fin (2 ^ t),
        if nearestNumerator r t a.val = n then
          Complex.normSq (qpeAmplitude t ((n : ℝ) / (r : ℝ)) a.val) else 0) :
    ((r - 1 : ℝ) / r) * (c * c) ≤
      orderFindingSuccessProbability r t d hsetting.prime_order aReg bReg
        (orderFinding aReg bReg anc oracle (ket s)) := by
  classical
  have hr := hsetting.prime_order
  set ψ := orderFinding aReg bReg anc oracle (ket s) with hψ
  let A : Fin r → Fin (2 ^ t) → ℝ := fun k a =>
    Complex.normSq (qpeAmplitude t ((k.val : ℝ) / (r : ℝ)) a.val)
  let B : Fin r → Fin (2 ^ t) → ℝ := fun k b =>
    Complex.normSq (qpeAmplitude t ((((k.val * d) % r : ℕ) : ℝ) / (r : ℝ)) b.val)
  let good : Fin r → Fin (2 ^ t) → Fin (2 ^ t) → Prop := fun k a b =>
    k.val ≠ 0 ∧ nearestNumerator r t a.val = k.val ∧
      nearestNumerator r t b.val = (k.val * d) % r
  let F : Fin r → Fin (2 ^ t) → Fin (2 ^ t) → ℝ := fun k a b =>
    if good k a b then A k a * B k b else 0
  have hA : ∀ k a, 0 ≤ A k a := fun _ _ => Complex.normSq_nonneg _
  have hB : ∀ k b, 0 ≤ B k b := fun _ _ => Complex.normSq_nonneg _
  have hF : ∀ k a b, 0 ≤ F k a b := by
    intro k a b
    dsimp only [F]
    split_ifs
    · exact mul_nonneg (hA k a) (hB k b)
    · exact le_rfl
  have hrinv : (0 : ℝ) ≤ (r : ℝ)⁻¹ := by positivity
  have hjp : ∀ a b : Fin (2 ^ t),
      jointRegisterProbability aReg bReg a.val b.val ψ =
        (r : ℝ)⁻¹ * ∑ k : Fin r, A k a * B k b := by
    intro a b
    have h := jointRegisterProbability_orderFinding_eq_character_average
      enc oracle P Q aReg bReg pointReg oracleWork anc s hsetting hspec hsetup a b
    simpa only [characterWeight] using h
  -- Step 1: restrict every character to its own pair of rounding windows.
  have step1 :
      ∑ a : Fin (2 ^ t), ∑ b : Fin (2 ^ t), (r : ℝ)⁻¹ * ∑ k : Fin r, F k a b ≤
        orderFindingSuccessProbability r t d hr aReg bReg ψ := by
    unfold orderFindingSuccessProbability
    apply Finset.sum_le_sum
    intro a _
    apply Finset.sum_le_sum
    intro b _
    by_cases hp : orderFindingPostprocess r t hr (a, b) = some (d : ZMod r)
    · rw [if_pos hp, hjp]
      apply mul_le_mul_of_nonneg_left _ hrinv
      apply Finset.sum_le_sum
      intro k _
      dsimp only [F]
      split_ifs
      · exact le_rfl
      · exact mul_nonneg (hA k a) (hB k b)
    · rw [if_neg hp]
      have hz : ∀ k, F k a b = 0 := by
        intro k
        dsimp only [F]
        rw [if_neg]
        rintro ⟨hk, ha, hb⟩
        exact hp (postprocess_of_windows hr k hk a b ha hb)
      simp [hz]
  -- Step 2: exchange the order of summation.
  have step2 :
      ∑ k : Fin r, (r : ℝ)⁻¹ * ∑ a : Fin (2 ^ t), ∑ b : Fin (2 ^ t), F k a b =
        ∑ a : Fin (2 ^ t), ∑ b : Fin (2 ^ t), (r : ℝ)⁻¹ * ∑ k : Fin r, F k a b := by
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.sum_comm]
  -- Step 3: each nonzero character contributes at least `c * c / r`.
  have step3 : ∀ k : Fin r,
      (if k.val = 0 then 0 else (r : ℝ)⁻¹ * (c * c)) ≤
        (r : ℝ)⁻¹ * ∑ a : Fin (2 ^ t), ∑ b : Fin (2 ^ t), F k a b := by
    intro k
    by_cases hk : k.val = 0
    · rw [if_pos hk]
      apply mul_nonneg hrinv
      exact Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun b _ => hF k a b))
    · rw [if_neg hk]
      apply mul_le_mul_of_nonneg_left _ hrinv
      have hprod :
          ∑ a : Fin (2 ^ t), ∑ b : Fin (2 ^ t), F k a b =
            (∑ a : Fin (2 ^ t),
                if nearestNumerator r t a.val = k.val then A k a else 0) *
              (∑ b : Fin (2 ^ t),
                if nearestNumerator r t b.val = (k.val * d) % r then B k b else 0) := by
        rw [Finset.sum_mul_sum]
        apply Finset.sum_congr rfl
        intro a _
        apply Finset.sum_congr rfl
        intro b _
        dsimp only [F, good]
        rw [ite_zero_mul_ite_zero]
        simp only [hk, ne_eq, not_false_eq_true, true_and]
      rw [hprod]
      have hka := hwin k.val (Nat.pos_of_ne_zero hk) k.isLt
      have hkb := hwin ((k.val * d) % r)
        (Nat.pos_of_ne_zero (mod_mul_ne_zero hr hd k hk)) (Nat.mod_lt _ hr.pos)
      exact mul_le_mul hka hkb hc (le_trans hc hka)
  calc
    ((r - 1 : ℝ) / r) * (c * c) =
        ∑ k : Fin r, (if k.val = 0 then 0 else (r : ℝ)⁻¹ * (c * c)) :=
      (nonzero_character_baseline_sum hr (c * c)).symm
    _ ≤ ∑ k : Fin r, (r : ℝ)⁻¹ * ∑ a : Fin (2 ^ t), ∑ b : Fin (2 ^ t), F k a b :=
      Finset.sum_le_sum (fun k _ => step3 k)
    _ = ∑ a : Fin (2 ^ t), ∑ b : Fin (2 ^ t), (r : ℝ)⁻¹ * ∑ k : Fin r, F k a b := step2
    _ ≤ orderFindingSuccessProbability r t d hr aReg bReg ψ := step1

end
end ShorECDLP.Entrant

/-! ---------------------------------------------------------------------------
(formerly `Bridge/Chain.lean`) -/

/-! EDITABLE. Chaining closed straight-line blocks.

A block is a straight-line program `Straight n 0 M` that reads only its own measurement records.
`shiftStraight` (adapted from the protected `2607_13816/Challenge/CursorShift.lean`, Apache-2.0)
moves such a block to an arbitrary starting cursor without letting it read earlier records, so a
list of blocks concatenates to one straight-line program whose instantiation is the sequential
composition of the instantiated blocks, independently of the records produced before it. -/

namespace ShorECDLP.Entrant.Bridge
open Quantum Challenge NaiveChallenge

/-- Prefix existing records without allowing this program to read them. -/
def shiftStraight {n s e : Nat} (offset : Nat) : Straight n s e → Straight n (offset+s) (offset+e)
  | .done => .done
  | .gate g p => .gate g (shiftStraight offset p)
  | .recordGate i v g p => .recordGate (Fin.natAdd offset i) v g (shiftStraight offset p)
  | .measure w p => .measure w (shiftStraight offset p)

theorem shift_lastCases (offset s : Nat) (b : Bool) (h : Fin (offset+s) → Bool) :
    (fun i : Fin (s+1) => (Fin.lastCases b h : Fin (offset+s+1) → Bool) (Fin.natAdd offset i)) =
      Fin.lastCases b (fun i => h (Fin.natAdd offset i)) := by
  funext i
  refine Fin.lastCases ?_ (fun j => ?_) i
  · have he : Fin.natAdd offset (Fin.last s) = Fin.last (offset+s) := Fin.ext rfl
    simp only [he, Fin.lastCases_last]
  · have he : Fin.natAdd offset j.castSucc = (Fin.natAdd offset j).castSucc := rfl
    simp only [he, Fin.lastCases_castSucc]

theorem shiftStraight_instantiate {n s e : Nat} (p : Straight n s e) (offset : Nat)
    (read : ConstantBit n → Bool) (history : Fin (offset+s) → Bool) :
    (shiftStraight offset p).instantiate read history =
      p.instantiate read (fun i => history (Fin.natAdd offset i)) := by
  induction p with
  | done => rfl
  | gate g p ih => simp only [shiftStraight, Straight.instantiate, ih]
  | recordGate i v g p ih => simp only [shiftStraight, Straight.instantiate, ih]
  | measure w p ih => simp only [shiftStraight, Straight.instantiate, ih, shift_lastCases]

/-- A shifted closed block ignores every earlier record. -/
theorem shiftStraight_closed {n e : Nat} (p : Straight n 0 e) (offset : Nat)
    (read : ConstantBit n → Bool) (history : Fin (offset+0) → Bool) :
    (shiftStraight offset p).instantiate read history = p.instantiate read Fin.elim0 := by
  rw [shiftStraight_instantiate]
  congr 1
  funext i
  exact Fin.elim0 i

theorem shiftStraight_gateSlots {n s e : Nat} (p : Straight n s e) (offset : Nat) :
    (shiftStraight offset p).gateSlots = p.gateSlots := by
  induction p <;> simp_all [shiftStraight, Straight.gateSlots]

theorem shiftStraight_wellFormed {n s e : Nat} (p : Straight n s e) (offset : Nat)
    (hp : p.WellFormed) : (shiftStraight offset p).WellFormed := by
  induction p <;> simp_all [shiftStraight, Straight.WellFormed]

theorem shiftStraight_straightT {n s e : Nat} (p : Straight n s e) (offset : Nat) :
    straightT (shiftStraight offset p) = straightT p := by
  induction p <;> simp_all [shiftStraight, straightT]

theorem shiftStraight_straightWires {n s e : Nat} (p : Straight n s e) (offset : Nat) :
    ShorECDLP.NaiveChallenge.straightWires (shiftStraight offset p) = ShorECDLP.NaiveChallenge.straightWires p := by
  induction p <;> simp_all [shiftStraight, ShorECDLP.NaiveChallenge.straightWires]

/-! ## Chains of closed blocks -/

theorem chain_end (start M L : Nat) : start + M + L * M = start + (L + 1) * M := by
  rw [Nat.succ_mul, Nat.add_assoc, Nat.add_comm M]

/-- Concatenate closed blocks, each with `M` records, starting at cursor `start`. -/
def chain {n M : Nat} : (bs : List (Straight n 0 M)) → (start : Nat) →
    Straight n start (start + bs.length * M)
  | [], start => castFinish (by simp) (.done : Straight n start start)
  | b :: bs, start => castFinish (by rw [List.length_cons, chain_end])
      ((shiftStraight start b).append (chain bs (start + M)))

/-- Sequential composition of a list of adaptive programs. -/
def seqAll : List AdaptiveCircuit → AdaptiveCircuit
  | [] => .done
  | a :: as => a.seq (seqAll as)

theorem chain_instantiate {n M : Nat} (bs : List (Straight n 0 M)) (start : Nat)
    (read : ConstantBit n → Bool) (history : Fin start → Bool) :
    (chain bs start).instantiate read history =
      seqAll (bs.map fun b => b.instantiate read Fin.elim0) := by
  induction bs generalizing start with
  | nil => simp only [chain, instantiate_castFinish]; rfl
  | cons b bs ih =>
    simp only [chain, instantiate_castFinish, List.map_cons, seqAll]
    rw [straight_append_constant _ _ read _ (fun h => ih (start + M) h) history]
    rw [shiftStraight_closed b start read history]

theorem chain_gateSlots {n M : Nat} (bs : List (Straight n 0 M)) (start : Nat) :
    (chain bs start).gateSlots = (bs.map Straight.gateSlots).sum := by
  induction bs generalizing start with
  | nil => simp [chain, Straight.gateSlots]
  | cons b bs ih =>
    simp only [chain, gateSlots_castFinish, Straight.gateSlots_append, shiftStraight_gateSlots, ih,
      List.map_cons, List.sum_cons]

theorem chain_wellFormed {n M : Nat} (bs : List (Straight n 0 M)) (start : Nat)
    (h : ∀ b ∈ bs, b.WellFormed) : (chain bs start).WellFormed := by
  induction bs generalizing start with
  | nil => simp [chain, Straight.WellFormed]
  | cons b bs ih =>
    simp only [chain, wellFormed_castFinish]
    exact straight_append_wellFormed _ _
      (shiftStraight_wellFormed b start (h b List.mem_cons_self))
      (ih (start + M) (fun c hc => h c (List.mem_cons_of_mem _ hc)))

theorem chain_straightT {n M : Nat} (bs : List (Straight n 0 M)) (start : Nat) :
    straightT (chain bs start) = (bs.map straightT).sum := by
  induction bs generalizing start with
  | nil => simp [chain, straightT]
  | cons b bs ih =>
    simp only [chain, straightT_castFinish, straightT_append, shiftStraight_straightT, ih,
      List.map_cons, List.sum_cons]

theorem straightWires_append {n a b c : Nat} (p : Straight n a b) (q : Straight n b c) :
    ShorECDLP.NaiveChallenge.straightWires (p.append q) = ShorECDLP.NaiveChallenge.straightWires p ++ ShorECDLP.NaiveChallenge.straightWires q := by
  induction p with
  | done => rfl
  | gate g p ih => simp only [Straight.append, ShorECDLP.NaiveChallenge.straightWires, ih, List.append_assoc]
  | recordGate i v g p ih => simp only [Straight.append, ShorECDLP.NaiveChallenge.straightWires, ih, List.append_assoc]
  | measure w p ih => simp only [Straight.append, ShorECDLP.NaiveChallenge.straightWires, ih, List.cons_append]

theorem straightWires_castFinish {n s e f : Nat} (h : e = f) (p : Straight n s e) :
    ShorECDLP.NaiveChallenge.straightWires (castFinish h p) = ShorECDLP.NaiveChallenge.straightWires p := by
  subst f; rfl

theorem chain_straightWires {n M : Nat} (bs : List (Straight n 0 M)) (start : Nat) :
    ShorECDLP.NaiveChallenge.straightWires (chain bs start) = bs.flatMap ShorECDLP.NaiveChallenge.straightWires := by
  induction bs generalizing start with
  | nil => simp [chain, straightWires_castFinish, ShorECDLP.NaiveChallenge.straightWires]
  | cons b bs ih =>
    simp only [chain, straightWires_castFinish, straightWires_append, shiftStraight_straightWires,
      ih, List.flatMap_cons]

/-- Every branch of a straight-line program records exactly its cursor difference
(adapted from the protected `2607_13816/Challenge/Records.lean`, Apache-2.0). -/
theorem straight_history_length {n s e : Nat} (p : Straight n s e)
    (read : ConstantBit n → Bool) (history : Fin s → Bool)
    (b : InstrumentBranch) (hb : b ∈ (p.instantiate read history).run) :
    b.history.length = e - s := by
  induction p generalizing b with
  | done =>
    simp only [Straight.instantiate, AdaptiveCircuit.run, List.mem_singleton] at hb
    subst b
    simp
  | gate g p ih =>
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hb
    exact ih history a ha
  | recordGate i v g p ih =>
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hb
    exact ih history a ha
  | measure w p ih =>
    rcases List.mem_append.mp hb with hb | hb
    all_goals
      obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hb
      have hh := ih _ a ha
      have hm := p.cursor_mono
      change a.history.length + 1 = _
      omega

end ShorECDLP.Entrant.Bridge

/-! ---------------------------------------------------------------------------
(formerly `Bridge/Coherent.lean`) -/

/-! EDITABLE. Adaptive controlled point additions refine the protected Naive oracle.

`AddsCoherently a ctrl pointReg work C` is the per-block contract of an adaptive controlled point
addition: on every computational-basis input whose point register holds a canonical point code
and whose workspace is clean, each Kraus branch equals one fixed coefficient times the basis state
in which the point register has been replaced by the (controlled) sum, and the coefficients have
total squared magnitude one.  Nothing else changes, for every value of every other wire.

Such a block coherently implements the protected Naive circuit `controlledPointAdd` placed on an
ideal workspace that the block never touches; a chain of blocks implements the Naive
`scalarMulCore`, hence the Naive `ecdlpOracle`, whose `ECDLPOracleSpec` is already proved. The
ideal workspace is purely mathematical: it is not part of the submitted program. -/

namespace ShorECDLP.Entrant.Bridge
open Quantum Secp256k1 Challenge NaiveChallenge

local instance : Fact (Nat.Prime p) := ⟨p_prime⟩

/-- Branchwise exact controlled point addition with input-independent coefficients. -/
def AddsCoherently (a : AdaptiveCircuit) (ctrl : Wire) (pointReg work : List Wire)
    (C : Point) : Prop :=
  ∃ cs : List ℂ, List.Forall₂ (fun (b : InstrumentBranch) (c : ℂ) =>
      ∀ (s : BasisState) (R : Point), regValue pointReg s = encodeNat R → Clean work s →
        b.kraus (ket s) =
          c • ket (writeReg pointReg (encode (controlledPointResult (s ctrl) R C)).val s))
    a.run cs ∧ (cs.map Complex.normSq).sum = 1

/-- Valid inputs: canonical point code, clean real workspace, clean ideal workspace. -/
def ValidN (pointReg work ideal : List Wire) (s : BasisState) : Prop :=
  (∃ R : Point, regValue pointReg s = encodeNat R) ∧ Clean work s ∧ Clean ideal s

/-! ## Register lemmas -/

theorem writeReg_apply_not_mem (reg : List Wire) (v : Nat) (s : BasisState) {w : Wire}
    (hw : w ∉ reg) : writeReg reg v s w = s w := by
  induction reg generalizing v s with
  | nil => rfl
  | cons r rs ih =>
    simp only [List.mem_cons, not_or] at hw
    simp only [writeReg]
    rw [ih _ _ hw.2, upd_other _ _ _ hw.1]

theorem regValue_writeReg (reg : List Wire) (hnd : reg.Nodup) (v : Nat) (s : BasisState)
    (hv : v < 2 ^ reg.length) : regValue reg (writeReg reg v s) = v := by
  induction reg generalizing v s with
  | nil =>
    simp only [List.length_nil, pow_zero] at hv
    simp only [regValue_nil]
    omega
  | cons r rs ih =>
    have hr : r ∉ rs := (List.nodup_cons.mp hnd).1
    have hrs : rs.Nodup := (List.nodup_cons.mp hnd).2
    simp only [writeReg, regValue_cons]
    rw [writeReg_apply_not_mem _ _ _ hr, upd_same,
      ih hrs _ _ (by rw [List.length_cons, Nat.pow_succ] at hv; omega)]
    rw [Nat.testBit_zero]
    by_cases h : v % 2 = 1 <;> simp [h] <;> omega

theorem regValue_congr (reg : List Wire) (s t : BasisState) (h : ∀ w ∈ reg, s w = t w) :
    regValue reg s = regValue reg t := by
  induction reg with
  | nil => rfl
  | cons r rs ih =>
    rw [regValue_cons, regValue_cons, h r List.mem_cons_self,
      ih (fun w hw => h w (List.mem_cons_of_mem _ hw))]

theorem clean_writeReg (reg ws : List Wire) (v : Nat) (s : BasisState)
    (hd : ∀ w ∈ ws, w ∉ reg) (hc : Clean ws s) : Clean ws (writeReg reg v s) := by
  intro w hw
  rw [writeReg_apply_not_mem _ _ _ (hd w hw)]
  exact hc w hw

/-! ## One block -/

/-- The Naive controlled addition, on an ideal workspace, acts as the target permutation. -/
theorem naiveAdd_ket (ctrl : Wire) (pointReg : List Wire) (idealStart : Wire) (C R : Point)
    (s : BasisState) (hlen : pointReg.length = pointWidth)
    (hnd : ([ctrl] ++ pointReg ++ controlledPointAddWork idealStart).Nodup)
    (hR : regValue pointReg s = encodeNat R) (hc : Clean (controlledPointAddWork idealStart) s) :
    Quantum.run (controlledPointAdd ctrl pointReg idealStart C) (ket s) =
      ket (writeReg pointReg (encode (controlledPointResult (s ctrl) R C)).val s) := by
  rw [run_ket_agrees_classical _ s (controlledPointAdd_HPFree ctrl pointReg idealStart C),
    controlledPointAdd_correct ctrl pointReg idealStart C R s hlen hnd hR hc]

/-- Disjointness data for one block and the ideal workspace. -/
structure BlockLayout (ctrl : Wire) (pointReg work : List Wire) (idealStart : Wire) : Prop where
  length : pointReg.length = pointWidth
  nodup : ([ctrl] ++ pointReg ++ controlledPointAddWork idealStart).Nodup
  work_disjoint : ∀ w ∈ work, w ∉ pointReg

theorem BlockLayout.point_nodup {ctrl : Wire} {pointReg work : List Wire} {idealStart : Wire}
    (h : BlockLayout ctrl pointReg work idealStart) : pointReg.Nodup := by
  have h1 := h.nodup
  rw [List.append_assoc] at h1
  exact ((List.nodup_append.mp h1).2.1).sublist (List.sublist_append_left _ _)

theorem BlockLayout.ideal_disjoint {ctrl : Wire} {pointReg work : List Wire} {idealStart : Wire}
    (h : BlockLayout ctrl pointReg work idealStart) :
    ∀ w ∈ controlledPointAddWork idealStart, w ∉ pointReg := by
  intro w hw hp
  have h1 := h.nodup
  rw [List.append_assoc] at h1
  have h2 := (List.nodup_append.mp h1).2.1
  exact (List.nodup_append.mp h2).2.2 w hp w hw rfl

/-- The Naive addition maps valid inputs to valid basis states. -/
theorem naiveAdd_supported {ctrl : Wire} {pointReg work : List Wire} {idealStart : Wire}
    (h : BlockLayout ctrl pointReg work idealStart) (C : Point) (s : BasisState)
    (hs : ValidN pointReg work (controlledPointAddWork idealStart) s) :
    SupportedOn (ValidN pointReg work (controlledPointAddWork idealStart))
      (Quantum.run (controlledPointAdd ctrl pointReg idealStart C) (ket s)) := by
  obtain ⟨⟨R, hR⟩, hw, hi⟩ := hs
  rw [naiveAdd_ket ctrl pointReg idealStart C R s h.length h.nodup hR hi]
  refine supportedOn_ket _ _ ⟨⟨controlledPointResult (s ctrl) R C, ?_⟩,
    clean_writeReg _ _ _ _ h.work_disjoint hw, clean_writeReg _ _ _ _ h.ideal_disjoint hi⟩
  rw [regValue_writeReg _ h.point_nodup _ _ (by rw [h.length]; exact encodeNat_lt _)]
  rfl

/-- A block satisfying the contract coherently implements the Naive controlled addition. -/
theorem AddsCoherently.naive {a : AdaptiveCircuit} {ctrl : Wire} {pointReg work : List Wire}
    {C : Point} (ha : AddsCoherently a ctrl pointReg work C) {idealStart : Wire}
    (h : BlockLayout ctrl pointReg work idealStart) :
    CoherentlyImplementsOn a (Quantum.run (controlledPointAdd ctrl pointReg idealStart C))
      (ValidN pointReg work (controlledPointAddWork idealStart)) := by
  obtain ⟨cs, hcs, hm⟩ := ha
  refine ⟨cs, hcs.imp ?_, hm⟩
  intro b c hb s hs
  obtain ⟨⟨R, hR⟩, hw, hi⟩ := hs
  rw [hb s R hR hw, naiveAdd_ket ctrl pointReg idealStart C R s h.length h.nodup hR hi]

/-! ## Chains of blocks -/

theorem coherent_done (Valid : BasisState → Prop) :
    CoherentlyImplementsOn .done (Quantum.run []) Valid := by
  refine ⟨[1], List.Forall₂.cons ?_ .nil, by simp⟩
  intro s _
  simp [Quantum.run_nil]

/-- Sequential composition of coherent blocks implements the concatenated ideal circuit. -/
theorem seqAll_coherent (Valid : BasisState → Prop) (as : List AdaptiveCircuit)
    (cs : List Circuit)
    (h : List.Forall₂ (fun a c => CoherentlyImplementsOn a (Quantum.run c) Valid ∧
      ∀ s, Valid s → SupportedOn Valid (Quantum.run c (ket s))) as cs) :
    CoherentlyImplementsOn (seqAll as) (Quantum.run cs.flatten) Valid := by
  induction h with
  | nil => exact coherent_done Valid
  | @cons a c as cs hhead _ ih =>
    have h := hhead.1.seq ih hhead.2
    simp only [seqAll, List.flatten_cons]
    refine h.congrIdeal ?_
    intro s _
    rw [Quantum.run_append_map]

theorem forall₂_imp_mem {α β : Type*} {R S : α → β → Prop} :
    ∀ {l₁ : List α} {l₂ : List β}, List.Forall₂ R l₁ l₂ →
      (∀ a b, a ∈ l₁ → b ∈ l₂ → R a b → S a b) → List.Forall₂ S l₁ l₂
  | _, _, .nil, _ => .nil
  | _, _, .cons hab hrest, H =>
    .cons (H _ _ List.mem_cons_self List.mem_cons_self hab)
      (forall₂_imp_mem hrest (fun a b ha hb h =>
        H a b (List.mem_cons_of_mem _ ha) (List.mem_cons_of_mem _ hb) h))

/-- The Naive scalar-multiplication core over parallel control and point lists. -/
theorem scalarMulCore_eq_flatten (pointReg : List Wire) (idealStart : Wire) :
    ∀ (ctrls : List Wire) (pts : List Point), ctrls.length = pts.length →
      scalarMulCore pointReg idealStart ctrls pts =
        ((ctrls.zip pts).map fun cp => controlledPointAdd cp.1 pointReg idealStart cp.2).flatten
  | [], [], _ => by simp [scalarMulCore]
  | c :: cs, P :: Ps, h => by
    simp only [scalarMulCore, List.zip_cons_cons, List.map_cons, List.flatten_cons]
    rw [scalarMulCore_eq_flatten pointReg idealStart cs Ps (by simpa using h)]
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h

/-- A chain of blocks, aligned with control wires and constant points, coherently implements
the Naive scalar-multiplication core on valid inputs. -/
theorem chain_coherent {n M : Nat} (read : ConstantBit n → Bool) (pointReg work : List Wire)
    (idealStart : Wire) (blocks : List (Straight n 0 M)) (ctrls : List Wire) (pts : List Point)
    (hlen : ctrls.length = pts.length)
    (hlayout : ∀ c ∈ ctrls, BlockLayout c pointReg work idealStart)
    (hblocks : List.Forall₂ (fun (b : Straight n 0 M) (cp : Wire × Point) =>
      AddsCoherently (b.instantiate read Fin.elim0) cp.1 pointReg work cp.2)
      blocks (ctrls.zip pts)) (start : Nat) (history : Fin start → Bool) :
    CoherentlyImplementsOn ((chain blocks start).instantiate read history)
      (Quantum.run (scalarMulCore pointReg idealStart ctrls pts))
      (ValidN pointReg work (controlledPointAddWork idealStart)) := by
  rw [chain_instantiate, scalarMulCore_eq_flatten pointReg idealStart ctrls pts hlen]
  apply seqAll_coherent
  rw [List.forall₂_map_left_iff, List.forall₂_map_right_iff]
  refine forall₂_imp_mem hblocks ?_
  intro b cp _ hcp hb
  have hc : cp.1 ∈ ctrls := (List.of_mem_zip hcp).1
  exact ⟨hb.naive (hlayout cp.1 hc), naiveAdd_supported (hlayout cp.1 hc) cp.2⟩

end ShorECDLP.Entrant.Bridge

/-! ---------------------------------------------------------------------------
(formerly `Bridge/Translate.lean`) -/

/-! EDITABLE. Translating vendored ECDSAAdd programs into challenge straight-line programs.

An ECDSAAdd instruction is `X`, `CX`, `CCX`, or an X-basis measurement with reset followed by an
immediate list of `Z`/`CZ` corrections selected by the outcome.  A template instruction is such
an instruction, optionally switched by one table bit (`TInstr`).  The translation keeps the gates,
turns each measurement into the challenge's `measure` followed by record-controlled corrections on
that very record (`Z = H·X·H`, `CZ = H·CX·H`, all Clifford), and never switches a measurement.

`translate_branch` is the soundness theorem: on every signed basis state, every Kraus branch of
the instantiated translation equals `(1/√2)^M` times the signed basis state produced by the
ECDSAAdd semantics on that branch's measurement record. -/

namespace ShorECDLP.Entrant.Bridge
open Quantum Challenge NaiveChallenge

/-- An ECDSAAdd instruction, optionally enabled by one constant bit of the table. -/
inductive TInstr (n : Nat) where
  | lit (i : ECDSAAdd.Instr)
  | when (ref : ConstantBit n) (value : Bool) (i : ECDSAAdd.Instr)

namespace TInstr

def instantiate {n : Nat} (read : ConstantBit n → Bool) : TInstr n → ECDSAAdd.Program
  | .lit i => [i]
  | .when ref v i => if read ref = v then [i] else []

/-- The underlying instruction. -/
def instr {n : Nat} : TInstr n → ECDSAAdd.Instr
  | .lit i => i
  | .when _ _ i => i

/-- Records written by the translation (switched measurements are not allowed). -/
def meas {n : Nat} : TInstr n → Nat
  | .lit (.measureX _ _ _) => 1
  | _ => 0

/-- No measurement is switched by a table bit. -/
def Static {n : Nat} : TInstr n → Prop
  | .when _ _ (.measureX _ _ _) => False
  | _ => True

def rename {n : Nat} (f : Nat → Nat) : TInstr n → TInstr n
  | .lit i => .lit (ECDSAAdd.renameInstr f i)
  | .when r v i => .when r v (ECDSAAdd.renameInstr f i)

end TInstr

/-- The ECDSAAdd program selected by the table bits. -/
def instB {n : Nat} (read : ConstantBit n → Bool) (t : List (TInstr n)) : ECDSAAdd.Program :=
  t.flatMap (TInstr.instantiate read)

def tmplMeas {n : Nat} : List (TInstr n) → Nat
  | [] => 0
  | i :: t => i.meas + tmplMeas t

/-- Clifford circuit of one phase correction. -/
def corrCircuit : ECDSAAdd.Correction → Circuit
  | .Z t => pauliZ t
  | .CZ a b => if a = b then pauliZ a else controlledZ a b

def corrsCircuit (cs : List ECDSAAdd.Correction) : Circuit := cs.flatMap corrCircuit

/-- Gates controlled by one record bit. -/
def recordGates {n k e : Nat} (r : Fin k) (v : Bool) : Circuit → Straight n k e → Straight n k e
  | [], next => next
  | g :: gs, next => .recordGate r v g (recordGates r v gs next)

/-- One template instruction in front of the translation of the rest. -/
def TInstr.step {n e : Nat} : (i : TInstr n) → (k : Nat) → Straight n (k + i.meas) e →
    Straight n k e
  | .lit (.X a), _, next => .gate (.literal (.X a)) next
  | .lit (.CX a b), _, next => .gate (.literal (.CX a b)) next
  | .lit (.CCX a b c), _, next => .gate (.literal (.CCX a b c)) next
  | .lit (.measureX w c0 c1), k, next => .measure w
      (recordGates (Fin.last k) false (corrsCircuit c0)
        (recordGates (Fin.last k) true (corrsCircuit c1) next))
  | .when r v (.X a), _, next => .gate (.whenBit r v (.X a)) next
  | .when r v (.CX a b), _, next => .gate (.whenBit r v (.CX a b)) next
  | .when r v (.CCX a b c), _, next => .gate (.whenBit r v (.CCX a b c)) next
  | .when _ _ (.measureX _ _ _), _, next => next

theorem translate_end {n : Nat} (i : TInstr n) (t : List (TInstr n)) (k : Nat) :
    k + i.meas + tmplMeas t = k + tmplMeas (i :: t) := by
  rw [tmplMeas, Nat.add_assoc]

/-- The straight-line translation of a template, starting at record cursor `k`. -/
def translate {n : Nat} : (t : List (TInstr n)) → (k : Nat) → Straight n k (k + tmplMeas t)
  | [], k => castFinish (by rfl) (.done : Straight n k k)
  | i :: t, k => i.step k (castFinish (translate_end i t k) (translate t (k + i.meas)))

/-! ## Signed basis states -/

/-- The ECDSAAdd signed basis state as a challenge state vector. -/
noncomputable def signedKet (st : ECDSAAdd.State) : State :=
  (if st.phase then (-1 : ℂ) else 1) • ket st.basis

/-- The magnitude of one X-basis measurement branch. -/
noncomputable def invSqrtTwo : ℂ := (((Real.sqrt 2)⁻¹ : ℝ) : ℂ)

theorem upd_eq_update (s : BasisState) (t : Wire) (b : Bool) :
    s[t ↦ b] = ECDSAAdd.writeBit s t b := by
  funext j
  simp only [upd, ECDSAAdd.writeBit, Function.update_apply]

theorem run_gate_signed (g : Gate) (f : BasisState → BasisState)
    (hg : ∀ s, applyGate g (ket s) = ket (f s)) (st : ECDSAAdd.State) :
    Quantum.run [g] (signedKet st) = signedKet ⟨st.phase, f st.basis⟩ := by
  simp only [signedKet, run_cons, run_nil, map_smul, hg]

theorem run_X_signed (a : Wire) (st : ECDSAAdd.State) :
    Quantum.run [.X a] (signedKet st) =
      signedKet ⟨st.phase, ECDSAAdd.writeBit st.basis a (!st.basis a)⟩ := by
  rw [run_gate_signed (.X a) (fun s => ECDSAAdd.writeBit s a (!s a))]
  intro s
  rw [applyGate_X_ket, upd_eq_update]

theorem run_CX_signed (a b : Wire) (st : ECDSAAdd.State) :
    Quantum.run [.CX a b] (signedKet st) =
      signedKet ⟨st.phase, ECDSAAdd.writeBit st.basis b (st.basis b ^^ st.basis a)⟩ := by
  rw [run_gate_signed (.CX a b) (fun s => ECDSAAdd.writeBit s b (s b ^^ s a))]
  intro s
  rw [applyGate_ket]
  simp only [onKet, upd_eq_update]

theorem run_CCX_signed (a b c : Wire) (st : ECDSAAdd.State) :
    Quantum.run [.CCX a b c] (signedKet st) =
      signedKet ⟨st.phase, ECDSAAdd.writeBit st.basis c (st.basis c ^^ (st.basis a && st.basis b))⟩ := by
  rw [run_gate_signed (.CCX a b c) (fun s => ECDSAAdd.writeBit s c (s c ^^ (s a && s b)))]
  intro s
  rw [applyGate_ket]
  simp only [onKet, upd_eq_update]

theorem sign_mul (x y : Bool) :
    ((if x then (-1 : ℂ) else 1) * if y then (-1 : ℂ) else 1) = if (x ^^ y) then -1 else 1 := by
  cases x <;> cases y <;> norm_num

theorem run_corr_signed (c : ECDSAAdd.Correction) (st : ECDSAAdd.State) :
    Quantum.run (corrCircuit c) (signedKet st) = signedKet (ECDSAAdd.correct [c] st) := by
  obtain ⟨ph, s⟩ := st
  cases c with
  | Z t =>
    simp only [corrCircuit, signedKet, map_smul, run_pauliZ_ket, ECDSAAdd.correct]
    by_cases hb : s t <;> cases ph <;> simp [hb]
  | CZ a b =>
    by_cases h : a = b
    · subst h
      rw [corrCircuit, if_pos rfl]
      simp only [signedKet, map_smul, run_pauliZ_ket, ECDSAAdd.correct, Bool.and_self]
      by_cases hb : s a <;> cases ph <;> simp [hb]
    · rw [corrCircuit, if_neg h]
      simp only [signedKet, map_smul, run_controlledZ_ket a b _ h, ECDSAAdd.correct]
      by_cases ha : s a <;> by_cases hb : s b <;> cases ph <;> simp [ha, hb]

theorem correct_append (c : ECDSAAdd.Correction) (cs : List ECDSAAdd.Correction)
    (st : ECDSAAdd.State) : ECDSAAdd.correct (c :: cs) st =
      ECDSAAdd.correct cs (ECDSAAdd.correct [c] st) := by
  cases c <;> rfl

theorem run_corrs_signed (cs : List ECDSAAdd.Correction) (st : ECDSAAdd.State) :
    Quantum.run (corrsCircuit cs) (signedKet st) = signedKet (ECDSAAdd.correct cs st) := by
  induction cs generalizing st with
  | nil => rfl
  | cons c cs ih =>
    rw [corrsCircuit, List.flatMap_cons, Quantum.run_append, run_corr_signed,
      correct_append c cs st]
    exact ih _

theorem xReset_signed (w : Wire) (v : Bool) (st : ECDSAAdd.State) :
    xResetKraus w v (signedKet st) =
      invSqrtTwo • signedKet ⟨st.phase ^^ (v && st.basis w), ECDSAAdd.writeBit st.basis w false⟩ := by
  simp only [signedKet, map_smul, xResetKraus_ket, xResetCoeff, smul_smul, invSqrtTwo,
    upd_eq_update]
  congr 1
  rw [mul_left_comm, sign_mul]

/-! ## Branch structure -/

theorem recordGates_branch {n k e : Nat} (r : Fin k) (v : Bool) (gs : Circuit)
    (next : Straight n k e) (read : ConstantBit n → Bool) (h : Fin k → Bool)
    (b : InstrumentBranch) (hb : b ∈ ((recordGates r v gs next).instantiate read h).run) :
    ∃ c ∈ (next.instantiate read h).run, b.history = c.history ∧
      ∀ ψ, b.kraus ψ = c.kraus (Quantum.run (if h r = v then gs else []) ψ) := by
  induction gs generalizing b with
  | nil =>
    refine ⟨b, hb, rfl, fun ψ => ?_⟩
    split <;> rfl
  | cons g gs ih =>
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hb
    obtain ⟨c, hc, hh, hk⟩ := ih d hd
    refine ⟨c, hc, hh, fun ψ => ?_⟩
    change d.kraus (Quantum.run (if h r = v then [g] else []) ψ) = _
    rw [hk]
    split <;> rfl

/-- Soundness of the translation on signed basis states. -/
theorem translate_branch {n : Nat} (read : ConstantBit n → Bool) :
    ∀ (t : List (TInstr n)), (∀ i ∈ t, i.Static) →
    ∀ (k : Nat) (h : Fin k → Bool) (b : InstrumentBranch),
      b ∈ ((translate t k).instantiate read h).run →
      ∀ st : ECDSAAdd.State, b.kraus (signedKet st) =
        invSqrtTwo ^ tmplMeas t • signedKet (ECDSAAdd.run (instB read t) b.history st)
  | [], _, k, h, b, hb, st => by
    simp only [translate, instantiate_castFinish, Straight.instantiate, AdaptiveCircuit.run,
      List.mem_singleton] at hb
    subst b
    simp [tmplMeas, instB, ECDSAAdd.run]
  | i :: t, hs, k, h, b, hb, st => by
    have hst : ∀ j ∈ t, j.Static := fun j hj => hs j (List.mem_cons_of_mem _ hj)
    have hi : i.Static := hs i List.mem_cons_self
    have ih := translate_branch read t hst
    cases i with
    | lit i =>
      cases i with
      | X a =>
        simp only [translate, TInstr.step, Straight.instantiate] at hb
        obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hb
        rw [instantiate_castFinish] at hc
        change c.kraus (Quantum.run [.X a] (signedKet st)) = _
        rw [run_X_signed, ih k h c hc]
        simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
          TInstr.instantiate, List.singleton_append, ECDSAAdd.run]
        rfl
      | CX a b' =>
        simp only [translate, TInstr.step, Straight.instantiate] at hb
        obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hb
        rw [instantiate_castFinish] at hc
        change c.kraus (Quantum.run [.CX a b'] (signedKet st)) = _
        rw [run_CX_signed, ih k h c hc]
        simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
          TInstr.instantiate, List.singleton_append, ECDSAAdd.run]
        rfl
      | CCX a b' c' =>
        simp only [translate, TInstr.step, Straight.instantiate] at hb
        obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hb
        rw [instantiate_castFinish] at hc
        change c.kraus (Quantum.run [.CCX a b' c'] (signedKet st)) = _
        rw [run_CCX_signed, ih k h c hc]
        simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
          TInstr.instantiate, List.singleton_append, ECDSAAdd.run]
        rfl
      | measureX w c0 c1 =>
        simp only [translate, TInstr.step, Straight.instantiate, AdaptiveCircuit.run] at hb
        rcases List.mem_append.mp hb with hb | hb
        · obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hb
          obtain ⟨d₁, hd₁, hh₁, hk₁⟩ := recordGates_branch _ _ _ _ read _ d hd
          obtain ⟨d₂, hd₂, hh₂, hk₂⟩ := recordGates_branch _ _ _ _ read _ d₁ hd₁
          rw [instantiate_castFinish] at hd₂
          change d.kraus (xResetKraus w false (signedKet st)) = _
          rw [hk₁, hk₂]
          simp only [Fin.lastCases_last, if_true, if_false, Bool.false_eq_true, run_nil]
          rw [xReset_signed, map_smul, map_smul, run_corrs_signed, ih _ _ d₂ hd₂, smul_smul]
          change _ = _ • signedKet (ECDSAAdd.run (instB read (TInstr.lit (.measureX w c0 c1) :: t))
            (false :: d.history) st)
          rw [hh₁, hh₂]
          simp only [tmplMeas, TInstr.meas, instB, List.flatMap_cons, TInstr.instantiate,
            List.singleton_append, ECDSAAdd.run, ECDSAAdd.measureAndCorrect, List.headD_cons,
            List.tail_cons, Bool.false_and, Bool.xor_false, if_false, Bool.false_eq_true]
          congr 1
          ring
        · obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hb
          obtain ⟨d₁, hd₁, hh₁, hk₁⟩ := recordGates_branch _ _ _ _ read _ d hd
          obtain ⟨d₂, hd₂, hh₂, hk₂⟩ := recordGates_branch _ _ _ _ read _ d₁ hd₁
          rw [instantiate_castFinish] at hd₂
          change d.kraus (xResetKraus w true (signedKet st)) = _
          rw [hk₁, hk₂]
          simp only [Fin.lastCases_last, if_true, Bool.true_eq_false, if_false, run_nil]
          rw [xReset_signed, map_smul, map_smul, run_corrs_signed, ih _ _ d₂ hd₂, smul_smul]
          change _ = _ • signedKet (ECDSAAdd.run (instB read (TInstr.lit (.measureX w c0 c1) :: t))
            (true :: d.history) st)
          rw [hh₁, hh₂]
          simp only [tmplMeas, TInstr.meas, instB, List.flatMap_cons, TInstr.instantiate,
            List.singleton_append, ECDSAAdd.run, ECDSAAdd.measureAndCorrect, List.headD_cons,
            List.tail_cons, Bool.true_and, if_true]
          congr 1
          ring
    | when r v i =>
      cases i with
      | X a =>
        simp only [translate, TInstr.step, Straight.instantiate] at hb
        obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hb
        rw [instantiate_castFinish] at hc
        change c.kraus (Quantum.run (TemplateGate.instantiate read (.whenBit r v (.X a)))
          (signedKet st)) = _
        simp only [TemplateGate.instantiate]
        by_cases hr : read r = v
        · rw [if_pos hr, run_X_signed, ih k h c hc]
          simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
            TInstr.instantiate, if_pos hr, List.singleton_append, ECDSAAdd.run]
          rfl
        · rw [if_neg hr, run_nil, ih k h c hc]
          simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
            TInstr.instantiate, if_neg hr, List.nil_append]
          rfl
      | CX a b' =>
        simp only [translate, TInstr.step, Straight.instantiate] at hb
        obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hb
        rw [instantiate_castFinish] at hc
        change c.kraus (Quantum.run (TemplateGate.instantiate read (.whenBit r v (.CX a b')))
          (signedKet st)) = _
        simp only [TemplateGate.instantiate]
        by_cases hr : read r = v
        · rw [if_pos hr, run_CX_signed, ih k h c hc]
          simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
            TInstr.instantiate, if_pos hr, List.singleton_append, ECDSAAdd.run]
          rfl
        · rw [if_neg hr, run_nil, ih k h c hc]
          simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
            TInstr.instantiate, if_neg hr, List.nil_append]
          rfl
      | CCX a b' c' =>
        simp only [translate, TInstr.step, Straight.instantiate] at hb
        obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hb
        rw [instantiate_castFinish] at hc
        change c.kraus (Quantum.run (TemplateGate.instantiate read (.whenBit r v (.CCX a b' c')))
          (signedKet st)) = _
        simp only [TemplateGate.instantiate]
        by_cases hr : read r = v
        · rw [if_pos hr, run_CCX_signed, ih k h c hc]
          simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
            TInstr.instantiate, if_pos hr, List.singleton_append, ECDSAAdd.run]
          rfl
        · rw [if_neg hr, run_nil, ih k h c hc]
          simp only [tmplMeas, TInstr.meas, Nat.zero_add, instB, List.flatMap_cons,
            TInstr.instantiate, if_neg hr, List.nil_append]
          rfl
      | measureX w c0 c1 => exact hi.elim

end ShorECDLP.Entrant.Bridge

/-! ---------------------------------------------------------------------------
(formerly `Bridge/PointCode.lean`) -/

/-! EDITABLE. The vendored ECDSAAdd curve and point register are the challenge's.

The vendored `ECDSAAdd.Math.BitcoinCurve` defines the same prime, curve, generator and point type
as the protected `ShorECDLP.Math.BitcoinCurve`, so the two point types are definitionally equal,
with the same group law.  The ECDSAAdd point register (finite tag on wire 1, `x` on wires
2..257, `y` on wires 258..513) holds a point exactly when the challenge's little-endian register
`List.range' 1 513` holds its canonical 513-bit code. -/

namespace ShorECDLP.Entrant.Bridge

theorem point_type_eq : ECDSAAdd.Secp256k1.Point = ShorECDLP.Secp256k1.Point := rfl

/-- View a challenge point as a vendored ECDSAAdd point (the identity map). -/
def toB (P : ShorECDLP.Secp256k1.Point) : ECDSAAdd.Secp256k1.Point := P

section
local instance : Fact (Nat.Prime ShorECDLP.p) := ⟨ShorECDLP.Secp256k1.p_prime⟩

theorem toB_add (P Q : ShorECDLP.Secp256k1.Point) : toB (P + Q) = toB P + toB Q := rfl

theorem toB_zero : toB 0 = 0 := rfl

theorem toB_neg (P : ShorECDLP.Secp256k1.Point) : toB (-P) = -toB P := rfl

theorem toB_nsmul (k : Nat) (P : ShorECDLP.Secp256k1.Point) : toB (k • P) = k • toB P := by
  induction k with
  | zero => rfl
  | succ k ih => rw [succ_nsmul, toB_add, ih, succ_nsmul]

theorem toB_G : toB ShorECDLP.Secp256k1.G = ECDSAAdd.Secp256k1.G := rfl
end

/-! ## Registers -/

theorem regValueB_eq (r : List Nat) (st : Nat → Bool) :
    ECDSAAdd.regValue r st = ShorECDLP.regValue r st := by
  induction r with
  | nil => rfl
  | cons w ws ih =>
    simp only [ECDSAAdd.regValue, List.foldr_cons] at ih ⊢
    rw [ih]
    rfl

theorem regValue_append (l₁ l₂ : List Nat) (st : Nat → Bool) :
    ShorECDLP.regValue (l₁ ++ l₂) st =
      ShorECDLP.regValue l₁ st + 2 ^ l₁.length * ShorECDLP.regValue l₂ st := by
  induction l₁ with
  | nil => simp
  | cons w ws ih =>
    simp only [List.cons_append, ShorECDLP.regValue_cons, ih, List.length_cons, Nat.pow_succ]
    ring

theorem regValue_lt (r : List Nat) (st : Nat → Bool) :
    ShorECDLP.regValue r st < 2 ^ r.length := by
  induction r with
  | nil => simp
  | cons w ws ih =>
    rw [ShorECDLP.regValue_cons, List.length_cons, Nat.pow_succ]
    by_cases h : st w <;> simp [h] <;> omega

theorem map_add_range (s n : Nat) : (List.range n).map (· + s) = List.range' s n := by
  rw [List.range'_eq_map_range]
  apply List.map_congr_left
  intro a _
  exact Nat.add_comm a s

/-- The challenge point register in the ECDSAAdd layout. -/
def pointWires : List Nat := List.range' 1 513

theorem pointWires_split :
    pointWires = 1 :: (List.range' 2 256 ++ List.range' 258 256) := by
  rw [pointWires, List.range'_append]
  rfl

theorem holds_point_def (st : Nat → Bool) (R : ECDSAAdd.Secp256k1.Point) :
    ECDSAAdd.Holds.holds st ECDSAAdd.Challenge.point R =
      (match ECDSAAdd.Secp256k1.coordinates R with
        | none => st 1 = false ∧ ECDSAAdd.regValue ((List.range 256).map (· + 2)) st = 0 ∧
            ECDSAAdd.regValue ((List.range 256).map (· + 258)) st = 0
        | some (x, y) => st 1 = true ∧
            ECDSAAdd.regValue ((List.range 256).map (· + 2)) st = x.val ∧
            ECDSAAdd.regValue ((List.range 256).map (· + 258)) st = y.val) := rfl

private theorem bridgeTwo256 : (2 : Nat) ^ 256 =
    115792089237316195423570985008687907853269984665640564039457584007913129639936 := by
  norm_num

set_option exponentiation.threshold 300 in
private theorem bridgeTwo257 : (2 : Nat) ^ 257 =
    231584178474632390847141970017375815706539969331281128078915168015826259279872 := by
  norm_num

private theorem bridgeCoordLt (x : ShorECDLP.Fp) :
    x.val < 115792089237316195423570985008687907853269984665640564039457584007913129639936 := by
  haveI : NeZero ShorECDLP.p := ⟨by norm_num [ShorECDLP.p]⟩
  have h := ZMod.val_lt x
  have hp : ShorECDLP.p < 115792089237316195423570985008687907853269984665640564039457584007913129639936 := by
    norm_num [ShorECDLP.p]
  omega

/-- The ECDSAAdd point predicate is the challenge's canonical point code on wires 1..513. -/
theorem holds_point_iff (st : Nat → Bool) (R : ShorECDLP.Secp256k1.Point) :
    ECDSAAdd.Holds.holds st ECDSAAdd.Challenge.point (toB R) ↔
      ShorECDLP.regValue pointWires st = ShorECDLP.Secp256k1.encodeNat R := by
  rw [holds_point_def, map_add_range, map_add_range, regValueB_eq, regValueB_eq,
    pointWires_split, ShorECDLP.regValue_cons, regValue_append, List.length_range']
  have hX := regValue_lt (List.range' 2 256) st
  have hY := regValue_lt (List.range' 258 256) st
  rw [List.length_range'] at hX hY
  generalize ShorECDLP.regValue (List.range' 2 256) st = X at hX ⊢
  generalize ShorECDLP.regValue (List.range' 258 256) st = Y at hY ⊢
  rw [bridgeTwo256] at hX hY ⊢
  cases R with
  | zero =>
    change (st 1 = false ∧ X = 0 ∧ Y = 0) ↔ _
    change _ ↔ _ = 0
    cases st 1 <;> simp
  | @some x y h =>
    change (st 1 = true ∧ X = x.val ∧ Y = y.val) ↔ _
    rw [ShorECDLP.Secp256k1.encodeNat_some, bridgeTwo257]
    have hx := bridgeCoordLt x
    have hy := bridgeCoordLt y
    cases st 1 <;> simp <;> omega

end ShorECDLP.Entrant.Bridge

/-! ---------------------------------------------------------------------------
(formerly `Bridge/Sound.lean`) -/

/-! EDITABLE. From ECDSAAdd specifications to coherent challenge blocks.

`translate_adds` turns an exact record-independent ECDSAAdd run into the challenge contract
`AddsCoherently`: every one of the `2^M` Kraus branches carries the same coefficient
`(1/√2)^M`.  `run_of_triple` derives that exact run from an ECDSAAdd `Triple` (phase restored,
point updated, workspace clean) plus a support bound, and `run_rename` (vendored) moves the control
wire from 0 to the phase qubit of the addition. -/

namespace ShorECDLP.Entrant.Bridge
open Quantum Challenge NaiveChallenge Secp256k1

local instance : Fact (Nat.Prime ShorECDLP.p) := ⟨ShorECDLP.Secp256k1.p_prime⟩

/-! ## Branch count and coefficients -/

theorem straight_run_length {n s e : Nat} (p : Straight n s e) (read : ConstantBit n → Bool)
    (h : Fin s → Bool) : (p.instantiate read h).run.length = 2 ^ (e - s) := by
  induction p with
  | done => simp [Straight.instantiate, AdaptiveCircuit.run]
  | gate g p ih =>
    simp only [Straight.instantiate, AdaptiveCircuit.run, List.length_map]
    exact ih h
  | recordGate i v g p ih =>
    simp only [Straight.instantiate, AdaptiveCircuit.run, List.length_map]
    exact ih h
  | measure w p ih =>
    simp only [Straight.instantiate, AdaptiveCircuit.run, List.length_append, List.length_map,
      ih]
    have hm := p.cursor_mono
    rw [← two_mul, ← Nat.pow_succ']
    congr 1
    omega

theorem normSq_invSqrtTwo : Complex.normSq invSqrtTwo = 1 / 2 := by
  rw [invSqrtTwo, Complex.normSq_ofReal, ← mul_inv, Real.mul_self_sqrt (by norm_num)]
  norm_num

theorem signedKet_false (s : BasisState) : signedKet ⟨false, s⟩ = ket s := by
  simp [signedKet]

/-- An exact, record-independent ECDSAAdd run gives a coherent block. -/
theorem translate_adds {n : Nat} (t : List (TInstr n)) (read : ConstantBit n → Bool)
    (hs : ∀ i ∈ t, i.Static) (ctrl : Wire) (pointReg work : List Wire) (C : Point)
    (hrun : ∀ (s : BasisState) (R : Point), regValue pointReg s = encodeNat R → Clean work s →
      ∀ m : List Bool, ECDSAAdd.run (instB read t) m ⟨false, s⟩ =
        ⟨false, writeReg pointReg (encode (controlledPointResult (s ctrl) R C)).val s⟩)
    (k : Nat) (h : Fin k → Bool) :
    AddsCoherently ((translate t k).instantiate read h) ctrl pointReg work C := by
  refine ⟨((translate t k).instantiate read h).run.map (fun _ => invSqrtTwo ^ tmplMeas t),
    ?_, ?_⟩
  · rw [List.forall₂_map_right_iff]
    apply List.forall₂_same.mpr
    intro b hb s R hR hc
    rw [← signedKet_false s, translate_branch read t hs k h b hb, hrun s R hR hc,
      signedKet_false]
  · rw [List.map_map]
    have hcf : (Complex.normSq ∘ fun _ : InstrumentBranch => invSqrtTwo ^ tmplMeas t) =
        fun _ => ((1 : ℝ) / 2) ^ tmplMeas t := by
      funext b
      rw [Function.comp_apply, map_pow, normSq_invSqrtTwo]
    rw [hcf, List.map_const', List.sum_replicate, straight_run_length, Nat.add_sub_cancel_left,
      nsmul_eq_mul]
    push_cast
    rw [← mul_pow]
    norm_num

/-! ## Exact runs from ECDSAAdd triples -/

theorem regValue_bits (r : List Wire) (s t : BasisState) (h : regValue r s = regValue r t) :
    ∀ w ∈ r, s w = t w := by
  induction r with
  | nil => simp
  | cons x xs ih =>
    rw [regValue_cons, regValue_cons] at h
    have hx : s x = t x := by
      cases hs : s x <;> cases ht : t x <;> simp [hs, ht] at h ⊢ <;> omega
    have hxs : regValue xs s = regValue xs t := by
      rw [hx] at h
      omega
    intro w hw
    rcases List.mem_cons.mp hw with rfl | hw
    · exact hx
    · exact ih hxs w hw

theorem pointWires_nodup : pointWires.Nodup := List.nodup_range'

theorem pointWires_length : pointWires.length = pointWidth := by
  simp [pointWires, pointWidth]

/-- The vendored ECDSAAdd control wire. -/
def bControl : Wire := 0

/-- The ECDSAAdd contract of a controlled addition of `C`, on workspace `work`. -/
def BSpec (prog : ECDSAAdd.Program) (C : Point) (work : List Wire) : Prop :=
  ∀ (b : Bool) (R : Point), ECDSAAdd.Triple
    (fun st => st bControl = b ∧ ECDSAAdd.Holds.holds st ECDSAAdd.Challenge.point (toB R) ∧
      ∀ w ∈ work, st w = false) prog
    (fun st => st bControl = b ∧
      ECDSAAdd.Holds.holds st ECDSAAdd.Challenge.point (toB (controlledPointResult b R C)) ∧
      ∀ w ∈ work, st w = false)

/-- The ECDSAAdd program touches only the control, the point register and the workspace. -/
def BSupport (prog : ECDSAAdd.Program) (work : List Wire) : Prop :=
  ∀ w ∈ ECDSAAdd.wires prog, w = bControl ∨ w ∈ pointWires ∨ w ∈ work

theorem run_of_triple (prog : ECDSAAdd.Program) (C : Point) (work : List Wire)
    (hspec : BSpec prog C work) (hsupp : BSupport prog work)
    (s : BasisState) (R : Point) (hR : regValue pointWires s = encodeNat R) (hc : Clean work s)
    (m : List Bool) :
    ECDSAAdd.run prog m ⟨false, s⟩ =
      ⟨false, writeReg pointWires (encode (controlledPointResult (s bControl) R C)).val s⟩ := by
  obtain ⟨hph, h0, hpt, hwk⟩ := hspec (s bControl) R ⟨false, s⟩ m
    ⟨rfl, (holds_point_iff s R).mpr hR, hc⟩
  rw [holds_point_iff] at hpt
  apply ECDSAAdd.State.extensionality
  · simpa using hph
  funext w
  dsimp only
  by_cases hw : w ∈ pointWires
  · apply regValue_bits pointWires _ _ _ w hw
    rw [hpt, regValue_writeReg _ pointWires_nodup _ _
      (by rw [pointWires_length]; exact encodeNat_lt _)]
    rfl
  · rw [writeReg_apply_not_mem _ _ _ hw]
    by_cases hp : w ∈ ECDSAAdd.wires prog
    · rcases hsupp w hp with h | h | h
      · rw [h]; exact h0
      · exact (hw h).elim
      · rw [hwk w h, hc w h]
    · exact ECDSAAdd.run_preserves_outside prog m ⟨false, s⟩ w hp

/-! ## Moving the control wire -/

theorem writeReg_mem_congr (P : List Wire) (v : Nat) (s t : BasisState) (w : Wire)
    (hw : w ∈ P) : writeReg P v s w = writeReg P v t w := by
  induction P generalizing v s t with
  | nil => simp at hw
  | cons p ps ih =>
    simp only [writeReg]
    by_cases h : w ∈ ps
    · exact ih _ _ _ h
    · have hwp : w = p := by simpa [h] using hw
      rw [writeReg_apply_not_mem _ _ _ h, writeReg_apply_not_mem _ _ _ h, hwp, upd_same,
        upd_same]

theorem pull_swap (c : Wire) (s : ECDSAAdd.State) :
    ECDSAAdd.pullState (Equiv.swap bControl c) (ECDSAAdd.pullState (Equiv.swap bControl c) s) =
      s := by
  apply ECDSAAdd.State.extensionality
  · rfl
  funext w
  simp [ECDSAAdd.pullState]

theorem run_swap (prog : ECDSAAdd.Program) (c : Wire) (m : List Bool) (s : ECDSAAdd.State) :
    ECDSAAdd.run (ECDSAAdd.renameProgram (Equiv.swap bControl c) prog) m s =
      ECDSAAdd.pullState (Equiv.swap bControl c)
        (ECDSAAdd.run prog m (ECDSAAdd.pullState (Equiv.swap bControl c) s)) := by
  rw [← ECDSAAdd.run_rename _ (Equiv.injective _), pull_swap]

/-- The renamed program is an exact controlled addition with control wire `c`. -/
theorem run_of_triple_swap (prog : ECDSAAdd.Program) (C : Point) (work : List Wire)
    (hspec : BSpec prog C work) (hsupp : BSupport prog work) (c : Wire)
    (hc : c ∉ pointWires) (hcw : c ∉ work) (h0 : bControl ∉ pointWires) (h0w : bControl ∉ work)
    (s : BasisState) (R : Point) (hR : regValue pointWires s = encodeNat R) (hcl : Clean work s)
    (m : List Bool) :
    ECDSAAdd.run (ECDSAAdd.renameProgram (Equiv.swap bControl c) prog) m ⟨false, s⟩ =
      ⟨false, writeReg pointWires (encode (controlledPointResult (s c) R C)).val s⟩ := by
  have fix : ∀ w, w ≠ bControl → w ≠ c → Equiv.swap bControl c w = w :=
    fun w h1 h2 => Equiv.swap_apply_of_ne_of_ne h1 h2
  have fixP : ∀ w ∈ pointWires, Equiv.swap bControl c w = w := fun w hw =>
    fix w (fun h => h0 (h ▸ hw)) (fun h => hc (h ▸ hw))
  have fixW : ∀ w ∈ work, Equiv.swap bControl c w = w := fun w hw =>
    fix w (fun h => h0w (h ▸ hw)) (fun h => hcw (h ▸ hw))
  rw [run_swap]
  have hR' : regValue pointWires (fun q => s (Equiv.swap bControl c q)) = encodeNat R := by
    rw [← hR]
    exact regValue_congr _ _ _ (fun w hw => by simp only [fixP w hw])
  have hcl' : Clean work (fun q => s (Equiv.swap bControl c q)) := fun w hw => by
    simp only [fixW w hw]; exact hcl w hw
  change ECDSAAdd.pullState _ (ECDSAAdd.run prog m ⟨false, fun q => s (Equiv.swap bControl c q)⟩) = _
  rw [run_of_triple prog C work hspec hsupp _ R hR' hcl' m]
  apply ECDSAAdd.State.extensionality
  · rfl
  funext w
  simp only [ECDSAAdd.pullState, Equiv.swap_apply_left]
  by_cases hw : w ∈ pointWires
  · rw [fixP w hw]
    exact writeReg_mem_congr _ _ _ _ w hw
  · have hw' : Equiv.swap bControl c w ∉ pointWires := by
      intro h
      have := fixP _ h
      rw [Equiv.swap_apply_self] at this
      exact hw (this ▸ h)
    rw [writeReg_apply_not_mem _ _ _ hw, writeReg_apply_not_mem _ _ _ hw',
      Equiv.swap_apply_self]

/-! ## Renamed templates -/

theorem instB_rename {n : Nat} (read : ConstantBit n → Bool) (f : Nat → Nat)
    (t : List (TInstr n)) :
    instB read (t.map (TInstr.rename f)) = ECDSAAdd.renameProgram f (instB read t) := by
  induction t with
  | nil => rfl
  | cons i t ih =>
    simp only [instB, List.map_cons, List.flatMap_cons] at ih ⊢
    rw [ih, ECDSAAdd.renameProgram, ECDSAAdd.renameProgram, List.map_append]
    cases i with
    | lit i => rfl
    | when r v i =>
      simp only [TInstr.rename, TInstr.instantiate]
      split <;> rfl

theorem rename_static {n : Nat} (f : Nat → Nat) (t : List (TInstr n))
    (hs : ∀ i ∈ t, i.Static) : ∀ i ∈ t.map (TInstr.rename f), i.Static := by
  intro i hi
  obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hi
  have := hs j hj
  cases j with
  | lit i => cases i <;> trivial
  | when r v i => cases i <;> exact this

theorem tmplMeas_rename {n : Nat} (f : Nat → Nat) (t : List (TInstr n)) :
    tmplMeas (t.map (TInstr.rename f)) = tmplMeas t := by
  induction t with
  | nil => rfl
  | cons i t ih =>
    simp only [List.map_cons, tmplMeas, ih]
    congr 1
    cases i with
    | lit i => cases i <;> rfl
    | when r v i => cases i <;> rfl

/-- One block: the template of a controlled addition of `C`, renamed so that its control is the
phase qubit `c`, translated to a closed straight-line program. -/
def block {n : Nat} (t : List (TInstr n)) (c : Wire) :
    Straight n 0 (0 + tmplMeas (t.map (TInstr.rename (Equiv.swap bControl c)))) :=
  translate (t.map (TInstr.rename (Equiv.swap bControl c))) 0

/-- A block satisfies the per-addition coherent contract. -/
theorem block_adds {n : Nat} (t : List (TInstr n)) (read : ConstantBit n → Bool)
    (hs : ∀ i ∈ t, i.Static) (C : Point) (work : List Wire)
    (hspec : BSpec (instB read t) C work) (hsupp : BSupport (instB read t) work) (c : Wire)
    (hc : c ∉ pointWires) (hcw : c ∉ work) (h0 : bControl ∉ pointWires) (h0w : bControl ∉ work) :
    AddsCoherently ((block t c).instantiate read Fin.elim0) c pointWires work C := by
  apply translate_adds _ read (rename_static _ t hs) c pointWires work C
  intro s R hR hcl m
  rw [instB_rename]
  exact run_of_triple_swap _ C work hspec hsupp c hc hcw h0 h0w s R hR hcl m

end ShorECDLP.Entrant.Bridge

/-! ---------------------------------------------------------------------------
(formerly `Bridge/Resources.lean`) -/

/-! EDITABLE. Static resources of translated templates.

Every count is a template-level (slot) count, independent of the table: switched-off
instructions still occupy their slots, as in the challenge's static T bound.

* T model: `straightT (translate t k) = 7 * tmplToffoli t` (corrections are Clifford);
* records: `tmplMeas t`, the number of unswitched measurements;
* gate slots: `tmplSlots t` (one per gate, three per correction);
* wires: contained in `tmplWires t`;
* well-formedness: from the vendored ECDSAAdd `instructionValid` of every template instruction. -/

namespace ShorECDLP.Entrant.Bridge
open Quantum Challenge NaiveChallenge

def TInstr.toffoli {n : Nat} : TInstr n → Nat
  | .lit (.CCX _ _ _) => 1
  | .when _ _ (.CCX _ _ _) => 1
  | _ => 0

def tmplToffoli {n : Nat} (t : List (TInstr n)) : Nat := (t.map TInstr.toffoli).sum

def corrsSlots (cs : List ECDSAAdd.Correction) : Nat := 3 * cs.length

def TInstr.slots {n : Nat} : TInstr n → Nat
  | .lit (.measureX _ c0 c1) => corrsSlots c0 + corrsSlots c1
  | .when _ _ (.measureX _ _ _) => 0
  | _ => 1

def tmplSlots {n : Nat} (t : List (TInstr n)) : Nat := (t.map TInstr.slots).sum

def corrWires : ECDSAAdd.Correction → List Wire
  | .Z a => [a]
  | .CZ a b => [a, b]

def instrWires : ECDSAAdd.Instr → List Wire
  | .X a => [a]
  | .CX a b => [a, b]
  | .CCX a b c => [a, b, c]
  | .measureX w c0 c1 => w :: (c0.flatMap corrWires ++ c1.flatMap corrWires)

def tmplWires {n : Nat} (t : List (TInstr n)) : List Wire := t.flatMap fun i => instrWires i.instr

/-! ## Append and literal lemmas -/

theorem tmplMeas_append {n : Nat} (a b : List (TInstr n)) :
    tmplMeas (a ++ b) = tmplMeas a + tmplMeas b := by
  induction a with
  | nil => simp [tmplMeas]
  | cons i a ih => simp only [List.cons_append, tmplMeas, ih, Nat.add_assoc]

theorem tmplToffoli_append {n : Nat} (a b : List (TInstr n)) :
    tmplToffoli (a ++ b) = tmplToffoli a + tmplToffoli b := by
  simp [tmplToffoli]

theorem tmplSlots_append {n : Nat} (a b : List (TInstr n)) :
    tmplSlots (a ++ b) = tmplSlots a + tmplSlots b := by
  simp [tmplSlots]

theorem tmplWires_append {n : Nat} (a b : List (TInstr n)) :
    tmplWires (a ++ b) = tmplWires a ++ tmplWires b := by
  simp [tmplWires]

theorem tmplMeas_lit {n : Nat} (p : ECDSAAdd.Program) :
    tmplMeas (p.map (TInstr.lit (n := n))) = ECDSAAdd.measurementCount p := by
  induction p with
  | nil => rfl
  | cons i p ih =>
    cases i <;> simp only [List.map_cons, tmplMeas, TInstr.meas, ECDSAAdd.measurementCount, ih,
      Nat.zero_add]

theorem tmplToffoli_lit {n : Nat} (p : ECDSAAdd.Program) :
    tmplToffoli (p.map (TInstr.lit (n := n))) = ECDSAAdd.toffoliCount p := by
  induction p with
  | nil => rfl
  | cons i p ih =>
    simp only [tmplToffoli, List.map_cons, List.map_map, List.sum_cons] at ih ⊢
    cases i <;> simp only [TInstr.toffoli, ECDSAAdd.toffoliCount, ih, Nat.zero_add]

theorem instB_lit {n : Nat} (read : ConstantBit n → Bool) (p : ECDSAAdd.Program) :
    instB read (p.map (TInstr.lit (n := n))) = p := by
  induction p with
  | nil => rfl
  | cons i p ih =>
    simp only [instB, List.map_cons, List.flatMap_cons, TInstr.instantiate] at ih ⊢
    rw [ih]
    rfl

theorem instB_append {n : Nat} (read : ConstantBit n → Bool) (a b : List (TInstr n)) :
    instB read (a ++ b) = instB read a ++ instB read b := by
  simp [instB]

theorem static_lit {n : Nat} (p : ECDSAAdd.Program) : ∀ i ∈ p.map (TInstr.lit (n := n)), i.Static := by
  intro i hi
  obtain ⟨j, _, rfl⟩ := List.mem_map.mp hi
  cases j <;> trivial

/-! ## Translation counts -/

theorem straightT_recordGates {n k e : Nat} (r : Fin k) (v : Bool) (gs : Circuit)
    (next : Straight n k e) :
    straightT (recordGates r v gs next) = tCount gs + straightT next := by
  induction gs with
  | nil => simp [recordGates, tCount]
  | cons g gs ih => simp only [recordGates, straightT, ih, tCount_cons]; omega

theorem tCount_corrs (cs : List ECDSAAdd.Correction) : tCount (corrsCircuit cs) = 0 := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    rw [corrsCircuit, List.flatMap_cons, tCount_append]
    rw [corrsCircuit] at ih
    rw [ih]
    cases c with
    | Z a => rfl
    | CZ a b => simp only [corrCircuit]; split <;> rfl

theorem translate_straightT {n : Nat} :
    ∀ (t : List (TInstr n)) (k : Nat), straightT (translate t k) = 7 * tmplToffoli t
  | [], k => by simp [translate, tmplToffoli, straightT]
  | i :: t, k => by
    have ih := translate_straightT t (k + i.meas)
    simp only [tmplToffoli, List.map_cons, List.sum_cons] at ih ⊢
    rw [Nat.mul_add, ← ih]
    cases i with
    | lit i =>
      cases i <;> simp [translate, TInstr.step, straightT, straightT_recordGates, tCount_corrs,
        TInstr.toffoli, slotGate, tCost]
    | when r v i =>
      cases i <;> simp [translate, TInstr.step, straightT, TInstr.toffoli, slotGate, tCost]

theorem gateSlots_recordGates {n k e : Nat} (r : Fin k) (v : Bool) (gs : Circuit)
    (next : Straight n k e) :
    (recordGates r v gs next).gateSlots = gs.length + next.gateSlots := by
  induction gs with
  | nil => simp [recordGates]
  | cons g gs ih => simp only [recordGates, Straight.gateSlots, ih, List.length_cons]; omega

theorem corrsCircuit_length (cs : List ECDSAAdd.Correction) :
    (corrsCircuit cs).length = corrsSlots cs := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    rw [corrsCircuit, List.flatMap_cons, List.length_append]
    rw [corrsCircuit] at ih
    rw [ih, corrsSlots, corrsSlots, List.length_cons]
    cases c with
    | Z a => simp [corrCircuit, pauliZ]; omega
    | CZ a b =>
      simp only [corrCircuit]
      split <;> simp [pauliZ, controlledZ] <;> omega

theorem translate_gateSlots {n : Nat} :
    ∀ (t : List (TInstr n)) (k : Nat), (translate t k).gateSlots = tmplSlots t
  | [], k => by simp [translate, tmplSlots, Straight.gateSlots]
  | i :: t, k => by
    have ih := translate_gateSlots t (k + i.meas)
    simp only [tmplSlots, List.map_cons, List.sum_cons] at ih ⊢
    rw [← ih]
    cases i with
    | lit i =>
      cases i <;> simp [translate, TInstr.step, Straight.gateSlots, gateSlots_recordGates,
        corrsCircuit_length, TInstr.slots]
      all_goals omega
    | when r v i =>
      cases i <;> simp [translate, TInstr.step, Straight.gateSlots, TInstr.slots]

/-! ## Wires -/

theorem straightWires_recordGates {n k e : Nat} (r : Fin k) (v : Bool) (gs : Circuit)
    (next : Straight n k e) :
    ShorECDLP.NaiveChallenge.straightWires (recordGates r v gs next) = circuitWires gs ++ ShorECDLP.NaiveChallenge.straightWires next := by
  induction gs with
  | nil => simp [recordGates, circuitWires]
  | cons g gs ih =>
    simp only [recordGates, ShorECDLP.NaiveChallenge.straightWires, ih, circuitWires, List.flatMap_cons, List.append_assoc]

theorem corrsCircuit_wires (cs : List ECDSAAdd.Correction) :
    ∀ w ∈ circuitWires (corrsCircuit cs), w ∈ cs.flatMap corrWires := by
  intro w hw
  simp only [circuitWires, corrsCircuit, List.mem_flatMap] at hw ⊢
  obtain ⟨g, ⟨c, hc, hg⟩, hw⟩ := hw
  refine ⟨c, hc, ?_⟩
  cases c with
  | Z a =>
    simp only [corrCircuit, pauliZ, List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl <;> simpa [gateWires, corrWires] using hw
  | CZ a b =>
    simp only [corrCircuit] at hg
    split at hg
    · simp only [pauliZ, List.mem_cons, List.not_mem_nil, or_false] at hg
      rcases hg with rfl | rfl | rfl <;> simp_all [gateWires, corrWires]
    · simp only [controlledZ, List.mem_cons, List.not_mem_nil, or_false] at hg
      rcases hg with rfl | rfl | rfl <;> simp_all [gateWires, corrWires]

theorem translate_wires {n : Nat} :
    ∀ (t : List (TInstr n)) (k : Nat), ∀ w ∈ ShorECDLP.NaiveChallenge.straightWires (translate t k), w ∈ tmplWires t
  | [], k => by simp [translate, straightWires_castFinish, ShorECDLP.NaiveChallenge.straightWires]
  | i :: t, k => by
    have ih := translate_wires t (k + i.meas)
    intro w hw
    simp only [tmplWires, List.flatMap_cons, List.mem_append] at ih ⊢
    cases i with
    | lit i =>
      cases i with
      | measureX x c0 c1 =>
        simp only [translate, TInstr.step, ShorECDLP.NaiveChallenge.straightWires, straightWires_recordGates,
          straightWires_castFinish, List.mem_cons, List.mem_append] at hw
        rcases hw with rfl | hw | hw | hw
        · left; simp [TInstr.instr, instrWires]
        · left; simp only [TInstr.instr, instrWires, List.mem_cons, List.mem_append]
          exact Or.inr (Or.inl (corrsCircuit_wires c0 w hw))
        · left; simp only [TInstr.instr, instrWires, List.mem_cons, List.mem_append]
          exact Or.inr (Or.inr (corrsCircuit_wires c1 w hw))
        · exact Or.inr (ih w hw)
      | _ =>
        simp only [translate, TInstr.step, ShorECDLP.NaiveChallenge.straightWires, straightWires_castFinish, slotGate,
          gateWires, List.mem_cons, List.mem_append, List.not_mem_nil, or_false] at hw
        rcases hw with hw | hw
        all_goals first
          | exact Or.inr (ih w hw)
          | (left; simp only [TInstr.instr, instrWires, List.mem_cons, List.not_mem_nil]; tauto)
    | when r v i =>
      cases i with
      | measureX x c0 c1 =>
        simp only [translate, TInstr.step, straightWires_castFinish] at hw
        exact Or.inr (ih w hw)
      | _ =>
        simp only [translate, TInstr.step, ShorECDLP.NaiveChallenge.straightWires, straightWires_castFinish, slotGate,
          gateWires, List.mem_cons, List.mem_append, List.not_mem_nil, or_false] at hw
        rcases hw with hw | hw
        all_goals first
          | exact Or.inr (ih w hw)
          | (left; simp only [TInstr.instr, instrWires, List.mem_cons, List.not_mem_nil]; tauto)

theorem tmplWires_rename {n : Nat} (f : Nat → Nat) (t : List (TInstr n)) :
    tmplWires (t.map (TInstr.rename f)) = (tmplWires t).map f := by
  have hc : ∀ cs : List ECDSAAdd.Correction,
      (cs.map (ECDSAAdd.renameCorrection f)).flatMap corrWires = (cs.flatMap corrWires).map f := by
    intro cs
    induction cs with
    | nil => rfl
    | cons c cs ih =>
      simp only [List.map_cons, List.flatMap_cons, List.map_append, ih]
      cases c <;> rfl
  have hi : ∀ i : ECDSAAdd.Instr, instrWires (ECDSAAdd.renameInstr f i) = (instrWires i).map f := by
    intro i
    cases i with
    | measureX w c0 c1 =>
      simp only [ECDSAAdd.renameInstr, instrWires, hc, List.map_cons, List.map_append]
    | _ => rfl
  induction t with
  | nil => rfl
  | cons i t ih =>
    simp only [tmplWires, List.map_cons, List.flatMap_cons, List.map_append] at ih ⊢
    rw [ih]
    cases i <;> simp only [TInstr.rename, TInstr.instr, hi]

/-- Template wires bound the instantiated ECDSAAdd program's wires. -/
theorem wires_instB_sub {n : Nat} (read : ConstantBit n → Bool) (t : List (TInstr n)) :
    ∀ w ∈ ECDSAAdd.wires (instB read t), w ∈ tmplWires t := by
  have hc : ∀ cs w, w ∈ ECDSAAdd.correctionWires cs → w ∈ cs.flatMap corrWires := by
    intro cs w hw
    induction cs with
    | nil => simp [ECDSAAdd.correctionWires] at hw
    | cons c cs ih =>
      cases c <;> simp only [ECDSAAdd.correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at hw <;> simp only [List.flatMap_cons, corrWires, List.mem_append,
        List.mem_cons, List.not_mem_nil] <;> tauto
  have hi : ∀ i w, w ∈ ECDSAAdd.Instr.wires i → w ∈ instrWires i := by
    intro i w hw
    cases i with
    | measureX x c0 c1 =>
      simp only [ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_singleton] at hw
      simp only [instrWires, List.mem_cons, List.mem_append]
      rcases hw with (rfl | h) | h
      · left; rfl
      · exact Or.inr (Or.inl (hc c0 w h))
      · exact Or.inr (Or.inr (hc c1 w h))
    | _ => simp_all [ECDSAAdd.Instr.wires, instrWires]
  induction t with
  | nil => simp [instB, ECDSAAdd.wires]
  | cons i t ih =>
    intro w hw
    rw [instB, List.flatMap_cons, ECDSAAdd.wires_append, Finset.mem_union] at hw
    simp only [tmplWires, List.flatMap_cons, List.mem_append]
    rcases hw with hw | hw
    · left
      cases i with
      | lit i =>
        simp only [TInstr.instantiate, ECDSAAdd.wires, Finset.union_empty] at hw
        exact hi i w hw
      | when r v i =>
        simp only [TInstr.instantiate] at hw
        split at hw
        · simp only [ECDSAAdd.wires, Finset.union_empty] at hw
          exact hi i w hw
        · simp [ECDSAAdd.wires] at hw
    · exact Or.inr (ih w hw)

/-! ## Well-formedness -/

theorem recordGates_wellFormed {n k e : Nat} (r : Fin k) (v : Bool) (gs : Circuit)
    (next : Straight n k e) (hg : CircuitWellFormed gs) (hn : next.WellFormed) :
    (recordGates r v gs next).WellFormed := by
  induction gs with
  | nil => exact hn
  | cons g gs ih =>
    exact ⟨hg g List.mem_cons_self, ih (fun x hx => hg x (List.mem_cons_of_mem _ hx))⟩

theorem corrsCircuit_wellFormed (cs : List ECDSAAdd.Correction) :
    CircuitWellFormed (corrsCircuit cs) := by
  intro g hg
  simp only [corrsCircuit, List.mem_flatMap] at hg
  obtain ⟨c, _, hg⟩ := hg
  cases c with
  | Z a => exact pauliZ_wellFormed a g hg
  | CZ a b =>
    simp only [corrCircuit] at hg
    split at hg
    · exact pauliZ_wellFormed a g hg
    · exact controlledZ_wellFormed a b (by assumption) g hg

theorem translate_wellFormed {n : Nat} :
    ∀ (t : List (TInstr n)) (k : Nat),
      (∀ i ∈ t, ECDSAAdd.Challenge.instructionValid i.instr) → (translate t k).WellFormed
  | [], k, _ => by simp [translate, Straight.WellFormed]
  | i :: t, k, hv => by
    have ih := translate_wellFormed t (k + i.meas) (fun j hj => hv j (List.mem_cons_of_mem _ hj))
    have hi := hv i List.mem_cons_self
    cases i with
    | lit i =>
      cases i with
      | measureX x c0 c1 =>
        simp only [translate, TInstr.step, Straight.WellFormed]
        exact recordGates_wellFormed _ _ _ _ (corrsCircuit_wellFormed c0)
          (recordGates_wellFormed _ _ _ _ (corrsCircuit_wellFormed c1)
            (by rw [wellFormed_castFinish]; exact ih))
      | _ =>
        simp only [translate, TInstr.step, Straight.WellFormed, wellFormed_castFinish]
        exact ⟨hi, ih⟩
    | when r v i =>
      cases i with
      | measureX x c0 c1 =>
        simp only [translate, TInstr.step, wellFormed_castFinish]
        exact ih
      | _ =>
        simp only [translate, TInstr.step, Straight.WellFormed, wellFormed_castFinish]
        exact ⟨hi, ih⟩

theorem rename_valid {n : Nat} (f : Nat → Nat) (hf : Function.Injective f) (t : List (TInstr n))
    (hv : ∀ i ∈ t, ECDSAAdd.Challenge.instructionValid i.instr) :
    ∀ i ∈ t.map (TInstr.rename f), ECDSAAdd.Challenge.instructionValid i.instr := by
  have hc : ∀ cs : List ECDSAAdd.Correction, (∀ c ∈ cs, ECDSAAdd.Challenge.correctionValid c) →
      ∀ c ∈ cs.map (ECDSAAdd.renameCorrection f), ECDSAAdd.Challenge.correctionValid c := by
    intro cs h c hc
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    have := h d hd
    cases d with
    | Z a => trivial
    | CZ a b => exact fun e => this (hf e)
  have hi : ∀ i, ECDSAAdd.Challenge.instructionValid i →
      ECDSAAdd.Challenge.instructionValid (ECDSAAdd.renameInstr f i) := by
    intro i h
    cases i with
    | X a => trivial
    | CX a b => exact fun e => h (hf e)
    | CCX a b c =>
      obtain ⟨h1, h2, h3⟩ := h
      exact ⟨fun e => h1 (hf e), fun e => h2 (hf e), fun e => h3 (hf e)⟩
    | measureX w c0 c1 => exact ⟨hc c0 h.1, hc c1 h.2⟩
  intro i hmem
  obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hmem
  have := hv j hj
  cases j <;> exact hi _ this

theorem tmplToffoli_rename {n : Nat} (f : Nat → Nat) (t : List (TInstr n)) :
    tmplToffoli (t.map (TInstr.rename f)) = tmplToffoli t := by
  simp only [tmplToffoli, List.map_map]
  congr 1
  apply List.map_congr_left
  intro i _
  cases i with
  | lit i => cases i <;> rfl
  | when r v i => cases i <;> rfl

theorem tmplSlots_rename {n : Nat} (f : Nat → Nat) (t : List (TInstr n)) :
    tmplSlots (t.map (TInstr.rename f)) = tmplSlots t := by
  simp only [tmplSlots, List.map_map]
  congr 1
  apply List.map_congr_left
  intro i _
  cases i with
  | lit i => cases i <;> simp [TInstr.rename, ECDSAAdd.renameInstr, TInstr.slots, corrsSlots]
  | when r v i => cases i <;> rfl

end ShorECDLP.Entrant.Bridge

/-! ---------------------------------------------------------------------------
(formerly `Bridge/AdaptiveTrial.lean`) -/

/-! EDITABLE. One observed trial whose oracle is a chain of adaptive point additions.

The straight-line program is

```text
hadamards(A ++ B) ; block₀ ; … ; block₅₂₅ ; iqft A ; iqft B ; observe(A ++ B)
```

where every block is a closed straight-line program (it reads only its own measurement records)
satisfying `AddsCoherently` for its control wire and table point.  The internal records of the
blocks come first in every history; the 526 phase bits follow them.  Coherent refinement
(`CoherentlyImplementsOn.terminalMass`) replaces the chain of blocks by the protected Naive
`ecdlpOracle` on an ideal workspace that the program never touches, and the single-trial window
bound of the unitary pipeline (`success_of_window_mass`, `window_mass_sharp`) then applies
unchanged, read through the protected `nearestPair` decoder at shifted record positions. -/

namespace ShorECDLP.Entrant.Bridge
open Quantum Secp256k1 Challenge NaiveChallenge
open ShorECDLP.Quantum.OrderFinding ShorECDLP.Quantum.PhaseEstimation
noncomputable section

local instance : Fact (Nat.Prime p) := ⟨p_prime⟩

/-! ## Instruments -/

theorem filter_seq_suffix (I J : Instrument) (K : Nat)
    (hI : ∀ b ∈ I, b.history.length = K) (q : List Bool → Bool) :
    (I.seq J).filter (fun b => q (b.history.drop K)) = I.seq (J.filter (fun b => q b.history)) := by
  unfold Instrument.seq
  rw [List.filter_flatMap]
  apply List.flatMap_congr
  intro b hb
  rw [List.filter_map]
  congr 1
  apply List.filter_congr
  intro c _
  simp only [Function.comp_apply, InstrumentBranch.seq, List.drop_left' (hI b hb)]

theorem filter_single_seq (k : State →ₗ[ℂ] State) (J : Instrument) (q : List Bool → Bool) :
    (Instrument.seq [⟨[], k⟩] J).filter (fun b => q b.history) =
      Instrument.seq [⟨[], k⟩] (J.filter (fun b => q b.history)) := by
  have h := filter_seq_suffix [⟨[], k⟩] J 0 (by simp) q
  simpa only [List.drop_zero] using h

theorem bornMass_single_seq (k : State →ₗ[ℂ] State) (J : Instrument) (ψ : State) :
    Instrument.bornMass (Instrument.seq [⟨[], k⟩] J) ψ = J.bornMass (k ψ) := by
  simp only [Instrument.seq, List.flatMap_cons, List.flatMap_nil, List.append_nil,
    Instrument.bornMass, List.map_map]
  rfl

theorem run_unitary_seq (c : Circuit) (a : AdaptiveCircuit) :
    (AdaptiveCircuit.unitary c a).run = Instrument.seq [⟨[], Quantum.run c⟩] a.run := by
  rw [show AdaptiveCircuit.unitary c a = (AdaptiveCircuit.unitary c .done).seq a from rfl,
    AdaptiveCircuit.run_seq, AdaptiveCircuit.run_unitary_done]

theorem gateNative_literal_run {n : Nat} (read : ConstantBit n → Bool) (c : Circuit) :
    (gateNative read (c.map TemplateGate.literal)).run = [⟨[], Quantum.run c⟩] := by
  rw [← constantGateProgram_instantiate _ 0 read Fin.elim0, constantGateProgram_run,
    literalGates_instantiate, AdaptiveCircuit.run_unitary_done]

/-! ## The straight-line trial -/

/-- Hadamards, the closed blocks, both inverse QFTs, and computational readout of `A ++ B`. -/
def trialProgram {n M : Nat} (regA regB : List Wire) (anc : Wire)
    (blocks : List (Straight n 0 M)) :
    Straight n 0 (0 + blocks.length * M + (regA ++ regB).length) :=
  (constantGateProgram ((hadamards (regA ++ regB)).map TemplateGate.literal) 0).append
    ((chain blocks 0).append
      ((constantGateProgram ((iqft regA anc ++ iqft regB anc).map TemplateGate.literal)
          (0 + blocks.length * M)).append
        (observeWires (regA ++ regB) (0 + blocks.length * M))))

theorem trialProgram_instantiate {n M : Nat} (regA regB : List Wire) (anc : Wire)
    (blocks : List (Straight n 0 M)) (read : ConstantBit n → Bool) :
    (trialProgram regA regB anc blocks).instantiate read Fin.elim0 =
      (gateNative read ((hadamards (regA ++ regB)).map TemplateGate.literal)).seq
        ((seqAll (blocks.map fun b => b.instantiate read Fin.elim0)).seq
          ((gateNative read ((iqft regA anc ++ iqft regB anc).map TemplateGate.literal)).seq
            (zObserve (regA ++ regB)))) := by
  have hq : ∀ h, ((constantGateProgram ((iqft regA anc ++ iqft regB anc).map TemplateGate.literal)
        (0 + blocks.length * M)).append
        (observeWires (regA ++ regB) (0 + blocks.length * M))).instantiate read h =
      (gateNative read ((iqft regA anc ++ iqft regB anc).map TemplateGate.literal)).seq
        (zObserve (regA ++ regB)) := by
    intro h
    rw [constantGateProgram_append_instantiate, constantGateProgram_instantiate,
      observeWires_instantiate]
  rw [trialProgram, constantGateProgram_append_instantiate, constantGateProgram_instantiate,
    straight_append_constant _ _ read _ hq Fin.elim0, chain_instantiate]

theorem trialProgram_run {n M : Nat} (regA regB : List Wire) (anc : Wire)
    (blocks : List (Straight n 0 M)) (read : ConstantBit n → Bool) :
    ((trialProgram regA regB anc blocks).instantiate read Fin.elim0).run =
      Instrument.seq [⟨[], Quantum.run (hadamards (regA ++ regB))⟩]
        (Instrument.seq (seqAll (blocks.map fun b => b.instantiate read Fin.elim0)).run
          (observedTrial (iqft regA anc ++ iqft regB anc) regA regB).run) := by
  rw [trialProgram_instantiate, AdaptiveCircuit.run_seq, AdaptiveCircuit.run_seq,
    AdaptiveCircuit.run_seq, gateNative_literal_run, gateNative_literal_run]
  rw [observedTrial, run_unitary_seq]

theorem seqAll_history_length {n M : Nat} (blocks : List (Straight n 0 M))
    (read : ConstantBit n → Bool) (b : InstrumentBranch)
    (hb : b ∈ (seqAll (blocks.map fun b => b.instantiate read Fin.elim0)).run) :
    b.history.length = blocks.length * M := by
  rw [← chain_instantiate blocks 0 read Fin.elim0] at hb
  have h := straight_history_length _ read Fin.elim0 b hb
  simpa using h

/-- The record mass of a suffix event equals the mass of the ideal unitary trial. -/
theorem trialProgram_mass {n M : Nat} (regA regB : List Wire) (anc : Wire)
    (blocks : List (Straight n 0 M)) (read : ConstantBit n → Bool)
    (ideal : State →ₗ[ℂ] State) (Valid : BasisState → Prop)
    (hcoh : CoherentlyImplementsOn (seqAll (blocks.map fun b => b.instantiate read Fin.elim0))
      ideal Valid)
    (ψ : State) (hψ : SupportedOn Valid (Quantum.run (hadamards (regA ++ regB)) ψ))
    (q : List Bool → Bool) :
    Instrument.bornMass (((trialProgram regA regB anc blocks).instantiate read Fin.elim0).run.filter
        (fun b => q (b.history.drop (blocks.length * M)))) ψ =
      recordMass (observedTrial (iqft regA anc ++ iqft regB anc) regA regB).run q
        (ideal (Quantum.run (hadamards (regA ++ regB)) ψ)) := by
  rw [trialProgram_run, filter_single_seq _ _ (fun h => q (h.drop (blocks.length * M))),
    bornMass_single_seq, filter_seq_suffix _ _ _ (seqAll_history_length blocks read) q,
    hcoh.terminalMass hψ, recordMass_filter]

/-! ## Layout -/

/-- Wire disjointness for the adaptive trial; `idealStart` places the Naive ideal workspace. -/
structure TrialLayout (regA regB pointReg work : List Wire) (anc idealStart : Wire) : Prop where
  a_length : regA.length = 263
  b_length : regB.length = 263
  point_length : pointReg.length = pointWidth
  nodup : (regA ++ regB ++ pointReg ++ scalarMulWork idealStart).Nodup
  anc_fresh : anc ∉ regA ++ regB ++ pointReg ++ scalarMulWork idealStart
  work_point : ∀ w ∈ work, w ∉ pointReg
  work_phase : ∀ w ∈ work, w ∉ regA ++ regB

theorem TrialLayout.block {regA regB pointReg work : List Wire} {anc idealStart : Wire}
    (h : TrialLayout regA regB pointReg work anc idealStart) (c : Wire) (hc : c ∈ regA ++ regB) :
    BlockLayout c pointReg work idealStart := by
  have hn := h.nodup
  rw [List.append_assoc (regA ++ regB) pointReg (scalarMulWork idealStart)] at hn
  obtain ⟨_, hrest, hdis⟩ := List.nodup_append.mp hn
  refine ⟨h.point_length, ?_, h.work_point⟩
  rw [List.append_assoc]
  refine List.nodup_append.mpr ⟨List.nodup_singleton c, hrest, ?_⟩
  intro a ha b hb
  rw [List.mem_singleton] at ha
  subst a
  exact hdis c hc b hb

theorem TrialLayout.phase_fresh {regA regB pointReg work : List Wire} {anc idealStart : Wire}
    (h : TrialLayout regA regB pointReg work anc idealStart) (w : Wire)
    (hw : w ∈ pointReg ++ work ++ controlledPointAddWork idealStart) : w ∉ regA ++ regB := by
  intro hab
  have hn := h.nodup
  rw [List.append_assoc (regA ++ regB) pointReg (scalarMulWork idealStart)] at hn
  obtain ⟨_, _, hdis⟩ := List.nodup_append.mp hn
  rcases List.mem_append.mp hw with hw | hw
  · rcases List.mem_append.mp hw with hw | hw
    · exact hdis w hab w (List.mem_append_left _ hw) rfl
    · exact h.work_phase w hw hab
  · exact hdis w hab w (List.mem_append_right _ hw) rfl

/-- Hadamards on the phase registers keep a valid input valid. -/
theorem hadamards_supported {regA regB pointReg work : List Wire} {anc idealStart : Wire}
    (h : TrialLayout regA regB pointReg work anc idealStart) (s : BasisState)
    (hs : ValidN pointReg work (controlledPointAddWork idealStart) s) :
    SupportedOn (ValidN pointReg work (controlledPointAddWork idealStart))
      (Quantum.run (hadamards (regA ++ regB)) (ket s)) := by
  have frame : ∀ w, w ∉ regA ++ regB →
      SupportedOn (fun t => t w = s w) (Quantum.run (hadamards (regA ++ regB)) (ket s)) := by
    intro w hw
    have hwires : w ∉ (AdaptiveCircuit.unitary (hadamards (regA ++ regB)) .done).wires := by
      simpa [AdaptiveCircuit.wires, circuitWires, hadamards, gateWires] using hw
    exact AdaptiveCircuit.branch_frame _ w (s w) hwires ⟨[], Quantum.run (hadamards (regA ++ regB))⟩
      (by rw [AdaptiveCircuit.run_unitary_done]; exact List.mem_singleton_self _) (ket s)
      (supportedOn_ket _ _ rfl)
  intro t ht
  have hag : ∀ w ∈ pointReg ++ work ++ controlledPointAddWork idealStart, t w = s w :=
    fun w hw => frame w (h.phase_fresh w hw) t ht
  obtain ⟨⟨R, hR⟩, hw, hi⟩ := hs
  refine ⟨⟨R, ?_⟩, ?_, ?_⟩
  · rw [regValue_congr pointReg t s (fun w hw' => hag w (by simp [hw'])), hR]
  · intro w hw'
    rw [hag w (by simp [hw']), hw w hw']
  · intro w hw'
    rw [hag w (by simp [hw']), hi w hw']

/-! ## The ideal oracle -/

theorem scalarMulCore_append (pointReg : List Wire) (idealStart : Wire) :
    ∀ (c₁ : List Wire) (p₁ : List Point) (c₂ : List Wire) (p₂ : List Point),
      c₁.length = p₁.length →
      scalarMulCore pointReg idealStart (c₁ ++ c₂) (p₁ ++ p₂) =
        scalarMulCore pointReg idealStart c₁ p₁ ++ scalarMulCore pointReg idealStart c₂ p₂
  | [], [], _, _, _ => by simp [scalarMulCore]
  | c :: cs, P :: Ps, c₂, p₂, h => by
    simp only [List.cons_append, scalarMulCore, List.append_assoc]
    rw [scalarMulCore_append pointReg idealStart cs Ps c₂ p₂ (by simpa using h)]
  | [], _ :: _, _, _, h => by simp at h
  | _ :: _, [], _, _, h => by simp at h

theorem ecdlpOracle_eq_core (regA regB pointReg : List Wire) (idealStart : Wire) (P Q : Point) :
    ecdlpOracle regA regB pointReg idealStart P Q =
      scalarMulCore pointReg idealStart (regA ++ regB)
        (Precompute.doublingTable regA.length P ++ Precompute.doublingTable regB.length Q) := by
  rw [scalarMulCore_append _ _ _ _ _ _ (Precompute.doublingTable_length _ _).symm]
  rfl

/-! ## Decoder at shifted positions -/

def paramsB : DecoderParams := ⟨263, 263, by omega, by omega, by omega, by omega⟩

/-- The phase bits follow the `K` internal records. -/
def positionsB (K : Nat) : TrialPositions paramsB where
  left := ⟨(List.range' K 263).toArray, by simp [paramsB]⟩
  right := ⟨(List.range' (K + 263) 263).toArray, by simp [paramsB]⟩

def layoutB (K : Nat) : DecodeLayout where
  kind := .nearestPair
  params := paramsB
  trials := [positionsB K]
  trials_le := by simp

def recoveredB (d a b : Nat) : Bool :=
  decide (orderFindingPostprocess order 263 order_prime
    (Fin.ofNat (2 ^ 263) a, Fin.ofNat (2 ^ 263) b) = some (d : ZMod order))

theorem successB_candidate (K d : Nat) (history : List Bool) (hl : history.length = K + 526)
    (hs : pairEvent 263 (recoveredB d) (history.drop K) = true) :
    (d : ZMod order) ∈ candidates (layoutB K) history := by
  have hleft : readWord history (positionsB K).left.toList =
      some (bitsValue ((history.drop K).take 263)) := by
    simp only [positionsB, Vector.toList, List.toList_toArray]
    exact readWord_range history K 263 (by omega)
  have hright : readWord history (positionsB K).right.toList =
      some (bitsValue ((history.drop K).drop 263)) := by
    have e1 : (history.drop K).drop 263 = history.drop (K + 263) := by
      simp [List.drop_drop]
    simp only [positionsB, Vector.toList, List.toList_toArray]
    rw [readWord_range history (K + 263) 263 (by omega), e1,
      List.take_of_length_le (by simp only [List.length_drop]; omega)]
  simp only [pairEvent, recoveredB, decide_eq_true_eq] at hs
  change (d : ZMod order) ∈ decodeTrial .nearestPair paramsB history (positionsB K) ++ []
  simp only [decodeTrial, hleft, hright, nearestPairCandidates, paramsB, if_true, hs,
    Option.toList_some, List.append_nil, List.mem_singleton]

theorem successB_verified (K : Nat) (Q : Point) (d : Nat) (hd : Q = d • G)
    (history : List Bool) (hl : history.length = K + 526)
    (hs : pairEvent 263 (recoveredB d) (history.drop K) = true) :
    (verifiedCandidate (layoutB K) Q history).isSome = true := by
  classical
  have hm := successB_candidate K d history hl hs
  have he : (d : ZMod order).val • G = Q := by
    rw [hd, ZMod.val_natCast]
    exact nsmul_mod_order G (by simpa using dlogPoint_order 1) d
  unfold verifiedCandidate
  exact List.find?_isSome.mpr ⟨_, hm, by simpa using he⟩

/-! ## Probability of the ideal trial -/

set_option exponentiation.threshold 300 in
theorem hwinB (n : ℕ) (hn0 : 0 < n) (hnr : n < order) :
    (200 : ℝ) / 201 ≤ ∑ a : Fin (2 ^ 263),
      if Quantum.OrderFinding.nearestNumerator order 263 a.val = n then
        Complex.normSq (qpeAmplitude 263 ((n : ℝ) / (order : ℝ)) a.val) else 0 := by
  have h := window_mass_sharp order 263 n hn0 hnr (by decide)
  rw [Fin.sum_univ_eq_sum_range (fun a => if Quantum.OrderFinding.nearestNumerator order 263 a = n then
    Complex.normSq (qpeAmplitude 263 ((n : ℝ) / (order : ℝ)) a) else 0)]
  simpa only [Quantum.OrderFinding.nearestNumerator, qpeAmplitude, eigenvalue] using h

theorem secret_mod_ne_zero' (Q : Point) (d : Nat) (hn : Q ≠ 0) (hd : Q = d • G) :
    d % order ≠ 0 := by
  intro h
  apply hn
  rw [hd, ← Nat.mod_add_div d order, h, Nat.zero_add, mul_nsmul, generator_nsmul_eq_zero,
    nsmul_zero]

/-- The unitary trial with the Naive oracle on the ideal workspace succeeds with 99 %. -/
theorem idealTrial_probability {regA regB pointReg work : List Wire} {anc idealStart : Wire}
    (hl : TrialLayout regA regB pointReg work anc idealStart)
    (Q : Point) (d : Nat) (hn : Q ≠ 0) (hd : Q = d • G) :
    (99 : ℝ) / 100 ≤ recordMass (observedTrial (iqft regA anc ++ iqft regB anc) regA regB).run
      (pairEvent 263 (recoveredB d))
      (Quantum.run (ecdlpOracle regA regB pointReg idealStart G Q)
        (Quantum.run (hadamards (regA ++ regB)) (ket zeroBasisState))) := by
  let hsetting : ECDLPSetting G Q order d :=
    { prime_order := order_prime
      order_P := generator_order
      Q_eq := hd }
  have hsetup : OrderFindingSetup pointEncoding regA regB pointReg
      (scalarMulWork idealStart) anc 263 zeroBasisState :=
    { a_width := hl.a_length
      b_width := hl.b_length
      a_zero := regValue_zeroBasisState regA
      b_zero := regValue_zeroBasisState regB
      point_zero := by
        simp only [regValue_zeroBasisState, pointEncoding_encode_val, encodeNat_zero]
      oracleWork_zero := by simp [Clean]
      ancilla_zero := zeroBasisState_apply anc
      ancilla_fresh := hl.anc_fresh }
  have hspec := ecdlpOracle_spec regA regB pointReg idealStart G Q hl.point_length hl.nodup
  rw [observedTrial_recordMass]
  have h := zObserve_eventProbability regA regB 263 hl.a_length hl.b_length (recoveredB d)
    (Quantum.run (iqft regA anc ++ iqft regB anc)
      (Quantum.run (ecdlpOracle regA regB pointReg idealStart G Q)
        (Quantum.run (hadamards (regA ++ regB)) (ket zeroBasisState))))
  rw [hl.a_length] at h
  rw [h]
  have hof : Quantum.run (iqft regA anc ++ iqft regB anc)
      (Quantum.run (ecdlpOracle regA regB pointReg idealStart G Q)
        (Quantum.run (hadamards (regA ++ regB)) (ket zeroBasisState))) =
      orderFinding regA regB anc (Quantum.run (ecdlpOracle regA regB pointReg idealStart G Q))
        (ket zeroBasisState) := by
    simp [orderFinding, Quantum.run_append, LinearMap.comp_apply]
  have heq : (∑ a : Fin (2 ^ 263), ∑ b : Fin (2 ^ 263),
      if recoveredB d a.val b.val then
        jointRegisterProbability regA regB a.val b.val
          (orderFinding regA regB anc (Quantum.run (ecdlpOracle regA regB pointReg idealStart G Q))
            (ket zeroBasisState)) else 0) =
      orderFindingSuccessProbability order 263 d order_prime regA regB
        (orderFinding regA regB anc (Quantum.run (ecdlpOracle regA regB pointReg idealStart G Q))
          (ket zeroBasisState)) := by
    unfold orderFindingSuccessProbability
    simp only [recoveredB, Fin.ofNat_eq_cast, Fin.cast_val_eq_self, decide_eq_true_eq]
  rw [hof, heq]
  refine le_trans ?_ (success_of_window_mass pointEncoding _ G Q regA regB pointReg
    (scalarMulWork idealStart) anc zeroBasisState hsetting hspec hsetup
    (secret_mod_ne_zero' Q d hn hd) (200 / 201) (by norm_num) hwinB)
  rw [div_mul_eq_mul_div, le_div_iff₀ (by norm_num [order])]
  norm_num [order]

/-! ## The adaptive trial -/

/-- Main glue theorem: if every block is a coherent controlled addition of its table point, the
straight-line trial succeeds with probability at least 99/100 through the protected decoder. -/
theorem trialProgram_success {n M : Nat} {regA regB pointReg work : List Wire}
    {anc idealStart : Wire} (hl : TrialLayout regA regB pointReg work anc idealStart)
    (blocks : List (Straight n 0 M)) (read : ConstantBit n → Bool) (Q : Point)
    (hblocks : List.Forall₂ (fun (b : Straight n 0 M) (cp : Wire × Point) =>
      AddsCoherently (b.instantiate read Fin.elim0) cp.1 pointReg work cp.2)
      blocks ((regA ++ regB).zip
        (Precompute.doublingTable 263 G ++ Precompute.doublingTable 263 Q)))
    (d : Nat) (hn : Q ≠ 0) (hd : Q = d • G) :
    (99 : ℝ) / 100 ≤ Instrument.bornMass
      (((trialProgram regA regB anc blocks).instantiate read Fin.elim0).run.filter
        (fun b => (verifiedCandidate (layoutB (blocks.length * M)) Q b.history).isSome))
      (ket zeroBasisState) := by
  have hlen : (regA ++ regB).length =
      (Precompute.doublingTable 263 G ++ Precompute.doublingTable 263 Q).length := by
    simp only [List.length_append, Precompute.doublingTable_length, hl.a_length, hl.b_length]
  have hcoh := chain_coherent read pointReg work idealStart blocks (regA ++ regB) _ hlen
    (fun c hc => hl.block c hc) hblocks 0 Fin.elim0
  have hor : scalarMulCore pointReg idealStart (regA ++ regB)
      (Precompute.doublingTable 263 G ++ Precompute.doublingTable 263 Q) =
      ecdlpOracle regA regB pointReg idealStart G Q := by
    rw [ecdlpOracle_eq_core, hl.a_length, hl.b_length]
  rw [chain_instantiate, hor] at hcoh
  have h0 : ValidN pointReg work (controlledPointAddWork idealStart) zeroBasisState :=
    ⟨⟨0, by simp⟩, by simp [Clean], by simp [Clean]⟩
  have hmass := trialProgram_mass regA regB anc blocks read _ _ hcoh (ket zeroBasisState)
    (hadamards_supported hl zeroBasisState h0) (pairEvent 263 (recoveredB d))
  have hprob := idealTrial_probability hl Q d hn hd
  rw [← hmass] at hprob
  refine le_trans hprob (bornMass_filter_mono _ _ _ ?_ _)
  intro b hb hs
  have hlen' := straight_history_length _ read Fin.elim0 b hb
  rw [List.length_append, hl.a_length, hl.b_length] at hlen'
  exact successB_verified _ Q d hd b.history (by omega) hs

end
end ShorECDLP.Entrant.Bridge

/-! ---------------------------------------------------------------------------
(formerly `Bridge/Assembly.lean`) -/

/-! EDITABLE. Generic assembly of the certified entry from controlled-addition templates.

An `AddProvider` supplies, for each of the 526 controlled additions, an ECDSAAdd template whose
control is wire 0, whose point register is wires 1..513 and whose workspace is `work`, with its
ECDSAAdd specification and its static template counts.  The assembly

* renames wire 0 of block `j` to the phase qubit `206624 + j` (registers `A = 206624..206886`,
  `B = 206887..207149`, QFT ancilla `207150`),
* chains the 526 translated blocks between the Hadamards and the two inverse QFTs,
* places the protected Naive ideal workspace at its original position `1026..206623`; the
  submitted program never touches it, so it costs no qubit, and
* proves the `Certificate` for any declared bounds above the static counts. -/

namespace ShorECDLP.Entrant.Bridge
open Quantum Secp256k1 Challenge NaiveChallenge
open ShorECDLP.Quantum.OrderFinding ShorECDLP.Quantum.PhaseEstimation
noncomputable section

local instance : Fact (Nat.Prime p) := ⟨p_prime⟩

/-! ## Wire layout -/

def phaseA : List Wire := List.range' 206624 263
def phaseB : List Wire := List.range' 206887 263
def qftAnc : Wire := 207150

theorem regAB_eq : phaseA ++ phaseB = List.range' 206624 526 :=
  List.range'_append (s := 206624) (m := 263) (n := 263) (step := 1)

theorem phaseA_length : phaseA.length = 263 := by simp [phaseA]
theorem phaseB_length : phaseB.length = 263 := by simp [phaseB]

theorem phase_length : (phaseA ++ phaseB).length = 526 := by
  rw [regAB_eq, List.length_range']

theorem regAB_getElem (i : Nat) (h : i < (phaseA ++ phaseB).length) :
    (phaseA ++ phaseB)[i] = 206624 + i := by
  rw [List.getElem_of_eq regAB_eq, List.getElem_range', Nat.one_mul]

/-- Control wire of addition `j`. -/
def ctrlOf (j : Fin 526) : Wire := 206624 + j.val

theorem ctrl_mem (j : Fin 526) : ctrlOf j ∈ phaseA ++ phaseB := by
  have := j.isLt
  rw [regAB_eq, List.mem_range'_1]
  unfold ctrlOf
  omega

theorem idealWork_bounds :
    ∀ w : Nat, w ∈ scalarMulWork bitcoinWorkStart → 1026 ≤ w ∧ w < 206624 := by
  intro w hw
  obtain ⟨_, _, _, hn, hf⟩ := bitcoinWireLayout
  have hup : w < 206624 := List.mem_range.mp (bitcoinDeclaredWires_subset w
    (List.mem_append_left [bitcoinQFTAncilla]
      (List.mem_append_right (bitcoinAReg ++ bitcoinBReg ++ bitcoinPointReg) hw)))
  have hlow : ¬ w < 1025 := by
    intro hlt
    have hmem : w ∈ bitcoinAReg ++ bitcoinBReg ++ bitcoinPointReg := by
      by_cases h1 : w < 256
      · exact List.mem_append_left _ (List.mem_append_left _
          (List.mem_range'_1.mpr ⟨by omega, by omega⟩))
      · by_cases h2 : w < 512
        · exact List.mem_append_left _ (List.mem_append_right _
            (List.mem_range'_1.mpr ⟨by omega, by omega⟩))
        · exact List.mem_append_right _
            (List.mem_range'_1.mpr ⟨by omega, by simp only [pointWidth]; omega⟩)
    exact (List.nodup_append.mp hn).2.2 w hmem w hw rfl
  have hne : w ≠ 1025 := by
    intro he
    subst he
    exact hf (List.mem_append_right _ hw)
  omega

theorem idealWork_nodup : (scalarMulWork bitcoinWorkStart).Nodup := by
  obtain ⟨_, _, _, hn, _⟩ := bitcoinWireLayout
  exact (List.nodup_append.mp hn).2.1

/-! ## Table points -/

/-- The table point added by block `j`: `2^j • G` for the first register, `2^(j-263) • Q`. -/
def tablePoint (Q : Point) (j : Fin 526) : Point :=
  if j.val < 263 then (2 ^ j.val) • G else (2 ^ (j.val - 263)) • Q

theorem tablePoint_eq (Q : Point) (j : Nat) (hj : j < 526)
    (h : j < (Precompute.doublingTable 263 G ++ Precompute.doublingTable 263 Q).length) :
    (Precompute.doublingTable 263 G ++ Precompute.doublingTable 263 Q)[j] =
      tablePoint Q ⟨j, hj⟩ := by
  simp only [tablePoint]
  by_cases hl : j < 263
  · rw [List.getElem_append_left (by rw [Precompute.doublingTable_length]; exact hl),
      Precompute.doublingTable_getElem _ _ hl, if_pos hl]
  · have h1 : (Precompute.doublingTable 263 G).length ≤ j := by
      rw [Precompute.doublingTable_length]; omega
    have h2 : j - (Precompute.doublingTable 263 G).length < 263 := by
      rw [Precompute.doublingTable_length]; omega
    rw [List.getElem_append_right h1, Precompute.doublingTable_getElem _ _ h2, if_neg hl,
      Precompute.doublingTable_length]

/-! ## Static helpers -/

theorem straightWires_castTable {n m s e : Nat} (h : n = m) (p : Straight n s e) :
    ShorECDLP.NaiveChallenge.straightWires (castTable h p) = ShorECDLP.NaiveChallenge.straightWires p := by
  subst h; rfl

theorem straightWires_constant {n : Nat} (c : Circuit) (k : Nat) :
    ShorECDLP.NaiveChallenge.straightWires (constantGateProgram (c.map (TemplateGate.literal (tableSize := n))) k) =
      circuitWires c := by
  induction c with
  | nil => rfl
  | cons g c ih =>
    change gateWires g ++ ShorECDLP.NaiveChallenge.straightWires (constantGateProgram (c.map TemplateGate.literal) k) = _
    rw [ih]
    simp [circuitWires]

theorem straightWires_observe {n : Nat} (ws : List Wire) (k : Nat) :
    ∀ w ∈ ShorECDLP.NaiveChallenge.straightWires (observeWires (n := n) ws k), w ∈ ws := by
  induction ws generalizing k with
  | nil =>
    intro w hw
    have h : ShorECDLP.NaiveChallenge.straightWires (observeWires (n := n) [] k) = [] := rfl
    rw [h] at hw
    exact absurd hw List.not_mem_nil
  | cons x xs ih =>
    intro w hw
    have h : ShorECDLP.NaiveChallenge.straightWires (observeWires (n := n) (x :: xs) k) =
        [x] ++ x :: ([x] ++ ShorECDLP.NaiveChallenge.straightWires (observeWires (n := n) xs (k + 1))) := by
      simp only [observeWires, ShorECDLP.NaiveChallenge.straightWires, slotGate, gateWires, straightWires_castFinish]
    rw [h] at hw
    rcases List.mem_append.mp hw with hw | hw
    · exact List.mem_cons.mpr (Or.inl (List.mem_singleton.mp hw))
    rcases List.mem_cons.mp hw with hw | hw
    · exact List.mem_cons.mpr (Or.inl hw)
    rcases List.mem_append.mp hw with hw | hw
    · exact List.mem_cons.mpr (Or.inl (List.mem_singleton.mp hw))
    · exact List.mem_cons_of_mem _ (ih _ w hw)

theorem tCount_hadamards (ws : List Wire) : tCount (hadamards ws) = 0 := by
  induction ws with
  | nil => rfl
  | cons w ws ih => simpa [hadamards, tCount, tCost] using ih

/-! ## Providers -/

/-- Everything the controlled-addition library provides. -/
structure AddProvider where
  n : Nat
  coeffs : Fin n → PointCoeff
  work : List Wire
  M : Nat
  T : Nat
  S : Nat
  tmpl : Fin 526 → List (TInstr n)
  static : ∀ j, ∀ i ∈ tmpl j, i.Static
  valid : ∀ j, ∀ i ∈ tmpl j, ECDSAAdd.Challenge.instructionValid i.instr
  supp : List Wire
  wires : ∀ j, ∀ w ∈ tmplWires (tmpl j), w ∈ supp
  supp_range : ∀ w : Nat, w ∈ supp → w < 206624
  supp_cover : ∀ w : Nat, w ∈ supp → w = bControl ∨ w ∈ pointWires ∨ w ∈ work
  work_range : ∀ w : Nat, w ∈ work → 514 ≤ w ∧ w < 206624
  meas : ∀ j, tmplMeas (tmpl j) = M
  toffoli : ∀ j, tmplToffoli (tmpl j) ≤ T
  slots : ∀ j, tmplSlots (tmpl j) ≤ S
  spec : ∀ (Q : Point) (d : Nat), Q ≠ 0 → Q = d • G → ∀ j : Fin 526,
    BSpec (instB (readConstant coeffs Q) (tmpl j)) (tablePoint Q j) work

namespace AddProvider

variable (P : AddProvider)

theorem block_meas (j : Fin 526) :
    0 + tmplMeas ((P.tmpl j).map (TInstr.rename (Equiv.swap bControl (ctrlOf j)))) = P.M := by
  rw [tmplMeas_rename, P.meas, Nat.zero_add]

/-- Block `j`: the template, controlled by its phase qubit, as a closed straight-line program. -/
def blockAt (j : Fin 526) : Straight P.n 0 P.M :=
  castFinish (P.block_meas j) (block (P.tmpl j) (ctrlOf j))

def blocks : List (Straight P.n 0 P.M) := List.ofFn P.blockAt

theorem blocks_length : P.blocks.length = 526 := List.length_ofFn

theorem cursor_eq : 0 + P.blocks.length * P.M + (phaseA ++ phaseB).length = 526 * P.M + 526 := by
  rw [P.blocks_length, phase_length]
  omega

def prog : Straight P.n 0 (526 * P.M + 526) :=
  castFinish P.cursor_eq (trialProgram phaseA phaseB qftAnc P.blocks)

def entry : StraightEntry where
  coefficients := List.ofFn P.coeffs
  finalCursor := 526 * P.M + 526
  program := castTable (List.length_ofFn).symm P.prog

def layout : DecodeLayout := layoutB (526 * P.M)

theorem entry_read (Q : Point) :
    (fun r : ConstantBit P.n => readConstant (List.ofFn P.coeffs).get Q
      ⟨Fin.cast (List.length_ofFn).symm r.point, r.field, r.bit⟩) = readConstant P.coeffs Q := by
  funext r
  have hg : (List.ofFn P.coeffs).get (Fin.cast (List.length_ofFn).symm r.point) =
      P.coeffs r.point := by
    simp
  simp only [readConstant]
  rw [hg]

theorem entry_instantiate (Q : Point) :
    P.entry.instantiate Q =
      (trialProgram phaseA phaseB qftAnc P.blocks).instantiate (readConstant P.coeffs Q)
        Fin.elim0 := by
  dsimp only [StraightEntry.instantiate, AddProvider.entry]
  rw [castTable_instantiate, P.entry_read Q, AddProvider.prog, instantiate_castFinish]

/-! ## Success -/

theorem trialLayout : TrialLayout phaseA phaseB pointWires P.work qftAnc bitcoinWorkStart where
  a_length := phaseA_length
  b_length := phaseB_length
  point_length := pointWires_length
  nodup := by
    rw [regAB_eq, List.append_assoc, List.nodup_append]
    refine ⟨List.nodup_range', ?_, ?_⟩
    · rw [List.nodup_append]
      refine ⟨pointWires_nodup, idealWork_nodup, ?_⟩
      intro a ha b hb hab
      subst hab
      have h1 := idealWork_bounds _ hb
      have h2 := List.mem_range'_1.mp ha
      omega
    · intro a ha b hb hab
      subst hab
      have h1 := List.mem_range'_1.mp ha
      rcases List.mem_append.mp hb with hb | hb
      · have h2 := List.mem_range'_1.mp hb
        omega
      · have h2 := idealWork_bounds _ hb
        omega
  anc_fresh := by
    intro h
    rw [regAB_eq] at h
    rcases List.mem_append.mp h with h | h
    · rcases List.mem_append.mp h with h | h
      · have := List.mem_range'_1.mp h
        unfold qftAnc at this
        omega
      · have := List.mem_range'_1.mp h
        unfold qftAnc at this
        omega
    · have := idealWork_bounds _ h
      unfold qftAnc at this
      omega
  work_point := by
    intro w hw hp
    have h1 := P.work_range w hw
    have h2 := List.mem_range'_1.mp hp
    omega
  work_phase := by
    intro w hw hp
    have h1 := P.work_range w hw
    rw [regAB_eq] at hp
    have h2 := List.mem_range'_1.mp hp
    omega

theorem bsupport (Q : Point) (j : Fin 526) :
    BSupport (instB (readConstant P.coeffs Q) (P.tmpl j)) P.work := fun w hw =>
  P.supp_cover w (P.wires j w (wires_instB_sub _ _ w hw))

theorem blockAt_adds (Q : Point) (d : Nat) (hn : Q ≠ 0) (hd : Q = d • G) (j : Fin 526) :
    AddsCoherently ((P.blockAt j).instantiate (readConstant P.coeffs Q) Fin.elim0) (ctrlOf j)
      pointWires P.work (tablePoint Q j) := by
  rw [AddProvider.blockAt, instantiate_castFinish]
  refine block_adds _ _ (P.static j) _ P.work (P.spec Q d hn hd j) (P.bsupport Q j) _
    ?_ ?_ ?_ ?_
  · intro h
    have := List.mem_range'_1.mp h
    unfold ctrlOf at this
    omega
  · intro h
    have := P.work_range _ h
    unfold ctrlOf at this
    omega
  · intro h
    have := List.mem_range'_1.mp h
    unfold bControl at this
    omega
  · intro h
    have := P.work_range _ h
    unfold bControl at this
    omega

theorem hblocks (Q : Point) (d : Nat) (hn : Q ≠ 0) (hd : Q = d • G) :
    List.Forall₂ (fun (b : Straight P.n 0 P.M) (cp : Wire × Point) =>
      AddsCoherently (b.instantiate (readConstant P.coeffs Q) Fin.elim0) cp.1 pointWires P.work
        cp.2)
      P.blocks ((phaseA ++ phaseB).zip
        (Precompute.doublingTable 263 G ++ Precompute.doublingTable 263 Q)) := by
  rw [List.forall₂_iff_get]
  refine ⟨?_, ?_⟩
  · simp [P.blocks_length, regAB_eq]
  · intro i h₁ h₂
    have hi : i < 526 := by rw [P.blocks_length] at h₁; exact h₁
    have hb : P.blocks.get ⟨i, h₁⟩ = P.blockAt ⟨i, hi⟩ := by
      simp only [List.get_eq_getElem, AddProvider.blocks, List.getElem_ofFn]
    have hz : ((phaseA ++ phaseB).zip
        (Precompute.doublingTable 263 G ++ Precompute.doublingTable 263 Q)).get ⟨i, h₂⟩ =
        (ctrlOf ⟨i, hi⟩, tablePoint Q ⟨i, hi⟩) := by
      simp only [List.get_eq_getElem, List.getElem_zip]
      exact Prod.ext (regAB_getElem i _) (tablePoint_eq Q i hi _)
    rw [hb, hz]
    exact P.blockAt_adds Q d hn hd ⟨i, hi⟩

theorem success (Q : Point) (d : Nat) (hn : Q ≠ 0) (hd : Q = d • G) :
    (99 : ℝ) / 100 ≤ Instrument.bornMass ((P.entry.instantiate Q).run.filter
      (fun b => (verifiedCandidate P.layout Q b.history).isSome)) (ket zeroBasisState) := by
  have h := trialProgram_success P.trialLayout P.blocks (readConstant P.coeffs Q) Q
    (P.hblocks Q d hn hd) d hn hd
  have hl : layoutB (P.blocks.length * P.M) = P.layout := by
    rw [P.blocks_length]
    rfl
  rw [hl] at h
  rw [P.entry_instantiate Q]
  exact h

/-! ## Static resources -/

/-- Every wire of the program. -/
def wireSupport : List Wire := P.supp ++ (phaseA ++ phaseB) ++ [qftAnc]

theorem mem_support_supp {w : Wire} (h : w ∈ P.supp) : w ∈ P.wireSupport :=
  List.mem_append_left _ (List.mem_append_left _ h)

theorem mem_support_phase {w : Wire} (h : w ∈ phaseA ++ phaseB) : w ∈ P.wireSupport :=
  List.mem_append_left _ (List.mem_append_right _ h)

theorem mem_support_anc : qftAnc ∈ P.wireSupport :=
  List.mem_append_right _ (List.mem_singleton_self _)

theorem wireSupport_length : P.wireSupport.length = P.supp.length + 527 := by
  have h3 : P.wireSupport.length = P.supp.length + (phaseA ++ phaseB).length + 1 := by
    simp only [AddProvider.wireSupport, List.length_append, List.length_singleton]
  have h2 := phase_length
  omega

theorem blockAt_wires (j : Fin 526) : ∀ w ∈ ShorECDLP.NaiveChallenge.straightWires (P.blockAt j), w ∈ P.wireSupport := by
  intro w hw
  rw [AddProvider.blockAt, straightWires_castFinish, block] at hw
  have h := translate_wires _ 0 w hw
  rw [tmplWires_rename, List.mem_map] at h
  obtain ⟨v, hv, rfl⟩ := h
  have hs := P.wires j v hv
  by_cases h0 : v = bControl
  · rw [h0, Equiv.swap_apply_left]
    exact P.mem_support_phase (ctrl_mem j)
  · have hr := P.supp_range v hs
    have hnec : v ≠ ctrlOf j := by intro e; rw [e] at hr; unfold ctrlOf at hr; omega
    rw [Equiv.swap_apply_of_ne_of_ne h0 hnec]
    exact P.mem_support_supp hs

theorem prog_wires : ∀ w ∈ ShorECDLP.NaiveChallenge.straightWires P.prog, w ∈ P.wireSupport := by
  intro w hw
  rw [AddProvider.prog, straightWires_castFinish, trialProgram, straightWires_append,
    straightWires_append, straightWires_append, straightWires_constant, straightWires_constant,
    chain_straightWires] at hw
  rcases List.mem_append.mp hw with hw | hw
  · exact P.mem_support_phase
      ((ModAddSupport.circuitUsesOnly_iff_support _ _).mp (hadamards_usesOnly _) w hw)
  rcases List.mem_append.mp hw with hw | hw
  · obtain ⟨b, hb, hw⟩ := List.mem_flatMap.mp hw
    obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hb
    exact P.blockAt_wires j w hw
  rcases List.mem_append.mp hw with hw | hw
  · have hA := (ModAddSupport.circuitUsesOnly_iff_support _ _).mp (iqft_usesOnly phaseA qftAnc)
    have hB := (ModAddSupport.circuitUsesOnly_iff_support _ _).mp (iqft_usesOnly phaseB qftAnc)
    have hw' : w ∈ circuitWires (iqft phaseA qftAnc) ∨ w ∈ circuitWires (iqft phaseB qftAnc) := by
      simpa only [circuitWires, List.flatMap_append, List.mem_append] using hw
    rcases hw' with hw' | hw'
    · rcases List.mem_append.mp (hA w hw') with h | h
      · exact P.mem_support_phase (List.mem_append_left _ h)
      · rw [List.mem_singleton.mp h]
        exact P.mem_support_anc
    · rcases List.mem_append.mp (hB w hw') with h | h
      · exact P.mem_support_phase (List.mem_append_right _ h)
      · rw [List.mem_singleton.mp h]
        exact P.mem_support_anc
  · exact P.mem_support_phase (straightWires_observe _ _ w hw)

theorem qubits_le (Q : Point) :
    (resources (P.entry.instantiate Q)).qubits ≤ P.supp.length + 527 := by
  have h := straight_qubit_bound P.entry.program (readConstant P.entry.coefficients.get Q)
    Fin.elim0
  have he : ShorECDLP.NaiveChallenge.straightWires P.entry.program = ShorECDLP.NaiveChallenge.straightWires P.prog := straightWires_castTable _ _
  have hs : (ShorECDLP.NaiveChallenge.straightWires P.prog).toFinset ⊆ P.wireSupport.toFinset := fun w hw =>
    List.mem_toFinset.mpr (P.prog_wires w (List.mem_toFinset.mp hw))
  have hc := Finset.card_le_card hs
  have h1 := List.card_toFinset (l := ShorECDLP.NaiveChallenge.straightWires P.prog)
  have h2 := List.toFinset_card_le (l := P.wireSupport)
  have h3 := P.wireSupport_length
  have h4 : (resources (P.entry.instantiate Q)).qubits ≤ (ShorECDLP.NaiveChallenge.straightWires P.prog).dedup.length := by
    rw [← he]
    exact h
  omega

theorem blockAt_straightT (j : Fin 526) : straightT (P.blockAt j) ≤ 7 * P.T := by
  rw [AddProvider.blockAt, straightT_castFinish, block, translate_straightT, tmplToffoli_rename]
  exact Nat.mul_le_mul_left _ (P.toffoli j)

theorem prog_straightT : straightT P.prog ≤ 526 * (7 * P.T) + 1033590 := by
  rw [AddProvider.prog, straightT_castFinish, trialProgram, straightT_append, straightT_append,
    straightT_append, straightT_constant, straightT_constant, straightT_observe,
    templateT_literal, templateT_literal, chain_straightT, tCount_hadamards]
  have hq : tCount (iqft phaseA qftAnc ++ iqft phaseB qftAnc) = 1033590 := by
    simp only [tCount_append, tCount_iqft, phaseA_length, phaseB_length]
  have hs := List.sum_le_card_nsmul (P.blocks.map straightT) (7 * P.T) (by
    intro x hx
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hx
    obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hb
    exact P.blockAt_straightT j)
  rw [List.length_map, P.blocks_length, smul_eq_mul] at hs
  rw [hq]
  omega

theorem tModel_le (Q : Point) :
    (resources (P.entry.instantiate Q)).tModel ≤ 526 * (7 * P.T) + 1033590 := by
  have h := straight_t_bound P.entry.program (readConstant P.entry.coefficients.get Q) Fin.elim0
  have he : straightT P.entry.program = straightT P.prog := straightT_castTable _ _
  exact h.trans (he.le.trans P.prog_straightT)

theorem measurements_eq (Q : Point) :
    (resources (P.entry.instantiate Q)).measurements = 526 * P.M + 526 :=
  (Straight.measurementCount P.entry.program _ _).trans (Nat.sub_zero _)

theorem blockAt_slots (j : Fin 526) : (P.blockAt j).gateSlots ≤ P.S := by
  rw [AddProvider.blockAt, gateSlots_castFinish, block, translate_gateSlots, tmplSlots_rename]
  exact P.slots j

theorem prog_slots : P.prog.gateSlots ≤ 526 * P.S + 418696 := by
  rw [AddProvider.prog, gateSlots_castFinish, trialProgram, Straight.gateSlots_append,
    Straight.gateSlots_append, Straight.gateSlots_append, constantGateProgram_slots,
    constantGateProgram_slots, observeWires_slots, chain_gateSlots]
  have hs := List.sum_le_card_nsmul (P.blocks.map Straight.gateSlots) P.S (by
    intro x hx
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hx
    obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hb
    exact P.blockAt_slots j)
  rw [List.length_map, P.blocks_length, smul_eq_mul] at hs
  have e1 : ((hadamards (phaseA ++ phaseB)).map (TemplateGate.literal (tableSize := P.n))).length
      = 526 := by
    simp [hadamards, regAB_eq]
  have h3 : (iqft phaseA qftAnc).length ≤ 208559 :=
    (iqft_length_le phaseA qftAnc).trans (by simp [phaseA_length])
  have h4 : (iqft phaseB qftAnc).length ≤ 208559 :=
    (iqft_length_le phaseB qftAnc).trans (by simp [phaseB_length])
  have e2 : ((iqft phaseA qftAnc ++ iqft phaseB qftAnc).map
      (TemplateGate.literal (tableSize := P.n))).length =
      (iqft phaseA qftAnc).length + (iqft phaseB qftAnc).length := by
    rw [List.length_map, List.length_append]
  have e3 := phase_length
  omega

attribute [local irreducible] AddProvider.blocks Straight.WellFormed in
theorem wellFormed : P.entry.program.WellFormed := by
  change (castTable _ P.prog).WellFormed
  rw [castTable_wellFormed, AddProvider.prog, wellFormed_castFinish, trialProgram]
  have hfa : qftAnc ∉ phaseA := by
    intro h
    have := List.mem_range'_1.mp h
    unfold qftAnc at this
    omega
  have hfb : qftAnc ∉ phaseB := by
    intro h
    have := List.mem_range'_1.mp h
    unfold qftAnc at this
    omega
  have h1 : (constantGateProgram ((hadamards (phaseA ++ phaseB)).map
      (TemplateGate.literal (tableSize := P.n))) 0).WellFormed := by
    apply constantGateProgram_wellFormed
    intro g hg
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hg
    obtain ⟨w, _, rfl⟩ := List.mem_map.mp ha
    trivial
  have h2 : (chain P.blocks 0).WellFormed := by
    apply chain_wellFormed
    intro b hb
    rw [AddProvider.blocks] at hb
    obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hb
    rw [AddProvider.blockAt, wellFormed_castFinish, block]
    exact translate_wellFormed _ 0 (rename_valid _ (Equiv.injective _) _ (P.valid j))
  have h3 : (constantGateProgram ((iqft phaseA qftAnc ++ iqft phaseB qftAnc).map
      (TemplateGate.literal (tableSize := P.n))) (0 + P.blocks.length * P.M)).WellFormed := by
    apply constantGateProgram_wellFormed
    intro g hg
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hg
    exact ((circuitWellFormed_append _ _).mpr
      ⟨iqft_wellFormed _ _ hfa List.nodup_range', iqft_wellFormed _ _ hfb List.nodup_range'⟩) a ha
  have h4 := observeWires_wellFormed (n := P.n) (phaseA ++ phaseB) (0 + P.blocks.length * P.M)
  exact straight_append_wellFormed _ _ h1
    (straight_append_wellFormed _ _ h2 (straight_append_wellFormed _ _ h3 h4))

/-- The certificate, for any declared bounds above the static counts. -/
theorem certificate (bounds : Bounds)
    (hq : P.supp.length + 527 ≤ bounds.qubits)
    (ht : 526 * (7 * P.T) + 1033590 ≤ bounds.tModel)
    (hm : 526 * P.M + 526 ≤ bounds.measurements)
    (hrec : 526 * P.M + 526 ≤ officialLimits.measurements)
    (hslots : 526 * P.S + 418696 ≤ officialLimits.gateSlots)
    (hrows : P.n ≤ officialLimits.coefficientRows) :
    Certificate officialLimits P.layout P.entry bounds where
  gateBudget := by
    change (castTable _ P.prog).gateSlots ≤ _
    rw [gateSlots_castTable]
    exact P.prog_slots.trans hslots
  recordBudget := hrec
  tableBudget := by
    change (List.ofFn P.coeffs).length ≤ _
    rw [List.length_ofFn]
    exact hrows
  candidateBudget := by
    simp [AddProvider.layout, layoutB, decoderCandidateLimit, officialLimits, budget55]
  wellFormed := P.wellFormed
  resources := fun Q =>
    ⟨(P.qubits_le Q).trans hq, (P.tModel_le Q).trans ht, (P.measurements_eq Q).le.trans hm⟩
  success := fun Q d hn hd => P.success Q d hn hd

end AddProvider
