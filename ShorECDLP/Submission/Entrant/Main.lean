  let eR2 : ℕ → ℝ := fun k => Real.cos (2 * Real.pi * ((2 * AR : ℤ) : ℝ) * (k : ℝ) / r)
  have hcL_eq : ∀ k : Fin r, cL k = (1 + eL1 k.val) / 2 ∧ cL k ^ 2 = 3 / 8 + eL1 k.val / 2 + eL2 k.val / 8 := by
