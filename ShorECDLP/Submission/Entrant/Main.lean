    · exact (by unfold backOfNat backSpec5; norm_num : _ ≤ (48 : ℝ) / (875 : ℝ)).trans (by simpa [d_S2fac] using DyadicHi.ofRat_sound 48 875 (by decide))
    · have h1 : (5 / 2 : ℝ) * psiB7 1 1 / (1 - rhoB7 / (37 / 100)) ≤ (1699786401 : ℝ) / (273238528 : ℝ) := by
