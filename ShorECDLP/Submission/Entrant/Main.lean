      have h4 : (4 : ℝ) ^ k0 = (2 : ℝ) ^ k0 * (2 : ℝ) ^ k0 := by rw [← mul_pow]; norm_num
      have h2k : (2 : ℝ) ^ k0 = 2 * (2 : ℝ) ^ (k0 - 1) := by rw [← pow_succ', Nat.sub_add_cancel (by omega)]
