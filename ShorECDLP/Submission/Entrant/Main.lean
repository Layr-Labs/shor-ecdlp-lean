theorem readout_support (read : ConstantBit 688128 → Bool)
    (h : Fin (262143 + 21 * impl.records15 + 10 * impl.records14 + 473 + body.reset.length) → Bool) :
    (readout.instantiate read h).wires ⊆ ledger.support := by
  unfold readout
