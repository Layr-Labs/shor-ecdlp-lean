      512 * f.site.ports.length * (tableAddressTree bank14.high 0 1).leaves +
        10 * (tableAddressTree bank14.high 0 1).internalNodes + 1020 := by
    unfold clearP
    rw [MeasuredClear.measuredClear_slots _ _ _ _ _ _ _ (site_layout_bank f hg)]
