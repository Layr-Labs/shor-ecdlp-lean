theorem nFast_new (start : Nat) : ChallengeMigration.straightWires (nFastProgram start) ⊆ newSource := by
  apply literalFixed_support (n := 32768) (ECDSAAdd.Baselines.normalizeProgram fastWindowSignProgram) 256
