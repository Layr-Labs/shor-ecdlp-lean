            (1 / B2.K) * ((2 : ℝ) ^ 256) ^ B2.fwd.a * (T0 * B2.qL ^ j) * B2.fwd.phi (runF (2, 1) γ).1 (runF (2, 1) γ).2 := by
        intro γ _
