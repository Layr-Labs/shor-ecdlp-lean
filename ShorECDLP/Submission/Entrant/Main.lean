  have h3 : 512 * (clearData f.garbPorts).length * (tableAddressTree high 0 1).leaves +
      10 * (tableAddressTree high 0 1).internalNodes + 1020 = 512 * f.garb.length * 256 + 10 * 255 + 1020 := by
