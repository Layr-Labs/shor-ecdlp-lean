  refine ⟨ccxList_records _ _ _, ?_, ?_⟩
  · rw [WEX.scrCWrite, ccxList_toffoli, hl, hT]; exact Nat.min_self _
  · rw [WEX.scrCWrite, ccxList_slots, hl, hT]; exact Nat.min_self _

