              have h1 : (1 : ℝ) ≤ (4 * (2 : ℝ) ^ (2 * d) / (4 : ℝ) ^ k0) / ((runF (1, 1) γ2).1 : ℝ) ^ 2 := (one_le_div (by positivity)).mpr hsq
              have : (0 : ℝ) ≤ (4 * (2 : ℝ) ^ (2 * d) / (4 : ℝ) ^ k0) * (1 / ((runF (1, 1) γ2).2 : ℝ) ^ 2) := by positivity
              linarith [show (4 * (2 : ℝ) ^ (2 * d) / (4 : ℝ) ^ k0) / ((runF (1, 1) γ2).1 : ℝ) ^ 2 =
