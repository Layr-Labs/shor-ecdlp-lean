    (goodNeighbor 256 r 2 k a ∧ ¬ goodNeighbor 256 r 1 k a) ∧ goodNeighbor 206 r 0 (kR k) b
  let G3 : Fin r → Fin (2 ^ 256) → Fin (2 ^ 206) → Prop := fun k a b =>
