  · simpa only [resourcesInstance,Single.ProducerResources.ofBody,bodyInstance,WEX.compactBody] using
      (show (1930 : Wire) ∉ List.range 1634 from by simp)
  · simpa only [resourcesInstance,Single.ProducerResources.ofBody,bodyInstance,WEX.compactBody] using
