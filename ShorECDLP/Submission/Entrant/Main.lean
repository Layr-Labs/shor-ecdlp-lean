def geometryOK (bits paths : List Wire) (root : Wire) (control : Option Wire)
    (targets : List Wire) : Bool :=
  decide (lookupRoot root control :: bits ++ paths).Nodup && decide targets.Nodup &&
    ((root :: lookupRoot root control :: bits ++ paths).all fun w => !targets.contains w)

def lookupPlacedOK {n : Nat} (bits paths : List Wire) (root : Wire) : WInstr n → Bool
  | .literal _ => true
  | .lookup c p => geometryOK bits paths root c (portTargets p)

theorem lookupPlacedOK_iff {n : Nat} (bits paths : List Wire) (root : Wire) (i : WInstr n) :
    lookupPlacedOK bits paths root i = true ↔
      match i with | .literal _ => True | .lookup c p => Placed bits paths root (.lookup c p) := by
  cases i <;> simp [lookupPlacedOK, geometryOK, Placed, Bool.and_eq_true, and_assoc, List.all_eq_true, List.disjoint_left, or_imp, forall_and]

/-- Literal segments occur intact in every row specialization. -/
theorem literal_wires_subset {n : Nat} (read : ConstantBit n → Bool) (code : WCode n)
    (address : Nat) (p : ECDSAAdd.Program) (hp : WInstr.literal p ∈ code) :
    ECDSAAdd.wires p ⊆ ECDSAAdd.wires ((specialize code address).instantiate read) := by
  induction code with
  | nil => simp at hp
  | cons i code ih =>
    simp only [specialize, List.flatMap_cons, ECDSAAdd.ShorPort.Tmpl.instantiate_append,
      ECDSAAdd.wires_append]
    rcases List.mem_cons.mp hp with h | h
    · cases h
      simp [WInstr.specialize, ECDSAAdd.ShorPort.Tmpl.instantiate_lit]
    · exact (ih h).trans (Finset.subset_union_right)

/-- The native six-module arithmetic inventory lies below the private lookup bank. -/
theorem nativeSites_lt : ∀ w ∈ ECDSAAdd.Entrant.sitesQ ECDSAAdd.Baselines.layout,
    w < 10000 := by decide +kernel

def nativeBits : List Wire := List.range' 10000 15
def nativePaths : List Wire := List.range' 10015 15
def nativeRoot : Wire := 10030

theorem native_reserved_outside : ∀ w ∈ nativeRoot :: nativeBits ++ nativePaths,
    w ∉ ECDSAAdd.Entrant.sitesQ ECDSAAdd.Baselines.layout := by
  intro w hw hm
  have hsmall := nativeSites_lt w hm
  simp only [nativeRoot, nativeBits, nativePaths, List.mem_cons, List.mem_append,
    List.mem_range'_1] at hw
  have hlarge : 10000 ≤ w := by
    rcases hw with (rfl | h) | h
    · decide
    · exact h.1
    · exact (by decide : 10000 ≤ 10015).trans h.1
  exact (Nat.not_le_of_gt hsmall) hlarge

theorem indexedPorts_targets {n : Nat} (ws : List Wire)
    (refs : Nat → Nat → ConstantBit n) (v : Bool) :
    portTargets (indexedPorts ws refs v) = ws := by
  induction ws generalizing refs with
  | nil => rfl
  | cons w ws ih =>
    simpa [indexedPorts, portTargets] using congrArg (List.cons w) (ih (fun a i => refs a (i+1)))

def geometryCodeOK {n : Nat} (bits paths : List Wire) (root : Wire) (code : WCode n) : Bool :=
  code.all (lookupPlacedOK bits paths root)

@[simp] theorem geometry_append {n : Nat} (bits paths : List Wire) (root : Wire)
    (xs ys : WCode n) : geometryCodeOK bits paths root (xs ++ ys) =
      (geometryCodeOK bits paths root xs && geometryCodeOK bits paths root ys) := by
  simp [geometryCodeOK]

@[simp] theorem geometry_literal {n : Nat} (bits paths : List Wire) (root : Wire)
    (p : ECDSAAdd.Program) : geometryCodeOK bits paths root (wLiteral (n := n) p) = true := rfl

@[simp] theorem geometry_mask {n : Nat} (bits paths : List Wire) (root : Wire)
    (c : Option Wire) (ws : List Wire) (refs : Nat → Nat → ConstantBit n) (v : Bool) :
    geometryCodeOK bits paths root (wMask c ws refs v) = geometryOK bits paths root c ws := by
  simp [geometryCodeOK, wMask, lookupPlacedOK, indexedPorts_targets]

@[simp] theorem geometry_point {n : Nat} (bits paths : List Wire) (root c : Wire)
    (r : ECDSAAdd.PointReg) (fin : Nat → ConstantBit n) (xr yr : Nat → Nat → ConstantBit n) :
    geometryCodeOK bits paths root (wPoint c r fin xr yr) =
      geometryOK bits paths root (some c) (r.finite :: r.x ++ r.y) := by
  simp only [geometryCodeOK, wPoint, List.all_cons, List.all_nil, Bool.and_true, lookupPlacedOK]
  congr 1
  simp only [portTargets, List.map_cons, List.map_append]; rw [show List.map LookupPort.target _ = _ from indexedPorts_targets _ _ _, show List.map LookupPort.target _ = _ from indexedPorts_targets _ _ _]

@[simp] theorem geometry_pairXor {n : Nat} (bits paths : List Wire) (root : Wire)
    (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (fin : Nat → ConstantBit n)
    (xr : Nat → Nat → ConstantBit n) :
    geometryCodeOK bits paths root (wPairXor L fin xr) =
      geometryOK bits paths root none (L.point.finite :: L.point.x) := by
  simp only [geometryCodeOK, wPairXor, List.all_cons, List.all_nil, Bool.and_true, lookupPlacedOK]
  congr 1
  simpa only [portTargets, List.map_cons] using congrArg (List.cons _) (indexedPorts_targets _ _ _)

@[simp] theorem geometry_shortXor {n : Nat} (bits paths : List Wire) (root : Wire)
    (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (fin : Nat → ConstantBit n)
    (xr : Nat → Nat → ConstantBit n) (y0 : Nat → ConstantBit n) :
    geometryCodeOK bits paths root (wShortXor L fin xr y0) =
      geometryOK bits paths root none (L.point.finite :: (L.point.x ++ L.point.y.take 1)) := by
  simp only [geometryCodeOK, wShortXor, List.all_cons, List.all_nil, Bool.and_true, lookupPlacedOK]
  congr 1
  simp only [portTargets, List.map_cons, List.map_append]; rw [show List.map LookupPort.target _ = _ from indexedPorts_targets _ _ _, show List.map LookupPort.target _ = _ from indexedPorts_targets _ _ _]
  all_goals rfl

@[simp] theorem geometry_bitTest {n : Nat} (bits paths : List Wire) (root w y t : Wire)
    (ref : Nat → ConstantBit n) : geometryCodeOK bits paths root (wBitTest w y t ref) =
      geometryOK bits paths root none ([y]) := by
  simp [geometryCodeOK, wBitTest, lookupPlacedOK, portTargets]

theorem geometry_zeroWith {n : Nat} (bits paths : List Wire) (root : Wire)
    (tail : Wire → WCode n) (h : ∀ w, geometryCodeOK bits paths root (tail w) = true)
    (c : Wire) (bs : List ECDSAAdd.Arithmetic.ZeroBit) :
    geometryCodeOK bits paths root (wZeroWith tail c bs) = true := by
  induction bs generalizing c with
  | nil => exact h c
  | cons b bs ih => simp [wZeroWith, ih]

/-- Geometry is checked compositionally, without reducing the arithmetic segments. -/
theorem native_lookupPlaced (rows doubles : Nat → Fin 32768) :
    (wFinite ECDSAAdd.Baselines.layout rows doubles).all
      (lookupPlacedOK nativeBits nativePaths nativeRoot) = true := by
  let L := ECDSAAdd.Baselines.layout
  have hpair : geometryOK nativeBits nativePaths nativeRoot none
      (L.point.finite :: L.point.x) = true := by dsimp only [L]; decide +kernel
  have hshort : geometryOK nativeBits nativePaths nativeRoot none
      (L.point.finite :: (L.point.x ++ L.point.y.take 1)) = true := by dsimp only [L]; decide +kernel
  have hy : geometryOK nativeBits nativePaths nativeRoot none ([ECDSAAdd.Entrant.yLow L]) = true := by
    dsimp only [L]
    decide +kernel
  have hp : ∀ c ∈ [L.infinitySelect, L.doubleSelect, L.genericSelect, L.core.equalNegY],
      geometryOK nativeBits nativePaths nativeRoot (some c) (L.point.finite :: (L.point.x ++ L.point.y)) = true := by
    dsimp only [L]
    decide +kernel
  have hc (r : List Wire) : geometryOK nativeBits nativePaths nativeRoot (some L.core.generic)
      (L.recoveryConstant r).src = true := by
    change geometryOK nativeBits nativePaths nativeRoot (some L.core.generic)
      (L.dialogPool.take 256) = true
    dsimp only [L]
    decide +kernel
  have heq (t₁ t₂ : Wire) (fin : Nat → ConstantBit 32768) (xr : Nat → Nat → ConstantBit 32768)
      (r₁ r₂ : Nat → ConstantBit 32768) :
      geometryCodeOK nativeBits nativePaths nativeRoot (wPairEqual L t₁ t₂ fin xr r₁ r₂) = true := by
    have htail (w : Wire) : geometryCodeOK nativeBits nativePaths nativeRoot
        (wPairTail (ECDSAAdd.Entrant.yLow L) t₁ t₂ r₁ r₂ w) = true := by
      simp [wPairTail, hy]
    have hzero := geometry_zeroWith nativeBits nativePaths nativeRoot _ htail
      L.control (ECDSAAdd.Entrant.pairPorts L)
    simp [wPairEqual, hpair, hzero]
  change geometryCodeOK nativeBits nativePaths nativeRoot (wFinite L rows doubles) = true
  simp [wFinite, wGenericLegacy, wRecovery, wCorners, wConstAdd, wShortEqual, List.cons_append, hshort, heq,
    hp L.infinitySelect (by simp), hp L.doubleSelect (by simp),
    hp L.genericSelect (by simp), hp L.core.equalNegY (by simp), hc]

/-- The original finite-addend support theorem controls every literal segment. -/
theorem native_literal_support (rows doubles : Nat → Fin 32768)
    (hd : rows 0 ≠ doubles 0) (p : ECDSAAdd.Program)
    (hp : WInstr.literal p ∈ wFinite ECDSAAdd.Baselines.layout rows doubles) :
    ECDSAAdd.wires p ⊆ (ECDSAAdd.Entrant.sitesQ ECDSAAdd.Baselines.layout).toFinset := by
  let C : ECDSAAdd.Secp256k1.Point := .some
    (Secp256k1.generator_nonsingular : ECDSAAdd.Secp256k1.curve.toAffine.Nonsingular _ _)
  let read : ConstantBit 32768 → Bool := fun ref =>
    (fieldValue (ECDSAAdd.ShorPort.toA (if ref.point = rows 0 then C else C+C)) ref.field).testBit
      ref.bit.val
  have hrow : ECDSAAdd.ShorPort.RowReads read (rows 0) C := by
    intro f b
    simp [read]
  have hdbl : ECDSAAdd.ShorPort.RowReads read (doubles 0) (C+C) := by
    intro f b
    simp [read, Ne.symm hd]
  have hk : ECDSAAdd.ShorPort.toA C = (1 : Nat) • Secp256k1.G := by rw [one_nsmul]; rfl
  have hsupp := ECDSAAdd.ShorPort.finiteT_supportQ ECDSAAdd.Baselines.layout
    ECDSAAdd.Baselines.layout_widths ECDSAAdd.Baselines.layout_nodup
    (Secp256k1.generator_nonsingular : ECDSAAdd.Secp256k1.curve.toAffine.Nonsingular _ _) 1 hk hrow hdbl
  rw [← specialize_finite ECDSAAdd.Baselines.layout rows doubles 0] at hsupp
  exact (literal_wires_subset read _ 0 p hp).trans hsupp

theorem native_placed (rows doubles : Nat → Fin 32768) (hd : rows 0 ≠ doubles 0) :
    ∀ i ∈ wFinite ECDSAAdd.Baselines.layout rows doubles,
      Placed nativeBits nativePaths nativeRoot i := by
  intro i hi
  have hc := List.all_eq_true.mp (native_lookupPlaced rows doubles) i hi
  cases i with
  | literal p =>
    intro w hw hm
    exact native_reserved_outside w hw (List.mem_toFinset.mp
      (native_literal_support rows doubles hd p hi hm))
  | lookup c p => exact (lookupPlacedOK_iff _ _ _ _).mp hc

end
end ShorECDLP.Entrant.WEX

namespace ShorECDLP.Entrant.WEX
open Quantum Challenge Paper2607_13816 Paper2607_13816.ChallengeMigration
noncomputable section
set_option maxHeartbeats 3000000

def normalizeWInstr {n : Nat} : WInstr n → WInstr n
  | .literal p => .literal (ECDSAAdd.Baselines.normalizeProgram p)
  | .lookup c p => .lookup c p

def normalizeW {n : Nat} (code : WCode n) : WCode n := code.map normalizeWInstr

theorem portTemplate_normalize {n : Nat} (control : Option Wire)
    (ports : List (LookupPort n)) (address : Nat) :
    ECDSAAdd.ShorPort.Tmpl.map ECDSAAdd.Baselines.normalizeInstr (portTemplate control ports address) =
      portTemplate control ports address := by
  induction ports with
  | nil => rfl
  | cons p ports ih =>
    cases control <;> simp only [portTemplate_cons, ECDSAAdd.ShorPort.Tmpl.map,
      List.map_cons, ECDSAAdd.ShorPort.TInstr.map, ECDSAAdd.Baselines.normalizeInstr]
    all_goals congr 1

theorem specialize_normalize {n : Nat} (code : WCode n) (address : Nat) :
    specialize (normalizeW code) address =
      ECDSAAdd.ShorPort.Tmpl.map ECDSAAdd.Baselines.normalizeInstr (specialize code address) := by
  induction code with
  | nil => rfl
  | cons i code ih =>
    cases i with
    | literal p =>
      change ECDSAAdd.ShorPort.Tmpl.lit (ECDSAAdd.Baselines.normalizeProgram p) ++
        specialize (normalizeW code) address =
        ECDSAAdd.ShorPort.Tmpl.map ECDSAAdd.Baselines.normalizeInstr
          (ECDSAAdd.ShorPort.Tmpl.lit p ++ specialize code address)
      rw [ih]
      simp [ECDSAAdd.ShorPort.Tmpl.map, ECDSAAdd.ShorPort.Tmpl.lit,
        ECDSAAdd.Baselines.normalizeProgram, List.map_map, ECDSAAdd.ShorPort.TInstr.map,
        Function.comp_def]
    | lookup c ports =>
      change portTemplate c ports address ++ specialize (normalizeW code) address =
        ECDSAAdd.ShorPort.Tmpl.map ECDSAAdd.Baselines.normalizeInstr
          (portTemplate c ports address ++ specialize code address)
      rw [ih]
      unfold ECDSAAdd.ShorPort.Tmpl.map
      rw [List.map_append]
      change portTemplate c ports address ++ _ =
        ECDSAAdd.ShorPort.Tmpl.map ECDSAAdd.Baselines.normalizeInstr (portTemplate c ports address) ++ _
      rw [portTemplate_normalize]

theorem specialize_normalize_run {n : Nat} (read : ConstantBit n → Bool)
    (code : WCode n) (address : Nat) (m : List Bool) (st : ECDSAAdd.State) :
    ECDSAAdd.run ((specialize (normalizeW code) address).instantiate read) m st =
      ECDSAAdd.run ((specialize code address).instantiate read) m st := by
  rw [specialize_normalize, ECDSAAdd.ShorPort.Tmpl.instantiate_normalize,
    ECDSAAdd.Baselines.normalize_run]

theorem literalRecords_normalize {n : Nat} (code : WCode n) :
    literalRecords (normalizeW code) = literalRecords code := by
  induction code with
  | nil => rfl
  | cons i code ih =>
    simp only [normalizeW] at ih
    cases i <;> simp [normalizeW, normalizeWInstr, literalRecords,
      ECDSAAdd.Baselines.normalize_measurements, ih]

theorem literalToffolis_normalize {n : Nat} (code : WCode n) :
    literalToffolis (normalizeW code) ≤ literalToffolis code := by
  induction code with
  | nil => exact le_rfl
  | cons i code ih =>
    cases i with
    | literal p =>
      simpa [normalizeW, normalizeWInstr, literalToffolis] using
        Nat.add_le_add (ECDSAAdd.Baselines.normalize_toffoli p) ih
    | lookup c p => simpa [normalizeW, normalizeWInstr, literalToffolis] using ih

@[simp] theorem traversals_normalize {n : Nat} (code : WCode n) :
    traversals (normalizeW code) = traversals code := by
  induction code with
  | nil => rfl
  | cons i code ih =>
    simp only [normalizeW] at ih
    cases i <;> simp [normalizeW, normalizeWInstr, traversals, ih]

theorem placed_normalize {n : Nat} (bits paths : List Wire) (root : Wire) (code : WCode n)
    (hp : ∀ i ∈ code, Placed bits paths root i) :
    ∀ i ∈ normalizeW code, Placed bits paths root i := by
  intro i hi
  obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hi
  have h := hp j hj
  cases j with
  | literal p => simpa [normalizeWInstr, Placed, ECDSAAdd.Baselines.normalize_wires] using h
  | lookup c p => exact h

theorem layouts_of_placed {n : Nat} (bits paths : List Wire) (root : Wire) (code : WCode n)
    (hl : bits.length ≤ paths.length) (hp : ∀ i ∈ code, Placed bits paths root i) :
    LookupLayouts bits paths root code :=
  ⟨hl, fun c p hm => (hp (.lookup c p) hm).1⟩

theorem portProgram_wellFormed {n : Nat} (ports : List (LookupPort n))
    (bits paths : List Wire) (q start : Nat) (hl : bits.length ≤ paths.length)
    (hn : (q :: bits ++ paths).Nodup)
    (hd : (q :: bits ++ paths).Disjoint (portTargets ports)) :
    (lookupProgram n (portOps ports bits paths q) start).WellFormed := by
  apply lookupProgram_wellFormed
  apply unaryLookupOps_physical _ _ _ _ (tableAddressTree_layout _ _ _ _ _ hl hn)
  intro label root hr g hg
  obtain ⟨port, hp, rfl⟩ := List.mem_map.mp hg
  change root ≠ port.target
  intro he
  have hroot : root ∈ q :: bits ++ paths := by
    rcases List.mem_cons.mp hr with rfl | h
    · simp
    · simp [h]
  have htarget : port.target ∈ portTargets ports := List.mem_map.mpr ⟨port, hp, rfl⟩
  exact List.disjoint_left.mp hd (by simpa [he] using hroot) htarget

/-- Physical literal segments and disjoint lookup leaves emit a valid straight program. -/
theorem compile_wellFormed {n : Nat} (bits paths : List Wire) (root : Wire) (code : WCode n)
    (hl : bits.length ≤ paths.length) (hp : ∀ i ∈ code, Placed bits paths root i)
    (hv : ∀ p, WInstr.literal p ∈ code → ∀ i ∈ p, ECDSAAdd.Challenge.instructionValid i)
    (start : Nat) : (compile bits paths root code start).WellFormed := by
  induction code generalizing start with
  | nil => trivial
  | cons i code ih =>
    have ht := ih (fun j hj => hp j (List.mem_cons_of_mem _ hj))
      (fun p hm => hv p (List.mem_cons_of_mem _ hm))
    have hi := hp i (by simp)
    cases i with
    | literal p =>
      simp only [compile, NaiveChallenge.wellFormed_castFinish]
      apply straight_append_wellFormed
      · apply Bridge.translate_wellFormed
        intro j hj
        obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hj
        exact hv p (by simp) k hk
      · exact ht _
    | lookup c p =>
      simp only [compile, NaiveChallenge.wellFormed_castFinish]
      apply straight_append_wellFormed
      · apply portProgram_wellFormed _ _ _ _ _ hl hi.1
        exact List.disjoint_left.mpr (fun w hw hm =>
          List.disjoint_left.mp hi.2.2 (List.mem_cons_of_mem root hw) hm)
      · exact ht _

end
end ShorECDLP.Entrant.WEX

namespace ShorECDLP.Entrant.WEX
open Quantum Challenge Paper2607_13816 Paper2607_13816.ChallengeMigration
open Secp256k1
noncomputable section
set_option maxHeartbeats 3000000
local instance : Fact (Nat.Prime p) := ⟨Secp256k1.p_prime⟩

/-- The finite-addend specification in the bridge's full-state form, at any table size. -/
theorem finite_BSpec {n : Nat} {read : ConstantBit n → Bool} {row rowD : Fin n}
    {cx cy : ECDSAAdd.Fp} (hc : ECDSAAdd.Secp256k1.curve.toAffine.Nonsingular cx cy) (k : Nat)
    (hk : ECDSAAdd.ShorPort.toA (.some hc) = k • G)
    (h : ECDSAAdd.ShorPort.RowReads read row (.some hc))
    (hD : ECDSAAdd.ShorPort.RowReads read rowD (.some hc + .some hc)) :
    Bridge.BSpec ((ECDSAAdd.ShorPort.finiteT ECDSAAdd.Baselines.layout row rowD).instantiate read)
      (ECDSAAdd.ShorPort.toA (.some hc)) ECDSAAdd.Baselines.layout.work := by
  intro b R
  have spec := ECDSAAdd.ShorPort.finiteT_spec ECDSAAdd.Baselines.layout
    ECDSAAdd.Baselines.layout_widths ECDSAAdd.Baselines.layout_nodup hc k hk h hD (Bridge.toB R) b
  refine ECDSAAdd.Triple.conseq ?_ spec ?_
  · intro s hs
    obtain ⟨hb, hR, hw⟩ := hs
    exact ⟨⟨hb, hR⟩, (ECDSAAdd.Arithmetic.regValue_zero _ _).mpr hw⟩
  · intro s hs
    obtain ⟨⟨hb, hR⟩, hw⟩ := hs
    refine ⟨hb, ?_, (ECDSAAdd.Arithmetic.regValue_zero _ _).mp hw⟩
    cases b <;> simpa [Secp256k1.controlledPointResult, Bridge.toB_add] using hR

/-- Full-state coherent native addition, before point-port transport and corner adaptation. -/
theorem native_point_coherent (read : ConstantBit 32768 → Bool)
    (rows doubles : Nat → Fin 32768) (hd : rows 0 ≠ doubles 0)
    (points : Nat → Point) (inputPoint : BasisState → Point)
    (hspec : ∀ address, Bridge.BSpec
      ((ECDSAAdd.ShorPort.finiteT ECDSAAdd.Baselines.layout (rows address)
        (doubles address)).instantiate read) (points address) ECDSAAdd.Baselines.layout.work)
    (hsupport : ∀ address, Bridge.BSupport
      ((ECDSAAdd.ShorPort.finiteT ECDSAAdd.Baselines.layout (rows address)
        (doubles address)).instantiate read) ECDSAAdd.Baselines.layout.work)
    (start : Nat) (history : Fin start → Bool) :
    CoherentlyImplementsOn
      ((compile nativeBits nativePaths nativeRoot
        (normalizeW (wFinite ECDSAAdd.Baselines.layout rows doubles)) start).instantiate read history)
      (Finsupp.lmapDomain ℂ ℂ (fun s => writeReg Bridge.pointWires
        (encode (Secp256k1.controlledPointResult (s Bridge.bControl) (inputPoint s)
          (points (tableAddressValue nativeBits s)))).val s))
      (fun s => Clean nativePaths s ∧ s nativeRoot = true ∧
        regValue Bridge.pointWires s = encodeNat (inputPoint s) ∧
        Clean ECDSAAdd.Baselines.layout.work s) := by
  apply compile_specialization_coherent read nativeBits nativePaths nativeRoot _ (by simp [nativeBits, nativePaths])
    (placed_normalize _ _ _ _ (native_placed rows doubles hd))
  intro s hs m
  rw [specialize_normalize_run, specialize_finite]
  exact Bridge.run_of_triple _ _ _ (hspec _) (hsupport _) s (inputPoint s) hs.1 hs.2 m

/-- Uniform record count and conservative T bound after physical normalization. -/
theorem native_normalized_counts (rows doubles : Nat → Fin 32768) (hd : rows 0 ≠ doubles 0)
    (read : ConstantBit 32768 → Bool) (start : Nat) (history : Fin start → Bool) :
    codeRecords nativeBits nativePaths nativeRoot
      (normalizeW (wFinite ECDSAAdd.Baselines.layout rows doubles)) = 2604421 ∧
    ((compile nativeBits nativePaths nativeRoot
      (normalizeW (wFinite ECDSAAdd.Baselines.layout rows doubles)) start).instantiate read history).tCount
        ≤ 22847195 := by
  have hp := placed_normalize _ _ _ _ (native_placed rows doubles hd)
  have layouts := layouts_of_placed nativeBits nativePaths nativeRoot _ (by simp [nativeBits, nativePaths]) hp
  obtain ⟨ht, hm⟩ := finite_literal_counts ECDSAAdd.Baselines.layout
    ECDSAAdd.Baselines.layout_widths ECDSAAdd.Baselines.layout_nodup rows doubles 0 hd
  constructor
  · rw [codeRecords_eq _ _ _ _ layouts, literalRecords_normalize, hm, traversals_normalize,
      traversals_finite]
    norm_num [nativeBits]
  · rw [compile_tCount _ _ _ _ _ layouts, traversals_normalize, traversals_finite]
    have hnorm := literalToffolis_normalize (wFinite ECDSAAdd.Baselines.layout rows doubles)
    rw [ht] at hnorm
    simp only [nativeBits, List.length_range']
    calc
      _ ≤ 7 * 2215341 + 7 * 32 * (2 ^ 15 - 1) :=
        Nat.add_le_add_right (Nat.mul_le_mul_left 7 hnorm) _
      _ = 22847195 := by norm_num

end
end ShorECDLP.Entrant.WEX

namespace ShorECDLP.Entrant.Bridge
open Quantum Secp256k1 Challenge NaiveChallenge
open ECDSAAdd.ShorPort (Tmpl finiteT maskedT xorT maskedPointT pairXorT shortXorT bitTestT
  pairTailT zeroWithT pairEqualT shortEqualT constAddT recoveryT genericT cornersT)
noncomputable section

local instance : Fact (Nat.Prime p) := ⟨p_prime⟩

/-! ## Port templates as bridge templates -/

section PortGeneric
variable {n : Nat}

/-- An ecdsa-lib template instruction as a bridge template instruction. -/
def ofPort : ECDSAAdd.ShorPort.TInstr n → TInstr n
  | .lit i => .lit i
  | .gated r v i => .when r v i

theorem ofPort_instantiate (read : ConstantBit n → Bool) (g : ECDSAAdd.ShorPort.TInstr n) :
    (ofPort g).instantiate read = g.instantiate read := by
  cases g <;> rfl

theorem instB_ofPort (read : ConstantBit n → Bool) (t : Tmpl n) :
    instB read (List.map ofPort t) = t.instantiate read := by
  induction t with
  | nil => rfl
  | cons g t ih =>
    show (ofPort g).instantiate read ++ instB read (List.map ofPort t) =
      g.instantiate read ++ ECDSAAdd.ShorPort.Tmpl.instantiate read t
    rw [ih, ofPort_instantiate]

/-! ### Gated instructions -/

/-- Every gated instruction of `t` satisfies `P`. -/
def PortGated (P : ECDSAAdd.Instr → Prop) (t : Tmpl n) : Prop :=
  ∀ r v i, ECDSAAdd.ShorPort.TInstr.gated r v i ∈ t → P i

/-- The gated gates of the template: an `X`, or a `CX` on distinct wires, on sites of `S`. -/
def PortGood (S : List Nat) : ECDSAAdd.Instr → Prop
  | .X w => w ∈ S
  | .CX c w => c ≠ w ∧ c ∈ S ∧ w ∈ S
  | _ => False

theorem portGated_nil {P : ECDSAAdd.Instr → Prop} : PortGated P ([] : Tmpl n) := by
  intro r v i h
  simp at h

theorem portGated_cons_gated {P : ECDSAAdd.Instr → Prop} {r : ConstantBit n} {v : Bool}
    {i : ECDSAAdd.Instr} {t : Tmpl n} (hi : P i) (ht : PortGated P t) :
    PortGated P (ECDSAAdd.ShorPort.TInstr.gated r v i :: t) := by
  intro r' v' i' h
  rcases List.mem_cons.mp h with h | h
  · cases h
    exact hi
  · exact ht r' v' i' h

theorem portGated_cons_lit {P : ECDSAAdd.Instr → Prop} {i : ECDSAAdd.Instr} {t : Tmpl n}
    (ht : PortGated P t) : PortGated P (ECDSAAdd.ShorPort.TInstr.lit i :: t) := by
  intro r' v' i' h
  rcases List.mem_cons.mp h with h | h
  · cases h
  · exact ht r' v' i' h

theorem portGated_append {P : ECDSAAdd.Instr → Prop} {s t : Tmpl n} (hs : PortGated P s)
    (ht : PortGated P t) : PortGated P (s ++ t) := by
  intro r v i h
  rcases List.mem_append.mp h with h | h
  · exact hs r v i h
  · exact ht r v i h

theorem portGated_append_iff {P : ECDSAAdd.Instr → Prop} (s t : Tmpl n) :
    PortGated P (s ++ t) ↔ PortGated P s ∧ PortGated P t :=
  ⟨fun h => ⟨fun r v i hm => h r v i (List.mem_append_left _ hm),
    fun r v i hm => h r v i (List.mem_append_right _ hm)⟩,
   fun h => portGated_append h.1 h.2⟩

theorem portGated_lit {P : ECDSAAdd.Instr → Prop} (p : ECDSAAdd.Program) :
    PortGated P (ECDSAAdd.ShorPort.Tmpl.lit p : Tmpl n) := by
  intro r v i hm
  obtain ⟨j, -, hj⟩ := List.mem_map.mp hm
  cases hj

/-! ### Gated-instruction counts -/

def portGOne : ECDSAAdd.ShorPort.TInstr n → Nat
  | .lit _ => 0
  | .gated _ _ _ => 1

/-- The number of gated instructions of a template. -/
def portGCount (t : Tmpl n) : Nat := (List.map portGOne t).sum

theorem portGCount_nil : portGCount ([] : Tmpl n) = 0 := rfl

theorem portGCount_cons (g : ECDSAAdd.ShorPort.TInstr n) (t : Tmpl n) :
    portGCount (g :: t) = portGOne g + portGCount t := by
  simp only [portGCount, List.map_cons, List.sum_cons]

theorem portGCount_append (s t : Tmpl n) :
    portGCount (s ++ t) = portGCount s + portGCount t := by
  simp only [portGCount, List.map_append, List.sum_append]

theorem portGCount_lit (p : ECDSAAdd.Program) :
    portGCount (ECDSAAdd.ShorPort.Tmpl.lit p : Tmpl n) = 0 := by
  induction p with
  | nil => rfl
  | cons i p ih =>
    show portGCount (ECDSAAdd.ShorPort.TInstr.lit i :: (ECDSAAdd.ShorPort.Tmpl.lit p : Tmpl n)) = 0
    simp only [portGCount_cons, ih, portGOne, Nat.add_zero]

/-! ### Static consequences of one instantiation -/

theorem portLit_mem (read : ConstantBit n → Bool) {t : Tmpl n} {i : ECDSAAdd.Instr}
    (h : ECDSAAdd.ShorPort.TInstr.lit i ∈ t) : i ∈ t.instantiate read :=
  List.mem_flatMap.mpr ⟨_, h, List.mem_singleton_self i⟩

theorem portStatic {S : List Nat} {t : Tmpl n} (hg : PortGated (PortGood S) t) :
    ∀ g ∈ List.map ofPort t, g.Static := by
  intro g hg'
  obtain ⟨g0, hg0, rfl⟩ := List.mem_map.mp hg'
  cases g0 with
  | lit i => trivial
  | gated r v i =>
    cases i with
    | measureX w c0 c1 => exact False.elim (hg r v _ hg0)
    | _ => trivial

theorem portMeas (read : ConstantBit n → Bool) {S : List Nat} {t : Tmpl n}
    (hg : PortGated (PortGood S) t) :
    tmplMeas (List.map ofPort t) = ECDSAAdd.measurementCount (t.instantiate read) := by
  induction t with
  | nil => rfl
  | cons g t ih =>
    have ht : PortGated (PortGood S) t := fun r v i h => hg r v i (List.mem_cons_of_mem _ h)
    rw [List.map_cons, tmplMeas, ih ht, ECDSAAdd.ShorPort.Tmpl.instantiate_cons,
      ECDSAAdd.measurementCount_append]
    congr 1
    cases g with
    | lit i => cases i <;> rfl
    | gated r v i =>
      have hi := hg r v i List.mem_cons_self
      cases i with
      | X a =>
        show 0 = ECDSAAdd.measurementCount (if read r = v then [ECDSAAdd.Instr.X a] else [])
        split <;> rfl
      | CX a b =>
        show 0 = ECDSAAdd.measurementCount (if read r = v then [ECDSAAdd.Instr.CX a b] else [])
        split <;> rfl
      | CCX a b c => exact False.elim hi
      | measureX w c0 c1 => exact False.elim hi

theorem portToffoli (read : ConstantBit n → Bool) {S : List Nat} {t : Tmpl n}
    (hg : PortGated (PortGood S) t) :
    tmplToffoli (List.map ofPort t) = ECDSAAdd.toffoliCount (t.instantiate read) := by
  induction t with
  | nil => rfl
  | cons g t ih =>
    have ht : PortGated (PortGood S) t := fun r v i h => hg r v i (List.mem_cons_of_mem _ h)
    have e : tmplToffoli (List.map ofPort (g :: t)) =
        (ofPort g).toffoli + tmplToffoli (List.map ofPort t) := by
      simp only [tmplToffoli, List.map_cons, List.sum_cons]
    rw [e, ih ht, ECDSAAdd.ShorPort.Tmpl.instantiate_cons, ECDSAAdd.toffoliCount_append]
    congr 1
    cases g with
    | lit i => cases i <;> rfl
    | gated r v i =>
      have hi := hg r v i List.mem_cons_self
      cases i with
      | X a =>
        show 0 = ECDSAAdd.toffoliCount (if read r = v then [ECDSAAdd.Instr.X a] else [])
        split <;> rfl
      | CX a b =>
        show 0 = ECDSAAdd.toffoliCount (if read r = v then [ECDSAAdd.Instr.CX a b] else [])
        split <;> rfl
      | CCX a b c => exact False.elim hi
      | measureX w c0 c1 => exact False.elim hi

theorem portSlots (read : ConstantBit n → Bool) (t : Tmpl n) :
    tmplSlots (List.map ofPort t) ≤
      3 * ECDSAAdd.Challenge.gateSlots (t.instantiate read) + portGCount t := by
  induction t with
  | nil => exact Nat.zero_le _
  | cons g t ih =>
    have e : tmplSlots (List.map ofPort (g :: t)) =
        (ofPort g).slots + tmplSlots (List.map ofPort t) := by
      simp only [tmplSlots, List.map_cons, List.sum_cons]
    have hone : (ofPort g).slots ≤
        3 * ECDSAAdd.Challenge.gateSlots (g.instantiate read) + portGOne g := by
      cases g with
      | lit i =>
        have h1 : ECDSAAdd.Challenge.gateSlots ((ECDSAAdd.ShorPort.TInstr.lit i : ECDSAAdd.ShorPort.TInstr n).instantiate read) =
            ECDSAAdd.Challenge.instructionSlots i := by
          show ECDSAAdd.Challenge.gateSlots [i] = _
          simp [ECDSAAdd.Challenge.gateSlots]
        rw [h1]
        cases i with
        | measureX w c0 c1 =>
          show corrsSlots c0 + corrsSlots c1 ≤ 3 * (1 + c0.length + c1.length) + 0
          unfold corrsSlots
          omega
        | _ =>
          show 1 ≤ 3 * 1 + 0
          omega
      | gated r v i =>
        have h1 : (ofPort (ECDSAAdd.ShorPort.TInstr.gated r v i : ECDSAAdd.ShorPort.TInstr n)).slots
            ≤ 1 := by
          cases i with
          | measureX w c0 c1 => exact Nat.zero_le 1
          | _ => exact Nat.le_refl 1
        show _ ≤ _ + 1
        omega
    rw [e, ECDSAAdd.ShorPort.Tmpl.instantiate_cons, ECDSAAdd.Challenge.gateSlots_append,
      portGCount_cons]
    omega

theorem portCorrWires {w : Nat} :
    ∀ cs : List ECDSAAdd.Correction, w ∈ cs.flatMap corrWires → w ∈ ECDSAAdd.correctionWires cs
  | [], h => by simp at h
  | c :: cs, h => by
    rw [List.flatMap_cons, List.mem_append] at h
    cases c with
    | Z a =>
      simp only [ECDSAAdd.correctionWires, Finset.mem_union, Finset.mem_singleton]
      rcases h with h | h
      · left
        simpa [corrWires] using h
      · exact Or.inr (portCorrWires cs h)
    | CZ a b =>
      simp only [ECDSAAdd.correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton]
      rcases h with h | h
      · left
        simpa [corrWires] using h
      · exact Or.inr (portCorrWires cs h)

theorem portInstrWires {i : ECDSAAdd.Instr} {w : Nat} (h : w ∈ instrWires i) :
    w ∈ ECDSAAdd.Instr.wires i := by
  cases i with
  | X a => simpa [instrWires, ECDSAAdd.Instr.wires] using h
  | CX a b => simpa [instrWires, ECDSAAdd.Instr.wires] using h
  | CCX a b c => simpa [instrWires, ECDSAAdd.Instr.wires] using h
  | measureX t c0 c1 =>
    simp only [instrWires, List.mem_cons, List.mem_append] at h
    simp only [ECDSAAdd.Instr.wires, Finset.mem_union, Finset.mem_singleton]
    rcases h with h | h | h
    · exact Or.inl (Or.inl h)
    · exact Or.inl (Or.inr (portCorrWires c0 h))
    · exact Or.inr (portCorrWires c1 h)

theorem portMemWires {i : ECDSAAdd.Instr} {w : Nat} (hw : w ∈ ECDSAAdd.Instr.wires i) :
    ∀ {p : ECDSAAdd.Program}, i ∈ p → w ∈ ECDSAAdd.wires p
  | [], hi => by simp at hi
  | j :: p, hi => by
    simp only [ECDSAAdd.wires, Finset.mem_union]
    rcases List.mem_cons.mp hi with rfl | h
    · exact Or.inl hw
    · exact Or.inr (portMemWires hw h)

theorem portGoodWires {S : List Nat} {i : ECDSAAdd.Instr} {w : Nat} (h : PortGood S i)
    (hw : w ∈ instrWires i) : w ∈ S := by
  cases i with
  | X a =>
    have h' : a ∈ S := h
    simp only [instrWires, List.mem_singleton] at hw
    rw [hw]
    exact h'
  | CX a b =>
    have h' : a ≠ b ∧ a ∈ S ∧ b ∈ S := h
    simp only [instrWires, List.mem_cons, List.not_mem_nil, or_false] at hw
    rcases hw with hw | hw
    · rw [hw]; exact h'.2.1
    · rw [hw]; exact h'.2.2
  | CCX a b c => exact False.elim h
  | measureX t c0 c1 => exact False.elim h

theorem portWires (read : ConstantBit n → Bool) {S : List Nat} {t : Tmpl n}
    (hg : PortGated (PortGood S) t)
    (hw : ECDSAAdd.wires (t.instantiate read) ⊆ S.toFinset) :
    ∀ w ∈ tmplWires (List.map ofPort t), w ∈ S := by
  intro w hw'
  rw [tmplWires, List.mem_flatMap] at hw'
  obtain ⟨a, ha, hwa⟩ := hw'
  obtain ⟨g, hg0, rfl⟩ := List.mem_map.mp ha
  cases g with
  | lit i =>
    exact List.mem_toFinset.mp (hw (portMemWires (portInstrWires hwa) (portLit_mem read hg0)))
  | gated r v i => exact portGoodWires (hg r v i hg0) hwa

theorem portValid (read : ConstantBit n → Bool) {S : List Nat} {t : Tmpl n}
    (hg : PortGated (PortGood S) t)
    (hv : ∀ i ∈ t.instantiate read, ECDSAAdd.Challenge.instructionValid i) :
    ∀ g ∈ List.map ofPort t, ECDSAAdd.Challenge.instructionValid g.instr := by
  intro g hg'
  obtain ⟨g0, hg0, rfl⟩ := List.mem_map.mp hg'
  cases g0 with
  | lit i => exact hv i (portLit_mem read hg0)
  | gated r v i =>
    have h := hg r v i hg0
    cases i with
    | X a => trivial
    | CX a b =>
      have h' : a ≠ b ∧ a ∈ S ∧ b ∈ S := h
      exact h'.1
    | CCX a b c => exact False.elim h
    | measureX w c0 c1 => exact False.elim h

/-! ### Normalisation -/

theorem portGated_normalize {S : List Nat} {t : Tmpl n} (h : PortGated (PortGood S) t) :
    PortGated (PortGood S) (ECDSAAdd.ShorPort.Tmpl.map ECDSAAdd.Baselines.normalizeInstr t) := by
  intro r v i hm
  obtain ⟨g, hg, he⟩ := List.mem_map.mp hm
  cases g with
  | lit j => simp [ECDSAAdd.ShorPort.TInstr.map] at he
  | gated r' v' j =>
    have hj := h r' v' j hg
    simp only [ECDSAAdd.ShorPort.TInstr.map, ECDSAAdd.ShorPort.TInstr.gated.injEq] at he
    obtain ⟨-, -, rfl⟩ := he
    cases j with
    | X a => exact hj
    | CX a b => exact hj
    | CCX a b c => exact False.elim hj
    | measureX w c0 c1 => exact False.elim hj

theorem portGCount_map (f : ECDSAAdd.Instr → ECDSAAdd.Instr) (t : Tmpl n) :
    portGCount (ECDSAAdd.ShorPort.Tmpl.map f t) = portGCount t := by
  induction t with
  | nil => rfl
  | cons g t ih =>
    show portGCount (ECDSAAdd.ShorPort.TInstr.map f g :: ECDSAAdd.ShorPort.Tmpl.map f t) =
      portGCount (g :: t)
    rw [portGCount_cons, portGCount_cons, ih]
    cases g <;> rfl

end PortGeneric

/-! ## The gated gates of `finiteT` -/

section PortCombinators
variable {n : Nat} {P : ECDSAAdd.Instr → Prop}

theorem portGated_maskedT (c : Nat) : ∀ (ws : List Nat), (∀ w ∈ ws, P (.CX c w)) →
    ∀ ref : Nat → ConstantBit n, PortGated P (maskedT c ws ref)
  | [], _, _ => portGated_nil
  | w :: ws, h, _ => portGated_cons_gated (h w List.mem_cons_self)
      (portGated_maskedT c ws (fun w' hw' => h w' (List.mem_cons_of_mem _ hw')) _)

theorem portGated_xorT : ∀ (ws : List Nat), (∀ w ∈ ws, P (.X w)) →
    ∀ ref : Nat → ConstantBit n, PortGated P (xorT ws ref)
  | [], _, _ => portGated_nil
  | w :: ws, h, _ => portGated_cons_gated (h w List.mem_cons_self)
      (portGated_xorT ws (fun w' hw' => h w' (List.mem_cons_of_mem _ hw')) _)

theorem portGated_maskedPointT (c : Nat) (r : ECDSAAdd.PointReg)
    (h : ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires r, P (.CX c w))
    (fin : ConstantBit n) (xr yr : Nat → ConstantBit n) :
    PortGated P (maskedPointT c r fin xr yr) := by
  have hf : P (.CX c r.finite) := h _ List.mem_cons_self
  have hx : ∀ w ∈ r.x, P (.CX c w) := fun w hw =>
    h w (List.mem_cons_of_mem _ (List.mem_append_left _ hw))
  have hy : ∀ w ∈ r.y, P (.CX c w) := fun w hw =>
    h w (List.mem_cons_of_mem _ (List.mem_append_right _ hw))
  rw [ECDSAAdd.ShorPort.maskedPointT]
  exact portGated_append (portGated_append (portGated_cons_gated hf portGated_nil)
    (portGated_maskedT c r.x hx xr)) (portGated_maskedT c r.y hy yr)

theorem portGated_pairXorT (L : ECDSAAdd.Arithmetic.ControlledPointLayout)
    (hX : ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires L.point, P (.X w))
    (fin : ConstantBit n) (xr : Nat → ConstantBit n) : PortGated P (pairXorT L fin xr) := by
  have hf : P (.X L.point.finite) := hX _ List.mem_cons_self
  have hx : ∀ w ∈ L.point.x, P (.X w) := fun w hw =>
    hX w (List.mem_cons_of_mem _ (List.mem_append_left _ hw))
  rw [ECDSAAdd.ShorPort.pairXorT]
  exact portGated_append (portGated_cons_gated hf portGated_nil) (portGated_xorT _ hx xr)

theorem portGated_shortXorT (L : ECDSAAdd.Arithmetic.ControlledPointLayout)
    (hX : ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires L.point, P (.X w))
    (fin : ConstantBit n) (xr : Nat → ConstantBit n) (y0 : ConstantBit n) :
    PortGated P (shortXorT L fin xr y0) := by
  have hf : P (.X L.point.finite) := hX _ List.mem_cons_self
  have hx : ∀ w ∈ L.point.x, P (.X w) := fun w hw =>
    hX w (List.mem_cons_of_mem _ (List.mem_append_left _ hw))
  have hy : ∀ w ∈ L.point.y.take 1, P (.X w) := fun w hw =>
    hX w (List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_of_mem_take hw)))
  rw [ECDSAAdd.ShorPort.shortXorT]
  exact portGated_append (portGated_append (portGated_cons_gated hf portGated_nil)
    (portGated_xorT _ hx xr)) (portGated_xorT _ hy _)

theorem portGated_bitTestT (w y t : Nat) (r : ConstantBit n) (hy : P (.X y)) :
    PortGated P (bitTestT w y t r) :=
  portGated_cons_gated hy (portGated_cons_lit (portGated_cons_gated hy portGated_nil))

theorem portGated_zeroWithT (T : Nat → Tmpl n) (hT : ∀ w, PortGated P (T w)) :
    ∀ (c : Nat) (bs : List ECDSAAdd.Arithmetic.ZeroBit), PortGated P (zeroWithT T c bs)
  | c, [] => hT c
  | _, b :: bs => portGated_append (portGated_append (portGated_lit _)
      (portGated_zeroWithT T hT b.work bs)) (portGated_lit _)

theorem portGated_pairEqualT (L : ECDSAAdd.Arithmetic.ControlledPointLayout)
    (hX : ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires L.point, P (.X w))
    (hy : P (.X (ECDSAAdd.Entrant.yLow L))) (t₁ t₂ : Nat) (fin : ConstantBit n)
    (xr : Nat → ConstantBit n) (r₁ r₂ : ConstantBit n) :
    PortGated P (pairEqualT L t₁ t₂ fin xr r₁ r₂) := by
  have hz : PortGated P (zeroWithT (pairTailT (ECDSAAdd.Entrant.yLow L) t₁ t₂ r₁ r₂)
      L.control (ECDSAAdd.Entrant.pairPorts L)) :=
    portGated_zeroWithT _ (fun w => portGated_append (portGated_bitTestT _ _ _ _ hy)
      (portGated_bitTestT _ _ _ _ hy)) _ _
  rw [ECDSAAdd.ShorPort.pairEqualT]
  exact portGated_append (portGated_append (portGated_pairXorT L hX fin xr) hz)
    (portGated_pairXorT L hX fin xr)

theorem portGated_shortEqualT (L : ECDSAAdd.Arithmetic.ControlledPointLayout)
    (hX : ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires L.point, P (.X w))
    (c t : Nat) (fin : ConstantBit n) (xr : Nat → ConstantBit n) (y0 : ConstantBit n) :
    PortGated P (shortEqualT L c t fin xr y0) := by
  rw [ECDSAAdd.ShorPort.shortEqualT]
  exact portGated_append (portGated_append (portGated_shortXorT L hX fin xr y0)
    (portGated_lit _)) (portGated_shortXorT L hX fin xr y0)

theorem portGated_constAddT (L : ECDSAAdd.Arithmetic.ControlledPointLayout)
    (hG : ∀ w ∈ L.dialogPool.take 256, P (.CX L.core.generic w))
    (r : List Nat) (ref : Nat → ConstantBit n) : PortGated P (constAddT L r ref) := by
  have hm : PortGated P (maskedT L.core.generic (L.recoveryConstant r).src ref) :=
    portGated_maskedT _ _ hG ref
  rw [ECDSAAdd.ShorPort.constAddT]
  exact portGated_append (portGated_append hm (portGated_lit _)) hm

/-- Every gated gate of the block template is an `X` on a point wire or on `yLow`, or a `CX`
from an in-place flag to a point wire, or from `core.generic` to the constant source. -/
theorem portGated_finiteT (L : ECDSAAdd.Arithmetic.ControlledPointLayout)
    (hX : ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires L.point, P (.X w))
    (hy : P (.X (ECDSAAdd.Entrant.yLow L)))
    (hC : ∀ c ∈ L.inPlaceFlags,
      ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires L.point, P (.CX c w))
    (hG : ∀ w ∈ L.dialogPool.take 256, P (.CX L.core.generic w)) (row rowD : Fin n) :
    PortGated P (finiteT L row rowD) := by
  have hpe := portGated_pairEqualT (n := n) L hX hy
  have hse := portGated_shortEqualT (n := n) L hX
  have hca := portGated_constAddT (n := n) L hG
  have hmp : ∀ c ∈ L.inPlaceFlags, ∀ (fin : ConstantBit n) (xr yr : Nat → ConstantBit n),
      PortGated P (maskedPointT c L.point fin xr yr) :=
    fun c hc fin xr yr => portGated_maskedPointT c L.point (hC c hc) fin xr yr
  have m1 : L.infinitySelect ∈ L.inPlaceFlags := by
    simp [ECDSAAdd.Arithmetic.ControlledPointLayout.inPlaceFlags]
  have m2 : L.doubleSelect ∈ L.inPlaceFlags := by
    simp [ECDSAAdd.Arithmetic.ControlledPointLayout.inPlaceFlags]
  have m3 : L.genericSelect ∈ L.inPlaceFlags := by
    simp [ECDSAAdd.Arithmetic.ControlledPointLayout.inPlaceFlags]
  have m4 : L.core.equalNegY ∈ L.inPlaceFlags := by
    simp [ECDSAAdd.Arithmetic.ControlledPointLayout.inPlaceFlags]
  simp only [ECDSAAdd.ShorPort.finiteT, ECDSAAdd.ShorPort.genericT, ECDSAAdd.ShorPort.recoveryT,
    ECDSAAdd.ShorPort.cornersT, portGated_append_iff, portGated_lit, hpe, hse, hca, hmp _ m1,
    hmp _ m2, hmp _ m3, hmp _ m4, and_self]

/-! ### Counts -/

theorem portGCount_maskedT (c : Nat) : ∀ (ws : List Nat) (ref : Nat → ConstantBit n),
    portGCount (maskedT c ws ref) = ws.length
  | [], _ => rfl
  | w :: ws, ref => by
    rw [ECDSAAdd.ShorPort.maskedT, portGCount_cons, portGCount_maskedT c ws, List.length_cons]
    simp only [portGOne]
    omega

theorem portGCount_xorT : ∀ (ws : List Nat) (ref : Nat → ConstantBit n),
    portGCount (xorT ws ref) = ws.length
  | [], _ => rfl
  | w :: ws, ref => by
    rw [ECDSAAdd.ShorPort.xorT, portGCount_cons, portGCount_xorT ws, List.length_cons]
    simp only [portGOne]
    omega

theorem portGCount_maskedPointT (c : Nat) (r : ECDSAAdd.PointReg) (fin : ConstantBit n)
    (xr yr : Nat → ConstantBit n) :
    portGCount (maskedPointT c r fin xr yr) = 1 + r.x.length + r.y.length := by
  rw [ECDSAAdd.ShorPort.maskedPointT, portGCount_append, portGCount_append, portGCount_cons,
    portGCount_nil, portGCount_maskedT, portGCount_maskedT]
  simp only [portGOne]

theorem portGCount_pairXorT (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (fin : ConstantBit n)
    (xr : Nat → ConstantBit n) : portGCount (pairXorT L fin xr) = 1 + L.point.x.length := by
  rw [ECDSAAdd.ShorPort.pairXorT, portGCount_append, portGCount_cons, portGCount_nil,
    portGCount_xorT]
  simp only [portGOne]

theorem portGCount_shortXorT (L : ECDSAAdd.Arithmetic.ControlledPointLayout)
    (fin : ConstantBit n) (xr : Nat → ConstantBit n) (y0 : ConstantBit n) :
    portGCount (shortXorT L fin xr y0) = 1 + L.point.x.length + (L.point.y.take 1).length := by
  rw [ECDSAAdd.ShorPort.shortXorT, portGCount_append, portGCount_append, portGCount_cons,
    portGCount_nil, portGCount_xorT, portGCount_xorT]
  simp only [portGOne]

theorem portGCount_pairTailT (y t₁ t₂ : Nat) (r₁ r₂ : ConstantBit n) (w : Nat) :
    portGCount (pairTailT y t₁ t₂ r₁ r₂ w) = 4 := by
  simp only [ECDSAAdd.ShorPort.pairTailT, ECDSAAdd.ShorPort.bitTestT, portGCount_append,
    portGCount_cons, portGCount_nil, portGOne]

theorem portGCount_zeroWithT (T : Nat → Tmpl n) (k : Nat) (hT : ∀ w, portGCount (T w) = k) :
    ∀ (c : Nat) (bs : List ECDSAAdd.Arithmetic.ZeroBit), portGCount (zeroWithT T c bs) = k
  | c, [] => hT c
  | _, b :: bs => by
    simp only [ECDSAAdd.ShorPort.zeroWithT, portGCount_append, portGCount_lit,
      portGCount_zeroWithT T k hT b.work bs]
    omega

theorem portGCount_pairEqualT (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (t₁ t₂ : Nat)
    (fin : ConstantBit n) (xr : Nat → ConstantBit n) (r₁ r₂ : ConstantBit n) :
    portGCount (pairEqualT L t₁ t₂ fin xr r₁ r₂) = 2 * (1 + L.point.x.length) + 4 := by
  rw [ECDSAAdd.ShorPort.pairEqualT, portGCount_append, portGCount_append, portGCount_pairXorT,
    portGCount_zeroWithT _ 4 (portGCount_pairTailT _ _ _ _ _)]
  omega

theorem portGCount_shortEqualT (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (c t : Nat)
    (fin : ConstantBit n) (xr : Nat → ConstantBit n) (y0 : ConstantBit n) :
    portGCount (shortEqualT L c t fin xr y0) =
      2 * (1 + L.point.x.length + (L.point.y.take 1).length) := by
  rw [ECDSAAdd.ShorPort.shortEqualT, portGCount_append, portGCount_append, portGCount_lit,
    portGCount_shortXorT]
  omega

theorem portGCount_constAddT (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (r : List Nat)
    (ref : Nat → ConstantBit n) :
    portGCount (constAddT L r ref) = 2 * (L.recoveryConstant r).src.length := by
  rw [ECDSAAdd.ShorPort.constAddT, portGCount_append, portGCount_append, portGCount_lit,
    portGCount_maskedT]
  omega

/-- The block template has at most 7,706 gated gates. -/
theorem portGCount_finiteT (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (hw : L.Widths)
    (row rowD : Fin n) : portGCount (finiteT L row rowD) ≤ 7706 := by
  have hx : L.point.x.length = 256 := hw.inputX
  have hy : L.point.y.length = 256 := hw.inputY
  have h1 : (L.point.y.take 1).length ≤ 1 := List.length_take_le _ _
  have hd : ∀ r, (L.recoveryConstant r).src.length ≤ 256 := fun r => List.length_take_le _ _
  have hdx := hd L.point.x
  have hdy := hd L.point.y
  simp only [ECDSAAdd.ShorPort.finiteT, ECDSAAdd.ShorPort.genericT, ECDSAAdd.ShorPort.recoveryT,
    ECDSAAdd.ShorPort.cornersT, portGCount_append, portGCount_lit, portGCount_pairEqualT,
    portGCount_shortEqualT, portGCount_constAddT, portGCount_maskedPointT]
  omega

end PortCombinators

/-! ## The gated gates on the fixed layout -/

section PortLayout

theorem portRes_sites (L : ECDSAAdd.Arithmetic.ControlledPointLayout) {w : Nat}
    (h : w ∈ ECDSAAdd.Arithmetic.CompressedPointSquare.residents L) :
    w ∈ ECDSAAdd.Entrant.sitesQ L :=
  List.mem_append_left _ h

theorem portX (L : ECDSAAdd.Arithmetic.ControlledPointLayout) :
    ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires L.point,
      PortGood (ECDSAAdd.Entrant.sitesQ L) (.X w) :=
  fun _ hw => portRes_sites L (List.mem_append_left _ (List.mem_append_left _ hw))

theorem portY (L : ECDSAAdd.Arithmetic.ControlledPointLayout) :
    PortGood (ECDSAAdd.Entrant.sitesQ L) (.X (ECDSAAdd.Entrant.yLow L)) := by
  show ECDSAAdd.Entrant.yLow L ∈ ECDSAAdd.Entrant.sitesQ L
  unfold ECDSAAdd.Entrant.yLow
  cases hy : L.point.y with
  | nil =>
    simp only [List.headD]
    exact portRes_sites L (List.mem_append_left _ (List.mem_append_right _
      (List.mem_singleton_self _)))
  | cons a l =>
    simp only [List.headD]
    have ha : a ∈ L.point.y := by rw [hy]; exact List.mem_cons_self
    exact portRes_sites L (List.mem_append_left _ (List.mem_append_left _
      (List.mem_cons_of_mem _ (List.mem_append_right _ ha))))

theorem portC (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (hn : L.wires.Nodup) :
    ∀ c ∈ L.inPlaceFlags, ∀ w ∈ ECDSAAdd.Arithmetic.PointAddLayout.pointWires L.point,
      PortGood (ECDSAAdd.Entrant.sitesQ L) (.CX c w) := by
  intro c hc w hw
  have hd := L.dialogUsed_nodup hn
  have h1 := (List.nodup_append.mp hd).1
  have h2 := (List.nodup_append.mp h1).2.2
  show c ≠ w ∧ c ∈ ECDSAAdd.Entrant.sitesQ L ∧ w ∈ ECDSAAdd.Entrant.sitesQ L
  exact ⟨fun e => h2 w (List.mem_append_left _ hw) c hc e.symm,
    portRes_sites L (List.mem_append_right _ hc),
    portRes_sites L (List.mem_append_left _ (List.mem_append_left _ hw))⟩

theorem portG (L : ECDSAAdd.Arithmetic.ControlledPointLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) :
    ∀ w ∈ L.dialogPool.take 256,
      PortGood (ECDSAAdd.Entrant.sitesQ L) (.CX L.core.generic w) := by
  intro w hw'
  have hd := L.dialogUsed_nodup hn
  have h3 := (List.nodup_append.mp hd).2.2
  have hgen : L.core.generic ∈ L.inPlaceFlags := by
    simp [ECDSAAdd.Arithmetic.ControlledPointLayout.inPlaceFlags]
  have hwp : w ∈ L.dialogPool := List.mem_of_mem_take hw'
  show L.core.generic ≠ w ∧ L.core.generic ∈ ECDSAAdd.Entrant.sitesQ L ∧
    w ∈ ECDSAAdd.Entrant.sitesQ L
  refine ⟨h3 _ (List.mem_append_right _ hgen) _ hwp,
    portRes_sites L (List.mem_append_right _ hgen), ?_⟩
  rw [ECDSAAdd.Entrant.pool_block L hw 256 (by norm_num)] at hw'
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hw'
  simp only [ECDSAAdd.Entrant.sitesQ, ECDSAAdd.Entrant.sharedPoolQ, List.mem_append]
  refine Or.inr (Or.inl (Or.inl (Or.inl (List.mem_map.mpr ⟨i, ?_, rfl⟩))))
  rw [List.mem_range'_1] at hi ⊢
  omega

/-- The point register of the ECDSAAdd challenge is the bridge's point register. -/
theorem portPointWires :
    ECDSAAdd.Arithmetic.PointAddLayout.pointWires ECDSAAdd.Challenge.point = pointWires := by
  rw [pointWires_split]
  show 1 :: ((List.range 256).map (· + 2) ++ (List.range 256).map (· + 258)) = _
  rw [map_add_range, map_add_range]

theorem portWorkEq :
    (ECDSAAdd.Baselines.layout.work : List Nat) = List.range' 514 9300 ++ [9814, 9815, 9816] := by
  have hc := ECDSAAdd.Baselines.core_wires
  have hsplit : List.range' 1 9813 = List.range' 1 513 ++ List.range' 514 9300 :=
    (List.range'_append (s := 1) (m := 513) (n := 9300) (step := 1)).symm
  have hin : ECDSAAdd.Arithmetic.PointAddLayout.pointWires ECDSAAdd.Baselines.layout.core.input =
      List.range' 1 513 := portPointWires
  have h2 : ECDSAAdd.Arithmetic.PointAddLayout.pointWires ECDSAAdd.Baselines.layout.core.output ++
      ECDSAAdd.Baselines.layout.core.work = List.range' 514 9300 := by
    rw [ECDSAAdd.Arithmetic.PointAddLayout.wires, hsplit, List.append_assoc, hin] at hc
    exact List.append_cancel_left hc
  show ECDSAAdd.Arithmetic.PointAddLayout.pointWires ECDSAAdd.Baselines.layout.core.output ++
      (ECDSAAdd.Baselines.layout.core.work ++ [9814, 9815, 9816]) = _
  rw [← List.append_assoc, h2]

theorem portWork_range : ∀ w : Nat, w ∈ ECDSAAdd.Baselines.layout.work → 514 ≤ w ∧ w < 206624 := by
  intro w hw
  have hw' : w ∈ List.range' 514 9300 ++ [9814, 9815, 9816] := by rw [← portWorkEq]; exact hw
  rcases List.mem_append.mp hw' with h | h
  · have := List.mem_range'_1.mp h
    omega
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at h
    omega

theorem portPool_lt (i : Nat) : ECDSAAdd.Baselines.layout.core.poolWire i < 9817 := by
  show (List.range' 4115 5699).getD i 0 < 9817
  rw [List.getD_eq_getElem?_getD]
  cases h : (List.range' 4115 5699)[i]? with
  | none => simp
  | some v =>
    have hv := List.mem_of_getElem? h
    rw [List.mem_range'_1] at hv
    simp only [Option.getD_some]
    omega

theorem portSites_lt : ∀ w : Nat, w ∈ ECDSAAdd.Entrant.sitesQ ECDSAAdd.Baselines.layout →
    w < 9817 := by
  intro w hw
  rw [ECDSAAdd.Entrant.sitesQ, List.mem_append] at hw
  rcases hw with hw | hw
  · rw [ECDSAAdd.Arithmetic.CompressedPointSquare.residents, List.mem_append,
      List.mem_append] at hw
    rcases hw with (hw | hw) | hw
    · have hp : w ∈ pointWires := by rw [← portPointWires]; exact hw
      rw [pointWires, List.mem_range'_1] at hp
      omega
    · rw [List.mem_singleton] at hw
      rw [hw]
      show (0 : Nat) < 9817
      norm_num
    · have hf : w ∈ ([9816, 9815, 9814, 4113, 4111, 4112, 4114] : List Nat) := hw
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hf
      omega
  · rw [ECDSAAdd.Entrant.sharedPoolQ, List.mem_append, List.mem_append, List.mem_append] at hw
    rcases hw with ((hw | hw) | hw) | hw
    · obtain ⟨i, -, rfl⟩ := List.mem_map.mp hw
      exact portPool_lt i
    · obtain ⟨i, -, rfl⟩ := List.mem_map.mp hw
      exact portPool_lt i
    · rw [List.mem_singleton] at hw
      rw [hw]
      exact portPool_lt _
    · obtain ⟨i, -, rfl⟩ := List.mem_map.mp hw
      exact portPool_lt i

theorem portCover (w : Nat) (h : w < 9817) :
    w = bControl ∨ w ∈ pointWires ∨ w ∈ ECDSAAdd.Baselines.layout.work := by
  by_cases h0 : w = 0
  · left
    exact h0
  by_cases h1 : w < 514
  · right; left
    rw [pointWires, List.mem_range'_1]
    omega
  right; right
  have hw : w ∈ List.range' 514 9300 ++ [9814, 9815, 9816] := by
    by_cases h2 : w < 9814
    · exact List.mem_append_left _ (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    · apply List.mem_append_right
      have : w = 9814 ∨ w = 9815 ∨ w = 9816 := by omega
      rcases this with e | e | e <;> rw [e] <;> simp
  rw [← portWorkEq] at hw
  exact hw

end PortLayout

end
end ShorECDLP.Entrant.Bridge


namespace ShorECDLP.Entrant.WEX
open Quantum Challenge Paper2607_13816 Paper2607_13816.ChallengeMigration
noncomputable section
set_option maxHeartbeats 3000000

abbrev NegLayout := ECDSAAdd.Arithmetic.CompactRecoveryNegateLayout

def NegateValid (K : NegLayout) (p : Nat) (s : BasisState) : Prop :=
  regValue K.word s < p ∧ Clean (K.work ++ [K.cin, K.zero]) s

def negateState (K : NegLayout) (p : Nat) (q : Wire) (s : BasisState) : BasisState :=
  writeReg K.word (if s q then (p - regValue K.word s) % p else regValue K.word s) s

theorem negate_run (K : NegLayout) (q p c : Nat) (hn : (K.wires q).Nodup)
    (hw : K.work.length = K.word.length) (npos : 0 < K.word.length)
    (hpc : p+c = 2 ^ K.word.length) (hc : 1 < c) (hp : 0 < p)
    (s : BasisState) (hs : NegateValid K p s) (m : List Bool) :
    ECDSAAdd.run (K.program q p c) m ⟨false, s⟩ = ⟨false, negateState K p q s⟩ := by
  have h := K.program_correct q hn hw npos p c (regValue K.word s) hpc hc hs.1
    ⟨false, s⟩ m (Bridge.regValueB_eq _ _)
    ((ECDSAAdd.Arithmetic.regValue_zero _ _).mpr (fun w hw => hs.2 w (by simp [hw])))
    (hs.2 _ (by simp)) (hs.2 _ (by simp))
  rw [Bridge.regValueB_eq] at h
  have hword : K.word.Nodup :=
    (List.nodup_cons.mp (List.nodup_cons.mp (List.nodup_cons.mp hn).2).2).2.of_append_left
  have hbound : (if s q then (p-regValue K.word s)%p else regValue K.word s) < 2^K.word.length := by
    have hpN : p ≤ 2^K.word.length := by omega
    split
    · exact (Nat.mod_lt _ hp).trans_le hpN
    · exact hs.1.trans_le hpN
  apply ECDSAAdd.State.extensionality
  · exact h.1
  funext w
  change (ECDSAAdd.run (K.program q p c) m ⟨false, s⟩).basis w = negateState K p q s w
  by_cases hm : w ∈ K.word
  · apply Bridge.regValue_bits K.word _ _ _ w hm
    rw [h.2.1, negateState, Bridge.regValue_writeReg K.word hword _ _ hbound]
  · rw [negateState, Bridge.writeReg_apply_not_mem _ _ _ hm]
    exact h.2.2 w hm

theorem negate_coherent (K : NegLayout) (q p c : Nat) (hn : (K.wires q).Nodup)
    (hw : K.work.length = K.word.length) (npos : 0 < K.word.length)
    (hpc : p+c = 2 ^ K.word.length) (hc : 1 < c) (hp : 0 < p) :
    CoherentlyImplementsOn (literalSource (K.program q p c))
      (Finsupp.lmapDomain ℂ ℂ (negateState K p q)) (NegateValid K p) :=
  literal_coherent _ _ _ (fun s hs m => negate_run K q p c hn hw npos hpc hc hp s hs m)

theorem negate_256_counts (K : NegLayout) (q p c : Nat)
    (hw : K.work.length = K.word.length) (hn : K.word.length = 256) :
    ECDSAAdd.toffoliCount (K.program q p c) = 1022 ∧
      ECDSAAdd.measurementCount (K.program q p c) = 1022 := by
  have h := K.program_counts q p c hw (by omega)
  simpa [hn] using h

end
end ShorECDLP.Entrant.WEX

namespace ShorECDLP.Entrant.WEX
open ECDSAAdd ECDSAAdd.Arithmetic ECDSAAdd.Secp256k1
noncomputable section
set_option maxHeartbeats 3000000

theorem pointY_neg_mod (P : Point) : pointY (-P) = (ECDSAAdd.p - pointY P) % ECDSAAdd.p := by
  rw [ECDSAAdd.ShorPort.pointY_neg, ZMod.neg_val', ECDSAAdd.ShorPort.coords_y]
  norm_num [ShorECDLP.p, ECDSAAdd.p]

theorem pointY_neg_twice_mod (P : Point) :
    (ECDSAAdd.p - pointY (-P)) % ECDSAAdd.p = pointY P := by
  have h := pointY_neg_mod (-P)
  simpa only [neg_neg] using h.symm

theorem run_no_records (p : Program) (hm : measurementCount p = 0) (m : List Bool) (st : State) :
    run p m st = run p ([]) st := by
  rw [← run_take p m st, hm, List.take_zero]

/-- The negative-double word may be cleared with the available doubled coordinates only
when its flag identifies that exact corner. Negation must precede the XOR. -/
theorem negative_corner_clear (K : NegLayout) (q : Wire) (r : PointReg) (D : Point)
    (hk : K.word = r.y) (hn : (K.wires q).Nodup)
    (hw : K.work.length = K.word.length) (npos : 0 < K.word.length)
    (hpc : ECDSAAdd.p + SquareReduction.c = 2 ^ K.word.length)
    (hpoint : (PointAddLayout.pointWires r).Nodup) (hq : q ∉ PointAddLayout.pointWires r)
    (hx : r.x.length = 256) (hy : r.y.length = 256)
    (st : State) (hY : ECDSAAdd.regValue r.y st.basis < ECDSAAdd.p)
    (hwork : ECDSAAdd.regValue K.work st.basis = 0) (hcin : st.basis K.cin = false)
    (hzero : st.basis K.zero = false)
    (hcorner : st.basis q = true → Holds.holds st.basis r (-D)) (m : List Bool) :
    run (K.program q ECDSAAdd.p SquareReduction.c ++ maskedPointConstant q r D) m st =
      run (maskedPointConstant q r (-D)) ([]) st := by
  let u := run (K.program q ECDSAAdd.p SquareReduction.c) m st
  let v := run (maskedPointConstant q r D) ([]) u
  let old := run (maskedPointConstant q r (-D)) ([]) st
  have hN := K.program_correct q hn hw npos ECDSAAdd.p SquareReduction.c
    (ECDSAAdd.regValue r.y st.basis) hpc (by norm_num [SquareReduction.c]) hY st m
    (by rw [hk]) hwork hcin hzero
  change u.phase = st.phase ∧ _ at hN
  rw [hk] at hN
  have hxy := (List.nodup_append'.mp (List.nodup_cons.mp hpoint).2).2.2
  have hfinite : r.finite ∉ r.y := fun hm =>
    (List.nodup_cons.mp hpoint).1 (List.mem_append_right _ hm)
  have hqY : q ∉ r.y := fun hm => hq (by simp [PointAddLayout.pointWires, hm])
  have hqU : u.basis q = st.basis q := hN.2.2 q hqY
  have hfiniteU : u.basis r.finite = st.basis r.finite := hN.2.2 _ hfinite
  have hxU : ECDSAAdd.regValue r.x u.basis = ECDSAAdd.regValue r.x st.basis := by
    apply ECDSAAdd.Arithmetic.regValue_congr
    intro w hw
    exact hN.2.2 w (List.disjoint_left.mp hxy hw)
  have ev := maskedPointConstant_correct q r D hpoint hq hx hy u ([])
  have eo := maskedPointConstant_correct q r (-D) hpoint hq hx hy st ([])
  have hfiniteEq : v.basis r.finite = old.basis r.finite := by
    rw [ev.finite, eo.finite, hqU, hfiniteU, ECDSAAdd.ShorPort.pointFinite_neg]
  have hxEq : ECDSAAdd.regValue r.x v.basis = ECDSAAdd.regValue r.x old.basis := by
    rw [ev.x, eo.x, hqU, hxU, ECDSAAdd.ShorPort.pointX_neg]
  have hyEq : ECDSAAdd.regValue r.y v.basis = ECDSAAdd.regValue r.y old.basis := by
    rw [ev.y, eo.y, hqU, hN.2.1]
    cases hqbit : st.basis q with
    | false => simp
    | true =>
      have hcoords := (point_holds _ _ _).mp (hcorner hqbit)
      rw [hcoords.2.2]
      simp [pointY_neg_twice_mod]
  have heq : v = old := by
    apply State.extensionality
    · exact (ev.phase.trans hN.1).trans eo.phase.symm
    funext w
    by_cases hf : w = r.finite
    · subst w; exact hfiniteEq
    by_cases hxm : w ∈ r.x
    · exact Bridge.regValue_bits r.x _ _ (by simpa only [Bridge.regValueB_eq] using hxEq) w hxm
    by_cases hym : w ∈ r.y
    · exact Bridge.regValue_bits r.y _ _ (by simpa only [Bridge.regValueB_eq] using hyEq) w hym
    have hout : w ∉ PointAddLayout.pointWires r := by
      simpa only [PointAddLayout.pointWires, List.mem_cons, List.mem_append, not_or] using ⟨⟨hf,hxm⟩,hym⟩
    exact ((ev.outside w hout).trans (hN.2.2 w hym)).trans (eo.outside w hout).symm
  rw [run_append, run_take, run_no_records _ (maskedPointConstant_counts q r D).2]
  exact heq

end
end ShorECDLP.Entrant.WEX

namespace ShorECDLP.Entrant.WEX
open Quantum Challenge Paper2607_13816 Paper2607_13816.ChallengeMigration
noncomputable section

theorem odd_sub_low_bit (p y : Nat) (hp : p % 2 = 1) (hy : y ≤ p) :
    (p-y).testBit 0 = !(y.testBit 0) := by
  simp only [Nat.testBit_zero]
  by_cases h : y % 2 = 1
  · have hn : (p-y) % 2 ≠ 1 := by omega
    simp [h, hn]
  · have hn : (p-y) % 2 = 1 := by omega
    simp [h, hn]

theorem neg_y_low_bit (y : ECDSAAdd.Fp) (hy : y ≠ 0) :
    (-y).val.testBit 0 = !(y.val.testBit 0) := by
  rw [ZMod.neg_val, if_neg hy]
  exact odd_sub_low_bit ECDSAAdd.p y.val (by norm_num [ECDSAAdd.p]) y.val_lt.le

end
