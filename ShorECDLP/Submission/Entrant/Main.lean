noncomputable def tablePoint (coeffs : Fin 131072 → PointCoeff) (Q : Point) (a : Nat) : Point :=
  constantPoint Q (coeffs ⟨a%131072,Nat.mod_lt _ (by decide)⟩)

noncomputable def source (table : Nat → Point) : AdaptiveCircuit :=
