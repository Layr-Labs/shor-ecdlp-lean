    have hlhs : P_F4 (2 * C) (C + D) / (10000 * (2 * C) ^ 2 * (C + D) ^ 2 * (Real.sqrt 2 * Real.sqrt (C * D) / Real.sqrt (D / (C + D))) * (3 * C + D) ^ 5 * Q_F (2 * C) (C + D)) =
