theorem Drops.static_wires {n s e d} {p q : Straight n s e}
    (h : Drops p q d) : straightWires q ⊆ straightWires p := by
  induction h with
  | refl => exact List.Subset.refl _
  | skip g h ih => exact fun _ hw => List.mem_append_right _ (ih hw)
  | gate g h ih =>
    intro w hw
    simp only [straightWires, List.mem_append] at hw ⊢
    exact hw.imp id (fun h => ih h)
  | record i v g h ih =>
    intro w hw
    simp only [straightWires, List.mem_append] at hw ⊢
    exact hw.imp id (fun h => ih h)
  | measure w h ih =>
    intro v hv
    simp only [straightWires, List.mem_cons] at hv ⊢
    exact hv.imp id (fun h => ih h)

