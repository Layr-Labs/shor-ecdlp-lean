theorem scrCWrite_counts : ECDSAAdd.measurementCount WEX.scrCWrite = 0 ∧
    ECDSAAdd.toffoliCount WEX.scrCWrite = 513 ∧ ECDSAAdd.Challenge.gateSlots WEX.scrCWrite = 513 := by
  have hl : WEX.cSources.length = 513 := by
