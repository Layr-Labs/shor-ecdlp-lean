  apply (NeighborReadout.neighborSuffix_support 688128
    (262143 + 21 * impl.records15 + 10 * impl.records14 + 473 + body.reset.length) 208 fineBits read h).trans
  have hs : [0,1] ⊆ resetWires := by simp [List.subset_def, resetWires]
