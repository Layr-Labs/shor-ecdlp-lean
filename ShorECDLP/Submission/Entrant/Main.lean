  by_cases hb : s 870 = true
  · simp [narrowMiddleState, signPointState, narrowRowState, inputPoint_eq s P hP,
      pointWrite_overwrite, hb]
  · have hf : s 870 = false := Bool.eq_false_iff.mpr hb
    simp [narrowMiddleState, signPointState, narrowRowState, inputPoint_eq s P hP,
      pointWrite_overwrite, hf, add_comm]

