theorem sine_neighbor_mass3_tight (m : ℕ) (hm : 204 ≤ m) (r : ℕ) (hr : 0 < r) (k : Fin r) :
    let c := Real.cos (Real.pi * ((2 ^ m : ℕ) : ℝ) * ((k.val : ℝ) / r)) ^ 2
    1 - ((29 / 100000 : ℝ) + (6003 / 500000 : ℝ) * c - (2819 / 1000000 : ℝ) * c ^ 2) ≤
