      dsimp only [z]; rw [Int.cast_natCast, Int.cast_natCast]; linarith
    rw [hcast]; exact abs_sub_round _
  exact (sinePhaseAmplitude_peak_lower_tight m hm ((k.val : ℝ) / r) a.val z hdist).trans hsingle

