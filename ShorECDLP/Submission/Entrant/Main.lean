theorem source_counts (q y : Wire) (sourceBound : Nat)
    (hBaseSlots : 32 * windowSlots + 176382 ≤ officialLimits.gateSlots)
    (hBaseRecords : 262143 + 20 * impl.records15 + 11 * impl.records14 + 472 +
