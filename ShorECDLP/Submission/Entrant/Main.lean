theorem portTemplate_counts {n : Nat} (read : ConstantBit n → Bool) (control : Option Wire)
    (ports : List (LookupPort n)) (address : Nat) :
    ECDSAAdd.toffoliCount ((portTemplate control ports address).instantiate read) = 0 ∧
      ECDSAAdd.measurementCount ((portTemplate control ports address).instantiate read) = 0 := by
  induction ports with
  | nil => exact ⟨rfl, rfl⟩
  | cons p ports ih =>
    simp only [portTemplate_cons, ECDSAAdd.ShorPort.Tmpl.instantiate_cons,
      ECDSAAdd.ShorPort.TInstr.instantiate]
    split
    · cases control <;> simpa [ECDSAAdd.toffoliCount, ECDSAAdd.measurementCount] using ih
    · exact ih

theorem specialize_counts {n : Nat} (read : ConstantBit n → Bool) (code : WCode n)
    (address : Nat) :
    ECDSAAdd.toffoliCount ((specialize code address).instantiate read) = literalToffolis code ∧
      ECDSAAdd.measurementCount ((specialize code address).instantiate read) = literalRecords code := by
  induction code with
  | nil => exact ⟨rfl, rfl⟩
  | cons i code ih =>
    simp only [specialize, List.flatMap_cons, ECDSAAdd.ShorPort.Tmpl.instantiate_append,
      ECDSAAdd.toffoliCount_append, ECDSAAdd.measurementCount_append] at ih ⊢
    cases i with
    | literal p =>
      simp [WInstr.specialize, ECDSAAdd.ShorPort.Tmpl.instantiate_lit,
        literalToffolis, literalRecords, ih.1, ih.2]
    | lookup c p =>
      have h := portTemplate_counts read c p address
      simpa [WInstr.specialize, h.1, h.2, literalToffolis, literalRecords] using ih

theorem finite_literal_counts {n : Nat} (L : ControlledPointLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) (rows doubles : Nat → Fin n) (address : Nat)
    (hd : rows address ≠ doubles address) :
    literalToffolis (wFinite L rows doubles) = 2215341 ∧
      literalRecords (wFinite L rows doubles) = 1555877 := by
  let read : ConstantBit n → Bool := fun _ => false
  have counts := ECDSAAdd.ShorPort.finiteT_counts_any L hw hn
    (rows address) (doubles address) hd read
  have literals := specialize_counts read (wFinite L rows doubles) address
  rw [specialize_finite] at literals
  exact ⟨literals.1.symm.trans counts.1, literals.2.symm.trans counts.2⟩

/-- Exact literal-replacement counts, uniform over every reader and incoming history. -/
theorem finite_compile_counts {n : Nat} (L : ControlledPointLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) (rows doubles : Nat → Fin n) (address : Nat)
    (hd : rows address ≠ doubles address) (bits paths : List Wire) (root : Wire)
    (hl : LookupLayouts bits paths root (wFinite L rows doubles)) (hbits : bits.length = 15)
    (read : ConstantBit n → Bool) (start : Nat) (history : Fin start → Bool) :
    codeRecords bits paths root (wFinite L rows doubles) = 2604421 ∧
      ((compile bits paths root (wFinite L rows doubles) start).instantiate read history).tCount =
        22847195 := by
  obtain ⟨ht, hm⟩ := finite_literal_counts L hw hn rows doubles address hd
  constructor
  · rw [codeRecords_eq _ _ _ _ hl, hm, traversals_finite, hbits]
    norm_num
  · rw [compile_tCount _ _ _ _ _ hl, ht, traversals_finite, hbits]
    norm_num

end
end ShorECDLP.Entrant.WEX

