    have hh0 : b₂.history = [] := List.eq_nil_of_length_eq_zero (by rw [h₂.1]; exact f.swapNet_meas)
    change b₂.kraus (b₁.kraus (Bridge.signedKet st)) = _
    rw [h₁ _ st (sel_valid address st hs), map_smul, h₂.2, hm0, hh0]
