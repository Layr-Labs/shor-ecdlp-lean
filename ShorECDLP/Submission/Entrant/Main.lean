namespace ShorECDLP.Entrant.WEX
open ECDSAAdd ECDSAAdd.Arithmetic ECDSAAdd.Secp256k1
noncomputable section

theorem torsion_unit_remainder_ne_zero (P : Point) (n m : Nat)
    (hP : P ≠ 0) (horder : n • P = 0) (hrem : n % m = 1) : m • P ≠ 0 := by
  intro hm
  have hn : n = n / m * m + 1 := by
    simpa only [hrem, Nat.mul_comm, Nat.add_comm] using (Nat.mod_add_div n m).symm
  have hmul : (n / m * m) • P = 0 := by
    rw [Nat.mul_comm, mul_nsmul, hm, nsmul_zero]
  rw [hn, add_nsmul, hmul, one_nsmul, zero_add] at horder
  exact hP horder

theorem finite_point_parity (P : Point) (hP : P ≠ 0) (horder : ShorECDLP.order • P = 0) :
    ECDSAAdd.Entrant.yBit (-P) = !(ECDSAAdd.Entrant.yBit P) := by
  have hdouble : P+P ≠ 0 := by
    simpa only [two_nsmul] using torsion_unit_remainder_ne_zero P ShorECDLP.order 2 hP horder
      (by norm_num [ShorECDLP.order])
  cases P with
  | zero => exact (hP rfl).elim
  | @some x y h =>
    have hy : y ≠ -y := (doubling_enabled_iff h).mpr (fun he =>
      hdouble (eq_neg_iff_add_eq_zero.mp he))
    have hy0 : y ≠ 0 := by intro hz; apply hy; simp [hz]
    rw [ECDSAAdd.ShorPort.yBit_eq, ECDSAAdd.ShorPort.yBit_eq, ECDSAAdd.ShorPort.pointY_neg]
    exact neg_y_low_bit y hy0

end
end ShorECDLP.Entrant.WEX


namespace ShorECDLP.Entrant.WEX
open Quantum Challenge NaiveChallenge Paper2607_13816 Paper2607_13816.ChallengeMigration
noncomputable section
set_option maxHeartbeats 3000000

def LookupOn {n : Nat} (support : List Wire) : LookupOp n → Prop
  | .gates gs => ∀ g ∈ gs, ∀ w ∈ gateWires (slotGate g), w ∈ support
  | .erase a b t => a ∈ support ∧ b ∈ support ∧ t ∈ support

theorem gateProgram_support {n start : Nat} (gs : List (TemplateGate n)) (support : List Wire)
    (hs : ∀ g ∈ gs, ∀ w ∈ gateWires (slotGate g), w ∈ support) :
    ShorECDLP.NaiveChallenge.straightWires (gateProgram (cursor := start) gs) ⊆ support := by
  induction gs with
  | nil => simp [gateProgram, ShorECDLP.NaiveChallenge.straightWires]
  | cons g gs ih =>
    intro w hw
    simp only [gateProgram, ShorECDLP.NaiveChallenge.straightWires, List.mem_append] at hw
    rcases hw with h | h
    · exact hs g (by simp) w h
    · exact ih (fun g hg => hs g (List.mem_cons_of_mem _ hg)) h

theorem andEraseProgram_support (n start a b t : Nat) (support : List Wire)
    (ha : a ∈ support) (hb : b ∈ support) (ht : t ∈ support) :
    ShorECDLP.NaiveChallenge.straightWires (andEraseProgram n start a b t) ⊆ support := by
  intro w hw
  simp only [andEraseProgram, Paper2607_13816.ChallengeMigration.recordGates,
    controlledZ, ShorECDLP.NaiveChallenge.straightWires, gateWires, List.mem_cons, List.mem_append,
    List.not_mem_nil, or_false] at hw
  aesop

theorem lookup_cast_wires {n s e f : Nat} (h : e = f) (p : Straight n s e) :
    ShorECDLP.NaiveChallenge.straightWires (Paper2607_13816.ChallengeMigration.castFinish h p) = ShorECDLP.NaiveChallenge.straightWires p := by
  subst f
  rfl

theorem lookupProgram_support {n : Nat} (ops : List (LookupOp n)) (start : Nat)
    (support : List Wire) (hs : ∀ op ∈ ops, LookupOn support op) :
    ShorECDLP.NaiveChallenge.straightWires (lookupProgram n ops start) ⊆ support := by
  induction ops generalizing start with
  | nil => simp [lookupProgram, ShorECDLP.NaiveChallenge.straightWires]
  | cons op ops ih =>
    have ht (k : Nat) := ih k (fun o ho => hs o (List.mem_cons_of_mem _ ho))
    have ho := hs op (by simp)
    cases op with
    | gates gs =>
      rw [lookupProgram, Bridge.straightWires_append]
      intro w hw
      rcases List.mem_append.mp hw with hw | hw
      · exact gateProgram_support gs support ho hw
      · exact ht start hw
    | erase a b t =>
      simp only [lookupProgram, lookup_cast_wires, Bridge.straightWires_append]
      intro w hw
      rcases List.mem_append.mp hw with hw | hw
      · exact andEraseProgram_support n start a b t support ho.1 ho.2.1 ho.2.2 hw
      · exact ht (start+1) hw

theorem ordinaryOp_on {n : Nat} (gs : Circuit) (support : List Wire)
    (hs : ∀ g ∈ gs, ∀ w ∈ gateWires g, w ∈ support) : LookupOn support (@ordinaryOp n gs) := by
  intro g hg w hw
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hg
  exact hs k hk w hw

theorem unaryLookupOps_support {n : Nat} (leaf : Nat → Wire → List (TemplateGate n))
    (tree : UnaryActionTree) (q : Wire) (paths support : List Wire)
    (hq : q ∈ support) (hb : ∀ w ∈ tree.indexWires, w ∈ support) (hp : paths ⊆ support)
    (hleaf : ∀ label root, root ∈ support → LookupOn support (.gates (leaf label root))) :
    ∀ op ∈ unaryLookupOps leaf tree q paths, LookupOn support op := by
  induction tree generalizing q paths with
  | leaf label => simpa [unaryLookupOps] using hleaf label q hq
  | node bit zero one ihz iho =>
    cases paths with
    | nil => simp [unaryLookupOps]
    | cons path rest =>
      have hbit := hb bit (by simp [UnaryActionTree.indexWires])
      have hpath : path ∈ support := hp (by simp)
      have hrest : rest ⊆ support := fun w hw => hp (List.mem_cons_of_mem _ hw)
      have hz := ihz path rest hpath (fun w hw => hb w (by simp [UnaryActionTree.indexWires, hw])) hrest
      have ho := iho path rest hpath (fun w hw => hb w (by simp [UnaryActionTree.indexWires, hw])) hrest
      have hcompute : LookupOn support (@ordinaryOp n (computeZeroAnd q bit path)) := by
        apply ordinaryOp_on
        intro g hg w hw
        simp only [computeZeroAnd, List.mem_cons, List.not_mem_nil, or_false] at hg
        rcases hg with rfl | rfl | rfl <;>
          simp only [gateWires, List.mem_cons, List.not_mem_nil, or_false] at hw
        all_goals aesop
      have hcx : LookupOn support (@ordinaryOp n ([.CX q path])) := by
        apply ordinaryOp_on
        intro g hg w hw
        simp only [List.mem_singleton] at hg
        subst g
        simp only [gateWires, List.mem_cons, List.not_mem_nil, or_false] at hw
        rcases hw with rfl | rfl <;> assumption
      have hx : LookupOn support (@ordinaryOp n ([.X bit])) := by
        apply ordinaryOp_on
        intro g hg w hw
        simp only [List.mem_singleton] at hg
        subst g
        simp only [gateWires, List.mem_singleton] at hw
        simpa [hw] using hbit
      simp only [unaryLookupOps, List.forall_mem_append, List.forall_mem_cons,
        List.mem_nil_iff, false_implies]
      exact ⟨⟨⟨⟨⟨hcompute,fun _ => trivial⟩,hz⟩,⟨hcx,fun _ => trivial⟩⟩,ho⟩,
        hcx,hx,⟨hq,hbit,hpath⟩,hx,fun _ => trivial⟩

theorem portProgram_support {n : Nat} (ports : List (LookupPort n)) (bits paths : List Wire)
    (root start : Nat) (support : List Wire) (hq : root ∈ support) (hb : bits ⊆ support)
    (hp : paths ⊆ support) (ht : portTargets ports ⊆ support) :
    ShorECDLP.NaiveChallenge.straightWires (lookupProgram n (portOps ports bits paths root) start) ⊆ support := by
  apply lookupProgram_support
  apply unaryLookupOps_support _ _ _ _ _ hq
  · intro w hw
    exact hb ((tableAddressTree_mem_index _ _ _ _).mp hw)
  · exact hp
  · intro label q hq g hg w hw
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hg
    change w ∈ [q,p.target] at hw
    rcases List.mem_cons.mp hw with rfl | hw
    · exact hq
    · have he : w = p.target := List.mem_singleton.mp hw
      rw [he]
      exact ht (List.mem_map.mpr ⟨p,hp,rfl⟩)

end
end ShorECDLP.Entrant.WEX


namespace ShorECDLP.Entrant.WEX
open ECDSAAdd ECDSAAdd.Arithmetic
noncomputable section
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192

def mapPointReg (f : Nat → Nat) (r : PointReg) : PointReg :=
  ⟨f r.finite, r.x.map f, r.y.map f⟩

def mapCore (f : Nat → Nat) (L : PointAddLayout) : PointAddLayout where
  input := mapPointReg f L.input
  output := mapPointReg f L.output
  dx := L.dx.map f
  dy := L.dy.map f
  slope := L.slope.map f
  square := L.square.map f
  offset := L.offset.map f
  candidateX := L.candidateX.map f
  delta := L.delta.map f
  product := L.product.map f
  candidateY := L.candidateY.map f
  constant := L.constant.map f
  divisor := L.divisor.map f
  inverse := L.inverse.map f
  inputXHigh := f L.inputXHigh
  inputYHigh := f L.inputYHigh
  equalX := f L.equalX
  equalNegY := f L.equalNegY
  generic := f L.generic
  double := f L.double
  pool := L.pool.map f

def mapControlled (f : Nat → Nat) (L : ControlledPointLayout) : ControlledPointLayout where
  core := mapCore f L.core
  control := f L.control
  genericSelect := f L.genericSelect
  doubleSelect := f L.doubleSelect
  infinitySelect := f L.infinitySelect

theorem mapCore_words (f : Nat → Nat) (L : PointAddLayout) :
    (mapCore f L).words = L.words.map (List.map f) := rfl

theorem mapControlled_wires (f : Nat → Nat) (L : ControlledPointLayout) :
    (mapControlled f L).wires = L.wires.map f := by
  simp [mapControlled, mapCore, mapPointReg, ControlledPointLayout.wires,
    ControlledPointLayout.extras, ControlledPointLayout.selectors, PointAddLayout.wires,
    PointAddLayout.pointWires, PointAddLayout.work, PointAddLayout.words, PointAddLayout.flags,
    List.flatten_cons, List.flatten_nil, List.map_append]

theorem mapControlled_widths (f : Nat → Nat) (L : ControlledPointLayout) (hw : L.Widths) :
    (mapControlled f L).Widths := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa [mapControlled, mapCore, mapPointReg] using hw.inputX
  · simpa [mapControlled, mapCore, mapPointReg] using hw.inputY
  · simpa [mapControlled, mapCore, mapPointReg] using hw.outputX
  · simpa [mapControlled, mapCore, mapPointReg] using hw.outputY
  · intro r hr
    change r ∈ (mapCore f L.core).words at hr
    rw [mapCore_words] at hr
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hr
    simpa using hw.words s hs
  · simpa [mapControlled, mapCore] using hw.divisor
  · simpa [mapControlled, mapCore] using hw.inverse
  · simpa [mapControlled, mapCore] using hw.pool

theorem mapControlled_nodup (f : Nat → Nat) (hf : Function.Injective f)
    (L : ControlledPointLayout) (hn : L.wires.Nodup) : (mapControlled f L).wires.Nodup := by
  rw [mapControlled_wires]
  exact hn.map hf

/-- The native finite flag is placed on the Streaming infinity port; free X gates
convert polarity. The arithmetic work bank lies above all persistent ports. -/
def streamWire (w : Nat) : Nat :=
  if w = 0 then 836 else if w = 1 then 838 else if w < 258 then w+261
    else if w < 514 then w+322 else w+10000

theorem streamWire_injective : Function.Injective streamWire := by
  intro a b h
  unfold streamWire at h
  split_ifs at h <;> omega

def streamLayout : ControlledPointLayout := mapControlled streamWire ECDSAAdd.Baselines.layout

theorem streamLayout_widths : streamLayout.Widths :=
  mapControlled_widths _ _ ECDSAAdd.Baselines.layout_widths

theorem streamLayout_nodup : streamLayout.wires.Nodup :=
  mapControlled_nodup _ streamWire_injective _ ECDSAAdd.Baselines.layout_nodup

theorem streamLayout_point : streamLayout.point =
    ⟨838, List.range' 263 256, List.range' 580 256⟩ := by
  change (⟨838, _, _⟩ : PointReg) = ⟨838, List.range' 263 256, List.range' 580 256⟩
  congr 1

theorem streamLayout_control : streamLayout.control = 836 := rfl

theorem streamLayout_sites : (ECDSAAdd.Entrant.sitesQ streamLayout).length = 1898 :=
  ECDSAAdd.Entrant.sitesQ_length _ streamLayout_widths

end
end ShorECDLP.Entrant.WEX

/-! Consolidated module: Main. -/

/-! EDITABLE. Entrant: Shor's ECDLP circuit with the ecdsa.fail controlled point addition.

One observed trial at 263-bit phase precision (two 263-qubit phase registers and one QFT
ancilla), 526 controlled additions of table points, each the Lean-verified finite-addend
circuit of ecdsa.fail (vendored in `ECDSAAdd.Part1..4` and `ECDSALib`) on its 1,898-site
layout, with the control wire renamed to the phase qubit. The generic bridge (`Bridge`) turns
any such provider into the challenge certificate; this module instantiates it.

Resources (all bounds equal the proved counts):
* qubits 2,425 = 1,898 sites of the addition + 526 phase qubits + 1 QFT ancilla;
* T-model 8,157,919,152 = 526 additions × 7 × 2,215,341 Toffoli + 1,033,590 (QFT rotations);
* measurements 818,391,828 = 526 × 1,555,877 + 526 phase-register measurements. -/

/-! ## The ecdsa.fail finite-addend template as the bridge's controlled-addition provider.

Block `j` is the vendored template `finiteT layout (portRow j) (portRowD j)` (control on wire 0,
point register on wires 1..513, workspace `layout.work`), normalised (`CCX a a t ↦ CX a t`) and
read as a bridge template (`gated ↦ when`).  The coefficient table has 528 rows,
`2^i • G` for `i ≤ 263` and `2^i • Q` for `i ≤ 263`: block `j` reads the addend `C` from row
`portRow j` and the ordinate of `-(C + C)` from row `portRowD j = portRow j + 1`.

* Specification: `finiteT_spec` (every addend `2^i • G` and `2^i • d • G` is a finite multiple
  of the generator).
* Static counts: the template's gated instructions are single `X`/`CX` gates on sites of
  `sitesQ layout` (`portGated_finiteT`), so measurements, Toffolis, wires and validity of the
  template follow from one instantiation (`Q = G`); the gated gates add at most 7,706 slots. -/

namespace ShorECDLP.Entrant.Bridge
open Quantum Secp256k1 Challenge NaiveChallenge
open ECDSAAdd.ShorPort (Tmpl finiteT maskedT xorT maskedPointT pairXorT shortXorT bitTestT
  pairTailT zeroWithT pairEqualT shortEqualT constAddT recoveryT genericT cornersT)
noncomputable section

local instance : Fact (Nat.Prime p) := ⟨p_prime⟩

/-! ## Port templates as bridge templates -/


/-! ## The coefficient table -/

section PortTable

theorem portOrderPos : 0 < order := order_prime.pos

/-- Rows `0..263` hold `2^i • G`, rows `264..527` hold `2^(i-264) • Q`. -/
def portCoeff (i : Nat) : PointCoeff :=
  if i < 264 then ⟨⟨2 ^ i % order, Nat.mod_lt _ portOrderPos⟩, ⟨0, portOrderPos⟩⟩
  else ⟨⟨0, portOrderPos⟩, ⟨2 ^ (i - 264) % order, Nat.mod_lt _ portOrderPos⟩⟩

def portCoeffs (i : Fin 528) : PointCoeff := portCoeff i.val

def portRowNat (j : Nat) : Nat := if j < 263 then j else j + 1

/-- The row of the addend of block `j`. -/
def portRow (j : Fin 526) : Fin 528 :=
  ⟨portRowNat j.val, by have := j.isLt; unfold portRowNat; split <;> omega⟩

/-- The row of the double of the addend of block `j`. -/
def portRowD (j : Fin 526) : Fin 528 :=
  ⟨portRowNat j.val + 1, by have := j.isLt; unfold portRowNat; split <;> omega⟩

theorem portCoeff_lo (Q : Point) (i : Nat) (h : i < 264) :
    constantPoint Q (portCoeff i) = (2 ^ i) • G := by
  unfold portCoeff
  rw [if_pos h]
  show (2 ^ i % order) • G + (0 : Nat) • Q = _
  rw [zero_nsmul, add_zero, nsmul_mod_order G generator_nsmul_eq_zero]

theorem portCoeff_hi (Q : Point) (hQ : order • Q = 0) (i : Nat) (h : 264 ≤ i) :
    constantPoint Q (portCoeff i) = (2 ^ (i - 264)) • Q := by
  unfold portCoeff
  rw [if_neg (show ¬ i < 264 by omega)]
  show (0 : Nat) • G + (2 ^ (i - 264) % order) • Q = _
  rw [zero_nsmul, zero_add, nsmul_mod_order Q hQ]

theorem portRow_eq (Q : Point) (hQ : order • Q = 0) (j : Fin 526) :
    constantPoint Q (portCoeffs (portRow j)) = tablePoint Q j := by
  have hj := j.isLt
  show constantPoint Q (portCoeff (portRowNat j.val)) = tablePoint Q j
  unfold portRowNat tablePoint
  by_cases h : j.val < 263
  · rw [if_pos h, if_pos h, portCoeff_lo Q _ (by omega)]
  · rw [if_neg h, if_neg h, portCoeff_hi Q hQ _ (by omega),
      show j.val + 1 - 264 = j.val - 263 by omega]

theorem portRowD_eq (Q : Point) (hQ : order • Q = 0) (j : Fin 526) :
    constantPoint Q (portCoeffs (portRowD j)) = tablePoint Q j + tablePoint Q j := by
  have hj := j.isLt
  show constantPoint Q (portCoeff (portRowNat j.val + 1)) = tablePoint Q j + tablePoint Q j
  unfold portRowNat tablePoint
  by_cases h : j.val < 263
  · rw [if_pos h, if_pos h, portCoeff_lo Q _ (by omega), pow_succ, mul_two, add_nsmul]
  · rw [if_neg h, if_neg h, portCoeff_hi Q hQ _ (by omega),
      show j.val + 1 + 1 - 264 = (j.val - 263) + 1 by omega, pow_succ, mul_two, add_nsmul]

/-- `2^i • C ≠ 0` for a non-zero multiple `C` of the generator (the order is an odd prime). -/
theorem portPowNe (C : Point) (k i : Nat) (hk : C = k • G) (hC : C ≠ 0) : (2 ^ i) • C ≠ 0 := by
  intro h
  rw [hk, smul_smul] at h
  have hd : order ∣ 2 ^ i * k := by
    rw [← generator_order]
    exact addOrderOf_dvd_of_nsmul_eq_zero h
  rcases (Nat.Prime.dvd_mul order_prime).mp hd with h1 | h1
  · have h2 := Nat.le_of_dvd (by norm_num) (Nat.Prime.dvd_of_dvd_pow order_prime h1)
    have h3 : 2 < order := by norm_num [ShorECDLP.order]
    omega
  · apply hC
    rw [hk]
    rw [← generator_order] at h1
    exact addOrderOf_dvd_iff_nsmul_eq_zero.mp h1

theorem portSome (C : ECDSAAdd.Secp256k1.Point) (h : C ≠ 0) :
    ∃ (cx cy : ECDSAAdd.Fp)
      (hc : ECDSAAdd.Secp256k1.curve.toAffine.Nonsingular cx cy), C = .some hc := by
  cases C with
  | zero => exact (h rfl).elim
  | some hc => exact ⟨_, _, hc, rfl⟩

/-- For `Q = d • G ≠ 0`, block `j` reads a finite multiple `C` of the generator from row
`portRow j` and `C + C` from row `portRowD j`; `C` is the table point of the bridge. -/
theorem portRows (Q : Point) (d : Nat) (hQ : Q ≠ 0) (hd : Q = d • G) (j : Fin 526) :
    ∃ (cx cy : ECDSAAdd.Fp)
      (hc : ECDSAAdd.Secp256k1.curve.toAffine.Nonsingular cx cy) (k : Nat),
      ECDSAAdd.ShorPort.toA (.some hc) = k • G ∧
      ECDSAAdd.ShorPort.RowReads (readConstant portCoeffs Q) (portRow j) (.some hc) ∧
      ECDSAAdd.ShorPort.RowReads (readConstant portCoeffs Q) (portRowD j)
        (.some hc + .some hc) ∧
      toB (tablePoint Q j) = .some hc := by
  have hQo : order • Q = 0 := by
    rw [hd, smul_smul, Nat.mul_comm, ← smul_smul, generator_nsmul_eq_zero]
    exact nsmul_zero d
  obtain ⟨k, hk, hne⟩ : ∃ k : Nat, tablePoint Q j = k • G ∧ tablePoint Q j ≠ 0 := by
    by_cases hj : j.val < 263
    · refine ⟨2 ^ j.val, ?_, ?_⟩
      · rw [tablePoint, if_pos hj]
      · rw [tablePoint, if_pos hj]
        exact portPowNe G 1 _ (one_nsmul G).symm G_ne_zero
    · refine ⟨2 ^ (j.val - 263) * d, ?_, ?_⟩
      · rw [tablePoint, if_neg hj, hd, smul_smul]
      · rw [tablePoint, if_neg hj]
        exact portPowNe Q d _ hd hQ
  have hrow := portRow_eq Q hQo j
  have hrowD := portRowD_eq Q hQo j
  obtain ⟨cx, cy, hc, hce⟩ := portSome (toB (tablePoint Q j)) hne
  refine ⟨cx, cy, hc, k, ?_, ?_, ?_, hce⟩
  · have h : ECDSAAdd.ShorPort.toA (toB (tablePoint Q j)) = k • G := hk
    rw [hce] at h
    exact h
  · exact ECDSAAdd.ShorPort.readConstant_rowReads portCoeffs Q _ _
      (hrow.trans (congrArg ECDSAAdd.ShorPort.toA hce))
  · exact ECDSAAdd.ShorPort.readConstant_rowReads portCoeffs Q _ _
      (hrowD.trans (congrArg (fun P : ECDSAAdd.Secp256k1.Point => ECDSAAdd.ShorPort.toA (P + P))
        hce))

end PortTable

/-! ## The provider -/

section PortProvider

/-- Block `j`: the normalised template of the finite-addend program, as a bridge template. -/
def portTmpl (j : Fin 526) : List (TInstr 528) :=
  List.map ofPort (ECDSAAdd.ShorPort.Tmpl.map ECDSAAdd.Baselines.normalizeInstr
    (finiteT ECDSAAdd.Baselines.layout (portRow j) (portRowD j)))

/-- The vendored specification in the bridge's form (control wire, point register, clean
workspace as separate conjuncts). -/
theorem portSpecB {read : ConstantBit 528 → Bool} {row rowD : Fin 528} {cx cy : ECDSAAdd.Fp}
    (hc : ECDSAAdd.Secp256k1.curve.toAffine.Nonsingular cx cy) (k : Nat)
    (hk : ECDSAAdd.ShorPort.toA (.some hc) = k • G)
    (h : ECDSAAdd.ShorPort.RowReads read row (.some hc))
    (hD : ECDSAAdd.ShorPort.RowReads read rowD (.some hc + .some hc))
    (b : Bool) (R : ECDSAAdd.Secp256k1.Point) :
    ECDSAAdd.Triple
      (fun st => st bControl = b ∧ ECDSAAdd.Holds.holds st ECDSAAdd.Challenge.point R ∧
        ∀ w ∈ ECDSAAdd.Baselines.layout.work, st w = false)
      ((finiteT ECDSAAdd.Baselines.layout row rowD).instantiate read)
      (fun st => st bControl = b ∧
        ECDSAAdd.Holds.holds st ECDSAAdd.Challenge.point (if b then R + .some hc else R) ∧
        ∀ w ∈ ECDSAAdd.Baselines.layout.work, st w = false) := by
  have spec := ECDSAAdd.ShorPort.finiteT_spec ECDSAAdd.Baselines.layout
    ECDSAAdd.Baselines.layout_widths ECDSAAdd.Baselines.layout_nodup hc k hk h hD R b
  refine ECDSAAdd.Triple.conseq ?_ spec ?_
  · intro s hs
    obtain ⟨hb, hR, hw⟩ := hs
    refine ⟨⟨hb, hR⟩, ?_⟩
    exact (ECDSAAdd.Arithmetic.regValue_zero ECDSAAdd.Baselines.layout.work s).mpr hw
  · intro s hs
    obtain ⟨⟨hb, hR⟩, hw⟩ := hs
    exact ⟨hb, hR, (ECDSAAdd.Arithmetic.regValue_zero ECDSAAdd.Baselines.layout.work s).mp hw⟩

theorem portResult (b : Bool) (R C : Point) {cx cy : ECDSAAdd.Fp}
    (hc : ECDSAAdd.Secp256k1.curve.toAffine.Nonsingular cx cy) (hce : toB C = .some hc) :
    toB (controlledPointResult b R C) = if b then toB R + .some hc else toB R := by
  cases b
  · rfl
  · show toB (R + C) = if true = true then toB R + .some hc else toB R
    rw [toB_add, hce, if_pos rfl]

theorem portSpec (Q : Point) (d : Nat) (hQ : Q ≠ 0) (hd : Q = d • G) (j : Fin 526) :
    BSpec (instB (readConstant portCoeffs Q) (portTmpl j)) (tablePoint Q j)
      ECDSAAdd.Baselines.layout.work := by
  obtain ⟨cx, cy, hc, k, hk, h, hD, hce⟩ := portRows Q d hQ hd j
  intro b R
  rw [portTmpl, instB_ofPort, ECDSAAdd.ShorPort.Tmpl.instantiate_normalize,
    ECDSAAdd.Baselines.normalize_triple, portResult b R _ hc hce]
  exact portSpecB hc k hk h hD b (toB R)

/-- The static facts of block `j`, from its instantiation at `Q = G`. -/
theorem portTmpl_facts (j : Fin 526) :
    (∀ i ∈ portTmpl j, i.Static) ∧
    (∀ i ∈ portTmpl j, ECDSAAdd.Challenge.instructionValid i.instr) ∧
    (∀ w ∈ tmplWires (portTmpl j), w ∈ ECDSAAdd.Entrant.sitesQ ECDSAAdd.Baselines.layout) ∧
    tmplMeas (portTmpl j) = 1555877 ∧
    tmplToffoli (portTmpl j) ≤ 2215341 ∧
    tmplSlots (portTmpl j) ≤ 141061706 := by
  obtain ⟨cx, cy, hc, k, hk, h, hD, -⟩ := portRows G 1 G_ne_zero (one_nsmul G).symm j
  have hgF : PortGated (PortGood (ECDSAAdd.Entrant.sitesQ ECDSAAdd.Baselines.layout))
      (finiteT ECDSAAdd.Baselines.layout (portRow j) (portRowD j)) :=
    portGated_finiteT ECDSAAdd.Baselines.layout (portX _) (portY _)
      (portC _ ECDSAAdd.Baselines.layout_nodup)
      (portG _ ECDSAAdd.Baselines.layout_widths ECDSAAdd.Baselines.layout_nodup) _ _
  have hgN := portGated_normalize hgF
  have hinst := ECDSAAdd.ShorPort.Tmpl.instantiate_normalize (readConstant portCoeffs G)
    (finiteT ECDSAAdd.Baselines.layout (portRow j) (portRowD j))
  obtain ⟨hT, hM⟩ := ECDSAAdd.ShorPort.finiteT_counts ECDSAAdd.Baselines.layout
    ECDSAAdd.Baselines.layout_widths ECDSAAdd.Baselines.layout_nodup hc k hk h hD
  have hS := ECDSAAdd.ShorPort.finiteT_supportQ ECDSAAdd.Baselines.layout
    ECDSAAdd.Baselines.layout_widths ECDSAAdd.Baselines.layout_nodup hc k hk h hD
  have hP := ECDSAAdd.ShorPort.finiteT_physical ECDSAAdd.Baselines.layout
    ECDSAAdd.Baselines.layout_widths ECDSAAdd.Baselines.layout_nodup hc k hk h hD
  have hSl := ECDSAAdd.ShorPort.finiteT_gateSlots_le ECDSAAdd.Baselines.layout
    ECDSAAdd.Baselines.layout_widths hc k hk h hD
  have hgc := portGCount_finiteT ECDSAAdd.Baselines.layout ECDSAAdd.Baselines.layout_widths
    (portRow j) (portRowD j)
  have hsl := portSlots (readConstant portCoeffs G) (ECDSAAdd.ShorPort.Tmpl.map ECDSAAdd.Baselines.normalizeInstr
    (finiteT ECDSAAdd.Baselines.layout (portRow j) (portRowD j)))
  rw [hinst, ECDSAAdd.Baselines.normalize_slots, portGCount_map] at hsl
  unfold portTmpl
  refine ⟨portStatic hgN, portValid (readConstant portCoeffs G) hgN ?_, portWires (readConstant portCoeffs G) hgN ?_, ?_, ?_, ?_⟩
  · rw [hinst]
    exact ECDSAAdd.Baselines.normalize_physical _ hP
  · rw [hinst, ECDSAAdd.Baselines.normalize_wires]
    exact hS
  · rw [portMeas (readConstant portCoeffs G) hgN, hinst, ECDSAAdd.Baselines.normalize_measurements, hM]
  · rw [portToffoli (readConstant portCoeffs G) hgN, hinst]
    exact (ECDSAAdd.Baselines.normalize_toffoli _).trans hT.le
  · omega

/-- The ecdsa.fail finite-addend program as the bridge's controlled-addition provider. -/
def portProvider : AddProvider where
  n := 528
  coeffs := portCoeffs
  work := ECDSAAdd.Baselines.layout.work
  M := 1555877
  T := 2215341
  S := 141061706
  tmpl := portTmpl
  static := fun j => (portTmpl_facts j).1
  valid := fun j => (portTmpl_facts j).2.1
  supp := ECDSAAdd.Entrant.sitesQ ECDSAAdd.Baselines.layout
  wires := fun j => (portTmpl_facts j).2.2.1
  supp_range := fun w hw => by
    have := portSites_lt w hw
    omega
  supp_cover := fun w hw => portCover w (portSites_lt w hw)
  work_range := portWork_range
  meas := fun j => (portTmpl_facts j).2.2.2.1
  toffoli := fun j => (portTmpl_facts j).2.2.2.2.1
  slots := fun j => (portTmpl_facts j).2.2.2.2.2
  spec := portSpec

/-- The certificate of the assembled entry: 2,425 qubits, T-model 8,157,919,152,
818,391,828 measurements. -/
theorem portCertificate :
    Certificate officialLimits portProvider.layout portProvider.entry
      ⟨2425, 8157919152, 818391828⟩ :=
  portProvider.certificate _
    (by
      have := ECDSAAdd.Entrant.sitesQ_length ECDSAAdd.Baselines.layout
        ECDSAAdd.Baselines.layout_widths
      show (ECDSAAdd.Entrant.sitesQ ECDSAAdd.Baselines.layout).length + 527 ≤ 2425
      omega)
    (by show 526 * (7 * 2215341) + 1033590 ≤ 8157919152; norm_num)
    (by show 526 * 1555877 + 526 ≤ 818391828; norm_num)
    (by show 526 * 1555877 + 526 ≤ 47471340504; norm_num)
    (by show 526 * 141061706 + 418696 ≤ 4000000000000000; norm_num)
    (by show 528 ≤ 983040; norm_num)

end PortProvider

