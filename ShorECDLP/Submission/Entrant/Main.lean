def count (c14 c15 c16 : Nat) (w : Digit) : Nat :=
  if w.width = 14 then c14 else if w.width = 15 then c15 else c16

class Programs (body : Single.WindowBody) where
  records14 : Nat
  records15 : Nat
  records16 : Nat
  cost14 : Nat
  cost15 : Nat
  cost16 : Nat
  program : (w : Digit) → (start : Nat) → Straight 933888 start
