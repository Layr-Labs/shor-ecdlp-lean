          have h1le : (1 : ℝ) ≤ (4 * (2 : ℝ) ^ (2 * d) / (4 : ℝ) ^ k0) *
              (1 / ((runF (1, 1) γ2).1 : ℝ) ^ 2 + 1 / ((runF (1, 1) γ2).2 : ℝ) ^ 2) := by
