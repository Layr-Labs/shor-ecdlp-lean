(formerly `ECDSALib/Structural.lean`) -/

/-! # Structural enables are true for every finite table point

The frontier program contains two enables that are compile-time booleans of `C`:
`cy ≠ -cy` (the doubling comparison) and `exceptionBit C` (`-(C+C) ∉ {0, C, -C}`). The template
`finiteT` emits both gates unconditionally. This is exact for every non-zero multiple of the
generator: the generator has prime order `order > 3`, so `C + C ≠ 0` and `C + C + C ≠ 0`. -/
noncomputable section
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.ShorPort
open Arithmetic Secp256k1 Entrant

/-- In the prime-order subgroup generated by `G`, `m • C ≠ 0` for `C ≠ 0` and `0 < m < order`. -/
theorem nsmul_ne_zero_of_multiple (C : ShorECDLP.Secp256k1.Point) (k m : ℕ)
    (hk : C = k • ShorECDLP.Secp256k1.G) (hC : C ≠ 0) (hm0 : 0 < m)
    (hm : m < ShorECDLP.order) : m • C ≠ 0 := by
  intro h
  rw [hk, smul_smul] at h
  have hd : ShorECDLP.order ∣ m * k := by
    rw [← ShorECDLP.Secp256k1.generator_order]
    exact addOrderOf_dvd_of_nsmul_eq_zero h
  rcases (Nat.Prime.dvd_mul ShorECDLP.Secp256k1.order_prime).mp hd with h1 | h1
  · exact absurd (Nat.le_of_dvd hm0 h1) (by omega)
  · apply hC
    rw [hk]
    rw [← ShorECDLP.Secp256k1.generator_order] at h1
    exact addOrderOf_dvd_iff_nsmul_eq_zero.mp h1

/-- `C + C ≠ 0` and `C + C + C ≠ 0` for a non-zero multiple of the generator. -/
theorem double_triple_ne_zero (C : Point) (k : ℕ)
    (hk : toA C = k • ShorECDLP.Secp256k1.G) (hC : C ≠ 0) :
    C + C ≠ 0 ∧ C + C + C ≠ 0 := by
  have hord : 3 < ShorECDLP.order := by norm_num [ShorECDLP.order]
  have h2 := nsmul_ne_zero_of_multiple (toA C) k 2 hk hC (by decide) (by omega)
  have h3 := nsmul_ne_zero_of_multiple (toA C) k 3 hk hC (by decide) hord
  rw [two_nsmul] at h2
  rw [show (3 : ℕ) = 2 + 1 from rfl, succ_nsmul, two_nsmul] at h3
  exact ⟨h2, h3⟩

/-- Both structural enables hold for a finite `C` with `C + C ≠ 0` and `C + C + C ≠ 0`. -/
theorem enables_true {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy)
    (h2 : (.some hc : Point) + .some hc ≠ 0) (h3 : (.some hc : Point) + .some hc + .some hc ≠ 0) :
    cy ≠ -cy ∧ exceptionBit (.some hc) = true := by
  set C : Point := .some hc with hCdef
  have hC : C ≠ 0 := WeierstrassCurve.Affine.Point.some_ne_zero hc
  refine ⟨(doubling_enabled_iff hc).mpr (fun h => h2 (eq_neg_iff_add_eq_zero.mp h)), ?_⟩
  have n1 : -(C + C) ≠ 0 := fun h => h2 (neg_eq_zero.mp h)
  have n2 : -(C + C) ≠ C := by
    intro h
    apply h3
    rw [← add_neg_cancel (C + C), h]
  have n3 : -(C + C) ≠ -C := by
    intro h
    apply hC
    have h' : C + C = C := neg_inj.mp h
    calc C = C + C - C := by abel
      _ = C - C := by rw [h']
      _ = 0 := sub_self C
  have f1 : pointEqual (dialogExceptionPoint C) 0 = false :=
    Bool.eq_false_iff.mpr fun h => n1 ((pointEqual_true_iff _ _).mp h)
  have f2 : pointEqual (dialogExceptionPoint C) C = false :=
    Bool.eq_false_iff.mpr fun h => n2 ((pointEqual_true_iff _ _).mp h)
  have f3 : pointEqual (dialogExceptionPoint C) (-C) = false :=
    Bool.eq_false_iff.mpr fun h => n3 ((pointEqual_true_iff _ _).mp h)
  simp only [exceptionBit, f1, f2, f3, Bool.not_false, Bool.and_self]

/-- Structural enables for a finite table point that is a multiple of the generator. -/
theorem enables_of_multiple {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G) :
    cy ≠ -cy ∧ exceptionBit (.some hc) = true :=
  have h := double_triple_ne_zero (.some hc) k hk (WeierstrassCurve.Affine.Point.some_ne_zero hc)
  enables_true hc h.1 h.2

/-! ## The instantiated template

Uniform over the table reader `read`, the rows and the curve point read: if `row` holds a finite
multiple `C = k • G` and `rowD` holds `C + C`, the instantiated template is exactly `finiteS`, so it
inherits the full specification and the resource bounds. -/

section Instantiated
open Challenge MappedCompressed Baselines CompressedPointDialog ControlledPointLayout
variable {n : Nat} {read : CBit n → Bool} {row rowD : Fin n}

theorem finiteT_eq (L : ControlledPointLayout) (hw : L.Widths) {cx cy : Fp}
    (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G)
    (h : RowReads read row (.some hc)) (hD : RowReads read rowD (.some hc + .some hc)) :
    (finiteT L row rowD).instantiate read = finiteS L (.some hc) cx cy :=
  have e := enables_of_multiple hc k hk
  finiteT_inst L hw hc h hD e.1 e.2

/-- Control `b`, point `R ↦ R + C` when `b`, workspace zero before and after, phase restored,
for every measurement record. -/
theorem finiteT_spec (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G)
    (h : RowReads read row (.some hc)) (hD : RowReads read rowD (.some hc + .some hc))
    (R : Point) (b : Bool) :
    Triple (fun st => (Holds.holds st L.control b ∧ Holds.holds st L.point R) ∧
        Holds.holds st L.work 0) ((finiteT L row rowD).instantiate read)
      (fun st => (Holds.holds st L.control b ∧
        Holds.holds st L.point (if b then R + .some hc else R)) ∧ Holds.holds st L.work 0) := by
  rw [finiteT_eq L hw hc k hk h hD]
  exact finiteS_full_spec L hw hn R hc b

theorem finiteT_counts (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G)
    (h : RowReads read row (.some hc)) (hD : RowReads read rowD (.some hc + .some hc)) :
    toffoliCount ((finiteT L row rowD).instantiate read) = 2215341 ∧
      measurementCount ((finiteT L row rowD).instantiate read) = 1555877 := by
  have e := enables_of_multiple hc k hk
  rw [finiteT_eq L hw hc k hk h hD]
  exact finiteS_counts L hw hn _ cx cy (decide_eq_true e.1) e.2

theorem finiteT_supportQ (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G)
    (h : RowReads read row (.some hc)) (hD : RowReads read rowD (.some hc + .some hc)) :
    wires ((finiteT L row rowD).instantiate read) ⊆ (sitesQ L).toFinset := by
  rw [finiteT_eq L hw hc k hk h hD]
  exact finiteS_supportQ L hw hn _ cx cy

theorem finiteT_physical (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G)
    (h : RowReads read row (.some hc)) (hD : RowReads read rowD (.some hc + .some hc)) :
    GatePhysical ((finiteT L row rowD).instantiate read) := by
  rw [finiteT_eq L hw hc k hk h hD]
  exact finiteS_physical L hw hn _ cx cy

theorem finiteT_gateSlots_le (L : ControlledPointLayout) (hw : L.Widths)
    {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G)
    (h : RowReads read row (.some hc)) (hD : RowReads read rowD (.some hc + .some hc)) :
    gateSlots ((finiteT L row rowD).instantiate read) ≤ 47018000 := by
  rw [finiteT_eq L hw hc k hk h hD]
  exact finiteS_gateSlots_le L hw _ cx cy


end Instantiated

/-! ## Only `X` and `CX` gates are gated

The template's table-dependent instructions are single `X`/`CX` gates: no gated Toffoli and no
gated measurement, so the measurement sequence is the same for every table point. -/

section Clifford
variable {n : Nat}

/-- Every gated instruction of `t` is an `X` or a `CX`. -/
def Tmpl.Clifford (t : Tmpl n) : Prop := ∀ g ∈ t, g.CliffordGated

theorem Tmpl.clifford_append_iff (s t : Tmpl n) :
    Tmpl.Clifford (s ++ t) ↔ Tmpl.Clifford s ∧ Tmpl.Clifford t := by
  simp only [Tmpl.Clifford, List.mem_append, or_imp, forall_and]

theorem Tmpl.clifford_lit (p : Program) : Tmpl.Clifford (Tmpl.lit p : Tmpl n) := by
  intro g hg
  obtain ⟨i, -, rfl⟩ := List.mem_map.mp hg
  exact True.intro

theorem maskedT_clifford (c : Wire) (ws : List Wire) (ref : Nat → CBit n) :
    Tmpl.Clifford (maskedT c ws ref) := by
  induction ws generalizing ref with
  | nil => intro g hg; simp [maskedT] at hg
  | cons w ws ih =>
    intro g hg
    rw [maskedT, List.mem_cons] at hg
    rcases hg with rfl | hg
    · exact True.intro
    · exact ih _ g hg

theorem xorT_clifford (ws : List Wire) (ref : Nat → CBit n) : Tmpl.Clifford (xorT ws ref) := by
  induction ws generalizing ref with
  | nil => intro g hg; simp [xorT] at hg
  | cons w ws ih =>
    intro g hg
    rw [xorT, List.mem_cons] at hg
    rcases hg with rfl | hg
    · exact True.intro
    · exact ih _ g hg

theorem Tmpl.clifford_single_X (r : CBit n) (v : Bool) (w : Wire) :
    Tmpl.Clifford ([.gated r v (.X w)] : Tmpl n) := by
  intro g hg
  rw [List.mem_singleton] at hg
  subst hg
  exact True.intro

theorem Tmpl.clifford_single_CX (r : CBit n) (v : Bool) (c w : Wire) :
    Tmpl.Clifford ([.gated r v (.CX c w)] : Tmpl n) := by
  intro g hg
  rw [List.mem_singleton] at hg
  subst hg
  exact True.intro

theorem bitTestT_clifford (w y t : Wire) (r : CBit n) : Tmpl.Clifford (bitTestT w y t r) := by
  intro g hg
  simp only [bitTestT, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl <;> exact True.intro

theorem zeroWithT_clifford (T : Wire → Tmpl n) (hT : ∀ w, Tmpl.Clifford (T w)) (c : Wire)
    (bs : List ZeroBit) : Tmpl.Clifford (zeroWithT T c bs) := by
  induction bs generalizing c with
  | nil => exact hT c
  | cons b bs ih =>
    simp only [zeroWithT, Tmpl.clifford_append_iff, Tmpl.clifford_lit, ih, and_self]

theorem pairEqualT_clifford (L : ControlledPointLayout) (t₁ t₂ : Wire) (fin : CBit n)
    (xr : Nat → CBit n) (r₁ r₂ : CBit n) : Tmpl.Clifford (pairEqualT L t₁ t₂ fin xr r₁ r₂) := by
  have hz := zeroWithT_clifford (pairTailT (yLow L) t₁ t₂ r₁ r₂)
    (fun w => (Tmpl.clifford_append_iff _ _).mpr ⟨bitTestT_clifford _ _ _ _, bitTestT_clifford _ _ _ _⟩)
    L.control (pairPorts L)
  simp only [pairEqualT, pairXorT, Tmpl.clifford_append_iff, Tmpl.clifford_single_X, xorT_clifford,
    hz, and_self]

theorem shortEqualT_clifford (L : ControlledPointLayout) (c t : Wire) (fin : CBit n)
    (xr : Nat → CBit n) (y0 : CBit n) : Tmpl.Clifford (shortEqualT L c t fin xr y0) := by
  simp only [shortEqualT, shortXorT, Tmpl.clifford_append_iff, Tmpl.clifford_single_X,
    xorT_clifford, Tmpl.clifford_lit, and_self]

theorem constAddT_clifford (L : ControlledPointLayout) (r : List Wire) (ref : Nat → CBit n) :
    Tmpl.Clifford (constAddT L r ref) := by
  simp only [constAddT, Tmpl.clifford_append_iff, maskedT_clifford, Tmpl.clifford_lit, and_self]

theorem maskedPointT_clifford (c : Wire) (r : PointReg) (fin : CBit n) (xr yr : Nat → CBit n) :
    Tmpl.Clifford (maskedPointT c r fin xr yr) := by
  simp only [maskedPointT, Tmpl.clifford_append_iff, Tmpl.clifford_single_CX, maskedT_clifford,
    and_self]

/-- Every gated instruction of the block template is an `X` or a `CX`. -/
theorem finiteT_clifford (L : ControlledPointLayout) (row rowD : Fin n) :
    Tmpl.Clifford (finiteT L row rowD) := by
  simp only [finiteT, cornersT, genericT, recoveryT, Tmpl.clifford_append_iff, Tmpl.clifford_lit,
    pairEqualT_clifford, shortEqualT_clifford, constAddT_clifford, maskedPointT_clifford, and_self]

/-- With only `X`/`CX` gated, the Toffoli and measurement counts do not depend on the table. -/
theorem Tmpl.counts_instantiate (read : CBit n → Bool) {t : Tmpl n} (h : Tmpl.Clifford t) :
    toffoliCount (t.instantiate read) = toffoliCount (Tmpl.all t) ∧
      measurementCount (t.instantiate read) = measurementCount (Tmpl.all t) := by
  induction t with
  | nil => exact ⟨rfl, rfl⟩
  | cons g t ih =>
    have ht : Tmpl.Clifford t := fun g' hg' => h g' (List.mem_cons_of_mem _ hg')
    have hg : g.CliffordGated := h g List.mem_cons_self
    obtain ⟨i1, i2⟩ := ih ht
    rw [Tmpl.instantiate_cons, toffoliCount_append, measurementCount_append, i1, i2]
    simp only [Tmpl.all, List.map_cons]
    cases g with
    | lit i => cases i <;> simp [TInstr.instantiate, TInstr.instr, toffoliCount, measurementCount]
    | gated r v i =>
      cases i with
      | X w =>
        by_cases hr : read r = v <;>
          simp [TInstr.instantiate, TInstr.instr, hr, toffoliCount, measurementCount]
      | CX c w =>
        by_cases hr : read r = v <;>
          simp [TInstr.instantiate, TInstr.instr, hr, toffoliCount, measurementCount]
      | CCX a b c => exact absurd hg (by simp [TInstr.CliffordGated])
      | measureX w c₀ c₁ => exact absurd hg (by simp [TInstr.CliffordGated])

/-- Wires of a sublist program are wires of the program. -/
theorem wires_subset_of_sublist {p q : Program} (h : p.Sublist q) : wires p ⊆ wires q := by
  induction h with
  | slnil => exact Finset.Subset.refl _
  | cons i _ ih => simp only [wires]; exact ih.trans Finset.subset_union_right
  | cons₂ i _ ih => simp only [wires]; exact Finset.union_subset_union (Finset.Subset.refl _) ih

/-- For every table reader, the instantiated template only touches wires of `Tmpl.all t`. -/
theorem Tmpl.wires_instantiate (read : CBit n → Bool) (t : Tmpl n) :
    wires (t.instantiate read) ⊆ wires (Tmpl.all t) :=
  wires_subset_of_sublist (Tmpl.instantiate_sublist read t)

end Clifford

section CountsAny
open Challenge MappedCompressed Baselines CompressedPointDialog ControlledPointLayout
variable {n : Nat}

/-- For every table reader (any `Q`, including points the specification does not cover), the
instantiated block has the same Toffoli and measurement counts: only `X`/`CX` are gated. -/
theorem finiteT_counts_any (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (row rowD : Fin n) (hr : row ≠ rowD) (read : CBit n → Bool) :
    toffoliCount ((finiteT L row rowD).instantiate read) = 2215341 ∧
      measurementCount ((finiteT L row rowD).instantiate read) = 1555877 := by
  have hcl := finiteT_clifford L row rowD
  -- a reader for `row = G`, `rowD = G + G`
  let P : Point := .some (ShorECDLP.Secp256k1.generator_nonsingular :
    curve.toAffine.Nonsingular _ _)
  let read₀ : CBit n → Bool := fun ref =>
    (ShorECDLP.Challenge.fieldValue (toA (if ref.point = row then P else P + P)) ref.field).testBit
      ref.bit.val
  have h₀ : RowReads read₀ row P := fun f b => by simp [read₀]
  have hD₀ : RowReads read₀ rowD (P + P) := fun f b => by simp [read₀, Ne.symm hr]
  have hk : toA P = (1 : ℕ) • ShorECDLP.Secp256k1.G := by rw [one_nsmul]; rfl
  obtain ⟨a1, a2⟩ := Tmpl.counts_instantiate read hcl
  obtain ⟨b1, b2⟩ := Tmpl.counts_instantiate read₀ hcl
  obtain ⟨c1, c2⟩ := finiteT_counts (read := read₀) L hw hn _ 1 hk h₀ hD₀
  exact ⟨by rw [a1, ← b1, c1], by rw [a2, ← b2, c2]⟩

end CountsAny

/-! ## B's contract on its fixed layout

`Challenge.encodes b R` (control wire, point register, every other wire clean) on B's `layout`:
the instantiated template meets B's per-addition contract, its wires lie in the 1,898-site
inventory `sitesQ layout` (`sitesQ_length`), and `qubits` counts at most those sites. -/

section Contract
open Challenge Baselines Entrant
variable {n : Nat} {read : CBit n → Bool} {row rowD : Fin n}

theorem finiteT_encodes {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G)
    (h : RowReads read row (.some hc)) (hD : RowReads read rowD (.some hc + .some hc))
    (b : Bool) (R : Point) :
    Triple (Challenge.encodes b R) ((finiteT layout row rowD).instantiate read)
      (Challenge.encodes b (if b then R + .some hc else R)) := by
  rw [finiteT_eq layout layout_widths hc k hk h hD]
  exact fixed_correct _ b R _ (finiteS_full_spec layout layout_widths layout_nodup R hc b)
    ((finiteS_support layout layout_widths layout_nodup _ cx cy).trans
      (sites_used layout layout_widths))

/-- The 514 I/O wires are sites of `sitesQ layout` (copied from B's `Entrant.Main`). -/
theorem io_subset_sitesQ : ioWires ⊆ (sitesQ layout).toFinset := by
  intro w hw
  have h := io_partition w hw
  simp only [sitesQ, CompressedPointSquare.residents, List.mem_toFinset, List.mem_append,
    List.mem_cons, List.not_mem_nil, or_false]
  rcases h with hp | hc
  · exact Or.inl (Or.inl (Or.inl hp))
  · exact Or.inl (Or.inl (Or.inr hc))

theorem finiteT_qubits_le {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (k : ℕ)
    (hk : toA (.some hc) = k • ShorECDLP.Secp256k1.G)
    (h : RowReads read row (.some hc)) (hD : RowReads read rowD (.some hc + .some hc)) :
    Challenge.qubits ((finiteT layout row rowD).instantiate read) ≤ 1898 := by
  have hs := finiteT_supportQ layout layout_widths layout_nodup hc k hk h hD
  have hu : ioWires ∪ wires ((finiteT layout row rowD).instantiate read) ⊆
      (sitesQ layout).toFinset := Finset.union_subset io_subset_sitesQ hs
  calc Challenge.qubits _ ≤ (sitesQ layout).toFinset.card := Finset.card_le_card hu
    _ ≤ (sitesQ layout).length := List.toFinset_card_le _
    _ = 1898 := sitesQ_length layout layout_widths

end Contract

end ECDSAAdd.ShorPort

end

