def narrowCF14 : ModNarrow bodyC 14 where
  records := 1617555
  tBound := 15537592
  credit := 2 * ECDSAAdd.toffoliCount (ECDSAAdd.Baselines.normalizeProgram WEX.fastWindowSignProgram) +
