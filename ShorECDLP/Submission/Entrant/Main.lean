    (hSlots : 32 * windowSlots + 176382 ≤ officialLimits.gateSlots)
    (hRecords : 262143 + 21 * impl.records15 + 10 * impl.records14 + 473 + body.reset.length + 34114 ≤ officialLimits.measurements) :
