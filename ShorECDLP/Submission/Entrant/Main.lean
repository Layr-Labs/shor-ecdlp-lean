      apply Fin.ext
      exact (width_address k hk s).symm
    rw [he]
    exact (h ⟨tableAddressValue windowBits s, hw⟩).symm
  unfold Single.Physical.tablePoint
  simp only [Nat.mod_eq_of_lt hn, Nat.mod_eq_of_lt hw]
