  heo0 : ∀ C D : ℝ, 0 < D → D ≤ C → phi (2 * C) D + phi (2 * C) (C + D) ≤ rhoEO * phi C D
  hinv : ∀ C D M Mh : ℝ, 0 < C → 0 < D → 0 < M → 0 < Mh → C * D ≤ M → M ^ (a - 2) ≤ Mh ^ 2 →
    1 / (C * D) ≤ (Mh / 2) * phi C D

