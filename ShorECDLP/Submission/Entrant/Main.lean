/-- Once every specialized arithmetic record has the same result, the emitted window
has one coefficient list for all addresses, all clean-path states and every history. -/
theorem compile_specialization_coherent {n : Nat} (read : ConstantBit n → Bool)
    (bits paths : List Wire) (root : Wire) (code : WCode n)
    (hl : bits.length ≤ paths.length) (hp : ∀ i ∈ code, Placed bits paths root i)
    (Valid : BasisState → Prop) (result : BasisState → BasisState)
    (hrun : ∀ s, Valid s → ∀ m,
      ECDSAAdd.run ((specialize code (tableAddressValue bits s)).instantiate read) m ⟨false, s⟩ =
        ⟨false, result s⟩)
