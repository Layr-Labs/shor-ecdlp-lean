  have hclear : M * ((51017 / 100000 : ℝ) * (P_F3 C D / (10000 * C ^ 2 * D ^ 2 * (C + D) ^ 5 * Q_F C D)) -
      (P_F3 (2 * C) D / (10000 * (2 * C) ^ 2 * D ^ 2 * (2 * C + D) ^ 5 * Q_F (2 * C) D) +
