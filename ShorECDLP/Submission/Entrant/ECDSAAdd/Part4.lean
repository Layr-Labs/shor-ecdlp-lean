theorem ports_map (f w : Wire → Wire) (sign : Wire) :
    mapCircuit f (ports w sign)=ports (f∘w) (f sign) := by
  simp only [mapCircuit,mapCleanup,ports,wireBlock_map,List.map_append,List.map_cons,List.map_nil,Function.comp_def]



















