theorem select_avoid (b source flag : Wire) (v : Bool) (P : Program)
    (hb : base 767≠b) (hs : base 767≠source) (hf : base 767≠flag)
    (hp : base 767∉wires P) : base 767∉wires (transcriptSelectWindow b source flag v P) := by
