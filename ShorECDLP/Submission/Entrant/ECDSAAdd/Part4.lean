    (sub : S⊆l.toFinset) (hx : x∉S) (hy : y∉S) (hz : z∉S) (hw' : w∉S)
    (xl : x∈l) (yl : y∈l) (zl : z∈l) (wl : w∈l) (xy : x≠y) (xz : x≠z) (xw : x≠w)
    (yz : y≠z) (yw : y≠w) (zw : z≠w) :
    S.card≤l.length-4 := by
