    obtain ⟨⟨hcy, hc1, hc2⟩, ⟨hy1, hy2⟩, -, -⟩ := hchain
    simp only [zeroWith]
    cases e₁ <;> cases e₂ <;> cases (yBit C) <;> cases (yBit D) <;>
      simp [pairTail, bitTest, zeroFlag, GatePhysical, PhysicalInstr, ProperGate, gatePhysical_append,
        hc1, hc2, hy1, hy2]
