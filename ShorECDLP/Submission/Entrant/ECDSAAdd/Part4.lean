    apply h_sources_fresh w hn true q
    exact List.mem_flatMap.mpr ⟨b,hb,by simpa using hq⟩
  · intro b hb q hq
    apply desired_fresh w hn q
    exact List.mem_flatMap.mpr ⟨b,hb,by simpa using hq⟩

theorem inverse_physical (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) :
    GatePhysical (inverse w) := by
