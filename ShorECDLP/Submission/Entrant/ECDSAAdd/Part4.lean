theorem finite_wires (L : ControlledPointLayout) (C : Point) (cy : Fp) (Gen : Program) :
    wires (finiteProgram L C cy Gen) ⊆ wires (finiteProgramN L C cy Gen) ∪
      wires (renameProgram (sigP L) (shared L C)) := by
