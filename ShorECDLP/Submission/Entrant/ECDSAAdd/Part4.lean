def U (L : ControlledPointLayout) : Equiv.Perm Wire :=
  Equiv.swap (L.core.poolWire 684) (L.core.poolWire 717)

def finiteProgram5 (L : ControlledPointLayout) (C : Point) (cy : Fp) (Gen : Program) : Program :=
  renameProgram (U L) (finiteProgramN L C cy (renameProgram (U L) Gen))

section
variable (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
include hw

theorem U_pool (q : Wire) (hq : q ∈ L.dialogPool) : U L q ∈ L.dialogPool := by
  have a := Square5Placement.pool_member L hw 684 (by omega)
  have b := Square5Placement.pool_member L hw 717 (by omega)
  by_cases ha : q = L.core.poolWire 684
  · rw [ha, U, Equiv.swap_apply_left]; exact b
  · by_cases hb : q = L.core.poolWire 717
    · rw [hb, U, Equiv.swap_apply_right]; exact a
    · rw [U, Equiv.swap_apply_of_ne_of_ne ha hb]; exact hq

theorem U_outside (q : Wire) (hq : q ∉ L.dialogPool) : U L q = q := by
  apply Equiv.swap_apply_of_ne_of_ne
  · exact fun e => hq (e ▸ Square5Placement.pool_member L hw 684 (by omega))
  · exact fun e => hq (e ▸ Square5Placement.pool_member L hw 717 (by omega))

theorem genericOK_relabel {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy)
    (Gen : Program) (hGen : GenericOK L hc Gen) : GenericOK L hc (renameProgram (U L) Gen) := by
  intro R b f hg s m hi
  have h := hGen R b f hg s m hi
  rw [Square5Placement.pool_relabel_state_eq L (U L) (U_pool L hw) (U_outside L hw)
    Gen s m hi.clean h.2.clean]
  exact h

include hn

theorem finiteProgram5_spec (R : Point) {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy)
    (b : Bool) (Gen : Program) (hGen : GenericOK L hc Gen) :
    Triple (PointDialogBoundary L R b (fun _ => false)) (finiteProgram5 L (.some hc) cy Gen)
      (PointDialogBoundary L (if b then R+.some hc else R) b (fun _ => false)) := by
  intro s m hi
  have h := finiteProgramN_spec L hw hn R hc b (renameProgram (U L) Gen)
    (genericOK_relabel L hw hc Gen hGen) s m hi
  unfold finiteProgram5
  rw [Square5Placement.pool_relabel_state_eq L (U L) (U_pool L hw) (U_outside L hw)
    _ s m hi.clean h.2.clean]
  exact h



























