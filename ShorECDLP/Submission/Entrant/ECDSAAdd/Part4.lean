    · exact pt _ (by simp [PointAddLayout.pointWires, h])
    · exact OB5Support.raw_sub_generic L (List.mem_toFinset.mpr (finLow_sites L hw 255 (by omega) q h))
  have r : wires (renameProgram (swapF L) (fastGeneric3F L cx cy)) ⊆
