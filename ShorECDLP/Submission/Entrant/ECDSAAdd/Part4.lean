section
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run wires

private theorem replace_middle (lead old fresh tail : Program)
    (count : measurementCount old=measurementCount fresh) (s : State) (m : List Bool)
    (eq : run old (m.drop (measurementCount lead)) (run lead m s)=
      run fresh (m.drop (measurementCount lead)) (run lead m s)) :
    run (lead++old++tail) m s=run (lead++fresh++tail) m s := by
  simp only [List.append_assoc,run_append,run_take]
  rw [eq,count]

theorem old_inverse_sandwich (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (sameM : measurementCount (rawSub L)=measurementCount (BalancedInverse.rawSubtract L))
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    run (ShortBiasedInverse.program L) m s=
      run ([.CX L.ymsb L.sourceGuard]++inverse L++[.CX L.ymsb L.sourceGuard]) m s := by
  let lead:Program:=[.CX L.ymsb L.sourceGuard]++inversePrefix L
  let tail:Program:=(seed L).reverse++[.CX L.ymsb L.sourceGuard]
  have ready:=inverse_prefix_ready L hw hn B R Y hr hy s m hs hR hY hc
  have prefixState : run lead m s=run (inversePrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s) := by
    simp only [lead,run_append,show measurementCount [Instr.CX L.ymsb L.sourceGuard]=0 from rfl,
      List.take_zero,List.drop_zero]
  have eq : run (lead++BalancedInverse.rawSubtract L++tail) m s=
      run (lead++rawSub L++tail) m s := by
    apply replace_middle _ _ _ _ sameM.symm
    rw [prefixState]
    exact (rawSub_eq L hw hn _ _ ready.1 ready.2).symm
  have oldSeed : seedViews L=[.CX L.ymsb L.sourceGuard]++seed L:=by rfl
  simpa only [ShortBiasedInverse.program,inverse,inversePrefix,lead,tail,oldSeed,
    List.reverse_append,List.reverse_cons,List.reverse_nil,List.nil_append,List.append_assoc] using eq

theorem inverse_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (sameM : measurementCount (rawSub L)=measurementCount (BalancedInverse.rawSubtract L))
    (free : L.sourceGuard∉wires (inverse L))
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    run (inverse L) m s=run (ShortBiasedInverse.program L) m s := by
  have old:=ShortBiasedInverse.program_correct L hw hn B R Y hr hy s m hs hR hY hc
  have same:=old_inverse_sandwich L hw hn sameM B R Y hr hy s m hs hR hY hc
  have scalar:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at scalar
  have ne:L.ymsb≠L.sourceGuard:=by tauto
  have notR:L.ymsb∉L.r:=by
    intro h
    have split:=List.nodup_append'.mp (show (BalancedCircuit.rawSource L++(rawTarget L++L.carry)).Nodup from by
      simpa only [List.append_assoc] using (List.nodup_cons.mp (rawLayoutND L hn)).2)
    have hy:L.ymsb∈BalancedCircuit.rawSource L:=by simp [BalancedCircuit.rawSource,BalancedCleanup.Layout.y]
    have ht:L.ymsb∈rawTarget L++L.carry:=by simp [rawTarget,h]
    exact List.disjoint_left.mp split.2.2 hy ht
  have out : (run ([.CX L.ymsb L.sourceGuard]++inverse L++[.CX L.ymsb L.sourceGuard]) m s).basis L.ymsb=
      s.basis L.ymsb := by rw [←same]; exact old.2.2.2 _ notR
  have stable : (run (inverse L) m (run [.CX L.ymsb L.sourceGuard] [] s)).basis L.ymsb=s.basis L.ymsb := by
    rw [←copy_sandwich_source L.ymsb L.sourceGuard ne]
    exact out
  exact (copy_sandwich_cancel L.ymsb L.sourceGuard (inverse L) free s m stable).symm.trans same.symm
end ECDSAAdd.Frontier.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit

theorem raw_counts (L : Layout) (hw : L.Widths) :
    toffoliCount (rawAdd L)=256 ∧ measurementCount (rawAdd L)=256 ∧
    toffoliCount (rawSub L)=256 ∧ measurementCount (rawSub L)=256 := by
  have w:=BalancedCircuit.widths L hw
  have len : (source L).length=(rawSource L).length := by simp [source,rawSource]
  have a:=addInPlace_counts (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have b:=subInPlace_counts (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have s:=signComplement_counts L.sign L.y
  simp only [rawAdd,rawSub,toffoliCount_append,measurementCount_append,a.1,a.2,b.1,b.2,s.1,s.2,w.2.1]
  norm_num

theorem old_raw_counts (L : Layout) (hw : L.Widths) :
    toffoliCount (BalancedCircuit.rawAdd L)=256 ∧ measurementCount (BalancedCircuit.rawAdd L)=256 ∧
    toffoliCount (BalancedInverse.rawSubtract L)=256 ∧ measurementCount (BalancedInverse.rawSubtract L)=256 := by
  have w:=BalancedCircuit.widths L hw
  have a:=addInPlace_counts (rawSource L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have b:=subInPlace_counts (rawSource L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have s:=signComplement_counts L.sign (rawSource L)
  simp only [BalancedCircuit.rawAdd,BalancedInverse.rawSubtract,toffoliCount_append,measurementCount_append,
    a.1,a.2,b.1,b.2,s.1,s.2,w.2.1]
  norm_num

theorem raw_measurement_eq (L : Layout) (hw : L.Widths) :
    measurementCount (rawAdd L)=measurementCount (BalancedCircuit.rawAdd L) ∧
    measurementCount (rawSub L)=measurementCount (BalancedInverse.rawSubtract L) := by
  have a:=raw_counts L hw
  have b:=old_raw_counts L hw
  omega
end ECDSAAdd.Frontier.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.GuardCompression
open ECDSAAdd.Arithmetic ECDSAAdd.RecordedQuantum BalancedCircuit
theorem addInPlace_readonly_physical (x y carry : List Wire) (cin : Wire)
    (hn : (cin :: y ++ carry).Nodup)
    (hd : List.Disjoint x (cin :: y ++ carry)) : GatePhysical (addInPlace x y carry cin) := by
  induction x generalizing y carry cin with
  | nil => simp [addInPlace,GatePhysical]
  | cons a xs ih =>
    cases xs with
    | nil =>
      cases y with
      | nil => simp [addInPlace,GatePhysical]
      | cons b ys =>
        cases ys with
        | cons b' ys => simp [addInPlace,GatePhysical]
        | nil =>
          have hab : a ≠ b := by
            intro e
            exact List.disjoint_left.mp hd List.mem_cons_self (by simp [e])
          have hcb : cin ≠ b := by
            intro e; subst cin
            have h := List.nodup_iff_count.mp hn b
            simp only [List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
            omega
          simp [addInPlace,GatePhysical,PhysicalInstr,ProperGate,hab,hcb]
    | cons a' xs =>
      cases y with
      | nil => simp [addInPlace,GatePhysical]
      | cons b ys =>
        cases ys with
        | nil => simp [addInPlace,GatePhysical]
        | cons b' ys =>
          cases carry with
          | nil => simp [addInPlace,GatePhysical]
          | cons k ks =>
            have hs : [a,b,cin,k].Nodup := by
              have hk : [b,cin,k].Nodup := by
                apply List.nodup_iff_count.mpr; intro q
                have h := List.nodup_iff_count.mp hn q
                simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
              have away : a∉[b,cin,k] := by
                intro mem
                apply List.disjoint_left.mp hd List.mem_cons_self
                simp only [List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at mem ⊢
                tauto
              exact List.nodup_cons.mpr ⟨away,hk⟩
            have ht : (k :: (b'::ys) ++ ks).Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := List.nodup_iff_count.mp hn q
              simp only [List.count_cons,List.count_append] at h ⊢; omega
            have hdis : List.Disjoint (a'::xs) (k :: (b'::ys) ++ ks) := by
              apply List.disjoint_left.mpr
              intro w hw hh
              apply List.disjoint_left.mp hd (List.mem_cons_of_mem _ hw)
              simp only [List.mem_cons,List.mem_append] at hh ⊢
              tauto
            have htail := ih (b'::ys) ks k ht hdis
            rw [addInPlace]
            simp only [gatePhysical_append]
            refine ⟨⟨⟨majority_physical _ _ _ _ hs,htail⟩,eraseCarry_physical _ _ _ _⟩,?_⟩
            simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
              not_or,not_false_eq_true,and_true] at hs
            have hcb : cin ≠ b := Ne.symm hs.2.1.1
            simp [GatePhysical,PhysicalInstr,ProperGate,hs.1.1,hcb]

private theorem physical_facts (L : Layout) (hn : L.wires.Nodup) :
    L.y.Nodup ∧ List.Disjoint L.y (L.sign::rawTarget L++L.carry) ∧
    (L.sign::rawTarget L++L.carry).Nodup := by
  have all : (L.sign::(L.y++rawTarget L++L.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (rawLayoutND L hn) q
    simp only [rawSource,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have split:=List.nodup_append'.mp (show (L.y++(rawTarget L++L.carry)).Nodup from by
    simpa only [List.append_assoc] using (List.nodup_cons.mp all).2)
  refine ⟨split.1,?_,?_⟩
  · apply List.disjoint_left.mpr
    intro q hq hh
    rcases List.mem_cons.mp hh with rfl|hh
    · exact (List.nodup_cons.mp all).1 (by simp [hq])
    · exact List.disjoint_left.mp split.2.2 hq hh
  · apply List.nodup_cons.mpr
    exact ⟨fun h=>(List.nodup_cons.mp all).1 (by
      simpa only [List.append_assoc] using List.mem_append_right L.y h),split.2.1⟩

private theorem physical_source_sub (L : Layout) (a : Wire) (ha : a∈source L) : a∈L.y := by
  simp only [source,List.mem_append,List.mem_singleton] at ha
  rcases ha with h|rfl
  · exact h
  · simp [BalancedCleanup.Layout.y]


theorem subInPlace_readonly_physical (x y carry : List Wire) (cin : Wire)
    (hn : (cin :: y ++ carry).Nodup) (hd : List.Disjoint x (cin :: y ++ carry)) :
    GatePhysical (subInPlace x y carry cin) := by
  simp only [subInPlace,gatePhysical_append]
  exact ⟨⟨notRegister_physical _,addInPlace_readonly_physical _ _ _ _ hn hd⟩,notRegister_physical _⟩

theorem raw_physical (L : Layout) (hn : L.wires.Nodup) :
    GatePhysical (rawAdd L) ∧ GatePhysical (rawSub L) := by
  have facts:=physical_facts L hn
  have dis : List.Disjoint (source L) (L.sign::rawTarget L++L.carry) := by
    apply List.disjoint_left.mpr
    intro q hq hm
    exact List.disjoint_left.mp facts.2.1 (physical_source_sub L q hq) hm
  have sc : GatePhysical (signComplement L.sign L.y) := by
    simp only [signComplement,GatePhysical,List.mem_map]
    intro i hi
    obtain ⟨q,hq,rfl⟩:=hi
    have ne : L.sign≠q := fun e=>List.disjoint_left.mp facts.2.1 hq (by simp [e])
    simpa [PhysicalInstr,ProperGate] using ne
  have a:=addInPlace_readonly_physical (source L) (rawTarget L) L.carry L.sign facts.2.2 dis
  have b:=subInPlace_readonly_physical (source L) (rawTarget L) L.carry L.sign facts.2.2 dis
  simpa only [rawAdd,rawSub,gatePhysical_append] using And.intro (And.intro (And.intro sc a) sc) (And.intro (And.intro sc b) sc)
end ECDSAAdd.Frontier.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit
attribute [local irreducible] wires GatePhysical

theorem old_seed_eq (L : Layout) : seedViews L=[.CX L.ymsb L.sourceGuard]++seed L := by rfl

theorem old_cleanup_eq (L : Layout) :
    BiasedCircuit.cleanupSuffix L=cleanup L++[.CX L.ymsb L.sourceGuard] := by
  simp only [BiasedCircuit.cleanupSuffix,cleanup,List.append_assoc]

theorem counts (L : Layout) (hw : L.Widths) :
    toffoliCount (forward L)=1021 ∧ measurementCount (forward L)=1021 ∧
    toffoliCount (inverse L)=1021 ∧ measurementCount (inverse L)=1021 := by
  have f:=ShortBiasedFold.counts L hw
  have i:=ShortBiasedInverse.counts L hw
  have a:=raw_counts L hw
  have b:=old_raw_counts L hw
  simp only [ShortBiasedFold.program,ShortBiasedFold.biasedPrefix,old_seed_eq,old_cleanup_eq,
    ShortBiasedInverse.program,toffoliCount_append,measurementCount_append,
    toffoliCount_reverse,measurementCount_reverse,b.1,b.2.1,b.2.2.1,b.2.2.2] at f i
  simp only [forward,inverse,toffoliCount_append,measurementCount_append,
    toffoliCount_reverse,measurementCount_reverse,a.1,a.2.1,a.2.2.1,a.2.2.2]
  norm_num [toffoliCount,measurementCount] at f i
  omega

theorem raw_support_subset (L : Layout) (hw : L.Widths) :
    wires (rawAdd L)⊆wires (BalancedCircuit.rawAdd L) ∧
    wires (rawSub L)⊆wires (BalancedInverse.rawSubtract L) := by
  have w:=BalancedCircuit.widths L hw
  have len : (source L).length=(rawSource L).length := by simp [source,rawSource]
  have newadd:=addInPlace_wires (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have newsub:=subInPlace_wires (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have oldadd:=addInPlace_wires (rawSource L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have oldsub:=subInPlace_wires (rawSource L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have inclusion : (L.sign::source L++rawTarget L++L.carry).toFinset⊆
      (L.sign::rawSource L++rawTarget L++L.carry).toFinset := by
    intro q hq
    simp only [source,rawSource,List.mem_toFinset,List.mem_cons,List.mem_append,List.mem_singleton,List.not_mem_nil,or_false,or_assoc] at hq ⊢
    have ymsb : L.ymsb∈L.y := by simp [BalancedCleanup.Layout.y]
    have ym : q=L.ymsb → q∈L.y := by intro e; rw [e]; exact ymsb
    tauto
  have sign : wires (signComplement L.sign L.y)⊆(L.sign::source L++rawTarget L++L.carry).toFinset := by
    apply (signComplement_wires_subset L.sign L.y).trans
    intro q hq
    simp only [source,List.mem_toFinset,List.mem_cons,List.mem_append,List.mem_singleton,
      List.not_mem_nil,or_false,or_assoc] at hq ⊢
    tauto
  have nadd : wires (rawAdd L)⊆(L.sign::source L++rawTarget L++L.carry).toFinset := by
    simp only [rawAdd,wires_append,Finset.union_subset_iff,newadd]
    exact ⟨⟨sign,Finset.Subset.refl _⟩,sign⟩
  have nsub : wires (rawSub L)⊆(L.sign::source L++rawTarget L++L.carry).toFinset := by
    simp only [rawSub,wires_append,Finset.union_subset_iff,newsub]
    exact ⟨⟨sign,Finset.Subset.refl _⟩,sign⟩
  have oadd : (L.sign::rawSource L++rawTarget L++L.carry).toFinset⊆wires (BalancedCircuit.rawAdd L) := by
    rw [BalancedCircuit.rawAdd,wires_append,wires_append,oldadd]
    exact Finset.subset_union_right.trans (Finset.subset_union_left)
  have osub : (L.sign::rawSource L++rawTarget L++L.carry).toFinset⊆wires (BalancedInverse.rawSubtract L) := by
    rw [BalancedInverse.rawSubtract,wires_append,wires_append,oldsub]
    exact Finset.subset_union_right.trans (Finset.subset_union_left)
  exact ⟨nadd.trans (inclusion.trans oadd),nsub.trans (inclusion.trans osub)⟩

theorem forward_support (L : Layout) (hw : L.Widths) : wires (forward L)⊆L.wires.toFinset := by
  have old:=ShortBiasedProperties.forward_support L hw
  have raw:=(raw_support_subset L hw).1
  simp only [ShortBiasedFold.program,ShortBiasedFold.biasedPrefix,old_seed_eq,old_cleanup_eq,
    wires_append,Finset.union_subset_iff] at old
  simp only [forward,wires_append,Finset.union_subset_iff]
  have rr : wires (rawAdd L)⊆L.wires.toFinset := raw.trans (by tauto)
  tauto

theorem inverse_support (L : Layout) (hw : L.Widths) : wires (inverse L)⊆L.wires.toFinset := by
  have old:=ShortBiasedProperties.inverse_support L hw
  have raw:=(raw_support_subset L hw).2
  simp only [ShortBiasedInverse.program,old_seed_eq,List.reverse_append,wires_append,wires_reverse,
    Finset.union_subset_iff] at old
  simp only [inverse,wires_append,wires_reverse,Finset.union_subset_iff]
  have rr : wires (rawSub L)⊆L.wires.toFinset := raw.trans (by tauto)
  tauto

theorem forward_physical (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) : GatePhysical (forward L) := by
  have old:=ShortBiasedPhysical.forward_physical L hw hn
  have raw:=(raw_physical L hn).1
  simp only [ShortBiasedFold.program,ShortBiasedFold.biasedPrefix,old_seed_eq,old_cleanup_eq,
    gatePhysical_append] at old
  simp only [forward,gatePhysical_append]
  tauto

theorem inverse_physical (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) : GatePhysical (inverse L) := by
  have old:=ShortBiasedPhysical.inverse_physical L hw hn
  have raw:=(raw_physical L hn).2
  simp only [ShortBiasedInverse.program,old_seed_eq,List.reverse_append,gatePhysical_append] at old
  simp only [inverse,gatePhysical_append]
  tauto
end ECDSAAdd.Frontier.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
namespace ECDSAAdd.Frontier.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit

def resetUnused (L : Layout) : Layout := {L with sourceGuard:=L.one,cout:=L.one,plus:=L.one}

theorem forward_ignores_unused (L : Layout) : forward (resetUnused L)=forward L := by rfl
theorem inverse_ignores_unused (L : Layout) : inverse (resetUnused L)=inverse L := by rfl

theorem reset_unused_away (L : Layout) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus]) : q∉(resetUnused L).wires := by
  have nd : ([L.sourceGuard,L.cout,L.plus]++([L.minus]++L.toLayout.wires)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro w
    have h:=List.nodup_iff_count.mp hn w
    simp only [Layout.wires,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have away:=List.disjoint_left.mp (List.nodup_append'.mp nd).2.2 hq
  intro h
  apply away
  change q∈[L.one,L.one,L.minus,L.one]++L.toLayout.wires at h
  simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false,or_assoc] at h ⊢
  have qo : q=L.one → q∈L.toLayout.wires := by
    intro e
    rw [e]
    simp [BalancedCleanup.Layout.wires]
  tauto

theorem unused_free (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus]) :
    q∉wires (forward L) ∧ q∉wires (inverse L) := by
  have hw' : (resetUnused L).Widths := hw
  have f:=forward_support (resetUnused L) hw'
  have i:=inverse_support (resetUnused L) hw'
  rw [forward_ignores_unused] at f
  rw [inverse_ignores_unused] at i
  exact ⟨fun h=>reset_unused_away L hn q hq (List.mem_toFinset.mp (f h)),
    fun h=>reset_unused_away L hn q hq (List.mem_toFinset.mp (i h))⟩

theorem guard_free (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.sourceGuard∉wires (forward L) ∧ L.sourceGuard∉wires (inverse L) :=
  unused_free L hw hn _ (by simp)
end ECDSAAdd.Frontier.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.GuardCompression
open ECDSAAdd.Arithmetic FieldRename
attribute [local irreducible] signComplement addInPlace subInPlace

theorem source_map (f : Wire → Wire) (L : Layout) :
    (source L).map f=source (mapCircuit f L) := by
  simp only [source,List.map_append,List.map_cons,List.map_nil,bf_y_map]
  rfl

theorem rawAdd_natural (f : Wire → Wire) (L : Layout) :
    renameProgram f (rawAdd L)=rawAdd (mapCircuit f L) := by
  simp only [rawAdd,rename_append,signComplement_natural,addInPlace_natural,
    ← source_map,← rawTarget_map,← bf_y_map]
  rfl

theorem rawSub_natural (f : Wire → Wire) (L : Layout) :
    renameProgram f (rawSub L)=rawSub (mapCircuit f L) := by
  simp only [rawSub,rename_append,signComplement_natural,subInPlace_natural,
    ← source_map,← rawTarget_map,← bf_y_map]
  rfl

theorem seed_natural (f : Wire → Wire) (L : Layout) (hy : L.ylow≠[]) :
    renameProgram f (seed L)=seed (mapCircuit f L) := by
  have h:=FieldRename.seedViews_natural f L hy
  simp only [old_seed_eq,rename_append] at h
  change [.CX (f L.ymsb) (f L.sourceGuard)]++renameProgram f (seed L)=
    [.CX (f L.ymsb) (f L.sourceGuard)]++seed (mapCircuit f L) at h
  exact List.append_cancel_left h

theorem cleanup_natural (f : Wire → Wire) (L : Layout) :
    renameProgram f (cleanup L)=cleanup (mapCircuit f L) := by
  have h:=bf_suffix_natural f L
  simp only [old_cleanup_eq,rename_append] at h
  change renameProgram f (cleanup L)++[.CX (f L.ymsb) (f L.sourceGuard)]=
    cleanup (mapCircuit f L)++[.CX (f L.ymsb) (f L.sourceGuard)] at h
  exact List.append_cancel_right h

theorem remainder_natural (f : Wire → Wire) (L : Layout) (hw : L.Widths) (hy : L.ylow≠[]) :
    renameProgram f (ShortBiasedFold.remainder L)=ShortBiasedFold.remainder (mapCircuit f L) := by
  have h:=ShortBiasedNatural.forward_prefix_natural f L hw hy
  simp only [ShortBiasedFold.biasedPrefix,rename_append,FieldRename.seedViews_natural f L hy,
    FieldRename.rawAdd_natural] at h
  exact List.append_cancel_left (List.append_cancel_left h)

theorem forward_natural (f : Wire → Wire) (L : Layout) (hw : L.Widths) :
    renameProgram f (forward L)=forward (mapCircuit f L) := by
  have hy : L.ylow≠[] := by intro e; have h:=hw.2.1; rw [e] at h; simp at h
  simp only [forward,rename_append,seed_natural f L hy,rawAdd_natural,remainder_natural f L hw hy,
    cleanup_natural]

theorem inverse_natural (f : Wire → Wire) (L : Layout) (hy : L.ylow≠[]) (hw : L.Widths) :
    renameProgram f (inverse L)=inverse (mapCircuit f L) := by
  simp only [inverse,rename_append,rename_reverse,bi_recoverPrefix_natural,
    bi_unbiasView_natural f L hw,ShortBiasedNatural.restoreRaw_natural,rawSub_natural,seed_natural f L hy]
end ECDSAAdd.Frontier.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.GuardCompression
open ECDSAAdd.Arithmetic ECDSAAdd.Challenge ECDSAAdd.Baselines
theorem forward_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    gateSlots (forward L) ≤ 24000 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have kw := BalancedCircuit.widths L hw
  have hb : (ShortBiasedFold.lowBits L).length=255 := by exact ShortBiasedFold.lowBits_length L
  have a := addInPlace_gateSlots_le (source L) (BalancedCircuit.rawTarget L)
    L.carry L.sign
  have r := (rotate_gateSlots_le (BalancedCircuit.rawTarget L)).1
  have l := (rotate_gateSlots_le L.r).2
  have m := mappedAdd_gateSlots_le (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus
  have u := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.positiveLiteral
  have c := compareLt_gateSlots_le none L.y L.r L.carry L.one L.parity
  have sl : (source L).length=257 := by simpa [source,BalancedCircuit.rawSource] using kw.1
  rw [sl] at a
  rw [kw.2.1] at r
  rw [w.2.1] at l
  rw [hb] at m
  rw [w.1] at u
  rw [w.2.1,w.2.2.1] at c
  simp only [forward,seed,ShortBiasedFold.remainder,cleanup,
    BiasedCircuit.prepareFold,BiasedCircuit.signView,ShortBiasedFold.shortFold,
    BiasedCircuit.releaseSelectors,BiasedCircuit.flipBias,seed,
    rawAdd,BalancedCleanup.prepareSign,BalancedCleanup.prepareCompare,
    BalancedCleanup.unnormalize,gateSlots_append,reverse_gateSlots,signComplement_gateSlots,
    gateSlots_cons,gateSlots_nil,instructionSlots,kw.1,w.2.1,w.2.2.1,List.length_cons,List.length_nil]
  omega

theorem inverse_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    Challenge.gateSlots (inverse L) ≤ 25000 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have rw := BalancedCircuit.widths L hw
  have a := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.negativeLiteral
  have c := compareLt_gateSlots_le none L.y L.r L.carry L.one L.parity
  have b := mappedSub_gateSlots_le (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus
  have s := subInPlace_gateSlots_le (source L) (BalancedCircuit.rawTarget L) L.carry L.sign
  have r := (rotate_gateSlots_le L.r).2
  have rt := (rotate_gateSlots_le (BalancedCircuit.rawTarget L)).2
  rw [w.1] at a
  rw [w.2.2.1,w.2.1] at c
  have bl : (ShortBiasedFold.lowBits L).length=255 := ShortBiasedFold.lowBits_length L
  rw [bl,w.1] at b
  have sl : (source L).length=257 := by simpa [source,BalancedCircuit.rawSource] using rw.1
  rw [sl,rw.2.1] at s
  rw [w.2.1] at r
  rw [rw.2.1] at rt
  simp only [inverse,BiasedInverse.recoverPrefix,BiasedInverse.unbiasView,
    ShortBiasedInverse.restoreRaw,BiasedInverse.selectors,ShortBiasedInverse.unfoldBias,ShortBiasedFold.shortUnfold,BiasedInverse.release,
    rawSub,BalancedCleanup.prepareSign,BalancedCleanup.normalize,
    BalancedCleanup.prepareCompare,seed,gateSlots_append,reverse_gateSlots,
    signComplement_gateSlots,gateSlots_cons,gateSlots_nil,instructionSlots,
    w.2.1,w.2.2.1,rw.1,List.length_cons,List.length_nil]
  omega
end ECDSAAdd.Frontier.GuardCompression

end

section
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run

theorem forward_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    let t:=run (forward L) m s
    t.phase=s.phase ∧ regValue L.r t.basis=encodeWord 256 (halfResult (rawSum B X Y)) ∧
    (∀q∈BalancedCircuit.work L,t.basis q=false) ∧ (∀q,q∉L.r → t.basis q=s.basis q) := by
  rw [forward_eq L hw hn (raw_measurement_eq L hw).1 (guard_free L hw hn).1 B X Y hx hy s m hs hr hyr hc]
  exact ShortBiasedFold.program_correct L hw hn B X Y hx hy s m hs hr hyr hc

theorem inverse_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    let t:=run (inverse L) m s
    t.phase=s.phase ∧ regValue L.r t.basis=encodeWord 256 (BalancedInverse.result B R Y) ∧
    (∀a∈work L,t.basis a=false) ∧ (∀a,a∉L.r → t.basis a=s.basis a) := by
  rw [inverse_eq L hw hn (raw_measurement_eq L hw).2 (guard_free L hw hn).2 B R Y hr hy s m hs hR hY hc]
  exact ShortBiasedInverse.program_correct L hw hn B R Y hr hy s m hs hR hY hc
end ECDSAAdd.Frontier.GuardCompression

end

section
set_option maxHeartbeats 2500000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.OneReuse
open ECDSAAdd.Arithmetic
attribute [local irreducible] run wires

def Apart (b : Wire) (s t : State) : Prop:=s.phase=t.phase ∧ ∀q,q≠b→s.basis q=t.basis q
def erase (b : Wire) (P : Program) : Program:=P.filter (fun i=>decide (b∉i.wires))
def OnlyTargets (b : Wire) (P : Program) : Prop:=∀i∈P,b∈i.wires→∃a,i=Instr.CX a b

theorem away_congr (b : Wire) (P : Program) (free : b∉wires P)
    (s t : State) (m : List Bool) (agree : Apart b s t) : Apart b (run P m s) (run P m t) := by
  have read (q : Wire) (hq : q∈wires P) : s.basis q=t.basis q:=
    agree.2 q (fun e=>free (e ▸ hq))
  have inc:=run_local_increment P s t m read
  refine ⟨?_,?_⟩
  · have h:=inc.1
    rw [agree.1] at h
    cases ht:t.phase <;> simpa [ht] using h
  · intro q qb
    by_cases hp:q∈wires P
    · exact inc.2 q hp
    · exact (run_preserves_outside P m s q hp).trans
        ((agree.2 q qb).trans (run_preserves_outside P m t q hp).symm)

private theorem instructions_mem (P : Program) (q : Wire) : q∈wires P↔∃i∈P,q∈i.wires := by
  induction P with
  | nil=>simp [wires]
  | cons i p ih=>
    simp only [wires,Finset.mem_union,ih,List.mem_cons]
    constructor
    · rintro (h|⟨j,hj,hq⟩)
      · exact ⟨i,Or.inl rfl,h⟩
      · exact ⟨j,Or.inr hj,hq⟩
    · rintro ⟨j,(rfl|hj),hq⟩
      · exact Or.inl hq
      · exact Or.inr ⟨j,hj,hq⟩

theorem erase_free (b : Wire) (P : Program) : b∉wires (erase b P) := by
  intro h
  obtain ⟨i,hi,hb⟩:=(instructions_mem _ _).mp h
  have keep: b∉i.wires:=of_decide_eq_true (List.mem_filter.mp hi).2
  exact keep hb

theorem erase_apart (b : Wire) (P : Program) :
    ∀(s t : State)(m : List Bool), OnlyTargets b P→Apart b s t→
      Apart b (run (erase b P) m s) (run P m t) := by
  induction P with
  | nil=>
    intro s t m legal agree
    simpa only [erase,List.filter_nil,run] using agree
  | cons i p ih=>
    intro s t m legal agree
    have tail:OnlyTargets b p:=fun j hj hq=>legal j (List.mem_cons_of_mem _ hj) hq
    by_cases free:b∉i.wires
    · have strip:erase b (i::p)=i::erase b p:=by simp [erase,free]
      have one:b∉wires [i]:=by simpa [wires] using free
      rw [strip,show i::erase b p=[i]++erase b p by rfl,show i::p=[i]++p by rfl,
        run_append,run_append,run_take,run_take]
      exact ih _ _ _ tail (away_congr b [i] one s t m agree)
    · obtain ⟨a,rfl⟩:=legal i (by simp) (by simpa using free)
      have strip:erase b (Instr.CX a b::p)=erase b p:=by simp [erase,Instr.wires]
      rw [strip,show Instr.CX a b::p=[Instr.CX a b]++p by rfl,run_append]
      simp only [show measurementCount [Instr.CX a b]=0 from rfl,List.take_zero,List.drop_zero]
      apply ih _ _ _ tail
      refine ⟨?_,?_⟩
      · simpa only [run] using agree.1
      · intro q qb
        simpa only [run,writeBit,Function.update_of_ne qb] using agree.2 q qb

theorem erase_correct (b : Wire) (P : Program) (legal : OnlyTargets b P)
    (s : State) (m : List Bool) (restored : (run P m s).basis b=s.basis b) :
    run (erase b P) m s=run P m s := by
  have rel:=erase_apart b P s s m legal ⟨rfl,fun _ _=>rfl⟩
  apply State.extensionality
  · exact rel.1
  · funext q
    by_cases qb:q=b
    · subst q
      exact (run_preserves_outside _ _ _ _ (erase_free b P)).trans restored.symm
    · exact rel.2 q qb
end ECDSAAdd.Frontier.OneReuse

end

section
set_option maxHeartbeats 1200000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Frontier.OneReuse
open ECDSAAdd.Arithmetic
attribute [local irreducible] run wires

def window (a n h b c : Wire) (Q : Program) : Program :=
  [.CX a b,.CX n b]++Q++[.CX a h,.CX a n,.CX h n,.CX h b,
    .measureX c [] [.Z a,.CZ a h]]

theorem window_restored (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (same : s.basis h=s.basis n) :
    (run (window a n h b c Q) m s).basis b=false := by
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  let t := run [.CX a b,.CX n b] m s
  let u := run Q m t
  have ta : t.basis a=s.basis a := by simp_all [t,run,writeBit,Function.update,ne_comm]
  have th : t.basis h=s.basis n := by simp_all [t,run,writeBit,Function.update,ne_comm]
  have tb : t.basis b= (s.basis a ^^ s.basis n) := by simp_all [t,run,writeBit,Function.update,ne_comm]
  have ua : u.basis a=s.basis a := (run_preserves_outside Q m t a fa).trans ta
  have uh : u.basis h=s.basis n := (run_preserves_outside Q m t h fh).trans th
  have ub : u.basis b= (s.basis a ^^ s.basis n) := (run_preserves_outside Q m t b fb).trans tb
  have pre (v : List Bool) : run [.CX a b,.CX n b] v s=t := by simp [t,run]
  have split : run (window a n h b c Q) m s=
      run [.CX a h,.CX a n,.CX h n,.CX h b,.measureX c [] [.Z a,.CZ a h]]
        (m.drop (measurementCount Q)) u := by
    simp only [window,run_append,measurementCount_append]
    simp only [measurementCount,List.drop_zero,Nat.zero_add,run_take]
    rw [pre]
  rw [split]
  have an : a≠n := by tauto
  have ab : a≠b := by tauto
  have hb : h≠b := by tauto
  have nb : n≠b := by tauto
  have cb : c≠b := by tauto
  have ah : a≠h := by tauto
  have nh : n≠h := by tauto
  cases ha:s.basis a <;> cases hn:s.basis n
  all_goals simp only [ha,hn,Bool.false_xor,Bool.true_xor] at ua uh ub
  all_goals simp [run,writeBit,Function.update,measureAndCorrect,correct,ua,uh,ub,an,ab,hb,nb,cb,ah,nh,Ne.symm an,Ne.symm ab,Ne.symm hb,Ne.symm nb,Ne.symm cb,Ne.symm ah,Ne.symm nh]

private theorem instruction_wire (P : Program) (i : Instr) (q : Wire)
    (hi : i∈P) (hq : q∈i.wires) : q∈wires P := by
  induction P with
  | nil => simp at hi
  | cons j ps ih =>
    rcases List.mem_cons.mp hi with rfl|hi
    · simp only [wires,Finset.mem_union]; exact Or.inl hq
    · simp only [wires,Finset.mem_union]; exact Or.inr (ih hi)

theorem window_legal (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fb : b∉wires Q) :
    OnlyTargets b (window a n h b c Q) := by
  intro i hi hb
  simp only [window,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hi
  rcases hi with ((rfl|rfl)|hi)|(rfl|rfl|rfl|rfl|rfl)
  · exact ⟨a,rfl⟩
  · exact ⟨n,rfl⟩
  · exact False.elim (fb (instruction_wire Q i b hi hb))
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · exact ⟨h,rfl⟩
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp [Instr.wires,correctionWires] at hb
    rcases hb with hb|hb|hb <;> subst b <;> simp_all


theorem window_reset (a n h b c : Wire) (Q : Program) (s : State) (m : List Bool) :
    (run (window a n h b c Q) m s).basis c=false := by
  have eq : window a n h b c Q=
      ([.CX a b,.CX n b]++Q++[.CX a h,.CX a n,.CX h n,.CX h b])++
        [.measureX c [] [.Z a,.CZ a h]] := by simp [window,List.append_assoc]
  rw [eq,run_append]
  simp [run,measureAndCorrect,writeBit]

def recycledWindow (a n h b c : Wire) (Q : Program) : Program :=
  renameProgram (Equiv.swap b c) (erase b (window a n h b c Q))

theorem recycledWindow_eq (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (carry : s.basis c=false) (same : s.basis h=s.basis n) :
    run (recycledWindow a n h b c Q) m s=run (window a n h b c Q) m s := by
  have eq := erase_correct b (window a n h b c Q) (window_legal a n h b c Q nd fb) s m
    ((window_restored a n h b c Q nd fa fb fh s m zero same).trans zero.symm)
  have rb : (run (erase b (window a n h b c Q)) m s).basis b=false := by
    rw [eq]; exact window_restored a n h b c Q nd fa fb fh s m zero same
  have rc : (run (erase b (window a n h b c Q)) m s).basis c=false := by
    rw [eq]; exact window_reset a n h b c Q s m
  exact (FieldFrameOB5.rebind_swap_run b c _ s m zero carry rb rc).trans eq

def carryWindow (a n h b c : Wire) (Q : Program) : Program :=
  [.CCX a n c]++window a n h b c Q

theorem carryWindow_legal (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fb : b∉wires Q) :
    OnlyTargets b (carryWindow a n h b c Q) := by
  intro i hi hb
  simp only [carryWindow,List.mem_append,List.mem_singleton] at hi
  rcases hi with rfl|hi
  · have small := nd
    simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at small
    simp [Instr.wires] at hb
    rcases hb with hb|hb|hb <;> subst b <;> simp_all
  · exact window_legal a n h b c Q nd fb i hi hb

theorem carryWindow_restored (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (same : s.basis h=s.basis n) :
    (run (carryWindow a n h b c Q) m s).basis b=false := by
  have small := nd
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at small
  rw [carryWindow,run_append]
  simp only [measurementCount,List.drop_zero]
  apply window_restored a n h b c Q nd fa fb fh
  · simp_all [run,writeBit,Function.update,ne_comm]
  · simp_all [run,writeBit,Function.update,ne_comm]

def recycledCarryWindow (a n h b c : Wire) (Q : Program) : Program :=
  renameProgram (Equiv.swap b c) (erase b (carryWindow a n h b c Q))

theorem recycledCarryWindow_eq (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (carry : s.basis c=false) (same : s.basis h=s.basis n) :
    run (recycledCarryWindow a n h b c Q) m s=run (carryWindow a n h b c Q) m s := by
  have eq := erase_correct b (carryWindow a n h b c Q) (carryWindow_legal a n h b c Q nd fb) s m
    ((carryWindow_restored a n h b c Q nd fa fb fh s m zero same).trans zero.symm)
  have rb : (run (erase b (carryWindow a n h b c Q)) m s).basis b=false := by
    rw [eq]; exact carryWindow_restored a n h b c Q nd fa fb fh s m zero same
  have rc : (run (erase b (carryWindow a n h b c Q)) m s).basis c=false := by
    rw [eq,carryWindow,run_append]
    exact window_reset a n h b c Q _ _
  exact (FieldFrameOB5.rebind_swap_run b c _ s m zero carry rb rc).trans eq
end ECDSAAdd.Frontier.OneReuse

