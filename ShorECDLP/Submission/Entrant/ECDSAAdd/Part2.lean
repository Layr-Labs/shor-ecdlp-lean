theorem sum_wires_subset (L : KaratsubaSquareLayout) (h : L.Valid) :
    ECDSAAdd.wires L.prepareSum⊆L.wires.toFinset ∧
    ECDSAAdd.wires L.clearSum⊆L.wires.toFinset := by
