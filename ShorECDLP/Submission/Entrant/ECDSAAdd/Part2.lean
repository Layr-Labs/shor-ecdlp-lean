theorem qubitBound (L : Layout) (hw : L.Widths) : qubitCount (program L)≤776 := by
  have h := Finset.card_le_card (support L hw)
  have n := List.toFinset_card_le L.wires
  rw [BalancedCircuit.declaredSites L hw] at n
  exact h.trans n
