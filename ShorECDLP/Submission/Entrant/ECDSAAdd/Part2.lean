  have hn := (List.nodup_cons.mp hnd).2
  have hc : c∉L.reg f := by
    intro h
    have hp := List.count_pos_iff.mpr h
    have hz := List.count_eq_zero.mpr (List.nodup_cons.mp hnd).1
    have hl := L.reg_count f c
