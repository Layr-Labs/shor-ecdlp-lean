      have hpad : 1≤pad.length := by rcases hp with hp|hp <;> omega
      have hr := cuccaroSignedSquareRow_counts c (d::tail)
        ((dst.drop 1).take ((d::tail).length+1)) pad carry hrow hpad
      have hi := ih (dst.drop 2) hnext (Or.inr hpad)
