      (fun st => (((Holds.holds st c B ∧ Holds.holds st M.x X) ∧ Holds.holds st M.y Y) ∧ Holds.holds st M.out (if B then (O+p-(X*Y)%p)%p else O)) ∧ Holds.holds st M.work 0)) := by
