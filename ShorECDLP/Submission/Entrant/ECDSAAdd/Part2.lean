    (∀ w, w∉L.acc → w∉L.history → w≠L.flag → (run (montPrepare L x y p) m s).basis w=s.basis w) ∧
    regValue L.acc (run (montPrepare L x y p) m s).basis=montgomeryValue p X Y 64%p ∧
