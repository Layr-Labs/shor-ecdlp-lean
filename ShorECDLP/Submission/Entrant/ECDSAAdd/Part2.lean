    (hci : s.basis L.cin=false) (hf : s.basis L.flag=decide (A<p)) :
    (run (montDenormalize L p) m s).phase=s.phase ∧
    (∀ w, w∉L.acc → w≠L.flag → (run (montDenormalize L p) m s).basis w=s.basis w) ∧
