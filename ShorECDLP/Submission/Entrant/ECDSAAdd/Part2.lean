    simpa [v0,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,candidateInitial] using CandidateValues.sub L h hnd v10 G .product .inputY .y
      hP heY hCY nY (by simp [v10,Nat.mod_lt _ hp]) hY
