  have heX := congrArg (fun t => t.2.1) he
  have heY := congrArg (fun t => t.2.2) he
  dsimp only at heF heX heY
  rw [heF,heX,heY] at hh
  exact ⟨hh.phase,hv.pointOutput hn hh,hb.pointOutput hn hh⟩

