      List.toFinset_card_of_nodup ((L.first.usedRecordTapeWires_sublist L.records).nodup (L.first_nodup hnd)),hn] at hbits
    have hm (bs : List ModBit) : (bs.flatMap ModBit.all).length=8*bs.length := by
      induction bs with
