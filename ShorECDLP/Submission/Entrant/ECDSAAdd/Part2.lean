private theorem prepared_preserved (M : MontLayout) (p X Y : Nat) (hnd : M.wires.Nodup)
    (s t : BasisState) (h : MontPrepared M p X Y s)
    (he : ∀w, w∉M.out → t w=s w) : MontPrepared M p X Y t := by
