  change (run (skywalkArithmeticClear w) m5 s4).phase=s4.phase ∧ _ at h5
  rw [hs5] at h5
  have hframe5 := arith_clear_transport w hn s2 s4 m3 m5 (by rw [hs3]; exact hframe4)
  rw [hs5] at hframe5
  have hstage5 := arith_stage_congr w _ s2.basis s5.basis h2.2
