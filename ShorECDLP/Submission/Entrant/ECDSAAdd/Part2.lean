theorem dialogStreamedSquareWide_pool (L : ControlledPointLayout) (hw : L.Widths) :
    L.dialogStreamedSquareWide.core.product++L.dialogStreamedSquareWide.core.pad++
      L.dialogStreamedSquareWide.core.work++
