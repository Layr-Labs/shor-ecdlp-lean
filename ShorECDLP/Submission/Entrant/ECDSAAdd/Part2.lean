  obtain ⟨hp,he,hz⟩ := maskedConstant_correct c (L.reg f) k (L.reg_nodup hn f) hc hk s m
  exact ⟨hp,InverseValues.update L hn v f _ _ _ h.1 he (by simpa only [h.1 f,h.2] using hz),
