private theorem controlled_inverse_copy (L : InverseLayout) (c : Wire)
    (hnd : (c::L.wires).Nodup) (hw : L.Widths) (v : InverseField → Nat) (B : Bool) :
    Triple (fun st => InverseValues L v st ∧ st c=B) (copyRegister (some c) L.x L.vLow)
